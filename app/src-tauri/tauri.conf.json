{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Causal Capybara",
  "version": "0.1.0",
  "identifier": "dev.vcesr.causalcapybara",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Causal Capybara",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "maximizable": true,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8760 ipc: http://ipc.localhost; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "dmg",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "copyright": "Yusufhan Balci; VCESR",
    "publisher": "Yusufhan Balci; VCESR",
    "homepage": "https://github.com/HYHBalci/causal-capybara",
    "category": "Education",
    "shortDescription": "Serious causal inference. Casual to use.",
    "longDescription": "A local desktop studio for applied causal inference: state a causal question, complete a picture of the research design, look at the diagnostics that design depends on, and estimate with the R and Python packages the field already publishes with.",
    "resources": {
      "../../sidecar": "sidecar",
      "../../engines": "engines",
      "../../schemas": "schemas",
      "../../docs/explain": "docs/explain",
      "../../LICENSE": "LICENSE",
      "../../NOTICE": "NOTICE",
      "../../docs/GUIDE.md": "docs/GUIDE.md"
    },
    "licenseFile": "../../LICENSE"
  }
}
