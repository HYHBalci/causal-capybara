{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scoped original scientific explanation",
  "allOf": [
    {
      "$ref": "node.schema.json"
    },
    {
      "type": "object",
      "required": [
        "evidence_ids",
        "source_ids",
        "conditions",
        "counterevidence",
        "gaps",
        "scope"
      ],
      "properties": {
        "kind": {
          "const": "claim"
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "counterevidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  ]
}
