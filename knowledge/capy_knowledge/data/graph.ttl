"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"obs.matching.genetic\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:cba5b970c14820ba6f7af878\",\"object_id\":\"concept:propensity-score\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"rosenbaum1983\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"obs.matching.genetic\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:ce770635e26287b6fad029c6\",\"object_id\":\"concept:missing-data\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"bang2005\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"obs.matching.genetic\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:d2f137fea0b207492b79a44a\",\"object_id\":\"assumption:exchangeability\",\"predicate\":\"requires_assumption\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"obs.matching.genetic\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:f7396e16019b55db78aeb4ad\",\"object_id\":\"ml.dml_irm\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"obs.matching.genetic\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Search over distance-metric weights until balance is as good as it can get, instead of trusting one metric.\",\"title\":\"Genetic matching\"}" .
<urn:capy:obs.matching.nn> a capy:method ; skos:prefLabel "Nearest-neighbour matching" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:obs.matching.nn\"],\"catalogue_key\":\"method:obs.matching.nn\",\"citation_ids\":[\"10.1214/09-sts313\",\"source:unresolved:f9ab87ede81d30b4ee1a\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":null,\"engines\":{\"python\":true,\"r\":\"MatchIt\"},\"needs_r_packages\":[\"MatchIt\"],\"runs_here\":true,\"summary\":\"Runs on this computer with what the app already installs.\"},\"designs\":[{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.overlap\",\"id\":\"overlap\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Overlap between the arms\"},{\"explain_key\":\"diagnostic.love\",\"id\":\"love\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Covariate balance (Love plot)\"},{\"explain_key\":\"diagnostic.ess\",\"id\":\"ess\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Effective sample size\"},{\"explain_key\":\"diagnostic.n_matched\",\"id\":\"n_matched\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Match quality\"},{\"explain_key\":\"diagnostic.ps_calibration\",\"id\":\"ps_calibration\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Treatment-model calibration\"}],\"estimands\":[{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"},{\"acronym\":\"ATC\",\"explain_key\":\"estimand.atc\",\"id\":\"ATC\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who didn't get it, what would it have done?\",\"title\":\"Average treatment effect on the controls\"}],\"explain_key\":\"method.obs.matching.nn\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"obs.matching.nn\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":true,\"one_liner\":\"Pair each treated unit with the most similar untreated unit, then compare within pairs.\",\"options\":[{\"choices\":[\"ps\",\"logit_ps\",\"mahalanobis\"],\"default\":\"ps\",\"help\":\"Propensity score, its logit (more spread out in the tails), or Mahalanobis distance on the covariates themselves.\",\"label\":\"Similarity measured by\",\"name\":\"distance\",\"profile\":\"standard\",\"type\":\"select\"},{\"default\":1,\"help\":\"More matches means less variance and more bias.\",\"label\":\"Matches per unit\",\"max\":10,\"min\":1,\"name\":\"ratio\",\"profile\":\"standard\",\"type\":\"int\"},{\"default\":null,\"help\":\"Refuse matches further apart than this. Units with no match inside the caliper leave the sample, and the flow diagram records it.\",\"label\":\"Caliper (SD of the score)\",\"max\":2.0,\"min\":0.01,\"name\":\"caliper\",\"profile\":\"standard\",\"type\":\"number\"},{\"default\":false,\"help\":\"Better matches, but a few units can end up carrying the estimate.\",\"label\":\"Reuse comparison units\",\"name\":\"replacement\",\"profile\":\"standard\",\"type\":\"bool\"},{\"default\":[],\"help\":\"Categorical variables that must agree exactly.\",\"label\":\"Match exactly on\",\"name\":\"exact\",\"profile\":\"advanced\",\"type\":\"columns\"},{\"default\":true,\"help\":\"Mops up the remaining imbalance.\",\"label\":\"Regression-adjust inside the matched sample\",\"name\":\"adjust_covariates\",\"profile\":\"advanced\",\"type\":\"bool\"}],\"plain_language\":\"Pair each treated unit with the most similar untreated unit, then compare within pairs.\",\"probes\":[{\"explain_key\":\"probe.rosenbaum\",\"id\":\"probe.rosenbaum\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"How unequal could the odds of treatment be inside a matched pair before the conclusion stopped being clear?\",\"requested_as\":\"probe.rosenbaum\",\"title\":\"Rosenbaum bounds\"},{\"explain_key\":\"probe.placebo_outcome\",\"id\":\"probe.placebo_outcome\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the same analysis on something the treatment could not have changed. It should find nothing.\",\"requested_as\":\"probe.placebo_outcome\",\"title\":\"Placebo outcome\"},{\"explain_key\":\"probe.subset\",\"id\":\"probe.subset\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Re-estimate on random subsets. The answer should move about as much as losing that much data costs, and no more.\",\"requested_as\":\"probe.subset\",\"title\":\"Subset stability\"},{\"explain_key\":\"probe.alternate_spec\",\"id\":\"probe.alternate_spec\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the grid of defensible specifications and sort the answers. The curve is the result, not the one you happened to run.\",\"requested_as\":\"probe.alternate_spec\",\"title\":\"Specification curve\"}],\"references\":[\"Ho, Imai, King & Stuart (2011), MatchIt\",\"Stuart (2010), Matching methods for causal inference\"],\"roles_forbidden\":[\"forbidden\"],\"roles_optional\":[\"a clustering variable\",\"weight\",\"effect_modifiers\"],\"roles_required\":[\"a treatment\",\"an outcome\",\"at least one measured confounder\"],\"see_also\":[{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"},{\"explain_key\":\"method.bounds.manski\",\"id\":\"bounds.manski\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Report the range the effect must lie in given only what the data can support, without assuming away the missing counterfactual.\",\"title\":\"Manski bounds\"},{\"explain_key\":\"method.interference.exposure\",\"id\":\"interference.exposure\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"When one unit's treatment affects another's outcome, estimate the direct and spillover effects separately instead of pretending neither exists.\",\"title\":\"Interference and spillovers\"},{\"explain_key\":\"method.ml.causal_forest\",\"id\":\"ml.causal_forest\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Grow trees that look for units whose effect differs, keeping the rows that chose each split away from the rows that estimate it.\",\"title\":\"Honest causal forest\"},{\"explain_key\":\"method.ml.dml_irm\",\"id\":\"ml.dml_irm\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"A separate outcome model for each arm plus a treatment model, combined in a doubly robust score: right if either side is right.\",\"title\":\"Double ML (interactive)\"},{\"explain_key\":\"method.ml.metalearner\",\"id\":\"ml.metalearner\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Build the per-unit effect out of ordinary prediction models, four different ways, on the same cross-fitting.\",\"title\":\"Meta-learner (T, S, X, DR)\"},{\"explain_key\":\"method.obs.aipw\",\"id\":\"obs.aipw\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Use a treatment model and an outcome model together; it is right if either one is.\",\"title\":\"Doubly robust (AIPW)\"}],\"status\":\"recommended\",\"status_label\":\"Recommended\",\"tags\":[\"Adjust for background differences\",\"ATT\",\"ATC\",\"Recommended\"],\"title\":\"Nearest-neighbour matching\",\"what_it_assumes\":[{\"explain_key\":\"assumption.exchangeability\",\"explains\":\"Treated and untreated units are comparable once you condition on the confounders you measured. Everything that pushed people towards treatment and also moves the outcome is in your adjustment set.\",\"id\":\"exchangeability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Exchangeability / no unmeasured confounding\",\"worry_when\":\"Treatment was chosen by people who knew something about the likely outcome that you do not observe. Clinical judgement, self-selection into a programme, and administrative triage are the classic cases.\"},{\"explain_key\":\"assumption.positivity\",\"explains\":\"Every kind of unit had some chance of being treated and some chance of not being treated. Where that fails, there is no comparison to make and the model is inventing one.\",\"id\":\"positivity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Positivity / overlap\",\"worry_when\":\"Any single weight carries a large share of the total; the effective sample is far below the nominal one; the propensity model separates the arms almost perfectly; treated units sit outside the control group's range.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"when_not_to_use\":[\"Unmatched treated units quietly change the population. Matching without replacement on a small comparison pool forces bad pairs.\"],\"when_to_use\":[\"Binary treatment with measured confounders, and the matched sample is something you can look at and argue about.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"obs.matching.nn\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"obs.matching.nn\",\"registry\":{\"designs\":[\"observational\"],\"diagnostics\":[\"overlap\",\"love\",\"ess\",\"n_matched\",\"ps_calibration\"],\"disrecommend_when\":null,\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":true,\"r\":\"MatchIt\"},\"estimands\":[\"ATT\",\"ATC\"],\"explain_key\":\"method.obs.matching.nn\",\"id\":\"obs.matching.nn\",\"needs\":[\"numpy\",\"scipy\",\"pandas\"],\"needs_overlap\":true,\"one_liner\":\"Pair each treated unit with the most similar untreated unit, then compare within pairs.\",\"options\":[{\"choices\":[\"ps\",\"logit_ps\",\"mahalanobis\"],\"default\":\"ps\",\"help\":\"Propensity score, its logit (more spread out in the tails), or Mahalanobis distance on the covariates themselves.\",\"label\":\"Similarity measured by\",\"name\":\"distance\",\"profile\":\"standard\",\"type\":\"select\"},{\"default\":1,\"help\":\"More matches means less variance and more bias.\",\"label\":\"Matches per unit\",\"max\":10,\"min\":1,\"name\":\"ratio\",\"profile\":\"standard\",\"type\":\"int\"},{\"default\":null,\"help\":\"Refuse matches further apart than this. Units with no match inside the caliper leave the sample, and the flow diagram records it.\",\"label\":\"Caliper (SD of the score)\",\"max\":2.0,\"min\":0.01,\"name\":\"caliper\",\"profile\":\"standard\",\"type\":\"number\"},{\"default\":false,\"help\":\"Better matches, but a few units can end up carrying the estimate.\",\"label\":\"Reuse comparison units\",\"name\":\"replacement\",\"profile\":\"standard\",\"type\":\"bool\"},{\"default\":[],\"help\":\"Categorical variables that must agree exactly.\",\"label\":\"Match exactly on\",\"name\":\"exact\",\"profile\":\"advanced\",\"type\":\"columns\"},{\"default\":true,\"help\":\"Mops up the remaining imbalance.\",\"label\":\"Regression-adjust inside the matched sample\",\"name\":\"adjust_covariates\",\"profile\":\"advanced\",\"type\":\"bool\"}],\"probes\":[\"probe.rosenbaum\",\"probe.placebo_outcome\",\"probe.subset\",\"probe.alternate_spec\"],\"reference_dispositions\":[{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:f9ab87ede81d30b4ee1a\",\"requested_as\":\"Ho, Imai, King & Stuart (2011), MatchIt\"},{\"disposition\":\"resolved_metadata\",\"id\":\"10.1214/09-sts313\",\"requested_as\":\"Stuart (2010), Matching methods for causal inference\"}],\"reference_ids\":[\"source:unresolved:f9ab87ede81d30b4ee1a\",\"10.1214/09-sts313\"],\"references\":[\"Ho, Imai, King & Stuart (2011), MatchIt\",\"Stuart (2010), Matching methods for causal inference\"],\"roles_forbidden\":[\"forbidden\"],\"roles_optional\":[\"cluster\",\"weight\",\"effect_modifiers\"],\"roles_required\":[\"treatment\",\"outcome\",\"confounders\"],\"source_path\":\"engines/python/capy_py/observational.py\",\"source_sha256\":\"f9dfafacc9dacabf923e4d48367973338dbe326bdf5c222ade0dedf0470b5ccb\",\"status\":\"recommended\",\"title\":\"Nearest-neighbour matching\",\"what_can_go_wrong\":\"Unmatched treated units quietly change the population. Matching without replacement on a small comparison pool forces bad pairs.\",\"why_recommended\":\"Binary treatment with measured confounders, and the matched sample is something you can look at and argue about.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:0023baf3d37c117a55765ace\",\"object_id\":\"assumption:consistency\",\"predicate\":\"requires_assumption\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":