<urn:capy:study%3Acastle_doctrine> a capy:study ; skos:prefLabel "Castle-doctrine laws, adopted at different times" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"study:castle_doctrine\",\"citation_ids\":[],\"citations\":[],\"content\":{\"caveat\":\"Adoption year is derived from the in-force indicator, not read from a column.\",\"citation\":\"Cheng & Hoekstra (2013).\",\"citation_url\":\"https://doi.org/10.3368/jhr.48.3.821\",\"design\":{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"},\"difficulty\":\"the important one\",\"estimand\":{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"},\"explain_key\":null,\"gaps\":[],\"id\":\"castle_doctrine\",\"kind\":\"study\",\"one_liner\":\"staggered adoption where nobody can tell you the right answer\",\"plain_language\":\"Twenty-one states adopted stand-your-ground laws between 2005 and 2010, staggered. The real version of the lesson the Medicaid example teaches with simulated data.\",\"provenance\":{\"data_origin\":\"Published study data, fetched from source. Not redistributed by this project.\",\"downloads_from\":[\"https://vincentarelbundock.github.io/Rdatasets/csv/causaldata/castle.csv\"],\"licences\":[\"MIT\"],\"rights\":\"MIT via causaldata, Huntington-Klein et al.\",\"source\":\"real\",\"study\":\"Cheng & Hoekstra (2013)\",\"truth\":\"This is the study data, not a simulation. There is no built-in answer to check the estimators against -- which is the whole reason to work with it.\"},\"question\":\"Twenty-one states adopted stand-your-ground laws between 2005 and 2010, staggered. The real version of the lesson the Medicaid example teaches with simulated data.\",\"rows\":550,\"see_also\":[{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"},{\"explain_key\":\"method.did.callaway_santanna\",\"id\":\"did.callaway_santanna\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Estimate one clean before-and-after for every adoption cohort, then say out loud how you averaged them.\",\"title\":\"Callaway & Sant'Anna group-time effects\"},{\"explain_key\":\"method.did.sun_abraham\",\"id\":\"did.sun_abraham\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Give every cohort its own event-study path, then average the paths by cohort size instead of letting the regression choose the weights.\",\"title\":\"Sun & Abraham event study\"},{\"explain_key\":\"method.did.twfe\",\"id\":\"did.twfe\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"One regression with unit and period fixed effects. Familiar, fast, and not an average treatment effect when units adopt at different dates.\",\"title\":\"Two-way fixed effects\"}],\"suggested_methods\":[{\"explain_key\":\"method.did.callaway_santanna\",\"id\":\"did.callaway_santanna\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Estimate one clean before-and-after for every adoption cohort, then say out loud how you averaged them.\",\"title\":\"Callaway & Sant'Anna group-time effects\"},{\"explain_key\":\"method.did.sun_abraham\",\"id\":\"did.sun_abraham\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Give every cohort its own event-study path, then average the paths by cohort size instead of letting the regression choose the weights.\",\"title\":\"Sun & Abraham event study\"},{\"explain_key\":\"method.did.twfe\",\"id\":\"did.twfe\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"One regression with unit and period fixed effects. Familiar, fast, and not an average treatment effect when units adopt at different dates.\",\"title\":\"Two-way fixed effects\"}],\"tags\":[\"Policy rolled out over time\",\"the important one\"],\"teaches\":\"staggered adoption where nobody can tell you the right answer\",\"title\":\"Castle-doctrine laws, adopted at different times\",\"tour\":[]},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"study:castle_doctrine\",\"kind\":\"study\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"castle_doctrine\",\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:04caa4151114d64edaf0dd8d\",\"object_id\":\"did.sun_abraham\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"study:castle_doctrine\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:1bdd5b83f46d1a1475ca8e85\",\"object_id\":\"design:did\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"c