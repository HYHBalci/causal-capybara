roject_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"obs.matching.nn\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:fd2872852f8fd2f9389875c5\",\"object_id\":\"concept:covariate-balance\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"rosenbaum1983\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"obs.matching.nn\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Pair each treated unit with the most similar untreated unit, then compare within pairs.\",\"title\":\"Nearest-neighbour matching\"}" .
<urn:capy:obs.matching.optimal> a capy:method ; skos:prefLabel "Optimal and full matching" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:obs.matching.optimal\"],\"catalogue_key\":\"method:obs.matching.optimal\",\"citation_ids\":[\"10.1198/016214504000000647\",\"source:unresolved:65a6ebf65ff495659ebb\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":\"Not wrapped yet. Nearest-neighbour and coarsened exact matching are implemented in Python.\",\"engines\":{\"python\":false,\"r\":\"optmatch\"},\"needs_r_packages\":[\"optmatch\",\"MatchIt\"],\"runs_here\":false,\"summary\":\"Not built into the app yet. The authoritative version is the R package optmatch, which the Engines screen can install for you.\"},\"designs\":[{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.love\",\"id\":\"love\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Covariate balance (Love plot)\"},{\"explain_key\":\"diagnostic.ess\",\"id\":\"ess\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Effective sample size\"},{\"explain_key\":\"diagnostic.n_matched\",\"id\":\"n_matched\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Match quality\"},{\"explain_key\":\"diagnostic.cem_strata\",\"id\":\"cem_strata\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Coarsened strata and common support\"}],\"estimands\":[{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"},{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"}],\"explain_key\":\"method.obs.matching.optimal\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"obs.matching.optimal\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":true,\"one_liner\":\"Choose the whole set of matches at once to minimise total distance, rather than greedily one treated unit at a time.\",\"options\":[],\"plain_language\":\"Choose the whole set of matches at once to minimise total distance, rather than greedily one treated unit at a time.\",\"probes\":[{\"explain_key\":\"probe.rosenbaum\",\"id\":\"probe.rosenbaum\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"How unequal could the odds of treatment be inside a matched pair before the conclusion stopped being clear?\",\"requested_as\":\"probe.rosenbaum\",\"title\":\"Rosenbaum bounds\"},{\"explain_key\":\"probe.placebo_outcome\",\"id\":\"probe.placebo_outcome\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the same analysis on something the treatment could not have changed. It should find nothing.\",\"requested_as\":\"probe.placebo_outcome\",\"title\":\"Placebo outcome\"}],\"references\":[\"Rosenbaum (1991)\",\"Hansen (2004), Full matching in an observational study of coaching\"],\"roles_forbidden\":[],\"roles_optional\":[],\"roles_required\":[\"a treatment\",\"an outcome\",\"at least one measured confounder\"],\"see_also\":[{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"},{\"explain_key\":\"method.bounds.manski\",\"id\":\"bounds.manski\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Report the range the effect must lie in given only what the data can support, without assuming away the missing counterfactual.\",\"title\":\"Manski bounds\"},{\"explain_key\":\"method.interference.exposure\",\"id\":\"interference.exposure\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"When one unit's treatment affects another's outcome, estimate the direct and spillover effects separately instead of pretending neither exists.\",\"title\":\"Interference and spillovers\"},{\"explain_key\":\"method.ml.causal_forest\",\"id\":\"ml.causal_forest\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Grow trees that look for units whose effect differs, keeping the rows that chose each split away from the rows that estimate it.\",\"title\":\"Honest causal forest\"},{\"explain_key\":\"method.ml.dml_irm\",\"id\":\"ml.dml_irm\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"A separate outcome model for each arm plus a treatment model, combined in a doubly robust score: right if either side is right.\",\"title\":\"Double ML (interactive)\"},{\"explain_key\":\"method.ml.dml_plr\",\"id\":\"ml.dml_plr\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Predict the outcome and the treatment from the confounders, then regress what is left of one on what is left of the other.\",\"title\":\"Double ML (partially linear)\"},{\"explain_key\":\"method.ml.metalearner\",\"id\":\"ml.metalearner\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Build the per-unit effect out of ordinary prediction models, four different ways, on the same cross-fitting.\",\"title\":\"Meta-learner (T, S, X, DR)\"}],\"status\":\"recommended\",\"status_label\":\"Recommended\",\"tags\":[\"Adjust for background differences\",\"ATT\",\"ATE\",\"Recommended\"],\"title\":\"Optimal and full matching\",\"what_it_assumes\":[{\"explain_key\":\"assumption.exchangeability\",\"explains\":\"Treated and untreated units are comparable once you condition on the confounders you measured. Everything that pushed people towards treatment and also moves the outcome is in your adjustment set.\",\"id\":\"exchangeability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Exchangeability / no unmeasured confounding\",\"worry_when\":\"Treatment was chosen by people who knew something about the likely outcome that you do not observe. Clinical judgement, self-selection into a programme, and administrative triage are the classic cases.\"},{\"explain_key\":\"assumption.positivity\",\"explains\":\"Every kind of unit had some chance of being treated and some chance of not being treated. Where that fails, there is no comparison to make and the model is inventing one.\",\"id\":\"positivity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Positivity / overlap\",\"worry_when\":\"Any single weight carries a large share of the total; the effective sample is far below the nominal one; the propensity model separates the arms almost perfectly; treated units sit outside the control group's range.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"when_not_to_use\":[\"Full matching can produce very unequal set sizes, so the effective sample size is the number to watch rather than the count of matched units.\"],\"when_to_use\":[\"Greedy nearest-neighbour matching depends on the order units are processed; optimal matching does not, and full matching keeps every unit by forming variable-ratio sets.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"obs.matching.optimal\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"obs.matching.optimal\",\"registry\":{\"coming\":\"Not wrapped yet. Nearest-neighbour and coarsened exact matching are implemented in Python.\",\"designs\":[\"observational\"],\"diagnostics\":[\"love\",\"ess\",\"n_matched\",\"cem_strata\"],\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":false,\"r\":\"optmatch\"},\"estimands\":[\"ATT\",\"ATE\"],\"id\":\"obs.matching.optimal\",\"needs_overlap\":true,\"one_liner\":\"Choose the whole set of matches at once to minimise total distance, rather than greedily one treated unit at a time.\",\"probes\":[\"probe.rosenbaum\",\"probe.placebo_outcome\"],\"r_needs\":[\"optmatch\",\"MatchIt\"],\"reference_dispositions\":[{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:65a6ebf65ff495659ebb\",\"requested_as\":\"Rosenbaum (1991)\"},{\"disposition\":\"resolved_metadata\",\"id\":\"10.1198/016214504000000647\",\"requested_as\":\"Hansen (2004), Full matching in an observational study of coaching\"}],\"reference_ids\":[\"source:unresolved:65a6ebf65ff495659ebb\",\"10.1198/016214504000000647\"],\"references\":[\"Rosenbaum (1991)\",\"Hansen (2004), Full matching in an observational study of coaching\"],\"roles_required\":[\"treatment\",\"outcome\",\"confounders\"],\"source_path\":\"engines/registry/methods.extra.yaml\",\"source_sha256\":\"2cb349e9f7f7e6f88c10c18d81478656fd420eda7ca977d9767610ac8c7a4be0\",\"status\":\"recommended\",\"title\":\"Optimal and full matching\",\"what_can_go_wrong\":\"Full matching can produce very unequal set sizes, so the effective sample size is the number to watch rather than the count of matched units.\",\"why_recommended\":\"Greedy nearest-neighbour matching depends on the order units are processed; optimal matching does not, and full matching keeps every unit by forming variable-ratio sets.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:08994097ca854f3494cf36b0\",\"object_id\":\"assumption:positivity\",\"predicate\":\"requires_assumption\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"obs.matching.optimal\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:0a2ee31e3513d4adb9fcca1d\",\"object_id\":\"concept:diagnostic-limits\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:rubin2008\"],\"review