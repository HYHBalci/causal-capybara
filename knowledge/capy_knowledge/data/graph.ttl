\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/observational.py\",\"tests/python/test_observational.py\",\"https://miguelhernan.org/whatifbook\",\"https://arxiv.org/html/1608.00060v7\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"source_ids\":[\"source:note:aipw\",\"hernan2020\",\"chernozhukov2018\"],\"summary\":\"ATT positivity is asymmetric: controls are needed on treated covariate support; control-only zero-treatment strata are not themselves an ATT identification failure.\",\"title\":\"ATT asymmetric positivity and treated support\"}" .
<urn:capy:claim%3Aaipw-clipping> a capy:claim ; skos:prefLabel "Finite propensity clipping, weighting and consistency" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Aaipw> ; capy:record "{\"aliases\":[\"propensity score clipping\",\"truncated propensity\",\"clipped weights\",\"bias variance tradeoff\"],\"assertion_mode\":\"original_editorial_explanation\",\"citation_ids\":[\"10.1093/aje/kwn164\",\"bang2005\",\"chernozhukov2018\",\"source:note:aipw\"],\"citations\":[],\"conditions\":[\"Clipping binds in the limiting propensity function.\",\"The outcome nuisance is misspecified for the propensity-only failure example.\",\"The bias expression describes the stated ATT score.\"],\"counterevidence\":[\"A correct ATT control outcome nuisance makes the stated clipping-bias term zero.\",\"If clipping never binds asymptotically, this particular consistency objection disappears.\",\"Trimming observations changes the target population; clipping propensities does not automatically define that target.\"],\"evidence_ids\":[\"evidence:aipw-clipping\"],\"gaps\":[\"No universally optimal clipping threshold is asserted.\",\"The engine reports clipping but its short double-robustness wording requires this qualification.\"],\"id\":\"claim:aipw-clipping\",\"kind\":\"claim\",\"provenance\":[\"source:note:aipw\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:2a864b1541d977ff50dd6cf3\",\"object_id\":\"bang2005\",\"predicate\":\"cites\",\"provenance\":[\"source:note:aipw\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/observational.py\",\"tests/python/test_observational.py\",\"https://doi.org/10.1111/j.1541-0420.2005.00377.x\",\"https://arxiv.org/html/1608.00060v7\",\"https://pmc.ncbi.nlm.nih.gov/articles/PMC2732954/\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Citation and original explanation; linked external bodies are not included.\",\"subject_id\":\"claim:aipw-clipping\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:66496e9801685c10251c5567\",\"object_id\":\"10.1093/aje/kwn164\",\"predicate\":\"cites\",\"provenance\":[\"source:note:aipw\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/observational.py\",\"tests/python/test_observational.py\",\"https://doi.org/10.1111/j.1541-0420.2005.00377.x\",\"https://arxiv.org/html/1608.00060v7\",\"https://pmc.ncbi.nlm.nih.gov/articles/PMC2732954/\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Citation and original explanation; linked external bodies are not included.\",\"subject_id\":\"claim:aipw-clipping\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Clipping binds in the limiting propensity function.\",\"The outcome nuisance is misspecified for the propensity-only failure example.\",\"The bias expression describes the stated ATT score.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:aeaa86b28e8f174180ba2de6\",\"object_id\":\"obs.aipw\",\"predicate\":\"qualifies\",\"provenance\":[\"source:note:aipw\",\"bang2005\",\"chernozhukov2018\",\"10.1093/aje/kwn164\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/observational.py\",\"tests/python/test_observational.py\",\"https://doi.org/10.1111/j.1541-0420.2005.00377.x\",\"https://arxiv.org/html/1608.00060v7\",\"https://pmc.ncbi.nlm.nih.gov/articles/PMC2732954/\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"subject_id\":\"claim:aipw-clipping\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:dff718bf726a02679d123c77\",\"object_id\":\"chernozhukov2018\",\"predicate\":\"cites\",\"provenance\":[\"source:note:aipw\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/observational.py\",\"tests/python/test_observational.py\",\"https://doi.org/10.1111/j.1541-0420.2005.00377.x\",\"https://arxiv.org/html/1608.00060v7\",\"https://pmc.ncbi.nlm.nih.gov/articles/PMC2732954/\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Citation and original explanation; linked external bodies are not included.\",\"subject_id\":\"claim:aipw-clipping\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:e27a193a0e50a315e0e7b99b\",\"object_id\":\"source:note:aipw\",\"predicate\":\"cites\",\"provenance\":[\"source:note:aipw\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/observational.py\",\"tests/python/test_observational.py\",\"https://doi.org/10.1111/j.1541-0420.2005.00377.x\",\"https://arxiv.org/html/1608.00060v7\",\"https://pmc.ncbi.nlm.nih.gov/articles/PMC2732954/\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Citation and original explanation; linked external bodies are not included.\",\"subject_id\":\"claim:aipw-clipping\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/observational.py\",\"tests/python/test_observational.py\",\"https://doi.org/10.1111/j.1541-0420.2005.00377.x\",\"https://arxiv.org/html/1608.00060v7\",\"https://pmc.ncbi.nlm.nih.gov/articles/PMC2732954/\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"source_ids\":[\"source:note:aipw\",\"bang2005\",\"chernozhukov2018\",\"10.1093/aje/kwn164\"],\"summary\":\"Finite fixed propensity clipping changes weights and can destroy propensity-only consistency with a misspecified outcome nuisance; bounded weights do not repair missing support.\",\"title\":\"Finite propensity clipping, weighting and consistency\"}" .
<urn:capy:claim%3Aaipw-cross-fitting-inference> a capy:claim ; skos:prefLabel "Cross-fitting and inference conditions" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Aaipw> ; capy:record "{\"aliases\":[\"cross-fitting\",\"sample splitting\",\"product rate\",\"influence function inference\",\"confidence interval coverage\"],\"assertion_mode\":\"original_editorial_explanation\",\"citation_ids\":[\"chernozhukov2018\",\"source:note:aipw\"],\"citations\":[],\"conditions\":[\"Identification and support hold.\",\"Inference respects the sampling or dependence structure.\",\"Suitable nuisance convergence and regularity hold; a standard sufficient error-product rate is o(n^(-1/2)).\"],\"counterevidence\":[\"Double-robust consistency is weaker than valid double-robust inference.\",\"Cross-fitting is not a universal coverage guarantee.\"],\"evidence_ids\":[\"evidence:aipw-cross-fitting-inference\"],\"gaps\":[\"Independent-unit cross-fitting theory does not automatically cover serial or clustered designs.\",\"No statistical adapter was run during this knowledge review.\"],\"id\":\"claim:aipw-cross-fitting-inference\",\"kind\":\"claim\",\"provenance\":[\"source:note:aipw\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:caf5898347be5214984a6038\",\"object_id\":\"source:note:aipw\",\"predicate\":\"cites\",\"provenance\":[\"source:note:aipw\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/observational.py\",\"tests/python/test_observational.py\",\"https://arxiv.org/html/1608.00060v7\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Citation and original explanation; linked external bodies are not included.\",\"subject_id\":\"claim:aipw-cross-fitting-inference\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:e0ed0732c652516ddfca1117\",\"object_id\":\"chernozhukov2018\",\"predicate\":\"cites\",\"provenance\":[\"source:note:aipw\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/observational.py\",\"tests/python/test_observational.py\",\"https://arxiv.org/html/1608.00060v7\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Citation and original explanation; linked external bodies are not included.\",\"subject_id\":\"claim:aipw-cross-fitting-inference\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Identification and support hold.\",\"Inference respects the sampling or dependence structure.\",\"Suitable nuisance convergence and regularity hold; a standard sufficient error-product rate is o(n^(-1/2)).\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:e3bfccb532ee720474aa8a27\",\"object_id\":\"obs.aipw\",\"predicate\":\"qualifies\",\"provenance\":[\"source:note:aipw\",\"chernozhukov2018\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/observational.py\",\"tests/python/test_observational.py\",\"https://arxiv.org/html/1608.00060v7\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"subject_id\":\"claim:aipw-cross-fitting-inference\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/observational.py\",\"tests/python/test_observational.py\",\"https://arxiv.org/html/1608.00060v7\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"source_ids\":[\"source:note:aipw\",\"chernozhukov2018\"],\"summary\":\"Cross-fitting limits score reuse; valid inference still needs support, sampling, moments and nuisance convergence or rate conditions, not just a split into folds.\",\"title\":\"Cross-fitting and inference conditions\"}" .
<urn:capy:claim%3Aaipw-diagnostics> a capy:claim ; skos:prefLabel "AIPW diagnostics do not prove exchangeability" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Aaipw> ; capy:record "{\"aliases\":[\"covariate balance\",\"overlap diagnostics\",\"effective sample size\",\"ESS\",\"exchangeability diagnostics\"],\"assertion_mode\":\"original_editorial_explanation\",\"citation_ids\":[\"10.1093/aje/kwn164\",\"hernan2020\",\"source:note:aipw\"],\"citations\":[],\"conditions\":[\"Diagnostics concern the fitted analysis and measured variables.\",\"Scientific identification assumptions are assessed separately.\"],\"counterevidence\":[\"Good measured balance can coexist with unmeasured confounding.\",\"A stable fitted estimate can remain causally unidentified.\"],\"evidence_ids\":[\"evidence:aipw-diagnostics\"],\"gaps\":[\"Diagnostic thresholds in the public engine are conventions, not scientific confidence probabilities.\"],\"id\":\"claim:aipw-diagnostics\",\"kind\":\"claim\",\"provenance\":[\"source:note:aipw\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:2987e659a1e318b1468d6994\",\"object_id\":\"source:note:aipw\",\"predicate\":\"cites\",\"provenance\":[\"source:note:aipw\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/observational.py\",\"tests/python/test_observational.py\",\"https://miguelhernan.org/whatifbook\",\"https://pmc.ncbi.nlm.nih.gov/articles/PMC2732954/\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":