_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:r-survreg\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"survival.kaplan_meier\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"The product-limit estimator accounts for right censoring in observed groups; their probability difference at tau is an association.\",\"title\":\"Unadjusted Kaplan–Meier survival contrast\"}" .
<urn:capy:survival.rmst> a capy:method ; skos:prefLabel "Unadjusted restricted mean survival contrast" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:survival.rmst\"],\"catalogue_key\":\"method:survival.rmst\",\"citation_ids\":[\"kaplan1958\",\"uno2014\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":null,\"engines\":{\"python\":true,\"r\":false},\"needs_r_packages\":[],\"runs_here\":true,\"summary\":\"Runs on this computer with what the app already installs.\"},\"designs\":[{\"explain_key\":\"design.survival\",\"id\":\"survival\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Follow people from a common time zero; some leave follow-up before the event is observed.\",\"title\":\"Time until an event\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.survival_followup\",\"id\":\"survival_followup\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Follow-up and common horizon support\"},{\"explain_key\":\"diagnostic.survival_censoring\",\"id\":\"survival_censoring\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Right-censoring assumptions\"},{\"explain_key\":\"diagnostic.survival_curves\",\"id\":\"survival_curves\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Observed Kaplan–Meier curves\"},{\"explain_key\":\"diagnostic.survival_heterogeneity\",\"id\":\"survival_heterogeneity\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Baseline subgroup heterogeneity in survival contrasts\"}],\"estimands\":[{\"acronym\":\"RMST(1) - RMST(0)\",\"explain_key\":\"estimand.rmst_difference\",\"id\":\"RMST_difference\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"Through a chosen horizon, how much event-free follow-up time differs between baseline treatments?\",\"title\":\"Restricted mean survival time difference\"}],\"explain_key\":\"method.survival.rmst\",\"gaps\":[],\"id\":\"survival.rmst\",\"in_more_depth\":\"RMST is the expected event-free time restricted to a prespecified horizon. It does not require proportional hazards or an extrapolated infinite tail. Here the two raw group distributions are different observed populations, so their contrast remains unadjusted. Independent censoring within each arm, independent people and support through tau are required. A sparse tail is flagged. Seeded within-group bootstrap intervals resample people and recompute the whole curve integral. An optional prespecified categorical baseline modifier compares subgroup RMST differences directly; all cells use the same supported horizon and time unit, with resampling within each treatment-by-subgroup cell.\",\"kind\":\"method\",\"needs_overlap\":false,\"one_liner\":\"Compare areas under observed Kaplan–Meier curves through a common horizon in time units; this is an unadjusted association.\",\"options\":[{\"default\":[],\"help\":\"Optional: one prespecified categorical baseline column with 2–8 observed levels. Tests differences between treatment contrasts on the selected scale at the chosen horizon. No automatic cutpoint search.\",\"label\":\"Baseline subgroup modifier\",\"max_items\":1,\"name\":\"subgroups\",\"profile\":\"beginner\",\"type\":\"columns\"},{\"default\":false,\"help\":\"Confirm only when the modifier was measured before treatment and its analysis was specified before inspecting outcomes. Your declaration is recorded but cannot verify the study design.\",\"label\":\"Modifier is baseline and analysis was prespecified\",\"name\":\"subgroups_prespecified\",\"profile\":\"beginner\",\"type\":\"bool\"},{\"choices\":[\"days\",\"weeks\",\"months\",\"years\"],\"default\":null,\"help\":\"Choose explicitly. Follow-up duration and the common horizon must use the same time unit.\",\"label\":\"Duration time unit\",\"name\":\"time_unit\",\"profile\":\"beginner\",\"type\":\"select\"},{\"default\":null,\"help\":\"Choose a positive time in the duration column's units, supported in both groups. Set before viewing the contrast. Required for survival/RMST; unused for the conditional time ratio.\",\"label\":\"Common follow-up horizon\",\"min\":0,\"name\":\"horizon\",\"profile\":\"beginner\",\"type\":\"number\"},{\"default\":100,\"help\":\"Seeded independent-subject resampling; increase for a less noisy interval.\",\"label\":\"Bootstrap resamples\",\"max\":2000,\"min\":20,\"name\":\"bootstrap_reps\",\"profile\":\"standard\",\"type\":\"int\"},{\"default\":0.95,\"label\":\"Confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"standard\",\"type\":\"number\"}],\"plain_language\":\"Integrate each observed Kaplan–Meier curve from zero through the same tau; subtract treatment 0 from treatment 1 in time units.\",\"probes\":[],\"references\":[\"Kaplan and Meier (1958), Nonparametric Estimation from Incomplete Observations\",\"Uno et al. (2014), Moving Beyond the Hazard Ratio in Quantifying the Between-Group Difference in Survival Analysis\"],\"roles_forbidden\":[\"entry\",\"start\",\"stop\",\"competing_event\",\"censoring\",\"a clustering variable\",\"weight\",\"strata\",\"a time variable\"],\"roles_optional\":[\"a unit id\"],\"roles_required\":[\"a treatment\",\"elapsed follow-up duration\",\"an event indicator (1 event, 0 right censored)\"],\"see_also\":[{\"explain_key\":\"design.survival\",\"id\":\"survival\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Follow people from a common time zero; some leave follow-up before the event is observed.\",\"title\":\"Time until an event\"},{\"acronym\":\"RMST(1) - RMST(0)\",\"explain_key\":\"estimand.rmst_difference\",\"id\":\"RMST_difference\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"Through a chosen horizon, how much event-free follow-up time differs between baseline treatments?\",\"title\":\"Restricted mean survival time difference\"},{\"explain_key\":\"method.survival.aft\",\"id\":\"survival.aft\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Fit a right-censored log-normal/Weibull AFT model; standardize survival/RMST over baseline covariates under explicit causal assumptions, or report a conditional time factor.\",\"title\":\"Censored AFT regression and causal standardization\"},{\"explain_key\":\"diagnostic.survival_heterogeneity\",\"id\":\"survival_heterogeneity\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Baseline subgroup heterogeneity in survival contrasts\"}],\"status\":\"recommended\",\"status_label\":\"Recommended\",\"tags\":[\"Time until an event\",\"RMST(1) - RMST(0)\",\"Recommended\"],\"title\":\"Unadjusted restricted mean survival contrast\",\"what_it_assumes\":[{\"explain_key\":\"assumption.exchangeability\",\"explains\":\"Treated and untreated units are comparable once you condition on the confounders you measured. Everything that pushed people towards treatment and also moves the outcome is in your adjustment set.\",\"id\":\"exchangeability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Exchangeability / no unmeasured confounding\",\"worry_when\":\"Treatment was chosen by people who knew something about the likely outcome that you do not observe. Clinical judgement, self-selection into a programme, and administrative triage are the classic cases.\"},{\"explain_key\":\"assumption.positivity\",\"explains\":\"Every kind of unit had some chance of being treated and some chance of not being treated. Where that fails, there is no comparison to make and the model is inventing one.\",\"id\":\"positivity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Positivity / overlap\",\"worry_when\":\"Any single weight carries a large share of the total; the effective sample is far below the nominal one; the propensity model separates the arms almost perfectly; treated units sit outside the control group's range.\"},{\"explain_key\":\"assumption.survival_consistency\",\"explains\":\"Observed event times must agree with the potential event times under the treatment actually received, with meaningful treatment versions.\",\"id\":\"survival_consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined baseline intervention\",\"worry_when\":null},{\"explain_key\":\"assumption.survival_no_interference\",\"explains\":\"One person's event time is assumed unaffected by other people's treatment assignments.\",\"id\":\"survival_no_interference\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No interference between people\",\"worry_when\":null},{\"explain_key\":\"assumption.conditional_independent_censoring\",\"explains\":\"Given baseline treatment and covariates, censoring must not convey additional information about the unobserved event time.\",\"id\":\"conditional_independent_censoring\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Independent censoring conditional on treatment and baseline covariates\",\"worry_when\":null}],\"when_not_to_use\":[\"Single event, right censoring, baseline treatment and independent subjects only. Time zero and event definition must agree across groups. A sparse tail, informative censoring, competing events or confounding invalidates a naive causal reading.\"],\"when_to_use\":[\"An absolute time contrast does not rely on proportional hazards, but still relies on within-arm censoring assumptions.\"]},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"survival.rmst\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"survival.rmst\",\"registry\":{\"designs\":[\"survival\"],\"diagnostics\":[\"survival_followup\",\"survival_censoring\",\"survival_curves\",\"survival_heterogeneity\"],\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":true,\"r\":false},\"estimands\":[\"RMST_difference\"],\"explain_key\":\"method.survival.rmst\",\"id\":\"survival.rmst\",\"needs\":[\"numpy\",\"scipy\"],\"needs_overlap\":false,\"one_liner\":\"Compare areas under observed Kaplan–Meier curves through a common horizon in time units; this is an unadjusted association.\",\"options\":[{\"default\":[],\"help\":\"Optional: one prespecified categorical baseline column with 2–8 observed levels. Tests differences between treatment contrasts on the selected scale at the chosen horizon. No automatic cutpoint search.\",\"label\":\"Baseline subgroup modifier\",\"max_items\":1,\"name\":\"subgroups\",\"profile\":\"beginner\",\"type\":\"columns\"},{\"default\":false,\"help\":\"Confirm only when the modifier was measured before treatment and its analysis was specified before inspecting outcomes. Your declaration is recorded but cannot verify the study design.\",\"label\":\"Modifier is baseline and analysis was prespecified\",\"name\":\"subgroups_prespecified\",\"profile\":\"beginner\",\"type\":\"bool\"},{\"choices\":[\"days\",\"weeks\",\"months\",\"years\"],\"default\":null,\"help\":\"Choose explicitly. Follow-up duration and the common horizon must use the same time unit.\",\"label\":\"Duration time unit\",\"name\":\"time_unit\",\"profile\":\"beginner\",\"type\":\"select\"},{\"default\":null,\"help\":\"Choose a positive time in the duration column's units, supported in both groups. Set before viewing the contrast. Required for survival/RMST; unused for the conditional time ratio.\",\"label\":\"Common follow-up horizon\",\"min\":0,\"name\":\"horizon\",\"profile\":\"beginner\",\"type\":\"number\"},{\"default\":100,\"help\":\"Seeded independent-subject resampling; increase for a less noisy interval.\",\"label\":\"Bootstrap resamples\",\"max\":2000,\"min\":20,\"name\":\"bootstrap_reps\",\"profile\":\"standard\",\"type\":\"int\"},{\"default\":0.95,\"label\":\"Confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"standard\",\"type\":\"number\"}],\"probes\":[],\"reference_dispositions\":[{\"disposition\":\"resolved_metadata\",\"id\":\"kaplan1958\",\"requested_as\":\"Kaplan and Meier (1958), Nonparametric Estimation from Incomplete Observations\"},{\"disposition\":\"resolved_metadata\",\"id\":\"uno2014\",\"requested_as\":\"Uno et al. (2014), Moving Beyond the Hazard Ratio in Quantifying the Between-Group Difference in Survival Analysis\"}],\"reference_ids\":[\"kaplan1958\",\"uno2014\"],\"references\":[\"Kaplan and Meier (1958), Nonparametric Estimation from Incomplete Observations\",\"Uno et al. (2014), Moving Beyond the Hazard Ratio in Quantifying the Between-Group Difference in Survival Analysis\"],\"roles_forbidden\":[\"entry\",\"start\",\"stop\",\"competing_event\",\"censoring\",\"cluster\",\"weight\",\"strata\",\"time\"],\"roles_optional\":[\"unit\"],\"roles_required\":[\"treatment\",\"duration\",\"event\"],\"source_path\":\"engines/python/capy_py/survival.py\",\"source_sha256\":\"87715ef1c40348535ad9e46db59851f0b6530b69f5970a4f2c7a0041f68f80ba\",\"status\":\"recommended\",\"title\":\"Unadjusted restricted mean survival contrast\",\"what_can_go_wrong\":\"Single event, right censoring, baseline treatment and independent subjects only. Time zero and event definition must agree across groups. A sparse tail, informative censoring, competing events or confounding invalidates a naive causal reading.\",\"why_recommended\":\"An absolute time contrast does not rely on proportional hazards, but still relies on within-arm censoring assumptions.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:08bcb2fddce50a419329339c\",\"object_id\":\"concept:rmst\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:uno2014\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_edi