review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"survival.rmst\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Consult the method card and exact claim qualifications before treating conceptual coverage as implementation support.\"],\"counterevidence\":[],\"gaps\":[\"No independent human scientific review or study-specific causal identification is established.\"],\"id\":\"relation:e17d15c16ed6ae6b0cde6cfa\",\"object_id\":\"concept:aft-interaction\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:wei1992\",\"source:ontology:r-survreg\",\"source:ontology:kent2020\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Qualified methodological context for this declared method; this link does not assert an implemented test or identifying assumption.\",\"subject_id\":\"survival.rmst\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"A separate identification argument is needed to interpret arm contrasts causally.\",\"Conditional censoring given extra covariates does not replace within-arm independent censoring for the raw procedure.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:eff89fde12aa8b147f1e4255\",\"object_id\":\"assumption:exchangeability\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Additional causal-interpretation context; not a sufficient condition for raw arm-specific Kaplan–Meier observation or an assumption established by this associational estimator.\",\"subject_id\":\"survival.rmst\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Consult the method card and exact claim qualifications before treating conceptual coverage as implementation support.\"],\"counterevidence\":[],\"gaps\":[\"No independent human scientific review or study-specific causal identification is established.\"],\"id\":\"relation:f4d9897fbd61ebc3e00298c4\",\"object_id\":\"concept:direct-heterogeneity-test\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:altman2003\",\"source:ontology:statsmodels-wald\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capyba