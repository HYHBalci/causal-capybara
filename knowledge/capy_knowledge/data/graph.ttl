<urn:capy:source%3Aproject-ontology> a capy:source ; skos:prefLabel "Original supplemental causal ontology" ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/ontology.json\",\"disposition\":\"original_ontology\",\"id\":\"source:project-ontology\",\"kind\":\"source\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_version\":\"sha256:27b14e32df9c1b540c22b4287f5fa59ad10b74953b62bbde510a181cb8718520\",\"summary\":\"Project-authored navigation, explanations and audit questions. Coverage and review are scoped per record; no whole-file scientific review is implied.\",\"title\":\"Original supplemental causal ontology\",\"url\":\"https://github.com/HYHBalci/causal-capybara/blob/ontology/knowledge/seed/ontology.json\"}" ; capy:ontologyMetadata "{\"audits\":[{\"concept_ids\":[\"concept:confounder\",\"concept:collider\",\"concept:mediator\",\"concept:missing-data\"],\"conditions\":[\"An authorized auditor must inspect the actual implementation and study design.\"],\"gaps\":[\"No code inspection, execution result, diagnostic acceptance or human approval is implied by this checklist.\"],\"id\":\"audit:adjustment\",\"method_ids\":[],\"question\":\"Do exclusions, imputation and adjustment preserve the target and avoid post-treatment, collider or selection conditioning?\",\"required_evidence\":[\"Covariate derivations\",\"Missingness/exclusion counts\",\"Formula or feature matrix construction\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Methodological implementation review; factual findings require authorized code and study evidence.\",\"source_ids\":[\"source:ontology:pearl2009\",\"source:ontology:imai2010\",\"bang2005\"],\"title\":\"Inspect adjustment and missingness\"},{\"concept_ids\":[\"concept:cate-blp\",\"concept:cate-calibration\",\"concept:gates\",\"concept:rate-heterogeneity\"],\"conditions\":[\"Apply only to the implemented analysis and declared target.\"],\"gaps\":[\"No audit result, diagnostic acceptance or human approval is implied.\"],\"id\":\"audit:cate-evaluation\",\"method_ids\":[\"ml.dml_plr\",\"ml.dml_irm\",\"ml.causal_forest\",\"ml.metalearner\",\"ml.policy_tree\",\"obs.tmle\"],\"question\":\"Do BLP, calibration, GATES and ranking summaries use the declared target scores and honest evaluation, with local simplifications disclosed?\",\"required_evidence\":[\"Training, nuisance and evaluation row/fold assignments\",\"Target score construction and propensity overlap\",\"Grouping/ranking construction without evaluation-outcome leakage\",\"Calibration null zero versus one and explicit covariance\",\"Conditional ranking-bootstrap scope and full-learning uncertainty limitations\"],\"review\":{\"actor\"