s\",\"provenance\":[\"source:note:rd-local\",\"source:ontology:cattaneo2022\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:cattaneo2022\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped original methodological explanation; no whole-method or study audit is implied.\",\"subject_id\":\"claim:rd-local\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"The stated cutoff design and local target conditions apply.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:909fa95e78863f437a477d94\",\"object_id\":\"rd.kink\",\"predicate\":\"qualifies\",\"provenance\":[\"source:note:rd-local\",\"source:ontology:cattaneo2022\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:cattaneo2022\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped original methodological explanation; no whole-method or study audit is implied.\",\"subject_id\":\"claim:rd-local\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:cattaneo2022\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped original methodological explanation; no whole-method or study audit is implied.\",\"source_ids\":[\"source:note:rd-local\",\"source:ontology:cattaneo2022\"],\"summary\":\"Regression discontinuity is a local design. Continuity-based, local-randomization, fuzzy and kink analyses rely on different conditions and targets. Inspect the running variable, threshold rule, treatment discontinuity, bandwidth and uncertainty procedure. Density and covariate-balance diagnostics can reveal problems, but a failure to reject cannot establish all required smoothness or assignment conditions. Extrapolation away from the cutoff needs an additional argument.\",\"title\":\"RD targets depend on the cutoff design and estimator\"}" .
