<urn:capy:claim%3Adid-support> a capy:claim ; skos:prefLabel "DiD comparison support and omitted cells" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Adid> ; capy:record "{\"aliases\":[\"no untreated comparison\",\"comparison support\",\"skipped cells\",\"not yet treated controls\"],\"assertion_mode\":\"original_editorial_explanation\",\"citation_ids\":[\"callaway2021\",\"source:note:did\"],\"citations\":[],\"conditions\":[\"Comparison units are unaffected over relevant periods.\",\"Baseline and target outcomes are observed for the chosen comparison.\",\"Conditional adjustment has relevant overlap.\"],\"counterevidence\":[\"Changing labels cannot supply an absent comparison.\",\"A fallback to not-yet-treated controls changes the comparison contract and must be disclosed.\"],\"evidence_ids\":[\"evidence:did-support\"],\"gaps\":[\"Aggregates cover supported cells rather than an invented complete panel of effects.\"],\"id\":\"claim:did-support\",\"kind\":\"claim\",\"provenance\":[\"source:note:did\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:69a2b78787f4dbad8c8e0e6d\",\"object_id\":\"source:note:did\",\"predicate\":\"cites\",\"provenance\":[\"source:note:did\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/did_modern.py\",\"tests/python/test_did_modern.py\",\"https://arxiv.org/html/1803.09015v4\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party 