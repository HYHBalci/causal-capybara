<urn:capy:claim%3Adid-twfe-heterogeneity> a capy:claim ; skos:prefLabel "TWFE heterogeneity and already-treated controls" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Adid> ; capy:record "{\"aliases\":[\"two way fixed effects\",\"TWFE\",\"already treated controls\",\"Sun Abraham\",\"lead lag contamination\"],\"assertion_mode\":\"original_editorial_explanation\",\"citation_ids\":[\"bacon2021\",\"source:note:did\",\"sun2021\"],\"citations\":[],\"conditions\":[\"Staggered adoption with the described two-way fixed-effects comparisons.\",\"Heterogeneous or time-varying treatment effects can affect interpretation.\"],\"counterevidence\":[\"TWFE can be appropriate under additional restrictions; it is not universally invalid.\",\"Adding unit and period fixed effects alone does not establish the desired causal average.\"],\"evidence_ids\":[\"evidence:did-twfe-heterogeneity\"],\"gaps\":[\"A specific regression's weights and comparison structure require study-level inspection.\"],\"id\":\"claim:did-twfe-heterogeneity\",\"kind\":\"claim\",\"provenance\":[\"source:note:did\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:0763a3278efdc286d56aeffb\",\"object_id\":\"bacon2021\",\"predicate\":\"cites\",\"provenance\":[\"source:note:did\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/did_modern.py\",\"tests/python/test_did_modern.py\",\"https://doi.org/10.1016/j.jeconom.2021.03.014\",\"https://arxiv.org/html/1804.05785v2\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":t