},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:d89fe08a2d7f0dede3158be7\",\"object_id\":\"diagnostic:differential_attrition\",\"predicate\":\"checked_by_diagnostic\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"rct.randomization_inference\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:d8e892bcdcff70b4e143f1c1\",\"object_id\":\"concept:synthetic-control\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"abadie2010\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"rct.randomization_inference\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:d8ea1d2f0ebb62979c12a075\",\"object_id\":\"bounds.manski\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"rct.randomization_inference\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:dfd1f88ef87108e4c916e552\",\"object_id\":\"concept:observational-design\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:rubin2008\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"rct.randomization_inference\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:e213645b04ab73a64a6c337e\",\"object_id\":\"concept:randomization\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:rubin2008\",\"source:ontology:hudgens2008\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"rct.randomization_inference\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:f482800d57ed5d8524a4571c\",\"object_id\":\"interference.exposure\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"rct.randomization_inference\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Re-run the randomisation thousands of times with the outcomes held fixed, and see how unusual what actually happened really is.\",\"title\":\"Randomisation (Fisher) inference\"}" .
<urn:capy:rct.stratified> a capy:method ; skos:prefLabel "Blocked or stratified experiment" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:rct.stratified\"],\"catalogue_key\":\"method:rct.stratified\",\"citation_ids\":[\"10.1111/j.1467-9868.2012.01048.x\",\"source:unresolved:12d5c830da10862dd1b8\",\"source:unresolved:7c987a4a1033b8e9971b\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":null,\"engines\":{\"python\":true,\"r\":\"estimatr (difference_in_means with blocks), randomizr\"},\"needs_r_packages\":[\"estimatr (difference_in_means with blocks), randomizr\"],\"runs_here\":true,\"summary\":\"Runs on this computer with what the app already installs.\"},\"designs\":[{\"explain_key\":\"design.rct\",\"id\":\"rct\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"People were assigned by chance, or as good as chance.\",\"title\":\"Randomised or as-if randomised\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.baseline_balance\",\"id\":\"baseline_balance\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Baseline balance\"},{\"explain_key\":\"diagnostic.block_structure\",\"id\":\"block_structure\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Block structure\"},{\"explain_key\":\"diagnostic.block_weighting\",\"id\":\"block_weighting\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Block weights\"},{\"explain_key\":\"diagnostic.differential_attrition\",\"id\":\"differential_attrition\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Differential attrition\"},{\"explain_key\":\"diagnostic.outcome_distribution\",\"id\":\"outcome_distribution\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Outcome distribution\"}],\"estimands\":[{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"},{\"acronym\":\"ITT\",\"explain_key\":\"estimand.itt\",\"id\":\"ITT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For everyone who was offered it, what did the offer do?\",\"title\":\"Intention to treat\"}],\"explain_key\":\"method.rct.stratified\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"rct.stratified\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":false,\"one_liner\":\"Estimate inside the blocks the randomisation was run in, then average them the way your estimand says to.\",\"options\":[{\"choices\":[\"block_weighted\",\"fixed_effects\"],\"default\":\"block_weighted\",\"help\":\"Block-weighted gives every unit the same say and estimates the ATE. Block fixed effects weights blocks by how precisely they estimate their own effect, which is a different quantity whenever the treated share varies across blocks.\",\"label\":\"How to average the blocks\",\"name\":\"estimator\",\"profile\":\"standard\",\"type\":\"select\"},{\"default\":false,\"help\":\"Those blocks contribute a contrast but no within-block variance. Dropping them makes the standard error honest and the estimand narrower; both choices appear in the sample flow.\",\"label\":\"Drop blocks with one unit in an arm\",\"name\":\"drop_singleton_blocks\",\"profile\":\"advanced\",\"type\":\"bool\"},{\"default\":null,\"help\":\"Used when the blocks are not already on the design board. Several columns are combined into one block key.\",\"label\":\"Blocking variables\",\"name\":\"blocks\",\"profile\":\"advanced\",\"type\":\"columns\"},{\"choices\":[\"HC0\",\"HC1\",\"HC2\",\"HC3\"],\"default\":\"HC2\",\"help\":\"HC2 is the default because for a two-arm contrast it reproduces Neyman's variance exactly. HC3 is more conservative in small samples; HC1 is the Stata default.\",\"label\":\"Robust variance\",\"name\":\"vcov\",\"profile\":\"advanced\",\"type\":\"select\"},{\"default\":0.95,\"help\":\"The coverage of the interval reported next to the estimate.\",\"label\":\"Confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"}],\"plain_language\":\"Estimate inside the blocks the randomisation was run in, then average them the way your estimand says to.\",\"probes\":[{\"explain_key\":\"probe.placebo_outcome\",\"id\":\"probe.placebo_outcome\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the same analysis on something the treatment could not have changed. It should find nothing.\",\"requested_as\":\"placebo_outcome\",\"title\":\"Placebo outcome\"},{\"explain_key\":\"probe.alternate_spec\",\"id\":\"probe.alternate_spec\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the grid of defensible specifications and sort the answers. The curve is the result, not the one you happened to run.\",\"requested_as\":\"alternate_spec\",\"title\":\"Specification curve\"},{\"explain_key\":\"probe.subset\",\"id\":\"probe.subset\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Re-estimate on random subsets. The answer should move about as much as losing that much data costs, and no more.\",\"requested_as\":\"subset_refuter\",\"title\":\"Subset stability\"},{\"explain_key\":\"method.rct.randomization_inference\",\"id\":\"rct.randomization_inference\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Re-run the randomisation thousands of times with the outcomes held fixed, and see how unusual what actually happened really is.\",\"requested_as\":\"randomization_inference\",\"title\":\"Randomisation (Fisher) inference\"}],\"references\":[\"Imbens and Rubin (2015), Causal Inference for Statistics, Social, and Biomedical Sciences, chapter 9\",\"Miratrix, Sekhon and Yu (2013), Adjusting Treatment Effect Estimates by Post-stratification in Randomized Experiments\",\"Gerber and Green (2012), Field Experiments: Design, Analysis, and Interpretation\"],\"roles_forbidden\":[\"an instrument\",\"a running variable\"],\"roles_optional\":[\"at least one measured confounder\",\"a clustering variable\"],\"roles_required\":[\"a treatment\",\"an outcome\",\"strata\"],\"see_also\":[{\"explain_key\":\"design.rct\",\"id\":\"rct\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"People were assigned by chance, or as good as chance.\",\"title\":\"Randomised or as-if randomised\"},{\"explain_key\":\"method.bounds.manski\",\"id\":\"bounds.manski\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Report the range the effect must lie in given only what the data can support, without assuming away the missing counterfactual.\",\"title\":\"Manski bounds\"},{\"explain_key\":\"method.interference.exposure\",\"id\":\"interference.exposure\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"When one unit's treatment affects another's outcome, estimate the direct and spillover effects separately instead of pretending neither exists.\",\"title\":\"Interference and spillovers\"},{\"explain_key\":\"method.rct.cace\",\"id\":\"rct.cace\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Not everyone offered a programme takes it. Report what the offer did, and separately what taking it up did for the people it moved.\",\"title\":\"ITT and CACE (noncompliance)\"},{\"explain_key\":\"method.rct.cluster\",\"id\":\"rct.cluster\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"When whole schools, clinics or villages were assigned, the number of clusters is the sample size that matters.\",\"title\":\"Cluster-randomised trial\"},{\"explain_key\":\"method.rct.diff_means\",\"id\":\"rct.diff_means\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Compare the two arms as they were randomised, and let covariates sharpen the comparison without letting them change the question.\",\"title\":\"Difference in means\"},{\"explain_key\":\"method.rct.randomization_inference\",\"id\":\"rct.randomization_inference\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Re-run the randomisation thousands of times with the outcomes held fixed, and see how unusual what actually happened really is.\",\"title\":\"Randomisation (Fisher) inference\"}],\"status\":\"recommended\",\"status_label\":\"Recommended\",\"tags\":[\"Randomised or as-if randomised\",\"ATE\",\"ITT\",\"Recommended\"],\"title\":\"Blocked or stratified experiment\",\"what_it_assumes\":[{\"explain_key\":\"assumption.randomisation\",\"explains\":\"Assignment really was by chance, and nothing after assignment broke the comparison -- no differential dropout, no crossover you have not modelled.\",\"id\":\"randomisation\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Randomisation held\",\"worry_when\":\"Dropout differs across arms; take-up is far from assignment; the randomiser was a person with discretion.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"when_not_to_use\":[\"Block fixed effects silently report a precision-weighted average rather than the ATE when the treated share differs across blocks. Blocks with one unit in an arm give no within-block variance, so the standard error leans on a pooled approximation this adapter names in its printout. Blocks with only one arm are dropped, which narrows the population the estimate describes.\",\"The blocks were not part of the randomisation -- blocking after the fact on a variable measured post-treatment is not stratification.\"],\"when_to_use\":[\"Randomisation was run inside blocks, so the comparison has to be made inside them too. Ignoring the blocks throws away precision; averaging them the wrong way changes the estimand.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"rct.stratified\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"rct.stratified\",\"registry\":{\"designs\":[\"rct\"],\"diagnostics\":[\"baseline_balance\",\"block_structure\",\"block_weighting\",\"differential_attrition\",\"outcome_distribution\"],\"disrecommend_when\":\"The blocks were not part of the randomisation -- blocking after the fact on a variable measured post-treatment is not stratification.\",\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":true,\"r\":\"estimatr (difference_in_means with blocks), randomizr\"},\"estimands\":[\"ATE\",\"ITT\"],\"explain_key\":\"method.rct.stratified\",\"id\":\"rct.stratified\",\"needs\":[\"numpy\",\"pandas\",\"scipy\"],\"needs_overlap\":false,\"one_liner\":\"Estimate inside the blocks the randomisation was run in, then average them the way your estimand says to.\",\"options\":[{\"choices\":[\"block_weighted\",\"fixed_effects\"],\"default\":\"block_weighted\",\"help\":\"Block-weighted gives every unit the same say and estimates the ATE. Block fixed effects weights blocks by how precisely they estimate their own effect, which is a different quantity whenever the treated share varies across blocks.\",\"label\":\"How to average the blocks\",\"name\":\"estimator\",\"profile\":\"standard\",\"type\":\"select\"},{\"default\":false,\"help\":\"Those blocks contribute a contrast but no within-block variance. Dropping them makes the standard error honest and the estimand narrower; both choices appear in the sample flow.\",\"label\":\"Drop blocks with one unit in an arm\",\"name\":\"drop_singleton_blocks\",\"profile\":\"advanced\",\"type\":\"bool\"},{\"default\":null,\"help\":\"Used when the blocks are not already on the design board. Several columns are combined into one block key.\",\"label\":\"Blocking variables\",\"name\":\"blocks\",\"profile\":\"advanced\",\"type\":\"columns\"},{\"choices\":[\"HC0\",\"HC1\",\"HC2\",\"HC3\"],\"default\":\"HC2\",\"help\":\"HC2 is the default because for a two-arm contrast it reproduces Neyman's variance exactly. HC3 is more conservative in small samples; HC1 is the Stata default.\",\"label\":\"Robust variance\",\"name\":\"vcov\",\"profile\":\"advanced\",\"type\":\"select\"},{\"default\":0.95,\"help\":\"The coverage of the interval reported next to the estimate.\",\"label\":\"Confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"}],\"probes\":[\"placebo_outcome\",\"alternate_spec\",\"subset_refuter\",\"randomization_inference\"],\"reference_dispositions\":[{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:7c987a4a1033b8e9971b\",\"requested_as\":\"Imbens and Rubin (2015), Causal Inference for Statistics, Social, and Biomedical Sciences, chapter 9\"},{\"disposition\":\"resolved_metadata\",\"id\":\"10.1111/j.1467-9868.2012.01048.x\",\"requested_as\":\"Miratrix, Sekhon and Yu (2013), Adjusting Treatment Effect Estimates by Post-stratification in Randomized Experiments\"},{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:12d5c830da10862dd1b8\",\"requested_as\":\"Gerber and Green (2012), Field Experiments: Design, Analysis, and Interpretation\"}],\"reference_ids\":[\"source:unresolved:7c987a4a1033b8e9971b\",\"10.1111/j.1467-9868.2012.01048.x\",\"source:unresolved:12d5c830da10862dd1b8\"],\"references\":[\"Imbens and Rubin (2015), Causal Inference for Statistics, Social, and Biomedical Sciences, chapter 9\",\"Miratrix, Sekhon and Yu (2013), Adjusting Treatment Effect Estimates by Post-stratification in Randomized Experiments\",\"Gerber and Green (2012), Field Experiments: Design, Analysis, and Interpretation\"],\"roles_forbidden\":[\"instruments\",\"running\"],\"roles_optional\":[\"confounders\",\"cluster\"],\"roles_required\":[\"treatment\",\"outcome\",\"strata\"],\"source_path\":\"engines/python/capy_py/rct.py\",\"source_sha256\":\"ad0630960d6aaff7fdef9a290c97dcb094099f646bd6ff87151d786a5604baa8\",\"status\":\"recommended\",\"title\":\"Blocked or stratified experiment\",\"what_can_go_wrong\":\"Block fixed effects silently report a precision-weighted average rather than the ATE when the treated share differs across blocks. Blocks with one unit in an arm give no within-block variance, so the standard error leans on a pooled approximation this adapter names in its printout. Blocks with only one arm are dropped, which narrows the population the estimate describes.\",\"why_recommended\":\"Randomisation was run inside blocks, so the comparison has to be made inside them too. Ignoring the blocks throws away precision; averaging them the wrong way changes the estimand.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:00bf1679bd728bf5dc7bcda7\",\"object_id\":\"design:rct\",\"predicate\":\"compatible_with_design\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"rct.stratified\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:0528ee11ad7efd88ee4b5d8a\",\"object_id\":\"concept:difference-in-differences\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"abadie2005\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"rct.stratified\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:09069bfea45b