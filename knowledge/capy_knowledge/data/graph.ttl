<urn:capy:probe.honest_did> a capy:probe ; skos:prefLabel "Honest DiD (Rambachan-Roth)" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"probe:probe.honest_did\"],\"catalogue_key\":\"probe:probe.honest_did\",\"citation_ids\":[\"10.1257/aeri.20210236\",\"source:unresolved:71b5b6774a9eb466304f\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":null,\"engines\":{\"python\":true,\"r\":\"HonestDiD\"},\"needs_r_packages\":[\"HonestDiD\"],\"runs_here\":true,\"summary\":\"Runs on this computer with what the app already installs.\"},\"designs\":[{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.honest_did\",\"id\":\"honest_did\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Honest DiD breakdown value\"},{\"explain_key\":\"diagnostic.pre_trend_size\",\"id\":\"pre_trend_size\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Size of the pre-trend\"}],\"estimands\":[{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"},{\"acronym\":\"ATT(g,t)\",\"explain_key\":\"estimand.cohort_att\",\"id\":\"cohort_ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For each group that adopted it, what did their own rollout do?\",\"title\":\"Group-time average treatment effect\"}],\"explain_key\":\"probe.honest_did\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"probe.honest_did\",\"in_more_depth\":null,\"kind\":\"probe\",\"needs_overlap\":false,\"one_liner\":\"What survives when parallel trends is allowed to fail by a stated amount.\",\"options\":[{\"default\":null,\"help\":\"The number this probe is about. Filled in automatically when the probe is launched from a result.\",\"label\":\"Parent estimate\",\"name\":\"parent_estimate\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":null,\"help\":\"Used to place the parent's confidence interval on the same scale.\",\"label\":\"Parent standard error\",\"min\":0.0,\"name\":\"parent_se\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":null,\"help\":\"Which analysis this probe is attached to. Some probes re-run it to get the fitted model rather than just the number.\",\"label\":\"Parent method\",\"name\":\"parent_method\",\"profile\":\"advanced\",\"type\":\"string\"},{\"default\":null,\"help\":\"Rows of {time, estimate, se}. Left empty, the probe re-runs did.event_study.\",\"label\":\"Event-study coefficients\",\"name\":\"event_study\",\"profile\":\"advanced\",\"type\":\"list\"},{\"default\":null,\"help\":\"Needed to average post-treatment periods honestly; the coefficients are correlated.\",\"label\":\"Coefficient covariance matrix\",\"name\":\"event_study_vcov\",\"profile\":\"advanced\",\"type\":\"list\"},{\"default\":[0.0,0.25,0.5,0.75,1.0,1.5,2.0],\"help\":\"Mbar = 1 means the post-treatment violation is no larger than the largest pre-treatment one.\",\"label\":\"Mbar grid\",\"name\":\"mbar_grid\",\"profile\":\"standard\",\"type\":\"list\"},{\"default\":[0.0,0.25,0.5,1.0,1.5,2.0],\"help\":\"In units of the largest pre-treatment wobble.\",\"label\":\"Smoothness grid\",\"name\":\"m_grid\",\"profile\":\"advanced\",\"type\":\"list\"},{\"choices\":[\"first\",\"average\"],\"default\":\"first\",\"label\":\"Effect to make robust\",\"name\":\"target\",\"profile\":\"standard\",\"type\":\"select\"},{\"default\":-1.0,\"label\":\"Reference period\",\"name\":\"ref_period\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":true,\"label\":\"Also report the smoothness bound\",\"name\":\"smoothness\",\"profile\":\"advanced\",\"type\":\"bool\"},{\"default\":0.0,\"help\":\"0 treats the pre-treatment coefficients as known, which is how honest DiD is usually reported. A positive value buys guaranteed coverage at the cost of a much wider interval.\",\"label\":\"Error budget spent bounding the pre-treatment path\",\"max\":0.049,\"min\":0.0,\"name\":\"alpha_pre\",\"profile\":\"advanced\",\"type\":\"number\"}],\"plain_language\":\"What survives when parallel trends is allowed to fail by a stated amount.\",\"probes\":[],\"references\":[\"Rambachan & Roth (2023), A more credible approach to parallel trends, Review of Economic Studies 90(5)\",\"Roth (2022), Pretest with caution: event-study estimates after testing for parallel trends\"],\"roles_forbidden\":[\"forbidden\"],\"roles_optional\":[\"a treatment\",\"a clustering variable\",\"at least one measured confounder\"],\"roles_required\":[\"an outcome\",\"a unit id\",\"a time variable\"],\"see_also\":[{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"},{\"explain_key\":\"method.did.bjs_imputation\",\"id\":\"did.bjs_imputation\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Learn what untreated life looks like from untreated cells only, then ask how far each treated cell landed from it.\",\"title\":\"Imputation (Borusyak-Jaravel-Spiess)\"},{\"explain_key\":\"method.did.callaway_santanna\",\"id\":\"did.callaway_santanna\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Estimate one clean before-and-after for every adoption cohort, then say out loud how you averaged them.\",\"title\":\"Callaway & Sant'Anna group-time effects\"},{\"explain_key\":\"method.did.chaisemartin\",\"id\":\"did.chaisemartin\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"An estimator built for panels where treatment switches on and off, which the imputation and cohort estimators assume never happens.\",\"title\":\"de Chaisemartin & D'Haultfoeuille\"},{\"explain_key\":\"method.did.dr_did\",\"id\":\"did.dr_did\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"One before-and-after with covariates, using an outcome model and a comparison-group model together so either one can carry it.\",\"title\":\"Doubly robust DiD\"},{\"explain_key\":\"method.did.event_study\",\"id\":\"did.event_study\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Plot the effect period by period around adoption, so you can see whether the gap opened when the policy arrived or long before it.\",\"title\":\"Event study (leads and lags)\"},{\"explain_key\":\"method.did.gardner_2s\",\"id\":\"did.gardner_2s\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Strip out unit and period effects using untreated cells only, then regress what is left on the policy.\",\"title\":\"Two-stage DiD (Gardner / Wooldridge-Mundlak)\"}],\"status\":\"recommended\",\"status_label\":\"Recommended\",\"tags\":[\"Policy rolled out over time\",\"ATT\",\"ATT(g,t)\",\"Recommended\"],\"title\":\"Honest DiD (Rambachan-Roth)\",\"what_it_assumes\":[{\"explain_key\":\"assumption.parallel_trends\",\"explains\":\"Without the policy, treated and comparison groups would have moved the same way. Not that they were at the same level -- that their paths would have been parallel.\",\"id\":\"parallel_trends\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Parallel trends\",\"worry_when\":\"Pre-period event-study coefficients drift away from zero; the policy was adopted because outcomes were already moving; the groups differ in composition in ways that interact with time.\"},{\"explain_key\":\"assumption.no_anticipation\",\"explains\":\"Units did not change behaviour before treatment arrived because they knew it was coming.\",\"id\":\"no_anticipation\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No anticipation\",\"worry_when\":\"There was a public announcement well before the policy started, or the pre-period coefficients move in the period immediately before adoption.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"when_not_to_use\":[\"Relative magnitudes measures post-treatment violations against pre-treatment ones, so a shock that starts with the policy is invisible to it. The confidence sets here are conservative by construction and wider than the conditional and hybrid sets in the original paper.\",\"There is no pre-treatment period to measure violations against\"],\"when_to_use\":[\"A flat pre-trend plot is not evidence of parallel trends, and a pre-trend test is weakest exactly when it matters. This reports what the conclusion survives instead of pretending the assumption was checked.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"probe.honest_did\",\"kind\":\"probe\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"probe.honest_did\",\"registry\":{\"designs\":[\"did\"],\"diagnostics\":[\"honest_did\",\"pre_trend_size\"],\"disrecommend_when\":\"There is no pre-treatment period to measure violations against\",\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":true,\"r\":\"HonestDiD\"},\"estimands\":[\"ATT\",\"cohort_ATT\"],\"explain_key\":\"probe.honest_did\",\"id\":\"probe.honest_did\",\"needs\":[\"numpy\",\"scipy\",\"pandas\"],\"needs_overlap\":false,\"one_liner\":\"What survives when parallel trends is allowed to fail by a stated amount.\",\"options\":[{\"default\":null,\"help\":\"The number this probe is about. Filled in automatically when the probe is launched from a result.\",\"label\":\"Parent estimate\",\"name\":\"parent_estimate\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":null,\"help\":\"Used to place the parent's confidence interval on the same scale.\",\"label\":\"Parent standard error\",\"min\":0.0,\"name\":\"parent_se\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":null,\"help\":\"Which analysis this probe is attached to. Some probes re-run it to get the fitted model rather than just the number.\",\"label\":\"Parent method\",\"name\":\"parent_method\",\"profile\":\"advanced\",\"type\":\"string\"},{\"default\":null,\"help\":\"Rows of {time, estimate, se}. Left empty, the probe re-runs did.event_study.\",\"label\":\"Event-study coefficients\",\"name\":\"event_study\",\"profile\":\"advanced\",\"type\":\"list\"},{\"default\":null,\"help\":\"Needed to average post-treatment periods honestly; the coefficients are correlated.\",\"label\":\"Coefficient covariance matrix\",\"name\":\"event_study_vcov\",\"profile\":\"advanced\",\"type\":\"list\"},{\"default\":[0.0,0.25,0.5,0.75,1.0,1.5,2.0],\"help\":\"Mbar = 1 means the post-treatment violation is no larger than the largest pre-treatment one.\",\"label\":\"Mbar grid\",\"name\":\"mbar_grid\",\"profile\":\"standard\",\"type\":\"list\"},{\"default\":[0.0,0.25,0.5,1.0,1.5,2.0],\"help\":\"In units of the largest pre-treatment wobble.\",\"label\":\"Smoothness grid\",\"name\":\"m_grid\",\"profile\":\"advanced\",\"type\":\"list\"},{\"choices\":[\"first\",\"average\"],\"default\":\"first\",\"label\":\"Effect to make robust\",\"name\":\"target\",\"profile\":\"standard\",\"type\":\"select\"},{\"default\":-1.0,\"label\":\"Reference period\",\"name\":\"ref_period\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":true,\"label\":\"Also report the smoothness bound\",\"name\":\"smoothness\",\"profile\":\"advanced\",\"type\":\"bool\"},{\"default\":0.0,\"help\":\"0 treats the pre-treatment coefficients as known, which is how honest DiD is usually reported. A positive value buys guaranteed coverage at the cost of a much wider interval.\",\"label\":\"Error budget spent bounding the pre-treatment path\",\"max\":0.049,\"min\":0.0,\"name\":\"alpha_pre\",\"profile\":\"advanced\",\"type\":\"number\"}],\"probes\":[],\"reference_dispositions\":[{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:71b5b6774a9eb466304f\",\"requested_as\":\"Rambachan & Roth (2023), A more credible approach to parallel trends, Review of Economic Studies 90(5)\"},{\"disposition\":\"resolved_metadata\",\"id\":\"10.1257/aeri.20210236\",\"requested_as\":\"Roth (2022), Pretest with caution: event-study estimates after testing for parallel trends\"}],\"reference_ids\":[\"source:unresolved:71b5b6774a9eb466304f\",\"10.1257/aeri.20210236\"],\"references\":[\"Rambachan & Roth (2023), A more credible approach to parallel trends, Review of Economic Studies 90(5)\",\"Roth (2022), Pretest with caution: event-study estimates after testing for parallel trends\"],\"roles_forbidden\":[\"forbidden\"],\"roles_optional\":[\"treatment\",\"cluster\",\"confounders\"],\"roles_required\":[\"outcome\",\"unit\",\"time\"],\"source_path\":\"engines/python/capy_py/sensitivity.py\",\"source_sha256\":\"2d17c4ca3660d99d91eb0d3bb715c2164c82cc3fe8c8b3d0cf21a2d54c733d8b\",\"status\":\"recommended\",\"title\":\"Honest DiD (Rambachan-Roth)\",\"what_can_go_wrong\":\"Relative magnitudes measures post-treatment violations against pre-treatment ones, so a shock that starts with the policy is invisible to it. The confidence sets here are conservative by construction and wider than the conditional and hybrid sets in the original paper.\",\"why_recommended\":\"A flat pre-trend plot is not evidence of parallel trends, and a pre-trend test is weakest exactly when it matters. This reports what the conclusion survives instead of pretending the assumption was checked.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:0bc14db6c9d1cc8dfc0e8a11\",\"object_id\":\"concept:design-before-outcome\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:rubin2008\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"probe.honest_did\"},{\"assertion_mode\":\"editorial\",\"con