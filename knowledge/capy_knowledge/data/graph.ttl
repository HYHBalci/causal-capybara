\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:pearl2009\",\"source:ontology:ich2019\",\"source:ontology:rubin2008\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Citation and original explanation; linked external bodies are not included.\",\"subject_id\":\"claim:causal-framing\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:pearl2009\",\"source:ontology:ich2019\",\"source:ontology:rubin2008\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped original methodological explanation; no whole-method or study audit is implied.\",\"source_ids\":[\"source:note:causal-framing\",\"source:ontology:pearl2009\",\"source:ontology:ich2019\",\"source:ontology:rubin2008\"],\"summary\":\"A regression coefficient, balanced covariates, a fitted graph or an accurately predicted outcome is not by itself an identified causal effect. Name the intervention, target population, endpoint and contrast, then state which design and assumptions connect them to an observed-data functional. When that argument is unavailable, report an association or model prediction. Computational verification and source links do not establish a study’s exchangeability.\",\"title\":\"Causal framing requires an identification argument\"}" .
