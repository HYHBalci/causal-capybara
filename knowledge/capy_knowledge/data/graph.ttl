<urn:capy:study%3Aproject_star> a capy:study ; skos:prefLabel "Project STAR, as it was run" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"study:project_star\",\"citation_ids\":[],\"citations\":[],\"content\":{\"caveat\":\"Published in the GPL-licensed AER package. Fetched to your machine, never redistributed here.\",\"citation\":\"Mosteller (1995); Krueger (1999).\",\"citation_url\":\"https://doi.org/10.2307/1602360\",\"design\":{\"explain_key\":\"design.rct\",\"id\":\"rct\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"People were assigned by chance, or as good as chance.\",\"title\":\"Randomised or as-if randomised\"},\"difficulty\":\"start here\",\"estimand\":{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"},\"explain_key\":null,\"gaps\":[],\"id\":\"project_star\",\"kind\":\"study\",\"one_liner\":\"blocked randomisation and the clustering the data will not give you\",\"plain_language\":\"Tennessee pupils randomised to small or regular kindergarten classes within their own school. The blocks are part of the design, not an afterthought.\",\"provenance\":{\"data_origin\":\"Published study data, fetched from source. Not redistributed by this project.\",\"downloads_from\":[\"https://vincentarelbundock.github.io/Rdatasets/csv/AER/STAR.csv\"],\"licences\":[\"GPL-2 | GPL-3\"],\"rights\":\"GPL-2 | GPL-3 via AER, Kleiber & Zeileis\",\"source\":\"real\",\"study\":\"Tennessee Student/Teacher Achievement Ratio experiment\",\"truth\":\"This is the study data, not a simulation. There is no built-in answer to check the estimators against -- which is the whole reason to work with it.\"},\"question\":\"Tennessee pupils randomised to small or regular kindergarten classes within their own school. The blocks are part of the design, not an afterthought.\",\"rows\":6325,\"see_also\":[{\"explain_key\":\"design.rct\",\"id\":\"rct\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"People were assigned by chance, or as good as chance.\",\"title\":\"Randomised or as-if randomised\"},{\"explain_key\":\"method.rct.stratified\",\"id\":\"rct.stratified\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Estimate inside the blocks the randomisation was run in, then average them the way your estimand says to.\",\"title\":\"Blocked or stratified experiment\"},{\"explain_key\":\"method.rct.cluster\",\"id\":\"rct.cluster\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"When whole schools, clinics or villages were assigned, the number of clusters is the sample size that matters.\",\"title\":\"Cluster-randomised trial\"},{\"explain_key\":\"method.rct.diff_means\",\"id\":\"rct.diff_means\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Compare the two arms as they were randomised, and let covariates sharpen the comparison without letting them change the question.\",\"title\":\"Difference in means\"}],\"suggested_methods\":[{\"explain_key\":\"method.rct.stratified\",\"id\":\"rct.stratified\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Estimate inside the blocks the randomisation was run in, then average them the way your estimand says to.\",\"title\":\"Blocked or stratified experiment\"},{\"explain_key\":\"method.rct.cluster\",\"id\":\"rct.cluster\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"When whole schools, clinics or villages were assigned, the number of clusters is the sample size that matters.\",\"title\":\"Cluster-randomised trial\"},{\"explain_key\":\"method.rct.diff_means\",\"id\":\"rct.diff_means\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Compare the two arms as they were randomised, and let covariates sharpen the comparison without letting them change the question.\",\"title\":\"Difference in means\"}],\"ta