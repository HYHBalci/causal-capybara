<urn:capy:study%3Acard_college> a capy:study ; skos:prefLabel "Growing up near a college" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"study:card_college\",\"citation_ids\":[],\"citations\":[],\"content\":{\"caveat\":\"\",\"citation\":\"Card (1995), in Aspects of Labour Market Behaviour.\",\"citation_url\":\"https://doi.org/10.3386/w4483\",\"design\":{\"explain_key\":\"design.iv\",\"id\":\"iv\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"An instrument or encouragement changed treatment, not the outcome directly.\",\"title\":\"Something else pushed people in\"},\"difficulty\":\"medium\",\"estimand\":{\"acronym\":\"LATE\",\"explain_key\":\"estimand.late\",\"id\":\"LATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who only got it because of the instrument or the cutoff, what did it do?\",\"title\":\"Local average treatment effect\"},\"explain_key\":null,\"gaps\":[],\"id\":\"card_college\",\"kind\":\"study\",\"one_liner\":\"a real instrument, its first stage, and what LATE means here\",\"plain_language\":\"College proximity as an instrument for years of schooling, and schooling for wages. The exclusion restriction is an argument, not a test.\",\"provenance\":{\"data_origin\":\"Published study data, fetched from source. Not redistributed by this project.\",\"downloads_from\":[\"https://vincentarelbundock.github.io/Rdatasets/csv/causaldata/close_college.csv\"],\"licences\":[\"MIT\"],\"rights\":\"MIT via causaldata, Huntington-Klein et al.\",\"source\":\"real\",\"study\":\"Card (1995), NLS Young Men\",\"truth\":\"This is the study data, not a simulation. There is no built-in answer to check the estimators against -- which is the whole reason to work with it.\"},\"question\":\"College proximity as an instrument for years of schooling, and schooling for wages. The exclusion restriction is an argument, not a test.\",\"rows\":3010,\"see_also\":[{\"explain_key\":\"design.iv\",\"id\":\"iv\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"An instrument or encouragement changed treatment, not the outcome directly.\",\"title\":\"Something else pushed people in\"},{\"explain_key\":\"method.iv.2sls\",\"id\":\"iv.2sls\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Use only the part of the treatment that the instrument moved, and see what happened to the outcome.\",\"title\":\"Two-stage least squares\"},{\"explain_key\":\"method.iv.weak_robust\",\"id\":\"iv.weak_robust\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Report the set of effects the data cannot reject, which stays honest however weak the instrument is.\",\"title\":\"Weak-instrument-robust confidence set\"}],\"suggested_methods\":[{\"explain_key\":\"method.iv.2sls\",\"id\":\"iv.2sls\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Use only the part of the treatment that the instrument moved, and see what happened to the outcome.\",\"title\":\"Two-stage least squares\"},{\"explain_key\":\"method.iv.weak_robust\",\"id\":\"iv.weak_robust\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Report the set of effects the data cannot reject, which stays honest however weak the instrument is.\",\"title\":\"Weak-instrument-robust confidence set\"}],\"tags\":[\"Something else pushed people in\",\"medium\"],\"teaches\":\"a real instrument, its first stage, and what LATE means here\",\"title\":\"Growing up near a college\",\"tour\":[]},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"study:card_college\",\"kind\":\"study\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"card_college\",\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:04f0124883c3087ba8924424\",\"object_id\":\"iv.2sls\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_revi