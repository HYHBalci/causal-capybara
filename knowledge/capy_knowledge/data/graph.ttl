cense_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Original scoped methodological guidance for Grouped average treatment effects; not a completed study audit or universal method support.\",\"source_ids\":[\"source:ontology:genericml\"],\"summary\":\"GATES summarizes effects in groups formed by a learned effect score. Score construction, grouping and evaluation require a defensible split or cross-fitting scheme; descriptive bins from reused outcomes do not inherit formal GATES inference.\",\"title\":\"Grouped average treatment effects\"}" .
<urn:capy:concept%3Agestimation> a capy:concept ; skos:prefLabel "G-estimation" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-ontology> ; capy:ontologyRole "method_idea" ; capy:record "{\"aliases\":[],\"assertion_mode\":\"original_editorial_context\",\"citation_ids\":[\"source:ontology:robins2000\"],\"citations\":[],\"conditions\":[],\"counterevidence\":[],\"evidence_basis\":\"Original project explanation with linked sources; not an exact reviewed claim/evidence group.\",\"gaps\":[\"Independent human semantic review and study-specific evidence are absent.\"],\"id\":\"concept:gestimation\",\"kind\":\"concept\",\"ontology_role\":\"method_idea\",\"provenance\":[\"source:project-ontology\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:483961076b6074d70d0f9d6e\",\"object_id\":\"concept:causal-longitudinal\",\"predicate\":\"broader\",\"provenance\":[\"source:project-ontology\",\"source:ontology:robins2000\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Qualified conceptual navigation; related terms are not equivalent estimands or verified identifying conditions.\",\"subject_id\":\"concept:gestimation\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:99418d92ae52f8bf7c244e62\",\"object_id\":\"source:ontology:robins2000\",\"predicate\":\"cites\",\"provenance\":[\"source:project-ontology\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Source context for original explanation; linked external bodies are not redistributed.\",\"subject_id\":\"concept:gestimation\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Original methodological context for G-estimation; not a study finding or a complete review of every implementation.\",\"source_ids\":[\"source:ontology:robins2000\"],\"summary\":\"G-estimation solves a structural-model identification problem using treatment-history restrictions; it is distinct from ordinary regression.\",\"title\":\"G-estimation\"}" .
<urn:capy:concept%3Aguardrail.bad_control> a capy:concept ; skos:prefLabel "Bad controls" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"concept:guardrail.bad_control\",\"citation_ids\":[],\"citations\":[],\"content\":{\"common_mistake\":null,\"explain_key\":\"guardrail.bad_control\",\"gaps\":[\"no citation\"],\"id\":\"guardrail.bad_control\",\"in_more_depth\":\"If a training programme raises earnings partly by raising the chance of being employed, then adjusting for employment removes that pathway from the estimate. The number you get is not the effect of the programme; it is the effect holding fixed one of the ways the programme works. Causal Capybara flags variables that look post-treatment -- by name, and by timing when the design has a time variable -- and marks them on the board. It does not remove them for you: the guardrail explains, and you decide. If you genuinely want the effect that does not run through a mediator, that is a controlled direct effect, and it is a different estimand with its own assumptions.\",\"kind\":\"concept\",\"one_liner\":\"Anything measured after treatment, or caused by it, does not belong in the adjustment set. Adjusting for it blocks part of the effect you are trying to measure.\",\"plain_language\":\"Anything measured after treatment, or caused by it, does not belong in the adjustment set. Adjusting for it blocks part of the effect you are trying to measure.\",\"references\":[],\"see_also\":[{\"explain_key\":\"concept.collider\",\"id\":\"concept.collider\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"A variable that two arrows point into. Conditioning on it creates an association between its causes that was not there before.\",\"title\":\"Colliders and why adjusting can hurt\"},{\"explain_key\":\"design.mediation\",\"id\":\"mediation\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"We care about a mediator, not only the total effect.\",\"title\":\"How it worked (pathways)\"},{\"explain_key\":\"assumption.exchangeability\",\"explains\":\"Treated and untreated units are comparable once you condition on the confounders you measured. Everything that pushed people towards treatment and also moves the outcome is in your adjustment set.\",\"id\":\"exchangeability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Exchangeability / no unmeasured confounding\",\"worry_when\":\"Treatment was chosen by people who knew something about the likely outcome that you do not observe. Clinical judgement, self-selection into a programme, and administrative triage are the classic cases.\"}],\"tags\":[],\"title\":\"Bad controls\",\"worry_when\":\"A covariate is named like a follow-up measurement; a covariate is dated after the treatment decision; adjusting for it moves the estimate a lot.\"},\"disposition\":\"imported\",\"gaps\":[\"no citation\"],\"id\":\"concept:guardrail.bad_control\",\"kind\":\"concept\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"guardrail.bad_control\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Anything measured after treatment, or caused by it, does not belong in the adjustment set. Adjusting for it blocks part of the effect you are trying to measure.\",\"title\":\"Bad controls\"}" .
