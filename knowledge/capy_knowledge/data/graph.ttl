display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"did.twfe\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"One regression with unit and period fixed effects. Familiar, fast, and not an average treatment effect when units adopt at different dates.\",\"title\":\"Two-way fixed effects\"}" .
<urn:capy:did.twoway_2x2> a capy:method ; skos:prefLabel "Difference-in-differences (2x2)" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:did.twoway_2x2\"],\"catalogue_key\":\"method:did.twoway_2x2\",\"citation_ids\":[\"10.1162/003355304772839588\",\"source:unresolved:65fdd16bf79636d10244\",\"source:unresolved:d8615b4f29a36cc03cc1\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":null,\"engines\":{\"python\":true,\"r\":\"fixest (or estimatr::lm_robust)\"},\"needs_r_packages\":[\"fixest (or estimatr::lm_robust)\"],\"runs_here\":true,\"summary\":\"Runs on this computer with what the app already installs.\"},\"designs\":[{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.raw_means\",\"id\":\"raw_means\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Raw means by cohort and period\"},{\"explain_key\":\"diagnostic.adoption\",\"id\":\"adoption\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Adoption pattern\"},{\"explain_key\":\"diagnostic.panel_balance\",\"id\":\"panel_balance\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Panel balance\"},{\"explain_key\":\"diagnostic.cell_means\",\"id\":\"cell_means\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Cell means\"},{\"explain_key\":\"diagnostic.event_study\",\"id\":\"event_study\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Event study\"},{\"explain_key\":\"diagnostic.pre_trends\",\"id\":\"pre_trends\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Pre-trend test\"}],\"estimands\":[{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"}],\"explain_key\":\"method.did.twoway_2x2\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\",\"some of the robustness probes it names have no card of their own yet\"],\"id\":\"did.twoway_2x2\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":false,\"one_liner\":\"Two groups, two periods: compare how much the treated group changed with how much the comparison group changed over the same window.\",\"options\":[{\"default\":0.95,\"help\":\"Width of the interval reported next to the estimate.\",\"label\":\"Confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":true,\"help\":\"Below 30 clusters the ordinary cluster-robust p-value rejects too often. This adds a restricted wild cluster bootstrap p-value in the Sensitivity tab.\",\"label\":\"Wild cluster bootstrap when clusters are few\",\"name\":\"wild_bootstrap\",\"profile\":\"advanced\",\"type\":\"bool\"},{\"default\":399,\"help\":\"Rademacher draws for the wild cluster bootstrap. Seeded by the run seed.\",\"label\":\"Bootstrap draws\",\"max\":9999,\"min\":99,\"name\":\"wild_reps\",\"profile\":\"advanced\",\"type\":\"int\"}],\"plain_language\":\"Two groups, two periods: compare how much the treated group changed with how much the comparison group changed over the same window.\",\"probes\":[{\"explain_key\":\"probe.placebo_outcome\",\"id\":\"probe.placebo_outcome\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the same analysis on something the treatment could not have changed. It should find nothing.\",\"requested_as\":\"placebo_outcome\",\"title\":\"Placebo outcome\"},{\"explain_key\":null,\"id\":\"placebo_period\",\"in_catalogue\":false,\"kind\":\"probe\",\"one_liner\":null,\"requested_as\":\"placebo_period\",\"title\":\"Placebo period\"},{\"explain_key\":\"probe.alternate_spec\",\"id\":\"probe.alternate_spec\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the grid of defensible specifications and sort the answers. The curve is the result, not the one you happened to run.\",\"requested_as\":\"alternate_spec\",\"title\":\"Specification curve\"},{\"explain_key\":null,\"id\":\"leave_one_out_unit\",\"in_catalogue\":false,\"kind\":\"probe\",\"one_liner\":null,\"requested_as\":\"leave_one_out_unit\",\"title\":\"Leave one unit out\"}],\"references\":[\"Card and Krueger (1994), Minimum Wages and Employment\",\"Angrist and Pischke (2009), Mostly Harmless Econometrics, ch. 5\",\"Bertrand, Duflo and Mullainathan (2004), How Much Should We Trust Differences-in-Differences Estimates?\"],\"roles_forbidden\":[\"a running variable\",\"an instrument\"],\"roles_optional\":[\"a clustering variable\",\"at least one measured confounder\",\"weight\"],\"roles_required\":[\"a treatment\",\"an outcome\",\"a unit id\",\"a time variable\"],\"see_also\":[{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"},{\"explain_key\":\"method.did.bjs_imputation\",\"id\":\"did.bjs_imputation\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Learn what untreated life looks like from untreated cells only, then ask how far each treated cell landed from it.\",\"title\":\"Imputation (Borusyak-Jaravel-Spiess)\"},{\"explain_key\":\"method.did.callaway_santanna\",\"id\":\"did.callaway_santanna\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Estimate one clean before-and-after for every adoption cohort, then say out loud how you averaged them.\",\"title\":\"Callaway & Sant'Anna group-time effects\"},{\"explain_key\":\"method.did.chaisemartin\",\"id\":\"did.chaisemartin\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"An estimator built for panels where treatment switches on and off, which the imputation and cohort estimators assume never happens.\",\"title\":\"de Chaisemartin & D'Haultfoeuille\"},{\"explain_key\":\"method.did.dr_did\",\"id\":\"did.dr_did\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"One before-and-after with covariates, using an outcome model and a comparison-group model together so either one can carry it.\",\"title\":\"Doubly robust DiD\"},{\"explain_key\":\"method.did.event_study\",\"id\":\"did.event_study\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Plot the effect period by period around adoption, so you can see whether the gap opened when the policy arrived or long before it.\",\"title\":\"Event study (leads and lags)\"},{\"explain_key\":\"method.did.gardner_2s\",\"id\":\"did.gardner_2s\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Strip out unit and period effects using untreated cells only, then regress what is left on the policy.\",\"title\":\"Two-stage DiD (Gardner / Wooldridge-Mundlak)\"}],\"status\":\"recommended\",\"status_label\":\"Recommended\",\"tags\":[\"Policy rolled out over time\",\"ATT\",\"Recommended\"],\"title\":\"Difference-in-differences (2x2)\",\"what_it_assumes\":[{\"explain_key\":\"assumption.parallel_trends\",\"explains\":\"Without the policy, treated and comparison groups would have moved the same way. Not that they were at the same level -- that their paths would have been parallel.\",\"id\":\"parallel_trends\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Parallel trends\",\"worry_when\":\"Pre-period event-study coefficients drift away from zero; the policy was adopted because outcomes were already moving; the groups differ in composition in ways that interact with time.\"},{\"explain_key\":\"assumption.no_anticipation\",\"explains\":\"Units did not change behaviour before treatment arrived because they knew it was coming.\",\"id\":\"no_anticipation\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No anticipation\",\"worry_when\":\"There was a public announcement well before the policy started, or the pre-period coefficients move in the period immediately before adoption.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"when_not_to_use\":[\"With two periods parallel trends cannot be tested at all -- you are asserting that the comparison group's change is what the treated group's change would have been. Few clusters make the confidence interval optimistic. Covariates enter linearly and additively only; there are no covariate-by-period interactions.\"],\"when_to_use\":[\"When one group is treated at one date, this is the whole design and everyone can see the four numbers it is made of. Nothing is hidden inside a fixed-effects machine.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\",\"some of the robustness probes it names have no card of their own yet\"],\"id\":\"did.twoway_2x2\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"did.twoway_2x2\",\"registry\":{\"designs\":[\"did\"],\"diagnostics\":[\"raw_means\",\"adoption\",\"panel_balance\",\"cell_means\",\"event_study\",\"pre_trends\"],\"disrecommend_when\":null,\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":true,\"r\":\"fixest (or estimatr::lm_robust)\"},\"estimands\":[\"ATT\"],\"explain_key\":\"method.did.twoway_2x2\",\"id\":\"did.twoway_2x2\",\"needs\":[\"numpy\",\"pandas\",\"scipy\"],\"needs_overlap\":false,\"one_liner\":\"Two groups, two periods: compare how much the treated group changed with how much the comparison group changed over the same window.\",\"options\":[{\"default\":0.95,\"help\":\"Width of the interval reported next to the estimate.\",\"label\":\"Confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":true,\"help\":\"Below 30 clusters the ordinary cluster-robust p-value rejects too often. This adds a restricted wild cluster bootstrap p-value in the Sensitivity tab.\",\"label\":\"Wild cluster bootstrap when clusters are few\",\"name\":\"wild_bootstrap\",\"profile\":\"advanced\",\"type\":\"bool\"},{\"default\":399,\"help\":\"Rademacher draws for the wild cluster bootstrap. Seeded by the run seed.\",\"label\":\"Bootstrap draws\",\"max\":9999,\"min\":99,\"name\":\"wild_reps\",\"profile\":\"advanced\",\"type\":\"int\"}],\"probes\":[\"placebo_outcome\",\"placebo_period\",\"alternate_spec\",\"leave_one_out_unit\"],\"reference_dispositions\":[{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:d8615b4f29a36cc03cc1\",\"requested_as\":\"Card and Krueger (1994), Minimum Wages and Employment\"},{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:65fdd16bf79636d10244\",\"requested_as\":\"Angrist and Pischke (2009), Mostly Harmless Econometrics, ch. 5\"},{\"disposition\":\"resolved_metadata\",\"id\":\"10.1162/003355304772839588\",\"requested_as\":\"Bertrand, Duflo and Mullainathan (2004), How Much Should We Trust Differences-in-Differences Estimates?\"}],\"reference_ids\":[\"source:unresolved:d8615b4f29a36cc03cc1\",\"source:unresolved:65fdd16bf79636d10244\",\"10.1162/003355304772839588\"],\"references\":[\"Card and Krueger (1994), Minimum Wages and Employment\",\"Angrist and Pischke (2009), Mostly Harmless Econometrics, ch. 5\",\"Bertrand, Duflo and Mullainathan (2004), How Much Should We Trust Differences-in-Differences Estimates?\"],\"roles_forbidden\":[\"running\",\"instruments\"],\"roles_optional\":[\"cluster\",\"confounders\",\"weight\"],\"roles_required\":[\"treatment\",\"outcome\",\"unit\",\"time\"],\"source_path\":\"engines/python/capy_py/did.py\",\"source_sha256\":\"6c4e72d00d337663377d0b86a9a96801e0bbc9813a8b50c74e66c5fab45398c2\",\"status\":\"recommended\",\"title\":\"Difference-in-differences (2x2)\",\"what_can_go_wrong\":\"With two periods parallel trends cannot be tested at all -- you are asserting that the comparison group's change is what the treated group's change would have been. Few clusters make the confidence interval optimistic. Covariates enter linearly and additively only; there are no covariate-by-period interactions.\",\"why_recommended\":\"When one group is treated at one date, this is the whole design and everyone can see the four numbers it is made of. Nothing is hidden inside a fixed-effects machine.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:058b53fc942e61383dad144d\",\"object_id\":\"10.1162/003355304772839588\",\"predicate\":\"cites\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/l