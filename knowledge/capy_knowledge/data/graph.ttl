<urn:capy:obs.superlearner> a capy:method ; skos:prefLabel "Super Learner nuisance models" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:obs.superlearner\"],\"catalogue_key\":\"method:obs.superlearner\",\"citation_ids\":[\"source:unresolved:9c43d263080175db3f0a\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":\"Not wrapped. The implemented cross-fitted estimators take a single learner per nuisance.\",\"engines\":{\"python\":false,\"r\":\"SuperLearner\"},\"needs_r_packages\":[\"SuperLearner\"],\"runs_here\":false,\"summary\":\"Not built into the app yet. The authoritative version is the R package SuperLearner, which the Engines screen can install for you.\"},\"designs\":[{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.nuisance_rmse\",\"id\":\"nuisance_rmse\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Nuisance models by fold\"},{\"explain_key\":\"diagnostic.fold_stability\",\"id\":\"fold_stability\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Stability across folds\"}],\"estimands\":[{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"},{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"}],\"explain_key\":\"method.obs.superlearner\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"obs.superlearner\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":false,\"one_liner\":\"Combine several candidate learners by cross-validated weights instead of betting on one.\",\"options\":[],\"plain_language\":\"Combine several candidate learners by cross-validated weights instead of betting on one.\",\"probes\":[{\"explain_key\":\"probe.cinelli_hazlett\",\"id\":\"probe.cinelli_hazlett\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"How strong would an unmeasured confounder have to be -- compared with the covariates you already have -- to explain the estimate away?\",\"requested_as\":\"probe.cinelli_hazlett\",\"title\":\"Cinelli-Hazlett sensitivity (partial R2)\"}],\"references\":[\"van der Laan, Polley & Hubbard (2007)\"],\"roles_forbidden\":[],\"roles_optional\":[],\"roles_required\":[\"a treatment\",\"an outcome\",\"at least one measured confounder\"],\"see_also\":[{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"},{\"explain_key\":\"method.bounds.manski\",\"id\":\"bounds.manski\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Report the range the effect must lie in given only what the data can support, without assuming away the missing counterfactual.\",\"title\":\"Manski bounds\"},{\"explain_key\":\"method.interference.exposure\",\"id\":\"interference.exposure\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"When one unit's treatment affects another's outcome, estimate the direct and spillover effects separately instead of pretending neither exists.\",\"title\":\"Interference and spillovers\"},{\"explain_key\":\"method.ml.causal_forest\",\"id\":\"ml.causal_forest\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Grow trees that look for units whose effect differs, keeping the rows that chose each split away from the rows that estimate it.\",\"title\":\"Honest causal forest\"},{\"explain_key\":\"method.ml.dml_irm\",\"id\":\"ml.dml_irm\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"A separate outcome model for each arm plus a treatment model, combined in a doubly robust score: right if either side is right.\",\"title\":\"Double ML (interactive)\"},{\"explain_key\":\"method.ml.dml_plr\",\"id\":\"ml.dml_plr\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Predict the outcome and the treatment from the confounders, then regress what is left of one on what is left of the other.\",\"title\":\"Double ML (partially linear)\"},{\"explain_key\":\"method.ml.metalearner\",\"id\":\"ml.metalearner\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Build the per-unit effect out of ordinary prediction models, four different ways, on the same cross-fitting.\",\"title\":\"Meta-learner (T, S, X, DR)\"}],\"status\":\"reasonable\",\"status_label\":\"Reasonable\",\"tags\":[\"Adjust for background differences\",\"ATE\",\"ATT\",\"Reasonable\"],\"title\":\"Super Learner nuisance models\",\"what_it_assumes\":[{\"explain_key\":\"assumption.exchangeability\",\"explains\":\"Treated and untreated units are comparable once you condition on the confounders you measured. Everything that pushed people towards treatment and also moves the outcome is in your adjustment set.\",\"id\":\"exchangeability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Exchangeability / no unmeasured confounding\",\"worry_when\":\"Treatment was chosen by people who knew something about the likely outcome that you do not observe. Clinical judgement, self-selection into a programme, and administrative triage are the classic cases.\"},{\"explain_key\":\"assumption.positivity\",\"explains\":\"Every kind of unit had some chance of being treated and some chance of not being treated. Where that fails, there is no comparison to make and the model is inventing one.\",\"id\":\"positivity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Positivity / overlap\",\"worry_when\":\"Any single weight carries a large share of the total; the effective sample is far below the nominal one; the propensity model separates the arms almost perfectly; treated units sit outside the control group's range.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"when_not_to_use\":[\"More machinery, more ways to leak information across folds, and no protection at all against unmeasured confounding.\"],\"when_to_use\":[\"Doubly robust estimators only deliver their promise if at least one nuisance model is close to right; an ensemble raises that chance without choosing in advance.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"obs.superlearner\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"obs.superlearner\",\"registry\":{\"coming\":\"Not wrapped. The implemented cross-fitted estimators take a single learner per nuisance.\",\"designs\":[\"observational\"],\"diagnostics\":[\"nuisance_rmse\",\"fold_stability\"],\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":false,\"r\":\"SuperLearner\"},\"estimands\":[\"ATE\",\"ATT\"],\"id\":\"obs.superlearner\",\"one_liner\":\"Combine several candidate learners by cross-validated weights instead of betting on one.\",\"probes\":[\"probe.cinelli_hazlett\"],\"r_needs\":[\"SuperLearner\"],\"reference_dispositions\":[{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:9c43d263080175db3f0a\",\"requested_as\":\"van der Laan, Polley & Hubbard (2007)\"}],\"reference_ids\":[\"source:unresolved:9c43d263080175db3f0a\"],\"references\":[\"van der Laan, Polley & Hubbard (2007)\"],\"roles_required\":[\"treatment\",\"outcome\",\"confounders\"],\"source_path\":\"engines/registry/methods.extra.yaml\",\"source_sha256\":\"2cb349e9f7f7e6f88c10c18d81478656fd420eda7ca977d9767610ac8c7a4be0\",\"status\":\"reasonable\",\"title\":\"Super Learner nuisance models\",\"what_can_go_wrong\":\"More machinery, more ways to leak information across folds, and no protection at all against unmeasured confounding.\",\"why_recommended\":\"Doubly robust estimators only deliver their promise if at least one nuisance model is close to right; an ensemble raises that chance without choosing in advance.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:0007b2acad53d55742807f61\",\"object_id\":\"assumption:consistency\",\"predicate\":\"requires_assumption\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"obs.superlearner\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:02efb443013d4ecc8f648981\",\"object_id\":\"softwarepackage:SuperLearner\",\"predicate\":\"implemented_by\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"obs.superlearner\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:12b407d9096f8b66975746e1\",\"object_id\":\"ml.causal_forest\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; 