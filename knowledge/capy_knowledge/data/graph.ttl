<urn:capy:discovery.structure_learning> a capy:method ; skos:prefLabel "Structure learning (causal discovery)" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:discovery.structure_learning\"],\"catalogue_key\":\"method:discovery.structure_learning\",\"citation_ids\":[\"source:unresolved:18ba78af040cefa63333\",\"source:unresolved:590ec230f43a8b1b259d\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":\"Gated behind Advanced and not implemented in this build. Causal Capybara leads with design-based inference on purpose.\",\"engines\":{\"python\":false,\"r\":\"pcalg\"},\"needs_r_packages\":[\"pcalg\"],\"runs_here\":false,\"summary\":\"Not built into the app yet. The authoritative version is the R package pcalg, which the Engines screen can install for you.\"},\"designs\":[{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"}],\"diagnostics\":[],\"estimands\":[],\"explain_key\":\"method.discovery.structure_learning\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\",\"no checks are listed for this method\",\"does not say which effect it estimates\"],\"id\":\"discovery.structure_learning\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":false,\"one_liner\":\"Search for a graph consistent with the data. It does not recover the true causal structure from observational data without extra assumptions.\",\"options\":[],\"plain_language\":\"Search for a graph consistent with the data. It does not recover the true causal structure from observational data without extra assumptions.\",\"probes\":[],\"references\":[\"Spirtes, Glymour & Scheines (2000)\",\"Peters, Janzing & Scholkopf (2017)\"],\"roles_forbidden\":[],\"roles_optional\":[],\"roles_required\":[],\"see_also\":[{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"}],\"status\":\"disrecommended\",\"status_label\":\"Usually the wrong choice\",\"tags\":[\"Adjust for background differences\",\"Usually the wrong choice\"],\"title\":\"Structure learning (causal discovery)\",\"what_it_assumes\":[{\"explain_key\":\"assumption.exchangeability\",\"explains\":\"Treated and untreated units are comparable once you condition on the confounders you measured. Everything that pushed people towards treatment and also moves the outcome is in your adjustment set.\",\"id\":\"exchangeability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Exchangeability / no unmeasured confounding\",\"worry_when\":\"Treatment was chosen by people who knew something about the likely outcome that you do not observe. Clinical judgement, self-selection into a programme, and administrative triage are the classic cases.\"},{\"explain_key\":\"assumption.positivity\",\"explains\":\"Every kind of unit had some chance of being treated and some chance of not being treated. Where that fails, there is no comparison to make and the model is inventing one.\",\"id\":\"positivity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Positivity / overlap\",\"worry_when\":\"Any single weight carries a large share of the total; the effective sample is far below the nominal one; the propensity model separates the arms almost perfectly; treated units sit outside the control group's range.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"when_not_to_use\":[\"Discovery algorithms return an equivalence class of graphs, not a graph, and the class is usually large. Different algorithms on the same data return different answers, and none of them can see a confounder you did not measure.\",\"Always, as a substitute for a design. It is a hypothesis generator behind a gate, and anything it produces lands as a candidate graph you must accept.\"],\"when_to_use\":[\"null\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\",\"no checks are listed for this method\",\"does not say which effect it estimates\"],\"id\":\"discovery.structure_learning\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"discovery.structure_learning\",\"registry\":{\"coming\":\"Gated behind Advanced and not implemented in this build. Causal Capybara leads with design-based inference on purpose.\",\"designs\":[\"observational\"],\"diagnostics\":[],\"disrecommend_when\":\"Always, as a substitute for a design. It is a hypothesis generator behind a gate, and anything it produces lands as a candidate graph you must accept.\",\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":false,\"r\":\"pcalg\"},\"estimands\":[],\"id\":\"discovery.structure_learning\",\"one_liner\":\"Search for a graph consistent with the data. It does not recover the true causal structure from observational data without extra assumptions.\",\"probes\":[],\"r_needs\":[\"pcalg\"],\"reference_dispositions\":[{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:590ec230f43a8b1b259d\",\"requested_as\":\"Spirtes, Glymour & Scheines (2000)\"},{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:18ba78af040cefa63333\",\"requested_as\":\"Peters, Janzing & Scholkopf (2017)\"}],\"reference_ids\":[\"source:unresolved:590ec230f43a8b1b259d\",\"source:unresolved:18ba78af040cefa63333\"],\"references\":[\"Spirtes, Glymour & Scheines (2000)\",\"Peters, Janzing & Scholkopf (2017)\"],\"roles_required\":[],\"source_path\":\"engines/registry/methods.extra.yaml\",\"source_sha256\":\"2cb349e9f7f7e6f88c10c18d81478656fd420eda7ca977d9767610ac8c7a4be0\",\"status\":\"disrecommended\",\"title\":\"Structure learning (causal discovery)\",\"what_can_go_wrong\":\"Discovery algorithms return an equivalence class of graphs, not a graph, and the class is usually large. Different algorithms on the same data return different answers, and none of them can see a confounder you did not measure.\",\"why_recommended\":\"null\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:00f1f15232b46fadccb8076d\",\"object_id\":\"concept:structural-causal-model\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:pearl2009\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a com