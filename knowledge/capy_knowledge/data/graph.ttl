-good-practices\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:rubin2008\",\"source:ontology:ich2019\",\"source:ontology:wilson2017\",\"source:ontology:sandve2013\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"med.natural_effects\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:bef0c8b2106add49b79f99d9\",\"object_id\":\"source:unresolved:32b7a739addbe8b46f2b\",\"predicate\":\"cites\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper 