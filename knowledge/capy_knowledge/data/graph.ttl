<urn:capy:did.triple_diff> a capy:method ; skos:prefLabel "Triple differences" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:did.triple_diff\"],\"catalogue_key\":\"method:did.triple_diff\",\"citation_ids\":[\"10.1093/ectj/utac010\",\"source:unresolved:498ea84a8c6c0795beb5\",\"source:unresolved:6e54466ed612f48a6469\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":null,\"engines\":{\"python\":true,\"r\":\"fixest::feols with three interacted fixed effects\"},\"needs_r_packages\":[\"fixest::feols with three interacted fixed effects\"],\"runs_here\":true,\"summary\":\"Runs on this computer with what the app already installs.\"},\"designs\":[{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.cell_means\",\"id\":\"cell_means\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Cell means\"},{\"explain_key\":\"diagnostic.raw_means\",\"id\":\"raw_means\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Raw means by cohort and period\"},{\"explain_key\":\"diagnostic.adoption\",\"id\":\"adoption\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Adoption pattern\"},{\"explain_key\":\"diagnostic.panel_balance\",\"id\":\"panel_balance\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Panel balance\"},{\"explain_key\":\"diagnostic.event_study\",\"id\":\"event_study\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Event study\"},{\"explain_key\":\"diagnostic.pre_trends\",\"id\":\"pre_trends\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Pre-trend test\"}],\"estimands\":[{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"}],\"explain_key\":\"method.did.triple_diff\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\",\"some of the robustness probes it names have no card of their own yet\"],\"id\":\"did.triple_diff\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":false,\"one_liner\":\"Compare the treated-versus-comparison difference for the group the policy could reach with the same difference for a group inside the same units that it could not.\",\"options\":[{\"default\":null,\"help\":\"A two-level indicator that splits each unit and period into a group the policy could affect and a group it could not. Defaults to the first strata variable.\",\"label\":\"Third dimension\",\"name\":\"third_dim\",\"profile\":\"standard\",\"type\":\"columns\"},{\"default\":-1,\"help\":\"Every coefficient is measured against this period, relative to adoption. -1 is the period just before treatment; choose -2 if you suspect the policy was anticipated.\",\"label\":\"Reference period\",\"max\":0,\"min\":-20,\"name\":\"ref_period\",\"profile\":\"standard\",\"type\":\"int\"},{\"default\":5,\"help\":\"Anything earlier is pooled into the first point, so no data is dropped.\",\"label\":\"Periods before adoption to show\",\"max\":30,\"min\":1,\"name\":\"max_lead\",\"profile\":\"standard\",\"type\":\"int\"},{\"default\":5,\"help\":\"Anything later is pooled into the last point, so no data is dropped.\",\"label\":\"Periods after adoption to show\",\"max\":30,\"min\":0,\"name\":\"max_lag\",\"profile\":\"standard\",\"type\":\"int\"},{\"default\":0.95,\"help\":\"Width of the interval reported next to the estimate.\",\"label\":\"Confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":true,\"help\":\"Below 30 clusters the ordinary cluster-robust p-value rejects too often. This adds a restricted wild cluster bootstrap p-value in the Sensitivity tab.\",\"label\":\"Wild cluster bootstrap when clusters are few\",\"name\":\"wild_bootstrap\",\"profile\":\"advanced\",\"type\":\"bool\"},{\"default\":399,\"help\":\"Rademacher draws for the wild cluster bootstrap. Seeded by the run seed.\",\"label\":\"Bootstrap draws\",\"max\":9999,\"min\":99,\"name\":\"wild_reps\",\"profile\":\"advanced\",\"type\":\"int\"}],\"plain_language\":\"Compare the treated-versus-comparison difference for the group the policy could reach with the same difference for a group inside the same units that it could not.\",\"probes\":[{\"explain_key\":\"probe.placebo_outcome\",\"id\":\"probe.placebo_outcome\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the same analysis on something the treatment could not have changed. It should find nothing.\",\"requested_as\":\"placebo_outcome\",\"title\":\"Placebo outcome\"},{\"explain_key\":null,\"id\":\"placebo_third_dim\",\"in_catalogue\":false,\"kind\":\"probe\",\"one_liner\":null,\"requested_as\":\"placebo_third_dim\",\"title\":\"Placebo on the third dimension\"},{\"explain_key\":\"probe.alternate_spec\",\"id\":\"probe.alternate_spec\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the grid of defensible specifications and sort the answers. The curve is the result, not the one you happened to run.\",\"requested_as\":\"alternate_spec\",\"title\":\"Specification curve\"}],\"references\":[\"Gruber (1994), The Incidence of Mandated Maternity Benefits\",\"Olden and Moen (2022), The triple difference estimator\",\"Ortiz-Villavicencio and Sant'Anna (2025), Better understanding triple differences estimators\"],\"roles_forbidden\":[\"a running variable\",\"an instrument\"],\"roles_optional\":[\"a clustering variable\",\"at least one measured confounder\"],\"roles_required\":[\"a treatment\",\"an outcome\",\"a unit id\",\"a time variable\",\"strata\"],\"see_also\":[{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"},{\"explain_key\":\"method.did.bjs_imputation\",\"id\":\"did.bjs_imputation\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Learn what untreated life looks like from untreated cells only, then ask how far each treated cell landed from it.\",\"title\":\"Imputation (Borusyak-Jaravel-Spiess)\"},{\"explain_key\":\"method.did.callaway_santanna\",\"id\":\"did.callaway_santanna\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Estimate one clean before-and-after for every adoption cohort, then say out loud how you averaged them.\",\"title\":\"Callaway & Sant'Anna group-time effects\"},{\"explain_key\":\"method.did.chaisemartin\",\"id\":\"did.chaisemartin\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"An estimator built for panels where treatment switches on and off, which the imputation and cohort estimators assume never happens.\",\"title\":\"de Chaisemartin & D'Haultfoeuille\"},{\"explain_key\":\"method.did.dr_did\",\"id\":\"did.dr_did\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"One before-and-after with covariates, using an outcome model and a comparison-group model together so either one can carry it.\",\"title\":\"Doubly robust DiD\"},{\"explain_key\":\"method.did.event_study\",\"id\":\"did.event_study\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Plot the effect period by period around adoption, so you can see whether the gap opened when the policy arrived or long before it.\",\"title\":\"Event study (leads and lags)\"},{\"explain_key\":\"method.did.gardner_2s\",\"id\":\"did.gardner_2s\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Strip out unit and period effects using untreated cells only, then regress what is left on the policy.\",\"title\":\"Two-stage DiD (Gardner / Wooldridge-Mundlak)\"}],\"status\":\"reasonable\",\"status_label\":\"Reasonable\",\"tags\":[\"Policy rolled out over time\",\"ATT\",\"Reasonable\"],\"title\":\"Triple differences\",\"what_it_assumes\":[{\"explain_key\":\"assumption.parallel_trends\",\"explains\":\"Without the policy, treated and comparison groups would have moved the same way. Not that they were at the same level -- that their paths would have been parallel.\",\"id\":\"parallel_trends\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Parallel trends\",\"worry_when\":\"Pre-period event-study coefficients drift away from zero; the policy was adopted because outcomes were already moving; the groups differ in composition in ways that interact with time.\"},{\"explain_key\":\"assumption.no_anticipation\",\"explains\":\"Units did not change behaviour before treatment arrived because they knew it was coming.\",\"id\":\"no_anticipation\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No anticipation\",\"worry_when\":\"There was a public announcement well before the policy started, or the pre-period coefficients move in the period immediately before adoption.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"when_not_to_use\":[\"It buys robustness with a new assumption: the gap between the two groups inside a unit must have been on parallel paths. If the policy also affected the supposedly unaffected group -- spillovers, general equilibrium -- the third difference subtracts part of the effect. Under staggered adoption the same weighting critique as two-way fixed effects applies, and there is no Callaway-Sant'Anna style version here.\",\"The third dimension does not vary inside a unit and period -- then it is effect heterogeneity across units, not a third difference.\"],\"when_to_use\":[\"When something else was happening in the treated units at the same time, the third difference sweeps it out: any shock that hit both groups inside a unit and period equally cancels. It rescues designs where plain parallel trends is not credible.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\",\"some of the robustness probes it names have no card of their own yet\"],\"id\":\"did.triple_diff\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"did.triple_diff\",\"registry\":{\"designs\":[\"did\"],\"diagnostics\":[\"cell_means\",\"raw_means\",\"adoption\",\"panel_balance\",\"event_study\",\"pre_trends\"],\"disrecommend_when\":\"The third dimension does not vary inside a unit and period -- then it is effect heterogeneity across units, not a third difference.\",\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":true,\"r\":\"fixest::feols with three interacted fixed effects\"},\"estimands\":[\"ATT\"],\"explain_key\":\"method.did.triple_diff\",\"id\":\"did.triple_diff\",\"needs\":[\"numpy\",\"pandas\",\"scipy\"],\"needs_overlap\":false,\"one_liner\":\"Compare the treated-versus-comparison difference for the group the policy could reach with the same difference for a group inside the same units that it could not.\",\"options\":[{\"default\":null,\"help\":\"A two-level indicator that splits each unit and period into a group the policy could affect and a group it could not. Defaults to the first strata variable.\",\"label\":\"Third dimension\",\"name\":\"third_dim\",\"profile\":\"standard\",\"type\":\"columns\"},{\"default\":-1,\"help\":\"Every coefficient is measured against this period, relative to adoption. -1 is the period just before treatment; choose -2 if you suspect the policy was anticipated.\",\"label\":\"Reference period\",\"max\":0,\"min\":-20,\"name\":\"ref_period\",\"profile\":\"standard\",\"type\":\"int\"},{\"default\":5,\"help\":\"Anything earlier is pooled into the first point, so no data is dropped.\",\"label\":\"Periods before adoption to show\",\"max\":30,\"min\":1,\"name\":\"max_lead\",\"profile\":\"standard\",\"type\":\"int\"},{\"default\":5,\"help\":\"Anything later is pooled into the last point, so no data is dropped.\",\"label\":\"Periods after adoption to show\",\"max\":30,\"min\":0,\"name\":\"max_lag\",\"profile\":\"standard\",\"type\":\"int\"},{\"default\":0.95,\"help\":\"Width of the interval reported next to the estimate.\",\"label\":\"Confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":true,\"help\":\"Below 30 clusters the ordinary cluster-robust p-value rejects too often. This adds a restricted wild cluster bootstrap p-value in the Sensitivity tab.\",\"label\":\"Wild cluster bootstrap when clusters are few\",\"name\":\"wild_bootstrap\",\"profile\":\"advanced\",\"type\":\"bool\"},{\"default\":399,\"help\":\"Rademacher draws for the wild cluster bootstrap. Seeded by the run seed.\",\"label\":\"Bootstrap draws\",\"max\":9999,\"min\":99,\"name\":\"wild_reps\",\"profile\":\"advanced\",\"type\":\"int\"}],\"probes\":[\"placebo_outcome\",\"placebo_third_dim\",\"alternate_spec\"],\"reference_dispositions\":[{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:6e54466ed612f48a6469\",\"requested_as\":\"Gruber (1994), The Incidence of Mandated Maternity Benefits\"},{\"disposition\":\"resolved_metadata\",\"id\":\"10.1093/ectj/utac010\",\"requested_as\":\"Olden and Moen (2022), The triple difference estimator\"},{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:498ea84a8c6c0795beb5\",\"requested_as\":\"Ortiz-Villavicencio and Sant'Anna (2025), Better understanding triple differences estimators\"}],\"reference_ids\":[\"source:unresolved:6e54466ed612f48a6469\",\"10.1093/ectj/utac010\",\"source:unresolved:498ea84a8c6c0795beb5\"],\"references\":[\"Gruber (1994), The Incidence of Mandated Maternity Benefits\",\"Olden and Moen (2022), The triple difference estimator\",\"Ortiz-Villavicencio and Sant'Anna (2025), Better understanding triple differences estimators\"],\"roles_forbidden\":[\"running\",\"instruments\"],\"roles_optional\":[\"cluster\",\"confounders\"],\"roles_required\":[\"treatment\",\"outcome\",\"unit\",\"time\",\"strata\"],\"source_path\":\"engines/python/capy_py/did.py\",\"source_sha256\":\"6c4e72d00d337663377d0b86a9a96801e0bbc9813a8b50c74e66c5fab45398c2\",\"status\":\"reasonable\",\"title\":\"Triple differences\",\"what_can_go_wrong\":\"It buys robustness with a new assumption: the gap between the two groups inside a unit must have been on parallel paths. If the policy also affected the supposedly unaffected group -- spillovers, general equilibrium -- the third difference subtracts part of the effect. Under staggered adoption the same weighting critique as two-way fixed effects applies, and there is no Callaway-Sant'Anna style version here.\",\"why_recommended\":\"When something else was happening in the treated units at the same time, the third difference sweeps it out: any shock that hit both groups inside a unit and period equally cancels. It rescues designs where plain parallel trends is not credible.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:0c9c7ced4585fb0789e3defb\",\"object_id\":\"concept:not-yet-treated\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"abadie2005\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"did.triple_diff\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:0ff4176245d19e471480dd37\",\"object_id\":\"concept:anticipation\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"abadie2005\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":f