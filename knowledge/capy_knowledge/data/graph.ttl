<urn:capy:sc.microsynth> a capy:method ; skos:prefLabel "Microsynth (many treated units)" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:sc.microsynth\"],\"catalogue_key\":\"method:sc.microsynth\",\"citation_ids\":[\"source:unresolved:725870b130b6c2b95b30\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":\"Not wrapped.\",\"engines\":{\"python\":false,\"r\":\"microsynth\"},\"needs_r_packages\":[\"microsynth\"],\"runs_here\":false,\"summary\":\"Not built into the app yet. The authoritative version is the R package microsynth, which the Engines screen can install for you.\"},\"designs\":[{\"explain_key\":\"design.synth\",\"id\":\"synth\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"One treated unit; build a comparison from a donor pool.\",\"title\":\"One place, constructed twin\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.sc_weights\",\"id\":\"sc_weights\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Donor weights\"},{\"explain_key\":\"diagnostic.sc_pre_fit\",\"id\":\"sc_pre_fit\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Pre-treatment fit\"},{\"explain_key\":\"diagnostic.sc_placebo_space\",\"id\":\"sc_placebo_space\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Placebo in space\"}],\"estimands\":[{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"}],\"explain_key\":\"method.sc.microsynth\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"sc.microsynth\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":false,\"one_liner\":\"Synthetic control when the treated unit is a neighbourhood or a small area and there are many of them.\",\"options\":[],\"plain_language\":\"Synthetic control when the treated unit is a neighbourhood or a small area and there are many of them.\",\"probes\":[{\"explain_key\":\"probe.leave_one_out\",\"id\":\"probe.leave_one_out\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Drop one cluster, cohort or donor at a time and see whether any single one is carrying the result.\",\"requested_as\":\"probe.leave_one_out\",\"title\":\"Leave one out\"}],\"references\":[\"Robbins, Saunders & Kilmer (2017)\"],\"roles_forbidden\":[],\"roles_optional\":[],\"roles_required\":[\"an outcome\",\"a unit id\",\"a time variable\"],\"see_also\":[{\"explain_key\":\"design.synth\",\"id\":\"synth\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"One treated unit; build a comparison from a donor pool.\",\"title\":\"One place, constructed twin\"},{\"explain_key\":\"method.did.synthdid_r\",\"id\":\"did.synthdid_r\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Weight both units and periods, then take a difference-in-differences -- halfway between synthetic control and DiD.\",\"title\":\"Synthetic difference-in-differences (synthdid)\"},{\"explain_key\":\"method.its.causal_impact\",\"id\":\"its.causal_impact\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Model the counterfactual series with a structural time-series model and control series, and report a posterior rather than an interval.\",\"title\":\"Bayesian structural time series (CausalImpact)\"},{\"explain_key\":\"method.sc.abadie\",\"id\":\"sc.abadie\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Build a weighted copy of the treated place out of untreated places that looked like it beforehand, then watch the two lines separate.\",\"title\":\"Synthetic control\"},{\"explain_key\":\"method.sc.augmented\",\"id\":\"sc.augmented\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"When no weighted average of the donors can match the treated place, correct the leftover bias with a ridge model and show the size of the correction.\",\"title\":\"Augmented synthetic control\"},{\"explain_key\":\"method.sc.matrix_completion\",\"id\":\"sc.matrix_completion\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Treat the missing treated-period outcomes as holes in a panel and fill them in with a low-rank model of what the panel would have done.\",\"title\":\"Matrix completion\"},{\"explain_key\":\"method.sc.scpi\",\"id\":\"sc.scpi\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Confidence intervals for a synthetic control that come from a model of the prediction error rather than from permutation.\",\"title\":\"Prediction intervals for synthetic control (scpi)\"}],\"status\":\"reasonable\",\"status_label\":\"Reasonable\",\"tags\":[\"One place, constructed twin\",\"ATT\",\"Reasonable\"],\"title\":\"Microsynth (many treated units)\",\"what_it_assumes\":[{\"explain_key\":\"assumption.donor_fit\",\"explains\":\"The weighted combination of untreated units reproduces the treated unit's pre-period path closely enough to stand in for it afterwards.\",\"id\":\"donor_fit\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Pre-treatment fit from the donor pool\",\"worry_when\":\"Visible pre-period gaps; a short pre-period relative to the number of donors; one donor carrying most of the weight.\"},{\"explain_key\":\"assumption.convex_hull\",\"explains\":\"The treated unit's characteristics can be written as a weighted average of the donors', with weights that do not go negative.\",\"id\":\"convex_hull\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Treated unit inside the donor convex hull\",\"worry_when\":\"The treated unit is at an extreme of the donor distribution on the predictors, or the pre-period gap has a persistent level offset.\"},{\"explain_key\":\"assumption.no_anticipation\",\"explains\":\"Units did not change behaviour before treatment arrived because they knew it was coming.\",\"id\":\"no_anticipation\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No anticipation\",\"worry_when\":\"There was a public announcement well before the policy started, or the pre-period coefficients move in the period immediately before adoption.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"}],\"when_not_to_use\":[\"Calibrating on many variables at once can produce weights that fit the past perfectly and predict the future badly.\"],\"when_to_use\":[\"Built for the case classic synthetic control was not: many small treated units with administrative data.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"sc.microsynth\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"sc.microsynth\",\"registry\":{\"coming\":\"Not wrapped.\",\"designs\":[\"synth\"],\"diagnostics\":[\"sc_weights\",\"sc_pre_fit\",\"sc_placebo_space\"],\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":false,\"r\":\"microsynth\"},\"estimands\":[\"ATT\"],\"id\":\"sc.microsynth\",\"one_liner\":\"Synthetic control when the treated unit is a neighbourhood or a small area and there are many of them.\",\"probes\":[\"probe.leave_one_out\"],\"r_needs\":[\"microsynth\"],\"reference_dispositions\":[{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:725870b130b6c2b95b30\",\"requested_as\":\"Robbins, Saunders & Kilmer (2017)\"}],\"reference_ids\":[\"source:unresolved:725870b130b6c2b95b30\"],\"references\":[\"Robbins, Saunders & Kilmer (2017)\"],\"roles_required\":[\"outcome\",\"unit\",\"time\"],\"source_path\":\"engines/registry/methods.extra.yaml\",\"source_sha256\":\"2cb349e9f7f7e6f88c10c18d81478656fd420eda7ca977d9767610ac8c7a4be0\",\"status\":\"reasonable\",\"title\":\"Microsynth (many treated units)\",\"what_can_go_wrong\":\"Calibrating on many variables at once can produce weights that fit the past perfectly and predict the future badly.\",\"why_recommended\":\"Built for the case classic synthetic control was not: many small treated units with administrative data.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:086a54b73490692976077cb7\",\"object_id\":\"sc.matrix_completion\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"sc.microsynth\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:09f4dd5bbe982d7551f734b3\",\"object_id\":\"concept:causal-framing\",\"predicate\":\"related_to\",\"provenanc