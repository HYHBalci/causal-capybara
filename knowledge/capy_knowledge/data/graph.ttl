-good-practices\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:rubin2008\",\"source:ontology:ich2019\",\"source:ontology:wilson2017\",\"source:ontology:sandve2013\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"med.controlled_direct\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:d1f77486b20b054a561e7f80\",\"object_id\":\"concept:natural-effects\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:imai2010\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"med.controlled_direct\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:dac7ea3ec32f1424a85873c2\",\"object_id\":\"estimand:CDE\",\"predicate\":\"targets_estimand\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"med.controlled_direct\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:de5a7338041798f45332862b\",\"object_id\":\"design:mediation\",\"predicate\":\"compatible_with_design\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"med.controlled_direct\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"What the treatment would still do if the mediator were fixed at one value for everybody.\",\"title\":\"Controlled direct effect\"}" .
<urn:capy:med.interventional> a capy:method ; skos:prefLabel "Interventional direct and indirect effects" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:med.interventional\"],\"catalogue_key\":\"method:med.interventional\",\"citation_ids\":[\"10.1097/ede.0000000000000034\",\"10.1097/ede.0000000000000596\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":null,\"engines\":{\"python\":true,\"r\":\"CMAverse\"},\"needs_r_packages\":[\"CMAverse\"],\"runs_here\":true,\"summary\":\"Runs on this computer with what the app already installs.\"},\"designs\":[{\"explain_key\":\"design.mediation\",\"id\":\"mediation\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"We care about a mediator, not only the total effect.\",\"title\":\"How it worked (pathways)\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.temporal_ordering\",\"id\":\"temporal_ordering\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Temporal ordering of covariates\"},{\"explain_key\":\"diagnostic.mediation_decomposition\",\"id\":\"mediation_decomposition\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Total = direct + indirect\"},{\"explain_key\":\"diagnostic.multiple_mediators\",\"id\":\"multiple_mediators\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Multiple mediators\"},{\"explain_key\":\"diagnostic.treatment_mediator_interaction\",\"id\":\"treatment_mediator_interaction\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Treatment-mediator interaction\"}],\"estimands\":[{\"acronym\":null,\"explain_key\":null,\"id\":\"IIE\",\"in_catalogue\":false,\"kind\":\"estimand\",\"one_liner\":null,\"title\":\"Interventional indirect effect\"},{\"acronym\":null,\"explain_key\":null,\"id\":\"IDE\",\"in_catalogue\":false,\"kind\":\"estimand\",\"one_liner\":null,\"title\":\"Interventional direct effect\"},{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"}],\"explain_key\":\"method.med.interventional\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\",\"targets Interventional indirect effect and Interventional direct effect, which the estimand catalogue does not define yet\"],\"id\":\"med.interventional\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":true,\"one_liner\":\"Shift the mediator to the distribution it would have in the population, rather than to each person's own unobservable counterfactual.\",\"options\":[{\"default\":true,\"label\":\"Let the mediator's effect depend on treatment\",\"name\":\"interaction\",\"profile\":\"standard\",\"type\":\"bool\"},{\"default\":500,\"label\":\"Bootstrap draws\",\"max\":5000,\"min\":100,\"name\":\"bootstrap_reps\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":100,\"label\":\"Simulation draws per unit\",\"max\":2000,\"min\":20,\"name\":\"mc_draws\",\"profile\":\"advanced\",\"type\":\"int\"}],\"plain_language\":\"Shift the mediator to the distribution it would have in the population, rather than to each person's own unobservable counterfactual.\",\"probes\":[{\"explain_key\":\"probe.subset\",\"id\":\"probe.subset\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Re-estimate on random subsets. The answer should move about as much as losing that much data costs, and no more.\",\"requested_as\":\"probe.subset\",\"title\":\"Subset stability\"},{\"explain_key\":\"probe.random_common_cause\",\"id\":\"probe.random_common_cause\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Add a variable that causes nothing to the adjustment set. The estimate should barely move.\",\"requested_as\":\"probe.random_common_cause\",\"title\":\"Random common cause\"},{\"explain_key\":\"probe.cinelli_hazlett\",\"id\":\"probe.cinelli_hazlett\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"How strong would an unmeasured confounder have to be -- compared with the covariates you already have -- to explain the estimate away?\",\"requested_as\":\"probe.cinelli_hazlett\",\"title\":\"Cinelli-Hazlett sensitivity (partial R2)\"},{\"explain_key\":\"probe.alternate_spec\",\"id\":\"probe.alternate_spec\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the grid of defensible specifications and sort the answers. The curve is the result, not the one you happened to run.\",\"requested_as\":\"probe.alternate_spec\",\"title\":\"Specification curve\"}],\"references\":[\"VanderWeele, Vansteelandt & Robins (2014), Effect decomposition in the presence of an exposure-induced mediator-outcome confounder\",\"Vansteelandt & Daniel (2017), Interventional effects for mediation analysis with multiple mediators\"],\"roles_forbidden\":[],\"roles_optional\":[\"at least one measured confounder\",\"forbidden\",\"weight\",\"a clustering variable\"],\"roles_required\":[\"a treatment\",\"a mediator\",\"an outcome\"],\"see_also\":[{\"explain_key\":\"design.mediation\",\"id\":\"mediation\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"We care about a mediator, not only the total effect.\",\"title\":\"How it worked (pathways)\"},{\"explain_key\":\"method.med.natural_effects\",\"id\":\"med.natural_effects\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Split the total effect into the part that travelled through the mediator and the part that did not.\",\"title\":\"Natural direct and indirect effects\"}],\"status\":\"recommended\",\"status_label\":\"Recommended\",\"tags\":[\"How it worked (pathways)\",\"Interventional indirect effect\",\"Interventional direct effect\",\"ATE\",\"Recommended\"],\"title\":\"Interventional direct and indirect effects\",\"what_it_assumes\":[{\"explain_key\":\"assumption.sequential_ignorability\",\"explains\":\"No unmeasured confounding of the treatment-outcome relationship, and none of the mediator-outcome relationship either, even after conditioning on treatment.\",\"id\":\"sequential_ignorability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Sequential ignorability\",\"worry_when\":\"There is a variable affected by treatment that also confounds the mediator-outcome relationship. Under that structure the natural effects are not identified at all.\"},{\"explain_key\":\"assumption.exchangeability\",\"explains\":\"Treated and untreated units are comparable once you condition on the confounders you measured. Everything that pushed people towards treatment and also moves the outcome is in your adjustment set.\",\"id\":\"exchangeability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Exchangeability / no unmeasured confounding\",\"worry_when\":\"Treatment was chosen by people who knew something about the likely outcome that you do not observe. Clinical judgement, self-selection into a programme, and administrative triage are the classic cases.\"},{\"explain_key\":\"assumption.positivity\",\"explains\":\"Every kind of unit had some chance of being treated and some chance of not being treated. Where that fails, there is no comparison to make and the model is inventing one.\",\"id\":\"positivity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Positivity / overlap\",\"worry_when\":\"Any single weight carries a large share of the total; the effective sample is far below the nominal one; the propensity model separates the arms almost perfectly; treated units sit outside the control group's range.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"when_not_to_use\":[\"It answers a slightly different question from the natural decomposition -- a population shift, not a person-level swap -- and path-specific effects for several mediators do not add up to the joint one.\"],\"when_to_use\":[\"The preferred default in policy and health: it needs no cross-world assumption, it survives a mediator-outcome confounder that the treatment caused, and it takes several mediators at once.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\",\"targets Interventional indirect effect and Interventional direct effect, which the estimand catalogue does not define yet\"],\"id\":\"med.interventional\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"med.interventional\",\"registry\":{\"designs\":[\"mediation\"],\"diagnostics\":[\"temporal_ordering\",\"mediation_decomposition\",\"multiple_mediators\",\"treatment_mediator_interaction\"],\"disrecommend_when\":null,\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":true,\"r\":\"CMAverse\"},\"estimands\":[\"IIE\",\"IDE\",\"ATE\"],\"explain_key\":\"method.med.interventional\",\"id\":\"med.interventional\",\"needs\":[\"numpy\",\"scipy\",\"pandas\"],\"needs_overlap\":true,\"one_liner\":\"Shift the mediator to the distribution it would have in the population, rather than to each person's own unobservable counterfactual.\",\"options\":[{\"default\":true,\"label\":\"Let the mediator's effect depend on treatment\",\"name\":\"interaction\",\"profile\":\"standard\",\"type\":\"bool\"},{\"default\":500,\"label\":\"Bootstrap draws\",\"max\":5000,\"min\":100,\"name\":\"bootstrap_reps\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":100,\"label\":\"Simulation draws per unit\",\"max\":2000,\"min\":20,\"name\":\"mc_draws\",\"profile\":\"advanced\",\"type\":\"int\"}],\"probes\":[\"probe.subset\",\"probe.random_common_cause\",\"probe.cinelli_hazlett\",\"probe.alternate_spec\"],\"reference_dispositions\":[{\"disposition\":\"resolved_metadata\",\"id\":\"10.1097/ede.0000000000000034\",\"requested_as\":\"VanderWeele, Vansteelandt & Robins (2014), Effect decomposition in the presence of an exposure-induced mediator-outcome confounder\"},{\"disposition\":\"resolved_metadata\",\"id\":\"10.1097/ede.0000000000000596\",\"requested_as\":\"Vansteelandt & Daniel (2017), Interventional effects for mediation analysis with multiple mediators\"}],\"reference_ids\":[\"10.1097/ede.0000000000000034\",\"10.1097/ede.0000000000000596\"],\"references\":[\"VanderWeele, Vansteelandt & Robins (2014), Effect decomposition in the presence of an exposure-induced mediator-outcome confounder\",\"Vansteelandt & Daniel (2017), Interventional effects for mediation analysis with multiple mediators\"],\"roles_forbidden\":[],\"roles_optional\":[\"confounders\",\"forbidden\",\"weight\",\"cluster\"],\"roles_required\":[\"treatment\",\"mediator\",\"outcome\"],\"source_path\":\"engines/python/capy_py/longitudinal.py\",\"source_sha256\":\"49a2064131adc4f82db0de13c3127729b10c3407c6c933d1afed97a11dce4e83\",\"status\":\"recommended\",\"title\":\"Interventional direct and indirect effects\",\"what_can_go_wrong\":\"It answers a slightly different question from the natural decomposition -- a population shift, not a person-level swap -- and path-specific effects for several mediators do not add up to the joint one.\",\"why_recommended\":\"The preferred default in policy and health: it needs no cross-world assumption, it survives a mediator-outcome confounder that the treatment caused, and it takes several mediators at once.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:01f870126809d06e998bae29\",\"object_id\":\"concept:natural-effects\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:imai2010\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"med.interventional\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:0f54d6418114ee