ghts\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"long.msm_iptw\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:ebd7708e98ddc96f6a6c0425\",\"object_id\":\"design:longitudinal\",\"predicate\":\"compatible_with_design\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"long.msm_iptw\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Reweight each person-period so the treated and untreated histories look alike, then fit one simple model to the reweighted data.\",\"title\":\"Marginal structural model (time-varying weights)\"}" .
<urn:capy:med.controlled_direct> a capy:method ; skos:prefLabel "Controlled direct effect" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:med.controlled_direct\"],\"catalogue_key\":\"method:med.controlled_direct\",\"citation_ids\":[\"10.1097/00001648-199203000-00013\",\"source:unresolved:cf5b8f6e073142f78ce4\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":null,\"engines\":{\"python\":true,\"r\":\"CMAverse\"},\"needs_r_packages\":[\"CMAverse\"],\"runs_here\":true,\"summary\":\"Runs on this computer with what the app already installs.\"},\"designs\":[{\"explain_key\":\"design.mediation\",\"id\":\"mediation\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"We care about a mediator, not only the total effect.\",\"title\":\"How it worked (pathways)\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.temporal_ordering\",\"id\":\"temporal_ordering\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Temporal ordering of covariates\"},{\"explain_key\":\"diagnostic.cde_path\",\"id\":\"cde_path\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Controlled direct effect across mediator levels\"},{\"explain_key\":\"diagnostic.mediation_decomposition\",\"id\":\"mediation_decomposition\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Total = direct + indirect\"},{\"explain_key\":\"diagnostic.treatment_mediator_interaction\",\"id\":\"treatment_mediator_interaction\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Treatment-mediator interaction\"}],\"estimands\":[{\"acronym\":null,\"explain_key\":null,\"id\":\"CDE\",\"in_catalogue\":false,\"kind\":\"estimand\",\"one_liner\":null,\"title\":\"Controlled direct effect\"}],\"explain_key\":\"method.med.controlled_direct\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\",\"targets Controlled direct effect, which the estimand catalogue does not define yet\"],\"id\":\"med.controlled_direct\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":true,\"one_liner\":\"What the treatment would still do if the mediator were fixed at one value for everybody.\",\"options\":[{\"default\":\"mean\",\"help\":\"A number, or mean / median / min / max. It should be a level a policy could actually impose.\",\"label\":\"Hold the mediator at\",\"name\":\"mediator_level\",\"profile\":\"standard\",\"type\":\"number\"},{\"default\":null,\"help\":\"The path of controlled direct effects across mediator values. Defaults to the 10th to 90th percentiles.\",\"label\":\"Levels to trace\",\"name\":\"mediator_grid\",\"profile\":\"advanced\",\"type\":\"string\"},{\"default\":true,\"help\":\"With no interaction the controlled direct effect is the same at every level, which is an assumption and not a finding.\",\"label\":\"Let the mediator's effect depend on treatment\",\"name\":\"interaction\",\"profile\":\"standard\",\"type\":\"bool\"},{\"default\":400,\"help\":\"Only used when the contrast is not a linear function of the outcome model.\",\"label\":\"Bootstrap draws\",\"max\":5000,\"min\":100,\"name\":\"bootstrap_reps\",\"profile\":\"advanced\",\"type\":\"int\"}],\"plain_language\":\"What the treatment would still do if the mediator were fixed at one value for everybody.\",\"probes\":[{\"explain_key\":\"probe.subset\",\"id\":\"probe.subset\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Re-estimate on random subsets. The answer should move about as much as losing that much data costs, and no more.\",\"requested_as\":\"probe.subset\",\"title\":\"Subset stability\"},{\"explain_key\":\"probe.alternate_spec\",\"id\":\"probe.alternate_spec\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the grid of defensible specifications and sort the answers. The curve is the result, not the one you happened to run.\",\"requested_as\":\"probe.alternate_spec\",\"title\":\"Specification curve\"},{\"explain_key\":\"probe.cinelli_hazlett\",\"id\":\"probe.cinelli_hazlett\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"How strong would an unmeasured confounder have to be -- compared with the covariates you already have -- to explain the estimate away?\",\"requested_as\":\"probe.cinelli_hazlett\",\"title\":\"Cinelli-Hazlett sensitivity (partial R2)\"}],\"references\":[\"Robins & Greenland (1992), Identifiability and exchangeability for direct and indirect effects\",\"VanderWeele (2015), Explanation in Causal Inference, ch. 2\"],\"roles_forbidden\":[],\"roles_optional\":[\"at least one measured confounder\",\"forbidden\",\"weight\",\"a clustering variable\"],\"roles_required\":[\"a treatment\",\"a mediator\",\"an outcome\"],\"see_also\":[{\"explain_key\":\"design.mediation\",\"id\":\"mediation\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"We care about a mediator, not only the total effect.\",\"title\":\"How it worked (pathways)\"}],\"status\":\"reasonable\",\"status_label\":\"Reasonable\",\"tags\":[\"How it worked (pathways)\",\"Controlled direct effect\",\"Reasonable\"],\"title\":\"Controlled direct effect\",\"what_it_assumes\":[{\"explain_key\":\"assumption.sequential_ignorability\",\"explains\":\"No unmeasured confounding of the treatment-outcome relationship, and none of the mediator-outcome relationship either, even after conditioning on treatment.\",\"id\":\"sequential_ignorability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Sequential ignorability\",\"worry_when\":\"There is a variable affected by treatment that also confounds the mediator-outcome relationship. Under that structure the natural effects are not identified at all.\"},{\"explain_key\":\"assumption.exchangeability\",\"explains\":\"Treated and untreated units are comparable once you condition on the confounders you measured. Everything that pushed people towards treatment and also moves the outcome is in your adjustment set.\",\"id\":\"exchangeability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Exchangeability / no unmeasured confounding\",\"worry_when\":\"Treatment was chosen by people who knew something about the likely outcome that you do not observe. Clinical judgement, self-selection into a programme, and administrative triage are the classic cases.\"},{\"explain_key\":\"assumption.positivity\",\"explains\":\"Every kind of unit had some chance of being treated and some chance of not being treated. Where that fails, there is no comparison to make and the model is inventing one.\",\"id\":\"positivity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Positivity / overlap\",\"worry_when\":\"Any single weight carries a large share of the total; the effective sample is far below the nominal one; the propensity model separates the arms almost perfectly; treated units sit outside the control group's range.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"when_not_to_use\":[\"It does not decompose the total effect: there is no indirect effect to put beside it, and when treatment and mediator interact there is a different answer at every mediator level.\",\"When the question is 'how much went through the mediator'; that is an indirect effect, which a controlled direct effect does not provide\"],\"when_to_use\":[\"The one mediation quantity that corresponds to an intervention you could actually run, and it needs no cross-world assumption.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\",\"targets Controlled direct effect, which the estimand catalogue does not define yet\"],\"id\":\"med.controlled_direct\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"med.controlled_direct\",\"registry\":{\"designs\":[\"mediation\"],\"diagnostics\":[\"temporal_ordering\",\"cde_path\",\"mediation_decomposition\",\"treatment_mediator_interaction\"],\"disrecommend_when\":\"When the question is 'how much went through the mediator'; that is an indirect effect, which a controlled direct effect does not provide\",\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":true,\"r\":\"CMAverse\"},\"estimands\":[\"CDE\"],\"explain_key\":\"method.med.controlled_direct\",\"id\":\"med.controlled_direct\",\"needs\":[\"numpy\",\"scipy\",\"pandas\"],\"needs_overlap\":true,\"one_liner\":\"What the treatment would still do if the mediator were fixed at one value for everybody.\",\"options\":[{\"default\":\"mean\",\"help\":\"A number, or mean / median / min / max. It should be a level a policy could actually impose.\",\"label\":\"Hold the mediator at\",\"name\":\"mediator_level\",\"profile\":\"standard\",\"type\":\"number\"},{\"default\":null,\"help\":\"The path of controlled direct effects across mediator values. Defaults to the 10th to 90th percentiles.\",\"label\":\"Levels to trace\",\"name\":\"mediator_grid\",\"profile\":\"advanced\",\"type\":\"string\"},{\"default\":true,\"help\":\"With no interaction the controlled direct effect is the same at every level, which is an assumption and not a finding.\",\"label\":\"Let the mediator's effect depend on treatment\",\"name\":\"interaction\",\"profile\":\"standard\",\"type\":\"bool\"},{\"default\":400,\"help\":\"Only used when the contrast is not a linear function of the outcome model.\",\"label\":\"Bootstrap draws\",\"max\":5000,\"min\":100,\"name\":\"bootstrap_reps\",\"profile\":\"advanced\",\"type\":\"int\"}],\"probes\":[\"probe.subset\",\"probe.alternate_spec\",\"probe.cinelli_hazlett\"],\"reference_dispositions\":[{\"disposition\":\"resolved_metadata\",\"id\":\"10.1097/00001648-199203000-00013\",\"requested_as\":\"Robins & Greenland (1992), Identifiability and exchangeability for direct and indirect effects\"},{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:cf5b8f6e073142f78ce4\",\"requested_as\":\"VanderWeele (2015), Explanation in Causal Inference, ch. 2\"}],\"reference_ids\":[\"10.1097/00001648-199203000-00013\",\"source:unresolved:cf5b8f6e073142f78ce4\"],\"references\":[\"Robins & Greenland (1992), Identifiability and exchangeability for direct and indirect effects\",\"VanderWeele (2015), Explanation in Causal Inference, ch. 2\"],\"roles_forbidden\":[],\"roles_optional\":[\"confounders\",\"forbidden\",\"weight\",\"cluster\"],\"roles_required\":[\"treatment\",\"mediator\",\"outcome\"],\"source_path\":\"engines/python/capy_py/longitudinal.py\",\"source_sha256\":\"49a2064131adc4f82db0de13c3127729b10c3407c6c933d1afed97a11dce4e83\",\"status\":\"reasonable\",\"title\":\"Controlled direct effect\",\"what_can_go_wrong\":\"It does not decompose the total effect: there is no indirect effect to put beside it, and when treatment and mediator interact there is a different answer at every mediator level.\",\"why_recommended\":\"The one mediation quantity that corresponds to an intervention you could actually run, and it needs no cross-world assumption.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:013c92f988d59d74bcde896e\",\"object_id\":\"concept:causal-estimands\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:ich2019\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"med.controlled_direct\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:04183500e5413bb2afa2961c\",\"object_id\":\"source:unresolved:cf5b8f6e073142f78ce4\",\"predicate\":\"cites\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apach