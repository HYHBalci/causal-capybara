<urn:capy:study%3Anhefs_smoking> a capy:study ; skos:prefLabel "Quitting smoking and gaining weight" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"study:nhefs_smoking\",\"citation_ids\":[],\"citations\":[],\"content\":{\"caveat\":\"\",\"citation\":\"Hernan & Robins, Causal Inference: What If (2020).\",\"citation_url\":\"https://miguelhernan.org/whatifbook\",\"design\":{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"},\"difficulty\":\"medium\",\"estimand\":{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"},\"explain_key\":null,\"gaps\":[],\"id\":\"nhefs_smoking\",\"kind\":\"study\",\"one_liner\":\"standardisation, weighting, and the assumptions underneath both\",\"plain_language\":\"The NHEFS cohort behind Hernan and Robins. What quitting did to weight, where the answer depends entirely on what you assume about who quits.\",\"provenance\":{\"data_origin\":\"Published study data, fetched from source. Not redistributed by this project.\",\"downloads_from\":[\"https://vincentarelbundock.github.io/Rdatasets/csv/causaldata/nhefs_complete.csv\"],\"licences\":[\"MIT\"],\"rights\":\"MIT via causaldata, Huntington-Klein et al.\",\"source\":\"real\",\"study\":\"NHANES I Epidemiologic Follow-up Study\",\"truth\":\"This is the study data, not a simulation. There is no built-in answer to check the estimators against -- which is the whole reason to work with it.\"},\"question\":\"The NHEFS cohort behind Hernan and Robins. What quitting did to weight, where the answer depends entirely on what you assume about who quits.\",\"rows\":1566,\"see_also\":[{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"},{\"explain_key\":\"method.obs.aipw\",\"id\":\"obs.aipw\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Use a treatment model and an outcome model together; it is right if either one is.\",\"title\":\"Doubly robust (AIPW)\"},{\"explain_key\":\"method.obs.weighting.ipw\",\"id\":\"obs.weighting.ipw\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Reweight the sample so the treated and untreated groups look alike on the measured confounders.\",\"title\":\"Propensity weighting\"},{\"explain_key\":\"method.obs.outcome_regression\",\"id\":\"obs.outcome_regression\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Model the outcome, then ask what would have happened if everyone had been treated, and if nobody had.\",\"title\":\"Outcome regression (g-computation)\"}],\"suggested_methods\":[{\"explain_key\":\"method.obs.aipw\",\"id\":\"obs.aipw\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Use a treatment model and an outcome model together; it is right if either one is.\",\"title\":\"Doubly robust (AIPW)\"},{\"explain_key\":\"method.obs.weighting.ipw\",\"id\":\"obs.weighting.ipw\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Reweight the sample so the treated and untreated groups look alike on the measured confounders.\",\"title\":\"Propensity weighting\"},{\"explain_key\":\"method.obs.outcome_regression\",\"id\":\"obs.outcome_regression\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Model the outcome, then ask what would have happened if everyone had been treated, and if nobody had.\",\"title\":\"Outcome regression (g-computation)\"}],\"tags\":[\"Adjust for background differences\",\"medium\"],\"teaches\":\"standardisation, weighting, and the assumptions underneath both\",\"title\":\"Quitting smoking and gaining weight\",\"tour\":[]},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"study:nhefs_smoking\",\"kind\":\"study\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"nhefs_smoking\",\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:22d90fb0db9fddea05665ef5\",\"object_id\":\"design:observational\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"study:nhefs_smoking\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:4736217239837a1a72744ab6\",\"object_id\":\"obs.aipw\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":t