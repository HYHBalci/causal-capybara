<urn:capy:iv.mte> a capy:method ; skos:prefLabel "Marginal treatment effects" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:iv.mte\"],\"catalogue_key\":\"method:iv.mte\",\"citation_ids\":[\"source:unresolved:46c5c77029a192eb5c02\",\"source:unresolved:703d6268d8f471e81a00\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":\"Not wrapped.\",\"engines\":{\"python\":false,\"r\":\"ivmte\"},\"needs_r_packages\":[\"ivmte\"],\"runs_here\":false,\"summary\":\"Not built into the app yet. The authoritative version is the R package ivmte, which the Engines screen can install for you.\"},\"designs\":[{\"explain_key\":\"design.iv\",\"id\":\"iv\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"An instrument or encouragement changed treatment, not the outcome directly.\",\"title\":\"Something else pushed people in\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.first_stage\",\"id\":\"first_stage\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"First stage\"},{\"explain_key\":\"diagnostic.compliers\",\"id\":\"compliers\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Complier share\"}],\"estimands\":[{\"acronym\":\"LATE\",\"explain_key\":\"estimand.late\",\"id\":\"LATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who only got it because of the instrument or the cutoff, what did it do?\",\"title\":\"Local average treatment effect\"},{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"},{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"}],\"explain_key\":\"method.iv.mte\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"iv.mte\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":false,\"one_liner\":\"Trace the effect as a function of how reluctant a unit is to be treated, instead of reporting one local average.\",\"options\":[],\"plain_language\":\"Trace the effect as a function of how reluctant a unit is to be treated, instead of reporting one local average.\",\"probes\":[{\"explain_key\":\"probe.alternate_spec\",\"id\":\"probe.alternate_spec\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the grid of defensible specifications and sort the answers. The curve is the result, not the one you happened to run.\",\"requested_as\":\"probe.alternate_spec\",\"title\":\"Specification curve\"}],\"references\":[\"Heckman & Vytlacil (2005)\",\"Mogstad, Santos & Torgovitsky (2018)\"],\"roles_forbidden\":[],\"roles_optional\":[],\"roles_required\":[\"a treatment\",\"an outcome\",\"an instrument\"],\"see_also\":[{\"explain_key\":\"design.iv\",\"id\":\"iv\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"An instrument or encouragement changed treatment, not the outcome directly.\",\"title\":\"Something else pushed people in\"},{\"explain_key\":\"method.bounds.manski\",\"id\":\"bounds.manski\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Report the range the effect must lie in given only what the data can support, without assuming away the missing counterfactual.\",\"title\":\"Manski bounds\"},{\"explain_key\":\"method.iv.2sls\",\"id\":\"iv.2sls\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Use only the part of the treatment that the instrument moved, and see what happened to the outcome.\",\"title\":\"Two-stage least squares\"},{\"explain_key\":\"method.iv.gmm\",\"id\":\"iv.gmm\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Weight the instruments by how informative each one actually is, using a weight matrix estimated from the data.\",\"title\":\"Two-step GMM\"},{\"explain_key\":\"method.iv.liml\",\"id\":\"iv.liml\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"The maximum-likelihood cousin of two-stage least squares, which stays much better behaved when the instruments are weak.\",\"title\":\"LIML (and Fuller)\"},{\"explain_key\":\"method.iv.shift_share\",\"id\":\"iv.shift_share\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Combine national shocks with local exposure shares to build an instrument for local changes.\",\"title\":\"Shift-share (Bartik) instruments\"},{\"explain_key\":\"method.iv.weak_robust\",\"id\":\"iv.weak_robust\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Report the set of effects the data cannot reject, which stays honest however weak the instrument is.\",\"title\":\"Weak-instrument-robust confidence set\"}],\"status\":\"reasonable\",\"status_label\":\"Reasonable\",\"tags\":[\"Something else pushed people in\",\"LATE\",\"ATE\",\"ATT\",\"Reasonable\"],\"title\":\"Marginal treatment effects\",\"what_it_assumes\":[{\"explain_key\":\"assumption.relevance\",\"explains\":\"The instrument actually moves treatment, and moves it enough that the resulting estimate is not mostly noise.\",\"id\":\"relevance\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Instrument relevance\",\"worry_when\":\"An effective F below about 10; a first-stage coefficient that is substantively tiny even if statistically significant; many instruments.\"},{\"explain_key\":\"assumption.exclusion\",\"explains\":\"The instrument affects the outcome only through the treatment. On the board, that is the arrow you did not draw.\",\"id\":\"exclusion\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Exclusion restriction\",\"worry_when\":\"The instrument is a policy that changed several things at once; it is correlated with geography, time or institutions that have their own effects; it was chosen because it predicted the outcome.\"},{\"explain_key\":\"assumption.monotonicity\",\"explains\":\"The instrument pushes everyone the same way, or not at all. Nobody takes the treatment only because they were discouraged from it.\",\"id\":\"monotonicity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Monotonicity / no defiers\",\"worry_when\":\"The instrument is an incentive that could plausibly backfire for some people, or it is a judge or examiner whose leniency ordering differs across case types.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"when_not_to_use\":[\"Identifying the curve away from the support of the instrument requires functional form, and the extrapolated ends can be almost entirely assumption.\"],\"when_to_use\":[\"The honest answer to \\\"your LATE is only about compliers\\\" -- it shows the whole curve and makes extrapolation to other estimands explicit rather than implicit.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"iv.mte\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"iv.mte\",\"registry\":{\"coming\":\"Not wrapped.\",\"designs\":[\"iv\"],\"diagnostics\":[\"first_stage\",\"compliers\"],\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":false,\"r\":\"ivmte\"},\"estimands\":[\"LATE\",\"ATE\",\"ATT\"],\"id\":\"iv.mte\",\"one_liner\":\"Trace the effect as a function of how reluctant a unit is to be treated, instead of reporting one local average.\",\"probes\":[\"probe.alternate_spec\"],\"r_needs\":[\"ivmte\"],\"reference_dispositions\":[{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:46c5c77029a192eb5c02\",\"requested_as\":\"Heckman & Vytlacil (2005)\"},{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:703d6268d8f471e81a00\",\"requested_as\":\"Mogstad, Santos & Torgovitsky (2018)\"}],\"reference_ids\":[\"source:unresolved:46c5c77029a192eb5c02\",\"source:unresolved:703d6268d8f471e81a00\"],\"references\":[\"Heckman & Vytlacil (2005)\",\"Mogstad, Santos & Torgovitsky (2018)\"],\"roles_required\":[\"treatment\",\"outcome\",\"instruments\"],\"source_path\":\"engines/registry/methods.extra.yaml\",\"source_sha256\":\"2cb349e9f7f7e6f88c10c18d81478656fd420eda7ca977d9767610ac8c7a4be0\",\"status\":\"reasonable\",\"title\":\"Marginal treatment effects\",\"what_can_go_wrong\":\"Identifying the curve away from the support of the instrument requires functional form, and the extrapolated ends can be almost entirely assumption.\",\"why_recommended\":\"The honest answer to \\\"your LATE is only about compliers\\\" -- it shows the whole curve and makes extrapolation to other estimands explicit rather than implicit.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:0e6efa220050929114bdb996\",\"object_id\":\"design:iv\",\"predicate\":\"compatible_with_design\",\"pr