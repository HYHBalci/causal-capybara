<urn:capy:bang2005> a capy:source ; skos:prefLabel "Bang, H., & Robins, J. M. (2005). Doubly robust estimation in missing data and causal inference models. Biometrics, 61(4), 962–973." ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"citation\":\"Bang, H., & Robins, J. M. (2005). Doubly robust estimation in missing data and causal inference models. Biometrics, 61(4), 962–973.\",\"citation_ids\":[],\"citations\":[],\"disposition\":\"resolved_metadata\",\"id\":\"bang2005\",\"kind\":\"source\",\"metadata\":{\"citation\":\"Bang, H., & Robins, J. M. (2005). Doubly robust estimation in missing data and causal inference models. Biometrics, 61(4), 962–973.\",\"id\":\"bang2005\",\"match\":[\"bang\",\"robins\",\"2005\"],\"resolved\":true,\"topic\":\"Observational studies\",\"url\":\"https://doi.org/10.1111/j.1541-0420.2005.00377.x\"},\"provenance\":[\"source:project-inventory\"],\"publication_rights\":{\"attribution\":\"Bang, H., & Robins, J. M. (2005). Doubly robust estimation in missing data and causal inference models. Biometrics, 61(4), 962–973.\",\"content_type\":\"external_publication_body\",\"license_id\":\"unknown\",\"license_url\":null,\"modified\":false,\"permissions\":{\"adapt\":false,\"cache\":false,\"display\":false,\"model_context\":false,\"public_export\":false},\"review_basis\":\"No full-text license has been admitted.\"},\"relations\":[],\"resolved\":true,\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_version\":\"https://doi.org/10.1111/j.1541-0420.2005.00377.x\",\"summary\":\"Bibliographic metadata/link only; no publication text, abstract, figure or dataset is distributed.\",\"title\":\"Bang, H., & Robins, J. M. (2005). Doubly robust estimation in missing data and causal inference models. Biometrics, 61(4), 962–973.\",\"url\":\"https://doi.org/10.1111/j.1541-0420.2005.00377.x\"}" .
<urn:capy:bernal2017> a capy:source ; skos:prefLabel "Lopez Bernal, J., Cummins, S., & Gasparrini, A. (2017). Interrupted time series regression for the evaluation of public health interventions: A tutorial. International Journal of Epidemiology, 46(1), 348–355." ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"citation\":\"Lopez Bernal, J., Cummins, S., & Gasparrini, A. (2017). Interrupted time series regression for the evaluation of public health interventions: A tutorial. International Journal of Epidemiology, 46(1), 348–355.\",\"citation_ids\":[],\"citations\":[],\"disposition\":\"resolved_metadata\",\"id\":\"bernal2017\",\"kind\":\"source\",\"metadata\":{\"citation\":\"Lopez Bernal, J., Cummins, S., & Gasparrini, A. (2017). Interrupted time series regression for the evaluation of public health interventions: A tutorial. International Journal of Epidemiology, 46(1), 348–355.\",\"id\":\"bernal2017\",\"match\":[\"bernal\",\"2017\"],\"resolved\":true,\"topic\":\"Interrupted time series\",\"url\":\"https://doi.org/10.1093/ije/dyw098\"},\"provenance\":[\"source:project-inventory\"],\"publication_rights\":{\"attribution\":\"Lopez Bernal, J., Cummins, S., & Gasparrini, A. (2017). Interrupted time series regression for the evaluation of public health interventions: A tutorial. International Journal of Epidemiology, 46(1), 348–355.\",\"content_type\":\"external_publication_body\",\"license_id\":\"unknown\",\"license_url\":null,\"modified\":false,\"permissions\":{\"adapt\":false,\"cache\":false,\"display\":false,\"model_context\":false,\"public_export\":false},\"review_basis\":\"No full-text license has been admitted.\"},\"relations\":[],\"resolved\":true,\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_con