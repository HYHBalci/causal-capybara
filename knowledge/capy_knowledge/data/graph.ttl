ncluded.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:survival\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:eb51dd8bdf5e7d1ca1c5cf6d\",\"object_id\":\"survival.kaplan_meier\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:survival\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:ed90b1edf1f01580afd2f9fc\",\"object_id\":\"estimand:time_ratio\",\"predicate\":\"targets_estimand\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:survival\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:f9fabbe13c029db783bff233\",\"object_id\":\"estimand:survival_difference\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:survival\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Define the event, time zero, baseline intervention, population, observation mechanism and horizon before fitting a survival model.\",\"title\":\"Time until an event\"}" .
<urn:capy:design%3Asynth> a capy:design ; skos:prefLabel "One place, constructed twin" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"Synthetic control\",\"SCM\",\"synthetic difference-in-differences\",\"donor pool\",\"comparative case study\"],\"catalogue_key\":\"design:synth\",\"citation_ids\":[],\"citations\":[],\"content\":{\"also_called\":[\"Synthetic control\",\"SCM\",\"synthetic difference-in-differences\",\"donor pool\",\"comparative case study\"],\"assumption_notes\":[\"The donors can reproduce the treated unit's pre-period\",\"The treated unit is inside the donors' convex hull\",\"No anticipation, and no donor affected by the same intervention\"],\"common_mistake\":\"Reporting weights and a gap plot with no placebo inference. With one treated unit, the placebo distribution is the inference.\",\"default_estimand\":{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"},\"diagnostics\":[{\"explain_key\":\"diagnostic.leave_one_out\",\"id\":\"leave_one_out\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Leave one unit out\"},{\"explain_key\":\"diagnostic.negative_control\",\"id\":\"negative_control\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Negative control\"},{\"explain_key\":\"diagnostic.placebo_outcome\",\"id\":\"placebo_outcome\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Placebo outcome\"},{\"explain_key\":\"diagnostic.placebo_treatment\",\"id\":\"placebo_treatment\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Placebo treatment\"},{\"explain_key\":\"diagnostic.probe_runs\",\"id\":\"probe_runs\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Probe runs\"},{\"explain_key\":\"diagnostic.random_common_cause\",\"id\":\"random_common_cause\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Random common cause\"},{\"explain_key\":\"diagnostic.sc_augmentation\",\"id\":\"sc_augmentation\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Size of the augmentation correction\"},{\"explain_key\":\"diagnostic.sc_convex_hull\",\"id\":\"sc_convex_hull\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Treated unit inside the donor hull\"},{\"explain_key\":\"diagnostic.sc_gap\",\"id\":\"sc_gap\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Treated minus synthetic gap\"},{\"explain_key\":\"diagnostic.sc_loo\",\"id\":\"sc_loo\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Leave one donor out\"},{\"explain_key\":\"diagnostic.sc_mc_rank\",\"id\":\"sc_mc_rank\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Matrix-completion rank\"},{\"explain_key\":\"diagnostic.sc_placebo_space\",\"id\":\"sc_placebo_space\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Placebo in space\"},{\"explain_key\":\"diagnostic.sc_placebo_time\",\"id\":\"sc_placebo_time\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Placebo in time\"},{\"explain_key\":\"diagnostic.sc_pre_fit\",\"id\":\"sc_pre_fit\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Pre-treatment fit\"},{\"explain_key\":\"diagnostic.sc_time_weights\",\"id\":\"sc_time_weights\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Time weights\"},{\"explain_key\":\"diagnostic.sc_weights\",\"id\":\"sc_weights\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Donor weights\"},{\"explain_key\":\"diagnostic.spec_curve\",\"id\":\"spec_curve\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Specification curve\"},{\"explain_key\":\"diagnostic.subset_stability\",\"id\":\"subset_stability\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Stability on random subsets\"},{\"explain_key\":\"diagnostic.unobserved_confounder\",\"id\":\"unobserved_confounder\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Simulated unobserved confounder\"}],\"estimands\":[{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"}],\"explain_key\":\"design.synth\",\"gaps\":[],\"how_the_board_reads\":\"If the synthetic unit cannot reproduce the pre-period, it is not a counterfactual.\",\"id\":\"synth\",\"in_more_depth\":\"This is what you reach for when the treated unit is a country, a region or a firm, and there is no comparable single control. The weights are chosen to reproduce the pre-intervention path, and the restriction that they are non-negative and sum to one is deliberate: it forbids extrapolation. Pre-period fit is the test. A synthetic unit that cannot reproduce the treated unit before the intervention has no claim to reproduce it afterwards, and the estimate is then mostly the pre-existing gap. Inference is by permutation, not by standard errors: re-run the method pretending each donor was treated, and see where the real one ranks.\",\"kind\":\"design\",\"methods\":[{\"explain_key\":\"method.did.synthdid_r\",\"id\":\"did.synthdid_r\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Weight both units and periods, then take a difference-in-differences -- halfway between synthetic control and DiD.\",\"title\":\"Synthetic difference-in-differences (synthdid)\"},{\"explain_key\":\"method.its.causal_impact\",\"id\":\"its.causal_impact\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Model the counterfactual series with a structural time-series model and control series, and report a posterior rather than an interval.\",\"title\":\"Bayesian structural time series (CausalImpact)\"},{\"explain_key\":\"method.sc.abadie\",\"id\":\"sc.abadie\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Build a weighted copy of the treated place out of untreated places that looked like it beforehand, then watch the two lines separate.\",\"title\":\"Synthetic control\"},{\"explain_key\":\"method.sc.augmented\",\"id\":\"sc.augmented\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"When no weighted average of the donors can match the treated place, correct the leftover bias with a ridge model and show the size of the correction.\",\"title\":\"Augmented synthetic control\"},{\"explain_key\":\"method.sc.matrix_completion\",\"id\":\"sc.matrix_completion\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Treat the missing treated-period outcomes as holes in a panel and fill them in with a low-rank model of what the panel would have done.\",\"title\":\"Matrix completion\"},{\"explain_key\":\"method.sc.microsynth\",\"id\":\"sc.microsynth\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Synthetic control when the treated unit is a neighbourhood or a small area and there are many of them.\",\"title\":\"Microsynth (many treated units)\"},{\"explain_key\":\"method.sc.scpi\",\"id\":\"sc.scpi\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Confidence intervals for a synthetic control that come from a model of the prediction error rather than from permutation.\",\"title\":\"Prediction intervals for synthetic control (scpi)\"},{\"explain_key\":\"method.sc.synthdid\",\"id\":\"sc.synthdid\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Weight the comparison units and the pre-treatment periods, then run a difference in differences on the result - a level gap is allowed, a trend gap is not.\",\"title\":\"Synthetic difference-in-differences\"}],\"one_liner\":\"One treated unit; build a comparison from a donor pool.\",\"plain_language\":\"One treated unit, many untreated donors. Build a weighted combination of donors that tracks the treated unit before the intervention, and use it afterwards.\",\"probes\":[{\"explain_key\":\"probe.add_unobserved_confounder\",\"id\":\"probe.add_unobserved_confounder\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Simulate a common cause of a stated strength and watch the estimate move; read off how strong one would have to be to explain the result away.\",\"title\":\"Unobserved confounder\"},{\"explain_key\":\"probe.alternate_spec\",\"id\":\"probe.alternate_spec\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the grid of defensible specifications and sort the answers. The curve is the result, not the one you happened to run.\",\"title\":\"Specification curve\"},{\"explain_key\":\"probe.leave_one_out\",\"id\":\"probe.leave_one_out\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Drop one cluster, cohort or donor at a time and see whether any single one is carrying the result.\",\"title\":\"Leave one out\"},{\"explain_key\":\"probe.negative_control\",\"id\":\"probe.negative_control\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Estimate something that shares the confounding but not the causal path. A non-zero answer is bias you can see.\",\"title\":\"Negative control\"},{\"explain_key\":\"probe.placebo_outcome\",\"id\":\"probe.placebo_outcome\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the same analysis on something the treatment could not have changed. It should find nothing.\",\"title\":\"Placebo outcome\"},{\"explain_key\":\"probe.placebo_treatment\",\"id\":\"probe.placebo_treatment\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Move the policy date earlier, reshuffle who was treated, or swap in a variable that cannot cause the outcome.\",\"title\":\"Placebo treatment\"},{\"explain_key\":\"probe.random_common_cause\",\"id\":\"probe.random_common_cause\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Add a variable that causes nothing to the adjustment set. The estimate should barely move.\",\"title\":\"Random common cause\"},{\"explain_key\":\"probe.subset\",\"id\":\"probe.subset\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Re-estimate on random subsets. The answer should move about as much as losing that much data costs, and no more.\",\"title\":\"Subset stability\"}],\"references\":[\"Abadie, Diamond & Hainmueller (2010)\",\"Abadie (2021), Using synthetic controls\"],\"see_also\":[{\"explain_key\":\"assumption.donor_fit\",\"explains\":\"The weighted combination of untreated units reproduces the treated unit's pre-period path closely enough to stand in for it afterwards.\",\"id\":\"donor_fit\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Pre-treatment fit from the donor pool\",\"worry_when\":\"Visible pre-period gaps; a short pre-period relative to the number of donors; one donor carrying most of the weight.\"},{\"explain_key\":\"diagnostic.sc_placebo\",\"id\":\"diagnostic.sc_placebo\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"Re-run the whole method pretending each donor was the treated unit. If many donors show a gap as large, the real one is unremarkable.\",\"title\":\"Synthetic control placebos\"},{\"explain_key\":\"method.sc.abadie\",\"id\":\"sc.abadie\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Build a weighted copy of the treated place out of untreated places that looked like it beforehand, then watch the two lines separate.\",\"title\":\"Synthetic control\"},{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"},{\"explain_key\":\"method.did.synthdid_r\",\"id\":\"did.synthdid_r\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Weight both units and periods, then take a difference-in-differences -- halfway between synthetic control and DiD.\",\"title\":\"Synthetic difference-in-differences (synthdid)\"},{\"explain_key\":\"method.its.causal_impact\",\"id\":\"its.causal_impact\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Model the counterfactual series with a structural time-series model and control series, and report a posterior rather than an interval.\",\"title\":\"Bayesian structural time series (CausalImpact)\"},{\"explain_key\":\"method.sc.augmented\",\"id\":\"sc.augmented\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"When no weighted average of the donors can match the treated place, correct the leftover bias with a ridge model and show the size of the correction.\",\"title\":\"Augmented synthetic control\"}],\"tags\":[\"ATT\"],\"title\":\"One place, constructed twin\",\"what_it_assumes\":[{\"explain_key\":\"assumption.donor_fit\",\"explains\":\"The weighted combination of untreated units reproduces the treated unit's pre-period path closely enough to stand in for it afterwards.\",\"id\":\"donor_fit\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Pre-treatment fit from the donor pool\",\"worry_when\":\"Visible pre-period gaps; a short pre-period relative to the number of donors; one donor carrying most of the weight.\"},{\"explain_key\":\"assumption.convex_hull\",\"explains\":\"The treated unit's characteristics can be written as a weighted average of the donors', with weights that do not go negative.\",\"id\":\"convex_hull\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Treated unit inside the donor convex hull\",\"worry_when\":\"The treated unit is at an extreme of the donor distribution on the predictors, or the pre-period gap has a persistent level offset.\"},{\"explain_key\":\"assumption.no_anticipation\",\"explains\":\"Units did not change behaviour before treatment arrived because they knew it was coming.\",\"id\":\"no_anticipation\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No anticipation\",\"worry_when\":\"There was a public announcement well before the policy started, or the pre-period coefficients move in the period immediately before adoption.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"}],\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"design:synth\",\"kind\":\"design\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"synth\",\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:0f5af6783235482cdd65a8f2\",\"object_id\":\"estimand:ATT\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:synth\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:522c3f893480ac4dde03bbf9\",\"object_id\":\"concept:diagnostic.sc_placebo\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:synth\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:52b32beed0ec1b0929676283\",\"object_id\":\"estimand:ATT\",\"predicate\":\"targets_estimand\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:synth\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:672ae109568aacac60d8da07\",\"object_id\":\"assumption:donor_fit\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not