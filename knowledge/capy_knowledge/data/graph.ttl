<urn:capy:estimand%3ARMST_difference> a capy:estimand ; skos:prefLabel "Restricted mean survival time difference" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"estimand:RMST_difference\",\"citation_ids\":[],\"citations\":[],\"content\":{\"acronym\":\"RMST(1) - RMST(0)\",\"common_mistake\":\"Choosing the horizon after seeing the effect or comparing curves beyond the shorter arm's follow-up.\",\"designs\":[{\"explain_key\":\"design.survival\",\"id\":\"survival\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Follow people from a common time zero; some leave follow-up before the event is observed.\",\"title\":\"Time until an event\"}],\"explain_key\":\"estimand.rmst_difference\",\"gaps\":[\"no plain-language description has been written yet\"],\"id\":\"RMST_difference\",\"in_more_depth\":\"The difference between areas under survival curves from zero through tau, in duration units. RMST is restricted to a chosen horizon, not unrestricted lifetime. Causal versus observed-group meaning depends on the design and estimator.\",\"kind\":\"estimand\",\"methods\":[{\"explain_key\":\"method.survival.aft\",\"id\":\"survival.aft\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Fit a right-censored log-normal/Weibull AFT model; standardize survival/RMST over baseline covariates under explicit causal assumptions, or report a conditional time factor.\",\"title\":\"Censored AFT regression and causal standardization\"},{\"explain_key\":\"method.survival.rmst\",\"id\":\"survival.rmst\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Compare areas under observed Kaplan–Meier curves through a common horizon in time units; this is an unadjusted association.\",\"title\":\"Unadjusted restricted mean survival contrast\"}],\"notation\":null,\"one_liner\":\"Through a chosen horizon, how much event-free follow-up time differs between baseline treatments?\",\"plain_language\":\"Through a chosen horizon, how much event-free follow-up time differs between baseline treatments?\",\"profile\":\"beginner\",\"references\":[],\"see_also\":[{\"explain_key\":\"design.survival\",\"id\":\"survival\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Follow people from a common time zero; some leave follow-up before the event is observed.\",\"title\":\"Time until an event\"},{\"explain_key\":\"method.survival.aft\",\"id\":\"survival.aft\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Fit a right-censored log-normal/Weibull AFT model; standardize survival/RMST over baseline covariates under explicit causal assumptions, or report a conditional time factor.\",\"title\":\"Censored AFT regression and causal standardization\"},{\"explain_key\":\"method.survival.rmst\",\"id\":\"survival.rmst\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Compare areas under observed Kaplan–Meier curves through a common horizon in time units; this is an unadjusted association.\",\"title\":\"Unadjusted restricted mean survival contrast\"}],\"tags\":[\"Time until an event\"],\"title\":\"Restricted mean survival time difference\"},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet\"],\"id\":\"estimand:RMST_difference\",\"kind\":\"estimand\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"RMST_difference\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Through a chosen horizon, how much event-free follow-up time differs between baseline treatments?\",\"title\":\"Restricted mean survival time difference\"}" .
<urn:capy:estimand%3Acohort_ATT> a capy:estimand ; skos:prefLabel "Group-time average treatment effect" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"estimand:cohort_ATT\",\"citation_ids\":[],\"citations\":[],\"content\":{\"acronym\":\"ATT(g,t)\",\"common_mistake\":\"Averaging cohorts with weights that can go negative -- which is what plain two-way fixed effects does.\",\"designs\":[{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"}],\"explain_key\":\"estimand.cohort_att\",\"gaps\":[],\"id\":\"cohort_ATT\",\"in_more_depth\":\"The building block of modern difference-in-differences. Instead of one coefficient, you get a matrix: what the 2014 adopters experienced in 2015, in 2016, and so on. Everything else -- an overall effect, an event study, a per-cohort summary -- is an explicit average of these with weights you can see. That explicitness is the point. Two-way fixed effects also produces a weighted average, but with weights nobody chose and which can be negative.\",\"kind\":\"estimand\",\"methods\":[{\"explain_key\":\"method.did.bjs_imputation\",\"id\":\"did.bjs_imputation\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Learn what untreated life looks like from untreated cells only, then ask how far each treated cell landed from it.\",\"title\":\"Imputation (Borusyak-Jaravel-Spiess)\"},{\"explain_key\":\"method.did.callaway_santanna\",\"id\":\"did.callaway_santanna\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Estimate one clean before-and-after for every adoption cohort, then say out loud how you averaged them.\",\"title\":\"Callaway & Sant'Anna group-time effects\"},{\"explain_key\":\"method.did.chaisemartin\",\"id\":\"did.chaisemartin\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"An estimator built for panels where treatment switches on and off, which the imputation and cohort estimators assume never happens.\",\"title\":\"de Chaisemartin & D'Haultfoeuille\"},{\"explain_key\":\"method.did.event_study\",\"id\":\"did.event_study\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Plot the effect period by period around adoption, so you can see whether the gap opened when the policy arrived or long before it.\",\"title\":\"Event study (leads and lags)\"},{\"explain_key\":\"method.did.gardner_2s\",\"id\":\"did.gardner_2s\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Strip out unit and period effects using untreated cells only, then regress what is left on the policy.\",\"title\":\"Two-stage DiD (Gardner / Wooldridge-Mundlak)\"},{\"explain_key\":\"method.did.sun_abraham\",\"id\":\"did.sun_abraham\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Give every cohort its own event-study path, then average the paths by cohort size instead of letting the regression choose the weights.\",\"title\":\"Sun & Abraham event study\"}],\"notation\":\"ATT(g,t) = E[Y_t(g) - Y_t(0) | G = g]\",\"one_liner\":\"For each group that adopted it, what did their own rollout do?\",\"plain_language\":\"One effect for each adopting cohort in each period, before any averaging.\",\"profile\":\"standard\",\"references\":[\"Callaway & Sant'Anna (2021)\"],\"see_also\":[{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"},{\"explain_key\":\"method.did.callaway_santanna\",\"id\":\"did.callaway_santanna\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Estimate one clean before-and-after for every adoption cohort, then say out loud how you averaged them.\",\"title\":\"Callaway & Sant'Anna group-time effects\"},{\"explain_key\":\"diagnostic.event_study\",\"id\":\"event_study\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Event study\"},{\"explain_key\":\"method.did.bjs_imputation\",\"id\":\"did.bjs_imputation\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Learn what untreated life looks like from untreated cells only, then ask how far each treated cell landed from it.\",\"title\":\"Imputation (Borusyak-Jaravel-Spiess)\"},{\"explain_key\":\"method.did.chaisemartin\",\"id\":\"did.chaisemartin\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"An estimator built for panels where treatment switches on and off, which the imputation and cohort estimators assume never happens.\",\"title\":\"de Chaisemartin & D'Haultfoeuille\"},{\"explain_key\":\"method.did.event_study\",\"id\":\"did.event_study\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Plot the effect period by period around adoption, so you can see whether the gap opened when the policy arrived or long before it.\",\"title\":\"Event study (leads and lags)\"}],\"tags\":[\"Policy rolled out over time\"],\"title\":\"Group-time average treatment effect\"},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"estimand:cohort_ATT\",\"kind\":\"estimand\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"cohort_ATT\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"One effect for each adopting cohort in each period, before any averaging.\",\"title\":\"Group-time average treatment effect\"}" .
<urn:capy:estimand%3Adose_response> a capy:estimand ; skos:prefLabel "Average dose-response function" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"estimand:dose_response\",\"citation_ids\":[],\"citations\":[],\"content\":{\"acronym\":\"ADRF\",\"common_mistake\":\"Fitting a single linear coefficient to a dose that acts non-linearly.\",\"designs\":[{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"}],\"explain_key\":\"estimand.dose_response\",\"gaps\":[],\"id\":\"dose_response\",\"in_more_depth\":\"A single linear coefficient assumes the tenth unit of a dose does what the first did, which is rarely true: effects saturate, and sometimes reverse. A dose-response curve estimates the whole function, with the positivity requirement now applying at every dose level -- and it usually fails at the extremes, where few units received that much.\",\"kind\":\"estimand\",\"methods\":[{\"explain_key\":\"method.ml.dml_plr\",\"id\":\"ml.dml_plr\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Predict the outcome and the treatment from the confounders, then regress what is left of one on what is left of the other.\",\"title\":\"Double ML (partially linear)\"}],\"notation\":null,\"one_liner\":\"If we changed the dose, how would the outcome change?\",\"plain_language\":\"How the outcome changes as the level of a continuous treatment changes.\",\"profile\":\"advanced\",\"references\":[],\"see_also\":[{\"explain_key\":\"assumption.positivity\",\"explains\":\"Every kind of unit had some chance of being treated and some chance of not being treated. Where that fails, there is no comparison to make and the model is inventing one.\",\"id\":\"positivity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Positivity / overlap\",\"worry_when\":\"Any single weight carries a large share of the total; the effective sample is far below the nominal one; the propensity model separates the arms almost perfectly; treated units sit outside the control group's range.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"},{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"},{\"explain_key\":\"method.ml.dml_plr\",\"id\":\"ml.dml_plr\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Predict the outcome and the treatment from the confounders, then regress what is left of one on what is left of the other.\",\"title\":\"Double ML (partially linear)\"}],\"tags\":[\"Adjust for background differences\"],\"title\":\"Average dose-response function\"},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"estimand:dose_response\",\"kind\":\"estimand\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"dose_response\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"How the outcome changes as the level of a continuous treatment changes.\",\"title\":\"Average dose-response function\"}" .
