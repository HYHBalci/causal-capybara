rmst\",\"id\":\"survival.rmst\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Compare areas under observed Kaplan–Meier curves through a common horizon in time units; this is an unadjusted association.\",\"title\":\"Unadjusted restricted mean survival contrast\"}],\"references\":[],\"see_also\":[{\"explain_key\":\"design.survival\",\"id\":\"survival\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Follow people from a common time zero; some leave follow-up before the event is observed.\",\"title\":\"Time until an event\"}],\"speaks_to\":null,\"tags\":[\"Time until an event\"],\"title\":\"Observed Kaplan–Meier curves\",\"worry_when\":\"The card itself says what would worry me here, because that depends on the numbers this particular run produced. A longer written explanation of this check has not been added to the library yet.\"},\"disposition\":\"imported\",\"gaps\":[\"no hand-written explanation yet, so the app generates one from the record\"],\"id\":\"diagnostic:survival_curves\",\"kind\":\"diagnostic\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"survival_curves\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"A check Causal Capybara runs for you and draws on the results screen. It appears when the design is \\\"Time until an event\\\". The card it appears on carries a plain summary of what it found in your data, and a line saying what would worry me about it.\",\"title\":\"Observed Kaplan–Meier curves\"}" .
