":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:rd\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"A rule assigned treatment on one side of a threshold. Right at the threshold, which side you land on is as good as random.\",\"title\":\"A cutoff decided eligibility\"}" .
<urn:capy:design%3Asurvival> a capy:design ; skos:prefLabel "Time until an event" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"Survival analysis\",\"time-to-event\",\"right censoring\",\"Kaplan-Meier\",\"restricted mean survival time\",\"RMST\",\"accelerated failure time\",\"AFT\",\"event-free survival\"],\"catalogue_key\":\"design:survival\",\"citation_ids\":[],\"citations\":[],\"content\":{\"also_called\":[\"Survival analysis\",\"time-to-event\",\"right censoring\",\"Kaplan-Meier\",\"restricted mean survival time\",\"RMST\",\"accelerated failure time\",\"AFT\",\"event-free survival\"],\"assumption_notes\":[],\"common_mistake\":\"Starting follow-up before treatment classification is complete, creating immortal-time bias; or interpreting any fitted treatment coefficient as causal.\",\"default_estimand\":{\"acronym\":\"RMST(1) - RMST(0)\",\"explain_key\":\"estimand.rmst_difference\",\"id\":\"RMST_difference\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"Through a chosen horizon, how much event-free follow-up time differs between baseline treatments?\",\"title\":\"Restricted mean survival time difference\"},\"diagnostics\":[{\"explain_key\":\"diagnostic.survival_followup\",\"id\":\"survival_followup\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Follow-up and common horizon support\"},{\"explain_key\":\"diagnostic.survival_censoring\",\"id\":\"survival_censoring\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Right-censoring assumptions\"},{\"explain_key\":\"diagnostic.survival_curves\",\"id\":\"survival_curves\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Observed Kaplan–Meier curves\"},{\"explain_key\":\"diagnostic.aft_fit\",\"id\":\"aft_fit\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"AFT model fit and common time scale\"},{\"explain_key\":\"diagnostic.aft_support\",\"id\":\"aft_support\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Conditional treatment and censoring support\"},{\"explain_key\":\"diagnostic.survival_heterogeneity\",\"id\":\"survival_heterogeneity\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Baseline subgroup heterogeneity in survival contrasts\"}],\"estimands\":[{\"acronym\":\"S(1) - S(0)\",\"explain_key\":\"estimand.survival_difference\",\"id\":\"survival_difference\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"At a chosen horizon, how do event-free probabilities differ between baseline treatments?\",\"title\":\"Survival probability difference\"},{\"acronym\":\"RMST(1) - RMST(0)\",\"explain_key\":\"estimand.rmst_difference\",\"id\":\"RMST_difference\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"Through a chosen horizon, how much event-free follow-up time differs between baseline treatments?\",\"title\":\"Restricted mean survival time difference\"},{\"acronym\":\"exp(beta)\",\"explain_key\":\"estimand.time_ratio\",\"id\":\"time_ratio\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"Conditional on baseline covariates, what common factor stretches event times in the AFT model?\",\"title\":\"Conditional AFT time ratio\"}],\"explain_key\":\"design.survival\",\"gaps\":[],\"how_the_board_reads\":\"Define one event and a common time zero. Duration is elapsed follow-up, with 1 for the event and 0 for right censoring. Treatment is set at baseline. Choose the duration unit and a common supported horizon on the method cards. Raw group curves are associations; causal standardization needs explicit identification and censoring assumptions.\",\"id\":\"survival\",\"in_more_depth\":\"A duration/event pair records the earlier of event time and censoring time, plus whether the single event occurred. The app supports positive elapsed times, independent people, baseline binary treatment and right censoring. It refuses competing-event codes, delayed entry, interval censoring, repeated-person records and time-varying treatments. A survival model describes event times; the study design and identifying assumptions determine whether a contrast supports a causal interpretation.\",\"kind\":\"design\",\"methods\":[{\"explain_key\":\"method.survival.aft\",\"id\":\"survival.aft\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Fit a right-censored log-normal/Weibull AFT model; standardize survival/RMST over baseline covariates under explicit causal assumptions, or report a conditional time factor.\",\"title\":\"Censored AFT regression and causal standardization\"},{\"explain_key\":\"method.survival.kaplan_meier\",\"id\":\"survival.kaplan_meier\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Compare observed group event-free probabilities at an explicit common horizon; this is an unadjusted association.\",\"title\":\"Unadjusted Kaplan–Meier survival contrast\"},{\"explain_key\":\"method.survival.rmst\",\"id\":\"survival.rmst\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Compare areas under observed Kaplan–Meier curves through a common horizon in time units; this is an unadjusted association.\",\"title\":\"Unadjusted restricted mean survival contrast\"}],\"one_liner\":\"Follow people from a common time zero; some leave follow-up before the event is observed.\",\"plain_language\":\"Define the event, time zero, baseline intervention, population, observation mechanism and horizon before fitting a survival model.\",\"probes\":[],\"references\":[\"Hernán and Robins (2020), Causal Inference: What If\",\"Hernán (2010), The Hazards of Hazard Ratios\"],\"see_also\":[{\"explain_key\":\"concept.survival_time_zero\",\"id\":\"concept.survival_time_zero\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"Time zero is when eligibility is assessed, the baseline treatment strategy is classified and follow-up begins.\",\"title\":\"Align eligibility, treatment and follow-up\"},{\"explain_key\":\"concept.survival_censoring\",\"id\":\"concept.survival_censoring\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"Right censoring means follow-up ends before the event is observed; the event time remains unknown.\",\"title\":\"Censoring is an observation mechanism\"},{\"explain_key\":\"concept.survival_competing_events\",\"id\":\"concept.survival_competing_events\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"An event that prevents the outcome of interest is not automatically ordinary right censoring.\",\"title\":\"Competing events require a causal question\"},{\"acronym\":\"RMST(1) - RMST(0)\",\"explain_key\":\"estimand.rmst_difference\",\"id\":\"RMST_difference\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"Through a chosen horizon, how much event-free follow-up time differs between baseline treatments?\",\"title\":\"Restricted mean survival time difference\"},{\"acronym\":\"S(1) - S(0)\",\"explain_key\":\"estimand.survival_difference\",\"id\":\"survival_difference\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"At a chosen horizon, how do event-free probabilities differ between baseline treatments?\",\"title\":\"Survival probability difference\"},{\"acronym\":\"exp(beta)\",\"explain_key\":\"estimand.time_ratio\",\"id\":\"time_ratio\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"Conditional on baseline covariates, what common factor stretches event times in the AFT model?\",\"title\":\"Conditional AFT time ratio\"},{\"explain_key\":\"method.survival.aft\",\"id\":\"survival.aft\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Fit a right-censored log-normal/Weibull AFT model; standardize survival/RMST over baseline covariates under explicit causal assumptions, or report a conditional time factor.\",\"title\":\"Censored AFT regression and causal standardization\"},{\"explain_key\":\"method.survival.kaplan_meier\",\"id\":\"survival.kaplan_meier\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Compare observed group event-free probabilities at an explicit common horizon; this is an unadjusted association.\",\"title\":\"Unadjusted Kaplan–Meier survival contrast\"},{\"explain_key\":\"method.survival.rmst\",\"id\":\"survival.rmst\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Compare areas under observed Kaplan–Meier curves through a common horizon in time units; this is an unadjusted association.\",\"title\":\"Unadjusted restricted mean survival contrast\"}],\"tags\":[\"S(1) - S(0)\",\"RMST(1) - RMST(0)\",\"exp(beta)\"],\"title\":\"Time until an event\",\"what_it_assumes\":[{\"explain_key\":\"assumption.exchangeability\",\"explains\":\"Treated and untreated units are comparable once you condition on the confounders you measured. Everything that pushed people towards treatment and also moves the outcome is in your adjustment set.\",\"id\":\"exchangeability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Exchangeability / no unmeasured confounding\",\"worry_when\":\"Treatment was chosen by people who knew something about the likely outcome that you do not observe. Clinical judgement, self-selection into a programme, and administrative triage are the classic cases.\"},{\"explain_key\":\"assumption.positivity\",\"explains\":\"Every kind of unit had some chance of being treated and some chance of not being treated. Where that fails, there is no comparison to make and the model is inventing one.\",\"id\":\"positivity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Positivity / overlap\",\"worry_when\":\"Any single weight carries a large share of the total; the effective sample is far below the nominal one; the propensity model separates the arms almost perfectly; treated units sit outside the control group's range.\"},{\"explain_key\":\"assumption.survival_consistency\",\"explains\":\"Observed event times must agree with the potential event times under the treatment actually received, with meaningful treatment versions.\",\"id\":\"survival_consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined baseline intervention\",\"worry_when\":null},{\"explain_key\":\"assumption.survival_no_interference\",\"explains\":\"One person's event time is assumed unaffected by other people's treatment assignments.\",\"id\":\"survival_no_interference\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No interference between people\",\"worry_when\":null},{\"explain_key\":\"assumption.conditional_independent_censoring\",\"explains\":\"Given baseline treatment and covariates, censoring must not convey additional information about the unobserved event time.\",\"id\":\"conditional_independent_censoring\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Independent censoring conditional on treatment and baseline covariates\",\"worry_when\":null}],\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"design:survival\",\"kind\":\"design\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"survival\",\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:01cd61912e1028a2f83099c9\",\"object_id\":\"estimand:time_ratio\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:survival\"},{\"a