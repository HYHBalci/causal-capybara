ject_id\":\"claim:aipw-att-control-nuisance\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/observational.py\",\"tests/python/test_observational.py\",\"https://arxiv.org/html/1608.00060v7\",\"https://doi.org/10.1111/j.1541-0420.2005.00377.x\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"source_ids\":[\"source:note:aipw\",\"chernozhukov2018\",\"bang2005\"],\"summary\":\"The ATT AIPW score uses the control outcome nuisance m0 and propensity odds for controls; it does not require a treated outcome nuisance m1 in that score.\",\"title\":\"ATT control outcome nuisance m0\"}" .
<urn:capy:claim%3Aaipw-att-positivity> a capy:claim ; skos:prefLabel "ATT asymmetric positivity and treated support" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Aaipw> ; capy:record "{\"aliases\":[\"ATT overlap\",\"treated support\",\"asymmetric positivity\",\"zero propensity\"],\"assertion_mode\":\"original_editorial_explanation\",\"citation_ids\":[\"chernozhukov2018\",\"hernan2020\",\"source:note:aipw\"],\"citations\":[],\"conditions\":[\"ATT is the declared target.\",\"Untreated counterfactual outcomes are exchangeable conditional on the adjustment set.\",\"Controls have positive probability on treated support.\"],\"counterevidence\":[\"Stable estimation and inference can require stronger bounds or moment conditions than minimal identification.\",\"ATE has a different support requirement.\"],\"evidence_ids\":[\"evidence:aipw-att-positivity\"],\"gaps\":[\"The fitted propensity plot cannot certify population support.\"],\"id\":\"claim:aipw-att-positivity\",\"kind\":\"claim\",\"provenance\":[\"source:note:aipw\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:1af4844107c5452aa4719842\",\"object_id\":\"chernozhukov2018\",\"predicate\":\"cites\",\"provenance\":[\"source:note:aipw\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/observational.py\",\"tests/python/test_observational.py\",\"https://miguelhernan.org/whatifbook\",\"https://arxiv.org/html/1608.00060v7\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\