"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Citation and original explanation; linked external bodies are not included.\",\"subject_id\":\"claim:survival-heterogeneity\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:5e3d08df8141c22020ac8503\",\"object_id\":\"source:note:survival-heterogeneity\",\"predicate\":\"cites\",\"provenance\":[\"source:note:survival-heterogeneity\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Citation and original explanation; linked external bodies are not included.\",\"subject_id\":\"claim:survival-heterogeneity\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"The same time units and horizon are supported in each required treatment-by-subgroup cell.\",\"Both treatment arms occur in every target subgroup.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:9ed18357318b01b2aefb8139\",\"object_id\":\"survival.kaplan_meier\",\"predicate\":\"qualifies\",\"provenance\":[\"source:note:survival-heterogeneity\",\"source:ontology:cole2004\",\"source:ontology:uno2014\",\"source:ontology:altman2003\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"subject_id\":\"claim:survival-heterogeneity\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"The same time units and horizon are supported in each required treatment-by-subgroup cell.\",\"Both treatment arms occur in every target subgroup.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:d0f8cc124b7de9b0e5111a5c\",\"object_id\":\"survival.aft\",\"predicate\":\"qualifies\",\"provenance\":[\"source:note:survival-heterogeneity\",\"source:ontology:cole2004\",\"source:ontology:uno2014\",\"source:ontology:altman2003\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"subject_id\":\"claim:survival-heterogeneity\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:ee9f99b616af2c6ded4b51a3\",\"object_id\":\"source:ontology:altman2003\",\"predicate\":\"cites\",\"provenance\":[\"source:note:survival-heterogeneity\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Citation and original explanation; linked external bodies are not included.\",\"subject_id\":\"claim:survival-heterogeneity\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"source_ids\":[\"source:note:survival-heterogeneity\",\"source:ontology:cole2004\",\"source:ontology:uno2014\",\"source:ontology:altman2003\"],\"summary\":\"Compare KM survival differences at a fixed horizon or RMST differences integrated through the same horizon across baseline subgroups. Raw within-cell KM requires a defensible censoring assumption within each treatment-by-subgroup cell; conditioning only in a later interpretation does not adjust that estimator. Estimate the joint covariance of the subgroup contrasts, preserve the sampling unit when resampling, and disclose failed replicates. A log-rank test is not a test of equality of those fixed-horizon treatment contrasts.\",\"title\":\"KM and RMST heterogeneity depend on common horizons and subgroup support\"}" .
