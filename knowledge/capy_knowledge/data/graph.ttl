ghts\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Not everyone offered a programme takes it. Report what the offer did, and separately what taking it up did for the people it moved.\",\"title\":\"ITT and CACE (noncompliance)\"}" .
<urn:capy:rct.cluster> a capy:method ; skos:prefLabel "Cluster-randomised trial" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:rct.cluster\"],\"catalogue_key\":\"method:rct.cluster\",\"citation_ids\":[\"10.1080/07350015.2016.1247004\",\"10.1162/rest_a_00552\",\"source:unresolved:04641d93b8c479f115ee\",\"source:unresolved:7b2f9efef7c2c47080c5\",\"source:unresolved:c7c1f7215fed6b2a856c\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":null,\"engines\":{\"python\":true,\"r\":\"clubSandwich, estimatr (lm_robust with clusters)\"},\"needs_r_packages\":[\"clubSandwich, estimatr (lm_robust with clusters)\"],\"runs_here\":true,\"summary\":\"Runs on this computer with what the app already installs.\"},\"designs\":[{\"explain_key\":\"design.rct\",\"id\":\"rct\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"People were assigned by chance, or as good as chance.\",\"title\":\"Randomised or as-if randomised\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.baseline_balance\",\"id\":\"baseline_balance\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Baseline balance\"},{\"explain_key\":\"diagnostic.cluster_structure\",\"id\":\"cluster_structure\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Cluster structure\"},{\"explain_key\":\"diagnostic.icc_design_effect\",\"id\":\"icc_design_effect\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Intra-cluster correlation and design effect\"},{\"explain_key\":\"diagnostic.differential_attrition\",\"id\":\"differential_attrition\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Differential attrition\"},{\"explain_key\":\"diagnostic.outcome_distribution\",\"id\":\"outcome_distribution\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Outcome distribution\"}],\"estimands\":[{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"},{\"acronym\":\"ITT\",\"explain_key\":\"estimand.itt\",\"id\":\"ITT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For everyone who was offered it, what did the offer do?\",\"title\":\"Intention to treat\"}],\"explain_key\":\"method.rct.cluster\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"rct.cluster\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":false,\"one_liner\":\"When whole schools, clinics or villages were assigned, the number of clusters is the sample size that matters.\",\"options\":[{\"choices\":[\"CR2\",\"CR1\"],\"default\":\"CR2\",\"help\":\"CR2 applies the Bell-McCaffrey small-sample correction. CR1 is the ordinary cluster sandwich, which is too small when there are few clusters.\",\"label\":\"Cluster-robust variance\",\"name\":\"vcov\",\"profile\":\"standard\",\"type\":\"select\"},{\"choices\":[\"individual\",\"cluster\"],\"default\":\"individual\",\"help\":\"With few clusters, a t-test on cluster means makes no large-sample assumption at all. Both are always reported; this chooses the headline.\",\"label\":\"Analyse individuals or cluster means\",\"name\":\"unit_of_analysis\",\"profile\":\"standard\",\"type\":\"select\"},{\"default\":true,\"help\":\"Covariates enter additively. Cluster-level covariates help most; individual-level ones mostly reduce within-cluster noise.\",\"label\":\"Adjust for baseline covariates\",\"name\":\"adjust\",\"profile\":\"standard\",\"type\":\"bool\"},{\"default\":40,\"help\":\"Cluster-robust inference is justified as the number of clusters grows. Forty is the usual rule of thumb, not a threshold with a proof behind it.\",\"label\":\"Warn below this many clusters\",\"min\":2,\"name\":\"min_clusters_warn\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":500,\"help\":\"The CR2 correction inverts a matrix the size of each cluster. Above this, the run falls back to CR1 and says so.\",\"label\":\"Largest cluster CR2 will handle\",\"min\":2,\"name\":\"cr2_max_cluster\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":0.95,\"help\":\"The coverage of the interval reported next to the estimate.\",\"label\":\"Confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"}],\"plain_language\":\"When whole schools, clinics or villages were assigned, the number of clusters is the sample size that matters.\",\"probes\":[{\"explain_key\":\"probe.placebo_outcome\",\"id\":\"probe.placebo_outcome\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the same analysis on something the treatment could not have changed. It should find nothing.\",\"requested_as\":\"placebo_outcome\",\"title\":\"Placebo outcome\"},{\"explain_key\":\"probe.alternate_spec\",\"id\":\"probe.alternate_spec\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the grid of defensible specifications and sort the answers. The curve is the result, not the one you happened to run.\",\"requested_as\":\"alternate_spec\",\"title\":\"Specification curve\"},{\"explain_key\":\"method.rct.randomization_inference\",\"id\":\"rct.randomization_inference\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Re-run the randomisation thousands of times with the outcomes held fixed, and see how unusual what actually happened really is.\",\"requested_as\":\"randomization_inference\",\"title\":\"Randomisation (Fisher) inference\"},{\"explain_key\":\"probe.subset\",\"id\":\"probe.subset\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Re-estimate on random subsets. The answer should move about as much as losing that much data costs, and no more.\",\"requested_as\":\"subset_refuter\",\"title\":\"Subset stability\"}],\"references\":[\"Bell and McCaffrey (2002), Bias Reduction in Standard Errors for Linear Regression with Multi-Stage Samples\",\"Imbens and Kolesar (2016), Robust Standard Errors in Small Samples\",\"Pustejovsky and Tipton (2018), Small-Sample Methods for Cluster-Robust Variance Estimation and Hypothesis Testing\",\"Cameron and Miller (2015), A Practitioner's Guide to Cluster-Robust Inference\",\"Hayes and Moulton (2017), Cluster Randomised Trials\"],\"roles_forbidden\":[\"an instrument\",\"a running variable\"],\"roles_optional\":[\"at least one measured confounder\",\"strata\"],\"roles_required\":[\"a treatment\",\"an outcome\",\"a clustering variable\"],\"see_also\":[{\"explain_key\":\"design.rct\",\"id\":\"rct\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"People were assigned by chance, or as good as chance.\",\"title\":\"Randomised or as-if randomised\"},{\"explain_key\":\"method.bounds.manski\",\"id\":\"bounds.manski\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Report the range the effect must lie in given only what the data can support, without assuming away the missing counterfactual.\",\"title\":\"Manski bounds\"},{\"explain_key\":\"method.interference.exposure\",\"id\":\"interference.exposure\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"When one unit's treatment affects another's outcome, estimate the direct and spillover effects separately instead of pretending neither exists.\",\"title\":\"Interference and spillovers\"},{\"explain_key\":\"method.rct.cace\",\"id\":\"rct.cace\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Not everyone offered a programme takes it. Report what the offer did, and separately what taking it up did for the people it moved.\",\"title\":\"ITT and CACE (noncompliance)\"},{\"explain_key\":\"method.rct.diff_means\",\"id\":\"rct.diff_means\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Compare the two arms as they were randomised, and let covariates sharpen the comparison without letting them change the question.\",\"title\":\"Difference in means\"},{\"explain_key\":\"method.rct.randomization_inference\",\"id\":\"rct.randomization_inference\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Re-run the randomisation thousands of times with the outcomes held fixed, and see how unusual what actually happened really is.\",\"title\":\"Randomisation (Fisher) inference\"},{\"explain_key\":\"method.rct.stratified\",\"id\":\"rct.stratified\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Estimate inside the blocks the randomisation was run in, then average them the way your estimand says to.\",\"title\":\"Blocked or stratified experiment\"}],\"status\":\"recommended\",\"status_label\":\"Recommended\",\"tags\":[\"Randomised or as-if randomised\",\"ATE\",\"ITT\",\"Recommended\"],\"title\":\"Cluster-randomised trial\",\"what_it_assumes\":[{\"explain_key\":\"assumption.randomisation\",\"explains\":\"Assignment really was by chance, and nothing after assignment broke the comparison -- no differential dropout, no crossover you have not modelled.\",\"id\":\"randomisation\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Randomisation held\",\"worry_when\":\"Dropout differs across arms; take-up is far from assignment; the randomiser was a person with discretion.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"when_not_to_use\":[\"Cluster-robust standard errors are justified by the number of clusters, not the number of rows: with fewer than about forty they are too small even with CR2. This adapter uses G - 1 degrees of freedom rather than the Bell-McCaffrey/Satterthwaite approximation, which can be optimistic when cluster sizes are unequal. If cluster size correlates with the effect, the individual-level and cluster-level answers differ and neither is wrong.\",\"Fewer than about fifteen clusters -- prefer randomisation inference, which does not need a large-G approximation.\"],\"when_to_use\":[\"Assignment happened to whole groups, so outcomes inside a group are not independent draws. Treating rows as independent would make the interval far too narrow.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"rct.cluster\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"rct.cluster\",\"registry\":{\"designs\":[\"rct\"],\"diagnostics\":[\"baseline_balance\",\"cluster_structure\",\"icc_design_effect\",\"differential_attrition\",\"outcome_distribution\"],\"disrecommend_when\":\"Fewer than about fifteen clusters -- prefer randomisation inference, which does not need a large-G approximation.\",\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":true,\"r\":\"clubSandwich, estimatr (lm_robust with clusters)\"},\"estimands\":[\"ATE\",\"ITT\"],\"explain_key\":\"method.rct.cluster\",\"id\":\"rct.cluster\",\"needs\":[\"numpy\",\"pandas\",\"scipy\"],\"needs_overlap\":false,\"one_liner\":\"When whole schools, clinics or villages were assigned, the number of clusters is the sample size that matters.\",\"options\":[{\"choices\":[\"CR2\",\"CR1\"],\"default\":\"CR2\",\"help\":\"CR2 applies the Bell-McCaffrey small-sample correction. CR1 is the ordinary cluster sandwich, which is too small when there are few clusters.\",\"label\":\"Cluster-robust variance\",\"name\":\"vcov\",\"profile\":\"standard\",\"type\":\"select\"},{\"choices\":[\"individual\",\"cluster\"],\"default\":\"individual\",\"help\":\"With few clusters, a t-test on cluster means makes no large-sample assumption at all. Both are always reported; this chooses the headline.\",\"label\":\"Analyse individuals or cluster means\",\"name\":\"unit_of_analysis\",\"profile\":\"standard\",\"type\":\"select\"},{\"default\":true,\"help\":\"Covariates enter additively. Cluster-level covariates help most; individual-level ones mostly reduce within-cluster noise.\",\"label\":\"Adjust for baseline covariates\",\"name\":\"adjust\",\"profile\":\"standard\",\"type\":\"bool\"},{\"default\":40,\"help\":\"Cluster-robust inference is justified as the number of clusters grows. Forty is the usual rule of thumb, not a threshold with a proof behind it.\",\"label\":\"Warn below this many clusters\",\"min\":2,\"name\":\"min_clusters_warn\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":500,\"help\":\"The CR2 correction inverts a matrix the size of each cluster. Above this, the run falls back to CR1 and says so.\",\"label\":\"Largest cluster CR2 will handle\",\"min\":2,\"name\":\"cr2_max_cluster\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":0.95,\"help\":\"The coverage of the interval reported next to the estimate.\",\"label\":\"Confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"}],\"probes\":[\"placebo_outcome\",\"alternate_spec\",\"randomization_inference\",\"subset_refuter\"],\"reference_dispositions\":[{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:c7c1f7215fed6b2a856c\",\"requested_as\":\"Bell and McCaffrey (2002), Bias Reduction in Standard Errors for Linear Regression with Multi-Stage Samples\"},{\"disposition\":\"resolved_metadata\",\"id\":\"10.1162/rest_a_00552\",\"requested_as\":\"Imbens and Kolesar (2016), Robust Standard Errors in Small Samples\"},{\"disposition\":\"resolved_metadata\",\"id\":\"10.1080/07350015.2016.1247004\",\"requested_as\":\"Pustejovsky and Tipton (2018), Small-Sample Methods for Cluster-Robust Variance Estimation and Hypothesis Testing\"},{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:7b2f9efef7c2c47080c5\",\"requested_as\":\"Cameron and Miller (2015), A Practitioner's Guide to Cluster-Robust Inference\"},{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:04641d93b8c479f115ee\",\"requested_as\":\"Hayes and Moulton (2017), Cluster Randomised Trials\"}],\"reference_ids\":[\"source:unresolved:c7c1f7215fed6b2a856c\",\"10.1162/rest_a_00552\",\"10.1080/07350015.2016.1247004\",\"source:unresolved:7b2f9efef7c2c47080c5\",\"source:unresolved:04641d93b8c479f115ee\"],\"references\":[\"Bell and McCaffrey (2002), Bias Reduction in Standard Errors for Linear Regression with Multi-Stage Samples\",\"Imbens and Kolesar (2016), Robust Standard Errors in Small Samples\",\"Pustejovsky and Tipton (2018), Small-Sample Methods for Cluster-Robust Variance Estimation and Hypothesis Testing\",\"Cameron and Miller (2015), A Practitioner's Guide to Cluster-Robust Inference\",\"Hayes and Moulton (2017), Cluster Randomised Trials\"],\"roles_forbidden\":[\"instruments\",\"running\"],\"roles_optional\":[\"confounders\",\"strata\"],\"roles_required\":[\"treatment\",\"outcome\",\"cluster\"],\"source_path\":\"engines/python/capy_py/rct.py\",\"source_sha256\":\"ad0630960d6aaff7fdef9a290c97dcb094099f646bd6ff87151d786a5604baa8\",\"status\":\"recommended\",\"title\":\"Cluster-randomised trial\",\"what_can_go_wrong\":\"Cluster-robust standard errors are justified by the number of clusters, not the number of rows: with fewer than about forty they are too small even with CR2. This adapter uses G - 1 degrees of freedom rather than the Bell-McCaffrey/Satterthwaite approximation, which can be optimistic when cluster sizes are unequal. If cluster size correlates with the effect, the individual-level and cluster-level answers differ and neither is wrong.\",\"why_recommended\":\"Assignment happened to whole groups, so outcomes inside a group are not independent draws. Treating rows as independent would make the interval far too narrow.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:0336cc02c71c6544bed59079\",\"object_id\":\"diagnostic:cluster_structure\",\"predicate\":\"checked_by_diagnostic\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"rct.cluster\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:04158f8ed27db7d508418030\",\"object_id\":\"diagnostic:differential_attrition\",\"predicate\":\"checked_by_diagnostic\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structura