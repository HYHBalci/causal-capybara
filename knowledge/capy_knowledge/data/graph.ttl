"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:64c1acbfcd4d2c18e774e50b\",\"object_id\":\"concept:separable-effects\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:stensrud2020\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Qualified conceptual navigation; related terms are not equivalent estimands or verified identifying conditions.\",\"subject_id\":\"concept:competing-event\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:b53e5fb1063878f5d07b41a9\",\"object_id\":\"concept:causal-survival\",\"predicate\":\"broader\",\"provenance\":[\"source:project-ontology\",\"source:ontology:young2019\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Qualified conceptual navigation; related terms are not equivalent estimands or verified identifying conditions.\",\"subject_id\":\"concept:competing-event\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:bcf805e474634174744b0135\",\"object_id\":\"concept:cumulative-incidence\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:young2019\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Qualified conceptual navigation; related terms are not equivalent estimands or verified identifying conditions.\",\"subject_id\":\"concept:competing-event\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Original methodological context for Competing events; not a study finding or a complete review of every implementation.\",\"source_ids\":[\"source:ontology:young2019\"],\"summary\":\"A competing event prevents the focal event; deciding whether to eliminate it or leave it in the strategy changes the causal question.\",\"title\":\"Competing events\"}" .
<urn:capy:concept%3Aconcept.about> a capy:concept ; skos:prefLabel "About Causal Capybara" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"concept:concept.about\",\"citation_ids\":[],\"citations\":[],\"content\":{\"common_mistake\":null,\"explain_key\":\"concept.about\",\"gaps\":[\"no citation\"],\"id\":\"concept.about\",\"in_more_depth\":\"The object of work here is a causal question, not an equation. You state the question in ordinary language, complete a picture of the research design, look at the diagnostics that design depends on, and then estimate -- usually with several methods at once, because the disagreement between them is part of what you learned. Everything runs locally. Your data does not leave this machine unless you export it, and there is no telemetry. The engines are the R and Python packages the field already publishes with; this application orchestrates them, records what was assumed, and refuses to present an estimate as causal because of the estimator's name. Copyright 2026 Yusufhan Balci; VCESR. Original project code and documentation are licensed under Apache-2.0; see the installed LICENSE and NOTICE for the terms and third-party attribution.\",\"kind\":\"concept\",\"one_liner\":\"A desktop studio for applied causal inference. Serious causal inference, casual to use.\",\"plain_language\":\"A desktop studio for applied causal inference. Serious causal inference, casual to use.\",\"references\":[],\"see_also\":[{\"explain_key\":\"concept.provisional\",\"id\":\"concept.provisional\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"A result the product does not think you should trust as it stands. It still computed it; it just will not let the flag disappear.\",\"title\":\"Provisional results\"},{\"explain_key\":\"concept.forest_plot\",\"id\":\"concept.forest_plot\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"One row per method, each with its interval. When several methods ran, the forest is the result -- not a single number chosen from it.\",\"title\":\"The forest plot, and why there is no headline number\"}],\"tags\":[],\"title\":\"About Causal Capybara\",\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[\"no citation\"],\"id\":\"concept:concept.about\",\"kind\":\"concept\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"concept.about\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"A desktop studio for applied causal inference. Serious causal inference, casual to use.\",\"title\":\"About Causal Capybara\"}" .
<urn:capy:concept%3Aconcept.caliper> a capy:concept ; skos:prefLabel "Caliper" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"concept:concept.caliper\",\"citation_ids\":[],\"citations\":[],\"content\":{\"common_mistake\":null,\"explain_key\":\"concept.caliper\",\"gaps\":[\"no citation\"],\"id\":\"concept.caliper\",\"in_more_depth\":\"Matching pairs each treated unit with the most similar untreated one available -- but \\\"the most similar available\\\" can still be very dissimilar when the comparison pool is thin. A caliper puts a bound on the gap, usually stated as a fraction of the spread of the estimated treatment probability, and refuses the pair when nothing falls inside it. The trade is explicit. A tight caliper gives better-matched pairs and drops more treated units; a loose one keeps everybody and admits worse comparisons. The dropping is not just a loss of precision: the question changes with it, because the answer now describes the treated units that could be matched rather than all of them. That is why the count of unmatched treated units belongs beside the estimate rather than in a footnote.\",\"kind\":\"concept\",\"one_liner\":\"The largest difference you are willing to tolerate inside a matched pair. Beyond it the treated unit is left unmatched rather than paired with somebody unlike them.\",\"plain_language\":\"The largest difference you are willing to tolerate inside a matched pair. Beyond it the treated unit is left unmatched rather than paired with somebody unlike them.\",\"references\":[],\"see_also\":[{\"explain_key\":\"diagnostic.n_matched\",\"id\":\"n_matched\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Match quality\"},{\"explain_key\":\"method.obs.matching.nn\",\"id\":\"obs.matching.nn\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Pair each treated unit with the most similar untreated unit, then compare within pairs.\",\"title\":\"Nearest-neighbour matching\"},{\"explain_key\":\"diagnostic.overlap\",\"id\":\"overlap\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Overlap between the arms\"},{\"explain_key\":\"concept.standardised_difference\",\"id\":\"concept.standardised_difference\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"The gap between groups on a covariate, divided by a pooled standard deviation, so covariates on different scales can be compared on one axis.\",\"title\":\"Standardised mean difference\"}],\"tags\":[],\"title\":\"Caliper\",\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[\"no citation\"],\"id\":\"concept:concept.caliper\",\"kind\":\"concept\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"concept.caliper\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"The largest difference you are willing to tolerate inside a matched pair. Beyond it the treated unit is left unmatched rather than paired with somebody unlike them.\",\"title\":\"Caliper\"}" .
<urn:capy:concept%3Aconcept.cluster_robust_se> a capy:concept ; skos:prefLabel "Cluster-robust standard errors" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"concept:concept.cluster_robust_se\",\"citation_ids\":[],\"citations\":[],\"content\":{\"common_mistake\":\"Clustering at the wrong level -- on the individual when assignment was by school, or on the year when the policy varied by state. The rule is to cluster at the level treatment was assigned.\",\"explain_key\":\"concept.cluster_robust_se\",\"gaps\":[\"no citation\"],\"id\":\"concept.cluster_robust_se\",\"in_more_depth\":\"If a whole school was assigned to the programme together, its pupils do not each carry separate evidence about whether the programme works: they share a headteacher, a catchment and a year. An interval computed as though the pupils were independent counts the same information over and over and comes out far too narrow, so an effect looks settled when it is not. The cluster-robust version allows rows within a group to be related in any way at all, and assumes only that different groups are independent of each other. What it needs in return is enough groups. Its accuracy grows with the number of clusters, not the number of rows, and with only a couple of dozen it becomes optimistic again -- which is the point at which a small-sample correction, or reshuffling whole clusters at a time, is the safer route.\",\"kind\":\"concept\",\"one_liner\":\"A way of computing uncertainty that treats each group -- a school, a village, a clinic -- as one group's worth of independent evidence, rather than counting every row inside it separately.\",\"plain_language\":\"A way of computing uncertainty that treats each group -- a school, a village, a clinic -- as one group's worth of independent evidence, rather than counting every row inside it separately.\",\"references\":[],\"see_also\":[{\"explain_key\":\"concept.clustering\",\"id\":\"concept.clustering\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"When treatment was assigned to whole groups -- states, schools, clinics -- the number of independent observations is closer to the number of groups than the number of rows.\",\"title\":\"Clustering\"},{\"explain_key\":\"diagnostic.cluster_structure\",\"id\":\"cluster_structure\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Cluster structure\"},{\"explain_key\":\"method.rct.cluster\",\"id\":\"rct.cluster\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"When whole schools, clinics or villages were assigned, the number of clusters is the sample size that matters.\",\"title\":\"Cluster-randomised trial\"},{\"explain_key\":\"diagnostic.permutation_distribution\",\"id\":\"permutation_distribution\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Randomisation distribution\"}],\"tags\":[],\"title\":\"Cluster-robust standard errors\",\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[\"no citation\"],\"id\":\"concept:concept.cluster_robust_se\",\"kind\":\"concept\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"concept.cluster_robust_se\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"A way of computing uncertainty that treats each group -- a school, a village, a clinic -- as one group's worth of independent evidence, rather than counting every row inside it separately.\",\"title\":\"Cluster-robust standard errors\"}" .
<urn:capy:concept%3Aconcept.clustering> a capy:concept ; skos:prefLabel "Clustering" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"concept:concept.clustering\",\"citation_ids\":[],\"citations\":[],\"content\":{\"common_mistake\":null,\"explain_key\":\"concept.clustering\",\"gaps\":[],\"id\":\"concept.clustering\",\"in_more_depth\":\"Standard errors that ignore the group structure can be several times too small, which turns a null result into a finding. The rule of thumb is to cluster at the level treatment was assigned at, which is usually coarser than the level the data is stored at. With few clusters -- under about forty -- the usual cluster-robust correction is itself unreliable, and the honest move is a small-sample correction, a t distribution with the number of clusters minus one, or a cluster bootstrap. This product states which one it used on every result.\",\"kind\":\"concept\",\"one_liner\":\"When treatment was assigned to whole groups -- states, schools, clinics -- the number of independent observations is closer to the number of groups than the number of rows.\",\"plain_language\":\"When treatment was assigned to whole groups -- states, schools, clinics -- the number of independent observations is closer to the number of groups than the number of rows.\",\"references\":[\"Cameron & Miller (2015), A practitioner's guide to cluster-robust inference\"],\"see_also\":[{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"},{\"explain_key\":\"method.rct.cluster\",\"id\":\"rct.cluster\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"When whole schools, clinics or villages were assigned, the number of clusters is the sample size that matters.\",\"title\":\"Cluster-randomised trial\"}],\"tags\":[],\"title\":\"Clustering\",\"worry_when\":\"Fewer than about forty clusters; very unequal cluster sizes; clustering at a finer level than treatment was assigned.\"},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"concept:concept.clustering\",\"kind\":\"concept\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"concept.clustering\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"When treatment was assigned to whole groups -- states, schools, clinics -- the number of independent observations is closer to the number of groups than the number of rows.\",\"title\":\"Clustering\"}" .
<urn:capy:concept%3Aconcept.collider> a capy:concept ; skos:prefLabel "Colliders and why adjusting can hurt" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"concept:concept.collider\",\"citation_ids\":[],\"citations\":[],\"content\":{\"common_mistake\":\"Treating \\\"adjust for more covariates\\\" as always safer. Colliders and post-treatment variables make it worse.\",\"explain_key\":\"concept.collider\",\"gaps\":[],\"id\":\"concept.collider\",\"in_more_depth\":\"Suppose talent and looks both help an actor get hired, and are unrelated in the population. Among people who were hired, the two become negatively related: if someone got in without much talent, they probably had looks. Nothing caused that association except your decision to look only at the hired. The same thing happens whenever you adjust for a variable that treatment and outcome both influence, or condition on a sample selected on such a variable. It is bias you added.\",\"kind\":\"concept\",\"one_liner\":\"A variable that two arrows point into. Conditioning on it creates an association between its causes that was not there before.\",\"plain_language\":\"A variable that two arrows point into. Conditioning on it creates an association between its causes that was not there before.\",\"references\":[\"Elwert & Winship (2014), Endogenous selection bias\"],\"see_also\":[{\"explain_key\":\"guardrail.bad_control\",\"id\":\"guardrail.bad_control\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"Anything measured after treatment, or caused by it, does not belong in the adjustment set. Adjusting for it blocks part of the effect you are trying to measure.\",\"title\":\"Bad controls\"},{\"explain_key\":\"concept.selection_bias\",\"id\":\"concept.selection_bias\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"Who ends up in your analysis sample can create an association all by itself, quite apart from confounding.\",\"title\":\"Selection bias\"},{\"explain_key\":\"design.catalogue\",\"id\":\"catalogue\",\"in_catalogue\":false,\"kind\":\"design\",\"one_liner\":\"Skip the cards; open the method catalogue with a search box.\",\"title\":\"I already know the method\"}],\"tags\":[],\"title\":\"Colliders and why adjusting can hurt\",\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"concept:concept.collider\",\"kind\":\"concept\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"concept.collider\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"A variable that two arrows point into. Conditioning on it creates an association between its causes that was not there before.\",\"title\":\"Colliders and why adjusting can hurt\"}" .
<urn:capy:concept%3Aconcept.complete_case> a capy:concept ; skos:prefLabel "Complete-case analysis" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"concept:concept.complete_case\",\"citation_ids\":[],\"citations\":[],\"content\":{\"common_mistake\":\"Reporting the analysis sample size without the starting one, so a third of the data can disappear without anybody noticing.\",\"explain_key\":\"concept.complete_case\",\"gaps\":[\"no citation\"],\"id\":\"concept.complete_case\",\"in_more_depth\":\"The rows that survive are not a random sample of the rows you started with. If the people doing badly were also the ones more likely to skip the follow-up, the surviving sample is healthier than the population it is meant to describe, and every number computed on it inherits that. The bias can run in either direction, and how large it is cannot be read off the rows that remain. It is not always wrong. If whatever drove the missingness is unrelated to the outcome once you account for the variables you kept, complete cases are unbiased and merely less precise. The honest minimum is to report how many rows went, and whether they went from the treated and untreated groups at the same rate.\",\"kind\":\"concept\",\"one_liner\":\"Dropping every row that is missing any value the analysis needs and computing on what is left. Most software does this silently.\",\"plain_language\":\"Dropping every row that is missing any value the analysis needs and computing on what is left. Most software does this silently.\",\"references\":[],\"see_also\":[{\"explain_key\":\"diagnostic.differential_attrition\",\"id\":\"differential_attrition\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Differential attrition\"},{\"explain_key\":\"concept.selection_bias\",\"id\":\"concept.selection_bias\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"Who ends up in your analysis sample can create an association all by itself, quite apart from confounding.\",\"title\":\"Selection bias\"},{\"explain_key\":\"concept.consort\",\"id\":\"concept.consort\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"A step-by-step record of how the imported rows became the analysis sample, with a reason for every row that left.\",\"title\":\"The sample flow\"}],\"tags\":[],\"title\":\"Complete-case analysis\",\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[\"no citation\"],\"id\":\"concept:concept.complete_case\",\"kind\":\"concept\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"concept.complete_case\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Dropping every row that is missing any value the analysis needs and computing on what is left. Most software does this silently.\",\"title\":\"Complete-case analysis\"}" .
<urn:capy:concept%3Aconcept.confounding> a capy:concept ; skos:prefLabel "Confounding" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"concept:concept.confounding\",\"citation_ids\":[],\"citations\":[],\"content\":{\"common_mistake\":\"Adjusting for everything available. Some variables -- descendants of the treatment, and colliders -- introduce bias when you condition on them.\",\"explain_key\":\"concept.confounding\",\"gaps\":[\"no citation\"],\"id\":\"concept.confounding\",\"in_more_depth\":\"If healthier people are both more likely to take a drug and more likely to survive, the drug looks effective whether or not it is. Adjusting means comparing treated and untreated units that match on the common cause, so that the remaining difference cannot be explained by it. The hard part is not the arithmetic; it is knowing what the common causes are. Adjustment can only handle the ones you measured, which is why the exchangeability assumption stays untested no matter how good the balance plot looks.\",\"kind\":\"concept\",\"one_liner\":\"A common cause of both the treatment and the outcome makes the two look related even when the treatment does nothing.\",\"plain_language\":\"A common cause of both the treatment and the outcome makes the two look related even when the treatment does nothing.\",\"references\":[],\"see_also\":[{\"explain_key\":\"assumption.exchangeability\",\"explains\":\"Treated and untreated units are comparable once you condition on the confounders you measured. Everything that pushed people towards treatment and also moves the outcome is in your adjustment set.\",\"id\":\"exchangeability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Exchangeability / no unmeasured confounding\",\"worry_when\":\"Treatment was chosen by people who knew something about the likely outcome that you do not observe. Clinical judgement, self-selection into a programme, and administrative triage are the classic cases.\"},{\"explain_key\":\"concept.collider\",\"id\":\"concept.collider\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"A variable that two arrows point into. Conditioning on it creates an association between its causes that was not there before.\",\"title\":\"Colliders and why adjusting can hurt\"},{\"explain_key\":\"guardrail.bad_control\",\"id\":\"guardrail.bad_control\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"Anything measured after treatment, or caused by it, does not belong in the adjustment set. Adjusting for it blocks part of the effect you are trying to measure.\",\"title\":\"Bad controls\"}],\"tags\":[],\"title\":\"Confounding\",\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[\"no citation\"],\"id\":\"concept:concept.confounding\",\"kind\":\"concept\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"concept.confounding\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"A common cause of both the treatment and the outcome makes the two look related even when the treatment does nothing.\",\"title\":\"Confounding\"}" .
<urn:capy:concept%3Aconcept.consort> a capy:concept ; skos:prefLabel "The sample flow" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"concept:concept.consort\",\"citation_ids\":[],\"citations\":[],\"content\":{\"common_mistake\":null,\"explain_key\":\"concept.consort\",\"gaps\":[\"no citation\"],\"id\":\"concept.consort\",\"in_more_depth\":\"Borrowed from the CONSORT diagrams of clinical trials. Complete-case drops, caliper failures, trimming, bandwidth truncation and donor restrictions all appear as explicit steps. The rule behind it is that no estimator in this product is allowed to silently change the population an estimate refers to. If matching could not find a partner for a fifth of the treated units, the estimand is now the effect for the other four fifths, and the flow says so.\",\"kind\":\"concept\",\"one_liner\":\"A step-by-step record of how the imported rows became the analysis sample, with a reason for every row that left.\",\"plain_language\":\"A step-by-step record of how the imported rows became the analysis sample, with a reason for every row that left.\",\"references\":[],\"see_also\":[{\"explain_key\":\"concept.selection_bias\",\"id\":\"concept.selection_bias\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"Who ends up in your analysis sample can create an association all by itself, quite apart from confounding.\",\"title\":\"Selection bias\"},{\"explain_key\":\"concept.effective_sample_size\",\"id\":\"concept.effective_sample_size\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"How many observations your weighted comparison is really worth. Almost always smaller than the number of rows, sometimes dramatically.\",\"title\":\"Effective sample size\"}],\"tags\":[],\"title\":\"The sample flow\",\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[\"no citation\"],\"id\":\"concept:concept.consort\",\"kind\":\"concept\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"concept.consort\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"A step-by-step record of how the imported rows became the analysis sample, with a reason for every row that left.\",\"title\":\"The sample flow\"}" .
<urn:capy:concept%3Aconcept.cross_fitting> a capy:concept ; skos:prefLabel "Cross-fitting" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"concept:concept.cross_fitting\",\"citation_ids\":[],\"citations\":[],\"content\":{\"common_mistake\":null,\"explain_key\":\"concept.cross_fitting\",\"gaps\":[],\"id\":\"concept.cross_fitting\",\"in_more_depth\":\"Machine-learning models for the treatment and outcome overfit, and if the same rows fit the model and enter the score, the overfitting shows up as bias in the estimate and as a confidence interval that is too narrow. Splitting into folds, fitting on the complement and predicting on the held- out fold removes that route, at the price of a little variance. It is what makes double machine learning honest, and it is why the fold diagnostics are mandatory whenever a learner is used: if the estimate swings wildly across folds, the answer depends on the split.\",\"kind\":\"concept\",\"one_liner\":\"Fit the nuisance models on one part of the data and apply them to another, so a flexible learner cannot fit its own noise into the effect estimate.\",\"plain_language\":\"Fit the nuisance models on one part of the data and apply them to another, so a flexible learner cannot fit its own noise into the effect estimate.\",\"references\":[\"Chernozhukov et al. (2018), Double/debiased machine learning\"],\"see_also\":[{\"explain_key\":\"method.ml.dml_irm\",\"id\":\"ml.dml_irm\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"A separate outcome model for each arm plus a treatment model, combined in a doubly robust score: right if either side is right.\",\"title\":\"Double ML (interactive)\"},{\"explain_key\":\"diagnostic.nuisance_rmse\",\"id\":\"nuisance_rmse\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Nuisance models by fold\"},{\"explain_key\":\"concept.honest_splitting\",\"id\":\"concept.honest_splitting\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"Use one half of the data to decide where the subgroups are and the other half to estimate their effects.\",\"title\":\"Honest splitting\"}],\"tags\":[],\"title\":\"Cross-fitting\",\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"concept:concept.cross_fitting\",\"kind\":\"concept\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"concept.cross_fitting\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Fit the nuisance models on one part of the data and apply them to another, so a flexible learner cannot fit its own noise into the effect estimate.\",\"title\":\"Cross-fitting\"}" .
<urn:capy:concept%3Aconcept.cross_world> a capy:concept ; skos:prefLabel "Cross-world assumptions" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"concept:concept.cross_world\",\"citation_ids\":[],\"citations\":[],\"content\":{\"common_mistake\":null,\"explain_key\":\"concept.cross_world\",\"gaps\":[],\"id\":\"concept.cross_world\",\"in_more_depth\":\"Natural direct and indirect effects need you to compare what would happen if a person were treated but their mediator took the value it would have taken untreated. No experiment can create that world for anyone, so no experiment can check the assumption. This is why interventional (stochastic) direct and indirect effects are preferred in policy and health settings: they replace the impossible comparison with one where the mediator is drawn from a distribution, which a trial could in principle implement.\",\"kind\":\"concept\",\"one_liner\":\"A condition relating outcomes under treatment and mediator values that no single person could ever experience together. Not testable, even in principle.\",\"plain_language\":\"A condition relating outcomes under treatment and mediator values that no single person could ever experience together. Not testable, even in principle.\",\"references\":[\"Robins & Richardson (2010)\",\"VanderWeele, Vansteelandt & Robins (2014)\"],\"see_also\":[{\"explain_key\":\"assumption.sequential_ignorability\",\"explains\":\"No unmeasured confounding of the treatment-outcome relationship, and none of the mediator-outcome relationship either, even after conditioning on treatment.\",\"id\":\"sequential_ignorability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Sequential ignorability\",\"worry_when\":\"There is a variable affected by treatment that also confounds the mediator-outcome relationship. Under that structure the natural effects are not identified at all.\"},{\"explain_key\":\"method.med.interventional\",\"id\":\"med.interventional\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Shift the mediator to the distribution it would have in the population, rather than to each person's own unobservable counterfactual.\",\"title\":\"Interventional direct and indirect effects\"}],\"tags\":[],\"title\":\"Cross-world assumptions\",\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"concept:concept.cross_world\",\"kind\":\"concept\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"concept.cross_world\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"A condition relating outcomes under treatment and mediator values that no single person could ever experience together. Not testable, even in principle.\",\"title\":\"Cross-world assumptions\"}" .
<urn:capy:concept%3Aconcept.donor_pool> a capy:concept ; skos:prefLabel "The donor pool" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"concept:concept.donor_pool\",\"citation_ids\":[],\"citations\":[],\"content\":{\"common_mistake\":\"Treating the pool as given because it arrived with the dataset. Write down why each unit is in it and why the excluded ones are out; that list is part of the design and belongs in the write-up.\",\"explain_key\":\"concept.donor_pool\",\"gaps\":[\"no citation\"],\"id\":\"concept.donor_pool\",\"in_more_depth\":\"A synthetic control builds its stand-in by blending other units, and it can only blend the ones you put in front of it. Include somewhere that got its own version of the policy and the comparison is contaminated by it. Include somewhere with nothing in common with the treated place and it will simply receive a weight of zero -- harmless, but it makes the pool look larger than it really is. Leave out the one place that would have matched well and the fit suffers for a reason nothing in the output will name. The pool also fixes how strong the placebo evidence can be. The treated unit's gap is judged against the gaps you get by pretending each donor was treated instead, so five donors give five comparisons, and \\\"more extreme than all of them\\\" is a one-in-six statement. No amount of computing makes it a stronger one.\",\"kind\":\"concept\",\"one_liner\":\"The set of untreated places a synthetic comparison is allowed to be built from. Choosing it is a research decision, not a technical one.\",\"plain_language\":\"The set of untreated places a synthetic comparison is allowed to be built from. Choosing it is a research decision, not a technical one.\",\"references\":[],\"see_also\":[{\"explain_key\":\"method.sc.abadie\",\"id\":\"sc.abadie\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Build a weighted copy of the treated place out of untreated places that looked like it beforehand, then watch the two lines separate.\",\"title\":\"Synthetic control\"},{\"explain_key\":\"diagnostic.sc_weights\",\"id\":\"sc_weights\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Donor weights\"},{\"explain_key\":\"diagnostic.sc_convex_hull\",\"id\":\"sc_convex_hull\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Treated unit inside the donor hull\"},{\"explain_key\":\"assumption.donor_fit\",\"explains\":\"The weighted combination of untreated units reproduces the treated unit's pre-period path closely enough to stand in for it afterwards.\",\"id\":\"donor_fit\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Pre-treatment fit from the donor pool\",\"worry_when\":\"Visible pre-period gaps; a short pre-period relative to the number of donors; one donor carrying most of the weight.\"}],\"tags\":[],\"title\":\"The donor pool\",\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[\"no citation\"],\"id\":\"concept:concept.donor_pool\",\"kind\":\"concept\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"concept.donor_pool\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"The set of untreated places a synthetic comparison is allowed to be built from. Choosing it is a research decision, not a technical one.\",\"title\":\"The donor pool\"}" .
<urn:capy:concept%3Aconcept.effective_sample_size> a capy:concept ; skos:prefLabel "Effective sample size" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"concept:concept.effective_sample_size\",\"citation_ids\":[],\"citations\":[],\"content\":{\"common_mistake\":null,\"explain_key\":\"concept.effective_sample_size\",\"gaps\":[\"no citation\"],\"id\":\"concept.effective_sample_size\",\"in_more_depth\":\"Weighting a comparison group to resemble the treated group concentrates the analysis on the few comparison units that actually resemble them. Kish's effective sample size expresses that concentration as a count: a thousand rows with wildly unequal weights can be worth eighty observations. It is the honest denominator. When it collapses, the confidence interval is narrower than the evidence, and the estimate rests on a handful of units whose individual peculiarities now matter.\",\"kind\":\"concept\",\"one_liner\":\"How many observations your weighted comparison is really worth. Almost always smaller than the number of rows, sometimes dramatically.\",\"plain_language\":\"How many observations your weighted comparison is really worth. Almost always smaller than the number of rows, sometimes dramatically.\",\"references\":[],\"see_also\":[{\"explain_key\":\"diagnostic.ess\",\"id\":\"ess\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Effective sample size\"},{\"explain_key\":\"assumption.positivity\",\"explains\":\"Every kind of unit had some chance of being treated and some chance of not being treated. Where that fails, there is no comparison to make and the model is inventing one.\",\"id\":\"positivity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Positivity / overlap\",\"worry_when\":\"Any single weight carries a large share of the total; the effective sample is far below the nominal one; the propensity model separates the arms almost perfectly; treated units sit outside the control group's range.\"},{\"acronym\":\"ATO\",\"explain_key\":\"estimand.ato\",\"id\":\"ATO\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For the people where treated and untreated genuinely overlap, what did it do?\",\"title\":\"Average treatment effect on the overlap population\"}],\"tags\":[],\"title\":\"Effective sample size\",\"worry_when\":\"The effective sample is below about 40% of the nominal one, or a single weight carries more than a fifth of the total.\"},\"disposition\":\"imported\",\"gaps\":[\"no citation\"],\"id\":\"concept:concept.effective_sample_size\",\"kind\":\"concept\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"concept.effective_sample_size\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"How many observations your weighted comparison is really worth. Almost always smaller than the number of rows, sometimes dramatically.\",\"title\":\"Effective sample size\"}" .
<urn:capy:concept%3Aconcept.estimand_first> a capy:concept ; skos:prefLabel "Estimand first, estimator second" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"concept:concept.estimand_first\",\"citation_ids\":[],\"citations\":[],\"content\":{\"common_mistake\":null,\"explain_key\":\"concept.estimand_first\",\"gaps\":[\"no citation\"],\"id\":\"concept.estimand_first\",\"in_more_depth\":\"\\\"The effect of the programme\\\" is not yet a quantity. For whom -- everyone, the people who took it up, the people at the eligibility cutoff, the people an encouragement moved? Against what -- no programme, the old programme, the programme at a different dose? Different designs identify different estimands, and this is why the app shows unavailable estimands greyed rather than hiding them: it is telling you what your design cannot answer, which is usually more useful than what it can.\",\"kind\":\"concept\",\"one_liner\":\"Decide what number you want before deciding how to compute it. The estimator does not define the question; the question restricts the estimators.\",\"plain_language\":\"Decide what number you want before deciding how to compute it. The estimator does not define the question; the question restricts the estimators.\",\"references\":[],\"see_also\":[{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"},{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"},{\"acronym\":\"LATE\",\"explain_key\":\"estimand.late\",\"id\":\"LATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who only got it because of the instrument or the cutoff, what did it do?\",\"title\":\"Local average treatment effect\"},{\"explain_key\":\"design.catalogue\",\"id\":\"catalogue\",\"in_catalogue\":false,\"kind\":\"design\",\"one_liner\":\"Skip the cards; open the method catalogue with a search box.\",\"title\":\"I already know the method\"}],\"tags\":[],\"title\":\"Estimand first, estimator second\",\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[\"no citation\"],\"id\":\"concept:concept.estimand_first\",\"kind\":\"concept\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"concept.estimand_first\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Decide what number you want before deciding how to compute it. The estimator does not define the question; the question restricts the estimators.\",\"title\":\"Estimand first, estimator second\"}" .
<urn:capy:concept%3Aconcept.forest_plot> a capy:concept ; skos:prefLabel "The forest plot, and why there is no headline number" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"concept:concept.forest_plot\",\"citation_ids\":[],\"citations\":[],\"content\":{\"common_mistake\":null,\"explain_key\":\"concept.forest_plot\",\"gaps\":[\"no citation\"],\"id\":\"concept.forest_plot\",\"in_more_depth\":\"Picking the estimate you liked best after seeing them all is how honest people produce dishonest research. This product therefore shows a headline number only when exactly one method ran; otherwise the range across defensible methods is the finding, and the generated prose describes the range. You can nominate a preferred estimate for a report. It is stored as a choice and displayed as a choice, not as a conclusion.\",\"kind\":\"concept\",\"one_liner\":\"One row per method, each with its interval. When several methods ran, the forest is the result -- not a single number chosen from it.\",\"plain_language\":\"One row per method, each with its interval. When several methods ran, the forest is the result -- not a single number chosen from it.\",\"references\":[],\"see_also\":[{\"explain_key\":\"concept.spec_curve\",\"id\":\"concept.spec_curve\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"Every defensible version of the analysis, sorted by estimate, so you can see the whole distribution instead of one draw from it.\",\"title\":\"Specification curve\"},{\"explain_key\":\"concept.provisional\",\"id\":\"concept.provisional\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"A result the product does not think you should trust as it stands. It still computed it; it just will not let the flag disappear.\",\"title\":\"Provisional results\"}],\"tags\":[],\"title\":\"The forest plot, and why there is no headline number\",\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[\"no citation\"],\"id\":\"concept:concept.forest_plot\",\"kind\":\"concept\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"concept.forest_plot\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"One row per method, each with its interval. When several methods ran, the forest is the result -- not a single number chosen from it.\",\"title\":\"The forest plot, and why there is no headline number\"}" .
<urn:capy:concept%3Aconcept.heterogeneity_prespecification> a capy:concept ; skos:prefLabel "Baseline hypotheses, support and multiplicity" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"concept:concept.heterogeneity_prespecification\",\"citation_ids\":[],\"citations\":[],\"content\":{\"common_mistake\":null,\"explain_key\":\"concept.heterogeneity_prespecification\",\"gaps\":[],\"id\":\"concept.heterogeneity_prespecification\",\"in_more_depth\":\"Treatment can affect post-treatment subgroup definitions and introduce selection bias. A prespecification checkbox records the user's declaration; it does not validate timing or the protocol. Inspect arm support in every subgroup and the chosen continuous evaluation values. An interaction test compares effects directly, whereas comparing separate p-values does not. Holm adjustment for one displayed family does not cover repeated outcome, model or horizon searches, and non-significance is not evidence of equivalence.\",\"kind\":\"concept\",\"one_liner\":\"Fix the modifier, coding, outcome and tested scale before inspecting effects, and report the complete testing family.\",\"plain_language\":\"Fix the modifier, coding, outcome and tested scale before inspecting effects, and report the complete testing family.\",\"references\":[\"Sun et al. (2010), Is a subgroup effect believable? Updating criteria to evaluate the credibility of subgroup analyses\",\"Altman and Bland (2003), Interaction revisited: the difference between two estimates\"],\"see_also\":[],\"tags\":[],\"title\":\"Baseline hypotheses, support and multiplicity\",\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"concept:concept.heterogeneity_prespecification\",\"kind\":\"concept\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"concept.heterogeneity_prespecification\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Fix the modifier, coding, outcome and tested scale before inspecting effects, and report the complete testing family.\",\"title\":\"Baseline hypotheses, support and multiplicity\"}" .
<urn:capy:concept%3Aconcept.heterogeneity_scale> a capy:concept ; skos:prefLabel "Heterogeneity depends on the effect scale" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"concept:concept.heterogeneity_scale\",\"citation_ids\":[],\"citations\":[],\"content\":{\"common_mistake\":null,\"explain_key\":\"concept.heterogeneity_scale\",\"gaps\":[],\"id\":\"concept.heterogeneity_scale\",\"in_more_depth\":\"Specify outcome family, coding, population and contrast before fitting. Conditional odds, rate or AFT time-factor interaction terms have different nulls from equality of standardized additive contrasts. For survival, keep the horizon and units fixed across subgroups. For continuous modifiers, distinguish setting a common profile to two values from averaging over people observed at those values.\",\"kind\":\"concept\",\"one_liner\":\"Absolute and relative treatment contrasts can vary differently across the same baseline groups.\",\"plain_language\":\"Absolute and relative treatment contrasts can vary differently across the same baseline groups.\",\"references\":[\"Knol and VanderWeele (2012), Recommendations for presenting analyses of effect modification and interaction\",\"Kent et al. (2020), The Predictive Approaches to Treatment effect Heterogeneity (PATH) Statement\"],\"see_also\":[],\"tags\":[],\"title\":\"Heterogeneity depends on the effect scale\",\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"concept:concept.heterogeneity_scale\",\"kind\":\"concept\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"concept.heterogeneity_scale\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Absolute and relative treatment contrasts can vary differently across the same baseline groups.\",\"title\":\"Heterogeneity depends on the effect scale\"}" .
<urn:capy:concept%3Aconcept.honest_splitting> a capy:concept ; skos:prefLabel "Honest splitting" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"concept:concept.honest_splitting\",\"citation_ids\":[],\"citations\":[],\"content\":{\"common_mistake\":null,\"explain_key\":\"concept.honest_splitting\",\"gaps\":[],\"id\":\"concept.honest_splitting\",\"in_more_depth\":\"If the same rows choose the split and estimate the effect inside it, the estimate is biased upwards by construction: the split was chosen because the effect looked large there. Honest trees and honest forests avoid it by separating the two jobs inside every tree. The price is variance -- half the rows for each job -- which is why honest methods need more data than they first appear to. The reward is a heterogeneity estimate you can believe.\",\"kind\":\"concept\",\"one_liner\":\"Use one half of the data to decide where the subgroups are and the other half to estimate their effects.\",\"plain_language\":\"Use one half of the data to decide where the subgroups are and the other half to estimate their effects.\",\"references\":[\"Athey & Imbens (2016), Recursive partitioning for heterogeneous causal effects\"],\"see_also\":[{\"explain_key\":\"method.ml.causal_forest\",\"id\":\"ml.causal_forest\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Grow trees that look for units whose effect differs, keeping the rows that chose each split away from the rows that estimate it.\",\"title\":\"Honest causal forest\"},{\"acronym\":\"CATE\",\"explain_key\":\"estimand.cate\",\"id\":\"CATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"How does the effect vary from person to person, or place to place?\",\"title\":\"Conditional average treatment effect\"},{\"explain_key\":\"concept.multiplicity\",\"id\":\"concept.multiplicity\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"Look at enough subgroups and one will look impressive. Pre-specify them, or report that you did not.\",\"title\":\"Subgroups and multiplicity\"}],\"tags\":[],\"title\":\"Honest splitting\",\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"concept:concept.honest_splitting\",\"kind\":\"concept\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"concept.honest_splitting\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Use one half of the data to decide where the subgroups are and the other half to estimate their effects.\",\"title\":\"Honest splitting\"}" .
<urn:capy:concept%3Aconcept.multiplicity> a capy:concept ; skos:prefLabel "Subgroups and multiplicity" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"concept:concept.multiplicity\",\"citation_ids\":[],\"citations\":[],\"content\":{\"common_mistake\":null,\"explain_key\":\"concept.multiplicity\",\"gaps\":[\"no citation\"],\"id\":\"concept.multiplicity\",\"in_more_depth\":\"With twenty subgroups and no real heterogeneity, you expect one significant result at the 5% level. The problem is not the arithmetic, it is that the subgroup gets written up as a finding and the other nineteen do not appear. Causal Capybara marks subgroup estimates as a separate group in the results and attaches a multiplicity caution rather than presenting them as a table of independent findings. For discovered rather than pre-specified heterogeneity, the calibration test and the rank-weighted effect are the honest summaries.\",\"kind\":\"concept\",\"one_liner\":\"Look at enough subgroups and one will look impressive. Pre-specify them, or report that you did not.\",\"plain_language\":\"Look at enough subgroups and one will look impressive. Pre-specify them, or report that you did not.\",\"references\":[],\"see_also\":[{\"acronym\":\"GATE\",\"explain_key\":\"estimand.gate\",\"id\":\"GATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"How does the effect vary across pre-specified groups?\",\"title\":\"Group average treatment effect\"},{\"acronym\":\"CATE\",\"explain_key\":\"estimand.cate\",\"id\":\"CATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"How does the effect vary from person to person, or place to place?\",\"title\":\"Conditional average treatment effect\"},{\"explain_key\":\"concept.honest_splitting\",\"id\":\"concept.honest_splitting\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"Use one half of the data to decide where the subgroups are and the other half to estimate their effects.\",\"title\":\"Honest splitting\"}],\"tags\":[],\"title\":\"Subgroups and multiplicity\",\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[\"no citation\"],\"id\":\"concept:concept.multiplicity\",\"kind\":\"concept\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"concept.multiplicity\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Look at enough subgroups and one will look impressive. Pre-specify them, or report that you did not.\",\"title\":\"Subgroups and multiplicity\"}" .
<urn:capy:concept%3Aconcept.negative_control> a capy:concept ; skos:prefLabel "Negative controls" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"concept:concept.negative_control\",\"citation_ids\":[],\"citations\":[],\"content\":{\"common_mistake\":null,\"explain_key\":\"concept.negative_control\",\"gaps\":[],\"id\":\"concept.negative_control\",\"in_more_depth\":\"If a vaccine appears to prevent injuries as well as influenza, the apparent influenza effect is at least partly healthy-user bias. That is more useful than any test of balance, because it puts a number on the confounding rather than asserting its absence. Negative-control exposures work the same way in reverse: something that could not cause the outcome but shares its confounders.\",\"kind\":\"concept\",\"one_liner\":\"A variable that shares your suspected confounding but cannot be affected by the treatment. An effect there is a measurement of your bias.\",\"plain_language\":\"A variable that shares your suspected confounding but cannot be affected by the treatment. An effect there is a measurement of your bias.\",\"references\":[\"Lipsitch, Tchetgen Tchetgen & Cohen (2010), Negative controls\"],\"see_also\":[{\"explain_key\":\"probe.negative_control\",\"id\":\"probe.negative_control\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"Estimate something that shares the confounding but not the causal path. A non-zero answer is bias you can see.\",\"title\":\"Negative control\"},{\"explain_key\":\"assumption.exchangeability\",\"explains\":\"Treated and untreated units are comparable once you condition on the confounders you measured. Everything that pushed people towards treatment and also moves the outcome is in your adjustment set.\",\"id\":\"exchangeability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Exchangeability / no unmeasured confounding\",\"worry_when\":\"Treatment was chosen by people who knew something about the likely outcome that you do not observe. Clinical judgement, self-selection into a programme, and administrative triage are the classic cases.\"}],\"tags\":[],\"title\":\"Negative controls\",\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"concept:concept.negative_control\",\"kind\":\"concept\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"concept.negative_control\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"A variable that shares your suspected confounding but cannot be affected by the treatment. An effect there is a measurement of your bias.\",\"title\":\"Negative controls\"}" .
<urn:capy:concept%3Aconcept.not_yet_treated> a capy:concept ; skos:prefLabel "Not-yet-treated comparisons" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"concept:concept.not_yet_treated\",\"citation_ids\":[],\"citations\":[],\"content\":{\"common_mistake\":null,\"explain_key\":\"concept.not_yet_treated\",\"gaps\":[\"no citation\"],\"id\":\"concept.not_yet_treated\",\"in_more_depth\":\"The obvious comparison group in a staggered design is the units that never adopt. Sometimes there are very few of them, and they are often unusual for the very reason they never adopted. The alternative is to borrow from the future: in 2006 a state that adopts in 2011 is untreated, and it probably resembles a 2007 adopter more closely than a permanent hold-out does. Two costs come with it. The pool thins as the panel runs on and more units switch on, so the later periods rest on fewer comparisons than the early ones. And it assumes those waiting units are not already reacting to a policy they can see coming, which is the no-anticipation assumption doing real work rather than sitting decoratively in the ledger.\",\"kind\":\"concept\",\"one_liner\":\"Units that do adopt the policy, but later. While they are still waiting they can serve as the comparison group for units that adopted earlier.\",\"plain_language\":\"Units that do adopt the policy, but later. While they are still waiting they can serve as the comparison group for units that adopted earlier.\",\"references\":[],\"see_also\":[{\"explain_key\":\"concept.staggered_adoption\",\"id\":\"concept.staggered_adoption\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"Units switch the policy on at different dates rather than all at once. It is the ordinary case in policy data, and it breaks the simplest before-and-after arithmetic.\",\"title\":\"Staggered adoption\"},{\"explain_key\":\"diagnostic.comparison_group\",\"id\":\"comparison_group\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Comparison group used\"},{\"explain_key\":\"diagnostic.group_time_att\",\"id\":\"group_time_att\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Group-time effects\"},{\"explain_key\":\"assumption.no_anticipation\",\"explains\":\"Units did not change behaviour before treatment arrived because they knew it was coming.\",\"id\":\"no_anticipation\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No anticipation\",\"worry_when\":\"There was a public announcement well before the policy started, or the pre-period coefficients move in the period immediately before adoption.\"}],\"tags\":[],\"title\":\"Not-yet-treated comparisons\",\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[\"no citation\"],\"id\":\"concept:concept.not_yet_treated\",\"kind\":\"concept\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"concept.not_yet_treated\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Units that do adopt the policy, but later. While they are still waiting they can serve as the comparison group for units that adopted earlier.\",\"title\":\"Not-yet-treated comparisons\"}" .
<urn:capy:concept%3Aconcept.placebo> a capy:concept ; skos:prefLabel "Placebo tests" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"concept:concept.placebo\",\"citation_ids\":[],\"citations\":[],\"content\":{\"common_mistake\":null,\"explain_key\":\"concept.placebo\",\"gaps\":[\"no citation\"],\"id\":\"concept.placebo\",\"in_more_depth\":\"A placebo outcome is one the treatment should not touch. A placebo treatment is a fake date or a permuted assignment. A placebo unit is a donor treated as though it had been intervened on. Each asks the same question: does this design manufacture findings? A clean placebo is reassuring and not decisive -- it rules out one route to a false positive, not all of them. A dirty placebo is much more informative, because it demonstrates a problem rather than failing to find one.\",\"kind\":\"concept\",\"one_liner\":\"Run the same analysis somewhere the effect cannot exist. If you find one, the design is producing effects that are not there.\",\"plain_language\":\"Run the same analysis somewhere the effect cannot exist. If you find one, the design is producing effects that are not there.\",\"references\":[],\"see_also\":[{\"explain_key\":\"probe.placebo_outcome\",\"id\":\"probe.placebo_outcome\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"Run the same analysis on something the treatment could not have changed. It should find nothing.\",\"title\":\"Placebo outcome\"},{\"explain_key\":\"probe.placebo_treatment\",\"id\":\"probe.placebo_treatment\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"Move the policy date earlier, reshuffle who was treated, or swap in a variable that cannot cause the outcome.\",\"title\":\"Placebo treatment\"},{\"explain_key\":\"diagnostic.sc_placebo\",\"id\":\"diagnostic.sc_placebo\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"Re-run the whole method pretending each donor was the treated unit. If many donors show a gap as large, the real one is unremarkable.\",\"title\":\"Synthetic control placebos\"}],\"tags\":[],\"title\":\"Placebo tests\",\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[\"no citation\"],\"id\":\"concept:concept.placebo\",\"kind\":\"concept\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"concept.placebo\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Run the same analysis somewhere the effect cannot exist. If you find one, the design is producing effects that are not there.\",\"title\":\"Placebo tests\"}" .
<urn:capy:concept%3Aconcept.provisional> a capy:concept ; skos:prefLabel "Provisional results" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"concept:concept.provisional\",\"citation_ids\":[],\"citations\":[],\"content\":{\"common_mistake\":null,\"explain_key\":\"concept.provisional\",\"gaps\":[\"no citation\"],\"id\":\"concept.provisional\",\"in_more_depth\":\"A run is marked provisional when something specific happened: the core diagnostic for the design was never opened, the weights are degenerate, the instrument is weak, a staggered panel was estimated with two-way fixed effects, matching dropped part of the treated group, or a synthetic control could not reproduce the pre-period. The flag travels. It appears on the forest plot as a different marker, in the estimates table, in the navigator, in the status bar's count, and in the generated report. You can always proceed; you cannot quietly proceed.\",\"kind\":\"concept\",\"one_liner\":\"A result the product does not think you should trust as it stands. It still computed it; it just will not let the flag disappear.\",\"plain_language\":\"A result the product does not think you should trust as it stands. It still computed it; it just will not let the flag disappear.\",\"references\":[],\"see_also\":[{\"explain_key\":\"concept.forest_plot\",\"id\":\"concept.forest_plot\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"One row per method, each with its interval. When several methods ran, the forest is the result -- not a single number chosen from it.\",\"title\":\"The forest plot, and why there is no headline number\"},{\"explain_key\":\"assumption.positivity\",\"explains\":\"Every kind of unit had some chance of being treated and some chance of not being treated. Where that fails, there is no comparison to make and the model is inventing one.\",\"id\":\"positivity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Positivity / overlap\",\"worry_when\":\"Any single weight carries a large share of the total; the effective sample is far below the nominal one; the propensity model separates the arms almost perfectly; treated units sit outside the control group's range.\"}],\"tags\":[],\"title\":\"Provisional results\",\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[\"no citation\"],\"id\":\"concept:concept.provisional\",\"kind\":\"concept\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"concept.provisional\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"A result the product does not think you should trust as it stands. It still computed it; it just will not let the flag disappear.\",\"title\":\"Provisional results\"}" .
<urn:capy:concept%3Aconcept.selection_bias> a capy:concept ; skos:prefLabel "Selection bias" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"concept:concept.selection_bias\",\"citation_ids\":[],\"citations\":[],\"content\":{\"common_mistake\":null,\"explain_key\":\"concept.selection_bias\",\"gaps\":[\"no citation\"],\"id\":\"concept.selection_bias\",\"in_more_depth\":\"Dropout that differs by treatment arm, complete-case analysis when missingness depends on the outcome, and administrative samples that only record people who reached a certain stage all condition on a consequence of the very things you are studying. This is why every dropped row appears in the sample flow with a reason. The flow is not bookkeeping: it is the record of which selections you made, so that you and a reader can judge whether any of them was a collider.\",\"kind\":\"concept\",\"one_liner\":\"Who ends up in your analysis sample can create an association all by itself, quite apart from confounding.\",\"plain_language\":\"Who ends up in your analysis sample can create an association all by itself, quite apart from confounding.\",\"references\":[],\"see_also\":[{\"explain_key\":\"concept.collider\",\"id\":\"concept.collider\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"A variable that two arrows point into. Conditioning on it creates an association between its causes that was not there before.\",\"title\":\"Colliders and why adjusting can hurt\"},{\"explain_key\":\"concept.consort\",\"id\":\"concept.consort\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"A step-by-step record of how the imported rows became the analysis sample, with a reason for every row that left.\",\"title\":\"The sample flow\"}],\"tags\":[],\"title\":\"Selection bias\",\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[\"no citation\"],\"id\":\"concept:concept.selection_bias\",\"kind\":\"concept\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"concept.selection_bias\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Who ends up in your analysis sample can create an association all by itself, quite apart from confounding.\",\"title\":\"Selection bias\"}" .
<urn:capy:concept%3Aconcept.spec_curve> a capy:concept ; skos:prefLabel "Specification curve" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"concept:concept.spec_curve\",\"citation_ids\":[],\"citations\":[],\"content\":{\"common_mistake\":null,\"explain_key\":\"concept.spec_curve\",\"gaps\":[],\"id\":\"concept.spec_curve\",\"in_more_depth\":\"A robustness check that reports three alternative specifications is a sample of size three from a space the analyst chose. A specification curve runs the grid -- covariate sets, calipers, bandwidths, trimming thresholds -- and plots all of them with the headline marked. A conclusion that survives most of the curve is stronger than one that survives three hand-picked variants. A curve that swings through zero tells you the finding is a specification, not a result.\",\"kind\":\"concept\",\"one_liner\":\"Every defensible version of the analysis, sorted by estimate, so you can see the whole distribution instead of one draw from it.\",\"plain_language\":\"Every defensible version of the analysis, sorted by estimate, so you can see the whole distribution instead of one draw from it.\",\"references\":[\"Simonsohn, Simmons & Nelson (2020), Specification curve analysis\"],\"see_also\":[{\"explain_key\":\"probe.alternate_spec\",\"id\":\"probe.alternate_spec\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"Run the grid of defensible specifications and sort the answers. The curve is the result, not the one you happened to run.\",\"title\":\"Specification curve\"},{\"explain_key\":\"concept.forest_plot\",\"id\":\"concept.forest_plot\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"One row per method, each with its interval. When several methods ran, the forest is the result -- not a single number chosen from it.\",\"title\":\"The forest plot, and why there is no headline number\"}],\"tags\":[],\"title\":\"Specification curve\",\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"concept:concept.spec_curve\",\"kind\":\"concept\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"concept.spec_curve\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Every defensible version of the analysis, sorted by estimate, so you can see the whole distribution instead of one draw from it.\",\"title\":\"Specification curve\"}" .
<urn:capy:concept%3Aconcept.staggered_adoption> a capy:concept ; skos:prefLabel "Staggered adoption" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"concept:concept.staggered_adoption\",\"citation_ids\":[],\"citations\":[],\"content\":{\"common_mistake\":null,\"explain_key\":\"concept.staggered_adoption\",\"gaps\":[\"no citation\"],\"id\":\"concept.staggered_adoption\",\"in_more_depth\":\"With a single adoption date the comparison is easy to state: adopters against non-adopters, before against after. When states adopt in 2004, 2009 and 2013, one regression coefficient has to combine many overlapping comparisons, and some of them treat a unit that is already under the policy as though it were an untreated control. If the effect grows or fades after adoption, those comparisons subtract one real effect from another and can drag the average towards zero, or past it. Estimators built for staggered adoption avoid this by never using an already-treated unit as a control. They compute one effect for each adoption cohort in each period and then average those blocks with weights you can look at and argue with.\",\"kind\":\"concept\",\"one_liner\":\"Units switch the policy on at different dates rather than all at once. It is the ordinary case in policy data, and it breaks the simplest before-and-after arithmetic.\",\"plain_language\":\"Units switch the policy on at different dates rather than all at once. It is the ordinary case in policy data, and it breaks the simplest before-and-after arithmetic.\",\"references\":[],\"see_also\":[{\"explain_key\":\"concept.twfe\",\"id\":\"concept.twfe\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"A regression that gives every unit its own baseline level and every period its own shift, so only change within a unit over time is compared. It is the workhorse behind difference-in-differences, and it misbehaves when units adopt at different dates.\",\"title\":\"Two-way fixed effects\"},{\"explain_key\":\"concept.not_yet_treated\",\"id\":\"concept.not_yet_treated\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"Units that do adopt the policy, but later. While they are still waiting they can serve as the comparison group for units that adopted earlier.\",\"title\":\"Not-yet-treated comparisons\"},{\"explain_key\":\"diagnostic.bacon_decomposition\",\"id\":\"bacon_decomposition\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Goodman-Bacon decomposition\"},{\"explain_key\":\"diagnostic.group_time_att\",\"id\":\"group_time_att\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Group-time effects\"},{\"explain_key\":\"method.did.callaway_santanna\",\"id\":\"did.callaway_santanna\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Estimate one clean before-and-after for every adoption cohort, then say out loud how you averaged them.\",\"title\":\"Callaway & Sant'Anna group-time effects\"}],\"tags\":[],\"title\":\"Staggered adoption\",\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[\"no citation\"],\"id\":\"concept:concept.staggered_adoption\",\"kind\":\"concept\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"concept.staggered_adoption\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Units switch the policy on at different dates rather than all at once. It is the ordinary case in policy data, and it breaks the simplest before-and-after arithmetic.\",\"title\":\"Staggered adoption\"}" .
<urn:capy:concept%3Aconcept.standardised_difference> a capy:concept ; skos:prefLabel "Standardised mean difference" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"concept:concept.standardised_difference\",\"citation_ids\":[],\"citations\":[],\"content\":{\"common_mistake\":null,\"explain_key\":\"concept.standardised_difference\",\"gaps\":[],\"id\":\"concept.standardised_difference\",\"in_more_depth\":\"It is the number a Love plot shows, before and after adjustment. The convention of worrying above 0.1 is a convention, not a law -- it comes from simulation studies, and what matters is whether a residual imbalance is on a variable that strongly predicts the outcome. Unlike a t-test of balance, it does not shrink as the sample grows, which is why balance is judged with it rather than with p-values.\",\"kind\":\"concept\",\"one_liner\":\"The gap between groups on a covariate, divided by a pooled standard deviation, so covariates on different scales can be compared on one axis.\",\"plain_language\":\"The gap between groups on a covariate, divided by a pooled standard deviation, so covariates on different scales can be compared on one axis.\",\"references\":[\"Austin (2009), Balance diagnostics\"],\"see_also\":[{\"explain_key\":\"diagnostic.love\",\"id\":\"love\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Covariate balance (Love plot)\"},{\"explain_key\":\"assumption.exchangeability\",\"explains\":\"Treated and untreated units are comparable once you condition on the confounders you measured. Everything that pushed people towards treatment and also moves the outcome is in your adjustment set.\",\"id\":\"exchangeability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Exchangeability / no unmeasured confounding\",\"worry_when\":\"Treatment was chosen by people who knew something about the likely outcome that you do not observe. Clinical judgement, self-selection into a programme, and administrative triage are the classic cases.\"}],\"tags\":[],\"title\":\"Standardised mean difference\",\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"concept:concept.standardised_difference\",\"kind\":\"concept\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"concept.standardised_difference\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"The gap between groups on a covariate, divided by a pooled standard deviation, so covariates on different scales can be compared on one axis.\",\"title\":\"Standardised mean difference\"}" .
<urn:capy:concept%3Aconcept.survival_censoring> a capy:concept ; skos:prefLabel "Censoring is an observation mechanism" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"concept:concept.survival_censoring\",\"citation_ids\":[],\"citations\":[],\"content\":{\"common_mistake\":null,\"explain_key\":\"concept.survival_censoring\",\"gaps\":[],\"id\":\"concept.survival_censoring\",\"in_more_depth\":\"Administrative end of follow-up and prognosis-related dropout can have different implications. Raw arm-specific Kaplan–Meier needs independence within arms. The adjusted AFT likelihood assumes independence given treatment and included baseline covariates. Counts and model convergence do not verify either condition. Positivity of observation through the horizon and meaningful conditional treatment support also need substantive review.\",\"kind\":\"concept\",\"one_liner\":\"Right censoring means follow-up ends before the event is observed; the event time remains unknown.\",\"plain_language\":\"Right censoring means follow-up ends before the event is observed; the event time remains unknown.\",\"references\":[\"Hernán and Robins (2020), Causal Inference: What If\"],\"see_also\":[],\"tags\":[],\"title\":\"Censoring is an observation mechanism\",\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"concept:concept.survival_censoring\",\"kind\":\"concept\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"concept.survival_censoring\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Right censoring means follow-up ends before the event is observed; the event time remains unknown.\",\"title\":\"Censoring is an observation mechanism\"}" .
<urn:capy:concept%3Aconcept.survival_competing_events> a capy:concept ; skos:prefLabel "Competing events require a causal question" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"concept:concept.survival_competing_events\",\"citation_ids\":[],\"citations\":[],\"content\":{\"common_mistake\":null,\"explain_key\":\"concept.survival_competing_events\",\"gaps\":[],\"id\":\"concept.survival_competing_events\",\"in_more_depth\":\"The cumulative incidence of an event with competing death, a hypothetical intervention eliminating competing death and separable treatment effects are different targets. None is supplied by recoding competing death to zero in these single-event adapters. Choose and justify an appropriate competing-risk design and estimator separately.\",\"kind\":\"concept\",\"one_liner\":\"An event that prevents the outcome of interest is not automatically ordinary right censoring.\",\"plain_language\":\"An event that prevents the outcome of interest is not automatically ordinary right censoring.\",\"references\":[\"Hernán and Robins (2020), Causal Inference: What If\"],\"see_also\":[],\"tags\":[],\"title\":\"Competing events require a causal question\",\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"concept:concept.survival_competing_events\",\"kind\":\"concept\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"concept.survival_competing_events\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"An event that prevents the outcome of interest is not automatically ordinary right censoring.\",\"title\":\"Competing events require a causal question\"}" .
<urn:capy:concept%3Aconcept.survival_hazard> a capy:concept ; skos:prefLabel "Hazard, survival probability and time ratios" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"concept:concept.survival_hazard\",\"citation_ids\":[],\"citations\":[],\"content\":{\"common_mistake\":null,\"explain_key\":\"concept.survival_hazard\",\"gaps\":[],\"id\":\"concept.survival_hazard\",\"in_more_depth\":\"A hazard ratio conditions on evolving risk sets and does not equal a survival probability or risk ratio. AFT exp(betaA) stretches conditional event times under a common log-time shape; with subgroup interactions, exp(betaA) is the reference subgroup factor and exp(betaA + delta_g) is the factor for subgroup g. A Weibull AFT model also implies a conditional hazard ratio exp(-betaA/sigma) in the reference subgroup, a different quantity; replace betaA by betaA + delta_g for other subgroups. The app reports the requested time factor, probability difference or RMST difference with its scale; it does not substitute one for another.\",\"kind\":\"concept\",\"one_liner\":\"A hazard is an instantaneous event rate among those still event-free. It is not an event probability.\",\"plain_language\":\"A hazard is an instantaneous event rate among those still event-free. It is not an event probability.\",\"references\":[\"Hernán (2010), The Hazards of Hazard Ratios\",\"Wei (1992), The accelerated failure time model: a useful alternative to the Cox regression model in survival analysis\"],\"see_also\":[],\"tags\":[],\"title\":\"Hazard, survival probability and time ratios\",\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"concept:concept.survival_hazard\",\"kind\":\"concept\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"concept.survival_hazard\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"A hazard is an instantaneous event rate among those still event-free. It is not an event probability.\",\"title\":\"Hazard, survival probability and time ratios\"}" .
<urn:capy:concept%3Aconcept.survival_time_zero> a capy:concept ; skos:prefLabel "Align eligibility, treatment and follow-up" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"concept:concept.survival_time_zero\",\"citation_ids\":[],\"citations\":[],\"content\":{\"common_mistake\":null,\"explain_key\":\"concept.survival_time_zero\",\"gaps\":[],\"id\":\"concept.survival_time_zero\",\"in_more_depth\":\"Counting event-free follow-up before a person could be classified as treated creates immortal-time bias. A baseline treatment analysis cannot silently stand in for a treatment that changes during follow-up. Delayed entry also changes the risk sets and is unsupported by these adapters.\",\"kind\":\"concept\",\"one_liner\":\"Time zero is when eligibility is assessed, the baseline treatment strategy is classified and follow-up begins.\",\"plain_language\":\"Time zero is when eligibility is assessed, the baseline treatment strategy is classified and follow-up begins.\",\"references\":[\"Hernán and Robins (2020), Causal Inference: What If\"],\"see_also\":[],\"tags\":[],\"title\":\"Align eligibility, treatment and follow-up\",\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"concept:concept.survival_time_zero\",\"kind\":\"concept\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"concept.survival_time_zero\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Time zero is when eligibility is assessed, the baseline treatment strategy is classified and follow-up begins.\",\"title\":\"Align eligibility, treatment and follow-up\"}" .
<urn:capy:concept%3Aconcept.target_trial> a capy:concept ; skos:prefLabel "The target trial" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"concept:concept.target_trial\",\"citation_ids\":[],\"citations\":[],\"content\":{\"common_mistake\":null,\"explain_key\":\"concept.target_trial\",\"gaps\":[],\"id\":\"concept.target_trial\",\"in_more_depth\":\"Eligibility, time zero, the treatment strategies being compared, the follow-up, the outcome, and the causal contrast. Making each explicit catches most of the errors that produce implausible observational results: immortal time bias, prevalent-user bias, and outcomes that precede the exposure. It is also the fastest way to notice that a question has no well-defined intervention behind it, in which case the estimand needs rewriting before any estimator is chosen.\",\"kind\":\"concept\",\"one_liner\":\"Write down the randomised experiment you would run if you could, then ask what your data lets you emulate.\",\"plain_language\":\"Write down the randomised experiment you would run if you could, then ask what your data lets you emulate.\",\"references\":[\"Hernán & Robins (2016), Using big data to emulate a target trial\"],\"see_also\":[{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"},{\"explain_key\":\"design.longitudinal\",\"id\":\"longitudinal\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"The same person is treated, untreated, treated again; confounders also move.\",\"title\":\"Treatment that changes over time\"}],\"tags\":[],\"title\":\"The target trial\",\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"concept:concept.target_trial\",\"kind\":\"concept\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"concept.target_trial\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Write down the randomised experiment you would run if you could, then ask what your data lets you emulate.\",\"title\":\"The target trial\"}" .
<urn:capy:concept%3Aconcept.time_varying_confounding> a capy:concept ; skos:prefLabel "Time-varying confounding" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"concept:concept.time_varying_confounding\",\"citation_ids\":[],\"citations\":[],\"content\":{\"common_mistake\":null,\"explain_key\":\"concept.time_varying_confounding\",\"gaps\":[],\"id\":\"concept.time_varying_confounding\",\"in_more_depth\":\"In a study of a blood-pressure drug, blood pressure is affected by earlier doses and drives later ones. Adjust for it and you block part of the drug's effect and open a collider path. Leave it out and confounding remains. Inverse-probability weighting for a marginal structural model, the parametric g-formula, and longitudinal targeted learning all solve the same problem in different ways: they model the treatment process over time rather than conditioning on its consequences.\",\"kind\":\"concept\",\"one_liner\":\"A variable that is both a consequence of past treatment and a cause of future treatment. Ordinary regression cannot handle it; g-methods can.\",\"plain_language\":\"A variable that is both a consequence of past treatment and a cause of future treatment. Ordinary regression cannot handle it; g-methods can.\",\"references\":[\"Robins, Hernán & Brumback (2000)\",\"Daniel et al. (2013), Methods for dealing with time-dependent confounding\"],\"see_also\":[{\"explain_key\":\"assumption.no_time_varying_confounding\",\"explains\":\"At every period, the things that drive the treatment decision and also affect the outcome are measured -- and measured before that decision.\",\"id\":\"no_time_varying_confounding\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No unmeasured time-varying confounding\",\"worry_when\":\"Clinical measurements taken after the dose was changed; employment status recorded at the end of a period used to explain treatment at its start.\"},{\"explain_key\":\"method.long.msm_iptw\",\"id\":\"long.msm_iptw\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Reweight each person-period so the treated and untreated histories look alike, then fit one simple model to the reweighted data.\",\"title\":\"Marginal structural model (time-varying weights)\"},{\"explain_key\":\"method.long.gformula\",\"id\":\"long.gformula\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Model each period in turn, then simulate the world where everyone followed the strategy you name.\",\"title\":\"Parametric g-formula\"}],\"tags\":[],\"title\":\"Time-varying confounding\",\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"concept:concept.time_varying_confounding\",\"kind\":\"concept\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"concept.time_varying_confounding\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"A variable that is both a consequence of past treatment and a cause of future treatment. Ordinary regression cannot handle it; g-methods can.\",\"title\":\"Time-varying confounding\"}" .
<urn:capy:concept%3Aconcept.twfe> a capy:concept ; skos:prefLabel "Two-way fixed effects" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"concept:concept.twfe\",\"citation_ids\":[],\"citations\":[],\"content\":{\"common_mistake\":\"Reading the coefficient as \\\"the\\\" effect. Under staggered adoption it is an average with weights nobody chose, and it is not guaranteed to lie between the smallest and the largest of the true effects it averages.\",\"explain_key\":\"concept.twfe\",\"gaps\":[\"no citation\"],\"id\":\"concept.twfe\",\"in_more_depth\":\"\\\"Fixed effect\\\" here just means a separate intercept. One per unit absorbs everything about a state that never changes -- its size, its politics, its weather. One per period absorbs anything that hit everybody at once, like a recession. What is left to explain the outcome is the timing of the policy. With two groups and two periods this reproduces the difference-in-differences answer exactly. With many adoption dates it no longer does. The single coefficient becomes a weighted average of every two-group, two-period comparison the data allows, including ones that use an early adopter as the control for a later one. Those weights are decided by the arithmetic rather than by you, and some of them can be negative. The decomposition diagnostic shows what your particular number is made of.\",\"kind\":\"concept\",\"one_liner\":\"A regression that gives every unit its own baseline level and every period its own shift, so only change within a unit over time is compared. It is the workhorse behind difference-in-differences, and it misbehaves when units adopt at different dates.\",\"plain_language\":\"A regression that gives every unit its own baseline level and every period its own shift, so only change within a unit over time is compared. It is the workhorse behind difference-in-differences, and it misbehaves when units adopt at different dates.\",\"references\":[],\"see_also\":[{\"explain_key\":\"concept.staggered_adoption\",\"id\":\"concept.staggered_adoption\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"Units switch the policy on at different dates rather than all at once. It is the ordinary case in policy data, and it breaks the simplest before-and-after arithmetic.\",\"title\":\"Staggered adoption\"},{\"explain_key\":\"method.did.twfe\",\"id\":\"did.twfe\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"One regression with unit and period fixed effects. Familiar, fast, and not an average treatment effect when units adopt at different dates.\",\"title\":\"Two-way fixed effects\"},{\"explain_key\":\"diagnostic.bacon_decomposition\",\"id\":\"bacon_decomposition\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Goodman-Bacon decomposition\"}],\"tags\":[],\"title\":\"Two-way fixed effects\",\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[\"no citation\"],\"id\":\"concept:concept.twfe\",\"kind\":\"concept\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"concept.twfe\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"A regression that gives every unit its own baseline level and every period its own shift, so only change within a unit over time is compared. It is the workhorse behind difference-in-differences, and it misbehaves when units adopt at different dates.\",\"title\":\"Two-way fixed effects\"}" .
