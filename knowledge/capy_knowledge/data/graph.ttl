l Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"One before-and-after with covariates, using an outcome model and a comparison-group model together so either one can carry it.\",\"title\":\"Doubly robust DiD\"}" .
<urn:capy:did.event_study> a capy:method ; skos:prefLabel "Event study (leads and lags)" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:did.event_study\"],\"catalogue_key\":\"method:did.event_study\",\"citation_ids\":[\"source:unresolved:49d048eae93725829880\",\"source:unresolved:6213601a0aefb169aa58\",\"sun2021\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":null,\"engines\":{\"python\":true,\"r\":\"fixest::feols with i(rel, ref = -1)\"},\"needs_r_packages\":[\"fixest::feols with i(rel, ref = -1)\"],\"runs_here\":true,\"summary\":\"Runs on this computer with what the app already installs.\"},\"designs\":[{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.raw_means\",\"id\":\"raw_means\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Raw means by cohort and period\"},{\"explain_key\":\"diagnostic.adoption\",\"id\":\"adoption\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Adoption pattern\"},{\"explain_key\":\"diagnostic.panel_balance\",\"id\":\"panel_balance\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Panel balance\"},{\"explain_key\":\"diagnostic.event_study\",\"id\":\"event_study\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Event study\"},{\"explain_key\":\"diagnostic.pre_trends\",\"id\":\"pre_trends\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Pre-trend test\"}],\"estimands\":[{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"},{\"acronym\":\"ATT(g,t)\",\"explain_key\":\"estimand.cohort_att\",\"id\":\"cohort_ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For each group that adopted it, what did their own rollout do?\",\"title\":\"Group-time average treatment effect\"}],\"explain_key\":\"method.did.event_study\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\",\"some of the robustness probes it names have no card of their own yet\"],\"id\":\"did.event_study\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":false,\"one_liner\":\"Plot the effect period by period around adoption, so you can see whether the gap opened when the policy arrived or long before it.\",\"options\":[{\"default\":-1,\"help\":\"Every coefficient is measured against this period, relative to adoption. -1 is the period just before treatment; choose -2 if you suspect the policy was anticipated.\",\"label\":\"Reference period\",\"max\":0,\"min\":-20,\"name\":\"ref_period\",\"profile\":\"standard\",\"type\":\"int\"},{\"default\":5,\"help\":\"Anything earlier is pooled into the first point, so no data is dropped.\",\"label\":\"Periods before adoption to show\",\"max\":30,\"min\":1,\"name\":\"max_lead\",\"profile\":\"standard\",\"type\":\"int\"},{\"default\":5,\"help\":\"Anything later is pooled into the last point, so no data is dropped.\",\"label\":\"Periods after adoption to show\",\"max\":30,\"min\":0,\"name\":\"max_lag\",\"profile\":\"standard\",\"type\":\"int\"},{\"choices\":[\"auto\",\"demean\",\"dummies\"],\"default\":\"auto\",\"help\":\"Auto uses dummy variables on small panels and partials the fixed effects out on large ones. The estimate is the same either way; this only trades memory for speed.\",\"label\":\"How to handle the fixed effects\",\"name\":\"absorb\",\"profile\":\"advanced\",\"type\":\"select\"},{\"default\":0.95,\"help\":\"Width of the interval reported next to the estimate.\",\"label\":\"Confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":true,\"help\":\"Below 30 clusters the ordinary cluster-robust p-value rejects too often. This adds a restricted wild cluster bootstrap p-value in the Sensitivity tab.\",\"label\":\"Wild cluster bootstrap when clusters are few\",\"name\":\"wild_bootstrap\",\"profile\":\"advanced\",\"type\":\"bool\"},{\"default\":399,\"help\":\"Rademacher draws for the wild cluster bootstrap. Seeded by the run seed.\",\"label\":\"Bootstrap draws\",\"max\":9999,\"min\":99,\"name\":\"wild_reps\",\"profile\":\"advanced\",\"type\":\"int\"}],\"plain_language\":\"Plot the effect period by period around adoption, so you can see whether the gap opened when the policy arrived or long before it.\",\"probes\":[{\"explain_key\":null,\"id\":\"placebo_period\",\"in_catalogue\":false,\"kind\":\"probe\",\"one_liner\":null,\"requested_as\":\"placebo_period\",\"title\":\"Placebo period\"},{\"explain_key\":\"probe.honest_did\",\"id\":\"probe.honest_did\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"What survives when parallel trends is allowed to fail by a stated amount.\",\"requested_as\":\"honest_did\",\"title\":\"Honest DiD (Rambachan-Roth)\"},{\"explain_key\":null,\"id\":\"leave_one_cohort_out\",\"in_catalogue\":false,\"kind\":\"probe\",\"one_liner\":null,\"requested_as\":\"leave_one_cohort_out\",\"title\":\"Leave one adoption cohort out\"},{\"explain_key\":\"probe.alternate_spec\",\"id\":\"probe.alternate_spec\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the grid of defensible specifications and sort the answers. The curve is the result, not the one you happened to run.\",\"requested_as\":\"alternate_spec\",\"title\":\"Specification curve\"}],\"references\":[\"Sun and Abraham (2021), Estimating dynamic treatment effects in event studies\",\"Freyaldenhoven, Hansen and Shapiro (2019), Pre-event trends in the panel event-study design\",\"Roth (2022), Pretest with caution\"],\"roles_forbidden\":[\"a running variable\",\"an instrument\"],\"roles_optional\":[\"a clustering variable\",\"at least one measured confounder\"],\"roles_required\":[\"a treatment\",\"an outcome\",\"a unit id\",\"a time variable\"],\"see_also\":[{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"},{\"explain_key\":\"method.did.bjs_imputation\",\"id\":\"did.bjs_imputation\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Learn what untreated life looks like from untreated cells only, then ask how far each treated cell landed from it.\",\"title\":\"Imputation (Borusyak-Jaravel-Spiess)\"},{\"explain_key\":\"method.did.callaway_santanna\",\"id\":\"did.callaway_santanna\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Estimate one clean before-and-after for every adoption cohort, then say out loud how you averaged them.\",\"title\":\"Callaway & Sant'Anna group-time effects\"},{\"explain_key\":\"method.did.chaisemartin\",\"id\":\"did.chaisemartin\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"An estimator built for panels where treatment switches on and off, which the imputation and cohort estimators assume never happens.\",\"title\":\"de Chaisemartin & D'Haultfoeuille\"},{\"explain_key\":\"method.did.dr_did\",\"id\":\"did.dr_did\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"One before-and-after with covariates, using an outcome model and a comparison-group model together so either one can carry it.\",\"title\":\"Doubly robust DiD\"},{\"explain_key\":\"method.did.gardner_2s\",\"id\":\"did.gardner_2s\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Strip out unit and period effects using untreated cells only, then regress what is left on the policy.\",\"title\":\"Two-stage DiD (Gardner / Wooldridge-Mundlak)\"},{\"explain_key\":\"method.did.goodman_bacon\",\"id\":\"did.goodman_bacon\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Open up a two-way fixed effects estimate and show every two-group comparison inside it, with the weight each one carries -- including the ones that use already-treated units as controls.\",\"title\":\"Goodman-Bacon decomposition\"}],\"status\":\"recommended\",\"status_label\":\"Recommended\",\"tags\":[\"Policy rolled out over time\",\"ATT\",\"ATT(g,t)\",\"Recommended\"],\"title\":\"Event study (leads and lags)\",\"what_it_assumes\":[{\"explain_key\":\"assumption.parallel_trends\",\"explains\":\"Without the policy, treated and comparison groups would have moved the same way. Not that they were at the same level -- that their paths would have been parallel.\",\"id\":\"parallel_trends\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Parallel trends\",\"worry_when\":\"Pre-period event-study coefficients drift away from zero; the policy was adopted because outcomes were already moving; the groups differ in composition in ways that interact with time.\"},{\"explain_key\":\"assumption.no_anticipation\",\"explains\":\"Units did not change behaviour before treatment arrived because they knew it was coming.\",\"id\":\"no_anticipation\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No anticipation\",\"worry_when\":\"There was a public announcement well before the policy started, or the pre-period coefficients move in the period immediately before adoption.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"when_not_to_use\":[\"A pre-trend test that fails to reject is not proof of parallel trends -- it is often just a wide interval. Under staggered adoption each lead and lag is contaminated by already-treated units used as controls (Sun and Abraham 2021). The headline number here is a simple unweighted average of the post-period coefficients, not a cohort-size weighted ATT.\"],\"when_to_use\":[\"It is the picture policy readers actually read: pre-period points that hover around zero, and a visible break at adoption. It shows dynamics instead of averaging them away.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\",\"some of the robustness probes it names have no card of their own yet\"],\"id\":\"did.event_study\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"did.event_study\",\"registry\":{\"designs\":[\"did\"],\"diagnostics\":[\"raw_means\",\"adoption\",\"panel_balance\",\"event_study\",\"pre_trends\"],\"disrecommend_when\":null,\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":true,\"r\":\"fixest::feols with i(rel, ref = -1)\"},\"estimands\":[\"ATT\",\"cohort_ATT\"],\"explain_key\":\"method.did.event_study\",\"id\":\"did.event_study\",\"needs\":[\"numpy\",\"pandas\",\"scipy\"],\"needs_overlap\":false,\"one_liner\":\"Plot the effect period by period around adoption, so you can see whether the gap opened when the policy arrived or long before it.\",\"options\":[{\"default\":-1,\"help\":\"Every coefficient is measured against this period, relative to adoption. -1 is the period just before treatment; choose -2 if you suspect the policy was anticipated.\",\"label\":\"Reference period\",\"max\":0,\"min\":-20,\"name\":\"ref_period\",\"profile\":\"standard\",\"type\":\"int\"},{\"default\":5,\"help\":\"Anything earlier is pooled into the first point, so no data is dropped.\",\"label\":\"Periods before adoption to show\",\"max\":30,\"min\":1,\"name\":\"max_lead\",\"profile\":\"standard\",\"type\":\"int\"},{\"default\":5,\"help\":\"Anything later is pooled into the last point, so no data is dropped.\",\"label\":\"Periods after adoption to show\",\"max\":30,\"min\":0,\"name\":\"max_lag\",\"profile\":\"standard\",\"type\":\"int\"},{\"choices\":[\"auto\",\"demean\",\"dummies\"],\"default\":\"auto\",\"help\":\"Auto uses dummy variables on small panels and partials the fixed effects out on large ones. The estimate is the same either way; this only trades memory for speed.\",\"label\":\"How to handle the fixed effects\",\"name\":\"absorb\",\"profile\":\"advanced\",\"type\":\"select\"},{\"default\":0.95,\"help\":\"Width of the interval reported next to the estimate.\",\"label\":\"Confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":true,\"help\":\"Below 30 clusters the ordinary cluster-robust p-value rejects too often. This adds a restricted wild cluster bootstrap p-value in the Sensitivity tab.\",\"label\":\"Wild cluster bootstrap when clusters are few\",\"name\":\"wild_bootstrap\",\"profile\":\"advanced\",\"type\":\"bool\"},{\"default\":399,\"help\":\"Rademacher draws for the wild cluster bootstrap. Seeded by the run seed.\",\"label\":\"Bootstrap draws\",\"max\":9999,\"min\":99,\"name\":\"wild_reps\",\"profile\":\"advanced\",\"type\":\"int\"}],\"probes\":[\"placebo_period\",\"honest_did\",\"leave_one_cohort_out\",\"alternate_spec\"],\"reference_dispositions\":[{\"disposition\":\"resolved_metadata\",\"id\":\"sun2021\",\"requested_as\":\"Sun and Abraham (2021), Estimating dynamic treatment effects in event studies\"},{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:49d048eae93725829880\",\"requested_as\":\"Freyaldenhoven, Hansen and Shapiro (2019), Pre-event trends in the panel event-study design\"},{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:6213601a0aefb169aa58\",\"requested_as\":\"Roth (2022), Pretest with caution\"}],\"reference_ids\":[\"sun2021\",\"source:unresolved:49d048eae93725829880\",\"source:unresolved:6213601a0aefb169aa58\"],\"references\":[\"Sun and Abraham (2021), Estimating dynamic treatment effects in event studies\",\"Freyaldenhoven, Hansen and Shapiro (2019), Pre-event trends in the panel event-study design\",\"Roth (2022), Pretest with caution\"],\"roles_forbidden\":[\"running\",\"instruments\"],\"roles_optional\":[\"cluster\",\"confounders\"],\"roles_required\":[\"treatment\",\"outcome\",\"unit\",\"time\"],\"source_path\":\"engines/python/capy_py/did.py\",\"source_sha256\":\"6c4e72d00d337663377d0b86a9a96801e0bbc9813a8b50c74e66c5fab45398c2\",\"status\":\"recommended\",\"title\":\"Event study (leads and lags)\",\"what_can_go_wrong\":\"A pre-trend test that fails to reject is not proof of parallel trends -- it is often just a wide interval. Under staggered adoption each lead and lag is contaminated by already-treated units used as controls (Sun and Abraham 2021). The headline number here is a simple unweighted average of the post-period coefficients, not a cohort-size weighted ATT.\",\"why_recommended\":\"It is the picture policy readers actually read: pre-period points that hover around zero, and a visible break at adoption. It shows dynamics instead of averaging them away.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:06641c4edefb7397a5de64a7\",\"object_id\":\"diagnostic:panel_balance\",\"predicate\":\"checked_by_diagnostic\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"did.event_study\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:077174e1d7660f63e6c6e332\",\"object_id\":\"concept:causal-panel\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"abadie2005\",\"abadie2010\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party pap