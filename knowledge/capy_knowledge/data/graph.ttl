<urn:capy:did.chaisemartin> a capy:method ; skos:prefLabel "de Chaisemartin & D'Haultfoeuille" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:did.chaisemartin\"],\"catalogue_key\":\"method:did.chaisemartin\",\"citation_ids\":[\"chaisemartin2020\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":\"Not wrapped. The implemented staggered estimators assume treatment is absorbing, and warn when your panel says otherwise.\",\"engines\":{\"python\":false,\"r\":\"DIDmultiplegtDYN\"},\"needs_r_packages\":[\"DIDmultiplegtDYN\"],\"runs_here\":false,\"summary\":\"Not built into the app yet. The authoritative version is the R package DIDmultiplegtDYN, which the Engines screen can install for you.\"},\"designs\":[{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.adoption\",\"id\":\"adoption\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Adoption pattern\"},{\"explain_key\":\"diagnostic.event_study\",\"id\":\"event_study\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Event study\"},{\"explain_key\":\"diagnostic.pre_trends\",\"id\":\"pre_trends\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Pre-trend test\"},{\"explain_key\":\"diagnostic.panel_balance\",\"id\":\"panel_balance\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Panel balance\"}],\"estimands\":[{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"},{\"acronym\":\"ATT(g,t)\",\"explain_key\":\"estimand.cohort_att\",\"id\":\"cohort_ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For each group that adopted it, what did their own rollout do?\",\"title\":\"Group-time average treatment effect\"}],\"explain_key\":\"method.did.chaisemartin\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"did.chaisemartin\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":false,\"one_liner\":\"An estimator built for panels where treatment switches on and off, which the imputation and cohort estimators assume never happens.\",\"options\":[],\"plain_language\":\"An estimator built for panels where treatment switches on and off, which the imputation and cohort estimators assume never happens.\",\"probes\":[{\"explain_key\":\"probe.honest_did\",\"id\":\"probe.honest_did\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"What survives when parallel trends is allowed to fail by a stated amount.\",\"requested_as\":\"probe.honest_did\",\"title\":\"Honest DiD (Rambachan-Roth)\"},{\"explain_key\":\"probe.placebo_treatment\",\"id\":\"probe.placebo_treatment\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Move the policy date earlier, reshuffle who was treated, or swap in a variable that cannot cause the outcome.\",\"requested_as\":\"probe.placebo_treatment\",\"title\":\"Placebo treatment\"}],\"references\":[\"de Chaisemartin & D'Haultfoeuille (2020), Two-way fixed effects estimators with heterogeneous treatment effects\"],\"roles_forbidden\":[],\"roles_optional\":[],\"roles_required\":[\"a treatment\",\"an outcome\",\"a unit id\",\"a time variable\"],\"see_also\":[{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"},{\"explain_key\":\"method.did.bjs_imputation\",\"id\":\"did.bjs_imputation\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Learn what untreated life looks like from untreated cells only, then ask how far each treated cell landed from it.\",\"title\":\"Imputation (Borusyak-Jaravel-Spiess)\"},{\"explain_key\":\"method.did.callaway_santanna\",\"id\":\"did.callaway_santanna\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Estimate one clean before-and-after for every adoption cohort, then say out loud how you averaged them.\",\"title\":\"Callaway & Sant'Anna group-time effects\"},{\"explain_key\":\"method.did.dr_did\",\"id\":\"did.dr_did\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"One before-and-after with covariates, using an outcome model and a comparison-group model together so either one can carry it.\",\"title\":\"Doubly robust DiD\"},{\"explain_key\":\"method.did.event_study\",\"id\":\"did.event_study\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Plot the effect period by period around adoption, so you can see whether the gap opened when the policy arrived or long before it.\",\"title\":\"Event study (leads and lags)\"},{\"explain_key\":\"method.did.gardner_2s\",\"id\":\"did.gardner_2s\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Strip out unit and period effects using untreated cells only, then regress what is left on the policy.\",\"title\":\"Two-stage DiD (Gardner / Wooldridge-Mundlak)\"},{\"explain_key\":\"method.did.goodman_bacon\",\"id\":\"did.goodman_bacon\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Open up a two-way fixed effects estimate and show every two-group comparison inside it, with the weight each one carries -- including the ones that use already-treated units as controls.\",\"title\":\"Goodman-Bacon decomposition\"}],\"status\":\"recommended\",\"status_label\":\"Recommended\",\"tags\":[\"Policy rolled out over time\",\"ATT\",\"ATT(g,t)\",\"Recommended\"],\"title\":\"de Chaisemartin & D'Haultfoeuille\",\"what_it_assumes\":[{\"explain_key\":\"assumption.parallel_trends\",\"explains\":\"Without the policy, treated and comparison groups would have moved the same way. Not that they were at the same level -- that their paths would have been parallel.\",\"id\":\"parallel_trends\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Parallel trends\",\"worry_when\":\"Pre-period event-study coefficients drift away from zero; the policy was adopted because outcomes were already moving; the groups differ in composition in ways that interact with time.\"},{\"explain_key\":\"assumption.no_anticipation\",\"explains\":\"Units did not change behaviour before treatment arrived because they knew it was coming.\",\"id\":\"no_anticipation\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No anticipation\",\"worry_when\":\"There was a public announcement well before the policy started, or the pre-period coefficients move in the period immediately before adoption.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"when_not_to_use\":[\"With few switchers the estimates are imprecise, and the placebo tests it relies on need a decent number of pre-periods.\"],\"when_to_use\":[\"The only family here that handles treatment turning back off, and it reports how many two-way fixed-effects weights would have been negative.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"did.chaisemartin\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"did.chaisemartin\",\"registry\":{\"coming\":\"Not wrapped. The implemented staggered estimators assume treatment is absorbing, and warn when your panel says otherwise.\",\"designs\":[\"did\"],\"diagnostics\":[\"adoption\",\"event_study\",\"pre_trends\",\"panel_balance\"],\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":false,\"r\":\"DIDmultiplegtDYN\"},\"estimands\":[\"ATT\",\"cohort_ATT\"],\"id\":\"did.chaisemartin\",\"one_liner\":\"An estimator built for panels where treatment switches on and off, which the imputation and cohort estimators assume never happens.\",\"probes\":[\"probe.honest_did\",\"probe.placebo_treatment\"],\"r_needs\":[\"DIDmultiplegtDYN\"],\"reference_dispositions\":[{\"disposition\":\"resolved_metadata\",\"id\":\"chaisemartin2020\",\"requested_as\":\"de Chaisemartin & D'Haultfoeuille (2020), Two-way fixed effects estimators with heterogeneous treatment effects\"}],\"reference_ids\":[\"chaisemartin2020\"],\"references\":[\"de Chaisemartin & D'Haultfoeuille (2020), Two-way fixed effects estimators with heterogeneous treatment effects\"],\"roles_required\":[\"treatment\",\"outcome\",\"unit\",\"time\"],\"source_path\":\"engines/registry/methods.extra.yaml\",\"source_sha256\":\"2cb349e9f7f7e6f88c10c18d81478656fd420eda7ca977d9767610ac8c7a4be0\",\"status\":\"recommended\",\"title\":\"de Chaisemartin & D'Haultfoeuille\",\"what_can_go_wrong\":\"With few switchers the estimates are imprecise, and the placebo tests it relies on need a decent number of pre-periods.\",\"why_recommended\":\"The only family here that handles treatment turning back off, and it reports how many two-way fixed-effects weights would have been negative.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:136a1526735067d131a5e3c8\",\"object_id\":\"concept:causal-scope\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:skos2009\",\"source:ontology:provo2013\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"did.chaisemartin\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:1e4198325c2d3ac54c91c8b6\",\"object_id\":\"design:did\",\"predicate\":\"compatible_with_design\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufha