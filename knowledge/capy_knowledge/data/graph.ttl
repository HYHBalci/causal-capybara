<urn:capy:rd.local_randomization> a capy:method ; skos:prefLabel "Local randomisation RD" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:rd.local_randomization\"],\"catalogue_key\":\"method:rd.local_randomization\",\"citation_ids\":[\"source:unresolved:116af3580b5ef98b4735\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":\"Not wrapped. The implemented RD adapter warns when the running variable is discrete.\",\"engines\":{\"python\":false,\"r\":\"rdlocrand\"},\"needs_r_packages\":[\"rdlocrand\"],\"runs_here\":false,\"summary\":\"Not built into the app yet. The authoritative version is the R package rdlocrand, which the Engines screen can install for you.\"},\"designs\":[{\"explain_key\":\"design.rd\",\"id\":\"rd\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Crossing a score, age, or border switched the programme on.\",\"title\":\"A cutoff decided eligibility\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.manipulation\",\"id\":\"manipulation\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Density at the cutoff\"},{\"explain_key\":\"diagnostic.covariate_balance\",\"id\":\"covariate_balance\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Covariate balance\"},{\"explain_key\":\"diagnostic.rd_plot\",\"id\":\"rd_plot\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Binned scatter at the cutoff\"}],\"estimands\":[{\"acronym\":\"LATE\",\"explain_key\":\"estimand.late\",\"id\":\"LATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who only got it because of the instrument or the cutoff, what did it do?\",\"title\":\"Local average treatment effect\"},{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"}],\"explain_key\":\"method.rd.local_randomization\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"rd.local_randomization\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":false,\"one_liner\":\"Treat a narrow window around the cutoff as a small randomised experiment rather than fitting a curve through it.\",\"options\":[],\"plain_language\":\"Treat a narrow window around the cutoff as a small randomised experiment rather than fitting a curve through it.\",\"probes\":[{\"explain_key\":\"probe.placebo_outcome\",\"id\":\"probe.placebo_outcome\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the same analysis on something the treatment could not have changed. It should find nothing.\",\"requested_as\":\"probe.placebo_outcome\",\"title\":\"Placebo outcome\"}],\"references\":[\"Cattaneo, Frandsen & Titiunik (2015)\"],\"roles_forbidden\":[],\"roles_optional\":[],\"roles_required\":[\"an outcome\",\"a running variable\",\"a cutoff\"],\"see_also\":[{\"explain_key\":\"design.rd\",\"id\":\"rd\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Crossing a score, age, or border switched the programme on.\",\"title\":\"A cutoff decided eligibility\"},{\"explain_key\":\"method.rd.fuzzy\",\"id\":\"rd.fuzzy\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Divide the jump in the outcome by the jump in take-up: the effect for the people the cutoff actually moved.\",\"title\":\"Fuzzy RD (crossing the cutoff only nudged people in)\"},{\"explain_key\":\"method.rd.local_linear\",\"id\":\"rd.local_linear\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Fit a line either side of the threshold and measure the step between them.\",\"title\":\"Sharp RD at the cutoff\"},{\"explain_key\":\"method.rd.multi_cutoff\",\"id\":\"rd.multi_cutoff\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Several thresholds, or a boundary on a map, pooled into one design.\",\"title\":\"Multi-cutoff and geographic RD\"}],\"status\":\"recommended\",\"status_label\":\"Recommended\",\"tags\":[\"A cutoff decided eligibility\",\"LATE\",\"ATE\",\"Recommended\"],\"title\":\"Local randomisation RD\",\"what_it_assumes\":[{\"explain_key\":\"assumption.no_manipulation\",\"explains\":\"People could not precisely control which side of the cutoff they landed on.\",\"id\":\"no_manipulation\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No manipulation of the running variable\",\"worry_when\":\"A visible spike or gap in the density at the cutoff; covariates that jump; a cutoff that people knew about and had time to respond to.\"},{\"explain_key\":\"assumption.continuity\",\"explains\":\"Everything else that affects the outcome changes smoothly through the cutoff, so the only thing that jumps is the treatment.\",\"id\":\"continuity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Continuity of potential outcomes at the cutoff\",\"worry_when\":\"Several rules share the threshold; the running variable is coarse, so \\\"at the cutoff\\\" is really a wide band; the estimate depends heavily on the bandwidth.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"when_not_to_use\":[\"The window has to be chosen by a covariate-balance criterion, and the resulting sample is often tiny, so randomisation inference rather than a normal approximation is required.\"],\"when_to_use\":[\"The natural approach when the running variable is discrete with few mass points, where local polynomial inference is fragile.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"rd.local_randomization\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"rd.local_randomization\",\"registry\":{\"coming\":\"Not wrapped. The implemented RD adapter warns when the running variable is discrete.\",\"designs\":[\"rd\"],\"diagnostics\":[\"manipulation\",\"covariate_balance\",\"rd_plot\"],\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":false,\"r\":\"rdlocrand\"},\"estimands\":[\"LATE\",\"ATE\"],\"id\":\"rd.local_randomization\",\"one_liner\":\"Treat a narrow window around the cutoff as a small randomised experiment rather than fitting a curve through it.\",\"probes\":[\"probe.placebo_outcome\"],\"r_needs\":[\"rdlocrand\"],\"reference_dispositions\":[{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:116af3580b5ef98b4735\",\"requested_as\":\"Cattaneo, Frandsen & Titiunik (2015)\"}],\"reference_ids\":[\"source:unresolved:116af3580b5ef98b4735\"],\"references\":[\"Cattaneo, Frandsen & Titiunik (2015)\"],\"roles_required\":[\"outcome\",\"running\",\"cutoff\"],\"source_path\":\"engines/registry/methods.extra.yaml\",\"source_sha256\":\"2cb349e9f7f7e6f88c10c18d81478656fd420eda7ca977d9767610ac8c7a4be0\",\"status\":\"recommended\",\"title\":\"Local randomisation RD\",\"what_can_go_wrong\":\"The window has to be chosen by a covariate-balance criterion, and the resulting sample is often tiny, so randomisation inference rather than a normal approximation is required.\",\"why_recommended\":\"The natural approach when the running variable is discrete with few mass points, where local polynomial inference is fragile.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:011ea57f6f4dbc23cfa6e6e7\",\"object_id\":\"concept:causal-foundations\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:pearl2009\",\"source:ontology:rubin2008\",\"hernan2020\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"rd.local_randomization\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or im