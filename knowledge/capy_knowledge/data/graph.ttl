"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"med.interventional\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:feed94c1f32493398766015a\",\"object_id\":\"softwarepackage:CMAverse\",\"predicate\":\"implemented_by\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"med.interventional\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Shift the mediator to the distribution it would have in the population, rather than to each person's own unobservable counterfactual.\",\"title\":\"Interventional direct and indirect effects\"}" .
<urn:capy:med.natural_effects> a capy:method ; skos:prefLabel "Natural direct and indirect effects" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:med.natural_effects\"],\"catalogue_key\":\"method:med.natural_effects\",\"citation_ids\":[\"10.1097/00001648-199203000-00013\",\"source:unresolved:32b7a739addbe8b46f2b\",\"source:unresolved:34279c2cb21096a4d068\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":null,\"engines\":{\"python\":true,\"r\":\"mediation\"},\"needs_r_packages\":[\"mediation\"],\"runs_here\":true,\"summary\":\"Runs on this computer with what the app already installs.\"},\"designs\":[{\"explain_key\":\"design.mediation\",\"id\":\"mediation\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"We care about a mediator, not only the total effect.\",\"title\":\"How it worked (pathways)\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.temporal_ordering\",\"id\":\"temporal_ordering\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Temporal ordering of covariates\"},{\"explain_key\":\"diagnostic.mediation_decomposition\",\"id\":\"mediation_decomposition\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Total = direct + indirect\"},{\"explain_key\":\"diagnostic.treatment_mediator_interaction\",\"id\":\"treatment_mediator_interaction\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Treatment-mediator interaction\"}],\"estimands\":[{\"acronym\":null,\"explain_key\":null,\"id\":\"NIE\",\"in_catalogue\":false,\"kind\":\"estimand\",\"one_liner\":null,\"title\":\"Natural indirect effect\"},{\"acronym\":null,\"explain_key\":null,\"id\":\"NDE\",\"in_catalogue\":false,\"kind\":\"estimand\",\"one_liner\":null,\"title\":\"Natural direct effect\"},{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"}],\"explain_key\":\"method.med.natural_effects\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\",\"targets Natural indirect effect and Natural direct effect, which the estimand catalogue does not define yet\"],\"id\":\"med.natural_effects\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":true,\"one_liner\":\"Split the total effect into the part that travelled through the mediator and the part that did not.\",\"options\":[{\"default\":true,\"help\":\"Adds a treatment-by-mediator term. Without it, the two mirror decompositions agree by construction rather than by evidence.\",\"label\":\"Let the mediator's effect depend on treatment\",\"name\":\"interaction\",\"profile\":\"standard\",\"type\":\"bool\"},{\"default\":500,\"label\":\"Bootstrap draws\",\"max\":5000,\"min\":100,\"name\":\"bootstrap_reps\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":100,\"help\":\"Only used when a model is non-linear; linear chains are integrated exactly.\",\"label\":\"Simulation draws per unit\",\"max\":2000,\"min\":20,\"name\":\"mc_draws\",\"profile\":\"advanced\",\"type\":\"int\"}],\"plain_language\":\"Split the total effect into the part that travelled through the mediator and the part that did not.\",\"probes\":[{\"explain_key\":\"probe.subset\",\"id\":\"probe.subset\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Re-estimate on random subsets. The answer should move about as much as losing that much data costs, and no more.\",\"requested_as\":\"probe.subset\",\"title\":\"Subset stability\"},{\"explain_key\":\"probe.random_common_cause\",\"id\":\"probe.random_common_cause\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Add a variable that causes nothing to the adjustment set. The estimate should barely move.\",\"requested_as\":\"probe.random_common_cause\",\"title\":\"Random common cause\"},{\"explain_key\":\"probe.cinelli_hazlett\",\"id\":\"probe.cinelli_hazlett\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"How strong would an unmeasured confounder have to be -- compared with the covariates you already have -- to explain the estimate away?\",\"requested_as\":\"probe.cinelli_hazlett\",\"title\":\"Cinelli-Hazlett sensitivity (partial R2)\"},{\"explain_key\":\"probe.alternate_spec\",\"id\":\"probe.alternate_spec\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the grid of defensible specifications and sort the answers. The curve is the result, not the one you happened to run.\",\"requested_as\":\"probe.alternate_spec\",\"title\":\"Specification curve\"}],\"references\":[\"Robins & Greenland (1992), Identifiability and exchangeability for direct and indirect effects\",\"Pearl (2001), Direct and indirect effects\",\"VanderWeele (2015), Explanation in Causal Inference\"],\"roles_forbidden\":[],\"roles_optional\":[\"at least one measured confounder\",\"weight\",\"a clustering variable\"],\"roles_required\":[\"a treatment\",\"a mediator\",\"an outcome\"],\"see_also\":[{\"explain_key\":\"design.mediation\",\"id\":\"mediation\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"We care about a mediator, not only the total effect.\",\"title\":\"How it worked (pathways)\"},{\"explain_key\":\"method.med.interventional\",\"id\":\"med.interventional\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Shift the mediator to the distribution it would have in the population, rather than to each person's own unobservable counterfactual.\",\"title\":\"Interventional direct and indirect effects\"}],\"status\":\"reasonable\",\"status_label\":\"Reasonable\",\"tags\":[\"How it worked (pathways)\",\"Natural indirect effect\",\"Natural direct effect\",\"ATE\",\"Reasonable\"],\"title\":\"Natural direct and indirect effects\",\"what_it_assumes\":[{\"explain_key\":\"assumption.sequential_ignorability\",\"explains\":\"No unmeasured confounding of the treatment-outcome relationship, and none of the mediator-outcome relationship either, even after conditioning on treatment.\",\"id\":\"sequential_ignorability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Sequential ignorability\",\"worry_when\":\"There is a variable affected by treatment that also confounds the mediator-outcome relationship. Under that structure the natural effects are not identified at all.\"},{\"explain_key\":\"assumption.exchangeability\",\"explains\":\"Treated and untreated units are comparable once you condition on the confounders you measured. Everything that pushed people towards treatment and also moves the outcome is in your adjustment set.\",\"id\":\"exchangeability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Exchangeability / no unmeasured confounding\",\"worry_when\":\"Treatment was chosen by people who knew something about the likely outcome that you do not observe. Clinical judgement, self-selection into a programme, and administrative triage are the classic cases.\"},{\"explain_key\":\"assumption.positivity\",\"explains\":\"Every kind of unit had some chance of being treated and some chance of not being treated. Where that fails, there is no comparison to make and the model is inventing one.\",\"id\":\"positivity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Positivity / overlap\",\"worry_when\":\"Any single weight carries a large share of the total; the effective sample is far below the nominal one; the propensity model separates the arms almost perfectly; treated units sit outside the control group's range.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"when_not_to_use\":[\"Cross-world independence cannot be tested by any experiment, ever. And if anything the treatment caused also confounds the mediator-outcome relation, natural effects are not identified at all -- that is what interventional effects are for.\",\"A mediator-outcome confounder that the treatment affects is on the board\"],\"when_to_use\":[\"It is the decomposition most readers have in mind, it adds up exactly, and it is the right answer when the mediator has no confounder that treatment itself caused.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\",\"targets Natural indirect effect and Natural direct effect, which the estimand catalogue does not define yet\"],\"id\":\"med.natural_effects\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"med.natural_effects\",\"registry\":{\"designs\":[\"mediation\"],\"diagnostics\":[\"temporal_ordering\",\"mediation_decomposition\",\"treatment_mediator_interaction\"],\"disrecommend_when\":\"A mediator-outcome confounder that the treatment affects is on the board\",\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":true,\"r\":\"mediation\"},\"estimands\":[\"NIE\",\"NDE\",\"ATE\"],\"explain_key\":\"method.med.natural_effects\",\"id\":\"med.natural_effects\",\"needs\":[\"numpy\",\"scipy\",\"pandas\"],\"needs_overlap\":true,\"one_liner\":\"Split the total effect into the part that travelled through the mediator and the part that did not.\",\"options\":[{\"default\":true,\"help\":\"Adds a treatment-by-mediator term. Without it, the two mirror decompositions agree by construction rather than by evidence.\",\"label\":\"Let the mediator's effect depend on treatment\",\"name\":\"interaction\",\"profile\":\"standard\",\"type\":\"bool\"},{\"default\":500,\"label\":\"Bootstrap draws\",\"max\":5000,\"min\":100,\"name\":\"bootstrap_reps\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":100,\"help\":\"Only used when a model is non-linear; linear chains are integrated exactly.\",\"label\":\"Simulation draws per unit\",\"max\":2000,\"min\":20,\"name\":\"mc_draws\",\"profile\":\"advanced\",\"type\":\"int\"}],\"probes\":[\"probe.subset\",\"probe.random_common_cause\",\"probe.cinelli_hazlett\",\"probe.alternate_spec\"],\"reference_dispositions\":[{\"disposition\":\"resolved_metadata\",\"id\":\"10.1097/00001648-199203000-00013\",\"requested_as\":\"Robins & Greenland (1992), Identifiability and exchangeability for direct and indirect effects\"},{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:32b7a739addbe8b46f2b\",\"requested_as\":\"Pearl (2001), Direct and indirect effects\"},{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:34279c2cb21096a4d068\",\"requested_as\":\"VanderWeele (2015), Explanation in Causal Inference\"}],\"reference_ids\":[\"10.1097/00001648-199203000-00013\",\"source:unresolved:32b7a739addbe8b46f2b\",\"source:unresolved:34279c2cb21096a4d068\"],\"references\":[\"Robins & Greenland (1992), Identifiability and exchangeability for direct and indirect effects\",\"Pearl (2001), Direct and indirect effects\",\"VanderWeele (2015), Explanation in Causal Inference\"],\"roles_forbidden\":[],\"roles_optional\":[\"confounders\",\"weight\",\"cluster\"],\"roles_required\":[\"treatment\",\"mediator\",\"outcome\"],\"source_path\":\"engines/python/capy_py/longitudinal.py\",\"source_sha256\":\"49a2064131adc4f82db0de13c3127729b10c3407c6c933d1afed97a11dce4e83\",\"status\":\"reasonable\",\"title\":\"Natural direct and indirect effects\",\"what_can_go_wrong\":\"Cross-world independence cannot be tested by any experiment, ever. And if anything the treatment caused also confounds the mediator-outcome relation, natural effects are not identified at all -- that is what interventional effects are for.\",\"why_recommended\":\"It is the decomposition most readers have in mind, it adds up exactly, and it is the right answer when the mediator has no confounder that treatment itself caused.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:1193c0eb0fd80548dd56f5cd\",\"object_id\":\"diagnostic:temporal_ordering\",\"predicate\":\"checked_by_diagnostic\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"med.natural_effects\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic 