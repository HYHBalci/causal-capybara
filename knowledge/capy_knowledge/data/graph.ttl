 process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:7a79b0cf681d0ac14b520697\",\"object_id\":\"concept:accelerated-failure-time\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:wei1992\",\"source:ontology:r-survreg\",\"source:ontology:lifelines-aft\",\"source:ontology:robins1991\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped proposition explains or qualifies this concept; support remains limited to the exact original evidence note.\",\"subject_id\":\"claim:aft-time-ratio\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:8800dfaedd1525cade216622\",\"object_id\":\"concept:structural-failure-time\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:wei1992\",\"source:ontology:r-survreg\",\"source:ontology:lifelines-aft\",\"source:ontology:robins1991\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped proposition explains or qualifies this concept; support remains limited to the exact original evidence note.\",\"subject_id\":\"claim:aft-time-ratio\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:89d0185a188c8cec9438a01e\",\"object_id\":\"source:ontology:robins1991\",\"predicate\":\"cites\",\"provenance\":[\"source:note:aft-time-ratio\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:wei1992\",\"source:ontology:r-survreg\",\"source:ontology:lifelines-aft\",\"source:ontology:robins1991\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Citation and original explanation; linked external bodies are not included.\",\"subject_id\":\"claim:aft-time-ratio\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:f4dfe5cde2ccee7954413d52\",\"object_id\":\"source:ontology:lifelines-aft\",\"predicate\":\"cites\",\"provenance\":[\"source:note:aft-time-ratio\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:wei1992\",\"source:ontology:r-survreg\",\"source:ontology:lifelines-aft\",\"source:ontology:robins1991\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Citation and original explanation; linked external bodies are not included.\",\"subject_id\":\"claim:aft-time-ratio\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:wei1992\",\"source:ontology:r-survreg\",\"source:ontology:lifelines-aft\",\"source:ontology:robins1991\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped original methodological explanation; no whole-method or study audit is implied.\",\"source_ids\":[\"source:note:aft-time-ratio\",\"source:ontology:wei1992\",\"source:ontology:r-survreg\",\"source:ontology:lifelines-aft\",\"source:ontology:robins1991\"],\"summary\":\"A common-distribution AFT model relates log event time to covariates; exponentiating a treatment coefficient gives a conditional time factor under that specification. It is not automatically a causal parameter or a marginal RMST contrast. Declare the distribution, shape, scale and covariate parameterization, since software conventions differ. Structural failure-time and rank-preserving models encode separate counterfactual transformations and identifying conditions; an ordinary AFT fit does not implement them.\",\"title\":\"Ordinary AFT regression and structural failure-time models differ\"}" .
<urn:capy:claim%3Aaipw-att-control-nuisance> a capy:claim ; skos:prefLabel "ATT control outcome nuisance m0" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Aaipw> ; capy:record "{\"aliases\":[\"control outcome regression\",\"m0\",\"ATTE nuisance\",\"treated outcome model m1\"],\"assertion_mode\":\"original_editorial_explanation\",\"citation_ids\":[\"bang2005\",\"chernozhukov2018\",\"source:note:aipw\"],\"citations\":[],\"conditions\":[\"Binary treatment and nonzero treated population probability.\",\"The described ATT score, not the ATE score.\",\"Relevant ATT identification and support assumptions.\"],\"counterevidence\":[\"ATE normally needs both treatment-arm outcome means.\",\"Fitting both models in shared engine code does not make m1 an ATT score input.\"],\"evidence_ids\":[\"evidence:aipw-att-control-nuisance\"],\"gaps\":[\"This describes the inspected public Python engine, not every estimator called doubly robust.\"],\"id\":\"claim:aipw-att-control-nuisance\",\"kind\":\"claim\",\"provenance\":[\"source:note:aipw\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Binary treatment and nonzero treated population probability.\",\"The described ATT score, not the ATE score.\",\"Relevant ATT identification and support assumptions.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:6db7ecabbd7db727c84e409b\",\"object_id\":\"obs.aipw\",\"predicate\":\"qualifies\",\"provenance\":[\"source:note:aipw\",\"chernozhukov2018\",\"bang2005\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/observational.py\",\"tests/python/test_observational.py\",\"https://arxiv.org/html/1608.00060v7\",\"https://doi.org/10.1111/j.1541-0420.2005.00377.x\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache