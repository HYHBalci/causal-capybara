ope\":\"Qualified conceptual navigation; related terms are not equivalent estimands or verified identifying conditions.\",\"subject_id\":\"concept:within-arm-independent-censoring\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:d49a6298845c522e34680a34\",\"object_id\":\"source:ontology:cole2004\",\"predicate\":\"cites\",\"provenance\":[\"source:project-ontology\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Source context for original explanation; linked external bodies are not redistributed.\",\"subject_id\":\"concept:within-arm-independent-censoring\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Original methodological context for Within-arm independent censoring for raw Kaplan–Meier; not a study finding or a complete review of every implementation.\",\"source_ids\":[\"source:ontology:cole2004\"],\"summary\":\"Raw treatment-arm Kaplan–Meier requires the appropriate independent-censoring condition within the reported arms and supported risk sets; conditioning only on additional covariates is a different assumption.\",\"title\":\"Within-arm independent censoring for raw Kaplan–Meier\"}" .
<urn:capy:design%3Adid> a capy:design ; skos:prefLabel "Policy rolled out over time" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"Difference-in-differences\",\"DiD\",\"DD\",\"two-way fixed effects\",\"TWFE\",\"event study\",\"staggered adoption\",\"parallel trends\",\"panel data\"],\"catalogue_key\":\"design:did\",\"citation_ids\":[],\"citations\":[],\"content\":{\"also_called\":[\"Difference-in-differences\",\"DiD\",\"DD\",\"two-way fixed effects\",\"TWFE\",\"event study\",\"staggered adoption\",\"parallel trends\",\"panel data\"],\"assumption_notes\":[\"Parallel trends -- untestable, but the pre-period is evidence\",\"No anticipation before treatment arrives\",\"SUTVA -- treated units do not spill over onto controls\"],\"common_mistake\":\"Running two-way fixed effects on a staggered panel and reporting the coefficient as an average treatment effect on the treated.\",\"default_estimand\":{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"},\"diagnostics\":[{\"explain_key\":\"diagnostic.adoption\",\"id\":\"adoption\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Adoption pattern\"},{\"explain_key\":\"diagnostic.bacon_decomposition\",\"id\":\"bacon_decomposition\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Goodman-Bacon decomposition\"},{\"explain_key\":\"diagnostic.cell_means\",\"id\":\"cell_means\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Cell means\"},{\"explain_key\":\"diagnostic.cohort_att\",\"id\":\"cohort_att\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Cohort effects\"},{\"explain_key\":\"diagnostic.cohort_interactions\",\"id\":\"cohort_interactions\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Cohort-by-period interactions\"},{\"explain_key\":\"diagnostic.comparison_group\",\"id\":\"comparison_group\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Comparison group used\"},{\"explain_key\":\"diagnostic.event_study\",\"id\":\"event_study\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Event study\"},{\"explain_key\":\"diagnostic.group_time_att\",\"id\":\"group_time_att\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Group-time effects\"},{\"explain_key\":\"diagnostic.honest_did\",\"id\":\"honest_did\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Honest DiD breakdown value\"},{\"explain_key\":\"diagnostic.imputation_fit\",\"id\":\"imputation_fit\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Untreated-cell model fit\"},{\"explain_key\":\"diagnostic.leave_one_out\",\"id\":\"leave_one_out\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Leave one unit out\"},{\"explain_key\":\"diagnostic.negative_control\",\"id\":\"negative_control\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Negative control\"},{\"explain_key\":\"diagnostic.overlap\",\"id\":\"overlap\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Overlap between the arms\"},{\"explain_key\":\"diagnostic.panel_balance\",\"id\":\"panel_balance\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Panel balance\"},{\"explain_key\":\"diagnostic.placebo_outcome\",\"id\":\"placebo_outcome\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Placebo outcome\"},{\"explain_key\":\"diagnostic.placebo_treatment\",\"id\":\"placebo_treatment\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Placebo treatment\"},{\"explain_key\":\"diagnostic.pre_trend_size\",\"id\":\"pre_trend_size\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Size of the pre-trend\"},{\"explain_key\":\"diagnostic.pre_trends\",\"id\":\"pre_trends\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Pre-trend test\"},{\"explain_key\":\"diagnostic.probe_runs\",\"id\":\"probe_runs\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Probe runs\"},{\"explain_key\":\"diagnostic.random_common_cause\",\"id\":\"random_common_cause\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Random common cause\"},{\"explain_key\":\"diagnostic.raw_means\",\"id\":\"raw_means\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Raw means by cohort and period\"},{\"explain_key\":\"diagnostic.sc_convex_hull\",\"id\":\"sc_convex_hull\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Treated unit inside the donor hull\"},{\"explain_key\":\"diagnostic.sc_gap\",\"id\":\"sc_gap\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Treated minus synthetic gap\"},{\"explain_key\":\"diagnostic.sc_loo\",\"id\":\"sc_loo\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Leave one donor out\"},{\"explain_key\":\"diagnostic.sc_mc_rank\",\"id\":\"sc_mc_rank\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Matrix-completion rank\"},{\"explain_key\":\"diagnostic.sc_placebo_space\",\"id\":\"sc_placebo_space\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Placebo in space\"},{\"explain_key\":\"diagnostic.sc_placebo_time\",\"id\":\"sc_placebo_time\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Placebo in time\"},{\"explain_key\":\"diagnostic.sc_pre_fit\",\"id\":\"sc_pre_fit\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Pre-treatment fit\"},{\"explain_key\":\"diagnostic.sc_time_weights\",\"id\":\"sc_time_weights\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Time weights\"},{\"explain_key\":\"diagnostic.sc_weights\",\"id\":\"sc_weights\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Donor weights\"},{\"explain_key\":\"diagnostic.spec_curve\",\"id\":\"spec_curve\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Specification curve\"},{\"explain_key\":\"diagnostic.subset_stability\",\"id\":\"subset_stability\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Stability on random subsets\"},{\"explain_key\":\"diagnostic.unobserved_confounder\",\"id\":\"unobserved_confounder\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Simulated unobserved confounder\"}],\"estimands\":[{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"},{\"acronym\":\"ATT(g,t)\",\"explain_key\":\"estimand.cohort_att\",\"id\":\"cohort_ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For each group that adopted it, what did their own rollout do?\",\"title\":\"Group-time average treatment effect\"},{\"acronym\":\"CATE\",\"explain_key\":\"estimand.cate\",\"id\":\"CATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"How does the effect vary from person to person, or place to place?\",\"title\":\"Conditional average treatment effect\"}],\"explain_key\":\"design.did\",\"gaps\":[],\"how_the_board_reads\":\"Rows are units, columns are periods. The cells light up when treatment turns on.\",\"id\":\"did\",\"in_more_depth\":\"Comparing changes removes anything about a unit that is fixed over time -- you do not need to measure it, only to believe it is stable. That is a real gain, and it is bought with a different assumption: that without the policy the two groups would have moved the same way. When everyone adopts at the same date, this is a clean 2x2. When they adopt at different dates, two-way fixed effects stops estimating what you want: it averages comparisons that include already-treated units acting as controls, with weights that can go negative. The modern estimators fix that by only ever comparing a newly treated cohort with units not yet treated. Clustering matters here more than almost anywhere. Standard errors should be clustered at the level treatment was assigned.\",\"kind\":\"design\",\"methods\":[{\"explain_key\":\"method.did.bjs_imputation\",\"id\":\"did.bjs_imputation\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Learn what untreated life looks like from untreated cells only, then ask how far each treated cell landed from it.\",\"title\":\"Imputation (Borusyak-Jaravel-Spiess)\"},{\"explain_key\":\"method.did.callaway_santanna\",\"id\":\"did.callaway_santanna\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Estimate one clean before-and-after for every adoption cohort, then say out loud how you averaged them.\",\"title\":\"Callaway & Sant'Anna group-time effects\"},{\"explain_key\":\"method.did.chaisemartin\",\"id\":\"did.chaisemartin\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"An estimator built for panels where treatment switches on and off, which the imputation and cohort estimators assume never happens.\",\"title\":\"de Chaisemartin & D'Haultfoeuille\"},{\"explain_key\":\"method.did.dr_did\",\"id\":\"did.dr_did\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"One before-and-after with covariates, using an outcome model and a comparison-group model together so either one can carry it.\",\"title\":\"Doubly robust DiD\"},{\"explain_key\":\"method.did.event_study\",\"id\":\"did.event_study\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Plot the effect period by period around adoption, so you can see whether the gap opened when the policy arrived or long before it.\",\"title\":\"Event study (leads and lags)\"},{\"explain_key\":\"method.did.gardner_2s\",\"id\":\"did.gardner_2s\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Strip out unit and period effects using untreated cells only, then regress what is left on the policy.\",\"title\":\"Two-stage DiD (Gardner / Wooldridge-Mundlak)\"},{\"explain_key\":\"method.did.goodman_bacon\",\"id\":\"did.goodman_bacon\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Open up a two-way fixed effects estimate and show every two-group comparison inside it, with the weight each one carries -- including the ones that use already-treated units as controls.\",\"title\":\"Goodman-Bacon decomposition\"},{\"explain_key\":\"method.did.matched\",\"id\":\"did.matched\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Match treated to comparison units on pre-period characteristics first, then difference.\",\"title\":\"Matched difference-in-differences\"},{\"explain_key\":\"method.did.sun_abraham\",\"id\":\"did.sun_abraham\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Give every cohort its own event-study path, then average the paths by cohort size instead of letting the regression choose the weights.\",\"title\":\"Sun & Abraham event study\"},{\"explain_key\":\"method.did.synthdid_r\",\"id\":\"did.synthdid_r\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Weight both units and periods, then take a difference-in-differences -- halfway between synthetic control and DiD.\",\"title\":\"Synthetic difference-in-differences (synthdid)\"},{\"explain_key\":\"method.did.triple_diff\",\"id\":\"did.triple_diff\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Compare the treated-versus-comparison difference for the group the policy could reach with the same difference for a group inside the same units that it could not.\",\"title\":\"Triple differences\"},{\"explain_key\":\"method.did.twfe\",\"id\":\"did.twfe\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"One regression with unit and period fixed effects. Familiar, fast, and not an average treatment effect when units adopt at different dates.\",\"title\":\"Two-way fixed effects\"},{\"explain_key\":\"method.did.twoway_2x2\",\"id\":\"did.twoway_2x2\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Two groups, two periods: compare how much the treated group changed with how much the comparison group changed over the same window.\",\"title\":\"Difference-in-differences (2x2)\"},{\"explain_key\":\"method.interference.exposure\",\"id\":\"interference.exposure\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"When one unit's treatment affects another's outcome, estimate the direct and spillover effects separately instead of pretending neither exists.\",\"title\":\"Interference and spillovers\"},{\"explain_key\":\"method.obs.missing.mice\",\"id\":\"obs.missing.mice\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Impute the missing values several times, run the analysis in each, and combine -- instead of dropping every row with a gap.\",\"title\":\"Multiple imputation compatible with the analysis\"},{\"explain_key\":\"method.sc.matrix_completion\",\"id\":\"sc.matrix_completion\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Treat the missing treated-period outcomes as holes in a panel and fill them in with a low-rank model of what the panel would have done.\",\"title\":\"Matrix completion\"},{\"explain_key\":\"method.sc.synthdid\",\"id\":\"sc.synthdid\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Weight the comparison units and the pre-treatment periods, then run a difference in differences on the result - a level gap is allowed, a trend gap is not.\",\"title\":\"Synthetic difference-in-differences\"}],\"one_liner\":\"Some places or groups got it earlier than others.\",\"plain_language\":\"Some units were treated and others were not, and you observe both before and after. The comparison is of changes, not levels.\",\"probes\":[{\"explain_key\":\"probe.add_unobserved_confounder\",\"id\":\"probe.add_unobserved_confounder\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Simulate a common cause of a stated strength and watch the estimate move; read off how strong one would have to be to explain the result away.\",\"title\":\"Unobserved confounder\"},{\"explain_key\":\"probe.alternate_spec\",\"id\":\"probe.alternate_spec\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the grid of defensible specifications and sort the answers. The curve is the result, not the one you happened to run.\",\"title\":\"Specification curve\"},{\"explain_key\":\"probe.honest_did\",\"id\":\"probe.honest_did\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"What survives when parallel trends is allowed to fail by a stated amount.\",\"title\":\"Honest DiD (Rambachan-Roth)\"},{\"explain_key\":\"probe.leave_one_out\",\"id\":\"probe.leave_one_out\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Drop one cluster, cohort or donor at a time and see whether any single one is carrying the result.\",\"title\":\"Leave one out\"},{\"explain_key\":\"probe.negative_control\",\"id\":\"probe.negative_control\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Estimate something that shares the confounding but not the causal path. A non-zero answer is bias you can see.\",\"title\":\"Negative control\"},{\"explain_key\":\"probe.placebo_outcome\",\"id\":\"probe.placebo_outcome\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the same analysis on something the treatment could not have changed. It should find nothing.\",\"title\":\"Placebo outcome\"},{\"explain_key\":\"probe.placebo_treatment\",\"id\":\"probe.placebo_treatment\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Move the policy date earlier, reshuffle who was treated, or swap in a variable that cannot cause the outcome.\",\"title\":\"Placebo treatment\"},{\"explain_key\":\"probe.random_common_cause\",\"id\":\"probe.random_common_cause\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Add a variable that causes nothing to the adjustment set. The estimate should barely move.\",\"title\":\"Random common cause\"},{\"explain_key\":\"probe.subset\",\"id\":\"probe.subset\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Re-estimate on random subsets. The answer should move about as much as losing that much data costs, and no more.\",\"title\":\"Subset stability\"}],\"references\":[\"Goodman-Bacon (2021), Difference-in-differences with variation in treatment timing\",\"Callaway & Sant'Anna (2021)\",\"Roth, Sant'Anna, Bilinski & Poe (2023), What's trending in difference-in-differences?\"],\"see_also\":[{\"explain_key\":\"assumption.parallel_trends\",\"explains\":\"Without the policy, treated and comparison groups would have moved the same way. Not that they were at the same level -- that their paths would have been parallel.\",\"id\":\"parallel_trends\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Parallel trends\",\"worry_when\":\"Pre-period event-study coefficients drift away from zero; the policy was adopted because outcomes were already moving; the groups differ in composition in ways that interact with time.\"},{\"explain_key\":\"diagnostic.adoption\",\"id\":\"adoption\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Adoption pattern\"},{\"explain_key\":\"method.did.callaway_santanna\",\"id\":\"did.callaway_santanna\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Estimate one clean before-and-after for every adoption cohort, then say out loud how you averaged them.\",\"title\":\"Callaway & Sant'Anna group-time effects\"},{\"acronym\":\"ATT(g,t)\",\"explain_key\":\"estimand.cohort_att\",\"id\":\"cohort_ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For each group that adopted it, what did their own rollout do?\",\"title\":\"Group-time average treatment effect\"},{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"},{\"acronym\":\"CATE\",\"explain_key\":\"estimand.cate\",\"id\":\"CATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"How does the effect vary from person to person, or place to place?\",\"title\":\"Conditional average treatment effect\"},{\"explain_key\":\"method.did.bjs_imputation\",\"id\":\"did.bjs_imputation\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Learn what untreated life looks like from untreated cells only, then ask how far each treated cell landed from it.\",\"title\":\"Imputation (Borusyak-Jaravel-Spiess)\"},{\"explain_key\":\"method.did.chaisemartin\",\"id\":\"did.chaisemartin\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"An estimator built for panels where treatment switches on and off, which the imputation and cohort estimators assume never happens.\",\"title\":\"de Chaisemartin & D'Haultfoeuille\"},{\"explain_key\":\"method.did.dr_did\",\"id\":\"did.dr_did\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"One before-and-after with covariates, using an outcome model and a comparison-group model together so either one can carry it.\",\"title\":\"Doubly robust DiD\"}],\"tags\":[\"ATT\",\"ATT(g,t)\",\"CATE\"],\"title\":\"Policy rolled out over time\",\"what_it_assumes\":[{\"explain_key\":\"assumption.parallel_trends\",\"explains\":\"Without the policy, treated and comparison groups would have moved the same way. Not that they were at the same level -- that their paths would have been parallel.\",\"id\":\"parallel_trends\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Parallel trends\",\"worry_when\":\"Pre-period event-study coefficients drift away from zero; the policy was adopted because outcomes were already moving; the groups differ in composition in ways that interact with time.\"},{\"explain_key\":\"assumption.no_anticipation\",\"explains\":\"Units did not change behaviour before treatment arrived because they knew it was coming.\",\"id\":\"no_anticipation\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No anticipation\",\"worry_when\":\"There was a public announcement well before the policy started, or the pre-period coefficients move in the period immediately before adoption.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"design:did\",\"kind\":\"design\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"did\",\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:0979c1f5e07ba32eb75a58a1\",\"object_id\":\"assumption:parallel_trends\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:did\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:1dcba5cb6be4446dd359dd9f\",\"object_id\":\"estimand:cohort_ATT\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:did\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:2ecfdd233b81cb78ff5611c0\",\"object_id\":\"diagnostic:adoption\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declare