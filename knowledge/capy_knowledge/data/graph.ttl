},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:observational\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:c81722c56aff060634f2f6f7\",\"object_id\":\"estimand:dose_response\",\"predicate\":\"targets_estimand\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:observational\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:ce1c00017e58769b414bff87\",\"object_id\":\"estimand:ATO\",\"predicate\":\"targets_estimand\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:observational\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:dbad699f99d51f33c14ccc38\",\"object_id\":\"estimand:ATT\",\"predicate\":\"targets_estimand\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:observational\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:ea20705e87cb9e3139fce45a\",\"object_id\":\"estimand:CATE\",\"predicate\":\"targets_estimand\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:observational\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Treatment was not random, but you believe you measured the things that decided who got it. Everything then rests on that belief.\",\"title\":\"Adjust for background differences\"}" .
<urn:capy:design%3Arct> a capy:design ; skos:prefLabel "Randomised or as-if randomised" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"Randomised controlled trial\",\"RCT\",\"randomised experiment\",\"field experiment\",\"A/B test\",\"experiment\",\"random assignment\"],\"catalogue_key\":\"design:rct\",\"citation_ids\":[],\"citations\":[],\"content\":{\"also_called\":[\"Randomised controlled trial\",\"RCT\",\"randomised experiment\",\"field experiment\",\"A/B test\",\"experiment\",\"random assignment\"],\"assumption_notes\":[\"Randomisation held, and nothing after assignment broke the comparison\",\"SUTVA -- one unit's assignment does not change another's outcome\",\"Consistency -- the treatment is one well-defined thing\"],\"common_mistake\":\"Reporting the complier effect as the policy effect. A policy can offer a programme; it cannot make people take it.\",\"default_estimand\":{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"},\"diagnostics\":[{\"explain_key\":\"diagnostic.baseline_balance\",\"id\":\"baseline_balance\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Baseline balance\"},{\"explain_key\":\"diagnostic.block_structure\",\"id\":\"block_structure\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Block structure\"},{\"explain_key\":\"diagnostic.block_weighting\",\"id\":\"block_weighting\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Block weights\"},{\"explain_key\":\"diagnostic.cluster_structure\",\"id\":\"cluster_structure\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Cluster structure\"},{\"explain_key\":\"diagnostic.compliance\",\"id\":\"compliance\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Compliance with assignment\"},{\"explain_key\":\"diagnostic.differential_attrition\",\"id\":\"differential_attrition\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Differential attrition\"},{\"explain_key\":\"diagnostic.icc_design_effect\",\"id\":\"icc_design_effect\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Intra-cluster correlation and design effect\"},{\"explain_key\":\"diagnostic.leave_one_out\",\"id\":\"leave_one_out\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Leave one unit out\"},{\"explain_key\":\"diagnostic.negative_control\",\"id\":\"negative_control\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Negative control\"},{\"explain_key\":\"diagnostic.outcome_distribution\",\"id\":\"outcome_distribution\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Outcome distribution\"},{\"explain_key\":\"diagnostic.permutation_distribution\",\"id\":\"permutation_distribution\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Randomisation distribution\"},{\"explain_key\":\"diagnostic.placebo_outcome\",\"id\":\"placebo_outcome\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Placebo outcome\"},{\"explain_key\":\"diagnostic.placebo_treatment\",\"id\":\"placebo_treatment\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Placebo treatment\"},{\"explain_key\":\"diagnostic.probe_runs\",\"id\":\"probe_runs\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Probe runs\"},{\"explain_key\":\"diagnostic.random_common_cause\",\"id\":\"random_common_cause\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Random common cause\"},{\"explain_key\":\"diagnostic.spec_curve\",\"id\":\"spec_curve\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Specification curve\"},{\"explain_key\":\"diagnostic.subset_stability\",\"id\":\"subset_stability\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Stability on random subsets\"},{\"explain_key\":\"diagnostic.unobserved_confounder\",\"id\":\"unobserved_confounder\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Simulated unobserved confounder\"},{\"explain_key\":\"diagnostic.outcome_heterogeneity\",\"id\":\"outcome_heterogeneity\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Direct heterogeneity test on the selected outcome scale\"},{\"explain_key\":\"diagnostic.link_heterogeneity\",\"id\":\"link_heterogeneity\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Conditional treatment-by-modifier interaction\"}],\"estimands\":[{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"},{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"},{\"acronym\":\"ITT\",\"explain_key\":\"estimand.itt\",\"id\":\"ITT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For everyone who was offered it, what did the offer do?\",\"title\":\"Intention to treat\"},{\"acronym\":\"CACE\",\"explain_key\":\"estimand.cace\",\"id\":\"CACE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For the people who comply with what they were offered, what did it do?\",\"title\":\"Complier average causal effect\"},{\"acronym\":\"LATE\",\"explain_key\":\"estimand.late\",\"id\":\"LATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who only got it because of the instrument or the cutoff, what did it do?\",\"title\":\"Local average treatment effect\"},{\"acronym\":\"CATE\",\"explain_key\":\"estimand.cate\",\"id\":\"CATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"How does the effect vary from person to person, or place to place?\",\"title\":\"Conditional average treatment effect\"},{\"acronym\":\"GATE\",\"explain_key\":\"estimand.gate\",\"id\":\"GATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"How does the effect vary across pre-specified groups?\",\"title\":\"Group average treatment effect\"}],\"explain_key\":\"design.rct\",\"gaps\":[],\"how_the_board_reads\":\"Put the column that says who was offered the programme in Assignment, and what it was meant to change in Outcome. Blocks and clusters describe how the assignment was actually done, so they are facts about the study rather than choices you make here.\",\"id\":\"rct\",\"in_more_depth\":\"What randomisation buys you is exchangeability for free. What it does not buy you is everything afterwards: people drop out, refuse the treatment, or take it when they were not offered it, and each of those can undo the comparison. So the questions this design asks are about implementation. Was assignment really random, or did someone with discretion do it? Did whole clusters get assigned together, in which case the number of independent observations is the number of clusters? Did everyone offered the programme take it, and if not, is the number you want the effect of the offer or the effect on the people it moved? Covariates are for precision here, not identification. Adjust for the ones you named before seeing the data.\",\"kind\":\"design\",\"methods\":[{\"explain_key\":\"method.bounds.manski\",\"id\":\"bounds.manski\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Report the range the effect must lie in given only what the data can support, without assuming away the missing counterfactual.\",\"title\":\"Manski bounds\"},{\"explain_key\":\"method.heterogeneity.binary\",\"id\":\"heterogeneity.binary\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Logistic interactions plus separate standardized risk-difference, risk-ratio or marginal odds-ratio heterogeneity tests.\",\"title\":\"Binary outcome heterogeneity\"},{\"explain_key\":\"method.heterogeneity.categorical\",\"id\":\"heterogeneity.categorical\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Multinomial treatment interactions and a joint test of category-probability contrasts; preserves categories without assigning numeric scores.\",\"title\":\"Nominal and ordinal outcome heterogeneity\"},{\"explain_key\":\"method.heterogeneity.continuous\",\"id\":\"heterogeneity.continuous\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"OLS treatment-by-baseline-modifier interactions with HC3 or cluster sandwich inference, direct mean-difference tests and Holm pairwise comparisons.\",\"title\":\"Continuous outcome heterogeneity\"},{\"explain_key\":\"method.heterogeneity.count\",\"id\":\"heterogeneity.count\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Poisson conditional-mean interactions with robust sandwich inference; compare standardized count or fixed-exposure rate contrasts.\",\"title\":\"Count and rate outcome heterogeneity\"},{\"explain_key\":\"method.interference.exposure\",\"id\":\"interference.exposure\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"When one unit's treatment affects another's outcome, estimate the direct and spillover effects separately instead of pretending neither exists.\",\"title\":\"Interference and spillovers\"},{\"explain_key\":\"method.rct.cace\",\"id\":\"rct.cace\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Not everyone offered a programme takes it. Report what the offer did, and separately what taking it up did for the people it moved.\",\"title\":\"ITT and CACE (noncompliance)\"},{\"explain_key\":\"method.rct.cluster\",\"id\":\"rct.cluster\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"When whole schools, clinics or villages were assigned, the number of clusters is the sample size that matters.\",\"title\":\"Cluster-randomised trial\"},{\"explain_key\":\"method.rct.diff_means\",\"id\":\"rct.diff_means\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Compare the two arms as they were randomised, and let covariates sharpen the comparison without letting them change the question.\",\"title\":\"Difference in means\"},{\"explain_key\":\"method.rct.randomization_inference\",\"id\":\"rct.randomization_inference\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Re-run the randomisation thousands of times with the outcomes held fixed, and see how unusual what actually happened really is.\",\"title\":\"Randomisation (Fisher) inference\"},{\"explain_key\":\"method.rct.stratified\",\"id\":\"rct.stratified\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Estimate inside the blocks the randomisation was run in, then average them the way your estimand says to.\",\"title\":\"Blocked or stratified experiment\"},{\"explain_key\":\"method.transport.generalize\",\"id\":\"transport.generalize\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Take an effect estimated in one population and ask what it would be in another with a different mix of characteristics.\",\"title\":\"Transportability and generalisability\"}],\"one_liner\":\"People were assigned by chance, or as good as chance.\",\"plain_language\":\"Assignment was by chance, so the arms are comparable on everything -- including the things nobody measured. That is the whole reason experiments are the benchmark.\",\"probes\":[{\"explain_key\":\"probe.add_unobserved_confounder\",\"id\":\"probe.add_unobserved_confounder\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Simulate a common cause of a stated strength and watch the estimate move; read off how strong one would have to be to explain the result away.\",\"title\":\"Unobserved confounder\"},{\"explain_key\":\"probe.alternate_spec\",\"id\":\"probe.alternate_spec\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the grid of defensible specifications and sort the answers. The curve is the result, not the one you happened to run.\",\"title\":\"Specification curve\"},{\"explain_key\":\"probe.leave_one_out\",\"id\":\"probe.leave_one_out\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Drop one cluster, cohort or donor at a time and see whether any single one is carrying the result.\",\"title\":\"Leave one out\"},{\"explain_key\":\"probe.negative_control\",\"id\":\"probe.negative_control\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Estimate something that shares the confounding but not the causal path. A non-zero answer is bias you can see.\",\"title\":\"Negative control\"},{\"explain_key\":\"probe.placebo_outcome\",\"id\":\"probe.placebo_outcome\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the same analysis on something the treatment could not have changed. It should find nothing.\",\"title\":\"Placebo outcome\"},{\"explain_key\":\"probe.placebo_treatment\",\"id\":\"probe.placebo_treatment\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Move the policy date earlier, reshuffle who was treated, or swap in a variable that cannot cause the outcome.\",\"title\":\"Placebo treatment\"},{\"explain_key\":\"probe.random_common_cause\",\"id\":\"probe.random_common_cause\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Add a variable that causes nothing to the adjustment set. The estimate should barely move.\",\"title\":\"Random common cause\"},{\"explain_key\":\"probe.subset\",\"id\":\"probe.subset\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Re-estimate on random subsets. The answer should move about as much as losing that much data costs, and no more.\",\"title\":\"Subset stability\"}],\"references\":[\"Gerber & Green (2012), Field Experiments\",\"Duflo, Glennerster & Kremer (2007)\"],\"see_also\":[{\"acronym\":\"ITT\",\"explain_key\":\"estimand.itt\",\"id\":\"ITT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For everyone who was offered it, what did the offer do?\",\"title\":\"Intention to treat\"},{\"acronym\":\"CACE\",\"explain_key\":\"estimand.cace\",\"id\":\"CACE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For the people who comply with what they were offered, what did it do?\",\"title\":\"Complier average causal effect\"},{\"explain_key\":\"diagnostic.baseline_balance\",\"id\":\"baseline_balance\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Baseline balance\"},{\"explain_key\":\"concept.clustering\",\"id\":\"concept.clustering\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"When treatment was assigned to whole groups -- states, schools, clinics -- the number of independent observations is closer to the number of groups than the number of rows.\",\"title\":\"Clustering\"},{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"},{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"},{\"acronym\":\"LATE\",\"explain_key\":\"estimand.late\",\"id\":\"LATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who only got it because of the instrument or the cutoff, what did it do?\",\"title\":\"Local average treatment effect\"},{\"acronym\":\"CATE\",\"explain_key\":\"estimand.cate\",\"id\":\"CATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"How does the effect vary from person to person, or place to place?\",\"title\":\"Conditional average treatment effect\"},{\"acronym\":\"GATE\",\"explain_key\":\"estimand.gate\",\"id\":\"GATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"How does the effect vary across pre-specified groups?\",\"title\":\"Group average treatment effect\"},{\"explain_key\":\"method.bounds.manski\",\"id\":\"bounds.manski\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Report the range the effect must lie in given only what the data can support, without assuming away the missing counterfactual.\",\"title\":\"Manski bounds\"},{\"explain_key\":\"method.heterogeneity.binary\",\"id\":\"heterogeneity.binary\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Logistic interactions plus separate standardized risk-difference, risk-ratio or marginal odds-ratio heterogeneity tests.\",\"title\":\"Binary outcome heterogeneity\"},{\"explain_key\":\"method.heterogeneity.categorical\",\"id\":\"heterogeneity.categorical\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Multinomial treatment interactions and a joint test of category-probability contrasts; preserves categories without assigning numeric scores.\",\"title\":\"Nominal and ordinal outcome heterogeneity\"},{\"explain_key\":\"method.heterogeneity.continuous\",\"id\":\"heterogeneity.continuous\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"OLS treatment-by-baseline-modifier interactions with HC3 or cluster sandwich inference, direct mean-difference tests and Holm pairwise comparisons.\",\"title\":\"Continuous outcome heterogeneity\"}],\"tags\":[\"ATE\",\"ATT\",\"ITT\",\"CACE\",\"LATE\",\"CATE\",\"GATE\"],\"title\":\"Randomised or as-if randomised\",\"what_it_assumes\":[{\"explain_key\":\"assumption.randomisation\",\"explains\":\"Assignment really was by chance, and nothing after assignment broke the comparison -- no differential dropout, no crossover you have not modelled.\",\"id\":\"randomisation\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Randomisation held\",\"worry_when\":\"Dropout differs across arms; take-up is far from assignment; the randomiser was a person with discretion.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"design:rct\",\"kind\":\"design\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"rct\",\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:07678fc60e087e6f53fb2e6f\",\"object_id\":\"estimand:ATE\",\"predicate\":\"targets_estimand\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:rct\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[]