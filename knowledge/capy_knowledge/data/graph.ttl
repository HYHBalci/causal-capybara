<urn:capy:sc.synthdid> a capy:method ; skos:prefLabel "Synthetic difference-in-differences" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:sc.synthdid\"],\"catalogue_key\":\"method:sc.synthdid\",\"citation_ids\":[\"10.3386/w22791\",\"source:unresolved:8384b81671bad8bbc00a\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":null,\"engines\":{\"python\":true,\"r\":\"synthdid\"},\"needs_r_packages\":[\"synthdid\"],\"runs_here\":true,\"summary\":\"Runs on this computer with what the app already installs.\"},\"designs\":[{\"explain_key\":\"design.synth\",\"id\":\"synth\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"One treated unit; build a comparison from a donor pool.\",\"title\":\"One place, constructed twin\"},{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.sc_pre_fit\",\"id\":\"sc_pre_fit\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Pre-treatment fit\"},{\"explain_key\":\"diagnostic.sc_gap\",\"id\":\"sc_gap\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Treated minus synthetic gap\"},{\"explain_key\":\"diagnostic.sc_weights\",\"id\":\"sc_weights\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Donor weights\"},{\"explain_key\":\"diagnostic.sc_convex_hull\",\"id\":\"sc_convex_hull\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Treated unit inside the donor hull\"},{\"explain_key\":\"diagnostic.sc_placebo_space\",\"id\":\"sc_placebo_space\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Placebo in space\"},{\"explain_key\":\"diagnostic.sc_placebo_time\",\"id\":\"sc_placebo_time\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Placebo in time\"},{\"explain_key\":\"diagnostic.sc_loo\",\"id\":\"sc_loo\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Leave one donor out\"},{\"explain_key\":\"diagnostic.sc_time_weights\",\"id\":\"sc_time_weights\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Time weights\"}],\"estimands\":[{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"}],\"explain_key\":\"method.sc.synthdid\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\",\"some of the robustness probes it names have no card of their own yet\"],\"id\":\"sc.synthdid\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":false,\"one_liner\":\"Weight the comparison units and the pre-treatment periods, then run a difference in differences on the result - a level gap is allowed, a trend gap is not.\",\"options\":[{\"default\":true,\"help\":\"Re-run the method treating each donor as if it had been treated. This is where the p-value comes from; turning it off leaves the estimate with no yardstick.\",\"label\":\"Placebo in space\",\"name\":\"placebo_in_space\",\"profile\":\"standard\",\"type\":\"bool\"},{\"default\":60,\"help\":\"Cap on the number of donor placebo refits. Lower it only for speed; the p-value's floor is 1/(placebos+1).\",\"label\":\"Donors used for placebos\",\"max\":500,\"min\":2,\"name\":\"max_placebos\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":true,\"help\":\"Refit pretending the intervention happened earlier, using pre-intervention data only.\",\"label\":\"Placebo in time\",\"name\":\"placebo_in_time\",\"profile\":\"standard\",\"type\":\"bool\"},{\"default\":null,\"help\":\"Which earlier period to pretend the intervention happened in. Defaults to about 60% of the way through the pre-treatment period.\",\"label\":\"Placebo date\",\"name\":\"placebo_time\",\"profile\":\"advanced\",\"type\":\"string\"},{\"default\":true,\"help\":\"Refit without each contributing donor, to see whether the result rests on one unit.\",\"label\":\"Leave one donor out\",\"name\":\"leave_one_out\",\"profile\":\"standard\",\"type\":\"bool\"},{\"default\":30,\"help\":\"Cap on leave-one-donor-out refits.\",\"label\":\"Leave-one-out refits\",\"max\":200,\"min\":1,\"name\":\"max_loo\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":0.5,\"help\":\"Share of total weight at which a single donor raises a warning.\",\"label\":\"Warn when one donor exceeds\",\"max\":1.0,\"min\":0.1,\"name\":\"donor_share_warn\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":0.95,\"help\":\"Level for the placebo-based interval.\",\"label\":\"Interval level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"}],\"plain_language\":\"Weight the comparison units and the pre-treatment periods, then run a difference in differences on the result - a level gap is allowed, a trend gap is not.\",\"probes\":[{\"explain_key\":null,\"id\":\"placebo_in_space\",\"in_catalogue\":false,\"kind\":\"probe\",\"one_liner\":null,\"requested_as\":\"placebo_in_space\",\"title\":\"Placebo in space: run it on a unit that was never treated\"},{\"explain_key\":null,\"id\":\"placebo_in_time\",\"in_catalogue\":false,\"kind\":\"probe\",\"one_liner\":null,\"requested_as\":\"placebo_in_time\",\"title\":\"Placebo in time: pretend it happened earlier\"},{\"explain_key\":null,\"id\":\"leave_one_donor_out\",\"in_catalogue\":false,\"kind\":\"probe\",\"one_liner\":null,\"requested_as\":\"leave_one_donor_out\",\"title\":\"Leave one donor region out\"},{\"explain_key\":\"probe.alternate_spec\",\"id\":\"probe.alternate_spec\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the grid of defensible specifications and sort the answers. The curve is the result, not the one you happened to run.\",\"requested_as\":\"alternate_spec\",\"title\":\"Specification curve\"},{\"explain_key\":\"probe.placebo_outcome\",\"id\":\"probe.placebo_outcome\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the same analysis on something the treatment could not have changed. It should find nothing.\",\"requested_as\":\"placebo_outcome\",\"title\":\"Placebo outcome\"}],\"references\":[\"Arkhangelsky, Athey, Hirshberg, Imbens & Wager (2021), Synthetic Difference-in-Differences\",\"Doudchenko & Imbens (2016), Balancing, Regression, Difference-in-Differences and Synthetic Control Methods: A Synthesis\"],\"roles_forbidden\":[\"a running variable\",\"an instrument\",\"a cutoff\"],\"roles_optional\":[\"a treatment\",\"donor_pool\"],\"roles_required\":[\"a unit id\",\"a time variable\",\"an outcome\",\"the treated unit\",\"an intervention time\"],\"see_also\":[{\"explain_key\":\"design.synth\",\"id\":\"synth\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"One treated unit; build a comparison from a donor pool.\",\"title\":\"One place, constructed twin\"},{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"},{\"explain_key\":\"method.did.bjs_imputation\",\"id\":\"did.bjs_imputation\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Learn what untreated life looks like from untreated cells only, then ask how far each treated cell landed from it.\",\"title\":\"Imputation (Borusyak-Jaravel-Spiess)\"},{\"explain_key\":\"method.did.callaway_santanna\",\"id\":\"did.callaway_santanna\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Estimate one clean before-and-after for every adoption cohort, then say out loud how you averaged them.\",\"title\":\"Callaway & Sant'Anna group-time effects\"},{\"explain_key\":\"method.did.chaisemartin\",\"id\":\"did.chaisemartin\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"An estimator built for panels where treatment switches on and off, which the imputation and cohort estimators assume never happens.\",\"title\":\"de Chaisemartin & D'Haultfoeuille\"},{\"explain_key\":\"method.did.dr_did\",\"id\":\"did.dr_did\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"One before-and-after with covariates, using an outcome model and a comparison-group model together so either one can carry it.\",\"title\":\"Doubly robust DiD\"},{\"explain_key\":\"method.did.event_study\",\"id\":\"did.event_study\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Plot the effect period by period around adoption, so you can see whether the gap opened when the policy arrived or long before it.\",\"title\":\"Event study (leads and lags)\"},{\"explain_key\":\"method.did.gardner_2s\",\"id\":\"did.gardner_2s\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Strip out unit and period effects using untreated cells only, then regress what is left on the policy.\",\"title\":\"Two-stage DiD (Gardner / Wooldridge-Mundlak)\"}],\"status\":\"recommended\",\"status_label\":\"Recommended\",\"tags\":[\"One place, constructed twin\",\"Policy rolled out over time\",\"ATT\",\"Recommended\"],\"title\":\"Synthetic difference-in-differences\",\"what_it_assumes\":[{\"explain_key\":\"assumption.donor_fit\",\"explains\":\"The weighted combination of untreated units reproduces the treated unit's pre-period path closely enough to stand in for it afterwards.\",\"id\":\"donor_fit\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Pre-treatment fit from the donor pool\",\"worry_when\":\"Visible pre-period gaps; a short pre-period relative to the number of donors; one donor carrying most of the weight.\"},{\"explain_key\":\"assumption.convex_hull\",\"explains\":\"The treated unit's characteristics can be written as a weighted average of the donors', with weights that do not go negative.\",\"id\":\"convex_hull\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Treated unit inside the donor convex hull\",\"worry_when\":\"The treated unit is at an extreme of the donor distribution on the predictors, or the pre-period gap has a persistent level offset.\"},{\"explain_key\":\"assumption.no_anticipation\",\"explains\":\"Units did not change behaviour before treatment arrived because they knew it was coming.\",\"id\":\"no_anticipation\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No anticipation\",\"worry_when\":\"There was a public announcement well before the policy started, or the pre-period coefficients move in the period immediately before adoption.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.parallel_trends\",\"explains\":\"Without the policy, treated and comparison groups would have moved the same way. Not that they were at the same level -- that their paths would have been parallel.\",\"id\":\"parallel_trends\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Parallel trends\",\"worry_when\":\"Pre-period event-study coefficients drift away from zero; the policy was adopted because outcomes were already moving; the groups differ in composition in ways that interact with time.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"when_not_to_use\":[\"With one treated unit the paper's jackknife variance is undefined, so inference here is the placebo estimator and rests on donors being exchangeable with the treated unit. Time weights that concentrate on one or two pre-periods make the comparison rest on that slice of history. Covariates are not used at all in this implementation.\",\"Many treated units adopting at different times - use a staggered DiD estimator, which is built for that and gives cohort effects.\"],\"when_to_use\":[\"It keeps difference-in-differences' tolerance for a permanent level difference between the treated unit and its comparison while borrowing synthetic control's discipline about which units and which periods count. It is usually less sensitive to a poor level match than classic SC and less sensitive to parallel-trends violations than plain DiD.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\",\"some of the robustness probes it names have no card of their own yet\"],\"id\":\"sc.synthdid\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"sc.synthdid\",\"registry\":{\"designs\":[\"synth\",\"did\"],\"diagnostics\":[\"sc_pre_fit\",\"sc_gap\",\"sc_weights\",\"sc_convex_hull\",\"sc_placebo_space\",\"sc_placebo_time\",\"sc_loo\",\"sc_time_weights\"],\"disrecommend_when\":\"Many treated units adopting at different times - use a staggered DiD estimator, which is built for that and gives cohort effects.\",\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":true,\"r\":\"synthdid\"},\"estimands\":[\"ATT\"],\"explain_key\":\"method.sc.synthdid\",\"id\":\"sc.synthdid\",\"needs\":[\"numpy\",\"scipy\",\"pandas\"],\"needs_overlap\":false,\"one_liner\":\"Weight the comparison units and the pre-treatment periods, then run a difference in differences on the result - a level gap is allowed, a trend gap is not.\",\"options\":[{\"default\":true,\"help\":\"Re-run the method treating each donor as if it had been treated. This is where the p-value comes from; turning it off leaves the estimate with no yardstick.\",\"label\":\"Placebo in space\",\"name\":\"placebo_in_space\",\"profile\":\"standard\",\"type\":\"bool\"},{\"default\":60,\"help\":\"Cap on the number of donor placebo refits. Lower it only for speed; the p-value's floor is 1/(placebos+1).\",\"label\":\"Donors used for placebos\",\"max\":500,\"min\":2,\"name\":\"max_placebos\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":true,\"help\":\"Refit pretending the intervention happened earlier, using pre-intervention data only.\",\"label\":\"Placebo in time\",\"name\":\"placebo_in_time\",\"profile\":\"standard\",\"type\":\"bool\"},{\"default\":null,\"help\":\"Which earlier period to pretend the intervention happened in. Defaults to about 60% of the way through the pre-treatment period.\",\"label\":\"Placebo date\",\"name\":\"placebo_time\",\"profile\":\"advanced\",\"type\":\"string\"},{\"default\":true,\"help\":\"Refit without each contributing donor, to see whether the result rests on one unit.\",\"label\":\"Leave one donor out\",\"name\":\"leave_one_out\",\"profile\":\"standard\",\"type\":\"bool\"},{\"default\":30,\"help\":\"Cap on leave-one-donor-out refits.\",\"label\":\"Leave-one-out refits\",\"max\":200,\"min\":1,\"name\":\"max_loo\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":0.5,\"help\":\"Share of total weight at which a single donor raises a warning.\",\"label\":\"Warn when one donor exceeds\",\"max\":1.0,\"min\":0.1,\"name\":\"donor_share_warn\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":0.95,\"help\":\"Level for the placebo-based interval.\",\"label\":\"Interval level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"}],\"probes\":[\"placebo_in_space\",\"placebo_in_time\",\"leave_one_donor_out\",\"alternate_spec\",\"placebo_outcome\"],\"reference_dispositions\":[{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:8384b81671bad8bbc00a\",\"requested_as\":\"Arkhangelsky, Athey, Hirshberg, Imbens & Wager (2021), Synthetic Difference-in-Differences\"},{\"disposition\":\"resolved_metadata\",\"id\":\"10.3386/w22791\",\"requested_as\":\"Doudchenko & Imbens (2016), Balancing, Regression, Difference-in-Differences and Synthetic Control Methods: A Synthesis\"}],\"reference_ids\":[\"source:unresolved:8384b81671bad8bbc00a\",\"10.3386/w22791\"],\"references\":[\"Arkhangelsky, Athey, Hirshberg, Imbens & Wager (2021), Synthetic Difference-in-Differences\",\"Doudchenko & Imbens (2016), Balancing, Regression, Difference-in-Differences and Synthetic Control Methods: A Synthesis\"],\"roles_forbidden\":[\"running\",\"instruments\",\"cutoff\"],\"roles_optional\":[\"treatment\",\"donor_pool\"],\"roles_required\":[\"unit\",\"time\",\"outcome\",\"treated_unit\",\"event_time\"],\"source_path\":\"engines/python/capy_py/synth.py\",\"source_sha256\":\"15e0fecaebae31df3c3744e9641e14d8600985ef540e9ec544eefab910067860\",\"status\":\"recommended\",\"title\":\"Synthetic difference-in-differences\",\"what_can_go_wrong\":\"With one treated unit the paper's jackknife variance is undefined, so inference here is the placebo estimator and rests on donors being exchangeable with the treated unit. Time weights that concentrate on one or two pre-periods make the comparison rest on that slice of history. Covariates are not used at all in this implementation.\",\"why_recommended\":\"It keeps difference-in-differences' tolerance for a permanent level difference between the treated unit and its comparison while borrowing synthetic control's discipline about which units and which periods count. It is usually less sensitive to a poor level match than classic SC and less sensitive to parallel-trends violations than plain DiD.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:00a2ef040d999040be0dfcc0\",\"object_id\":\"design:did\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"sc.synthdid\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:05dfcf917d5293b95cb9b528\",\"object_id\":\"diagnostic:sc_gap\",\"predicate\":\"checked_by_diagnostic\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relation