ope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:did\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:c97b3e1e824e1fd929cbd7f9\",\"object_id\":\"estimand:cohort_ATT\",\"predicate\":\"targets_estimand\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:did\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Some units were treated and others were not, and you observe both before and after. The comparison is of changes, not levels.\",\"title\":\"Policy rolled out over time\"}" .
<urn:capy:design%3Aits> a capy:design ; skos:prefLabel "A shock in a single series" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"Interrupted time series\",\"ITS\",\"segmented regression\",\"before and after\",\"single series\"],\"catalogue_key\":\"design:its\",\"citation_ids\":[],\"citations\":[],\"content\":{\"also_called\":[\"Interrupted time series\",\"ITS\",\"segmented regression\",\"before and after\",\"single series\"],\"assumption_notes\":[\"The pre-period trend would have continued\",\"No co-interventions at the same moment\",\"Errors modelled well enough that the interval means something\"],\"common_mistake\":\"Fitting ordinary least squares to a monthly series and reporting the standard errors as they come.\",\"default_estimand\":{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"},\"diagnostics\":[{\"explain_key\":\"diagnostic.its_autocorrelation\",\"id\":\"its_autocorrelation\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Residual autocorrelation\"},{\"explain_key\":\"diagnostic.its_control_shock\",\"id\":\"its_control_shock\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Control series at the interruption\"},{\"explain_key\":\"diagnostic.its_counterfactual\",\"id\":\"its_counterfactual\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Counterfactual projection\"},{\"explain_key\":\"diagnostic.its_model_choice\",\"id\":\"its_model_choice\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Model choice\"},{\"explain_key\":\"diagnostic.its_pre_period\",\"id\":\"its_pre_period\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Pre-period length\"},{\"explain_key\":\"diagnostic.its_seasonality\",\"id\":\"its_seasonality\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Seasonality\"},{\"explain_key\":\"diagnostic.its_series\",\"id\":\"its_series\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"The series and the interruption\"},{\"explain_key\":\"diagnostic.leave_one_out\",\"id\":\"leave_one_out\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Leave one unit out\"},{\"explain_key\":\"diagnostic.negative_control\",\"id\":\"negative_control\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Negative control\"},{\"explain_key\":\"diagnostic.placebo_outcome\",\"id\":\"placebo_outcome\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Placebo outcome\"},{\"explain_key\":\"diagnostic.placebo_treatment\",\"id\":\"placebo_treatment\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Placebo treatment\"},{\"explain_key\":\"diagnostic.probe_runs\",\"id\":\"probe_runs\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Probe runs\"},{\"explain_key\":\"diagnostic.random_common_cause\",\"id\":\"random_common_cause\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Random common cause\"},{\"explain_key\":\"diagnostic.spec_curve\",\"id\":\"spec_curve\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Specification curve\"},{\"explain_key\":\"diagnostic.subset_stability\",\"id\":\"subset_stability\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Stability on random subsets\"},{\"explain_key\":\"diagnostic.unobserved_confounder\",\"id\":\"unobserved_confounder\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Simulated unobserved confounder\"}],\"estimands\":[{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"}],\"explain_key\":\"design.its\",\"gaps\":[],\"how_the_board_reads\":\"The counterfactual trend is an assumption, not an estimate.\",\"id\":\"its\",\"in_more_depth\":\"Common in public health, where a rule changes nationally and there is no untreated region. The strength is that the unit is its own control; the weakness is that the counterfactual is entirely a modelling assumption, and an extrapolated linear trend over several years is a strong claim. Three things routinely go wrong. Seasonality left unmodelled shows up as an effect. Autocorrelated residuals make the confidence interval far too narrow. And anything else that changed on the same date is inseparable from the policy -- which is why a control series that should not have been affected is worth a great deal.\",\"kind\":\"design\",\"methods\":[{\"explain_key\":\"method.its.arima\",\"id\":\"its.arima\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Model the memory in the series itself, then ask how big a step, pulse or ramp the data need at the intervention date.\",\"title\":\"ARIMA with an intervention\"},{\"explain_key\":\"method.its.causal_impact\",\"id\":\"its.causal_impact\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Model the counterfactual series with a structural time-series model and control series, and report a posterior rather than an interval.\",\"title\":\"Bayesian structural time series (CausalImpact)\"},{\"explain_key\":\"method.its.controlled\",\"id\":\"its.controlled\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"The same interruption, measured against a series the intervention did not touch, so a shock that hit everybody is not booked as your effect.\",\"title\":\"Controlled ITS\"},{\"explain_key\":\"method.its.segmented\",\"id\":\"its.segmented\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Fit the trend before the interruption, project it forward, and measure the jump and the change of direction after it.\",\"title\":\"Segmented regression\"}],\"one_liner\":\"Before versus after an interruption; maybe a control series.\",\"plain_language\":\"One series, one interruption. Fit the trend before, extrapolate it, and compare with what happened.\",\"probes\":[{\"explain_key\":\"probe.add_unobserved_confounder\",\"id\":\"probe.add_unobserved_confounder\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Simulate a common cause of a stated strength and watch the estimate move; read off how strong one would have to be to explain the result away.\",\"title\":\"Unobserved confounder\"},{\"explain_key\":\"probe.alternate_spec\",\"id\":\"probe.alternate_spec\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the grid of defensible specifications and sort the answers. The curve is the result, not the one you happened to run.\",\"title\":\"Specification curve\"},{\"explain_key\":\"probe.leave_one_out\",\"id\":\"probe.leave_one_out\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Drop one cluster, cohort or donor at a time and see whether any single one is carrying the result.\",\"title\":\"Leave one out\"},{\"explain_key\":\"probe.negative_control\",\"id\":\"probe.negative_control\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Estimate something that shares the confounding but not the causal path. A non-zero answer is bias you can see.\",\"title\":\"Negative control\"},{\"explain_key\":\"probe.placebo_outcome\",\"id\":\"probe.placebo_outcome\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the same analysis on something the treatment could not have changed. It should find nothing.\",\"title\":\"Placebo outcome\"},{\"explain_key\":\"probe.placebo_treatment\",\"id\":\"probe.placebo_treatment\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Move the policy date earlier, reshuffle who was treated, or swap in a variable that cannot cause the outcome.\",\"title\":\"Placebo treatment\"},{\"explain_key\":\"probe.random_common_cause\",\"id\":\"probe.random_common_cause\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Add a variable that causes nothing to the adjustment set. The estimate should barely move.\",\"title\":\"Random common cause\"},{\"explain_key\":\"probe.subset\",\"id\":\"probe.subset\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Re-estimate on random subsets. The answer should move about as much as losing that much data costs, and no more.\",\"title\":\"Subset stability\"}],\"references\":[\"Bernal, Cummins & Gasparrini (2017)\",\"Brodersen et al. (2015)\"],\"see_also\":[{\"explain_key\":\"assumption.model_form\",\"explains\":\"The line you fit before the interruption is the line the outcome would have continued to follow.\",\"id\":\"model_form\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Functional form of the counterfactual trend\",\"worry_when\":\"Few pre-period points; residual autocorrelation that survives the model; the estimate flips when you add a seasonal term or a quadratic trend.\"},{\"explain_key\":\"diagnostic.its_autocorrelation\",\"id\":\"its_autocorrelation\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Residual autocorrelation\"},{\"explain_key\":\"method.its.controlled\",\"id\":\"its.controlled\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"The same interruption, measured against a series the intervention did not touch, so a shock that hit everybody is not booked as your effect.\",\"title\":\"Controlled ITS\"},{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"},{\"explain_key\":\"method.its.arima\",\"id\":\"its.arima\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Model the memory in the series itself, then ask how big a step, pulse or ramp the data need at the intervention date.\",\"title\":\"ARIMA with an intervention\"},{\"explain_key\":\"method.its.causal_impact\",\"id\":\"its.causal_impact\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Model the counterfactual series with a structural time-series model and control series, and report a posterior rather than an interval.\",\"title\":\"Bayesian structural time series (CausalImpact)\"},{\"explain_key\":\"method.its.segmented\",\"id\":\"its.segmented\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Fit the trend before the interruption, project it forward, and measure the jump and the change of direction after it.\",\"title\":\"Segmented regression\"}],\"tags\":[\"ATT\"],\"title\":\"A shock in a single series\",\"what_it_assumes\":[{\"explain_key\":\"assumption.no_cointerventions\",\"explains\":\"Nothing else changed at the same moment that also moves the outcome.\",\"id\":\"no_cointerventions\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No co-interventions at the interruption\",\"worry_when\":\"A busy policy period; a national event at the same date; a change in how the outcome was measured or coded at the same date.\"},{\"explain_key\":\"assumption.model_form\",\"explains\":\"The line you fit before the interruption is the line the outcome would have continued to follow.\",\"id\":\"model_form\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Functional form of the counterfactual trend\",\"worry_when\":\"Few pre-period points; residual autocorrelation that survives the model; the estimate flips when you add a seasonal term or a quadratic trend.\"},{\"explain_key\":\"assumption.no_anticipation\",\"explains\":\"Units did not change behaviour before treatment arrived because they knew it was coming.\",\"id\":\"no_anticipation\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No anticipation\",\"worry_when\":\"There was a public announcement well before the policy started, or the pre-period coefficients move in the period immediately before adoption.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"}],\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"design:its\",\"kind\":\"design\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"its\",\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:036eb2e7e7245d618c37cf9c\",\"object_id\":\"its.arima\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:its\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:535f0936c0c6c4d379d922e4\",\"object_id\":\"assumption:model_form\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:its\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:b9f753ead13025dc8a7e166f\",\"object_id\":\"estimand:ATT\",\"predicate\":\"targets_estimand\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:its\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:c3ca9f4407aac0c30c0ad828\",\"object_id\":\"estimand:ATT\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:its\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:cb00550ef8aeb8e8eb8755c8\",\"object_id\":\"its.causal_impact\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:its\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:ce3b46917ac068cafed8a25c\",\"object_id\":\"its.segmented\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:its\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:dae42d22073b36fd8ab9b8cd\",\"object_id\":\"diagnostic:its_autocorrelation\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:its\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:f462ca8f1d2e5562aafdf93a\",\"object_id\":\"its.controlled\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:its\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"One series, one interruption. Fit the trend before, extrapolate it, and compare with what happened.\",\"title\":\"A shock in a single series\"}" .
<urn:capy:design%3Aiv> a capy:design ; skos:prefLabel "Something else pushed people in" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"Instrumental variables\",\"IV\",\"2SLS\",\"two-stage least squares\",\"encouragement design\",\"natural experiment\",\"LATE\",\"exclusion restriction\"],\"catalogue_key\":\"design:iv\",\"citation_ids\":[],\"citations\":[],\"content\":{\"also_called\":[\"Instrumental variables\",\"IV\",\"2SLS\",\"two-stage least squares\",\"encouragement design\",\"natural experiment\",\"LATE\",\"exclusion restriction\"],\"assumption_notes\":[\"Relevance -- testable, and the effective F is the number to read\",\"Exclusion -- untestable\",\"Monotonicity -- no defiers\"],\"common_mistake\":\"Calling the result \\\"the\\\" causal effect. Another instrument moves different people and identifies a different number, and both can be right.\",\"default_estimand\":{\"acronym\":\"LATE\",\"explain_key\":\"estimand.late\",\"id\":\"LATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who only got it because of the instrument or the cutoff, what did it do?\",\"title\":\"Local average treatment effect\"},\"diagnostics\":[{\"explain_key\":\"diagnostic.compliers\",\"id\":\"compliers\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Complier share\"},{\"explain_key\":\"diagnostic.endogeneity\",\"id\":\"endogeneity\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Endogeneity test\"},{\"explain_key\":\"diagnostic.first_stage\",\"id\":\"first_stage\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"First stage\"},{\"explain_key\":\"diagnostic.leave_one_out\",\"id\":\"leave_one_out\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Leave one unit out\"},{\"explain_key\":\"diagnostic.negative_control\",\"id\":\"negative_control\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Negative control\"},{\"explain_key\":\"diagnostic.overid\",\"id\":\"overid\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Overidentification test\"},{\"explain_key\":\"diagnostic.placebo_outcome\",\"id\":\"placebo_outcome\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Placebo outcome\"},{\"explain_key\":\"diagnostic.placebo_reduced_form\",\"id\":\"placebo_reduced_form\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Placebo reduced form\"},{\"explain_key\":\"diagnostic.placebo_treatment\",\"id\":\"placebo_treatment\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Placebo treatment\"},{\"explain_key\":\"diagnostic.probe_runs\",\"id\":\"probe_runs\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Probe runs\"},{\"explain_key\":\"diagnostic.random_common_cause\",\"id\":\"random_common_cause\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Random common cause\"},{\"explain_key\":\"diagnostic.reduced_form\",\"id\":\"reduced_form\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Reduced form\"},{\"explain_key\":\"diagnostic.spec_curve\",\"id\":\"spec_curve\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Specification curve\"},{\"explain_key\":\"diagnostic.subset_stability\",\"id\":\"subset_stability\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Stability on random subsets\"},{\"explain_key\":\"diagnostic.unobserved_confounder\",\"id\":\"unobserved_confounder\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Simulated unobserved confounder\"},{\"explain_key\":\"diagnostic.weak_iv_set\",\"id\":\"weak_iv_set\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Weak-instrument-robust set\"}],\"estimands\":[{\"acronym\":\"LATE\",\"explain_key\":\"estimand.late\",\"id\":\"LATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who only got it because of the instrument or the cutoff, what did it do?\",\"title\":\"Local average treatment effect\"},{\"acronym\":\"CACE\",\"explain_key\":\"estimand.cace\",\"id\":\"CACE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For the people who comply with what they were offered, what did it do?\",\"title\":\"Complier average causal effect\"},{\"acronym\":\"LATET\",\"explain_key\":\"estimand.latet\",\"id\":\"LATET\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For treated compliers, what did it do?\",\"title\":\"Local average treatment effect on the treated\"},{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"}],\"explain_key\":\"design.iv\",\"gaps\":[],\"how_the_board_reads\":\"The arrow from the instrument straight to the outcome is missing on purpose. That missing arrow is the exclusion restriction, and it is an assumption you are making.\",\"id\":\"iv\",\"in_more_depth\":\"The instrument does the work randomisation would have done, but only for part of the population: the compliers, whose treatment status the instrument actually changed. It says nothing about people who would have been treated regardless, or never. The arrow you did not draw -- from instrument straight to outcome -- is the exclusion restriction, and it cannot be tested. A strong first stage tells you the instrument moves treatment; it is silent about other routes. Weak instruments are the practical trap. Below an effective F of about ten, the usual interval is not trustworthy and a weak-instrument-robust set is the honest report, even when it is unbounded.\",\"kind\":\"design\",\"methods\":[{\"explain_key\":\"method.bounds.manski\",\"id\":\"bounds.manski\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Report the range the effect must lie in given only what the data can support, without assuming away the missing counterfactual.\",\"title\":\"Manski bounds\"},{\"explain_key\":\"method.iv.2sls\",\"id\":\"iv.2sls\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Use only the part of the treatment that the instrument moved, and see what happened to the outcome.\",\"title\":\"Two-stage least squares\"},{\"explain_key\":\"method.iv.gmm\",\"id\":\"iv.gmm\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Weight the instruments by how informative each one actually is, using a weight matrix estimated from the data.\",\"title\":\"Two-step GMM\"},{\"explain_key\":\"method.iv.liml\",\"id\":\"iv.liml\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"The maximum-likelihood cousin of two-stage least squares, which stays much better behaved when the instruments are weak.\",\"title\":\"LIML (and Fuller)\"},{\"explain_key\":\"method.iv.mte\",\"id\":\"iv.mte\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Trace the effect as a function of how reluctant a unit is to be treated, instead of reporting one local average.\",\"title\":\"Marginal treatment effects\"},{\"explain_key\":\"method.iv.shift_share\",\"id\":\"iv.shift_share\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Combine national shocks with local exposure shares to build an instrument for local changes.\",\"title\":\"Shift-share (Bartik) instruments\"},{\"explain_key\":\"method.iv.weak_robust\",\"id\":\"iv.weak_robust\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Report the set of effects the data cannot reject, which stays honest however weak the instrument is.\",\"title\":\"Weak-instrument-robust confidence set\"}],\"one_liner\":\"An instrument or encouragement changed treatment, not the outcome directly.\",\"plain_language\":\"An instrument moved treatment without touching the outcome any other way. You learn the effect for the people it moved.\",\"probes\":[{\"explain_key\":\"probe.add_unobserved_confounder\",\"id\":\"probe.add_unobserved_confounder\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Simulate a common cause of a stated strength and watch the estimate move; read off how strong one would have to be to explain the result away.\",\"title\":\"Unobserved confounder\"},{\"explain_key\":\"probe.alternate_spec\",\"id\":\"probe.alternate_spec\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the grid of defensible specifications and sort the answers. The curve is the result, not the one you happened to run.\",\"title\":\"Specification curve\"},{\"explain_key\":\"probe.leave_one_out\",\"id\":\"probe.leave_one_out\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Drop one cluster, cohort or donor at a time and see whether any single one is carrying the result.\",\"title\":\"Leave one out\"},{\"explain_key\":\"probe.negative_control\",\"id\":\"probe.negative_control\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Estimate something that shares the confounding but not the causal path. A non-zero answer is bias you can see.\",\"title\":\"Negative control\"},{\"explain_key\":\"probe.placebo_outcome\",\"id\":\"probe.placebo_outcome\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the same analysis on something the treatment could not have changed. It should find nothing.\",\"title\":\"Placebo outcome\"},{\"explain_key\":\"probe.placebo_treatment\",\"id\":\"probe.placebo_treatment\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Move the policy date earlier, reshuffle who was treated, or swap in a variable that cannot cause the outcome.\",\"title\":\"Placebo treatment\"},{\"explain_key\":\"probe.random_common_cause\",\"id\":\"probe.random_common_cause\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Add a variable that causes nothing to the adjustment set. The estimate should barely move.\",\"title\":\"Random common cause\"},{\"explain_key\":\"probe.subset\",\"id\":\"probe.subset\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Re-estimate on random subsets. The answer should move about as much as losing that much data costs, and no more.\",\"title\":\"Subset stability\"}],\"references\":[\"Angrist, Imbens & Rubin (1996)\",\"Andrews, Stock & Sun (2019)\"],\"see_also\":[{\"explain_key\":\"assumption.exclusion\",\"explains\":\"The instrument affects the outcome only through the treatment. On the board, that is the arrow you did not draw.\",\"id\":\"exclusion\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Exclusion restriction\",\"worry_when\":\"The instrument is a policy that changed several things at once; it is correlated with geography, time or institutions that have their own effects; it was chosen because it predicted the outcome.\"},{\"acronym\":\"LATE\",\"explain_key\":\"estimand.late\",\"id\":\"LATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who only got it because of the instrument or the cutoff, what did it do?\",\"title\":\"Local average treatment effect\"},{\"explain_key\":\"diagnostic.first_stage\",\"id\":\"first_stage\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"First stage\"},{\"acronym\":\"CACE\",\"explain_key\":\"estimand.cace\",\"id\":\"CACE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For the people who comply with what they were offered, what did it do?\",\"title\":\"Complier average causal effect\"},{\"acronym\":\"LATET\",\"explain_key\":\"estimand.latet\",\"id\":\"LATET\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For treated compliers, what did it do?\",\"title\":\"Local average treatment effect on the treated\"},{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"},{\"explain_key\":\"method.bounds.manski\",\"id\":\"bounds.manski\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Report the range the effect must lie in given only what the data can support, without assuming away the missing counterfactual.\",\"title\":\"Manski bounds\"},{\"explain_key\":\"method.iv.2sls\",\"id\":\"iv.2sls\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Use only the part of the treatment that the instrument moved, and see what happened to the outcome.\",\"title\":\"Two-stage least squares\"},{\"explain_key\":\"method.iv.gmm\",\"id\":\"iv.gmm\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Weight the instruments by how informative each one actually is, using a weight matrix estimated from the data.\",\"title\":\"Two-step GMM\"},{\"explain_key\":\"method.iv.liml\",\"id\":\"iv.liml\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"The maximum-likelihood cousin of two-stage least squares, which stays much better behaved when the instruments are weak.\",\"title\":\"LIML (and Fuller)\"}],\"tags\":[\"LATE\",\"CACE\",\"LATET\",\"ATE\"],\"title\":\"Something else pushed people in\",\"what_it_assumes\":[{\"explain_key\":\"assumption.relevance\",\"explains\":\"The instrument actually moves treatment, and moves it enough that the resulting estimate is not mostly noise.\",\"id\":\"relevance\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Instrument relevance\",\"worry_when\":\"An effective F below about 10; a first-stage coefficient that is substantively tiny even if statistically significant; many instruments.\"},{\"explain_key\":\"assumption.exclusion\",\"explains\":\"The instrument affects the outcome only through the treatment. On the board, that is the arrow you did not draw.\",\"id\":\"exclusion\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Exclusion restriction\",\"worry_when\":\"The instrument is a policy that changed several things at once; it is correlated with geography, time or institutions that have their own effects; it was chosen because it predicted the outcome.\"},{\"explain_key\":\"assumption.monotonicity\",\"explains\":\"The instrument pushes everyone the same way, or not at all. Nobody takes the treatment only because they were discouraged from it.\",\"id\":\"monotonicity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Monotonicity / no defiers\",\"worry_when\":\"The instrument is an incentive that could plausibly backfire for some people, or it is a judge or examiner whose leniency ordering differs across case types.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"design:iv\",\"kind\":\"design\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"iv\",\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:07455cc37059f443ac9e90a2\",\"object_id\":\"estimand:LATE\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type