ity-direct\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Prespecified contrast and appropriate joint covariance.\",\"Causal interpretation additionally requires design-specific identification.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:af23bbcd0c43359c3e0d9b5a\",\"object_id\":\"ml.policy_tree\",\"predicate\":\"qualifies\",\"provenance\":[\"source:note:heterogeneity-direct\",\"source:ontology:altman2003\",\"source:ontology:statsmodels-wald\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"subject_id\":\"claim:heterogeneity-direct\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:bfde71e0d0c7a0b02b8b4b7a\",\"object_id\":\"source:ontology:statsmodels-wald\",\"predicate\":\"cites\",\"provenance\":[\"source:note:heterogeneity-direct\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Citation and original explanation; linked external bodies are not included.\",\"subject_id\":\"claim:heterogeneity-direct\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"source_ids\":[\"source:note:heterogeneity-direct\",\"source:ontology:altman2003\",\"source:ontology:statsmodels-wald\"],\"summary\":\"Compare subgroup treatment contrasts directly; do not compare their separate significance labels. A joint Wald test needs an estimable contrast vector and covariance of full rank. Its null is equality on the stated effect scale, for the stated population and horizon. Failure to reject is not an equivalence result, and rejecting the null does not establish causal identification.\",\"title\":\"Heterogeneity requires a direct comparison on a declared scale\"}" .
