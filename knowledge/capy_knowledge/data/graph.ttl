<urn:capy:angrist1996> a capy:source ; skos:prefLabel "Angrist, J. D., Imbens, G. W., & Rubin, D. B. (1996). Identification of causal effects using instrumental variables. Journal of the American Statistical Association, 91(434), 444–455." ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"citation\":\"Angrist, J. D., Imbens, G. W., & Rubin, D. B. (1996). Identification of causal effects using instrumental variables. Journal of the American Statistical Association, 91(434), 444–455.\",\"citation_ids\":[],\"citations\":[],\"disposition\":\"resolved_metadata\",\"id\":\"angrist1996\",\"kind\":\"source\",\"metadata\":{\"citation\":\"Angrist, J. D., Imbens, G. W., & Rubin, D. B. (1996). Identification of causal effects using instrumental variables. Journal of the American Statistical Association, 91(434), 444–455.\",\"id\":\"angrist1996\",\"match\":[\"angrist\",\"imbens\",\"rubin\",\"1996\"],\"resolved\":true,\"topic\":\"Instrumental variables\",\"url\":\"https://doi.org/10.1080/01621459.1996.10476902\"},\"provenance\":[\"source:project-inventory\"],\"publication_rights\":{\"attribution\":\"Angrist, J. D., Imbens, G. W., & Rubin, D. B. (1996). Identification of causal effects using instrumental variables. Journal of the American Statistical Association, 91(434), 444–455.\",\"content_type\":\"external_publication_body\",\"license_id\":\"unknown\",\"license_url\":null,\"modified\":false,\"permissions\":{\"adapt\":false,\"cache\":false,\"display\":false,\"model_context\":false,\"public_export\":false},\"review_basis\":\"No full-text license has been admitted.\"},\"relations\":[],\"resolved\":true,\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_version\":\"https://doi.org/10.1080/01621459.1996.10476902\",\"summary\":\"Bibliographic metadata/link only; no publication text, abstract, figure or dataset is distributed.\",\"title\":\"Angrist, J. D., Imbens, G. W., & Rubin, D. B. (1996). Identification of causal effects using instrumental variables. Journal of the American Statistical Association, 91(434), 444–455.\",\"url\":\"https://doi.org/10.1080/01621459.1996.10476902\"}" .
<urn:capy:assumption%3Aconditional_independent_censoring> a capy:assumption ; skos:prefLabel "Independent censoring conditional on treatment and baseline covariates" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"assumption:conditional_independent_censoring\",\"citation_ids\":[],\"citations\":[],\"content\":{\"checks\":[],\"common_mistake\":null,\"designs\":[{\"explain_key\":\"design.survival\",\"id\":\"survival\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Follow people from a common time zero; some leave follow-up before the event is observed.\",\"title\":\"Time until an event\"}],\"explain_key\":\"assumption.conditional_independent_censoring\",\"gaps\":[\"no check in the app speaks to this one, so it can only be argued for\"],\"id\":\"conditional_independent_censoring\",\"in_more_depth\":\"The AFT likelihood relies on this untested condition. Raw Kaplan–Meier instead needs independence within each treatment group; the conditional statement alone cannot justify a raw group curve. Prognosis-dependent dropout, unmeasured predictors and unsupported observation horizons need review.\",\"kind\":\"assumption\",\"one_liner\":\"Given baseline treatment and covariates, censoring must not convey additional information about the unobserved event time.\",\"plain_language\":\"Given baseline treatment and covariates, censoring must not convey additional information about the unobserved event time.\",\"references\":[\"Hernán and Robins (2020), Causal Inference: What If\"],\"see_also\":[{\"explain_key\":\"design.survival\",\"id\":\"survival\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Follow people from a common time zero; some leave follow-up before the event is observed.\",\"title\":\"Time until an event\"}],\"starts_as\":\"untested\",\"tags\":[\"Time until an event\"],\"title\":\"Independent censoring conditional on treatment and baseline covariates\",\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[\"no check in the app speaks to this one, so it can only be argued for\"],\"id\":\"assumption:conditional_independent_censoring\",\"kind\":\"assumption\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"conditional_independent_censoring\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Given baseline treatment and covariates, censoring must not convey additional information about the unobserved event time.\",\"title\":\"Independent censoring conditional on treatment and baseline covariates\"}" .
<urn:capy:assumption%3Aconsistency> a capy:assumption ; skos:prefLabel "Consistency / well-defined intervention" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"assumption:consistency\",\"citation_ids\":[],\"citations\":[],\"content\":{\"checks\":[{\"explain_key\":\"diagnostic.strategy_paths\",\"id\":\"strategy_paths\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Treatment strategies compared\"}],\"common_mistake\":\"Estimating the effect of a variable nobody could assign, then discussing it as if a policy could change it.\",\"designs\":[{\"explain_key\":\"design.rct\",\"id\":\"rct\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"People were assigned by chance, or as good as chance.\",\"title\":\"Randomised or as-if randomised\"},{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"},{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"},{\"explain_key\":\"design.rd\",\"id\":\"rd\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Crossing a score, age, or border switched the programme on.\",\"title\":\"A cutoff decided eligibility\"},{\"explain_key\":\"design.iv\",\"id\":\"iv\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"An instrument or encouragement changed treatment, not the outcome directly.\",\"title\":\"Something else pushed people in\"},{\"explain_key\":\"design.synth\",\"id\":\"synth\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"One treated unit; build a comparison from a donor pool.\",\"title\":\"One place, constructed twin\"},{\"explain_key\":\"design.its\",\"id\":\"its\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Before versus after an interruption; maybe a control series.\",\"title\":\"A shock in a single series\"},{\"explain_key\":\"design.mediation\",\"id\":\"mediation\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"We care about a mediator, not only the total effect.\",\"title\":\"How it worked (pathways)\"},{\"explain_key\":\"design.longitudinal\",\"id\":\"longitudinal\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"The same person is treated, untreated, treated again; confounders also move.\",\"title\":\"Treatment that changes over time\"}],\"explain_key\":\"assumption.consistency\",\"gaps\":[],\"id\":\"consistency\",\"in_more_depth\":\"Consistency is what makes \\\"the effect of X\\\" mean anything. It is comfortable for a drug at a stated dose and uncomfortable for \\\"obesity\\\", \\\"education\\\" or \\\"democracy\\\", where the intervention is not defined and different ways of changing the variable would have different effects. Target-trial thinking is the discipline here: write down the trial you would run, including who is eligible, when time zero is, and what exactly is assigned. If you cannot write it, the estimand is not yet a question.\",\"kind\":\"assumption\",\"one_liner\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"plain_language\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"references\":[\"Hernán (2016), Does water kill?\",\"Hernán & Robins (2016), Using big data to emulate a target trial\"],\"see_also\":[{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"concept.target_trial\",\"id\":\"concept.target_trial\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"Write down the randomised experiment you would run if you could, then ask what your data lets you emulate.\",\"title\":\"The target trial\"},{\"explain_key\":\"design.rct\",\"id\":\"rct\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"People were assigned by chance, or as good as chance.\",\"title\":\"Randomised or as-if randomised\"},{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"},{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"},{\"explain_key\":\"design.rd\",\"id\":\"rd\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Crossing a score, age, or border switched the programme on.\",\"title\":\"A cutoff decided eligibility\"},{\"explain_key\":\"design.iv\",\"id\":\"iv\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"An instrument or encouragement changed treatment, not the outcome directly.\",\"title\":\"Something else pushed people in\"},{\"explain_key\":\"design.synth\",\"id\":\"synth\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"One treated unit; build a comparison from a donor pool.\",\"title\":\"One place, constructed twin\"},{\"explain_key\":\"design.its\",\"id\":\"its\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Before versus after an interruption; maybe a control series.\",\"title\":\"A shock in a single series\"},{\"explain_key\":\"design.mediation\",\"id\":\"mediation\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"We care about a mediator, not only the total effect.\",\"title\":\"How it worked (pathways)\"},{\"explain_key\":\"design.longitudinal\",\"id\":\"longitudinal\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"The same person is treated, untreated, treated again; confounders also move.\",\"title\":\"Treatment that changes over time\"},{\"explain_key\":\"diagnostic.strategy_paths\",\"id\":\"strategy_paths\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Treatment strategies compared\"}],\"starts_as\":\"assumed\",\"tags\":[\"Randomised or as-if randomised\",\"Adjust for background differences\",\"Policy rolled out over time\",\"A cutoff decided eligibility\",\"Something else pushed people in\",\"One place, constructed twin\",\"A shock in a single series\",\"How it worked (pathways)\",\"Treatment that changes over time\"],\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"assumption:consistency\",\"kind\":\"assumption\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"consistency\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"title\":\"Consistency / well-defined intervention\"}" .
<urn:capy:assumption%3Acontinuity> a capy:assumption ; skos:prefLabel "Continuity of potential outcomes at the cutoff" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"assumption:continuity\",\"citation_ids\":[],\"citations\":[],\"content\":{\"checks\":[{\"explain_key\":\"diagnostic.bandwidth_sensitivity\",\"id\":\"bandwidth_sensitivity\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Bandwidth sensitivity path\"},{\"explain_key\":\"diagnostic.bias_correction\",\"id\":\"bias_correction\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Bias correction and robust interval\"},{\"explain_key\":\"diagnostic.level_jump_at_kink\",\"id\":\"level_jump_at_kink\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Level jump at a kink\"},{\"explain_key\":\"diagnostic.rd_plot\",\"id\":\"rd_plot\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Binned scatter at the cutoff\"},{\"explain_key\":\"diagnostic.running_variable_discreteness\",\"id\":\"running_variable_discreteness\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Discreteness of the running variable\"}],\"common_mistake\":\"Presenting the discontinuity estimate as the average effect of the programme for everyone eligible.\",\"designs\":[{\"explain_key\":\"design.rd\",\"id\":\"rd\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Crossing a score, age, or border switched the programme on.\",\"title\":\"A cutoff decided eligibility\"}],\"explain_key\":\"assumption.continuity\",\"gaps\":[],\"id\":\"continuity\",\"in_more_depth\":\"The cutoff has to be doing one job. If the same threshold also triggers a different programme, a tax band or an administrative category, the jump you measure is the combined effect of all of them, and nothing separates them. Continuity is why the estimate is local: it is identified at the cutoff and the extrapolation away from it is a modelling choice, not a finding.\",\"kind\":\"assumption\",\"one_liner\":\"Everything else that affects the outcome changes smoothly through the cutoff, so the only thing that jumps is the treatment.\",\"plain_language\":\"Everything else that affects the outcome changes smoothly through the cutoff, so the only thing that jumps is the treatment.\",\"references\":[\"Hahn, Todd & van der Klaauw (2001)\",\"Cattaneo, Idrobo & Titiunik (2019)\"],\"see_also\":[{\"acronym\":\"LATE\",\"explain_key\":\"estimand.late\",\"id\":\"LATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who only got it because of the instrument or the cutoff, what did it do?\",\"title\":\"Local average treatment effect\"},{\"explain_key\":\"diagnostic.rd_bandwidth\",\"id\":\"diagnostic.rd_bandwidth\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"The estimate plotted against the bandwidth, so the choice is visible rather than buried in an option.\",\"title\":\"Bandwidth sensitivity path\"},{\"explain_key\":\"design.rd\",\"id\":\"rd\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Crossing a score, age, or border switched the programme on.\",\"title\":\"A cutoff decided eligibility\"},{\"explain_key\":\"diagnostic.bandwidth_sensitivity\",\"id\":\"bandwidth_sensitivity\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Bandwidth sensitivity path\"},{\"explain_key\":\"diagnostic.bias_correction\",\"id\":\"bias_correction\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Bias correction and robust interval\"},{\"explain_key\":\"diagnostic.level_jump_at_kink\",\"id\":\"level_jump_at_kink\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Level jump at a kink\"},{\"explain_key\":\"diagnostic.rd_plot\",\"id\":\"rd_plot\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Binned scatter at the cutoff\"}],\"starts_as\":\"assumed\",\"tags\":[\"A cutoff decided eligibility\"],\"title\":\"Continuity of potential outcomes at the cutoff\",\"worry_when\":\"Several rules share the threshold; the running variable is coarse, so \\\"at the cutoff\\\" is really a wide band; the estimate depends heavily on the bandwidth.\"},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"assumption:continuity\",\"kind\":\"assumption\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"continuity\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Everything else that affects the outcome changes smoothly through the cutoff, so the only thing that jumps is the treatment.\",\"title\":\"Continuity of potential outcomes at the cutoff\"}" .
<urn:capy:assumption%3Aconvex_hull> a capy:assumption ; skos:prefLabel "Treated unit inside the donor convex hull" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"assumption:convex_hull\",\"citation_ids\":[],\"citations\":[],\"content\":{\"checks\":[{\"explain_key\":\"diagnostic.augmentation_gap\",\"id\":\"augmentation_gap\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Augmentation gap\"},{\"explain_key\":\"diagnostic.sc_augmentation\",\"id\":\"sc_augmentation\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Size of the augmentation correction\"},{\"explain_key\":\"diagnostic.sc_convex_hull\",\"id\":\"sc_convex_hull\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Treated unit inside the donor hull\"},{\"explain_key\":\"diagnostic.sc_weights\",\"id\":\"sc_weights\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Donor weights\"}],\"common_mistake\":null,\"designs\":[{\"explain_key\":\"design.synth\",\"id\":\"synth\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"One treated unit; build a comparison from a donor pool.\",\"title\":\"One place, constructed twin\"}],\"explain_key\":\"assumption.convex_hull\",\"gaps\":[],\"id\":\"convex_hull\",\"in_more_depth\":\"Classic synthetic control restricts weights to be non-negative and to sum to one, which forbids extrapolation on purpose. The price is that if the treated unit is more extreme than every donor -- richer, larger, more urban -- no combination can reach it, and the synthetic unit is biased towards the middle of the pool. That bias then shows up as a permanent gap that looks like an effect. Augmented synthetic control corrects for that bias explicitly, and reports the size of the correction so you can see how much work it is doing.\",\"kind\":\"assumption\",\"one_liner\":\"The treated unit's characteristics can be written as a weighted average of the donors', with weights that do not go negative.\",\"plain_language\":\"The treated unit's characteristics can be written as a weighted average of the donors', with weights that do not go negative.\",\"references\":[\"Ben-Michael, Feller & Rothstein (2021), The augmented synthetic control method\"],\"see_also\":[{\"explain_key\":\"assumption.donor_fit\",\"explains\":\"The weighted combination of untreated units reproduces the treated unit's pre-period path closely enough to stand in for it afterwards.\",\"id\":\"donor_fit\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Pre-treatment fit from the donor pool\",\"worry_when\":\"Visible pre-period gaps; a short pre-period relative to the number of donors; one donor carrying most of the weight.\"},{\"explain_key\":\"method.sc.augmented\",\"id\":\"sc.augmented\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"When no weighted average of the donors can match the treated place, correct the leftover bias with a ridge model and show the size of the correction.\",\"title\":\"Augmented synthetic control\"},{\"explain_key\":\"design.synth\",\"id\":\"synth\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"One treated unit; build a comparison from a donor pool.\",\"title\":\"One place, constructed twin\"},{\"explain_key\":\"diagnostic.augmentation_gap\",\"id\":\"augmentation_gap\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Augmentation gap\"},{\"explain_key\":\"diagnostic.sc_augmentation\",\"id\":\"sc_augmentation\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Size of the augmentation correction\"},{\"explain_key\":\"diagnostic.sc_convex_hull\",\"id\":\"sc_convex_hull\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Treated unit inside the donor hull\"},{\"explain_key\":\"diagnostic.sc_weights\",\"id\":\"sc_weights\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Donor weights\"}],\"starts_as\":\"untested\",\"tags\":[\"One place, constructed twin\"],\"title\":\"Treated unit inside the donor convex hull\",\"worry_when\":\"The treated unit is at an extreme of the donor distribution on the predictors, or the pre-period gap has a persistent level offset.\"},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"assumption:convex_hull\",\"kind\":\"assumption\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"convex_hull\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"The treated unit's characteristics can be written as a weighted average of the donors', with weights that do not go negative.\",\"title\":\"Treated unit inside the donor convex hull\"}" .
<urn:capy:assumption%3Adonor_fit> a capy:assumption ; skos:prefLabel "Pre-treatment fit from the donor pool" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"assumption:donor_fit\",\"citation_ids\":[],\"citations\":[],\"content\":{\"checks\":[{\"explain_key\":\"diagnostic.sc_gap\",\"id\":\"sc_gap\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Treated minus synthetic gap\"},{\"explain_key\":\"diagnostic.sc_loo\",\"id\":\"sc_loo\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Leave one donor out\"},{\"explain_key\":\"diagnostic.sc_mc_rank\",\"id\":\"sc_mc_rank\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Matrix-completion rank\"},{\"explain_key\":\"diagnostic.sc_placebo_space\",\"id\":\"sc_placebo_space\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Placebo in space\"},{\"explain_key\":\"diagnostic.sc_pre_fit\",\"id\":\"sc_pre_fit\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Pre-treatment fit\"},{\"explain_key\":\"diagnostic.sc_time_weights\",\"id\":\"sc_time_weights\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Time weights\"}],\"common_mistake\":null,\"designs\":[{\"explain_key\":\"design.synth\",\"id\":\"synth\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"One treated unit; build a comparison from a donor pool.\",\"title\":\"One place, constructed twin\"}],\"explain_key\":\"assumption.donor_fit\",\"gaps\":[],\"id\":\"donor_fit\",\"in_more_depth\":\"A synthetic control that cannot track the treated unit before the intervention has no claim to track it after. Pre-period fit is the closest thing to a testable condition this design has, and it is a necessary condition rather than a sufficient one: a good pre-fit can still be a coincidence, especially with a short pre-period and many donors. Report the pre-period root-mean-square prediction error, and compare it with the same quantity for placebo units. A treated unit whose post/pre error ratio is unremarkable among the placebos has not shown an effect.\",\"kind\":\"assumption\",\"one_liner\":\"The weighted combination of untreated units reproduces the treated unit's pre-period path closely enough to stand in for it afterwards.\",\"plain_language\":\"The weighted combination of untreated units reproduces the treated unit's pre-period path closely enough to stand in for it afterwards.\",\"references\":[\"Abadie, Diamond & Hainmueller (2010)\",\"Abadie (2021), Using synthetic controls\"],\"see_also\":[{\"explain_key\":\"assumption.convex_hull\",\"explains\":\"The treated unit's characteristics can be written as a weighted average of the donors', with weights that do not go negative.\",\"id\":\"convex_hull\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Treated unit inside the donor convex hull\",\"worry_when\":\"The treated unit is at an extreme of the donor distribution on the predictors, or the pre-period gap has a persistent level offset.\"},{\"explain_key\":\"diagnostic.sc_placebo\",\"id\":\"diagnostic.sc_placebo\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"Re-run the whole method pretending each donor was the treated unit. If many donors show a gap as large, the real one is unremarkable.\",\"title\":\"Synthetic control placebos\"},{\"explain_key\":\"method.sc.abadie\",\"id\":\"sc.abadie\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Build a weighted copy of the treated place out of untreated places that looked like it beforehand, then watch the two lines separate.\",\"title\":\"Synthetic control\"},{\"explain_key\":\"design.synth\",\"id\":\"synth\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"One treated unit; build a comparison from a donor pool.\",\"title\":\"One place, constructed twin\"},{\"explain_key\":\"diagnostic.sc_gap\",\"id\":\"sc_gap\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Treated minus synthetic gap\"},{\"explain_key\":\"diagnostic.sc_loo\",\"id\":\"sc_loo\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Leave one donor out\"},{\"explain_key\":\"diagnostic.sc_mc_rank\",\"id\":\"sc_mc_rank\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Matrix-completion rank\"},{\"explain_key\":\"diagnostic.sc_placebo_space\",\"id\":\"sc_placebo_space\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Placebo in space\"}],\"starts_as\":\"untested\",\"tags\":[\"One place, constructed twin\"],\"title\":\"Pre-treatment fit from the donor pool\",\"worry_when\":\"Visible pre-period gaps; a short pre-period relative to the number of donors; one donor carrying most of the weight.\"},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"assumption:donor_fit\",\"kind\":\"assumption\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"donor_fit\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"The weighted combination of untreated units reproduces the treated unit's pre-period path closely enough to stand in for it afterwards.\",\"title\":\"Pre-treatment fit from the donor pool\"}" .
<urn:capy:assumption%3Aexchangeability> a capy:assumption ; skos:prefLabel "Exchangeability / no unmeasured confounding" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"assumption:exchangeability\",\"citation_ids\":[],\"citations\":[],\"content\":{\"checks\":[{\"explain_key\":\"diagnostic.covariate_balance\",\"id\":\"covariate_balance\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Covariate balance\"},{\"explain_key\":\"diagnostic.ebal_convergence\",\"id\":\"ebal_convergence\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Moment balance\"},{\"explain_key\":\"diagnostic.evalue\",\"id\":\"evalue\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"E-value\"},{\"explain_key\":\"diagnostic.evalue_scale\",\"id\":\"evalue_scale\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"E-value scale\"},{\"explain_key\":\"diagnostic.extreme_confounder\",\"id\":\"extreme_confounder\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Confounder strength needed to explain the estimate\"},{\"explain_key\":\"diagnostic.love\",\"id\":\"love\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Covariate balance (Love plot)\"},{\"explain_key\":\"diagnostic.negative_control\",\"id\":\"negative_control\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Negative control\"},{\"explain_key\":\"diagnostic.oster_assumptions\",\"id\":\"oster_assumptions\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Oster's assumptions\"},{\"explain_key\":\"diagnostic.oster_delta\",\"id\":\"oster_delta\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Oster delta\"},{\"explain_key\":\"diagnostic.placebo_outcome\",\"id\":\"placebo_outcome\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Placebo outcome\"},{\"explain_key\":\"diagnostic.placebo_treatment\",\"id\":\"placebo_treatment\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Placebo treatment\"},{\"explain_key\":\"diagnostic.random_common_cause\",\"id\":\"random_common_cause\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Random common cause\"},{\"explain_key\":\"diagnostic.robustness_value\",\"id\":\"robustness_value\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Robustness value\"},{\"explain_key\":\"diagnostic.rosenbaum_bounds\",\"id\":\"rosenbaum_bounds\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Rosenbaum bounds\"},{\"explain_key\":\"diagnostic.unobserved_confounder\",\"id\":\"unobserved_confounder\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Simulated unobserved confounder\"},{\"explain_key\":\"diagnostic.weighted_balance\",\"id\":\"weighted_balance\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Balance after weighting\"}],\"common_mistake\":\"Reading \\\"balance achieved\\\" as \\\"confounding removed\\\". Balance is about the covariates in the model; confounding is about the ones that are not.\",\"designs\":[{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"},{\"explain_key\":\"design.longitudinal\",\"id\":\"longitudinal\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"The same person is treated, untreated, treated again; confounders also move.\",\"title\":\"Treatment that changes over time\"},{\"explain_key\":\"design.mediation\",\"id\":\"mediation\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"We care about a mediator, not only the total effect.\",\"title\":\"How it worked (pathways)\"},{\"explain_key\":\"design.survival\",\"id\":\"survival\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Follow people from a common time zero; some leave follow-up before the event is observed.\",\"title\":\"Time until an event\"}],\"explain_key\":\"assumption.exchangeability\",\"gaps\":[],\"id\":\"exchangeability\",\"in_more_depth\":\"This is the assumption the whole selection-on-observables design rests on, and no diagnostic in this product can test it. Balance plots show that the variables you measured are now comparable; they say nothing about the ones you did not measure. A perfectly flat Love plot is consistent with total confounding by something you never recorded. What you can do instead: argue from how treatment was actually assigned, draw the graph and see whether your adjustment set closes the back doors, and then ask the sensitivity question -- how strong would an unmeasured confounder have to be, compared with the ones you did measure, before the conclusion changes?\",\"kind\":\"assumption\",\"one_liner\":\"Treated and untreated units are comparable once you condition on the confounders you measured. Everything that pushed people towards treatment and also moves the outcome is in your adjustment set.\",\"plain_language\":\"Treated and untreated units are comparable once you condition on the confounders you measured. Everything that pushed people towards treatment and also moves the outcome is in your adjustment set.\",\"references\":[\"Hernán & Robins (2020), Causal Inference: What If, ch. 3\",\"Cinelli & Hazlett (2020), Making sense of sensitivity\"],\"see_also\":[{\"explain_key\":\"assumption.positivity\",\"explains\":\"Every kind of unit had some chance of being treated and some chance of not being treated. Where that fails, there is no comparison to make and the model is inventing one.\",\"id\":\"positivity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Positivity / overlap\",\"worry_when\":\"Any single weight carries a large share of the total; the effective sample is far below the nominal one; the propensity model separates the arms almost perfectly; treated units sit outside the control group's range.\"},{\"explain_key\":\"concept.confounding\",\"id\":\"concept.confounding\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"A common cause of both the treatment and the outcome makes the two look related even when the treatment does nothing.\",\"title\":\"Confounding\"},{\"explain_key\":\"method.obs.aipw\",\"id\":\"obs.aipw\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Use a treatment model and an outcome model together; it is right if either one is.\",\"title\":\"Doubly robust (AIPW)\"},{\"explain_key\":\"diagnostic.love\",\"id\":\"love\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Covariate balance (Love plot)\"},{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"},{\"explain_key\":\"design.longitudinal\",\"id\":\"longitudinal\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"The same person is treated, untreated, treated again; confounders also move.\",\"title\":\"Treatment that changes over time\"},{\"explain_key\":\"design.mediation\",\"id\":\"mediation\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"We care about a mediator, not only the total effect.\",\"title\":\"How it worked (pathways)\"},{\"explain_key\":\"design.survival\",\"id\":\"survival\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Follow people from a common time zero; some leave follow-up before the event is observed.\",\"title\":\"Time until an event\"},{\"explain_key\":\"diagnostic.covariate_balance\",\"id\":\"covariate_balance\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Covariate balance\"},{\"explain_key\":\"diagnostic.ebal_convergence\",\"id\":\"ebal_convergence\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Moment balance\"},{\"explain_key\":\"diagnostic.evalue\",\"id\":\"evalue\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"E-value\"},{\"explain_key\":\"diagnostic.evalue_scale\",\"id\":\"evalue_scale\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"E-value scale\"}],\"starts_as\":\"untested\",\"tags\":[\"Adjust for background differences\",\"Treatment that changes over time\",\"How it worked (pathways)\",\"Time until an event\"],\"title\":\"Exchangeability / no unmeasured confounding\",\"worry_when\":\"Treatment was chosen by people who knew something about the likely outcome that you do not observe. Clinical judgement, self-selection into a programme, and administrative triage are the classic cases.\"},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"assumption:exchangeability\",\"kind\":\"assumption\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"exchangeability\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Treated and untreated units are comparable once you condition on the confounders you measured. Everything that pushed people towards treatment and also moves the outcome is in your adjustment set.\",\"title\":\"Exchangeability / no unmeasured confounding\"}" .
<urn:capy:assumption%3Aexclusion> a capy:assumption ; skos:prefLabel "Exclusion restriction" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"assumption:exclusion\",\"citation_ids\":[],\"citations\":[],\"content\":{\"checks\":[{\"explain_key\":\"diagnostic.overid\",\"id\":\"overid\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Overidentification test\"},{\"explain_key\":\"diagnostic.placebo_reduced_form\",\"id\":\"placebo_reduced_form\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Placebo reduced form\"},{\"explain_key\":\"diagnostic.reduced_form\",\"id\":\"reduced_form\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Reduced form\"}],\"common_mistake\":\"Treating a passed overidentification test as evidence for exclusion. It tests whether your instruments agree, not whether they are right.\",\"designs\":[{\"explain_key\":\"design.iv\",\"id\":\"iv\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"An instrument or encouragement changed treatment, not the outcome directly.\",\"title\":\"Something else pushed people in\"}],\"explain_key\":\"assumption.exclusion\",\"gaps\":[],\"id\":\"exclusion\",\"in_more_depth\":\"Exclusion cannot be tested. A strong first stage tells you the instrument moves treatment; it tells you nothing about whether it also moves the outcome another way. Overidentification tests compare instruments against each other and are silent when all of them are invalid in the same direction. What you can do: argue from how the instrument was generated, and look for placebo outcomes the instrument should not affect. Finding an effect there is evidence against exclusion; finding none is weak comfort.\",\"kind\":\"assumption\",\"one_liner\":\"The instrument affects the outcome only through the treatment. On the board, that is the arrow you did not draw.\",\"plain_language\":\"The instrument affects the outcome only through the treatment. On the board, that is the arrow you did not draw.\",\"references\":[\"Angrist, Imbens & Rubin (1996)\",\"Conley, Hansen & Rossi (2012), Plausibly exogenous\"],\"see_also\":[{\"explain_key\":\"assumption.monotonicity\",\"explains\":\"The instrument pushes everyone the same way, or not at all. Nobody takes the treatment only because they were discouraged from it.\",\"id\":\"monotonicity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Monotonicity / no defiers\",\"worry_when\":\"The instrument is an incentive that could plausibly backfire for some people, or it is a judge or examiner whose leniency ordering differs across case types.\"},{\"explain_key\":\"assumption.relevance\",\"explains\":\"The instrument actually moves treatment, and moves it enough that the resulting estimate is not mostly noise.\",\"id\":\"relevance\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Instrument relevance\",\"worry_when\":\"An effective F below about 10; a first-stage coefficient that is substantively tiny even if statistically significant; many instruments.\"},{\"acronym\":\"LATE\",\"explain_key\":\"estimand.late\",\"id\":\"LATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who only got it because of the instrument or the cutoff, what did it do?\",\"title\":\"Local average treatment effect\"},{\"explain_key\":\"diagnostic.overid\",\"id\":\"overid\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Overidentification test\"},{\"explain_key\":\"design.iv\",\"id\":\"iv\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"An instrument or encouragement changed treatment, not the outcome directly.\",\"title\":\"Something else pushed people in\"},{\"explain_key\":\"diagnostic.placebo_reduced_form\",\"id\":\"placebo_reduced_form\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Placebo reduced form\"},{\"explain_key\":\"diagnostic.reduced_form\",\"id\":\"reduced_form\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Reduced form\"}],\"starts_as\":\"assumed\",\"tags\":[\"Something else pushed people in\"],\"title\":\"Exclusion restriction\",\"worry_when\":\"The instrument is a policy that changed several things at once; it is correlated with geography, time or institutions that have their own effects; it was chosen because it predicted the outcome.\"},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"assumption:exclusion\",\"kind\":\"assumption\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"exclusion\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"The instrument affects the outcome only through the treatment. On the board, that is the arrow you did not draw.\",\"title\":\"Exclusion restriction\"}" .
<urn:capy:assumption%3Amodel_form> a capy:assumption ; skos:prefLabel "Functional form of the counterfactual trend" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"assumption:model_form\",\"citation_ids\":[],\"citations\":[],\"content\":{\"checks\":[{\"explain_key\":\"diagnostic.its_autocorrelation\",\"id\":\"its_autocorrelation\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Residual autocorrelation\"},{\"explain_key\":\"diagnostic.its_counterfactual\",\"id\":\"its_counterfactual\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Counterfactual projection\"},{\"explain_key\":\"diagnostic.its_model_choice\",\"id\":\"its_model_choice\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Model choice\"},{\"explain_key\":\"diagnostic.its_pre_period\",\"id\":\"its_pre_period\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Pre-period length\"},{\"explain_key\":\"diagnostic.its_seasonality\",\"id\":\"its_seasonality\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Seasonality\"},{\"explain_key\":\"diagnostic.its_series\",\"id\":\"its_series\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"The series and the interruption\"}],\"common_mistake\":null,\"designs\":[{\"explain_key\":\"design.its\",\"id\":\"its\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Before versus after an interruption; maybe a control series.\",\"title\":\"A shock in a single series\"}],\"explain_key\":\"assumption.model_form\",\"gaps\":[],\"id\":\"model_form\",\"in_more_depth\":\"This is an assumption, not an estimate, and it is doing more work than any coefficient in the model. A linear pre-trend extrapolated over several years is a strong claim. Seasonality, mean reversion after an unusual year, and slow-moving demographics all bend the counterfactual. Autocorrelated residuals are the standard failure: ordinary standard errors then understate uncertainty badly, sometimes by a factor of two or three.\",\"kind\":\"assumption\",\"one_liner\":\"The line you fit before the interruption is the line the outcome would have continued to follow.\",\"plain_language\":\"The line you fit before the interruption is the line the outcome would have continued to follow.\",\"references\":[\"Bernal et al. (2017)\",\"Brodersen et al. (2015), Inferring causal impact\"],\"see_also\":[{\"explain_key\":\"diagnostic.its_autocorrelation\",\"id\":\"its_autocorrelation\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Residual autocorrelation\"},{\"explain_key\":\"assumption.no_cointerventions\",\"explains\":\"Nothing else changed at the same moment that also moves the outcome.\",\"id\":\"no_cointerventions\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No co-interventions at the interruption\",\"worry_when\":\"A busy policy period; a national event at the same date; a change in how the outcome was measured or coded at the same date.\"},{\"explain_key\":\"design.its\",\"id\":\"its\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Before versus after an interruption; maybe a control series.\",\"title\":\"A shock in a single series\"},{\"explain_key\":\"diagnostic.its_counterfactual\",\"id\":\"its_counterfactual\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Counterfactual projection\"},{\"explain_key\":\"diagnostic.its_model_choice\",\"id\":\"its_model_choice\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Model choice\"},{\"explain_key\":\"diagnostic.its_pre_period\",\"id\":\"its_pre_period\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Pre-period length\"}],\"starts_as\":\"assumed\",\"tags\":[\"A shock in a single series\"],\"title\":\"Functional form of the counterfactual trend\",\"worry_when\":\"Few pre-period points; residual autocorrelation that survives the model; the estimate flips when you add a seasonal term or a quadratic trend.\"},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"assumption:model_form\",\"kind\":\"assumption\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"model_form\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"The line you fit before the interruption is the line the outcome would have continued to follow.\",\"title\":\"Functional form of the counterfactual trend\"}" .
<urn:capy:assumption%3Amonotonicity> a capy:assumption ; skos:prefLabel "Monotonicity / no defiers" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"assumption:monotonicity\",\"citation_ids\":[],\"citations\":[],\"content\":{\"checks\":[{\"explain_key\":\"diagnostic.compliance\",\"id\":\"compliance\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Compliance with assignment\"},{\"explain_key\":\"diagnostic.compliers\",\"id\":\"compliers\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Complier share\"}],\"common_mistake\":null,\"designs\":[{\"explain_key\":\"design.iv\",\"id\":\"iv\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"An instrument or encouragement changed treatment, not the outcome directly.\",\"title\":\"Something else pushed people in\"}],\"explain_key\":\"assumption.monotonicity\",\"gaps\":[],\"id\":\"monotonicity\",\"in_more_depth\":\"Without monotonicity, the instrumental-variables estimate is a mixture of compliers' and defiers' effects with weights that can be negative, and it need not lie between the effects of any real group. Monotonicity is what makes the estimate a local average treatment effect on compliers. It is not testable, though the implied complier share and the proportions of each response type give a sanity check: a negative implied share is evidence something is wrong.\",\"kind\":\"assumption\",\"one_liner\":\"The instrument pushes everyone the same way, or not at all. Nobody takes the treatment only because they were discouraged from it.\",\"plain_language\":\"The instrument pushes everyone the same way, or not at all. Nobody takes the treatment only because they were discouraged from it.\",\"references\":[\"Imbens & Angrist (1994)\",\"Mogstad, Torgovitsky & Walters (2021)\"],\"see_also\":[{\"explain_key\":\"assumption.exclusion\",\"explains\":\"The instrument affects the outcome only through the treatment. On the board, that is the arrow you did not draw.\",\"id\":\"exclusion\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Exclusion restriction\",\"worry_when\":\"The instrument is a policy that changed several things at once; it is correlated with geography, time or institutions that have their own effects; it was chosen because it predicted the outcome.\"},{\"acronym\":\"LATE\",\"explain_key\":\"estimand.late\",\"id\":\"LATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who only got it because of the instrument or the cutoff, what did it do?\",\"title\":\"Local average treatment effect\"},{\"acronym\":\"CACE\",\"explain_key\":\"estimand.cace\",\"id\":\"CACE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For the people who comply with what they were offered, what did it do?\",\"title\":\"Complier average causal effect\"},{\"explain_key\":\"design.iv\",\"id\":\"iv\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"An instrument or encouragement changed treatment, not the outcome directly.\",\"title\":\"Something else pushed people in\"},{\"explain_key\":\"diagnostic.compliance\",\"id\":\"compliance\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Compliance with assignment\"},{\"explain_key\":\"diagnostic.compliers\",\"id\":\"compliers\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Complier share\"}],\"starts_as\":\"assumed\",\"tags\":[\"Something else pushed people in\"],\"title\":\"Monotonicity / no defiers\",\"worry_when\":\"The instrument is an incentive that could plausibly backfire for some people, or it is a judge or examiner whose leniency ordering differs across case types.\"},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"assumption:monotonicity\",\"kind\":\"assumption\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"monotonicity\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"The instrument pushes everyone the same way, or not at all. Nobody takes the treatment only because they were discouraged from it.\",\"title\":\"Monotonicity / no defiers\"}" .
<urn:capy:assumption%3Ano_anticipation> a capy:assumption ; skos:prefLabel "No anticipation" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"assumption:no_anticipation\",\"citation_ids\":[],\"citations\":[],\"content\":{\"checks\":[{\"explain_key\":\"diagnostic.sc_placebo_time\",\"id\":\"sc_placebo_time\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Placebo in time\"}],\"common_mistake\":null,\"designs\":[{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"},{\"explain_key\":\"design.its\",\"id\":\"its\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Before versus after an interruption; maybe a control series.\",\"title\":\"A shock in a single series\"},{\"explain_key\":\"design.synth\",\"id\":\"synth\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"One treated unit; build a comparison from a donor pool.\",\"title\":\"One place, constructed twin\"}],\"explain_key\":\"assumption.no_anticipation\",\"gaps\":[],\"id\":\"no_anticipation\",\"in_more_depth\":\"Announcement usually precedes implementation, and people respond to announcements. If they do, the \\\"before\\\" period is already partly treated, which biases the comparison and can make the pre-trend look wrong even when parallel trends holds. The pre-period coefficients of an event study are where anticipation shows up: a drift starting exactly at the announcement date is the signature. Interrupted-time-series designs let you mark announcement and implementation as two separate dates for this reason.\",\"kind\":\"assumption\",\"one_liner\":\"Units did not change behaviour before treatment arrived because they knew it was coming.\",\"plain_language\":\"Units did not change behaviour before treatment arrived because they knew it was coming.\",\"references\":[\"Malani & Reif (2015), Interpreting pre-trends as anticipation\"],\"see_also\":[{\"explain_key\":\"assumption.parallel_trends\",\"explains\":\"Without the policy, treated and comparison groups would have moved the same way. Not that they were at the same level -- that their paths would have been parallel.\",\"id\":\"parallel_trends\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Parallel trends\",\"worry_when\":\"Pre-period event-study coefficients drift away from zero; the policy was adopted because outcomes were already moving; the groups differ in composition in ways that interact with time.\"},{\"explain_key\":\"diagnostic.event_study\",\"id\":\"event_study\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Event study\"},{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"},{\"explain_key\":\"design.its\",\"id\":\"its\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Before versus after an interruption; maybe a control series.\",\"title\":\"A shock in a single series\"},{\"explain_key\":\"design.synth\",\"id\":\"synth\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"One treated unit; build a comparison from a donor pool.\",\"title\":\"One place, constructed twin\"},{\"explain_key\":\"diagnostic.sc_placebo_time\",\"id\":\"sc_placebo_time\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Placebo in time\"}],\"starts_as\":\"untested\",\"tags\":[\"Policy rolled out over time\",\"A shock in a single series\",\"One place, constructed twin\"],\"title\":\"No anticipation\",\"worry_when\":\"There was a public announcement well before the policy started, or the pre-period coefficients move in the period immediately before adoption.\"},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"assumption:no_anticipation\",\"kind\":\"assumption\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"no_anticipation\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Units did not change behaviour before treatment arrived because they knew it was coming.\",\"title\":\"No anticipation\"}" .
<urn:capy:assumption%3Ano_cointerventions> a capy:assumption ; skos:prefLabel "No co-interventions at the interruption" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"assumption:no_cointerventions\",\"citation_ids\":[],\"citations\":[],\"content\":{\"checks\":[{\"explain_key\":\"diagnostic.its_control_shock\",\"id\":\"its_control_shock\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Control series at the interruption\"}],\"common_mistake\":null,\"designs\":[{\"explain_key\":\"design.its\",\"id\":\"its\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Before versus after an interruption; maybe a control series.\",\"title\":\"A shock in a single series\"}],\"explain_key\":\"assumption.no_cointerventions\",\"gaps\":[],\"id\":\"no_cointerventions\",\"in_more_depth\":\"An interrupted time series attributes the whole break to the policy. Policy rarely arrives alone: a smoking ban lands with a media campaign, a lockdown with a benefits change, a guideline with a payment reform. Any of those would produce the same picture. A control series that should have been unaffected is the main defence. If the control breaks at the same moment, something broader happened.\",\"kind\":\"assumption\",\"one_liner\":\"Nothing else changed at the same moment that also moves the outcome.\",\"plain_language\":\"Nothing else changed at the same moment that also moves the outcome.\",\"references\":[\"Bernal, Cummins & Gasparrini (2017), Interrupted time series regression\"],\"see_also\":[{\"explain_key\":\"assumption.model_form\",\"explains\":\"The line you fit before the interruption is the line the outcome would have continued to follow.\",\"id\":\"model_form\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Functional form of the counterfactual trend\",\"worry_when\":\"Few pre-period points; residual autocorrelation that survives the model; the estimate flips when you add a seasonal term or a quadratic trend.\"},{\"explain_key\":\"method.its.controlled\",\"id\":\"its.controlled\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"The same interruption, measured against a series the intervention did not touch, so a shock that hit everybody is not booked as your effect.\",\"title\":\"Controlled ITS\"},{\"explain_key\":\"design.its\",\"id\":\"its\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Before versus after an interruption; maybe a control series.\",\"title\":\"A shock in a single series\"},{\"explain_key\":\"diagnostic.its_control_shock\",\"id\":\"its_control_shock\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Control series at the interruption\"}],\"starts_as\":\"assumed\",\"tags\":[\"A shock in a single series\"],\"title\":\"No co-interventions at the interruption\",\"worry_when\":\"A busy policy period; a national event at the same date; a change in how the outcome was measured or coded at the same date.\"},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"assumption:no_cointerventions\",\"kind\":\"assumption\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"no_cointerventions\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Nothing else changed at the same moment that also moves the outcome.\",\"title\":\"No co-interventions at the interruption\"}" .
<urn:capy:assumption%3Ano_manipulation> a capy:assumption ; skos:prefLabel "No manipulation of the running variable" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"assumption:no_manipulation\",\"citation_ids\":[],\"citations\":[],\"content\":{\"checks\":[{\"explain_key\":\"diagnostic.manipulation\",\"id\":\"manipulation\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Density at the cutoff\"}],\"common_mistake\":null,\"designs\":[{\"explain_key\":\"design.rd\",\"id\":\"rd\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Crossing a score, age, or border switched the programme on.\",\"title\":\"A cutoff decided eligibility\"}],\"explain_key\":\"assumption.no_manipulation\",\"gaps\":[],\"id\":\"no_manipulation\",\"in_more_depth\":\"Regression discontinuity works because, right at the cutoff, which side you fall on is as good as random. That fails if people can fine-tune their score: applicants who just miss a threshold and resubmit, firms that report just under a reporting limit, students whose marks get nudged over a pass line. The density test is the standard check: if there is a cliff in the number of units just either side of the cutoff, someone was sorting. A smooth density does not prove there was no manipulation, but a jump is strong evidence there was. Covariate balance at the cutoff is the second check: pre-determined characteristics should not jump.\",\"kind\":\"assumption\",\"one_liner\":\"People could not precisely control which side of the cutoff they landed on.\",\"plain_language\":\"People could not precisely control which side of the cutoff they landed on.\",\"references\":[\"McCrary (2008), Manipulation of the running variable\",\"Cattaneo, Jansson & Ma (2020), Simple local polynomial density estimators\"],\"see_also\":[{\"explain_key\":\"diagnostic.rd_density\",\"id\":\"diagnostic.rd_density\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"The number of units just either side of the threshold. A cliff means somebody was sorting.\",\"title\":\"Density at the cutoff\"},{\"explain_key\":\"assumption.continuity\",\"explains\":\"Everything else that affects the outcome changes smoothly through the cutoff, so the only thing that jumps is the treatment.\",\"id\":\"continuity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Continuity of potential outcomes at the cutoff\",\"worry_when\":\"Several rules share the threshold; the running variable is coarse, so \\\"at the cutoff\\\" is really a wide band; the estimate depends heavily on the bandwidth.\"},{\"explain_key\":\"method.rd.local_linear\",\"id\":\"rd.local_linear\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Fit a line either side of the threshold and measure the step between them.\",\"title\":\"Sharp RD at the cutoff\"},{\"explain_key\":\"design.rd\",\"id\":\"rd\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Crossing a score, age, or border switched the programme on.\",\"title\":\"A cutoff decided eligibility\"},{\"explain_key\":\"diagnostic.manipulation\",\"id\":\"manipulation\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Density at the cutoff\"}],\"starts_as\":\"untested\",\"tags\":[\"A cutoff decided eligibility\"],\"title\":\"No manipulation of the running variable\",\"worry_when\":\"A visible spike or gap in the density at the cutoff; covariates that jump; a cutoff that people knew about and had time to respond to.\"},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"assumption:no_manipulation\",\"kind\":\"assumption\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"no_manipulation\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"People could not precisely control which side of the cutoff they landed on.\",\"title\":\"No manipulation of the running variable\"}" .
<urn:capy:assumption%3Ano_time_varying_confounding> a capy:assumption ; skos:prefLabel "No unmeasured time-varying confounding" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"assumption:no_time_varying_confounding\",\"citation_ids\":[],\"citations\":[],\"content\":{\"checks\":[{\"explain_key\":\"diagnostic.censoring_weights\",\"id\":\"censoring_weights\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Censoring weights\"},{\"explain_key\":\"diagnostic.natural_course\",\"id\":\"natural_course\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Natural-course calibration\"},{\"explain_key\":\"diagnostic.person_time\",\"id\":\"person_time\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Person-time and switching\"},{\"explain_key\":\"diagnostic.temporal_ordering\",\"id\":\"temporal_ordering\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Temporal ordering of covariates\"}],\"common_mistake\":null,\"designs\":[{\"explain_key\":\"design.longitudinal\",\"id\":\"longitudinal\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"The same person is treated, untreated, treated again; confounders also move.\",\"title\":\"Treatment that changes over time\"}],\"explain_key\":\"assumption.no_time_varying_confounding\",\"gaps\":[],\"id\":\"no_time_varying_confounding\",\"in_more_depth\":\"In longitudinal data the same variable is often a confounder for later treatment and a consequence of earlier treatment. Adjusting for it in an ordinary regression both blocks the path you want and opens a collider path; not adjusting for it leaves confounding. This is precisely the problem g-methods were invented for. Lag discipline is the practical form of this assumption: a covariate may adjust a treatment decision only if it was measured before that decision. The board draws arrows that cannot point into the future for this reason.\",\"kind\":\"assumption\",\"one_liner\":\"At every period, the things that drive the treatment decision and also affect the outcome are measured -- and measured before that decision.\",\"plain_language\":\"At every period, the things that drive the treatment decision and also affect the outcome are measured -- and measured before that decision.\",\"references\":[\"Robins (1986)\",\"Hernán, Brumback & Robins (2000), Marginal structural models\"],\"see_also\":[{\"explain_key\":\"method.long.msm_iptw\",\"id\":\"long.msm_iptw\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Reweight each person-period so the treated and untreated histories look alike, then fit one simple model to the reweighted data.\",\"title\":\"Marginal structural model (time-varying weights)\"},{\"explain_key\":\"method.long.gformula\",\"id\":\"long.gformula\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Model each period in turn, then simulate the world where everyone followed the strategy you name.\",\"title\":\"Parametric g-formula\"},{\"explain_key\":\"concept.time_varying_confounding\",\"id\":\"concept.time_varying_confounding\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"A variable that is both a consequence of past treatment and a cause of future treatment. Ordinary regression cannot handle it; g-methods can.\",\"title\":\"Time-varying confounding\"},{\"explain_key\":\"design.longitudinal\",\"id\":\"longitudinal\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"The same person is treated, untreated, treated again; confounders also move.\",\"title\":\"Treatment that changes over time\"},{\"explain_key\":\"diagnostic.censoring_weights\",\"id\":\"censoring_weights\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Censoring weights\"},{\"explain_key\":\"diagnostic.natural_course\",\"id\":\"natural_course\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Natural-course calibration\"},{\"explain_key\":\"diagnostic.person_time\",\"id\":\"person_time\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Person-time and switching\"},{\"explain_key\":\"diagnostic.temporal_ordering\",\"id\":\"temporal_ordering\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Temporal ordering of covariates\"}],\"starts_as\":\"untested\",\"tags\":[\"Treatment that changes over time\"],\"title\":\"No unmeasured time-varying confounding\",\"worry_when\":\"Clinical measurements taken after the dose was changed; employment status recorded at the end of a period used to explain treatment at its start.\"},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"assumption:no_time_varying_confounding\",\"kind\":\"assumption\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"no_time_varying_confounding\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"At every period, the things that drive the treatment decision and also affect the outcome are measured -- and measured before that decision.\",\"title\":\"No unmeasured time-varying confounding\"}" .
<urn:capy:assumption%3Aparallel_trends> a capy:assumption ; skos:prefLabel "Parallel trends" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"assumption:parallel_trends\",\"citation_ids\":[],\"citations\":[],\"content\":{\"checks\":[{\"explain_key\":\"diagnostic.adoption\",\"id\":\"adoption\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Adoption pattern\"},{\"explain_key\":\"diagnostic.bacon_decomposition\",\"id\":\"bacon_decomposition\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Goodman-Bacon decomposition\"},{\"explain_key\":\"diagnostic.cell_means\",\"id\":\"cell_means\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Cell means\"},{\"explain_key\":\"diagnostic.cohort_att\",\"id\":\"cohort_att\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Cohort effects\"},{\"explain_key\":\"diagnostic.cohort_interactions\",\"id\":\"cohort_interactions\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Cohort-by-period interactions\"},{\"explain_key\":\"diagnostic.comparison_group\",\"id\":\"comparison_group\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Comparison group used\"},{\"explain_key\":\"diagnostic.event_study\",\"id\":\"event_study\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Event study\"},{\"explain_key\":\"diagnostic.group_time_att\",\"id\":\"group_time_att\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Group-time effects\"},{\"explain_key\":\"diagnostic.honest_did\",\"id\":\"honest_did\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Honest DiD breakdown value\"},{\"explain_key\":\"diagnostic.imputation_fit\",\"id\":\"imputation_fit\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Untreated-cell model fit\"},{\"explain_key\":\"diagnostic.pre_trend_size\",\"id\":\"pre_trend_size\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Size of the pre-trend\"},{\"explain_key\":\"diagnostic.pre_trends\",\"id\":\"pre_trends\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Pre-trend test\"},{\"explain_key\":\"diagnostic.raw_means\",\"id\":\"raw_means\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Raw means by cohort and period\"}],\"common_mistake\":\"Reading a pre-trend test that fails to reject as confirmation. Low power makes that easy, and a wide pre-period confidence interval is not evidence of parallel paths.\",\"designs\":[{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"}],\"explain_key\":\"assumption.parallel_trends\",\"gaps\":[],\"id\":\"parallel_trends\",\"in_more_depth\":\"This is the identifying assumption of difference-in-differences, and it is about a counterfactual path nobody observes. The pre-period is the closest thing to evidence: if the groups already moved differently before the policy, the assumption is in trouble. If they moved together, that is consistent with parallel trends and also consistent with them diverging afterwards for reasons unrelated to the policy. Parallel trends is also scale-dependent: trends parallel in levels are generally not parallel in logs. Choosing the scale is part of the assumption, not a presentation detail. When pre-trends are imperfect, honest DiD asks the useful question: how much could trends have drifted before the conclusion breaks?\",\"kind\":\"assumption\",\"one_liner\":\"Without the policy, treated and comparison groups would have moved the same way. Not that they were at the same level -- that their paths would have been parallel.\",\"plain_language\":\"Without the policy, treated and comparison groups would have moved the same way. Not that they were at the same level -- that their paths would have been parallel.\",\"references\":[\"Roth (2022), Pretest with caution\",\"Rambachan & Roth (2023), A more credible approach to parallel trends\"],\"see_also\":[{\"explain_key\":\"diagnostic.pre_trends\",\"id\":\"pre_trends\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Pre-trend test\"},{\"explain_key\":\"diagnostic.event_study\",\"id\":\"event_study\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Event study\"},{\"explain_key\":\"method.did.callaway_santanna\",\"id\":\"did.callaway_santanna\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Estimate one clean before-and-after for every adoption cohort, then say out loud how you averaged them.\",\"title\":\"Callaway & Sant'Anna group-time effects\"},{\"explain_key\":\"probe.honest_did\",\"id\":\"probe.honest_did\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"What survives when parallel trends is allowed to fail by a stated amount.\",\"title\":\"Honest DiD (Rambachan-Roth)\"},{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"},{\"explain_key\":\"diagnostic.adoption\",\"id\":\"adoption\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Adoption pattern\"},{\"explain_key\":\"diagnostic.bacon_decomposition\",\"id\":\"bacon_decomposition\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Goodman-Bacon decomposition\"},{\"explain_key\":\"diagnostic.cell_means\",\"id\":\"cell_means\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Cell means\"},{\"explain_key\":\"diagnostic.cohort_att\",\"id\":\"cohort_att\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Cohort effects\"}],\"starts_as\":\"untested\",\"tags\":[\"Policy rolled out over time\"],\"title\":\"Parallel trends\",\"worry_when\":\"Pre-period event-study coefficients drift away from zero; the policy was adopted because outcomes were already moving; the groups differ in composition in ways that interact with time.\"},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"assumption:parallel_trends\",\"kind\":\"assumption\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"parallel_trends\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Without the policy, treated and comparison groups would have moved the same way. Not that they were at the same level -- that their paths would have been parallel.\",\"title\":\"Parallel trends\"}" .
<urn:capy:assumption%3Apositivity> a capy:assumption ; skos:prefLabel "Positivity / overlap" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"assumption:positivity\",\"citation_ids\":[],\"citations\":[],\"content\":{\"checks\":[{\"explain_key\":\"diagnostic.cem_strata\",\"id\":\"cem_strata\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Coarsened strata and common support\"},{\"explain_key\":\"diagnostic.ess\",\"id\":\"ess\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Effective sample size\"},{\"explain_key\":\"diagnostic.model_reliance\",\"id\":\"model_reliance\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"How much the model is doing\"},{\"explain_key\":\"diagnostic.n_matched\",\"id\":\"n_matched\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Match quality\"},{\"explain_key\":\"diagnostic.overlap\",\"id\":\"overlap\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Overlap between the arms\"},{\"explain_key\":\"diagnostic.pair_quality\",\"id\":\"pair_quality\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Matched-pair quality\"},{\"explain_key\":\"diagnostic.positivity_by_period\",\"id\":\"positivity_by_period\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Positivity by period\"},{\"explain_key\":\"diagnostic.propensity_clipping\",\"id\":\"propensity_clipping\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Propensity clipping\"},{\"explain_key\":\"diagnostic.ps_calibration\",\"id\":\"ps_calibration\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Treatment-model calibration\"},{\"explain_key\":\"diagnostic.regime_support\",\"id\":\"regime_support\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Support for the intervention regime\"},{\"explain_key\":\"diagnostic.trim_cost\",\"id\":\"trim_cost\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"What trimming costs\"},{\"explain_key\":\"diagnostic.trim_stability\",\"id\":\"trim_stability\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Stability across trimming thresholds\"},{\"explain_key\":\"diagnostic.weights_by_period\",\"id\":\"weights_by_period\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Weights by period\"}],\"common_mistake\":\"Trimming to a default cutoff to make the plot look better. Trimming changes the population the estimate is about, so it belongs in the sample flow as a stated choice, and the Probe bench plots the estimate against the threshold rather than picking one for you.\",\"designs\":[{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"},{\"explain_key\":\"design.longitudinal\",\"id\":\"longitudinal\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"The same person is treated, untreated, treated again; confounders also move.\",\"title\":\"Treatment that changes over time\"},{\"explain_key\":\"design.mediation\",\"id\":\"mediation\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"We care about a mediator, not only the total effect.\",\"title\":\"How it worked (pathways)\"},{\"explain_key\":\"design.survival\",\"id\":\"survival\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Follow people from a common time zero; some leave follow-up before the event is observed.\",\"title\":\"Time until an event\"}],\"explain_key\":\"assumption.positivity\",\"gaps\":[],\"id\":\"positivity\",\"in_more_depth\":\"Positivity is the assumption you actually can look at. Fit a treatment model, plot the predicted probabilities by arm, and see whether the two distributions overlap. Where treated units sit at probabilities no control unit reaches, the estimate for those units comes from extrapolating the outcome model, not from anything in the data. The effective sample size is the honest denominator: reweighting a comparison group to look like the treated group can leave you with a thousand rows worth a hundred observations. Structural violations (a rule that made some group ineligible) cannot be fixed by any estimator. Random violations (a small sample in a thin region) show up as unstable weights.\",\"kind\":\"assumption\",\"one_liner\":\"Every kind of unit had some chance of being treated and some chance of not being treated. Where that fails, there is no comparison to make and the model is inventing one.\",\"plain_language\":\"Every kind of unit had some chance of being treated and some chance of not being treated. Where that fails, there is no comparison to make and the model is inventing one.\",\"references\":[\"Petersen et al. (2012), Diagnosing and responding to violations in the positivity assumption\",\"Crump et al. (2009), Dealing with limited overlap\"],\"see_also\":[{\"explain_key\":\"diagnostic.overlap\",\"id\":\"overlap\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Overlap between the arms\"},{\"explain_key\":\"diagnostic.ess\",\"id\":\"ess\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Effective sample size\"},{\"explain_key\":\"concept.effective_sample_size\",\"id\":\"concept.effective_sample_size\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"How many observations your weighted comparison is really worth. Almost always smaller than the number of rows, sometimes dramatically.\",\"title\":\"Effective sample size\"},{\"acronym\":\"ATO\",\"explain_key\":\"estimand.ato\",\"id\":\"ATO\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For the people where treated and untreated genuinely overlap, what did it do?\",\"title\":\"Average treatment effect on the overlap population\"},{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"},{\"explain_key\":\"design.longitudinal\",\"id\":\"longitudinal\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"The same person is treated, untreated, treated again; confounders also move.\",\"title\":\"Treatment that changes over time\"},{\"explain_key\":\"design.mediation\",\"id\":\"mediation\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"We care about a mediator, not only the total effect.\",\"title\":\"How it worked (pathways)\"},{\"explain_key\":\"design.survival\",\"id\":\"survival\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Follow people from a common time zero; some leave follow-up before the event is observed.\",\"title\":\"Time until an event\"},{\"explain_key\":\"diagnostic.cem_strata\",\"id\":\"cem_strata\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Coarsened strata and common support\"},{\"explain_key\":\"diagnostic.model_reliance\",\"id\":\"model_reliance\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"How much the model is doing\"},{\"explain_key\":\"diagnostic.n_matched\",\"id\":\"n_matched\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Match quality\"}],\"starts_as\":\"untested\",\"tags\":[\"Adjust for background differences\",\"Treatment that changes over time\",\"How it worked (pathways)\",\"Time until an event\"],\"title\":\"Positivity / overlap\",\"worry_when\":\"Any single weight carries a large share of the total; the effective sample is far below the nominal one; the propensity model separates the arms almost perfectly; treated units sit outside the control group's range.\"},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"assumption:positivity\",\"kind\":\"assumption\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"positivity\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Every kind of unit had some chance of being treated and some chance of not being treated. Where that fails, there is no comparison to make and the model is inventing one.\",\"title\":\"Positivity / overlap\"}" .
<urn:capy:assumption%3Arandomisation> a capy:assumption ; skos:prefLabel "Randomisation held" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"assumption:randomisation\",\"citation_ids\":[],\"citations\":[],\"content\":{\"checks\":[{\"explain_key\":\"diagnostic.baseline_balance\",\"id\":\"baseline_balance\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Baseline balance\"},{\"explain_key\":\"diagnostic.block_structure\",\"id\":\"block_structure\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Block structure\"},{\"explain_key\":\"diagnostic.block_weighting\",\"id\":\"block_weighting\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Block weights\"},{\"explain_key\":\"diagnostic.differential_attrition\",\"id\":\"differential_attrition\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Differential attrition\"},{\"explain_key\":\"diagnostic.permutation_distribution\",\"id\":\"permutation_distribution\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Randomisation distribution\"}],\"common_mistake\":\"Running a battery of balance tests and adjusting for whatever came out significant. That is a garden of forking paths, not a fix.\",\"designs\":[{\"explain_key\":\"design.rct\",\"id\":\"rct\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"People were assigned by chance, or as good as chance.\",\"title\":\"Randomised or as-if randomised\"}],\"explain_key\":\"assumption.randomisation\",\"gaps\":[],\"id\":\"randomisation\",\"in_more_depth\":\"In a clean experiment this is the assumption that does all the work, and it is the one you get for free. What is not free is what happened afterwards. Attrition that differs by arm, treatment received that differs from treatment assigned, and outcomes measured differently by arm all break the guarantee. A baseline balance table checks that nothing went wrong in the mechanics. It is not a test of randomisation: with enough covariates some will differ by chance, and a failed balance test on a genuinely randomised trial is a false alarm as often as a real signal.\",\"kind\":\"assumption\",\"one_liner\":\"Assignment really was by chance, and nothing after assignment broke the comparison -- no differential dropout, no crossover you have not modelled.\",\"plain_language\":\"Assignment really was by chance, and nothing after assignment broke the comparison -- no differential dropout, no crossover you have not modelled.\",\"references\":[\"Senn (1994), Testing for baseline balance\",\"Bruhn & McKenzie (2009)\"],\"see_also\":[{\"explain_key\":\"diagnostic.baseline_balance\",\"id\":\"baseline_balance\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Baseline balance\"},{\"acronym\":\"ITT\",\"explain_key\":\"estimand.itt\",\"id\":\"ITT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For everyone who was offered it, what did the offer do?\",\"title\":\"Intention to treat\"},{\"acronym\":\"CACE\",\"explain_key\":\"estimand.cace\",\"id\":\"CACE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For the people who comply with what they were offered, what did it do?\",\"title\":\"Complier average causal effect\"},{\"explain_key\":\"design.rct\",\"id\":\"rct\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"People were assigned by chance, or as good as chance.\",\"title\":\"Randomised or as-if randomised\"},{\"explain_key\":\"diagnostic.block_structure\",\"id\":\"block_structure\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Block structure\"},{\"explain_key\":\"diagnostic.block_weighting\",\"id\":\"block_weighting\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Block weights\"},{\"explain_key\":\"diagnostic.differential_attrition\",\"id\":\"differential_attrition\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Differential attrition\"}],\"starts_as\":\"assumed\",\"tags\":[\"Randomised or as-if randomised\"],\"title\":\"Randomisation held\",\"worry_when\":\"Dropout differs across arms; take-up is far from assignment; the randomiser was a person with discretion.\"},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"assumption:randomisation\",\"kind\":\"assumption\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"randomisation\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Assignment really was by chance, and nothing after assignment broke the comparison -- no differential dropout, no crossover you have not modelled.\",\"title\":\"Randomisation held\"}" .
<urn:capy:assumption%3Arelevance> a capy:assumption ; skos:prefLabel "Instrument relevance" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"assumption:relevance\",\"citation_ids\":[],\"citations\":[],\"content\":{\"checks\":[{\"explain_key\":\"diagnostic.first_stage\",\"id\":\"first_stage\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"First stage\"},{\"explain_key\":\"diagnostic.weak_iv_set\",\"id\":\"weak_iv_set\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Weak-instrument-robust set\"}],\"common_mistake\":\"Adding more instruments to raise the first-stage F. Many weak instruments make the bias worse, not better.\",\"designs\":[{\"explain_key\":\"design.iv\",\"id\":\"iv\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"An instrument or encouragement changed treatment, not the outcome directly.\",\"title\":\"Something else pushed people in\"}],\"explain_key\":\"assumption.relevance\",\"gaps\":[],\"id\":\"relevance\",\"in_more_depth\":\"This one is testable, and the test matters more than people expect. With a weak instrument, two-stage least squares is biased towards the ordinary least squares estimate and its confidence interval has far less than nominal coverage -- a 95% interval that covers the truth 60% of the time. Report the effective F statistic rather than the naive one when the errors are not homoskedastic, and when it is small, report a weak-instrument-robust confidence set instead of the usual interval. An unbounded set is sometimes the honest answer.\",\"kind\":\"assumption\",\"one_liner\":\"The instrument actually moves treatment, and moves it enough that the resulting estimate is not mostly noise.\",\"plain_language\":\"The instrument actually moves treatment, and moves it enough that the resulting estimate is not mostly noise.\",\"references\":[\"Olea & Pflueger (2013), A robust test for weak instruments\",\"Andrews, Stock & Sun (2019), Weak instruments in IV regression\"],\"see_also\":[{\"explain_key\":\"diagnostic.first_stage\",\"id\":\"first_stage\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"First stage\"},{\"explain_key\":\"diagnostic.weak_iv_set\",\"id\":\"weak_iv_set\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Weak-instrument-robust set\"},{\"explain_key\":\"method.iv.weak_robust\",\"id\":\"iv.weak_robust\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Report the set of effects the data cannot reject, which stays honest however weak the instrument is.\",\"title\":\"Weak-instrument-robust confidence set\"},{\"explain_key\":\"design.iv\",\"id\":\"iv\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"An instrument or encouragement changed treatment, not the outcome directly.\",\"title\":\"Something else pushed people in\"}],\"starts_as\":\"untested\",\"tags\":[\"Something else pushed people in\"],\"title\":\"Instrument relevance\",\"worry_when\":\"An effective F below about 10; a first-stage coefficient that is substantively tiny even if statistically significant; many instruments.\"},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"assumption:relevance\",\"kind\":\"assumption\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"relevance\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"The instrument actually moves treatment, and moves it enough that the resulting estimate is not mostly noise.\",\"title\":\"Instrument relevance\"}" .
<urn:capy:assumption%3Asequential_ignorability> a capy:assumption ; skos:prefLabel "Sequential ignorability" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"assumption:sequential_ignorability\",\"citation_ids\":[],\"citations\":[],\"content\":{\"checks\":[{\"explain_key\":\"diagnostic.cde_path\",\"id\":\"cde_path\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Controlled direct effect across mediator levels\"},{\"explain_key\":\"diagnostic.mediation_decomposition\",\"id\":\"mediation_decomposition\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Total = direct + indirect\"},{\"explain_key\":\"diagnostic.multiple_mediators\",\"id\":\"multiple_mediators\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Multiple mediators\"},{\"explain_key\":\"diagnostic.treatment_mediator_interaction\",\"id\":\"treatment_mediator_interaction\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Treatment-mediator interaction\"}],\"common_mistake\":\"Reporting a product-of-coefficients decomposition as \\\"the mechanism\\\" without stating either assumption.\",\"designs\":[{\"explain_key\":\"design.mediation\",\"id\":\"mediation\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"We care about a mediator, not only the total effect.\",\"title\":\"How it worked (pathways)\"},{\"explain_key\":\"design.longitudinal\",\"id\":\"longitudinal\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"The same person is treated, untreated, treated again; confounders also move.\",\"title\":\"Treatment that changes over time\"}],\"explain_key\":\"assumption.sequential_ignorability\",\"gaps\":[],\"id\":\"sequential_ignorability\",\"in_more_depth\":\"Mediation asks for two exchangeability assumptions instead of one, and the second is usually much harder: whatever determines how much of the mediator a person gets is rarely unrelated to their outcome. Randomising treatment does not randomise the mediator. Natural direct and indirect effects need a third, cross-world condition relating potential outcomes under treatment values that no single person can ever experience. No experiment, however large, can test it. That is why interventional (stochastic) effects are the better default in policy and health: they answer a slightly different question that a trial could in principle check.\",\"kind\":\"assumption\",\"one_liner\":\"No unmeasured confounding of the treatment-outcome relationship, and none of the mediator-outcome relationship either, even after conditioning on treatment.\",\"plain_language\":\"No unmeasured confounding of the treatment-outcome relationship, and none of the mediator-outcome relationship either, even after conditioning on treatment.\",\"references\":[\"VanderWeele (2015), Explanation in Causal Inference\",\"Robins & Greenland (1992), Identifiability and exchangeability for direct and indirect effects\"],\"see_also\":[{\"explain_key\":\"method.med.interventional\",\"id\":\"med.interventional\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Shift the mediator to the distribution it would have in the population, rather than to each person's own unobservable counterfactual.\",\"title\":\"Interventional direct and indirect effects\"},{\"explain_key\":\"method.med.natural_effects\",\"id\":\"med.natural_effects\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Split the total effect into the part that travelled through the mediator and the part that did not.\",\"title\":\"Natural direct and indirect effects\"},{\"explain_key\":\"concept.cross_world\",\"id\":\"concept.cross_world\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"A condition relating outcomes under treatment and mediator values that no single person could ever experience together. Not testable, even in principle.\",\"title\":\"Cross-world assumptions\"},{\"explain_key\":\"design.mediation\",\"id\":\"mediation\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"We care about a mediator, not only the total effect.\",\"title\":\"How it worked (pathways)\"},{\"explain_key\":\"design.longitudinal\",\"id\":\"longitudinal\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"The same person is treated, untreated, treated again; confounders also move.\",\"title\":\"Treatment that changes over time\"},{\"explain_key\":\"diagnostic.cde_path\",\"id\":\"cde_path\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Controlled direct effect across mediator levels\"},{\"explain_key\":\"diagnostic.mediation_decomposition\",\"id\":\"mediation_decomposition\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Total = direct + indirect\"},{\"explain_key\":\"diagnostic.multiple_mediators\",\"id\":\"multiple_mediators\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Multiple mediators\"},{\"explain_key\":\"diagnostic.treatment_mediator_interaction\",\"id\":\"treatment_mediator_interaction\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Treatment-mediator interaction\"}],\"starts_as\":\"assumed\",\"tags\":[\"How it worked (pathways)\",\"Treatment that changes over time\"],\"title\":\"Sequential ignorability\",\"worry_when\":\"There is a variable affected by treatment that also confounds the mediator-outcome relationship. Under that structure the natural effects are not identified at all.\"},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"assumption:sequential_ignorability\",\"kind\":\"assumption\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"sequential_ignorability\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"No unmeasured confounding of the treatment-outcome relationship, and none of the mediator-outcome relationship either, even after conditioning on treatment.\",\"title\":\"Sequential ignorability\"}" .
<urn:capy:assumption%3Asurvival_consistency> a capy:assumption ; skos:prefLabel "Consistency / well-defined baseline intervention" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"assumption:survival_consistency\",\"citation_ids\":[],\"citations\":[],\"content\":{\"checks\":[],\"common_mistake\":null,\"designs\":[{\"explain_key\":\"design.survival\",\"id\":\"survival\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Follow people from a common time zero; some leave follow-up before the event is observed.\",\"title\":\"Time until an event\"}],\"explain_key\":\"assumption.survival_consistency\",\"gaps\":[\"no check in the app speaks to this one, so it can only be argued for\"],\"id\":\"survival_consistency\",\"in_more_depth\":\"Define the treatment strategy, event, time zero and duration unit. A model coefficient cannot repair an ill-defined intervention. This remains untested.\",\"kind\":\"assumption\",\"one_liner\":\"Observed event times must agree with the potential event times under the treatment actually received, with meaningful treatment versions.\",\"plain_language\":\"Observed event times must agree with the potential event times under the treatment actually received, with meaningful treatment versions.\",\"references\":[\"Hernán and Robins (2020), Causal Inference: What If\"],\"see_also\":[{\"explain_key\":\"design.survival\",\"id\":\"survival\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Follow people from a common time zero; some leave follow-up before the event is observed.\",\"title\":\"Time until an event\"}],\"starts_as\":\"untested\",\"tags\":[\"Time until an event\"],\"title\":\"Consistency / well-defined baseline intervention\",\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[\"no check in the app speaks to this one, so it can only be argued for\"],\"id\":\"assumption:survival_consistency\",\"kind\":\"assumption\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"survival_consistency\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Observed event times must agree with the potential event times under the treatment actually received, with meaningful treatment versions.\",\"title\":\"Consistency / well-defined baseline intervention\"}" .
<urn:capy:assumption%3Asurvival_no_interference> a capy:assumption ; skos:prefLabel "No interference between people" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"assumption:survival_no_interference\",\"citation_ids\":[],\"citations\":[],\"content\":{\"checks\":[],\"common_mistake\":null,\"designs\":[{\"explain_key\":\"design.survival\",\"id\":\"survival\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Follow people from a common time zero; some leave follow-up before the event is observed.\",\"title\":\"Time until an event\"}],\"explain_key\":\"assumption.survival_no_interference\",\"gaps\":[\"no check in the app speaks to this one, so it can only be argued for\"],\"id\":\"survival_no_interference\",\"in_more_depth\":\"Contagion, shared care resources and spillovers may violate this condition. These adapters also assume independent subjects for resampling; clustered uncertainty requires another adapter. This remains untested.\",\"kind\":\"assumption\",\"one_liner\":\"One person's event time is assumed unaffected by other people's treatment assignments.\",\"plain_language\":\"One person's event time is assumed unaffected by other people's treatment assignments.\",\"references\":[\"Hernán and Robins (2020), Causal Inference: What If\"],\"see_also\":[{\"explain_key\":\"design.survival\",\"id\":\"survival\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Follow people from a common time zero; some leave follow-up before the event is observed.\",\"title\":\"Time until an event\"}],\"starts_as\":\"untested\",\"tags\":[\"Time until an event\"],\"title\":\"No interference between people\",\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[\"no check in the app speaks to this one, so it can only be argued for\"],\"id\":\"assumption:survival_no_interference\",\"kind\":\"assumption\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"survival_no_interference\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"One person's event time is assumed unaffected by other people's treatment assignments.\",\"title\":\"No interference between people\"}" .
<urn:capy:assumption%3Asutva> a capy:assumption ; skos:prefLabel "SUTVA / no interference" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"assumption:sutva\",\"citation_ids\":[],\"citations\":[],\"content\":{\"checks\":[],\"common_mistake\":\"Treating spillover as noise. If treatment helps the treated partly by hurting the untreated, the comparison overstates the total effect, and no amount of adjustment recovers it.\",\"designs\":[{\"explain_key\":\"design.rct\",\"id\":\"rct\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"People were assigned by chance, or as good as chance.\",\"title\":\"Randomised or as-if randomised\"},{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"},{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"},{\"explain_key\":\"design.rd\",\"id\":\"rd\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Crossing a score, age, or border switched the programme on.\",\"title\":\"A cutoff decided eligibility\"},{\"explain_key\":\"design.iv\",\"id\":\"iv\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"An instrument or encouragement changed treatment, not the outcome directly.\",\"title\":\"Something else pushed people in\"},{\"explain_key\":\"design.synth\",\"id\":\"synth\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"One treated unit; build a comparison from a donor pool.\",\"title\":\"One place, constructed twin\"},{\"explain_key\":\"design.its\",\"id\":\"its\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Before versus after an interruption; maybe a control series.\",\"title\":\"A shock in a single series\"},{\"explain_key\":\"design.mediation\",\"id\":\"mediation\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"We care about a mediator, not only the total effect.\",\"title\":\"How it worked (pathways)\"},{\"explain_key\":\"design.longitudinal\",\"id\":\"longitudinal\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"The same person is treated, untreated, treated again; confounders also move.\",\"title\":\"Treatment that changes over time\"}],\"explain_key\":\"assumption.sutva\",\"gaps\":[\"no check in the app speaks to this one, so it can only be argued for\"],\"id\":\"sutva\",\"in_more_depth\":\"Two claims in one. No interference says your neighbour's vaccination does not change your infection risk, your rival firm's subsidy does not change your employment. One version of treatment says the programme delivered in one clinic is the same programme delivered in another. Neither is testable from the data in a standard design. Both are often false in exactly the settings policy analysts care about -- vaccination, job training in a local labour market, school choice.\",\"kind\":\"assumption\",\"one_liner\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"plain_language\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"references\":[\"Cox (1958)\",\"Hudgens & Halloran (2008), Toward causal inference with interference\"],\"see_also\":[{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"},{\"explain_key\":\"design.rct\",\"id\":\"rct\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"People were assigned by chance, or as good as chance.\",\"title\":\"Randomised or as-if randomised\"},{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"},{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"},{\"explain_key\":\"design.rd\",\"id\":\"rd\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Crossing a score, age, or border switched the programme on.\",\"title\":\"A cutoff decided eligibility\"},{\"explain_key\":\"design.iv\",\"id\":\"iv\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"An instrument or encouragement changed treatment, not the outcome directly.\",\"title\":\"Something else pushed people in\"},{\"explain_key\":\"design.synth\",\"id\":\"synth\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"One treated unit; build a comparison from a donor pool.\",\"title\":\"One place, constructed twin\"},{\"explain_key\":\"design.its\",\"id\":\"its\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Before versus after an interruption; maybe a control series.\",\"title\":\"A shock in a single series\"},{\"explain_key\":\"design.mediation\",\"id\":\"mediation\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"We care about a mediator, not only the total effect.\",\"title\":\"How it worked (pathways)\"},{\"explain_key\":\"design.longitudinal\",\"id\":\"longitudinal\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"The same person is treated, untreated, treated again; confounders also move.\",\"title\":\"Treatment that changes over time\"}],\"starts_as\":\"assumed\",\"tags\":[\"Randomised or as-if randomised\",\"Adjust for background differences\",\"Policy rolled out over time\",\"A cutoff decided eligibility\",\"Something else pushed people in\",\"One place, constructed twin\",\"A shock in a single series\",\"How it worked (pathways)\",\"Treatment that changes over time\"],\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},\"disposition\":\"imported\",\"gaps\":[\"no check in the app speaks to this one, so it can only be argued for\"],\"id\":\"assumption:sutva\",\"kind\":\"assumption\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"sutva\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"title\":\"SUTVA / no interference\"}" .
<urn:capy:assumption%3Awithin_group_independent_censoring> a capy:assumption ; skos:prefLabel "Within-arm independent censoring for raw Kaplan–Meier" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-ontology> ; capy:record "{\"citation_ids\":[\"source:ontology:cole2004\"],\"citations\":[],\"disposition\":\"original_qualified_observation_condition\",\"gaps\":[\"Independent human semantic review and study-specific evidence are absent.\"],\"id\":\"assumption:within_group_independent_censoring\",\"kind\":\"assumption\",\"provenance\":[\"source:project-ontology\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:9f87683d6827d55da15dfd09\",\"object_id\":\"concept:within-arm-independent-censoring\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"The maintained concept supplies this observation-condition explanation.\",\"subject_id\":\"assumption:within_group_independent_censoring\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:cf5b92e6da0dbf647c08a0dc\",\"object_id\":\"source:ontology:cole2004\",\"predicate\":\"cites\",\"provenance\":[\"source:project-ontology\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"assumption:within_group_independent_censoring\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Observation condition for the raw arm-specific Kaplan–Meier distribution and its RMST summary; not a treatment-exchangeability claim.\",\"source_ids\":[\"source:ontology:cole2004\"],\"summary\":\"Raw treatment-arm Kaplan–Meier requires the appropriate independent-censoring condition within the reported arms and supported risk sets; conditioning only on additional covariates is a different assumption.\",\"title\":\"Within-arm independent censoring for raw Kaplan–Meier\"}" .
<urn:capy:bacon2021> a capy:source ; skos:prefLabel "Goodman-Bacon, A. (2021). Difference-in-differences with variation in treatment timing. Journal of Econometrics, 225(2), 254–277." ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"citation\":\"Goodman-Bacon, A. (2021). Difference-in-differences with variation in treatment timing. Journal of Econometrics, 225(2), 254–277.\",\"citation_ids\":[],\"citations\":[],\"disposition\":\"resolved_metadata\",\"id\":\"bacon2021\",\"kind\":\"source\",\"metadata\":{\"citation\":\"Goodman-Bacon, A. (2021). Difference-in-differences with variation in treatment timing. Journal of Econometrics, 225(2), 254–277.\",\"id\":\"bacon2021\",\"match\":[\"goodman\",\"bacon\",\"2021\"],\"resolved\":true,\"topic\":\"Difference-in-differences\",\"url\":\"https://doi.org/10.1016/j.jeconom.2021.03.014\"},\"provenance\":[\"source:project-inventory\"],\"publication_rights\":{\"attribution\":\"Goodman-Bacon, A. (2021). Difference-in-differences with variation in treatment timing. Journal of Econometrics, 225(2), 254–277.\",\"content_type\":\"external_publication_body\",\"license_id\":\"unknown\",\"license_url\":null,\"modified\":false,\"permissions\":{\"adapt\":false,\"cache\":false,\"display\":false,\"model_context\":false,\"public_export\":false},\"review_basis\":\"No full-text license has been admitted.\"},\"relations\":[],\"resolved\":true,\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project materi