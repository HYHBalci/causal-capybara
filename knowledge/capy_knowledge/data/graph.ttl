<urn:capy:obs.weighting.cbps> a capy:method ; skos:prefLabel "Covariate balancing propensity score" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:obs.weighting.cbps\"],\"catalogue_key\":\"method:obs.weighting.cbps\",\"citation_ids\":[\"10.1111/rssb.12027\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":\"Not wrapped yet. Entropy balancing is the closest implemented alternative.\",\"engines\":{\"python\":false,\"r\":\"CBPS\"},\"needs_r_packages\":[\"CBPS\",\"WeightIt\"],\"runs_here\":false,\"summary\":\"Not built into the app yet. The authoritative version is the R package CBPS, which the Engines screen can install for you.\"},\"designs\":[{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.love\",\"id\":\"love\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Covariate balance (Love plot)\"},{\"explain_key\":\"diagnostic.ess\",\"id\":\"ess\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Effective sample size\"},{\"explain_key\":\"diagnostic.overlap\",\"id\":\"overlap\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Overlap between the arms\"},{\"explain_key\":\"diagnostic.ps_calibration\",\"id\":\"ps_calibration\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Treatment-model calibration\"}],\"estimands\":[{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"},{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"},{\"acronym\":\"ATO\",\"explain_key\":\"estimand.ato\",\"id\":\"ATO\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For the people where treated and untreated genuinely overlap, what did it do?\",\"title\":\"Average treatment effect on the overlap population\"}],\"explain_key\":\"method.obs.weighting.cbps\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"obs.weighting.cbps\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":true,\"one_liner\":\"Fit the treatment model so that it balances covariates, rather than fitting it to predict treatment and hoping balance follows.\",\"options\":[],\"plain_language\":\"Fit the treatment model so that it balances covariates, rather than fitting it to predict treatment and hoping balance follows.\",\"probes\":[{\"explain_key\":\"probe.trim_curve\",\"id\":\"probe.trim_curve\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Re-estimate across a grid of propensity-score trimming thresholds instead of picking one and hoping.\",\"requested_as\":\"probe.trim_curve\",\"title\":\"Trimming curve\"},{\"explain_key\":\"probe.cinelli_hazlett\",\"id\":\"probe.cinelli_hazlett\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"How strong would an unmeasured confounder have to be -- compared with the covariates you already have -- to explain the estimate away?\",\"requested_as\":\"probe.cinelli_hazlett\",\"title\":\"Cinelli-Hazlett sensitivity (partial R2)\"}],\"references\":[\"Imai & Ratkovic (2014), Covariate balancing propensity score\"],\"roles_forbidden\":[],\"roles_optional\":[],\"roles_required\":[\"a treatment\",\"an outcome\",\"at least one measured confounder\"],\"see_also\":[{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"},{\"explain_key\":\"method.bounds.manski\",\"id\":\"bounds.manski\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Report the range the effect must lie in given only what the data can support, without assuming away the missing counterfactual.\",\"title\":\"Manski bounds\"},{\"explain_key\":\"method.interference.exposure\",\"id\":\"interference.exposure\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"When one unit's treatment affects another's outcome, estimate the direct and spillover effects separately instead of pretending neither exists.\",\"title\":\"Interference and spillovers\"},{\"explain_key\":\"method.ml.causal_forest\",\"id\":\"ml.causal_forest\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Grow trees that look for units whose effect differs, keeping the rows that chose each split away from the rows that estimate it.\",\"title\":\"Honest causal forest\"},{\"explain_key\":\"method.ml.dml_irm\",\"id\":\"ml.dml_irm\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"A separate outcome model for each arm plus a treatment model, combined in a doubly robust score: right if either side is right.\",\"title\":\"Double ML (interactive)\"},{\"explain_key\":\"method.ml.dml_plr\",\"id\":\"ml.dml_plr\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Predict the outcome and the treatment from the confounders, then regress what is left of one on what is left of the other.\",\"title\":\"Double ML (partially linear)\"},{\"explain_key\":\"method.ml.metalearner\",\"id\":\"ml.metalearner\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Build the per-unit effect out of ordinary prediction models, four different ways, on the same cross-fitting.\",\"title\":\"Meta-learner (T, S, X, DR)\"}],\"status\":\"recommended\",\"status_label\":\"Recommended\",\"tags\":[\"Adjust for background differences\",\"ATT\",\"ATE\",\"ATO\",\"Recommended\"],\"title\":\"Covariate balancing propensity score\",\"what_it_assumes\":[{\"explain_key\":\"assumption.exchangeability\",\"explains\":\"Treated and untreated units are comparable once you condition on the confounders you measured. Everything that pushed people towards treatment and also moves the outcome is in your adjustment set.\",\"id\":\"exchangeability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Exchangeability / no unmeasured confounding\",\"worry_when\":\"Treatment was chosen by people who knew something about the likely outcome that you do not observe. Clinical judgement, self-selection into a programme, and administrative triage are the classic cases.\"},{\"explain_key\":\"assumption.positivity\",\"explains\":\"Every kind of unit had some chance of being treated and some chance of not being treated. Where that fails, there is no comparison to make and the model is inventing one.\",\"id\":\"positivity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Positivity / overlap\",\"worry_when\":\"Any single weight carries a large share of the total; the effective sample is far below the nominal one; the propensity model separates the arms almost perfectly; treated units sit outside the control group's range.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"when_not_to_use\":[\"The just-identified version can be unstable with many covariates; entropy balancing solves a closely related problem and is implemented here in Python.\"],\"when_to_use\":[\"A propensity model that predicts well can still balance badly. CBPS optimises the thing you actually care about.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"obs.weighting.cbps\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"obs.weighting.cbps\",\"registry\":{\"coming\":\"Not wrapped yet. Entropy balancing is the closest implemented alternative.\",\"designs\":[\"observational\"],\"diagnostics\":[\"love\",\"ess\",\"overlap\",\"ps_calibration\"],\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":false,\"r\":\"CBPS\"},\"estimands\":[\"ATT\",\"ATE\",\"ATO\"],\"id\":\"obs.weighting.cbps\",\"needs_overlap\":true,\"one_liner\":\"Fit the treatment model so that it balances covariates, rather than fitting it to predict treatment and hoping balance follows.\",\"probes\":[\"probe.trim_curve\",\"probe.cinelli_hazlett\"],\"r_needs\":[\"CBPS\",\"WeightIt\"],\"reference_dispositions\":[{\"disposition\":\"resolved_metadata\",\"id\":\"10.1111/rssb.12027\",\"requested_as\":\"Imai & Ratkovic (2014), Covariate balancing propensity score\"}],\"reference_ids\":[\"10.1111/rssb.12027\"],\"references\":[\"Imai & Ratkovic (2014), Covariate balancing propensity score\"],\"roles_required\":[\"treatment\",\"outcome\",\"confounders\"],\"source_path\":\"engines/registry/methods.extra.yaml\",\"source_sha256\":\"2cb349e9f7f7e6f88c10c18d81478656fd420eda7ca977d9767610ac8c7a4be0\",\"status\":\"recommended\",\"title\":\"Covariate balancing propensity score\",\"what_can_go_wrong\":\"The just-identified version can be unstable with many covariates; entropy balancing solves a closely related problem and is implemented here in Python.\",\"why_recommended\":\"A propensity model that predicts well can still balance badly. CBPS optimises the thing you actually care about.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:0dd5f9b7618fcf247b1ad94d\",\"object_id\":\"concept:causal-robust-learning\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"bang2005\",\"chernozhukov2018\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"obs.weighting.cbps\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counter