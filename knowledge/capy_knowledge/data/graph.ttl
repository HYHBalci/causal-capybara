<urn:capy:rd.multi_cutoff> a capy:method ; skos:prefLabel "Multi-cutoff and geographic RD" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:rd.multi_cutoff\"],\"catalogue_key\":\"method:rd.multi_cutoff\",\"citation_ids\":[\"source:unresolved:ab31b4a1add58aa271f9\",\"source:unresolved:ff1c0f85d4a2d98369da\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":\"Not wrapped. Run one cutoff at a time and compare the projects.\",\"engines\":{\"python\":false,\"r\":\"rdmulti\"},\"needs_r_packages\":[\"rdmulti\"],\"runs_here\":false,\"summary\":\"Not built into the app yet. The authoritative version is the R package rdmulti, which the Engines screen can install for you.\"},\"designs\":[{\"explain_key\":\"design.rd\",\"id\":\"rd\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Crossing a score, age, or border switched the programme on.\",\"title\":\"A cutoff decided eligibility\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.rd_plot\",\"id\":\"rd_plot\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Binned scatter at the cutoff\"},{\"explain_key\":\"diagnostic.manipulation\",\"id\":\"manipulation\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Density at the cutoff\"},{\"explain_key\":\"diagnostic.covariate_balance\",\"id\":\"covariate_balance\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Covariate balance\"},{\"explain_key\":\"diagnostic.bandwidth_sensitivity\",\"id\":\"bandwidth_sensitivity\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Bandwidth sensitivity path\"}],\"estimands\":[{\"acronym\":\"LATE\",\"explain_key\":\"estimand.late\",\"id\":\"LATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who only got it because of the instrument or the cutoff, what did it do?\",\"title\":\"Local average treatment effect\"}],\"explain_key\":\"method.rd.multi_cutoff\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"rd.multi_cutoff\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":false,\"one_liner\":\"Several thresholds, or a boundary on a map, pooled into one design.\",\"options\":[],\"plain_language\":\"Several thresholds, or a boundary on a map, pooled into one design.\",\"probes\":[{\"explain_key\":\"probe.alternate_spec\",\"id\":\"probe.alternate_spec\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the grid of defensible specifications and sort the answers. The curve is the result, not the one you happened to run.\",\"requested_as\":\"probe.alternate_spec\",\"title\":\"Specification curve\"}],\"references\":[\"Cattaneo, Titiunik & Vazquez-Bare (2020)\",\"Keele & Titiunik (2015), Geographic boundaries\"],\"roles_forbidden\":[],\"roles_optional\":[],\"roles_required\":[\"an outcome\",\"a running variable\"],\"see_also\":[{\"explain_key\":\"design.rd\",\"id\":\"rd\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Crossing a score, age, or border switched the programme on.\",\"title\":\"A cutoff decided eligibility\"},{\"explain_key\":\"method.rd.fuzzy\",\"id\":\"rd.fuzzy\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Divide the jump in the outcome by the jump in take-up: the effect for the people the cutoff actually moved.\",\"title\":\"Fuzzy RD (crossing the cutoff only nudged people in)\"},{\"explain_key\":\"method.rd.local_linear\",\"id\":\"rd.local_linear\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Fit a line either side of the threshold and measure the step between them.\",\"title\":\"Sharp RD at the cutoff\"},{\"explain_key\":\"method.rd.local_randomization\",\"id\":\"rd.local_randomization\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Treat a narrow window around the cutoff as a small randomised experiment rather than fitting a curve through it.\",\"title\":\"Local randomisation RD\"}],\"status\":\"reasonable\",\"status_label\":\"Reasonable\",\"tags\":[\"A cutoff decided eligibility\",\"LATE\",\"Reasonable\"],\"title\":\"Multi-cutoff and geographic RD\",\"what_it_assumes\":[{\"explain_key\":\"assumption.no_manipulation\",\"explains\":\"People could not precisely control which side of the cutoff they landed on.\",\"id\":\"no_manipulation\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No manipulation of the running variable\",\"worry_when\":\"A visible spike or gap in the density at the cutoff; covariates that jump; a cutoff that people knew about and had time to respond to.\"},{\"explain_key\":\"assumption.continuity\",\"explains\":\"Everything else that affects the outcome changes smoothly through the cutoff, so the only thing that jumps is the treatment.\",\"id\":\"continuity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Continuity of potential outcomes at the cutoff\",\"worry_when\":\"Several rules share the threshold; the running variable is coarse, so \\\"at the cutoff\\\" is really a wide band; the estimate depends heavily on the bandwidth.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"when_not_to_use\":[\"Pooling assumes the effect is comparable across cutoffs; geographic designs add spatial confounding that a distance-to-boundary running variable does not remove.\"],\"when_to_use\":[\"Pooling cutoffs buys precision, and comparing effects across cutoffs is itself informative about how local the estimate is.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"rd.multi_cutoff\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"rd.multi_cutoff\",\"registry\":{\"coming\":\"Not wrapped. Run one cutoff at a time and compare the projects.\",\"designs\":[\"rd\"],\"diagnostics\":[\"rd_plot\",\"manipulation\",\"covariate_balance\",\"bandwidth_sensitivity\"],\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":false,\"r\":\"rdmulti\"},\"estimands\":[\"LATE\"],\"id\":\"rd.multi_cutoff\",\"one_liner\":\"Several thresholds, or a boundary on a map, pooled into one design.\",\"probes\":[\"probe.alternate_spec\"],\"r_needs\":[\"rdmulti\"],\"reference_dispositions\":[{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:ff1c0f85d4a2d98369da\",\"requested_as\":\"Cattaneo, Titiunik & Vazquez-Bare (2020)\"},{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:ab31b4a1add58aa271f9\",\"requested_as\":\"Keele & Titiunik (2015), Geographic boundaries\"}],\"reference_ids\":[\"source:unresolved:ff1c0f85d4a2d98369da\",\"source:unresolved:ab31b4a1add58aa271f9\"],\"references\":[\"Cattaneo, Titiunik & Vazquez-Bare (2020)\",\"Keele & Titiunik (2015), Geographic boundaries\"],\"roles_required\":[\"outcome\",\"running\"],\"source_path\":\"engines/registry/methods.extra.yaml\",\"source_sha256\":\"2cb349e9f7f7e6f88c10c18d81478656fd420eda7ca977d9767610ac8c7a4be0\",\"status\":\"reasonable\",\"title\":\"Multi-cutoff and geographic RD\",\"what_can_go_wrong\":\"Pooling assumes the effect is comparable across cutoffs; geographic designs add spatial confounding that a distance-to-boundary running variable does not remove.\",\"why_recommended\":\"Pooling cutoffs buys precision, and comparing effects across cutoffs is itself informative about how local the estimate is.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:01961123043925bfbd817c34\",\"object_id\":\"source:unresolved:ab31b4a1add58aa271f9\",\"predicate\":\"cites\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"rd.multi_cutoff\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:173944760f61a036faf3940b\",\"object_id\":\"concept:identification\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:pearl2009\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Or