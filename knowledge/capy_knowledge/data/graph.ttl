<urn:capy:ml.dml_plr> a capy:method ; skos:prefLabel "Double ML (partially linear)" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:ml.dml_plr\"],\"catalogue_key\":\"method:ml.dml_plr\",\"citation_ids\":[\"10.2307/1912705\",\"chernozhukov2018\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":null,\"engines\":{\"python\":true,\"r\":\"DoubleML\"},\"needs_r_packages\":[\"DoubleML\"],\"runs_here\":true,\"summary\":\"Runs on this computer with what the app already installs.\"},\"designs\":[{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.nuisance_rmse\",\"id\":\"nuisance_rmse\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Nuisance models by fold\"},{\"explain_key\":\"diagnostic.propensity_clipping\",\"id\":\"propensity_clipping\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Propensity clipping\"},{\"explain_key\":\"diagnostic.cate_distribution\",\"id\":\"cate_distribution\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"CATE distribution\"},{\"explain_key\":\"diagnostic.cate_calibration\",\"id\":\"cate_calibration\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"CATE calibration\"},{\"explain_key\":\"diagnostic.rate\",\"id\":\"rate\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Rank-weighted average treatment effect\"},{\"explain_key\":\"diagnostic.fold_stability\",\"id\":\"fold_stability\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Stability across folds\"},{\"explain_key\":\"diagnostic.seed_stability\",\"id\":\"seed_stability\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Stability across seeds\"},{\"explain_key\":\"diagnostic.constant_effect\",\"id\":\"constant_effect\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Constant-effect assumption\"}],\"estimands\":[{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"},{\"acronym\":\"ADRF\",\"explain_key\":\"estimand.dose_response\",\"id\":\"dose_response\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If we changed the dose, how would the outcome change?\",\"title\":\"Average dose-response function\"}],\"explain_key\":\"method.ml.dml_plr\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"ml.dml_plr\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":true,\"one_liner\":\"Predict the outcome and the treatment from the confounders, then regress what is left of one on what is left of the other.\",\"options\":[{\"choices\":[\"linear\",\"lasso\",\"forest\",\"gradient_boosting\"],\"default\":\"linear\",\"help\":\"The model used for E[Y|X] and E[D|X]. Boring is usually right: a regularised linear model is hard to beat when the sample is small, and a flexible learner cannot fix a confounder you did not measure.\",\"label\":\"Nuisance learner\",\"name\":\"learner\",\"profile\":\"standard\",\"type\":\"select\"},{\"default\":5,\"help\":\"Each fold is scored by models that never saw it. More folds use the data better and cost more time; below 5 the estimate starts to depend on the split.\",\"label\":\"Cross-fitting folds\",\"max\":20,\"min\":2,\"name\":\"folds\",\"profile\":\"standard\",\"type\":\"int\"},{\"default\":0.01,\"help\":\"Keeps the weights finite when a unit is nearly certain to be treated. Every clipped unit is reported, because clipping quietly changes the population.\",\"label\":\"Clip propensity scores at\",\"max\":0.45,\"min\":0.0,\"name\":\"clip\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":0.95,\"help\":\"The interval width. Changing it after seeing the result is not a neutral act.\",\"label\":\"Confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":1,\"help\":\"Reruns the whole cross-fitting under fresh random splits. The split is an arbitrary choice; the answer should not depend on it.\",\"label\":\"Repeat under new fold splits\",\"max\":10,\"min\":1,\"name\":\"stability_reps\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":200,\"help\":\"Draws used for the standard error of the targeting curve. 0 skips it.\",\"label\":\"Bootstrap draws for the RATE curve\",\"max\":2000,\"min\":0,\"name\":\"rate_reps\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":[],\"help\":\"Groups you named BEFORE looking. Each one gets the same doubly robust score as the headline, and the multiplicity caution comes with them.\",\"label\":\"Pre-registered subgroups\",\"name\":\"subgroups\",\"profile\":\"standard\",\"type\":\"columns\"}],\"plain_language\":\"Predict the outcome and the treatment from the confounders, then regress what is left of one on what is left of the other.\",\"probes\":[{\"explain_key\":\"probe.cinelli_hazlett\",\"id\":\"probe.cinelli_hazlett\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"How strong would an unmeasured confounder have to be -- compared with the covariates you already have -- to explain the estimate away?\",\"requested_as\":\"probe.cinelli_hazlett\",\"title\":\"Cinelli-Hazlett sensitivity (partial R2)\"},{\"explain_key\":\"probe.rosenbaum\",\"id\":\"probe.rosenbaum\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"How unequal could the odds of treatment be inside a matched pair before the conclusion stopped being clear?\",\"requested_as\":\"probe.rosenbaum\",\"title\":\"Rosenbaum bounds\"},{\"explain_key\":\"probe.placebo_outcome\",\"id\":\"probe.placebo_outcome\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the same analysis on something the treatment could not have changed. It should find nothing.\",\"requested_as\":\"probe.placebo_outcome\",\"title\":\"Placebo outcome\"},{\"explain_key\":\"probe.subset\",\"id\":\"probe.subset\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Re-estimate on random subsets. The answer should move about as much as losing that much data costs, and no more.\",\"requested_as\":\"probe.subset\",\"title\":\"Subset stability\"},{\"explain_key\":\"probe.random_common_cause\",\"id\":\"probe.random_common_cause\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Add a variable that causes nothing to the adjustment set. The estimate should barely move.\",\"requested_as\":\"probe.random_common_cause\",\"title\":\"Random common cause\"},{\"explain_key\":\"probe.trim_curve\",\"id\":\"probe.trim_curve\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Re-estimate across a grid of propensity-score trimming thresholds instead of picking one and hoping.\",\"requested_as\":\"probe.trim_curve\",\"title\":\"Trimming curve\"}],\"references\":[\"Chernozhukov, Chetverikov, Demirer, Duflo, Hansen, Newey & Robins (2018), Double/debiased machine learning for treatment and structural parameters\",\"Robinson (1988), Root-N-consistent semiparametric regression\"],\"roles_forbidden\":[\"forbidden\"],\"roles_optional\":[\"effect_modifiers\",\"a clustering variable\"],\"roles_required\":[\"a treatment\",\"an outcome\",\"at least one measured confounder\"],\"see_also\":[{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"},{\"explain_key\":\"method.bounds.manski\",\"id\":\"bounds.manski\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Report the range the effect must lie in given only what the data can support, without assuming away the missing counterfactual.\",\"title\":\"Manski bounds\"},{\"explain_key\":\"method.interference.exposure\",\"id\":\"interference.exposure\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"When one unit's treatment affects another's outcome, estimate the direct and spillover effects separately instead of pretending neither exists.\",\"title\":\"Interference and spillovers\"},{\"explain_key\":\"method.ml.causal_forest\",\"id\":\"ml.causal_forest\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Grow trees that look for units whose effect differs, keeping the rows that chose each split away from the rows that estimate it.\",\"title\":\"Honest causal forest\"},{\"explain_key\":\"method.ml.dml_irm\",\"id\":\"ml.dml_irm\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"A separate outcome model for each arm plus a treatment model, combined in a doubly robust score: right if either side is right.\",\"title\":\"Double ML (interactive)\"},{\"explain_key\":\"method.ml.metalearner\",\"id\":\"ml.metalearner\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Build the per-unit effect out of ordinary prediction models, four different ways, on the same cross-fitting.\",\"title\":\"Meta-learner (T, S, X, DR)\"},{\"explain_key\":\"method.obs.aipw\",\"id\":\"obs.aipw\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Use a treatment model and an outcome model together; it is right if either one is.\",\"title\":\"Doubly robust (AIPW)\"}],\"status\":\"recommended\",\"status_label\":\"Recommended\",\"tags\":[\"Adjust for background differences\",\"ATE\",\"ADRF\",\"Recommended\"],\"title\":\"Double ML (partially linear)\",\"what_it_assumes\":[{\"explain_key\":\"assumption.exchangeability\",\"explains\":\"Treated and untreated units are comparable once you condition on the confounders you measured. Everything that pushed people towards treatment and also moves the outcome is in your adjustment set.\",\"id\":\"exchangeability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Exchangeability / no unmeasured confounding\",\"worry_when\":\"Treatment was chosen by people who knew something about the likely outcome that you do not observe. Clinical judgement, self-selection into a programme, and administrative triage are the classic cases.\"},{\"explain_key\":\"assumption.positivity\",\"explains\":\"Every kind of unit had some chance of being treated and some chance of not being treated. Where that fails, there is no comparison to make and the model is inventing one.\",\"id\":\"positivity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Positivity / overlap\",\"worry_when\":\"Any single weight carries a large share of the total; the effective sample is far below the nominal one; the propensity model separates the arms almost perfectly; treated units sit outside the control group's range.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"when_not_to_use\":[\"It assumes one effect for everyone. With a binary treatment and a varying effect it returns a variance-weighted average that is not the ATE. If the confounders predict treatment almost perfectly there is no residual variation left to divide by, and the interval collapses into nonsense. Machine learning does not identify anything. Cross-fitting removes the bias that comes from fitting flexible models on the same rows you estimate with; it does nothing about a confounder you never measured.\",\"The effect plainly varies across units -- use ml.dml_irm instead.\"],\"when_to_use\":[\"The one causal ML method that also handles a continuous dose, with an analytic standard error that comes from the estimator's own orthogonal score rather than a bootstrap.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"ml.dml_plr\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"ml.dml_plr\",\"registry\":{\"designs\":[\"observational\"],\"diagnostics\":[\"nuisance_rmse\",\"propensity_clipping\",\"cate_distribution\",\"cate_calibration\",\"rate\",\"fold_stability\",\"seed_stability\",\"constant_effect\"],\"disrecommend_when\":\"The effect plainly varies across units -- use ml.dml_irm instead.\",\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":true,\"r\":\"DoubleML\"},\"estimands\":[\"ATE\",\"dose_response\"],\"explain_key\":\"method.ml.dml_plr\",\"id\":\"ml.dml_plr\",\"needs\":[\"numpy\",\"scipy\",\"pandas\",\"scikit-learn\"],\"needs_overlap\":true,\"one_liner\":\"Predict the outcome and the treatment from the confounders, then regress what is left of one on what is left of the other.\",\"options\":[{\"choices\":[\"linear\",\"lasso\",\"forest\",\"gradient_boosting\"],\"default\":\"linear\",\"help\":\"The model used for E[Y|X] and E[D|X]. Boring is usually right: a regularised linear model is hard to beat when the sample is small, and a flexible learner cannot fix a confounder you did not measure.\",\"label\":\"Nuisance learner\",\"name\":\"learner\",\"profile\":\"standard\",\"type\":\"select\"},{\"default\":5,\"help\":\"Each fold is scored by models that never saw it. More folds use the data better and cost more time; below 5 the estimate starts to depend on the split.\",\"label\":\"Cross-fitting folds\",\"max\":20,\"min\":2,\"name\":\"folds\",\"profile\":\"standard\",\"type\":\"int\"},{\"default\":0.01,\"help\":\"Keeps the weights finite when a unit is nearly certain to be treated. Every clipped unit is reported, because clipping quietly changes the population.\",\"label\":\"Clip propensity scores at\",\"max\":0.45,\"min\":0.0,\"name\":\"clip\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":0.95,\"help\":\"The interval width. Changing it after seeing the result is not a neutral act.\",\"label\":\"Confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":1,\"help\":\"Reruns the whole cross-fitting under fresh random splits. The split is an arbitrary choice; the answer should not depend on it.\",\"label\":\"Repeat under new fold splits\",\"max\":10,\"min\":1,\"name\":\"stability_reps\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":200,\"help\":\"Draws used for the standard error of the targeting curve. 0 skips it.\",\"label\":\"Bootstrap draws for the RATE curve\",\"max\":2000,\"min\":0,\"name\":\"rate_reps\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":[],\"help\":\"Groups you named BEFORE looking. Each one gets the same doubly robust score as the headline, and the multiplicity caution comes with them.\",\"label\":\"Pre-registered subgroups\",\"name\":\"subgroups\",\"profile\":\"standard\",\"type\":\"columns\"}],\"probes\":[\"probe.cinelli_hazlett\",\"probe.rosenbaum\",\"probe.placebo_outcome\",\"probe.subset\",\"probe.random_common_cause\",\"probe.trim_curve\"],\"reference_dispositions\":[{\"disposition\":\"resolved_metadata\",\"id\":\"chernozhukov2018\",\"requested_as\":\"Chernozhukov, Chetverikov, Demirer, Duflo, Hansen, Newey & Robins (2018), Double/debiased machine learning for treatment and structural parameters\"},{\"disposition\":\"resolved_metadata\",\"id\":\"10.2307/1912705\",\"requested_as\":\"Robinson (1988), Root-N-consistent semiparametric regression\"}],\"reference_ids\":[\"chernozhukov2018\",\"10.2307/1912705\"],\"references\":[\"Chernozhukov, Chetverikov, Demirer, Duflo, Hansen, Newey & Robins (2018), Double/debiased machine learning for treatment and structural parameters\",\"Robinson (1988), Root-N-consistent semiparametric regression\"],\"roles_forbidden\":[\"forbidden\"],\"roles_optional\":[\"effect_modifiers\",\"cluster\"],\"roles_required\":[\"treatment\",\"outcome\",\"confounders\"],\"source_path\":\"engines/python/capy_py/causalml.py\",\"source_sha256\":\"1c60218ff563078a18a811cc23ca51cddaad89bb27de76b552224a35be8473ca\",\"status\":\"recommended\",\"title\":\"Double ML (partially linear)\",\"what_can_go_wrong\":\"It assumes one effect for everyone. With a binary treatment and a varying effect it returns a variance-weighted average that is not the ATE. If the confounders predict treatment almost perfectly there is no residual variation left to divide by, and the interval collapses into nonsense. Machine learning does not identify anything. Cross-fitting removes the bias that comes from fitting flexible models on the same rows you estimate with; it does nothing about a confounder you never measured.\",\"why_recommended\":\"The one causal ML method that also handles a continuous dose, with an analytic standard error that comes from the estimator's own orthogonal score rather than a bootstrap.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:038d9b71132d221c465fb954\",\"object_id\":\"concept:negative-control\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:rubin2008\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"ml.dml_plr\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:05179d65b0c9426f3a95103c\",\"object_id\":\"concept:double-robustness\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"bang2005\",\"chernozhukov2018\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_pr