t\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"An instrument moved treatment without touching the outcome any other way. You learn the effect for the people it moved.\",\"title\":\"Something else pushed people in\"}" .
<urn:capy:design%3Alongitudinal> a capy:design ; skos:prefLabel "Treatment that changes over time" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"Time-varying treatment\",\"marginal structural model\",\"MSM\",\"g-formula\",\"g-methods\",\"TMLE\",\"longitudinal data\",\"dynamic treatment\"],\"catalogue_key\":\"design:longitudinal\",\"citation_ids\":[],\"citations\":[],\"content\":{\"also_called\":[\"Time-varying treatment\",\"marginal structural model\",\"MSM\",\"g-formula\",\"g-methods\",\"TMLE\",\"longitudinal data\",\"dynamic treatment\"],\"assumption_notes\":[\"No unmeasured time-varying confounding\",\"Positivity at every period -- and it fails more often than in a cross-section\",\"Correct specification of the treatment and outcome models over time\"],\"common_mistake\":\"Putting time-varying confounders into an ordinary regression alongside treatment. That is precisely the case g-methods exist for.\",\"default_estimand\":{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"},\"diagnostics\":[{\"explain_key\":\"diagnostic.augmentation_gap\",\"id\":\"augmentation_gap\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Augmentation gap\"},{\"explain_key\":\"diagnostic.bootstrap_spread\",\"id\":\"bootstrap_spread\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Bootstrap spread\"},{\"explain_key\":\"diagnostic.censoring_weights\",\"id\":\"censoring_weights\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Censoring weights\"},{\"explain_key\":\"diagnostic.evalue\",\"id\":\"evalue\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"E-value\"},{\"explain_key\":\"diagnostic.evalue_scale\",\"id\":\"evalue_scale\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"E-value scale\"},{\"explain_key\":\"diagnostic.extreme_confounder\",\"id\":\"extreme_confounder\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Confounder strength needed to explain the estimate\"},{\"explain_key\":\"diagnostic.influence_spread\",\"id\":\"influence_spread\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Influence-function spread\"},{\"explain_key\":\"diagnostic.leave_one_out\",\"id\":\"leave_one_out\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Leave one unit out\"},{\"explain_key\":\"diagnostic.linear_form\",\"id\":\"linear_form\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Linearity of the outcome model\"},{\"explain_key\":\"diagnostic.natural_course\",\"id\":\"natural_course\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Natural-course calibration\"},{\"explain_key\":\"diagnostic.negative_control\",\"id\":\"negative_control\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Negative control\"},{\"explain_key\":\"diagnostic.person_time\",\"id\":\"person_time\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Person-time and switching\"},{\"explain_key\":\"diagnostic.placebo_outcome\",\"id\":\"placebo_outcome\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Placebo outcome\"},{\"explain_key\":\"diagnostic.placebo_treatment\",\"id\":\"placebo_treatment\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Placebo treatment\"},{\"explain_key\":\"diagnostic.positivity_by_period\",\"id\":\"positivity_by_period\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Positivity by period\"},{\"explain_key\":\"diagnostic.probe_runs\",\"id\":\"probe_runs\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Probe runs\"},{\"explain_key\":\"diagnostic.random_common_cause\",\"id\":\"random_common_cause\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Random common cause\"},{\"explain_key\":\"diagnostic.regime_support\",\"id\":\"regime_support\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Support for the intervention regime\"},{\"explain_key\":\"diagnostic.robustness_value\",\"id\":\"robustness_value\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Robustness value\"},{\"explain_key\":\"diagnostic.spec_curve\",\"id\":\"spec_curve\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Specification curve\"},{\"explain_key\":\"diagnostic.strategy_paths\",\"id\":\"strategy_paths\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Treatment strategies compared\"},{\"explain_key\":\"diagnostic.subset_stability\",\"id\":\"subset_stability\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Stability on random subsets\"},{\"explain_key\":\"diagnostic.temporal_ordering\",\"id\":\"temporal_ordering\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Temporal ordering of covariates\"},{\"explain_key\":\"diagnostic.unobserved_confounder\",\"id\":\"unobserved_confounder\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Simulated unobserved confounder\"},{\"explain_key\":\"diagnostic.weighted_balance\",\"id\":\"weighted_balance\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Balance after weighting\"},{\"explain_key\":\"diagnostic.weights_by_period\",\"id\":\"weights_by_period\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Weights by period\"}],\"estimands\":[{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"},{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"}],\"explain_key\":\"design.longitudinal\",\"gaps\":[],\"how_the_board_reads\":\"Treatment and confounders both move over time, and each can only be affected by what came before it. Whether a covariate is treated as measured at the same time as the treatment or one period earlier changes the answer, so say which you mean.\",\"id\":\"longitudinal\",\"in_more_depth\":\"This is the setting ordinary regression cannot handle. A variable like blood pressure or employment status is a consequence of past treatment and a cause of future treatment. Adjust for it and you block part of the effect and open a collider path; ignore it and confounding remains. G-methods solve it by modelling the treatment process over time instead of conditioning on its consequences: inverse-probability weighting for a marginal structural model, the parametric g-formula, or a sequential doubly robust estimator. Lag discipline is the practical rule, and the board enforces it: a covariate may adjust a treatment decision only if it was measured before that decision. Arrows cannot point into the past.\",\"kind\":\"design\",\"methods\":[{\"explain_key\":\"method.long.g_estimation\",\"id\":\"long.g_estimation\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Estimate the effect of a treatment regime by finding the parameter that removes the association between treatment and the blipped-down outcome.\",\"title\":\"G-estimation of structural nested models\"},{\"explain_key\":\"method.long.gformula\",\"id\":\"long.gformula\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Model each period in turn, then simulate the world where everyone followed the strategy you name.\",\"title\":\"Parametric g-formula\"},{\"explain_key\":\"method.long.lmtp\",\"id\":\"long.lmtp\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Estimate the effect of shifting a continuous or multi-valued treatment, rather than of setting everyone to one value.\",\"title\":\"Longitudinal modified treatment policies (lmtp)\"},{\"explain_key\":\"method.long.ltmle\",\"id\":\"long.ltmle\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Regress backwards from the final outcome, then correct with the treatment probabilities: right if either set of models is right.\",\"title\":\"Sequential doubly robust (ICE g-formula with augmentation)\"},{\"explain_key\":\"method.long.ltmle_survival\",\"id\":\"long.ltmle_survival\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Time-to-event outcomes with time-varying treatment and censoring, targeted at each time.\",\"title\":\"Longitudinal TMLE for survival outcomes\"},{\"explain_key\":\"method.long.msm_iptw\",\"id\":\"long.msm_iptw\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Reweight each person-period so the treated and untreated histories look alike, then fit one simple model to the reweighted data.\",\"title\":\"Marginal structural model (time-varying weights)\"},{\"explain_key\":\"method.obs.missing.mice\",\"id\":\"obs.missing.mice\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Impute the missing values several times, run the analysis in each, and combine -- instead of dropping every row with a gap.\",\"title\":\"Multiple imputation compatible with the analysis\"}],\"one_liner\":\"The same person is treated, untreated, treated again; confounders also move.\",\"plain_language\":\"The same unit is treated, untreated, treated again -- and the confounders move too, partly because of the treatment.\",\"probes\":[{\"explain_key\":\"probe.add_unobserved_confounder\",\"id\":\"probe.add_unobserved_confounder\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Simulate a common cause of a stated strength and watch the estimate move; read off how strong one would have to be to explain the result away.\",\"title\":\"Unobserved confounder\"},{\"explain_key\":\"probe.alternate_spec\",\"id\":\"probe.alternate_spec\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the grid of defensible specifications and sort the answers. The curve is the result, not the one you happened to run.\",\"title\":\"Specification curve\"},{\"explain_key\":\"probe.cinelli_hazlett\",\"id\":\"probe.cinelli_hazlett\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"How strong would an unmeasured confounder have to be -- compared with the covariates you already have -- to explain the estimate away?\",\"title\":\"Cinelli-Hazlett sensitivity (partial R2)\"},{\"explain_key\":\"probe.evalue\",\"id\":\"probe.evalue\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"The smallest confounder-treatment and confounder-outcome association that could explain the result away.\",\"title\":\"E-value\"},{\"explain_key\":\"probe.leave_one_out\",\"id\":\"probe.leave_one_out\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Drop one cluster, cohort or donor at a time and see whether any single one is carrying the result.\",\"title\":\"Leave one out\"},{\"explain_key\":\"probe.negative_control\",\"id\":\"probe.negative_control\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Estimate something that shares the confounding but not the causal path. A non-zero answer is bias you can see.\",\"title\":\"Negative control\"},{\"explain_key\":\"probe.placebo_outcome\",\"id\":\"probe.placebo_outcome\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the same analysis on something the treatment could not have changed. It should find nothing.\",\"title\":\"Placebo outcome\"},{\"explain_key\":\"probe.placebo_treatment\",\"id\":\"probe.placebo_treatment\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Move the policy date earlier, reshuffle who was treated, or swap in a variable that cannot cause the outcome.\",\"title\":\"Placebo treatment\"},{\"explain_key\":\"probe.random_common_cause\",\"id\":\"probe.random_common_cause\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Add a variable that causes nothing to the adjustment set. The estimate should barely move.\",\"title\":\"Random common cause\"},{\"explain_key\":\"probe.subset\",\"id\":\"probe.subset\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Re-estimate on random subsets. The answer should move about as much as losing that much data costs, and no more.\",\"title\":\"Subset stability\"}],\"references\":[\"Robins, Hernán & Brumback (2000)\",\"Hernán & Robins (2020), part III\"],\"see_also\":[{\"explain_key\":\"concept.time_varying_confounding\",\"id\":\"concept.time_varying_confounding\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"A variable that is both a consequence of past treatment and a cause of future treatment. Ordinary regression cannot handle it; g-methods can.\",\"title\":\"Time-varying confounding\"},{\"explain_key\":\"method.long.msm_iptw\",\"id\":\"long.msm_iptw\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Reweight each person-period so the treated and untreated histories look alike, then fit one simple model to the reweighted data.\",\"title\":\"Marginal structural model (time-varying weights)\"},{\"explain_key\":\"method.long.gformula\",\"id\":\"long.gformula\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Model each period in turn, then simulate the world where everyone followed the strategy you name.\",\"title\":\"Parametric g-formula\"},{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"},{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"},{\"explain_key\":\"method.long.g_estimation\",\"id\":\"long.g_estimation\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Estimate the effect of a treatment regime by finding the parameter that removes the association between treatment and the blipped-down outcome.\",\"title\":\"G-estimation of structural nested models\"},{\"explain_key\":\"method.long.lmtp\",\"id\":\"long.lmtp\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Estimate the effect of shifting a continuous or multi-valued treatment, rather than of setting everyone to one value.\",\"title\":\"Longitudinal modified treatment policies (lmtp)\"},{\"explain_key\":\"method.long.ltmle\",\"id\":\"long.ltmle\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Regress backwards from the final outcome, then correct with the treatment probabilities: right if either set of models is right.\",\"title\":\"Sequential doubly robust (ICE g-formula with augmentation)\"}],\"tags\":[\"ATE\",\"ATT\"],\"title\":\"Treatment that changes over time\",\"what_it_assumes\":[{\"explain_key\":\"assumption.no_time_varying_confounding\",\"explains\":\"At every period, the things that drive the treatment decision and also affect the outcome are measured -- and measured before that decision.\",\"id\":\"no_time_varying_confounding\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No unmeasured time-varying confounding\",\"worry_when\":\"Clinical measurements taken after the dose was changed; employment status recorded at the end of a period used to explain treatment at its start.\"},{\"explain_key\":\"assumption.positivity\",\"explains\":\"Every kind of unit had some chance of being treated and some chance of not being treated. Where that fails, there is no comparison to make and the model is inventing one.\",\"id\":\"positivity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Positivity / overlap\",\"worry_when\":\"Any single weight carries a large share of the total; the effective sample is far below the nominal one; the propensity model separates the arms almost perfectly; treated units sit outside the control group's range.\"},{\"explain_key\":\"assumption.sequential_ignorability\",\"explains\":\"No unmeasured confounding of the treatment-outcome relationship, and none of the mediator-outcome relationship either, even after conditioning on treatment.\",\"id\":\"sequential_ignorability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Sequential ignorability\",\"worry_when\":\"There is a variable affected by treatment that also confounds the mediator-outcome relationship. Under that structure the natural effects are not identified at all.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"design:longitudinal\",\"kind\":\"design\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"longitudinal\",\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:005cf716e6577bcb4327159a\",\"object_id\":\"long.ltmle\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:longitudinal\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:5afe20f1dec0a8eec35735c4\",\"object_id\":\"estimand:ATT\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:longitudinal\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:63c8e355b715a0f037effcca\",\"object_id\":\"estimand:ATT\",\"predicate\":\"targets_estimand\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:longitudinal\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:6c5c7c86a259ae9276e53b71\",\"object_id\":\"concept:concept.time_varying_confounding\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:longitudinal\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:6eeb59b807048318945a01a5\",\"object_id\":\"long.g_estimation\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:longitudinal\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:84adab2368992e92560021c4\",\"object_id\":\"estimand:ATE\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:longitudinal\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:95dfef3c6ef5efbfaa5832a7\",\"object_id\":\"long.gformula\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:longitudinal\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:977440a6eadd902f7c7f0f2a\",\"object_id\":\"estimand:ATE\",\"predicate\":\"targets_estimand\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:longitudinal\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:c61aed4657534e9fc9f56d10\",\"object_id\":\"long.lmtp\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:longitudinal\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:d68f58d982f0ea89ba4a2b22\",\"object_id\":\"long.msm_iptw\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:longitudinal\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"The same unit is treated, untreated, treated again -- and the confounders move too, partly because of the treatment.\",\"title\":\"Treatment that changes over time\"}" .
<urn:capy:design%3Amediation> a capy:design ; skos:prefLabel "How it worked (pathways)" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"Causal mediation\",\"direct and indirect effects\",\"natural direct effect\",\"natural indirect effect\",\"pathway analysis\",\"mechanism\"],\"catalogue_key\":\"design:mediation\",\"citation_ids\":[],\"citations\":[],\"content\":{\"also_called\":[\"Causal mediation\",\"direct and indirect effects\",\"natural direct effect\",\"natural indirect effect\",\"pathway analysis\",\"mechanism\"],\"assumption_notes\":[\"No unmeasured treatment-outcome confounding\",\"No unmeasured mediator-outcome confounding, even given treatment\",\"For natural effects, an untestable cross-world condition\"],\"common_mistake\":\"Reporting a proportion mediated without saying that a variable affected by treatment could make the decomposition undefined.\",\"default_estimand\":{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"},\"diagnostics\":[{\"explain_key\":\"diagnostic.cde_path\",\"id\":\"cde_path\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Controlled direct effect across mediator levels\"},{\"explain_key\":\"diagnostic.evalue\",\"id\":\"evalue\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"E-value\"},{\"explain_key\":\"diagnostic.evalue_scale\",\"id\":\"evalue_scale\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"E-value scale\"},{\"explain_key\":\"diagnostic.extreme_confounder\",\"id\":\"extreme_confounder\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Confounder strength needed to explain the estimate\"},{\"explain_key\":\"diagnostic.leave_one_out\",\"id\":\"leave_one_out\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Leave one unit out\"},{\"explain_key\":\"diagnostic.linear_form\",\"id\":\"linear_form\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Linearity of the outcome model\"},{\"explain_key\":\"diagnostic.mediation_decomposition\",\"id\":\"mediation_decomposition\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Total = direct + indirect\"},{\"explain_key\":\"diagnostic.multiple_mediators\",\"id\":\"multiple_mediators\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Multiple mediators\"},{\"explain_key\":\"diagnostic.negative_control\",\"id\":\"negative_control\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Negative control\"},{\"explain_key\":\"diagnostic.placebo_outcome\",\"id\":\"placebo_outcome\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Placebo outcome\"},{\"explain_key\":\"diagnostic.placebo_treatment\",\"id\":\"placebo_treatment\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Placebo treatment\"},{\"explain_key\":\"diagnostic.probe_runs\",\"id\":\"probe_runs\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Probe runs\"},{\"explain_key\":\"diagnostic.random_common_cause\",\"id\":\"random_common_cause\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Random common cause\"},{\"explain_key\":\"diagnostic.robustness_value\",\"id\":\"robustness_value\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Robustness value\"},{\"explain_key\":\"diagnostic.spec_curve\",\"id\":\"spec_curve\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Specification curve\"},{\"explain_key\":\"diagnostic.subset_stability\",\"id\":\"subset_stability\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Stability on random subsets\"},{\"explain_key\":\"diagnostic.temporal_ordering\",\"id\":\"temporal_ordering\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Temporal ordering of covariates\"},{\"explain_key\":\"diagnostic.treatment_mediator_interaction\",\"id\":\"treatment_mediator_interaction\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Treatment-mediator interaction\"},{\"explain_key\":\"diagnostic.unobserved_confounder\",\"id\":\"unobserved_confounder\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Simulated unobserved confounder\"}],\"estimands\":[{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"},{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"}],\"explain_key\":\"design.mediation\",\"gaps\":[],\"how_the_board_reads\":\"You have to believe you measured everything that confounds treatment with the outcome AND everything that confounds the mediator with the outcome. That second half is the hard one, and it is what statisticians call sequential ignorability.\",\"id\":\"mediation\",\"in_more_depth\":\"Mediation needs two exchangeability assumptions rather than one, and the second is harder than the first: even in a randomised trial, the mediator is not randomised, so whatever determines it may also drive the outcome. Natural direct and indirect effects need a third condition comparing outcomes across worlds no person can inhabit at once. It is not testable, even in principle. Interventional effects replace it with something a trial could implement, which is why they are the better default for policy and health questions. Do not start from a product of two regression coefficients. It is only the indirect effect under linearity and no interaction, and it is silent about the assumptions.\",\"kind\":\"design\",\"methods\":[{\"explain_key\":\"method.med.controlled_direct\",\"id\":\"med.controlled_direct\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"What the treatment would still do if the mediator were fixed at one value for everybody.\",\"title\":\"Controlled direct effect\"},{\"explain_key\":\"method.med.interventional\",\"id\":\"med.interventional\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Shift the mediator to the distribution it would have in the population, rather than to each person's own unobservable counterfactual.\",\"title\":\"Interventional direct and indirect effects\"},{\"explain_key\":\"method.med.natural_effects\",\"id\":\"med.natural_effects\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Split the total effect into the part that travelled through the mediator and the part that did not.\",\"title\":\"Natural direct and indirect effects\"}],\"one_liner\":\"We care about a mediator, not only the total effect.\",\"plain_language\":\"Not just whether the treatment worked, but how much of the effect travelled through a particular mechanism.\",\"probes\":[{\"explain_key\":\"probe.add_unobserved_confounder\",\"id\":\"probe.add_unobserved_confounder\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Simulate a common cause of a stated strength and watch the estimate move; read off how strong one would have to be to explain the result away.\",\"title\":\"Unobserved confounder\"},{\"explain_key\":\"probe.alternate_spec\",\"id\":\"probe.alternate_spec\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the grid of defensible specifications and sort the answers. The curve is the result, not the one you happened to run.\",\"title\":\"Specification curve\"},{\"explain_key\":\"probe.cinelli_hazlett\",\"id\":\"probe.cinelli_hazlett\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"How strong would an unmeasured confounder have to be -- compared with the covariates you already have -- to explain the estimate away?\",\"title\":\"Cinelli-Hazlett sensitivity (partial R2)\"},{\"explain_key\":\"probe.evalue\",\"id\":\"probe.evalue\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"The smallest confounder-treatment and confounder-outcome association that could explain the result away.\",\"title\":\"E-value\"},{\"explain_key\":\"probe.leave_one_out\",\"id\":\"probe.leave_one_out\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Drop one cluster, cohort or donor at a time and see whether any single one is carrying the result.\",\"title\":\"Leave one out\"},{\"explain_key\":\"probe.negative_control\",\"id\":\"probe.negative_control\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Estimate something that shares the confounding but not the causal path. A non-zero answer is bias you can see.\",\"title\":\"Negative control\"},{\"explain_key\":\"probe.placebo_outcome\",\"id\":\"probe.placebo_outcome\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the same analysis on something the treatment could not have changed. It should find nothing.\",\"title\":\"Placebo outcome\"},{\"explain_key\":\"probe.placebo_treatment\",\"id\":\"probe.placebo_treatment\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Move the policy date earlier, reshuffle who was treated, or swap in a variable that cannot cause the outcome.\",\"title\":\"Placebo treatment\"},{\"explain_key\":\"probe.random_common_cause\",\"id\":\"probe.random_common_cause\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Add a variable that causes nothing to the adjustment set. The estimate should barely move.\",\"title\":\"Random common cause\"},{\"explain_key\":\"probe.subset\",\"id\":\"probe.subset\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Re-estimate on random subsets. The answer should move about as much as losing that much data costs, and no more.\",\"title\":\"Subset stability\"}],\"references\":[\"VanderWeele (2015)\",\"Robins & Greenland (1992)\"],\"see_also\":[{\"explain_key\":\"assumption.sequential_ignorability\",\"explains\":\"No unmeasured confounding of the treatment-outcome relationship, and none of the mediator-outcome relationship either, even after conditioning on treatment.\",\"id\":\"sequential_ignorability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Sequential ignorability\",\"worry_when\":\"There is a variable affected by treatment that also confounds the mediator-outcome relationship. Under that structure the natural effects are not identified at all.\"},{\"explain_key\":\"concept.cross_world\",\"id\":\"concept.cross_world\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"A condition relating outcomes under treatment and mediator values that no single person could ever experience together. Not testable, even in principle.\",\"title\":\"Cross-world assumptions\"},{\"explain_key\":\"method.med.interventional\",\"id\":\"med.interventional\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Shift the mediator to the distribution it would have in the population, rather than to each person's own unobservable counterfactual.\",\"title\":\"Interventional direct and indirect effects\"},{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"},{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"},{\"explain_key\":\"method.med.controlled_direct\",\"id\":\"med.controlled_direct\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"What the treatment would still do if the mediator were fixed at one value for everybody.\",\"title\":\"Controlled direct effect\"},{\"explain_key\":\"method.med.natural_effects\",\"id\":\"med.natural_effects\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Split the total effect into the part that travelled through the mediator and the part that did not.\",\"title\":\"Natural direct and indirect effects\"}],\"tags\":[\"ATE\",\"ATT\"],\"title\":\"How it worked (pathways)\",\"what_it_assumes\":[{\"explain_key\":\"assumption.sequential_ignorability\",\"explains\":\"No unmeasured confounding of the treatment-outcome relationship, and none of the mediator-outcome relationship either, even after conditioning on treatment.\",\"id\":\"sequential_ignorability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Sequential ignorability\",\"worry_when\":\"There is a variable affected by treatment that also confounds the mediator-outcome relationship. Under that structure the natural effects are not identified at all.\"},{\"explain_key\":\"assumption.exchangeability\",\"explains\":\"Treated and untreated units are comparable once you condition on the confounders you measured. Everything that pushed people towards treatment and also moves the outcome is in your adjustment set.\",\"id\":\"exchangeability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Exchangeability / no unmeasured confounding\",\"worry_when\":\"Treatment was chosen by people who knew something about the likely outcome that you do not observe. Clinical judgement, self-selection into a programme, and administrative triage are the classic cases.\"},{\"explain_key\":\"assumption.positivity\",\"explains\":\"Every kind of unit had some chance of being treated and some chance of not being treated. Where that fails, there is no comparison to make and the model is inventing one.\",\"id\":\"positivity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Positivity / overlap\",\"worry_when\":\"Any single weight carries a large share of the total; the effective sample is far below the nominal one; the propensity model separates the arms almost perfectly; treated units sit outside the control group's range.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"design:mediation\",\"kind\":\"design\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"mediation\",\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:10469b3ff0584957a2303cba\",\"object_id\":\"estimand:ATT\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:mediation\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:4ffec4ad2699598a78c0f0a1\",\"object_id\":\"estimand:ATT\",\"predicate\":\"targets_estimand\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:mediation\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:69481feb2fb9a54bcef47d03\",\"object_id\":\"med.controlled_direct\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:mediation\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:acf4b6d5aba8e17747fc8aae\",\"object_id\":\"estimand:ATE\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:mediation\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:b3c5ccf5a46516e3b2b1f28c\",\"object_id\":\"concept:concept.cross_world\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:mediation\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:bcd93b27135e019604c2325d\",\"object_id\":\"med.natural_effects\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:mediation\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:e3f4db13842b44ebbd550829\",\"object_id\":\"med.interventional\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:mediation\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:eb12ef742f22bc288b6715fd\",\"object_id\":\"estimand:ATE\",\"predicate\":\"targets_estimand\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:mediation\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:fc3a6c9237ab4b036a2d3494\",\"object_id\":\"assumption:sequential_ignorability\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:mediation\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Not just whether the treatment worked, but how much of the effect travelled through a particular mechanism.\",\"title\":\"How it worked (pathways)\"}" .
<urn:capy:design%3Aobservational> a capy:design ; skos:prefLabel "Adjust for background differences" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"Selection on observables\",\"unconfoundedness\",\"conditional ignorability\",\"propensity score\",\"matching\",\"inverse probability weighting\",\"IPW\",\"covariate adjustment\",\"doubly robust\",\"AIPW\"],\"catalogue_key\":\"design:observational\",\"citation_ids\":[],\"citations\":[],\"content\":{\"also_called\":[\"Selection on observables\",\"unconfoundedness\",\"conditional ignorability\",\"propensity score\",\"matching\",\"inverse probability weighting\",\"IPW\",\"covariate adjustment\",\"doubly robust\",\"AIPW\"],\"assumption_notes\":[\"Exchangeability given the measured confounders -- untestable\",\"Positivity -- visible in the overlap plot\",\"SUTVA and consistency\"],\"common_mistake\":\"Adding every available variable to the adjustment set. Post-treatment variables and colliders introduce bias that was not there before.\",\"default_estimand\":{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"},\"diagnostics\":[{\"explain_key\":\"diagnostic.cate_calibration\",\"id\":\"cate_calibration\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"CATE calibration\"},{\"explain_key\":\"diagnostic.cate_distribution\",\"id\":\"cate_distribution\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"CATE distribution\"},{\"explain_key\":\"diagnostic.cem_strata\",\"id\":\"cem_strata\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Coarsened strata and common support\"},{\"explain_key\":\"diagnostic.constant_effect\",\"id\":\"constant_effect\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Constant-effect assumption\"},{\"explain_key\":\"diagnostic.ebal_convergence\",\"id\":\"ebal_convergence\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Moment balance\"},{\"explain_key\":\"diagnostic.ess\",\"id\":\"ess\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Effective sample size\"},{\"explain_key\":\"diagnostic.evalue\",\"id\":\"evalue\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"E-value\"},{\"explain_key\":\"diagnostic.evalue_scale\",\"id\":\"evalue_scale\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"E-value scale\"},{\"explain_key\":\"diagnostic.extreme_confounder\",\"id\":\"extreme_confounder\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Confounder strength needed to explain the estimate\"},{\"explain_key\":\"diagnostic.fold_stability\",\"id\":\"fold_stability\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Stability across folds\"},{\"explain_key\":\"diagnostic.forest_honesty\",\"id\":\"forest_honesty\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Honest splitting scheme\"},{\"explain_key\":\"diagnostic.leave_one_out\",\"id\":\"leave_one_out\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Leave one unit out\"},{\"explain_key\":\"diagnostic.linear_form\",\"id\":\"linear_form\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Linearity of the outcome model\"},{\"explain_key\":\"diagnostic.love\",\"id\":\"love\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Covariate balance (Love plot)\"},{\"explain_key\":\"diagnostic.metalearner_plug_in\",\"id\":\"metalearner_plug_in\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Plug-in bias of the meta-learner\"},{\"explain_key\":\"diagnostic.model_reliance\",\"id\":\"model_reliance\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"How much the model is doing\"},{\"explain_key\":\"diagnostic.n_matched\",\"id\":\"n_matched\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Match quality\"},{\"explain_key\":\"diagnostic.negative_control\",\"id\":\"negative_control\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Negative control\"},{\"explain_key\":\"diagnostic.nuisance_rmse\",\"id\":\"nuisance_rmse\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Nuisance models by fold\"},{\"explain_key\":\"diagnostic.oster_assumptions\",\"id\":\"oster_assumptions\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Oster's assumptions\"},{\"explain_key\":\"diagnostic.oster_delta\",\"id\":\"oster_delta\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Oster delta\"},{\"explain_key\":\"diagnostic.overlap\",\"id\":\"overlap\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Overlap between the arms\"},{\"explain_key\":\"diagnostic.pair_quality\",\"id\":\"pair_quality\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Matched-pair quality\"},{\"explain_key\":\"diagnostic.placebo_outcome\",\"id\":\"placebo_outcome\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Placebo outcome\"},{\"explain_key\":\"diagnostic.placebo_treatment\",\"id\":\"placebo_treatment\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Placebo treatment\"},{\"explain_key\":\"diagnostic.policy_value\",\"id\":\"policy_value\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Honest policy value\"},{\"explain_key\":\"diagnostic.probe_runs\",\"id\":\"probe_runs\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Probe runs\"},{\"explain_key\":\"diagnostic.propensity_clipping\",\"id\":\"propensity_clipping\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Propensity clipping\"},{\"explain_key\":\"diagnostic.ps_calibration\",\"id\":\"ps_calibration\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Treatment-model calibration\"},{\"explain_key\":\"diagnostic.random_common_cause\",\"id\":\"random_common_cause\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Random common cause\"},{\"explain_key\":\"diagnostic.rate\",\"id\":\"rate\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Rank-weighted average treatment effect\"},{\"explain_key\":\"diagnostic.robustness_value\",\"id\":\"robustness_value\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Robustness value\"},{\"explain_key\":\"diagnostic.rosenbaum_bounds\",\"id\":\"rosenbaum_bounds\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Rosenbaum bounds\"},{\"explain_key\":\"diagnostic.seed_stability\",\"id\":\"seed_stability\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Stability across seeds\"},{\"explain_key\":\"diagnostic.spec_curve\",\"id\":\"spec_curve\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Specification curve\"},{\"explain_key\":\"diagnostic.subset_stability\",\"id\":\"subset_stability\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Stability on random subsets\"},{\"explain_key\":\"diagnostic.tmle_targeting\",\"id\":\"tmle_targeting\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Targeting step\"},{\"explain_key\":\"diagnostic.trim_cost\",\"id\":\"trim_cost\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"What trimming costs\"},{\"explain_key\":\"diagnostic.trim_stability\",\"id\":\"trim_stability\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Stability across trimming thresholds\"},{\"explain_key\":\"diagnostic.unobserved_confounder\",\"id\":\"unobserved_confounder\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Simulated unobserved confounder\"},{\"explain_key\":\"diagnostic.outcome_heterogeneity\",\"id\":\"outcome_heterogeneity\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Direct heterogeneity test on the selected outcome scale\"},{\"explain_key\":\"diagnostic.link_heterogeneity\",\"id\":\"link_heterogeneity\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Conditional treatment-by-modifier interaction\"}],\"estimands\":[{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"},{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"},{\"acronym\":\"ATC\",\"explain_key\":\"estimand.atc\",\"id\":\"ATC\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who didn't get it, what would it have done?\",\"title\":\"Average treatment effect on the controls\"},{\"acronym\":\"ATO\",\"explain_key\":\"estimand.ato\",\"id\":\"ATO\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For the people where treated and untreated genuinely overlap, what did it do?\",\"title\":\"Average treatment effect on the overlap population\"},{\"acronym\":\"CATE\",\"explain_key\":\"estimand.cate\",\"id\":\"CATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"How does the effect vary from person to person, or place to place?\",\"title\":\"Conditional average treatment effect\"},{\"acronym\":\"GATE\",\"explain_key\":\"estimand.gate\",\"id\":\"GATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"How does the effect vary across pre-specified groups?\",\"title\":\"Group average treatment effect\"},{\"acronym\":\"ADRF\",\"explain_key\":\"estimand.dose_response\",\"id\":\"dose_response\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If we changed the dose, how would the outcome change?\",\"title\":\"Average dose-response function\"}],\"explain_key\":\"design.observational\",\"gaps\":[],\"how_the_board_reads\":\"Every column you put in \\\"measured confounders\\\" is a claim that it was recorded before treatment was decided. Anything measured afterwards belongs in the box below it instead.\",\"id\":\"observational\",\"in_more_depth\":\"This is the workhorse and the hardest design to defend. The estimate is only as good as the adjustment set, and no diagnostic can tell you whether the set is complete -- balance plots only speak about the variables in it. Two things you can do. First, look at overlap: where the treated and untreated groups do not resemble each other at all, no method compares anything, it extrapolates. Second, ask the sensitivity question: how strong would an unmeasured confounder have to be, relative to the ones you did measure, to overturn the finding? Be careful about what goes into the adjustment set. Variables measured after treatment, or caused by it, make things worse rather than better.\",\"kind\":\"design\",\"methods\":[{\"explain_key\":\"method.bounds.manski\",\"id\":\"bounds.manski\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Report the range the effect must lie in given only what the data can support, without assuming away the missing counterfactual.\",\"title\":\"Manski bounds\"},{\"explain_key\":\"method.discovery.structure_learning\",\"id\":\"discovery.structure_learning\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Search for a graph consistent with the data. It does not recover the true causal structure from observational data without extra assumptions.\",\"title\":\"Structure learning (causal discovery)\"},{\"explain_key\":\"method.heterogeneity.binary\",\"id\":\"heterogeneity.binary\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Logistic interactions plus separate standardized risk-difference, risk-ratio or marginal odds-ratio heterogeneity tests.\",\"title\":\"Binary outcome heterogeneity\"},{\"explain_key\":\"method.heterogeneity.categorical\",\"id\":\"heterogeneity.categorical\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Multinomial treatment interactions and a joint test of category-probability contrasts; preserves categories without assigning numeric scores.\",\"title\":\"Nominal and ordinal outcome heterogeneity\"},{\"explain_key\":\"method.heterogeneity.continuous\",\"id\":\"heterogeneity.continuous\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"OLS treatment-by-baseline-modifier interactions with HC3 or cluster sandwich inference, direct mean-difference tests and Holm pairwise comparisons.\",\"title\":\"Continuous outcome heterogeneity\"},{\"explain_key\":\"method.heterogeneity.count\",\"id\":\"heterogeneity.count\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Poisson conditional-mean interactions with robust sandwich inference; compare standardized count or fixed-exposure rate contrasts.\",\"title\":\"Count and rate outcome heterogeneity\"},{\"explain_key\":\"method.interference.exposure\",\"id\":\"interference.exposure\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"When one unit's treatment affects another's outcome, estimate the direct and spillover effects separately instead of pretending neither exists.\",\"title\":\"Interference and spillovers\"},{\"explain_key\":\"method.ml.causal_forest\",\"id\":\"ml.causal_forest\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Grow trees that look for units whose effect differs, keeping the rows that chose each split away from the rows that estimate it.\",\"title\":\"Honest causal forest\"},{\"explain_key\":\"method.ml.dml_irm\",\"id\":\"ml.dml_irm\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"A separate outcome model for each arm plus a treatment model, combined in a doubly robust score: right if either side is right.\",\"title\":\"Double ML (interactive)\"},{\"explain_key\":\"method.ml.dml_plr\",\"id\":\"ml.dml_plr\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Predict the outcome and the treatment from the confounders, then regress what is left of one on what is left of the other.\",\"title\":\"Double ML (partially linear)\"},{\"explain_key\":\"method.ml.metalearner\",\"id\":\"ml.metalearner\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Build the per-unit effect out of ordinary prediction models, four different ways, on the same cross-fitting.\",\"title\":\"Meta-learner (T, S, X, DR)\"},{\"explain_key\":\"method.ml.policy_tree\",\"id\":\"ml.policy_tree\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Learn a short, readable rule for who to treat, then value that rule on data it never saw.\",\"title\":\"Policy tree (who should be treated)\"},{\"explain_key\":\"method.obs.aipw\",\"id\":\"obs.aipw\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Use a treatment model and an outcome model together; it is right if either one is.\",\"title\":\"Doubly robust (AIPW)\"},{\"explain_key\":\"method.obs.matching.cem\",\"id\":\"obs.matching.cem\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Bin the covariates, then compare only inside bins that contain both arms.\",\"title\":\"Coarsened exact matching\"},{\"explain_key\":\"method.obs.matching.genetic\",\"id\":\"obs.matching.genetic\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Search over distance-metric weights until balance is as good as it can get, instead of trusting one metric.\",\"title\":\"Genetic matching\"},{\"explain_key\":\"method.obs.matching.nn\",\"id\":\"obs.matching.nn\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Pair each treated unit with the most similar untreated unit, then compare within pairs.\",\"title\":\"Nearest-neighbour matching\"},{\"explain_key\":\"method.obs.matching.optimal\",\"id\":\"obs.matching.optimal\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Choose the whole set of matches at once to minimise total distance, rather than greedily one treated unit at a time.\",\"title\":\"Optimal and full matching\"},{\"explain_key\":\"method.obs.missing.mice\",\"id\":\"obs.missing.mice\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Impute the missing values several times, run the analysis in each, and combine -- instead of dropping every row with a gap.\",\"title\":\"Multiple imputation compatible with the analysis\"},{\"explain_key\":\"method.obs.outcome_regression\",\"id\":\"obs.outcome_regression\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Model the outcome, then ask what would have happened if everyone had been treated, and if nobody had.\",\"title\":\"Outcome regression (g-computation)\"},{\"explain_key\":\"method.obs.superlearner\",\"id\":\"obs.superlearner\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Combine several candidate learners by cross-validated weights instead of betting on one.\",\"title\":\"Super Learner nuisance models\"},{\"explain_key\":\"method.obs.tmle\",\"id\":\"obs.tmle\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Fit the outcome model, then nudge it once in the direction the treatment model says it is wrong.\",\"title\":\"Targeted maximum likelihood (TMLE)\"},{\"explain_key\":\"method.obs.weighting.cbps\",\"id\":\"obs.weighting.cbps\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Fit the treatment model so that it balances covariates, rather than fitting it to predict treatment and hoping balance follows.\",\"title\":\"Covariate balancing propensity score\"},{\"explain_key\":\"method.obs.weighting.entropy\",\"id\":\"obs.weighting.entropy\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Find the weights closest to equal that make the covariate means match exactly.\",\"title\":\"Entropy balancing\"},{\"explain_key\":\"method.obs.weighting.ipw\",\"id\":\"obs.weighting.ipw\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Reweight the sample so the treated and untreated groups look alike on the measured confounders.\",\"title\":\"Propensity weighting\"},{\"explain_key\":\"method.obs.weighting.twang\",\"id\":\"obs.weighting.twang\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Grow a boosted model for the propensity score, stopping at the iteration that balances covariates best.\",\"title\":\"Boosted propensity scores (twang)\"},{\"explain_key\":\"method.transport.generalize\",\"id\":\"transport.generalize\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Take an effect estimated in one population and ask what it would be in another with a different mix of characteristics.\",\"title\":\"Transportability and generalisability\"}],\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"plain_language\":\"Treatment was not random, but you believe you measured the things that decided who got it. Everything then rests on that belief.\",\"probes\":[{\"explain_key\":\"probe.add_unobserved_confounder\",\"id\":\"probe.add_unobserved_confounder\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Simulate a common cause of a stated strength and watch the estimate move; read off how strong one would have to be to explain the result away.\",\"title\":\"Unobserved confounder\"},{\"explain_key\":\"probe.alternate_spec\",\"id\":\"probe.alternate_spec\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the grid of defensible specifications and sort the answers. The curve is the result, not the one you happened to run.\",\"title\":\"Specification curve\"},{\"explain_key\":\"probe.cinelli_hazlett\",\"id\":\"probe.cinelli_hazlett\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"How strong would an unmeasured confounder have to be -- compared with the covariates you already have -- to explain the estimate away?\",\"title\":\"Cinelli-Hazlett sensitivity (partial R2)\"},{\"explain_key\":\"probe.evalue\",\"id\":\"probe.evalue\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"The smallest confounder-treatment and confounder-outcome association that could explain the result away.\",\"title\":\"E-value\"},{\"explain_key\":\"probe.leave_one_out\",\"id\":\"probe.leave_one_out\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Drop one cluster, cohort or donor at a time and see whether any single one is carrying the result.\",\"title\":\"Leave one out\"},{\"explain_key\":\"probe.negative_control\",\"id\":\"probe.negative_control\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Estimate something that shares the confounding but not the causal path. A non-zero answer is bias you can see.\",\"title\":\"Negative control\"},{\"explain_key\":\"probe.oster\",\"id\":\"probe.oster\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"How important would unobserved variables have to be, relative to the controls you already have, to drive the coefficient to zero?\",\"title\":\"Oster coefficient stability\"},{\"explain_key\":\"probe.placebo_outcome\",\"id\":\"probe.placebo_outcome\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the same analysis on something the treatment could not have changed. It should find nothing.\",\"title\":\"Placebo outcome\"},{\"explain_key\":\"probe.placebo_treatment\",\"id\":\"probe.placebo_treatment\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Move the policy date earlier, reshuffle who was treated, or swap in a variable that cannot cause the outcome.\",\"title\":\"Placebo treatment\"},{\"explain_key\":\"probe.random_common_cause\",\"id\":\"probe.random_common_cause\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Add a variable that causes nothing to the adjustment set. The estimate should barely move.\",\"title\":\"Random common cause\"},{\"explain_key\":\"probe.rosenbaum\",\"id\":\"probe.rosenbaum\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"How unequal could the odds of treatment be inside a matched pair before the conclusion stopped being clear?\",\"title\":\"Rosenbaum bounds\"},{\"explain_key\":\"probe.subset\",\"id\":\"probe.subset\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Re-estimate on random subsets. The answer should move about as much as losing that much data costs, and no more.\",\"title\":\"Subset stability\"},{\"explain_key\":\"probe.trim_curve\",\"id\":\"probe.trim_curve\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Re-estimate across a grid of propensity-score trimming thresholds instead of picking one and hoping.\",\"title\":\"Trimming curve\"}],\"references\":[\"Hernán & Robins (2020)\",\"Imbens & Rubin (2015)\"],\"see_also\":[{\"explain_key\":\"assumption.exchangeability\",\"explains\":\"Treated and untreated units are comparable once you condition on the confounders you measured. Everything that pushed people towards treatment and also moves the outcome is in your adjustment set.\",\"id\":\"exchangeability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Exchangeability / no unmeasured confounding\",\"worry_when\":\"Treatment was chosen by people who knew something about the likely outcome that you do not observe. Clinical judgement, self-selection into a programme, and administrative triage are the classic cases.\"},{\"explain_key\":\"assumption.positivity\",\"explains\":\"Every kind of unit had some chance of being treated and some chance of not being treated. Where that fails, there is no comparison to make and the model is inventing one.\",\"id\":\"positivity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Positivity / overlap\",\"worry_when\":\"Any single weight carries a large share of the total; the effective sample is far below the nominal one; the propensity model separates the arms almost perfectly; treated units sit outside the control group's range.\"},{\"explain_key\":\"guardrail.bad_control\",\"id\":\"guardrail.bad_control\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"Anything measured after treatment, or caused by it, does not belong in the adjustment set. Adjusting for it blocks part of the effect you are trying to measure.\",\"title\":\"Bad controls\"},{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"},{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"},{\"acronym\":\"ATC\",\"explain_key\":\"estimand.atc\",\"id\":\"ATC\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who didn't get it, what would it have done?\",\"title\":\"Average treatment effect on the controls\"},{\"acronym\":\"ATO\",\"explain_key\":\"estimand.ato\",\"id\":\"ATO\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For the people where treated and untreated genuinely overlap, what did it do?\",\"title\":\"Average treatment effect on the overlap population\"},{\"acronym\":\"CATE\",\"explain_key\":\"estimand.cate\",\"id\":\"CATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"How does the effect vary from person to person, or place to place?\",\"title\":\"Conditional average treatment effect\"},{\"acronym\":\"GATE\",\"explain_key\":\"estimand.gate\",\"id\":\"GATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"How does the effect vary across pre-specified groups?\",\"title\":\"Group average treatment effect\"},{\"acronym\":\"ADRF\",\"explain_key\":\"estimand.dose_response\",\"id\":\"dose_response\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If we changed the dose, how would the outcome change?\",\"title\":\"Average dose-response function\"},{\"explain_key\":\"method.bounds.manski\",\"id\":\"bounds.manski\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Report the range the effect must lie in given only what the data can support, without assuming away the missing counterfactual.\",\"title\":\"Manski bounds\"},{\"explain_key\":\"method.discovery.structure_learning\",\"id\":\"discovery.structure_learning\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Search for a graph consistent with the data. It does not recover the true causal structure from observational data without extra assumptions.\",\"title\":\"Structure learning (causal discovery)\"},{\"explain_key\":\"method.heterogeneity.binary\",\"id\":\"heterogeneity.binary\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Logistic interactions plus separate standardized risk-difference, risk-ratio or marginal odds-ratio heterogeneity tests.\",\"title\":\"Binary outcome heterogeneity\"},{\"explain_key\":\"method.heterogeneity.categorical\",\"id\":\"heterogeneity.categorical\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Multinomial treatment interactions and a joint test of category-probability contrasts; preserves categories without assigning numeric scores.\",\"title\":\"Nominal and ordinal outcome heterogeneity\"}],\"tags\":[\"ATT\",\"ATE\",\"ATC\",\"ATO\",\"CATE\",\"GATE\",\"ADRF\"],\"title\":\"Adjust for background differences\",\"what_it_assumes\":[{\"explain_key\":\"assumption.exchangeability\",\"explains\":\"Treated and untreated units are comparable once you condition on the confounders you measured. Everything that pushed people towards treatment and also moves the outcome is in your adjustment set.\",\"id\":\"exchangeability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Exchangeability / no unmeasured confounding\",\"worry_when\":\"Treatment was chosen by people who knew something about the likely outcome that you do not observe. Clinical judgement, self-selection into a programme, and administrative triage are the classic cases.\"},{\"explain_key\":\"assumption.positivity\",\"explains\":\"Every kind of unit had some chance of being treated and some chance of not being treated. Where that fails, there is no comparison to make and the model is inventing one.\",\"id\":\"positivity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Positivity / overlap\",\"worry_when\":\"Any single weight carries a large share of the total; the effective sample is far below the nominal one; the propensity model separates the arms almost perfectly; treated units sit outside the control group's range.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"design:observational\",\"kind\":\"design\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"observational\",\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:026b8be4f5b4318df687478a\",\"object_id\":\"estimand:GATE\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:observational\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:0a44445d526491d0edff82aa\",\"object_id\":\"discovery.structure_learning\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:observational\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:126eedc69bdc79cc15bb4946\",\"object_id\":\"heterogeneity.binary\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apac