\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"did.event_study\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:fa271073ca3e91787791329e\",\"object_id\":\"softwarepackage:fixest::feols with i(rel, ref = -1)\",\"predicate\":\"implemented_by\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"did.event_study\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Plot the effect period by period around adoption, so you can see whether the gap opened when the policy arrived or long before it.\",\"title\":\"Event study (leads and lags)\"}" .
<urn:capy:did.gardner_2s> a capy:method ; skos:prefLabel "Two-stage DiD (Gardner / Wooldridge-Mundlak)" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:did.gardner_2s\"],\"catalogue_key\":\"method:did.gardner_2s\",\"citation_ids\":[\"10.2139/ssrn.3906345\",\"source:unresolved:8060396d0111d6160836\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":null,\"engines\":{\"python\":true,\"r\":\"did2s (or etwfe)\"},\"needs_r_packages\":[\"did2s (or etwfe)\"],\"runs_here\":true,\"summary\":\"Runs on this computer with what the app already installs.\"},\"designs\":[{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.raw_means\",\"id\":\"raw_means\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Raw means by cohort and period\"},{\"explain_key\":\"diagnostic.adoption\",\"id\":\"adoption\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Adoption pattern\"},{\"explain_key\":\"diagnostic.panel_balance\",\"id\":\"panel_balance\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Panel balance\"},{\"explain_key\":\"diagnostic.comparison_group\",\"id\":\"comparison_group\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Comparison group used\"},{\"explain_key\":\"diagnostic.cohort_att\",\"id\":\"cohort_att\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Cohort effects\"},{\"explain_key\":\"diagnostic.event_study\",\"id\":\"event_study\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Event study\"},{\"explain_key\":\"diagnostic.pre_trends\",\"id\":\"pre_trends\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Pre-trend test\"},{\"explain_key\":\"diagnostic.imputation_fit\",\"id\":\"imputation_fit\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Untreated-cell model fit\"}],\"estimands\":[{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"},{\"acronym\":\"ATT(g,t)\",\"explain_key\":\"estimand.cohort_att\",\"id\":\"cohort_ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For each group that adopted it, what did their own rollout do?\",\"title\":\"Group-time average treatment effect\"}],\"explain_key\":\"method.did.gardner_2s\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\",\"some of the robustness probes it names have no card of their own yet\"],\"id\":\"did.gardner_2s\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":false,\"one_liner\":\"Strip out unit and period effects using untreated cells only, then regress what is left on the policy.\",\"options\":[{\"choices\":[\"additive\",\"by_period\"],\"default\":\"by_period\",\"help\":\"Additive shifts the untreated path by a constant. By period lets each covariate matter differently in each period, which is the Wooldridge-Mundlak form and much more flexible -- and much hungrier for data.\",\"label\":\"How covariates enter the comparison model\",\"name\":\"covariate_mode\",\"profile\":\"advanced\",\"type\":\"select\"},{\"default\":3,\"help\":\"The comparison model is fitted on the pre-period, so pre-period 'effects' are near zero by construction unless some periods are held out. These held-out periods are what the parallel-trends test is actually run on. Units that would lose their last untreated period keep it.\",\"label\":\"Pre-adoption periods to hold out for testing\",\"max\":20,\"min\":0,\"name\":\"pre_test_periods\",\"profile\":\"standard\",\"type\":\"int\"},{\"default\":12,\"help\":\"Anything later is pooled into the last point, so no observation is dropped.\",\"label\":\"Periods after adoption to show separately\",\"max\":60,\"min\":0,\"name\":\"max_lag\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":0.95,\"help\":\"Width of the interval reported next to the estimate.\",\"label\":\"Confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"}],\"plain_language\":\"Strip out unit and period effects using untreated cells only, then regress what is left on the policy.\",\"probes\":[{\"explain_key\":\"probe.placebo_outcome\",\"id\":\"probe.placebo_outcome\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the same analysis on something the treatment could not have changed. It should find nothing.\",\"requested_as\":\"placebo_outcome\",\"title\":\"Placebo outcome\"},{\"explain_key\":null,\"id\":\"placebo_period\",\"in_catalogue\":false,\"kind\":\"probe\",\"one_liner\":null,\"requested_as\":\"placebo_period\",\"title\":\"Placebo period\"},{\"explain_key\":null,\"id\":\"leave_one_cohort_out\",\"in_catalogue\":false,\"kind\":\"probe\",\"one_liner\":null,\"requested_as\":\"leave_one_cohort_out\",\"title\":\"Leave one adoption cohort out\"},{\"explain_key\":\"probe.honest_did\",\"id\":\"probe.honest_did\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"What survives when parallel trends is allowed to fail by a stated amount.\",\"requested_as\":\"honest_did\",\"title\":\"Honest DiD (Rambachan-Roth)\"},{\"explain_key\":\"probe.alternate_spec\",\"id\":\"probe.alternate_spec\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the grid of defensible specifications and sort the answers. The curve is the result, not the one you happened to run.\",\"requested_as\":\"alternate_spec\",\"title\":\"Specification curve\"}],\"references\":[\"Gardner (2022), Two-stage differences in differences\",\"Wooldridge (2021), Two-way fixed effects, the two-way Mundlak regression, and difference-in-differences estimators\"],\"roles_forbidden\":[\"a running variable\",\"an instrument\"],\"roles_optional\":[\"a clustering variable\",\"at least one measured confounder\",\"weight\"],\"roles_required\":[\"a treatment\",\"an outcome\",\"a unit id\",\"a time variable\"],\"see_also\":[{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"},{\"explain_key\":\"method.did.bjs_imputation\",\"id\":\"did.bjs_imputation\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Learn what untreated life looks like from untreated cells only, then ask how far each treated cell landed from it.\",\"title\":\"Imputation (Borusyak-Jaravel-Spiess)\"},{\"explain_key\":\"method.did.callaway_santanna\",\"id\":\"did.callaway_santanna\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Estimate one clean before-and-after for every adoption cohort, then say out loud how you averaged them.\",\"title\":\"Callaway & Sant'Anna group-time effects\"},{\"explain_key\":\"method.did.chaisemartin\",\"id\":\"did.chaisemartin\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"An estimator built for panels where treatment switches on and off, which the imputation and cohort estimators assume never happens.\",\"title\":\"de Chaisemartin & D'Haultfoeuille\"},{\"explain_key\":\"method.did.dr_did\",\"id\":\"did.dr_did\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"One before-and-after with covariates, using an outcome model and a comparison-group model together so either one can carry it.\",\"title\":\"Doubly robust DiD\"},{\"explain_key\":\"method.did.event_study\",\"id\":\"did.event_study\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Plot the effect period by period around adoption, so you can see whether the gap opened when the policy arrived or long before it.\",\"title\":\"Event study (leads and lags)\"},{\"explain_key\":\"method.did.goodman_bacon\",\"id\":\"did.goodman_bacon\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Open up a two-way fixed effects estimate and show every two-group comparison inside it, with the weight each one carries -- including the ones that use already-treated units as controls.\",\"title\":\"Goodman-Bacon decomposition\"}],\"status\":\"reasonable\",\"status_label\":\"Reasonable\",\"tags\":[\"Policy rolled out over time\",\"ATT\",\"ATT(g,t)\",\"Reasonable\"],\"title\":\"Two-stage DiD (Gardner / Wooldridge-Mundlak)\",\"what_it_assumes\":[{\"explain_key\":\"assumption.parallel_trends\",\"explains\":\"Without the policy, treated and comparison groups would have moved the same way. Not that they were at the same level -- that their paths would have been parallel.\",\"id\":\"parallel_trends\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Parallel trends\",\"worry_when\":\"Pre-period event-study coefficients drift away from zero; the policy was adopted because outcomes were already moving; the groups differ in composition in ways that interact with time.\"},{\"explain_key\":\"assumption.no_anticipation\",\"explains\":\"Units did not change behaviour before treatment arrived because they knew it was coming.\",\"id\":\"no_anticipation\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No anticipation\",\"worry_when\":\"There was a public announcement well before the policy started, or the pre-period coefficients move in the period immediately before adoption.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"when_not_to_use\":[\"The second stage is a regression on residuals from a first stage, so its ordinary standard error is too small; the correction is applied here, but any tool that skips it will look more precise than it is. With no covariates it is numerically the imputation estimator, so reporting both as independent confirmation would be double counting.\"],\"when_to_use\":[\"It looks and reads like the regression people expect, but the fixed effects are learned where the policy is off, so treated cells cannot bend them. Covariates can enter period by period, which is the Wooldridge-Mundlak form that handles covariate-specific trends.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\",\"some of the robustness probes it names have no card of their own yet\"],\"id\":\"did.gardner_2s\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"did.gardner_2s\",\"registry\":{\"designs\":[\"did\"],\"diagnostics\":[\"raw_means\",\"adoption\",\"panel_balance\",\"comparison_group\",\"cohort_att\",\"event_study\",\"pre_trends\",\"imputation_fit\"],\"disrecommend_when\":null,\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":true,\"r\":\"did2s (or etwfe)\"},\"estimands\":[\"ATT\",\"cohort_ATT\"],\"explain_key\":\"method.did.gardner_2s\",\"id\":\"did.gardner_2s\",\"needs\":[\"numpy\",\"scipy\",\"pandas\"],\"needs_overlap\":false,\"one_liner\":\"Strip out unit and period effects using untreated cells only, then regress what is left on the policy.\",\"options\":[{\"choices\":[\"additive\",\"by_period\"],\"default\":\"by_period\",\"help\":\"Additive shifts the untreated path by a constant. By period lets each covariate matter differently in each period, which is the Wooldridge-Mundlak form and much more flexible -- and much hungrier for data.\",\"label\":\"How covariates enter the comparison model\",\"name\":\"covariate_mode\",\"profile\":\"advanced\",\"type\":\"select\"},{\"default\":3,\"help\":\"The comparison model is fitted on the pre-period, so pre-period 'effects' are near zero by construction unless some periods are held out. These held-out periods are what the parallel-trends test is actually run on. Units that would lose their last untreated period keep it.\",\"label\":\"Pre-adoption periods to hold out for testing\",\"max\":20,\"min\":0,\"name\":\"pre_test_periods\",\"profile\":\"standard\",\"type\":\"int\"},{\"default\":12,\"help\":\"Anything later is pooled into the last point, so no observation is dropped.\",\"label\":\"Periods after adoption to show separately\",\"max\":60,\"min\":0,\"name\":\"max_lag\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":0.95,\"help\":\"Width of the interval reported next to the estimate.\",\"label\":\"Confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"}],\"probes\":[\"placebo_outcome\",\"placebo_period\",\"leave_one_cohort_out\",\"honest_did\",\"alternate_spec\"],\"reference_dispositions\":[{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:8060396d0111d6160836\",\"requested_as\":\"Gardner (2022), Two-stage differences in differences\"},{\"disposition\":\"resolved_metadata\",\"id\":\"10.2139/ssrn.3906345\",\"requested_as\":\"Wooldridge (2021), Two-way fixed effects, the two-way Mundlak regression, and difference-in-differences estimators\"}],\"reference_ids\":[\"source:unresolved:8060396d0111d6160836\",\"10.2139/ssrn.3906345\"],\"references\":[\"Gardner (2022), Two-stage differences in differences\",\"Wooldridge (2021), Two-way fixed effects, the two-way Mundlak regression, and difference-in-differences estimators\"],\"roles_forbidden\":[\"running\",\"instruments\"],\"roles_optional\":[\"cluster\",\"confounders\",\"weight\"],\"roles_required\":[\"treatment\",\"outcome\",\"unit\",\"time\"],\"source_path\":\"engines/python/capy_py/did_modern.py\",\"source_sha256\":\"f5546f580cd2c75174a6cb550cf3b66ca1a008151067f52513cafaa766ebfe16\",\"status\":\"reasonable\",\"title\":\"Two-stage DiD (Gardner / Wooldridge-Mundlak)\",\"what_can_go_wrong\":\"The second stage is a regression on residuals from a first stage, so its ordinary standard error is too small; the correction is applied here, but any tool that skips it will look more precise than it is. With no covariates it is numerically the imputation estimator, so reporting both as independent confirmation would be double counting.\",\"why_recommended\":\"It looks and reads like the regression people expect, but the fixed effects are learned where the policy is off, so treated cells cannot bend them. Covariates can enter period by period, which is the Wooldridge-Mundlak form that handles covariate-specific trends.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:0813b6d23ae5c7a34e033138\",\"object_id\":\"softwarepackage:did2s (or etwfe)\",\"predicate\":\"implemented_by\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"did.gardner_2s\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:0ca32e1e169c18085a09bd04\",\"object_id\":\"diagnostic:raw_means\",\"predicate\":\"checked_by_diagnostic\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"did.gardner_2s\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:0d88869ac2595c9e8ad50ed9\",\"object_id\":\"concept:donor-pool\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"abadie2010\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"d