\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"probe.add_unobserved_confounder\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:ec8ecd0eafded01ed6dd4c35\",\"object_id\":\"design:observational\",\"predicate\":\"compatible_with_design\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"probe.add_unobserved_confounder\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:ee71926ed24d8839f8b88a0c\",\"object_id\":\"source:unresolved:819d130bff0fe2451d5d\",\"predicate\":\"cites\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"probe.add_unobserved_confounder\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:efd5c92f6c8e7fed1c213ef0\",\"object_id\":\"assumption:donor_fit\",\"predicate\":\"requires_assumption\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"probe.add_unobserved_confounder\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:f50a2a4325b1613a3651422e\",\"object_id\":\"assumption:no_anticipation\",\"predicate\":\"requires_assumption\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"probe.add_unobserved_confounder\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:ff8c51c7ee0e78a5f473df9d\",\"object_id\":\"design:longitudinal\",\"predicate\":\"compatible_with_design\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"probe.add_unobserved_confounder\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Simulate a common cause of a stated strength and watch the estimate move; read off how strong one would have to be to explain the result away.\",\"title\":\"Unobserved confounder\"}" .
<urn:capy:probe.alternate_spec> a capy:probe ; skos:prefLabel "Specification curve" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"probe:probe.alternate_spec\"],\"catalogue_key\":\"probe:probe.alternate_spec\",\"citation_ids\":[\"10.1038/s41562-020-0912-z\",\"10.1177/1745691616658637\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":null,\"engines\":{\"python\":true,\"r\":\"specr\"},\"needs_r_packages\":[\"specr\"],\"runs_here\":true,\"summary\":\"Runs on this computer with what the app already installs.\"},\"designs\":[{\"explain_key\":\"design.rct\",\"id\":\"rct\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"People were assigned by chance, or as good as chance.\",\"title\":\"Randomised or as-if randomised\"},{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"},{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"},{\"explain_key\":\"design.rd\",\"id\":\"rd\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Crossing a score, age, or border switched the programme on.\",\"title\":\"A cutoff decided eligibility\"},{\"explain_key\":\"design.iv\",\"id\":\"iv\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"An instrument or encouragement changed treatment, not the outcome directly.\",\"title\":\"Something else pushed people in\"},{\"explain_key\":\"design.synth\",\"id\":\"synth\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"One treated unit; build a comparison from a donor pool.\",\"title\":\"One place, constructed twin\"},{\"explain_key\":\"design.its\",\"id\":\"its\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Before versus after an interruption; maybe a control series.\",\"title\":\"A shock in a single series\"},{\"explain_key\":\"design.mediation\",\"id\":\"mediation\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"We care about a mediator, not only the total effect.\",\"title\":\"How it worked (pathways)\"},{\"explain_key\":\"design.longitudinal\",\"id\":\"longitudinal\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"The same person is treated, untreated, treated again; confounders also move.\",\"title\":\"Treatment that changes over time\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.spec_curve\",\"id\":\"spec_curve\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Specification curve\"},{\"explain_key\":\"diagnostic.probe_runs\",\"id\":\"probe_runs\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Probe runs\"}],\"estimands\":[{\"acronym\":null,\"explain_key\":null,\"id\":\"inherited\",\"in_catalogue\":false,\"kind\":\"estimand\",\"one_liner\":null,\"title\":\"Whichever effect the method it is applied to targets\"}],\"explain_key\":\"probe.alternate_spec\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\",\"targets Whichever effect the method it is applied to targets, which the estimand catalogue does not define yet\"],\"id\":\"probe.alternate_spec\",\"in_more_depth\":null,\"kind\":\"probe\",\"needs_overlap\":false,\"one_liner\":\"Run the grid of defensible specifications and sort the answers. The curve is the result, not the one you happened to run.\",\"options\":[{\"default\":[],\"help\":\"A list of option sets. Each entry may also carry a 'label' and a 'roles' block, so covariate sets and samples vary alongside the options.\",\"label\":\"Specifications to run\",\"name\":\"grid\",\"profile\":\"standard\",\"type\":\"object[]\"},{\"default\":null,\"help\":\"The method id of the analysis this probe refutes. The app fills this in from the result card you launched the probe from.\",\"label\":\"Analysis being probed\",\"name\":\"parent_method\",\"profile\":\"advanced\",\"type\":\"string\"},{\"default\":{},\"help\":\"Passed through to every re-run so the probe compares like with like. The app fills this in; parent_estimate, parent_se and parent_run_id come with it.\",\"label\":\"Options the analysis was run with\",\"name\":\"parent_options\",\"profile\":\"advanced\",\"type\":\"object\"}],\"plain_language\":\"Run the grid of defensible specifications and sort the answers. The curve is the result, not the one you happened to run.\",\"probes\":[],\"references\":[\"Simonsohn, Simmons & Nelson (2020), Specification curve analysis\",\"Steegen et al. (2016), Increasing transparency through a multiverse analysis\"],\"roles_forbidden\":[],\"roles_optional\":[\"at least one measured confounder\",\"a unit id\",\"a time variable\",\"a clustering variable\",\"strata\",\"weight\",\"an instrument\",\"a running variable\",\"donor_pool\"],\"roles_required\":[\"a treatment\",\"an outcome\"],\"see_also\":[{\"explain_key\":\"design.rct\",\"id\":\"rct\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"People were assigned by chance, or as good as chance.\",\"title\":\"Randomised or as-if randomised\"},{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"},{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"},{\"explain_key\":\"design.rd\",\"id\":\"rd\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Crossing a score, age, or border switched the programme on.\",\"title\":\"A cutoff decided eligibility\"},{\"explain_key\":\"design.iv\",\"id\":\"iv\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"An instrument or encouragement changed treatment, not the outcome directly.\",\"title\":\"Something else pushed people in\"},{\"explain_key\":\"design.synth\",\"id\":\"synth\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"One treated unit; build a comparison from a donor pool.\",\"title\":\"One place, constructed twin\"},{\"explain_key\":\"design.its\",\"id\":\"its\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Before versus after an interruption; maybe a control series.\",\"title\":\"A shock in a single series\"},{\"explain_key\":\"design.mediation\",\"id\":\"mediation\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"We care about a mediator, not only the total effect.\",\"title\":\"How it worked (pathways)\"},{\"explain_key\":\"design.longitudinal\",\"id\":\"longitudinal\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"The same person is treated, untreated, treated again; confounders also move.\",\"title\":\"Treatment that changes over time\"}],\"status\":\"recommended\",\"status_label\":\"Recommended\",\"tags\":[\"Randomised or as-if randomised\",\"Adjust for background differences\",\"Policy rolled out over time\",\"A cutoff decided eligibility\",\"Something else pushed people in\",\"One place, constructed twin\",\"A shock in a single series\",\"How it worked (pathways)\",\"Treatment that changes over time\",\"Whichever effect the method it is applied to targets\",\"Recommended\"],\"title\":\"Specification curve\",\"what_it_assumes\":[{\"explain_key\":\"assumption.randomisation\",\"explains\":\"Assignment really was by chance, and nothing after assignment broke the comparison -- no differential dropout, no crossover you have not modelled.\",\"id\":\"randomisation\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Randomisation held\",\"worry_when\":\"Dropout differs across arms; take-up is far from assignment; the randomiser was a person with discretion.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"},{\"explain_key\":\"assumption.exchangeability\",\"explains\":\"Treated and untreated units are comparable once you condition on the confounders you measured. Everything that pushed people towards treatment and also moves the outcome is in your adjustment set.\",\"id\":\"exchangeability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Exchangeability / no unmeasured confounding\",\"worry_when\":\"Treatment was chosen by people who knew something about the likely outcome that you do not observe. Clinical judgement, self-selection into a programme, and administrative triage are the classic cases.\"},{\"explain_key\":\"assumption.positivity\",\"explains\":\"Every kind of unit had some chance of being treated and some chance of not being treated. Where that fails, there is no comparison to make and the model is inventing one.\",\"id\":\"positivity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Positivity / overlap\",\"worry_when\":\"Any single weight carries a large share of the total; the effective sample is far below the nominal one; the propensity model separates the arms almost perfectly; treated units sit outside the control group's range.\"},{\"explain_key\":\"assumption.parallel_trends\",\"explains\":\"Without the policy, treated and comparison groups would have moved the same way. Not that they were at the same level -- that their paths would have been parallel.\",\"id\":\"parallel_trends\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Parallel trends\",\"worry_when\":\"Pre-period event-study coefficients drift away from zero; the policy was adopted because outcomes were already moving; the groups differ in composition in ways that interact with time.\"},{\"explain_key\":\"assumption.no_anticipation\",\"explains\":\"Units did not change behaviour before treatment arrived because they knew it was coming.\",\"id\":\"no_anticipation\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No anticipation\",\"worry_when\":\"There was a public announcement well before the policy started, or the pre-period coefficients move in the period immediately before adoption.\"},{\"explain_key\":\"assumption.no_manipulation\",\"explains\":\"People could not precisely control which side of the cutoff they landed on.\",\"id\":\"no_manipulation\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No manipulation of the running variable\",\"worry_when\":\"A visible spike or gap in the density at the cutoff; covariates that jump; a cutoff that people knew about and had time to respond to.\"},{\"explain_key\":\"assumption.continuity\",\"explains\":\"Everything else that affects the outcome changes smoothly through the cutoff, so the only thing that jumps is the treatment.\",\"id\":\"continuity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Continuity of potential outcomes at the cutoff\",\"worry_when\":\"Several rules share the threshold; the running variable is coarse, so \\\"at the cutoff\\\" is really a wide band; the estimate depends heavily on the bandwidth.\"},{\"explain_key\":\"assumption.relevance\",\"explains\":\"The instrument actually moves treatment, and moves it enough that the resulting estimate is not mostly noise.\",\"id\":\"relevance\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Instrument relevance\",\"worry_when\":\"An effective F below about 10; a first-stage coefficient that is substantively tiny even if statistically significant; many instruments.\"},{\"explain_key\":\"assumption.exclusion\",\"explains\":\"The instrument affects the outcome only through the treatment. On the board, that is the arrow you did not draw.\",\"id\":\"exclusion\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Exclusion restriction\",\"worry_when\":\"The instrument is a policy that changed several things at once; it is correlated with geography, time or institutions that have their own effects; it was chosen because it predicted the outcome.\"},{\"explain_key\":\"assumption.monotonicity\",\"explains\":\"The instrument pushes everyone the same way, or not at all. Nobody takes the treatment only because they were discouraged from it.\",\"id\":\"monotonicity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Monotonicity / no defiers\",\"worry_when\":\"The instrument is an incentive that could plausibly backfire for some people, or it is a judge or examiner whose leniency ordering differs across case types.\"},{\"explain_key\":\"assumption.donor_fit\",\"explains\":\"The weighted combination of untreated units reproduces the treated unit's pre-period path closely enough to stand in for it afterwards.\",\"id\":\"donor_fit\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Pre-treatment fit from the donor pool\",\"worry_when\":\"Visible pre-period gaps; a short pre-period relative to the number of donors; one donor carrying most of the weight.\"},{\"explain_key\":\"assumption.convex_hull\",\"explains\":\"The treated unit's characteristics can be written as a weighted average of the donors', with weights that do not go negative.\",\"id\":\"convex_hull\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Treated unit inside the donor convex hull\",\"worry_when\":\"The treated unit is at an extreme of the donor distribution on the predictors, or the pre-period gap has a persistent level offset.\"},{\"explain_key\":\"assumption.no_cointerventions\",\"explains\":\"Nothing else changed at the same moment that also moves the outcome.\",\"id\":\"no_cointerventions\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No co-interventions at the interruption\",\"worry_when\":\"A busy policy period; a national event at the same date; a change in how the outcome was measured or coded at the same date.\"},{\"explain_key\":\"assumption.model_form\",\"explains\":\"The line you fit before the interruption is the line the outcome would have continued to follow.\",\"id\":\"model_form\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Functional form of the counterfactual trend\",\"worry_when\":\"Few pre-period points; residual autocorrelation that survives the model; the estimate flips when you add a seasonal term or a quadratic trend.\"},{\"explain_key\":\"assumption.sequential_ignorability\",\"explains\":\"No unmeasured confounding of the treatment-outcome relationship, and none of the mediator-outcome relationship either, even after conditioning on treatment.\",\"id\":\"sequential_ignorability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Sequential ignorability\",\"worry_when\":\"There is a variable affected by treatment that also confounds the mediator-outcome relationship. Under that structure the natural effects are not identified at all.\"},{\"explain_key\":\"assumption.no_time_varying_confounding\",\"explains\":\"At every period, the things that drive the treatment decision and also affect the outcome are measured -- and measured before that decision.\",\"id\":\"no_time_varying_confounding\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No unmeasured time-varying confounding\",\"worry_when\":\"Clinical measurements taken after the dose was changed; employment status recorded at the end of a period used to explain treatment at its start.\"}],\"when_not_to_use\":[\"A grid chosen after seeing the answers is not a specification curve. Decide the grid first, and include the specifications you would not have chosen.\"],\"when_to_use\":[\"It replaces the appendix table nobody reads with the picture that actually settles the argument: every defensible choice, sorted.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\",\"targets Whichever effect the method it is applied to targets, which the estimand catalogue does not define yet\"],\"id\":\"probe.alternate_spec\",\"kind\":\"probe\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"probe.alternate_spec\",\"registry\":{\"designs\":[\"rct\",\"observational\",\"did\",\"rd\",\"iv\",\"synth\",\"its\",\"mediation\",\"longitudinal\"],\"diagnostics\":[\"spec_curve\",\"probe_runs\"],\"disrecommend_when\":null,\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":true,\"r\":\"specr\"},\"estimands\":[\"inherited\"],\"explain_key\":\"probe.alternate_spec\",\"id\":\"probe.alternate_spec\",\"needs\":[\"numpy\",\"pandas\"],\"needs_overlap\":false,\"one_liner\":\"Run the grid of defensible specifications and sort the answers. The curve is the result, not the one you happened to run.\",\"options\":[{\"default\":[],\"help\":\"A list of option sets. Each entry may also carry a 'label' and a 'roles' block, so covariate sets and samples vary alongside the options.\",\"label\":\"Specifications to run\",\"name\":\"grid\",\"profile\":\"standard\",\"type\":\"object[]\"},{\"default\":null,\"help\":\"The method id of the analysis this probe refutes. The app fills this in from the result card you launched the probe from.\",\"label\":\"Analysis being probed\",\"name\":\"parent_method\",\"profile\":\"advanced\",\"type\":\"string\"},{\"default\":{},\"help\":\"Passed through to every re-run so the probe compares like with like. The app fills this in; parent_estimate, parent_se and parent_run_id come with it.\",\"label\":\"Options the analysis was run with\",\"name\":\"parent_options\",\"profile\":\"advanced\",\"type\":\"object\"}],\"probes\":[],\"reference_dispositions\":[{\"disposition\":\"resolved_metadata\",\"id\":\"10.1038/s41562-020-0912-z\",\"requested_as\":\"Simonsohn, Simmons & Nelson (2020), Specification curve analysis\"},{\"disposition\":\"resolved_metadata\",\"id\":\"10.1177/1745691616658637\",\"requested_as\":\"Steegen et al. (2016), Increasing transparency through a multiverse analysis\"}],\"reference_ids\":[\"10.1038/s41562-020-0912-z\",\"10.1177/1745691616658637\"],\"references\":[\"Simonsohn, Simmons & Nelson (2020), Specification curve analysis\",\"Steegen et al. (2016), Increasing transparency through a multiverse analysis\"],\"roles_forbidden\":[],\"roles_optional\":[\"confounders\",\"unit\",\"time\",\"cluster\",\"strata\",\"weight\",\"instruments\",\"running\",\"donor_pool\"],\"roles_required\":[\"treatment\",\"outcome\"],\"source_path\":\"engines/python/capy_py/probes.py\",\"source_sha256\":\"f732e2c12a9530b309565b36a91b862fdc23debccbafde2c7a3ecdf9aba34006\",\"status\":\"recommended\",\"title\":\"Specification curve\",\"what_can_go_wrong\":\"A grid chosen after seeing the answers is not a specification curve. Decide the grid first, and include the specifications you would not have chosen.\",\"why_recommended\":\"It replaces the appendix table nobody reads with the picture that actually settles the argument: every defensible choice, sorted.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:03ef627f6bde982bdf