dit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Citation and original explanation; linked external bodies are not included.\",\"subject_id\":\"claim:categorical-outcome-interaction\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Sampling covariance and prediction target must match the declared null.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:e81b9bf7769d7288634112f8\",\"object_id\":\"heterogeneity.categorical\",\"predicate\":\"qualifies\",\"provenance\":[\"source:note:categorical-outcome-interaction\",\"source:ontology:statsmodels-mnlogit\",\"source:ontology:statsmodels-wald\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"subject_id\":\"claim:categorical-outcome-interaction\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"source_ids\":[\"source:note:categorical-outcome-interaction\",\"source:ontology:statsmodels-mnlogit\",\"source:ontology:statsmodels-wald\"],\"summary\":\"A multinomial model represents a probability for each outcome category. Nominal labels are not numerical scores; applying this model to ordered labels does not impose proportional odds or estimate a common ordinal shift. Category probabilities sum to one, so joint tests must account for their dependent contrasts.\",\"title\":\"Categorical-outcome probability heterogeneity\"}" .
<urn:capy:claim%3Acausal-framing> a capy:claim ; skos:prefLabel "Causal framing requires an identification argument" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Acausal-framing> ; capy:record "{\"aliases\":[\"causal framing\",\"causal identification\",\"association prediction\",\"regression balance fitted model intervention\"],\"assertion_mode\":\"original_editorial_explanation\",\"citation_ids\":[\"source:note:causal-framing\",\"source:ontology:ich2019\",\"source:ontology:pearl2009\",\"source:ontology:rubin2008\"],\"citations\":[],\"conditions\":[\"A defensible design and identification argument are needed for causal interpretation.\"],\"counterevidence\":[\"The related diagnostic, fitted model or software check cannot establish all causal assumptions.\"],\"evidence_ids\":[\"evidence:causal-framing\"],\"gaps\":[\"Independent human review and empirical study-specific identification evidence are absent.\"],\"id\":\"claim:causal-framing\",\"kind\":\"claim\",\"provenance\":[\"source:note:causal-framing\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:277e653ab7e1ca89e68432e7\",\"object_id\":\"source:ontology:ich2019\",\"predicate\":\"cites\",\"provenance\":[\"source:note:causal-framing\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:pearl2009\",\"source:ontology:ich2019\",\"source:ontology:rubin2008\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\