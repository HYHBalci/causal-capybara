\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"rct.diff_means\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:f1d6f61b9ff45ed40d71fe4c\",\"object_id\":\"10.1016/j.aam.2006.12.003\",\"predicate\":\"cites\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"rct.diff_means\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:f3e9f713aa9cd5a458d96a2e\",\"object_id\":\"concept:interrupted-time-series\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:hernan2016\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"rct.diff_means\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:ff6c6e68be59c03515b62f5e\",\"object_id\":\"assumption:sutva\",\"predicate\":\"requires_assumption\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"rct.diff_means\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Compare the two arms as they were randomised, and let covariates sharpen the comparison without letting them change the question.\",\"title\":\"Difference in means\"}" .
<urn:capy:rct.randomization_inference> a capy:method ; skos:prefLabel "Randomisation (Fisher) inference" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:rct.randomization_inference\"],\"catalogue_key\":\"method:rct.randomization_inference\",\"citation_ids\":[\"10.2307/2277749\",\"source:unresolved:066a5821b64a698d3413\",\"source:unresolved:12d5c830da10862dd1b8\",\"source:unresolved:ce9275187e1e2526448d\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":null,\"engines\":{\"python\":true,\"r\":\"ri2, coin\"},\"needs_r_packages\":[\"ri2, coin\"],\"runs_here\":true,\"summary\":\"Runs on this computer with what the app already installs.\"},\"designs\":[{\"explain_key\":\"design.rct\",\"id\":\"rct\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"People were assigned by chance, or as good as chance.\",\"title\":\"Randomised or as-if randomised\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.permutation_distribution\",\"id\":\"permutation_distribution\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Randomisation distribution\"},{\"explain_key\":\"diagnostic.baseline_balance\",\"id\":\"baseline_balance\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Baseline balance\"},{\"explain_key\":\"diagnostic.differential_attrition\",\"id\":\"differential_attrition\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Differential attrition\"},{\"explain_key\":\"diagnostic.outcome_distribution\",\"id\":\"outcome_distribution\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Outcome distribution\"}],\"estimands\":[{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"},{\"acronym\":\"ITT\",\"explain_key\":\"estimand.itt\",\"id\":\"ITT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For everyone who was offered it, what did the offer do?\",\"title\":\"Intention to treat\"}],\"explain_key\":\"method.rct.randomization_inference\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"rct.randomization_inference\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":false,\"one_liner\":\"Re-run the randomisation thousands of times with the outcomes held fixed, and see how unusual what actually happened really is.\",\"options\":[{\"default\":2000,\"help\":\"More draws make the p-value less noisy, not more valid; the p-value is exact at any number.\",\"label\":\"Permutations\",\"max\":200000,\"min\":99,\"name\":\"reps\",\"profile\":\"standard\",\"type\":\"int\"},{\"choices\":[\"diff_means\",\"welch_t\",\"rank_sum\"],\"default\":\"diff_means\",\"help\":\"The difference in means is the usual choice. The rank sum is far less sensitive to a few extreme outcomes; the studentised statistic behaves better when the arms have very different variances.\",\"label\":\"Test statistic\",\"name\":\"statistic\",\"profile\":\"standard\",\"type\":\"select\"},{\"choices\":[\"two_sided\",\"greater\",\"less\"],\"default\":\"two_sided\",\"help\":\"One-sided tests must be chosen before seeing the data.\",\"label\":\"Alternative\",\"name\":\"alternative\",\"profile\":\"advanced\",\"type\":\"select\"},{\"default\":true,\"help\":\"Searches for the constant treatment effects the test does not reject. That interval assumes the same effect for every unit, which is a stronger claim than the point estimate makes.\",\"label\":\"Interval by test inversion\",\"name\":\"invert_ci\",\"profile\":\"advanced\",\"type\":\"bool\"},{\"default\":0.95,\"help\":\"The coverage of the interval reported next to the estimate.\",\"label\":\"Confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"}],\"plain_language\":\"Re-run the randomisation thousands of times with the outcomes held fixed, and see how unusual what actually happened really is.\",\"probes\":[{\"explain_key\":\"probe.placebo_outcome\",\"id\":\"probe.placebo_outcome\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the same analysis on something the treatment could not have changed. It should find nothing.\",\"requested_as\":\"placebo_outcome\",\"title\":\"Placebo outcome\"},{\"explain_key\":\"probe.placebo_treatment\",\"id\":\"probe.placebo_treatment\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Move the policy date earlier, reshuffle who was treated, or swap in a variable that cannot cause the outcome.\",\"requested_as\":\"placebo_treatment\",\"title\":\"Placebo treatment\"},{\"explain_key\":\"probe.subset\",\"id\":\"probe.subset\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Re-estimate on random subsets. The answer should move about as much as losing that much data costs, and no more.\",\"requested_as\":\"subset_refuter\",\"title\":\"Subset stability\"},{\"explain_key\":\"probe.alternate_spec\",\"id\":\"probe.alternate_spec\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the grid of defensible specifications and sort the answers. The curve is the result, not the one you happened to run.\",\"requested_as\":\"alternate_spec\",\"title\":\"Specification curve\"}],\"references\":[\"Fisher (1935), The Design of Experiments\",\"Rosenbaum (2002), Observational Studies, chapter 2\",\"Imbens and Rubin (2015), Causal Inference for Statistics, Social, and Biomedical Sciences, chapter 5\",\"Gerber and Green (2012), Field Experiments: Design, Analysis, and Interpretation\"],\"roles_forbidden\":[\"an instrument\",\"a running variable\"],\"roles_optional\":[\"strata\",\"a clustering variable\",\"at least one measured confounder\"],\"roles_required\":[\"a treatment\",\"an outcome\"],\"see_also\":[{\"explain_key\":\"design.rct\",\"id\":\"rct\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"People were assigned by chance, or as good as chance.\",\"title\":\"Randomised or as-if randomised\"},{\"explain_key\":\"method.bounds.manski\",\"id\":\"bounds.manski\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Report the range the effect must lie in given only what the data can support, without assuming away the missing counterfactual.\",\"title\":\"Manski bounds\"},{\"explain_key\":\"method.interference.exposure\",\"id\":\"interference.exposure\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"When one unit's treatment affects another's outcome, estimate the direct and spillover effects separately instead of pretending neither exists.\",\"title\":\"Interference and spillovers\"},{\"explain_key\":\"method.rct.cace\",\"id\":\"rct.cace\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Not everyone offered a programme takes it. Report what the offer did, and separately what taking it up did for the people it moved.\",\"title\":\"ITT and CACE (noncompliance)\"},{\"explain_key\":\"method.rct.cluster\",\"id\":\"rct.cluster\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"When whole schools, clinics or villages were assigned, the number of clusters is the sample size that matters.\",\"title\":\"Cluster-randomised trial\"},{\"explain_key\":\"method.rct.diff_means\",\"id\":\"rct.diff_means\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Compare the two arms as they were randomised, and let covariates sharpen the comparison without letting them change the question.\",\"title\":\"Difference in means\"},{\"explain_key\":\"method.rct.stratified\",\"id\":\"rct.stratified\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Estimate inside the blocks the randomisation was run in, then average them the way your estimand says to.\",\"title\":\"Blocked or stratified experiment\"}],\"status\":\"recommended\",\"status_label\":\"Recommended\",\"tags\":[\"Randomised or as-if randomised\",\"ATE\",\"ITT\",\"Recommended\"],\"title\":\"Randomisation (Fisher) inference\",\"what_it_assumes\":[{\"explain_key\":\"assumption.randomisation\",\"explains\":\"Assignment really was by chance, and nothing after assignment broke the comparison -- no differential dropout, no crossover you have not modelled.\",\"id\":\"randomisation\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Randomisation held\",\"worry_when\":\"Dropout differs across arms; take-up is far from assignment; the randomiser was a person with discretion.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"when_not_to_use\":[\"It tests the sharp null that treatment changed nothing for anyone, which is not the null that the average effect is zero; rejecting it is a weaker statement than it looks. The permutation scheme must match how assignment was actually done -- miss the blocks or the clusters and the p-value is wrong in a way no amount of computation fixes. Small designs admit few distinct assignments, which puts a floor under the p-value. The interval, when produced, assumes a constant additive effect.\"],\"when_to_use\":[\"The randomisation is the only thing this p-value relies on. No normal approximation, no large-sample argument, no variance model -- which matters most exactly when the sample is small, the outcome is skewed, or there are few clusters.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"rct.randomization_inference\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"rct.randomization_inference\",\"registry\":{\"designs\":[\"rct\"],\"diagnostics\":[\"permutation_distribution\",\"baseline_balance\",\"differential_attrition\",\"outcome_distribution\"],\"disrecommend_when\":null,\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":true,\"r\":\"ri2, coin\"},\"estimands\":[\"ATE\",\"ITT\"],\"explain_key\":\"method.rct.randomization_inference\",\"id\":\"rct.randomization_inference\",\"needs\":[\"numpy\",\"pandas\",\"scipy\"],\"needs_overlap\":false,\"one_liner\":\"Re-run the randomisation thousands of times with the outcomes held fixed, and see how unusual what actually happened really is.\",\"options\":[{\"default\":2000,\"help\":\"More draws make the p-value less noisy, not more valid; the p-value is exact at any number.\",\"label\":\"Permutations\",\"max\":200000,\"min\":99,\"name\":\"reps\",\"profile\":\"standard\",\"type\":\"int\"},{\"choices\":[\"diff_means\",\"welch_t\",\"rank_sum\"],\"default\":\"diff_means\",\"help\":\"The difference in means is the usual choice. The rank sum is far less sensitive to a few extreme outcomes; the studentised statistic behaves better when the arms have very different variances.\",\"label\":\"Test statistic\",\"name\":\"statistic\",\"profile\":\"standard\",\"type\":\"select\"},{\"choices\":[\"two_sided\",\"greater\",\"less\"],\"default\":\"two_sided\",\"help\":\"One-sided tests must be chosen before seeing the data.\",\"label\":\"Alternative\",\"name\":\"alternative\",\"profile\":\"advanced\",\"type\":\"select\"},{\"default\":true,\"help\":\"Searches for the constant treatment effects the test does not reject. That interval assumes the same effect for every unit, which is a stronger claim than the point estimate makes.\",\"label\":\"Interval by test inversion\",\"name\":\"invert_ci\",\"profile\":\"advanced\",\"type\":\"bool\"},{\"default\":0.95,\"help\":\"The coverage of the interval reported next to the estimate.\",\"label\":\"Confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"}],\"probes\":[\"placebo_outcome\",\"placebo_treatment\",\"subset_refuter\",\"alternate_spec\"],\"reference_dispositions\":[{\"disposition\":\"resolved_metadata\",\"id\":\"10.2307/2277749\",\"requested_as\":\"Fisher (1935), The Design of Experiments\"},{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:ce9275187e1e2526448d\",\"requested_as\":\"Rosenbaum (2002), Observational Studies, chapter 2\"},{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:066a5821b64a698d3413\",\"requested_as\":\"Imbens and Rubin (2015), Causal Inference for Statistics, Social, and Biomedical Sciences, chapter 5\"},{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:12d5c830da10862dd1b8\",\"requested_as\":\"Gerber and Green (2012), Field Experiments: Design, Analysis, and Interpretation\"}],\"reference_ids\":[\"10.2307/2277749\",\"source:unresolved:ce9275187e1e2526448d\",\"source:unresolved:066a5821b64a698d3413\",\"source:unresolved:12d5c830da10862dd1b8\"],\"references\":[\"Fisher (1935), The Design of Experiments\",\"Rosenbaum (2002), Observational Studies, chapter 2\",\"Imbens and Rubin (2015), Causal Inference for Statistics, Social, and Biomedical Sciences, chapter 5\",\"Gerber and Green (2012), Field Experiments: Design, Analysis, and Interpretation\"],\"roles_forbidden\":[\"instruments\",\"running\"],\"roles_optional\":[\"strata\",\"cluster\",\"confounders\"],\"roles_required\":[\"treatment\",\"outcome\"],\"source_path\":\"engines/python/capy_py/rct.py\",\"source_sha256\":\"ad0630960d6aaff7fdef9a290c97dcb094099f646bd6ff87151d786a5604baa8\",\"status\":\"recommended\",\"title\":\"Randomisation (Fisher) inference\",\"what_can_go_wrong\":\"It tests the sharp null that treatment changed nothing for anyone, which is not the null that the average effect is zero; rejecting it is a weaker statement than it looks. The permutation scheme must match how assignment was actually done -- miss the blocks or the clusters and the p-value is wrong in a way no amount of computation fixes. Small designs admit few distinct assignments, which puts a floor under the p-value. The interval, when produced, assumes a constant additive effect.\",\"why_recommended\":\"The randomisation is the only thing this p-value relies on. No normal approximation, no large-sample argument, no variance model -- which matters most exactly when the sample is small, the outcome is skewed, or there are few clusters.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:00a1cbdb0c20dec1bf000685\",\"object_id\":\"rct.diff_means\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body in