<urn:capy:study%3Agov_transfers> a capy:study ; skos:prefLabel "A cash transfer with an income cutoff" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"study:gov_transfers\",\"citation_ids\":[],\"citations\":[],\"content\":{\"caveat\":\"\",\"citation\":\"Manacorda, Miguel & Vigorito (2011).\",\"citation_url\":\"https://doi.org/10.1257/app.3.3.1\",\"design\":{\"explain_key\":\"design.rd\",\"id\":\"rd\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Crossing a score, age, or border switched the programme on.\",\"title\":\"A cutoff decided eligibility\"},\"difficulty\":\"start here\",\"estimand\":{\"acronym\":\"LATE\",\"explain_key\":\"estimand.late\",\"id\":\"LATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who only got it because of the instrument or the cutoff, what did it do?\",\"title\":\"Local average treatment effect\"},\"explain_key\":null,\"gaps\":[],\"id\":\"gov_transfers\",\"kind\":\"study\",\"one_liner\":\"regression discontinuity where the assignment rule is known exactly\",\"plain_language\":\"Eligibility decided by an income score, already centred on the threshold. A clean discontinuity, and a good place to meet the design.\",\"provenance\":{\"data_origin\":\"Published study data, fetched from source. Not redistributed by this project.\",\"downloads_from\":[\"https://vincentarelbundock.github.io/Rdatasets/csv/causaldata/gov_transfers.csv\"],\"licences\":[\"MIT\"],\"rights\":\"MIT via causaldata, Huntington-Klein et al.\",\"source\":\"real\",\"study\":\"Manacorda, Miguel & Vigorito (2011)\",\"truth\":\"This is the study data, not a simulation. There is no built-in answer to check the estimators against -- which is the whole reason to work with it.\"},\"question\":\"Eligibility decided by an income score, already centred on the threshold. A clean discontinuity, and a good place to meet the design.\",\"rows\":1948,\"see_also\":[{\"explain_key\":\"design.rd\