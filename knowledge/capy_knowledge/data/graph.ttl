<urn:capy:long.gformula> a capy:method ; skos:prefLabel "Parametric g-formula" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:long.gformula\"],\"catalogue_key\":\"method:long.gformula\",\"citation_ids\":[\"10.1016/0270-0255(86)90088-6\",\"hernan2020\",\"source:unresolved:94ce9e118d5756f8e844\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":null,\"engines\":{\"python\":true,\"r\":\"gfoRmula\"},\"needs_r_packages\":[\"gfoRmula\"],\"runs_here\":true,\"summary\":\"Runs on this computer with what the app already installs.\"},\"designs\":[{\"explain_key\":\"design.longitudinal\",\"id\":\"longitudinal\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"The same person is treated, untreated, treated again; confounders also move.\",\"title\":\"Treatment that changes over time\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.temporal_ordering\",\"id\":\"temporal_ordering\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Temporal ordering of covariates\"},{\"explain_key\":\"diagnostic.person_time\",\"id\":\"person_time\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Person-time and switching\"},{\"explain_key\":\"diagnostic.positivity_by_period\",\"id\":\"positivity_by_period\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Positivity by period\"},{\"explain_key\":\"diagnostic.natural_course\",\"id\":\"natural_course\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Natural-course calibration\"},{\"explain_key\":\"diagnostic.strategy_paths\",\"id\":\"strategy_paths\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Treatment strategies compared\"},{\"explain_key\":\"diagnostic.bootstrap_spread\",\"id\":\"bootstrap_spread\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Bootstrap spread\"}],\"estimands\":[{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"}],\"explain_key\":\"method.long.gformula\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"long.gformula\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":true,\"one_liner\":\"Model each period in turn, then simulate the world where everyone followed the strategy you name.\",\"options\":[{\"choices\":[\"treat_all\",\"treat_none\",\"natural_course\",\"threshold\"],\"default\":[\"treat_all\",\"treat_none\"],\"help\":\"The worlds to compare: everyone treated throughout, nobody treated, the natural course (nobody intervenes), or a rule that starts treatment when a covariate crosses a threshold.\",\"label\":\"Strategies to simulate\",\"name\":\"interventions\",\"profile\":\"standard\",\"type\":\"multiselect\"},{\"choices\":[\"treat_all\",\"treat_none\",\"natural_course\",\"threshold\"],\"default\":[\"treat_all\",\"treat_none\"],\"help\":\"Which two strategies the headline number compares, at the end of follow-up.\",\"label\":\"Headline comparison\",\"name\":\"contrast\",\"profile\":\"standard\",\"type\":\"multiselect\"},{\"default\":null,\"help\":\"For a 'treat when X crosses a line' strategy, the time-varying covariate to watch.\",\"label\":\"Threshold rule: variable\",\"name\":\"threshold_variable\",\"profile\":\"advanced\",\"type\":\"column\"},{\"default\":null,\"label\":\"Threshold rule: value\",\"name\":\"threshold_value\",\"profile\":\"advanced\",\"type\":\"number\"},{\"choices\":[\"below\",\"above\"],\"default\":\"below\",\"label\":\"Threshold rule: treat when the variable is\",\"name\":\"threshold_direction\",\"profile\":\"advanced\",\"type\":\"select\"},{\"default\":true,\"label\":\"Threshold rule: once started, stay on treatment\",\"name\":\"threshold_absorbing\",\"profile\":\"advanced\",\"type\":\"bool\"},{\"default\":5000,\"help\":\"More histories, less simulation noise. Both arms share the same random draws, so the contrast is far steadier than either mean.\",\"label\":\"Simulated histories\",\"max\":200000,\"min\":500,\"name\":\"mc_samples\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":200,\"help\":\"Every model is refitted on each resample of people.\",\"label\":\"Bootstrap draws\",\"max\":5000,\"min\":50,\"name\":\"bootstrap_reps\",\"profile\":\"advanced\",\"type\":\"int\"},{\"choices\":[\"dummies\",\"linear\"],\"default\":\"dummies\",\"help\":\"A separate level per period, or a straight line through them.\",\"label\":\"How time enters the models\",\"name\":\"period_effects\",\"profile\":\"advanced\",\"type\":\"select\"}],\"plain_language\":\"Model each period in turn, then simulate the world where everyone followed the strategy you name.\",\"probes\":[{\"explain_key\":\"probe.alternate_spec\",\"id\":\"probe.alternate_spec\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the grid of defensible specifications and sort the answers. The curve is the result, not the one you happened to run.\",\"requested_as\":\"probe.alternate_spec\",\"title\":\"Specification curve\"},{\"explain_key\":\"probe.subset\",\"id\":\"probe.subset\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Re-estimate on random subsets. The answer should move about as much as losing that much data costs, and no more.\",\"requested_as\":\"probe.subset\",\"title\":\"Subset stability\"},{\"explain_key\":\"probe.placebo_outcome\",\"id\":\"probe.placebo_outcome\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the same analysis on something the treatment could not have changed. It should find nothing.\",\"requested_as\":\"probe.placebo_outcome\",\"title\":\"Placebo outcome\"},{\"explain_key\":\"probe.random_common_cause\",\"id\":\"probe.random_common_cause\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Add a variable that causes nothing to the adjustment set. The estimate should barely move.\",\"requested_as\":\"probe.random_common_cause\",\"title\":\"Random common cause\"}],\"references\":[\"Robins (1986), A new approach to causal inference in mortality studies\",\"Hernan & Robins (2020), Causal Inference: What If, ch. 21\",\"Keil et al. (2014), A parametric g-formula for studying time-varying exposures\"],\"roles_forbidden\":[\"forbidden\"],\"roles_optional\":[\"strata\",\"weight\",\"a clustering variable\",\"censoring\"],\"roles_required\":[\"a unit id\",\"a time variable\",\"a treatment\",\"an outcome\",\"at least one measured confounder\"],\"see_also\":[{\"explain_key\":\"design.longitudinal\",\"id\":\"longitudinal\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"The same person is treated, untreated, treated again; confounders also move.\",\"title\":\"Treatment that changes over time\"},{\"explain_key\":\"method.long.g_estimation\",\"id\":\"long.g_estimation\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Estimate the effect of a treatment regime by finding the parameter that removes the association between treatment and the blipped-down outcome.\",\"title\":\"G-estimation of structural nested models\"},{\"explain_key\":\"method.long.lmtp\",\"id\":\"long.lmtp\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Estimate the effect of shifting a continuous or multi-valued treatment, rather than of setting everyone to one value.\",\"title\":\"Longitudinal modified treatment policies (lmtp)\"},{\"explain_key\":\"method.long.ltmle\",\"id\":\"long.ltmle\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Regress backwards from the final outcome, then correct with the treatment probabilities: right if either set of models is right.\",\"title\":\"Sequential doubly robust (ICE g-formula with augmentation)\"},{\"explain_key\":\"method.long.ltmle_survival\",\"id\":\"long.ltmle_survival\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Time-to-event outcomes with time-varying treatment and censoring, targeted at each time.\",\"title\":\"Longitudinal TMLE for survival outcomes\"},{\"explain_key\":\"method.long.msm_iptw\",\"id\":\"long.msm_iptw\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Reweight each person-period so the treated and untreated histories look alike, then fit one simple model to the reweighted data.\",\"title\":\"Marginal structural model (time-varying weights)\"},{\"explain_key\":\"method.obs.missing.mice\",\"id\":\"obs.missing.mice\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Impute the missing values several times, run the analysis in each, and combine -- instead of dropping every row with a gap.\",\"title\":\"Multiple imputation compatible with the analysis\"}],\"status\":\"recommended\",\"status_label\":\"Recommended\",\"tags\":[\"Treatment that changes over time\",\"ATE\",\"Recommended\"],\"title\":\"Parametric g-formula\",\"what_it_assumes\":[{\"explain_key\":\"assumption.no_time_varying_confounding\",\"explains\":\"At every period, the things that drive the treatment decision and also affect the outcome are measured -- and measured before that decision.\",\"id\":\"no_time_varying_confounding\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No unmeasured time-varying confounding\",\"worry_when\":\"Clinical measurements taken after the dose was changed; employment status recorded at the end of a period used to explain treatment at its start.\"},{\"explain_key\":\"assumption.positivity\",\"explains\":\"Every kind of unit had some chance of being treated and some chance of not being treated. Where that fails, there is no comparison to make and the model is inventing one.\",\"id\":\"positivity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Positivity / overlap\",\"worry_when\":\"Any single weight carries a large share of the total; the effective sample is far below the nominal one; the propensity model separates the arms almost perfectly; treated units sit outside the control group's range.\"},{\"explain_key\":\"assumption.sequential_ignorability\",\"explains\":\"No unmeasured confounding of the treatment-outcome relationship, and none of the mediator-outcome relationship either, even after conditioning on treatment.\",\"id\":\"sequential_ignorability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Sequential ignorability\",\"worry_when\":\"There is a variable affected by treatment that also confounds the mediator-outcome relationship. Under that structure the natural effects are not identified at all.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"when_not_to_use\":[\"Every model in the chain has to be roughly right, and the simulation extrapolates without saying so. The natural-course check is the only thing standing between you and a confident wrong answer.\"],\"when_to_use\":[\"It answers the question a policy actually asks -- what if everyone had followed this rule -- and it handles a confounder that is also a consequence of earlier treatment, which regression cannot.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"long.gformula\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"long.gformula\",\"registry\":{\"designs\":[\"longitudinal\"],\"diagnostics\":[\"temporal_ordering\",\"person_time\",\"positivity_by_period\",\"natural_course\",\"strategy_paths\",\"bootstrap_spread\"],\"disrecommend_when\":null,\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":true,\"r\":\"gfoRmula\"},\"estimands\":[\"ATE\"],\"explain_key\":\"method.long.gformula\",\"id\":\"long.gformula\",\"needs\":[\"numpy\",\"scipy\",\"pandas\"],\"needs_overlap\":true,\"one_liner\":\"Model each period in turn, then simulate the world where everyone followed the strategy you name.\",\"options\":[{\"choices\":[\"treat_all\",\"treat_none\",\"natural_course\",\"threshold\"],\"default\":[\"treat_all\",\"treat_none\"],\"help\":\"The worlds to compare: everyone treated throughout, nobody treated, the natural course (nobody intervenes), or a rule that starts treatment when a covariate crosses a threshold.\",\"label\":\"Strategies to simulate\",\"name\":\"interventions\",\"profile\":\"standard\",\"type\":\"multiselect\"},{\"choices\":[\"treat_all\",\"treat_none\",\"natural_course\",\"threshold\"],\"default\":[\"treat_all\",\"treat_none\"],\"help\":\"Which two strategies the headline number compares, at the end of follow-up.\",\"label\":\"Headline comparison\",\"name\":\"contrast\",\"profile\":\"standard\",\"type\":\"multiselect\"},{\"default\":null,\"help\":\"For a 'treat when X crosses a line' strategy, the time-varying covariate to watch.\",\"label\":\"Threshold rule: variable\",\"name\":\"threshold_variable\",\"profile\":\"advanced\",\"type\":\"column\"},{\"default\":null,\"label\":\"Threshold rule: value\",\"name\":\"threshold_value\",\"profile\":\"advanced\",\"type\":\"number\"},{\"choices\":[\"below\",\"above\"],\"default\":\"below\",\"label\":\"Threshold rule: treat when the variable is\",\"name\":\"threshold_direction\",\"profile\":\"advanced\",\"type\":\"select\"},{\"default\":true,\"label\":\"Threshold rule: once started, stay on treatment\",\"name\":\"threshold_absorbing\",\"profile\":\"advanced\",\"type\":\"bool\"},{\"default\":5000,\"help\":\"More histories, less simulation noise. Both arms share the same random draws, so the contrast is far steadier than either mean.\",\"label\":\"Simulated histories\",\"max\":200000,\"min\":500,\"name\":\"mc_samples\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":200,\"help\":\"Every model is refitted on each resample of people.\",\"label\":\"Bootstrap draws\",\"max\":5000,\"min\":50,\"name\":\"bootstrap_reps\",\"profile\":\"advanced\",\"type\":\"int\"},{\"choices\":[\"dummies\",\"linear\"],\"default\":\"dummies\",\"help\":\"A separate level per period, or a straight line through them.\",\"label\":\"How time enters the models\",\"name\":\"period_effects\",\"profile\":\"advanced\",\"type\":\"select\"}],\"probes\":[\"probe.alternate_spec\",\"probe.subset\",\"probe.placebo_outcome\",\"probe.random_common_cause\"],\"reference_dispositions\":[{\"disposition\":\"resolved_metadata\",\"id\":\"10.1016/0270-0255(86)90088-6\",\"requested_as\":\"Robins (1986), A new approach to causal inference in mortality studies\"},{\"disposition\":\"resolved_metadata\",\"id\":\"hernan2020\",\"requested_as\":\"Hernan & Robins (2020), Causal Inference: What If, ch. 21\"},{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:94ce9e118d5756f8e844\",\"requested_as\":\"Keil et al. (2014), A parametric g-formula for studying time-varying exposures\"}],\"reference_ids\":[\"10.1016/0270-0255(86)90088-6\",\"hernan2020\",\"source:unresolved:94ce9e118d5756f8e844\"],\"references\":[\"Robins (1986), A new approach to causal inference in mortality studies\",\"Hernan & Robins (2020), Causal Inference: What If, ch. 21\",\"Keil et al. (2014), A parametric g-formula for studying time-varying exposures\"],\"roles_forbidden\":[\"forbidden\"],\"roles_optional\":[\"strata\",\"weight\",\"cluster\",\"censoring\"],\"roles_required\":[\"unit\",\"time\",\"treatment\",\"outcome\",\"confounders\"],\"source_path\":\"engines/python/capy_py/longitudinal.py\",\"source_sha256\":\"49a2064131adc4f82db0de13c3127729b10c3407c6c933d1afed97a11dce4e83\",\"status\":\"recommended\",\"title\":\"Parametric g-formula\",\"what_can_go_wrong\":\"Every model in the chain has to be roughly right, and the simulation extrapolates without saying so. The natural-course check is the only thing standing between you and a confident wrong answer.\",\"why_recommended\":\"It answers the question a policy actually asks -- what if everyone had followed this rule -- and it handles a confounder that is also a consequence of earlier treatment, which regression cannot.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:00c30601d3bd6100ad1f67cf\",\"object_id\":\"assumption:positivity\",\"predicate\":\"requires_assumption\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"long.gformula\"},{\"assertion_mode\":\"editorial\",\"conditions\