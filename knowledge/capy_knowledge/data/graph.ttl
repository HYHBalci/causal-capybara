<urn:capy:sun2010> a capy:source ; skos:prefLabel "Sun, X., Briel, M., Walter, S. D., and Guyatt, G. H. (2010). Is a subgroup effect believable? Updating criteria to evaluate the credibility of subgroup analyses. BMJ 340:c117." ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"citation\":\"Sun, X., Briel, M., Walter, S. D., and Guyatt, G. H. (2010). Is a subgroup effect believable? Updating criteria to evaluate the credibility of subgroup analyses. BMJ 340:c117.\",\"citation_ids\":[],\"citations\":[],\"disposition\":\"resolved_metadata\",\"id\":\"sun2010\",\"kind\":\"source\",\"metadata\":{\"citation\":\"Sun, X., Briel, M., Walter, S. D., and Guyatt, G. H. (2010). Is a subgroup effect believable? Updating criteria to evaluate the credibility of subgroup analyses. BMJ 340:c117.\",\"id\":\"sun2010\",\"match\":[\"sun\",\"2010\",\"subgroup\"],\"resolved\":true,\"topic\":\"Treatment effect heterogeneity\",\"url\":\"https://doi.org/10.1136/bmj.c117\"},\"provenance\":[\"source:project-inventory\"],\"publication_rights\":{\"attribution\":\"Sun, X., Briel, M., Walter, S. D., and Guyatt, G. H. (2010). Is a subgroup effect believable? Updating criteria to evaluate the credibility of subgroup analyses. BMJ 340:c117.\",\"content_type\":\"external_publication_body\",\"license_id\":\"unknown\",\"license_url\":null,\"modified\":false,\"permissions\":{\"adapt\":false,\"cache\":false,\"display\":false,\"model_context\":false,\"public_export\":false},\"review_basis\":\"No full-text license has been admitted.\"},\"relations\":[],\"resolved\":true,\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_version\":\"https://doi.org/10.1136/bmj.c117\",\"summary\":\"Bibliographic metadata/link only; no publication text, abstract, figure or dataset is distributed.\",\"title\":\"Sun, X., Briel, M., Walter, S. D., and Guyatt, G. H. (2010). Is a subgroup effect believable? Updating criteria to evaluate the credibility of subgroup analyses. BMJ 340:c117.\",\"url\":\"https://doi.org/10.1136/bmj.c117\"}" .
<urn:capy:sun2021> a capy:source ; skos:prefLabel "Sun, L., & Abraham, S. (2021). Estimating dynamic treatment effects in event studies with heterogeneous treatment effects. Journal of Econometrics, 225(2), 175–199." ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"citation\":\"Sun, L., & Abraham, S. (2021). Estimating dynamic treatment effects in event studies with heterogeneous treatment effects. Journal of Econometrics, 225(2), 175–199.\",\"citation_ids\":[],\"citations\":[],\"disposition\":\"resolved_metadata\",\"id\":\"sun2021\",\"kind\":\"source\",\"metadata\":{\"citation\":\"Sun, L., & Abraham, S. (2021). Estimating dynamic treatment effects in event studies with heterogeneous treatment effects. Journal of Econometrics, 225(2), 175–199.\",\"id\":\"sun2021\",\"match\":[\"sun\",\"abraham\",\"2021\"],\"resolved\":true,\"topic\":\"Difference-in-differences\",\"url\":\"https://doi.org/10.1016/j.jeconom.2020.09.006\"},\"provenance\":[\"source:project-inventory\"],\"publication_rights\":{\"attribution\":\"Sun, L., & Abraham, S. (2021). Estimating dynamic treatment effects in event studies with heterogeneous treatment effects. Journal of Econometrics, 225(2), 175–199.\",\"content_type\":\"external_publication_body\",\"license_id\":\"unknown\",\"license_url\":null,\"modified\":false,\"permissions\":{\"adapt\":false,\"cache\":false,\"display\":false,\"model_context\":false,\"public_export\":false},\"review_basis\":\"No full-text license has been admitted.\"},\"relations\":[],\"resolved\":true,\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_version\":\"https://doi.org/10.1016/j.jeconom.2020.09.006\",\"summary\":\"Bibliographic metadata/link only; no publication text, abstract, figure or dataset is distributed.\",\"title\":\"Sun, L., & Abraham, S. (2021). Estimating dynamic treatment effects in event studies with heterogeneous treatment effects. Journal of Econometrics, 225(2), 175–199.\",\"url\":\"https://doi.org/10.1016/j.jeconom.2020.09.006\"}" .
<urn:capy:survival.aft> a capy:method ; skos:prefLabel "Censored AFT regression and causal standardization" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:survival.aft\"],\"catalogue_key\":\"method:survival.aft\",\"citation_ids\":[\"hernan2010\",\"hernan2020\",\"rudolph2023\",\"uno2014\",\"wei1992\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":null,\"engines\":{\"python\":true,\"r\":false},\"needs_r_packages\":[],\"runs_here\":true,\"summary\":\"Runs on this computer with what the app already installs.\"},\"designs\":[{\"explain_key\":\"design.survival\",\"id\":\"survival\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Follow people from a common time zero; some leave follow-up before the event is observed.\",\"title\":\"Time until an event\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.survival_followup\",\"id\":\"survival_followup\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Follow-up and common horizon support\"},{\"explain_key\":\"diagnostic.survival_censoring\",\"id\":\"survival_censoring\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Right-censoring assumptions\"},{\"explain_key\":\"diagnostic.aft_fit\",\"id\":\"aft_fit\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"AFT model fit and common time scale\"},{\"explain_key\":\"diagnostic.aft_support\",\"id\":\"aft_support\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Conditional treatment and censoring support\"},{\"explain_key\":\"diagnostic.survival_heterogeneity\",\"id\":\"survival_heterogeneity\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Baseline subgroup heterogeneity in survival contrasts\"}],\"estimands\":[{\"acronym\":\"S(1) - S(0)\",\"explain_key\":\"estimand.survival_difference\",\"id\":\"survival_difference\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"At a chosen horizon, how do event-free probabilities differ between baseline treatments?\",\"title\":\"Survival probability difference\"},{\"acronym\":\"RMST(1) - RMST(0)\",\"explain_key\":\"estimand.rmst_difference\",\"id\":\"RMST_difference\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"Through a chosen horizon, how much event-free follow-up time differs between baseline treatments?\",\"title\":\"Restricted mean survival time difference\"},{\"acronym\":\"exp(beta)\",\"explain_key\":\"estimand.time_ratio\",\"id\":\"time_ratio\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"Conditional on baseline covariates, what common factor stretches event times in the AFT model?\",\"title\":\"Conditional AFT time ratio\"}],\"explain_key\":\"method.survival.aft\",\"gaps\":[],\"id\":\"survival.aft\",\"in_more_depth\":\"The likelihood uses the event-time density for events and survival probability for right-censored observations. For a supported horizon, predict both treatments for every complete-case baseline covariate profile and average over that empirical target population. An optional prespecified categorical baseline modifier adds all subgroup main effects and treatment-by-subgroup interactions to one pooled common-scale model. In that mode, both treatment predictions are averaged over the same observed profiles within each subgroup; those subgroup populations can have different covariate distributions. The displayed time-factor headline is the reference subgroup's conditional factor, and the subgroup table gives all factors. Survival/RMST standardization is causal only under justified consistency, no interference, exchangeability, treatment positivity, independent censoring conditional on treatment/covariates and correct model form. Those conditions remain untested. Each subject bootstrap sample refits the likelihood and re-averages over its resampled target population; subgroup mode resamples within baseline subgroups, conditioning on their observed counts. The optimizer must converge to a finite interior solution with stable positive curvature. A complete-case target may differ from the original population; the flow reports missingness.\",\"kind\":\"method\",\"needs_overlap\":true,\"one_liner\":\"Fit a right-censored log-normal/Weibull AFT model; standardize survival/RMST over baseline covariates under explicit causal assumptions, or report a conditional time factor.\",\"options\":[{\"choices\":[\"lognormal\",\"weibull\"],\"default\":\"lognormal\",\"help\":\"A correct common-scale AFT distribution and covariate form are assumptions, not conclusions from optimizer convergence.\",\"label\":\"Event-time distribution\",\"name\":\"distribution\",\"profile\":\"beginner\",\"type\":\"select\"},{\"default\":[],\"help\":\"Optional: one prespecified categorical baseline column with 2–8 observed levels. Tests differences between treatment contrasts on the selected scale at the chosen horizon. No automatic cutpoint search.\",\"label\":\"Baseline subgroup modifier\",\"max_items\":1,\"name\":\"subgroups\",\"profile\":\"beginner\",\"type\":\"columns\"},{\"default\":false,\"help\":\"Confirm only when the modifier was measured before treatment and its analysis was specified before inspecting outcomes. Your declaration is recorded but cannot verify the study design.\",\"label\":\"Modifier is baseline and analysis was prespecified\",\"name\":\"subgroups_prespecified\",\"profile\":\"beginner\",\"type\":\"bool\"},{\"choices\":[\"days\",\"weeks\",\"months\",\"years\"],\"default\":null,\"help\":\"Choose explicitly. Follow-up duration and the common horizon must use the same time unit.\",\"label\":\"Duration time unit\",\"name\":\"time_unit\",\"profile\":\"beginner\",\"type\":\"select\"},{\"default\":null,\"help\":\"Choose a positive time in the duration column's units, supported in both groups. Set before viewing the contrast. Required for survival/RMST; unused for the conditional time ratio.\",\"label\":\"Common follow-up horizon\",\"min\":0,\"name\":\"horizon\",\"profile\":\"beginner\",\"type\":\"number\"},{\"default\":100,\"help\":\"Seeded independent-subject resampling; increase for a less noisy interval.\",\"label\":\"Bootstrap resamples\",\"max\":2000,\"min\":20,\"name\":\"bootstrap_reps\",\"profile\":\"standard\",\"type\":\"int\"},{\"default\":0.95,\"label\":\"Confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"standard\",\"type\":\"number\"}],\"plain_language\":\"Fit a right-censored common-scale log-normal or Weibull AFT model, then distinguish its conditional time factor from marginal standardized survival and RMST.\",\"probes\":[],\"references\":[\"Wei (1992), The accelerated failure time model: a useful alternative to the Cox regression model in survival analysis\",\"Hernán and Robins (2020), Causal Inference: What If\",\"Hernán (2010), The Hazards of Hazard Ratios\",\"Uno et al. (2014), Moving Beyond the Hazard Ratio in Quantifying the Between-Group Difference in Survival Analysis\",\"Rudolph, Schisterman and Naimi (2023), A Simulation Study Comparing the Performance of Time-Varying Inverse Probability Weighting and G-Computation in Survival Analysis\"],\"roles_forbidden\":[\"entry\",\"start\",\"stop\",\"competing_event\",\"censoring\",\"a clustering variable\",\"weight\",\"strata\",\"a time variable\"],\"roles_optional\":[\"a unit id\",\"at least one measured confounder\",\"forbidden\"],\"roles_required\":[\"a treatment\",\"elapsed follow-up duration\",\"an event indicator (1 event, 0 right censored)\"],\"see_also\":[{\"explain_key\":\"design.survival\",\"id\":\"survival\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Follow people from a common time zero; some leave follow-up before the event is observed.\",\"title\":\"Time until an event\"},{\"acronym\":\"exp(beta)\",\"explain_key\":\"estimand.time_ratio\",\"id\":\"time_ratio\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"Conditional on baseline covariates, what common factor stretches event times in the AFT model?\",\"title\":\"Conditional AFT time ratio\"},{\"acronym\":\"S(1) - S(0)\",\"explain_key\":\"estimand.survival_difference\",\"id\":\"survival_difference\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"At a chosen horizon, how do event-free probabilities differ between baseline treatments?\",\"title\":\"Survival probability difference\"},{\"acronym\":\"RMST(1) - RMST(0)\",\"explain_key\":\"estimand.rmst_difference\",\"id\":\"RMST_difference\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"Through a chosen horizon, how much event-free follow-up time differs between baseline treatments?\",\"title\":\"Restricted mean survival time difference\"},{\"explain_key\":\"concept.survival_hazard\",\"id\":\"concept.survival_hazard\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"A hazard is an instantaneous event rate among those still event-free. It is not an event probability.\",\"title\":\"Hazard, survival probability and time ratios\"},{\"explain_key\":\"diagnostic.survival_heterogeneity\",\"id\":\"survival_heterogeneity\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Baseline subgroup heterogeneity in survival contrasts\"},{\"explain_key\":\"method.survival.kaplan_meier\",\"id\":\"survival.kaplan_meier\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Compare observed group event-free probabilities at an explicit common horizon; this is an unadjusted association.\",\"title\":\"Unadjusted Kaplan–Meier survival contrast\"},{\"explain_key\":\"method.survival.rmst\",\"id\":\"survival.rmst\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Compare areas under observed Kaplan–Meier curves through a common horizon in time units; this is an unadjusted association.\",\"title\":\"Unadjusted restricted mean survival contrast\"}],\"status\":\"recommended\",\"status_label\":\"Recommended\",\"tags\":[\"Time until an event\",\"S(1) - S(0)\",\"RMST(1) - RMST(0)\",\"exp(beta)\",\"Recommended\"],\"title\":\"Censored AFT regression and causal standardization\",\"what_it_assumes\":[{\"explain_key\":\"assumption.exchangeability\",\"explains\":\"Treated and untreated units are comparable once you condition on the confounders you measured. Everything that pushed people towards treatment and also moves the outcome is in your adjustment set.\",\"id\":\"exchangeability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Exchangeability / no unmeasured confounding\",\"worry_when\":\"Treatment was chosen by people who knew something about the likely outcome that you do not observe. Clinical judgement, self-selection into a programme, and administrative triage are the classic cases.\"},{\"explain_key\":\"assumption.positivity\",\"explains\":\"Every kind of unit had some chance of being treated and some chance of not being treated. Where that fails, there is no comparison to make and the model is inventing one.\",\"id\":\"positivity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Positivity / overlap\",\"worry_when\":\"Any single weight carries a large share of the total; the effective sample is far below the nominal one; the propensity model separates the arms almost perfectly; treated units sit outside the control group's range.\"},{\"explain_key\":\"assumption.survival_consistency\",\"explains\":\"Observed event times must agree with the potential event times under the treatment actually received, with meaningful treatment versions.\",\"id\":\"survival_consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined baseline intervention\",\"worry_when\":null},{\"explain_key\":\"assumption.survival_no_interference\",\"explains\":\"One person's event time is assumed unaffected by other people's treatment assignments.\",\"id\":\"survival_no_interference\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No interference between people\",\"worry_when\":null},{\"explain_key\":\"assumption.conditional_independent_censoring\",\"explains\":\"Given baseline treatment and covariates, censoring must not convey additional information about the unobserved event time.\",\"id\":\"conditional_independent_censoring\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Independent censoring conditional on treatment and baseline covariates\",\"worry_when\":null}],\"when_not_to_use\":[\"Correct parametric common-scale AFT form, independent censoring given treatment/covariates, and independent subjects are required. Causal standardization additionally needs consistency, exchangeability and positivity. No competing risks, delayed entry, time-varying treatment, IPCW or structural causal AFT is implemented.\"],\"when_to_use\":[\"Separates marginal counterfactual survival/RMST standardization from the conditional AFT time ratio, and displays unverified identification/model assumptions.\"]},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"survival.aft\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"survival.aft\",\"registry\":{\"designs\":[\"survival\"],\"diagnostics\":[\"survival_followup\",\"survival_censoring\",\"aft_fit\",\"aft_support\",\"survival_heterogeneity\"],\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":true,\"r\":false},\"estimands\":[\"survival_difference\",\"RMST_difference\",\"time_ratio\"],\"explain_key\":\"method.survival.aft\",\"id\":\"survival.aft\",\"needs\":[\"numpy\",\"scipy\",\"statsmodels\"],\"needs_overlap\":true,\"one_liner\":\"Fit a right-censored log-normal/Weibull AFT model; standardize survival/RMST over baseline covariates under explicit causal assumptions, or report a conditional time factor.\",\"options\":[{\"choices\":[\"lognormal\",\"weibull\"],\"default\":\"lognormal\",\"help\":\"A correct common-scale AFT distribution and covariate form are assumptions, not conclusions from optimizer convergence.\",\"label\":\"Event-time distribution\",\"name\":\"distribution\",\"profile\":\"beginner\",\"type\":\"select\"},{\"default\":[],\"help\":\"Optional: one prespecified categorical baseline column with 2–8 observed levels. Tests differences between treatment contrasts on the selected scale at the chosen horizon. No automatic cutpoint search.\",\"label\":\"Baseline subgroup modifier\",\"max_items\":1,\"name\":\"subgroups\",\"profile\":\"beginner\",\"type\":\"columns\"},{\"default\":false,\"help\":\"Confirm only when the modifier was measured before treatment and its analysis was specified before inspecting outcomes. Your declaration is recorded but cannot verify the study design.\",\"label\":\"Modifier is baseline and analysis was prespecified\",\"name\":\"subgroups_prespecified\",\"profile\":\"beginner\",\"type\":\"bool\"},{\"choices\":[\"days\",\"weeks\",\"months\",\"years\"],\"default\":null,\"help\":\"Choose explicitly. Follow-up duration and the common horizon must use the same time unit.\",\"label\":\"Duration time unit\",\"name\":\"time_unit\",\"profile\":\"beginner\",\"type\":\"select\"},{\"default\":null,\"help\":\"Choose a positive time in the duration column's units, supported in both groups. Set before viewing the contrast. Required for survival/RMST; unused for the conditional time ratio.\",\"label\":\"Common follow-up horizon\",\"min\":0,\"name\":\"horizon\",\"profile\":\"beginner\",\"type\":\"number\"},{\"default\":100,\"help\":\"Seeded independent-subject resampling; increase for a less noisy interval.\",\"label\":\"Bootstrap resamples\",\"max\":2000,\"min\":20,\"name\":\"bootstrap_reps\",\"profile\":\"standard\",\"type\":\"int\"},{\"default\":0.95,\"label\":\"Confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"standard\",\"type\":\"number\"}],\"probes\":[],\"reference_dispositions\":[{\"disposition\":\"resolved_metadata\",\"id\":\"wei1992\",\"requested_as\":\"Wei (1992), The accelerated failure time model: a useful alternative to the Cox regression model in survival analysis\"},{\"disposition\":\"resolved_metadata\",\"id\":\"hernan2020\",\"requested_as\":\"Hernán and Robins (2020), Causal Inference: What If\"},{\"disposition\":\"resolved_metadata\",\"id\":\"hernan2010\",\"requested_as\":\"Hernán (2010), The Hazards of Hazard Ratios\"},{\"disposition\":\"resolved_metadata\",\"id\":\"uno2014\",\"requested_as\":\"Uno et al. (2014), Moving Beyond the Hazard Ratio in Quantifying the Between-Group Difference in Survival Analysis\"},{\"disposition\":\"resolved_metadata\",\"id\":\"rudolph2023\",\"requested_as\":\"Rudolph, Schisterman and Naimi (2023), A Simulation Study Comparing the Performance of Time-Varying Inverse Probability Weighting and G-Computation in Survival Analysis\"}],\"reference_ids\":[\"wei1992\",\"hernan2020\",\"hernan2010\",\"uno2014\",\"rudolph2023\"],\"references\":[\"Wei (1992), The accelerated failure time model: a useful alternative to the Cox regression model in survival analysis\",\"Hernán and Robins (2020), Causal Inference: What If\",\"Hernán (2010), The Hazards of Hazard Ratios\",\"Uno et al. (2014), Moving Beyond the Hazard Ratio in Quantifying the Between-Group Difference in Survival Analysis\",\"Rudolph, Schisterman and Naimi (2023), A Simulation Study Comparing the Performance of Time-Varying Inverse Probability Weighting and G-Computation in Survival Analysis\"],\"roles_forbidden\":[\"entry\",\"start\",\"stop\",\"competing_event\",\"censoring\",\"cluster\",\"weight\",\"strata\",\"time\"],\"roles_optional\":[\"unit\",\"confounders\",\"forbidden\"],\"roles_required\":[\"treatment\",\"duration\",\"event\"],\"source_path\":\"engines/python/capy_py/survival.py\",\"source_sha256\":\"87715ef1c40348535ad9e46db59851f0b6530b69f5970a4f2c7a0041f68f80ba\",\"status\":\"recommended\",\"title\":\"Censored AFT regression and causal standardization\",\"what_can_go_wrong\":\"Correct parametric common-scale AFT form, independent censoring given treatment/covariates, and independent subjects are required. Causal standardization additionally needs consistency, exchangeability and positivity. No competing risks, delayed entry, time-varying treatment, IPCW or structural causal AFT is implemented.\",\"why_recommended\":\"Separates marginal counterfactual survival/RMST standardization from the conditional AFT time ratio, and displays unverified identification/model assumptions.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:0107226dbb82c445bf372aa4\",\"object_id\":\"concept:survival-event\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:young2019\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"survival.aft\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:052fe5770f2daff01d19c608\",\"object_id\":\"survival.rmst\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"