review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"its.causal_impact\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Model the counterfactual series with a structural time-series model and control series, and report a posterior rather than an interval.\",\"title\":\"Bayesian structural time series (CausalImpact)\"}" .
<urn:capy:its.controlled> a capy:method ; skos:prefLabel "Controlled ITS" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:its.controlled\"],\"catalogue_key\":\"method:its.controlled\",\"citation_ids\":[\"10.1046/j.1365-2710.2002.00430.x\",\"10.1093/ije/dyy135\",\"10.1136/bmj.h2750\",\"10.1162/003465398557825\",\"10.2307/1913610\",\"bernal2017\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":null,\"engines\":{\"python\":true,\"r\":\"nlme / sandwich, or fixest for the interacted form\"},\"needs_r_packages\":[\"nlme / sandwich, or fixest for the interacted form\"],\"runs_here\":true,\"summary\":\"Runs on this computer with what the app already installs.\"},\"designs\":[{\"explain_key\":\"design.its\",\"id\":\"its\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Before versus after an interruption; maybe a control series.\",\"title\":\"A shock in a single series\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.its_series\",\"id\":\"its_series\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"The series and the interruption\"},{\"explain_key\":\"diagnostic.its_pre_period\",\"id\":\"its_pre_period\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Pre-period length\"},{\"explain_key\":\"diagnostic.its_autocorrelation\",\"id\":\"its_autocorrelation\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Residual autocorrelation\"},{\"explain_key\":\"diagnostic.its_counterfactual\",\"id\":\"its_counterfactual\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Counterfactual projection\"},{\"explain_key\":\"diagnostic.its_seasonality\",\"id\":\"its_seasonality\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Seasonality\"},{\"explain_key\":\"diagnostic.its_control_shock\",\"id\":\"its_control_shock\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Control series at the interruption\"}],\"estimands\":[{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"}],\"explain_key\":\"method.its.controlled\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\",\"some of the robustness probes it names have no card of their own yet\"],\"id\":\"its.controlled\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":false,\"one_liner\":\"The same interruption, measured against a series the intervention did not touch, so a shock that hit everybody is not booked as your effect.\",\"options\":[{\"default\":null,\"help\":\"When the intervention took effect. A period number, or a date if the time column is a date. Normally set by the event_time role on the board.\",\"label\":\"Interruption time\",\"name\":\"event_time\",\"profile\":\"standard\",\"type\":\"string\"},{\"choices\":[\"first_post\",\"last_pre\"],\"default\":\"first_post\",\"help\":\"Whether the time you gave is the first period under the intervention, or the last period before it. Getting this wrong shifts every estimate by one period.\",\"label\":\"The marker is\",\"name\":\"event_marks\",\"profile\":\"standard\",\"type\":\"select\"},{\"default\":null,\"help\":\"How far after the interruption the headline effect is read. Leave empty to use the end of the observed follow-up. Anything beyond that is extrapolation.\",\"label\":\"Horizon (periods after the interruption)\",\"name\":\"horizon\",\"profile\":\"standard\",\"type\":\"number\"},{\"default\":0,\"help\":\"Periods right after the interruption while the policy was still bedding in. They are plotted but excluded from the fit, and the exclusion is recorded in the sample flow.\",\"label\":\"Phase-in periods to hold out\",\"min\":0,\"name\":\"transition_periods\",\"profile\":\"standard\",\"type\":\"int\"},{\"default\":null,\"help\":\"If the policy was announced before it took effect, give the announcement date. The model then carries two markers, so anticipation is estimated instead of being smeared into the implementation effect.\",\"label\":\"Announcement time\",\"name\":\"announcement_time\",\"profile\":\"advanced\",\"type\":\"string\"},{\"default\":null,\"help\":\"12 for monthly data, 4 for quarterly, 7 for daily-with-weekly-pattern. Leave empty if the series has no season.\",\"label\":\"Seasonal cycle length\",\"name\":\"season_period\",\"profile\":\"standard\",\"type\":\"number\"},{\"choices\":[\"auto\",\"none\",\"harmonic\",\"dummy\"],\"default\":\"auto\",\"help\":\"Harmonics (a smooth cycle, cheap in degrees of freedom) or dummies (one per slot, flexible but expensive). 'auto' uses harmonics when a cycle length is given.\",\"label\":\"Seasonality as\",\"name\":\"seasonality\",\"profile\":\"advanced\",\"type\":\"select\"},{\"default\":2,\"help\":\"How wiggly the seasonal shape is allowed to be. Two pairs handle most public-health series.\",\"label\":\"Number of harmonic pairs\",\"max\":6,\"min\":1,\"name\":\"harmonics\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":0.95,\"help\":\"Coverage of the reported intervals.\",\"label\":\"Confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"},{\"choices\":[\"mean\",\"sum\",\"median\"],\"default\":null,\"help\":\"Only needed when the data has several rows per period. Leaving it empty is an error rather than a silent average, because the choice changes the answer.\",\"label\":\"Aggregate duplicate periods by\",\"name\":\"aggregate\",\"profile\":\"advanced\",\"type\":\"select\"},{\"choices\":[\"hac\",\"ols\"],\"default\":\"hac\",\"help\":\"Newey-West HAC is the default because time-series residuals are almost always correlated. Plain OLS is offered so you can see how much difference it makes.\",\"label\":\"Standard errors\",\"name\":\"se\",\"profile\":\"standard\",\"type\":\"select\"},{\"default\":null,\"help\":\"How many periods of correlation the standard errors allow for. Empty uses the usual rule, floor(4*(n/100)^(2/9)).\",\"label\":\"HAC lag length\",\"min\":0,\"name\":\"hac_lags\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":null,\"help\":\"How many lags the Ljung-Box and Breusch-Godfrey tests look at.\",\"label\":\"Autocorrelation test lags\",\"min\":1,\"name\":\"ljung_box_lags\",\"profile\":\"advanced\",\"type\":\"int\"},{\"choices\":[\"interacted\",\"difference\"],\"default\":\"interacted\",\"help\":\"'Interacted' fits the treated and control series together so you can see the control's own jump; 'difference' subtracts the control first and runs one clean segmented regression.\",\"label\":\"Model\",\"name\":\"model\",\"profile\":\"standard\",\"type\":\"select\"},{\"choices\":[\"mean\",\"pool\"],\"default\":\"mean\",\"help\":\"'Mean' averages them into one comparison series; 'pool' keeps them as separate rows so each carries equal weight per period.\",\"label\":\"Several controls become\",\"name\":\"control_combine\",\"profile\":\"advanced\",\"type\":\"select\"}],\"plain_language\":\"The same interruption, measured against a series the intervention did not touch, so a shock that hit everybody is not booked as your effect.\",\"probes\":[{\"explain_key\":null,\"id\":\"placebo_time\",\"in_catalogue\":false,\"kind\":\"probe\",\"one_liner\":null,\"requested_as\":\"placebo_time\",\"title\":\"Placebo in time\"},{\"explain_key\":\"probe.placebo_outcome\",\"id\":\"probe.placebo_outcome\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the same analysis on something the treatment could not have changed. It should find nothing.\",\"requested_as\":\"placebo_outcome\",\"title\":\"Placebo outcome\"},{\"explain_key\":\"probe.alternate_spec\",\"id\":\"probe.alternate_spec\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the grid of defensible specifications and sort the answers. The curve is the result, not the one you happened to run.\",\"requested_as\":\"alternate_spec\",\"title\":\"Specification curve\"},{\"explain_key\":null,\"id\":\"leave_one_control_out\",\"in_catalogue\":false,\"kind\":\"probe\",\"one_liner\":null,\"requested_as\":\"leave_one_control_out\",\"title\":\"Leave one control unit out\"}],\"references\":[\"Wagner, Soumerai, Zhang & Ross-Degnan (2002), Segmented regression analysis of interrupted time series studies in medication use research\",\"Bernal, Cummins & Gasparrini (2017), Interrupted time series regression for the evaluation of public health interventions: a tutorial\",\"Newey & West (1987), A simple, positive semi-definite, heteroskedasticity and autocorrelation consistent covariance matrix\",\"Kontopantelis, Doran, Springate, Buchan & Reeves (2015), Regression based quasi-experimental approach when randomisation is not an option\",\"Lopez Bernal, Cummins & Gasparrini (2018), The use of controls in interrupted time series studies of public health interventions\",\"Driscoll & Kraay (1998), Consistent covariance matrix estimation with spatially dependent panel data\"],\"roles_forbidden\":[\"forbidden\"],\"roles_optional\":[\"at least one measured confounder\",\"a treatment\"],\"roles_required\":[\"an outcome\",\"a time variable\",\"an intervention time\",\"control_series\"],\"see_also\":[{\"explain_key\":\"design.its\",\"id\":\"its\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Before versus after an interruption; maybe a control series.\",\"title\":\"A shock in a single series\"},{\"explain_key\":\"method.its.arima\",\"id\":\"its.arima\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Model the memory in the series itself, then ask how big a step, pulse or ramp the data need at the intervention date.\",\"title\":\"ARIMA with an intervention\"},{\"explain_key\":\"method.its.causal_impact\",\"id\":\"its.causal_impact\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Model the counterfactual series with a structural time-series model and control series, and report a posterior rather than an interval.\",\"title\":\"Bayesian structural time series (CausalImpact)\"},{\"explain_key\":\"method.its.segmented\",\"id\":\"its.segmented\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Fit the trend before the interruption, project it forward, and measure the jump and the change of direction after it.\",\"title\":\"Segmented regression\"}],\"status\":\"recommended\",\"status_label\":\"Recommended\",\"tags\":[\"A shock in a single series\",\"ATT\",\"Recommended\"],\"title\":\"Controlled ITS\",\"what_it_assumes\":[{\"explain_key\":\"assumption.no_cointerventions\",\"explains\":\"Nothing else changed at the same moment that also moves the outcome.\",\"id\":\"no_cointerventions\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No co-interventions at the interruption\",\"worry_when\":\"A busy policy period; a national event at the same date; a change in how the outcome was measured or coded at the same date.\"},{\"explain_key\":\"assumption.model_form\",\"explains\":\"The line you fit before the interruption is the line the outcome would have continued to follow.\",\"id\":\"model_form\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Functional form of the counterfactual trend\",\"worry_when\":\"Few pre-period points; residual autocorrelation that survives the model; the estimate flips when you add a seasonal term or a quadratic trend.\"},{\"explain_key\":\"assumption.no_anticipation\",\"explains\":\"Units did not change behaviour before treatment arrived because they knew it was coming.\",\"id\":\"no_anticipation\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No anticipation\",\"worry_when\":\"There was a public announcement well before the policy started, or the pre-period coefficients move in the period immediately before adoption.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"}],\"when_not_to_use\":[\"It trades one assumption for another: instead of assuming the trend would have continued, you assume the two series would have moved in parallel. A control that was itself partly exposed pulls the estimate towards zero. Averaging controls that sit at very different levels lets the biggest one decide the answer. Simplification: the interacted model uses Driscoll-Kraay standard errors, which lean on having a reasonable number of periods and are thin on the cross-sectional side when there are only two or three series.\",\"No untreated series measured on the same calendar exists\"],\"when_to_use\":[\"A single interrupted series cannot tell your intervention apart from anything else that happened that month. A control series that was not exposed can, and the control's own level and slope change are reported so you can see whether the shock was shared.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\",\"some of the robustness probes it names have no card of their own yet\"],\"id\":\"its.controlled\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"its.controlled\",\"registry\":{\"designs\":[\"its\"],\"diagnostics\":[\"its_series\",\"its_pre_period\",\"its_autocorrelation\",\"its_counterfactual\",\"its_seasonality\",\"its_control_shock\"],\"disrecommend_when\":\"No untreated series measured on the same calendar exists\",\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":true,\"r\":\"nlme / sandwich, or fixest for the interacted form\"},\"estimands\":[\"ATT\"],\"explain_key\":\"method.its.controlled\",\"id\":\"its.controlled\",\"needs\":[\"numpy\",\"pandas\",\"scipy\"],\"needs_overlap\":false,\"one_liner\":\"The same interruption, measured against a series the intervention did not touch, so a shock that hit everybody is not booked as your effect.\",\"options\":[{\"default\":null,\"help\":\"When the intervention took effect. A period number, or a date if the time column is a date. Normally set by the event_time role on the board.\",\"label\":\"Interruption time\",\"name\":\"event_time\",\"profile\":\"standard\",\"type\":\"string\"},{\"choices\":[\"first_post\",\"last_pre\"],\"default\":\"first_post\",\"help\":\"Whether the time you gave is the first period under the intervention, or the last period before it. Getting this wrong shifts every estimate by one period.\",\"label\":\"The marker is\",\"name\":\"event_marks\",\"profile\":\"standard\",\"type\":\"select\"},{\"default\":null,\"help\":\"How far after the interruption the headline effect is read. Leave empty to use the end of the observed follow-up. Anything beyond that is extrapolation.\",\"label\":\"Horizon (periods after the interruption)\",\"name\":\"horizon\",\"profile\":\"standard\",\"type\":\"number\"},{\"default\":0,\"help\":\"Periods right after the interruption while the policy was still bedding in. They are plotted but excluded from the fit, and the exclusion is recorded in the sample flow.\",\"label\":\"Phase-in periods to hold out\",\"min\":0,\"name\":\"transition_periods\",\"profile\":\"standard\",\"type\":\"int\"},{\"default\":null,\"help\":\"If the policy was announced before it took effect, give the announcement date. The model then carries two markers, so anticipation is estimated instead of being smeared into the implementation effect.\",\"label\":\"Announcement time\",\"name\":\"announcement_time\",\"profile\":\"advanced\",\"type\":\"string\"},{\"default\":null,\"help\":\"12 for monthly data, 4 for quarterly, 7 for daily-with-weekly-pattern. Leave empty if the series has no season.\",\"label\":\"Seasonal cycle length\",\"name\":\"season_period\",\"profile\":\"standard\",\"type\":\"number\"},{\"choices\":[\"auto\",\"none\",\"harmonic\",\"dummy\"],\"default\":\"auto\",\"help\":\"Harmonics (a smooth cycle, cheap in degrees of freedom) or dummies (one per slot, flexible but expensive). 'auto' uses harmonics when a cycle length is given.\",\"label\":\"Seasonality as\",\"name\":\"seasonality\",\"profile\":\"advanced\",\"type\":\"select\"},{\"default\":2,\"help\":\"How wiggly the seasonal shape is allowed to be. Two pairs handle most public-health series.\",\"label\":\"Number of harmonic pairs\",\"max\":6,\"min\":1,\"name\":\"harmonics\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":0.95,\"help\":\"Coverage of the reported intervals.\",\"label\":\"Confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"},{\"choices\":[\"mean\",\"sum\",\"median\"],\"default\":null,\"help\":\"Only needed when the data has several rows per period. Leaving it empty is an error rather than a silent average, because the choice changes the answer.\",\"label\":\"Aggregate duplicate periods by\",\"name\":\"aggregate\",\"profile\":\"advanced\",\"type\":\"select\"},{\"choices\":[\"hac\",\"ols\"],\"default\":\"hac\",\"help\":\"Newey-West HAC is the default because time-series residuals are almost always correlated. Plain OLS is offered so you can see how much difference it makes.\",\"label\":\"Standard errors\",\"name\":\"se\",\"profile\":\"standard\",\"type\":\"select\"},{\"default\":null,\"help\":\"How many periods of correlation the standard errors allow for. Empty uses the usual rule, floor(4*(n/100)^(2/9)).\",\"label\":\"HAC lag length\",\"min\":0,\"name\":\"hac_lags\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":null,\"help\":\"How many lags the Ljung-Box and Breusch-Godfrey tests look at.\",\"label\":\"Autocorrelation test lags\",\"min\":1,\"name\":\"ljung_box_lags\",\"profile\":\"advanced\",\"type\":\"int\"},{\"choices\":[\"interacted\",\"difference\"],\"default\":\"interacted\",\"help\":\"'Interacted' fits the treated and control series together so you can see the control's own jump; 'difference' subtracts the control first and runs one clean segmented regression.\",\"label\":\"Model\",\"name\":\"model\",\"profile\":\"standard\",\"type\":\"select\"},{\"choices\":[\"mean\",\"pool\"],\"default\":\"mean\",\"help\":\"'Mean' averages them into one comparison series; 'pool' keeps them as separate rows so each carries equal weight per period.\",\"label\":\"Several controls become\",\"name\":\"control_combine\",\"profile\":\"advanced\",\"type\":\"select\"}],\"probes\":[\"placebo_time\",\"placebo_outcome\",\"alternate_spec\",\"leave_one_control_out\"],\"reference_dispositions\":[{\"disposition\":\"resolved_metadata\",\"id\":\"10.1046/j.1365-2710.2002.00430.x\",\"requested_as\":\"Wagner, Soumerai, Zhang & Ross-Degnan (2002), Segmented regression analysis of interrupted time series studies in medication use research\"},{\"disposition\":\"resolved_metadata\",\"id\":\"bernal2017\",\"requested_as\":\"Bernal, Cummins & Gasparrini (2017), Interrupted time series regression for the evaluation of public health interventions: a tutorial\"},{\"disposition\":\"resolved_metadata\",\"id\":\"10.2307/1913610\",\"requested_as\":\"Newey & West (1987), A simple, positive semi-definite, heteroskedasticity and autocorrelation consistent covariance matrix\"},{\"disposition\":\"resolved_metadata\",\"id\":\"10.1136/bmj.h2750\",\"requested_as\":\"Kontopantelis, Doran, Springate, Buchan & Reeves (2015), Regression based quasi-experimental approach when randomisation is not an option\"},{\"disposition\":\"resolved_metadata\",\"id\":\"10.1093/ije/dyy135\",\"requested_as\":\"Lopez Bernal, Cummins & Gasparrini (2018), The use of controls in interrupted time series studies of public health interventions\"},{\"disposition\":\"resolved_metadata\",\"id\":\"10.1162/003465398557825\",\"requested_as\":\"Driscoll & Kraay (1998), Consistent covariance matrix estimation with spatially dependent panel data\"}],\"reference_ids\":[\"10.1046/j.1365-2710.2002.00430.x\",\"bernal2017\",\"10.2307/1913610\",\"10.1136/bmj.h2750\",\"10.1093/ije/dyy135\",\"10.1162/003465398557825\"],\"references\":[\"Wagner, Soumerai, Zhang & Ross-Degnan (2002), Segmented regression analysis of interrupted time series studies in medication use research\",\"Bernal, Cummins & Gasparrini (2017), Interrupted time series regression for the evaluation of public health interventions: a tutorial\",\"Newey & West (1987), A simple, positive semi-definite, heteroskedasticity and autocorrelation consistent covariance matrix\",\"Kontopantelis, Doran, Springate, Buchan & Reeves (2015), Regression based quasi-experimental approach when randomisation is not an option\",\"Lopez Bernal, Cummins & Gasparrini (2018), The use of controls in interrupted time series studies of public health interventions\",\"Driscoll & Kraay (1998), Consistent covariance matrix estimation with spatially dependent panel data\"],\"roles_forbidden\":[\"forbidden\"],\"roles_optional\":[\"confounders\",\"treatment\"],\"roles_required\":[\"outcome\",\"time\",\"event_time\",\"control_series\"],\"source_path\":\"engines/python/capy_py/its.py\",\"source_sha256\":\"88a1fc1758dc94c7257e85a7c5a844e5787c0686140255e359c093b6baae8f7a\",\"status\":\"recommended\",\"title\":\"Controlled ITS\",\"what_can_go_wrong\":\"It trades one assumption for another: instead of assuming the trend would have continued, you assume the two series would have moved in parallel. A control that was itself partly exposed pulls the estimate towards zero. Averaging controls that sit at very different levels lets the biggest one decide the answer. Simplification: the interacted model uses Driscoll-Kraay standard errors, which lean on having a reasonable number of periods and are thin on the cross-sectional side when there are only two or three series.\",\"why_recommended\":\"A single interrupted series cannot tell your intervention apart from anything else that happened that month. A control series that was not exposed can, and the control's own level and slope change are reported so you can see whether the shock was shared.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:00d51e86e5ce2c00d1f175f0\",\"object_id\":\"10.1162/003465398557825\",\"predicate\":\"cites\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"its.controlled\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:05b1214d6279cad7c4564b67\",\"object_id\":\"10.1093/ije/dyy135\",\"predicate\":\"cites\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICEN