r this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"obs.weighting.cbps\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:f349d60a10a361ba350f1ea7\",\"object_id\":\"interference.exposure\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"obs.weighting.cbps\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:f5be743904fe199ecea5cb52\",\"object_id\":\"diagnostic:ps_calibration\",\"predicate\":\"checked_by_diagnostic\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"obs.weighting.cbps\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Fit the treatment model so that it balances covariates, rather than fitting it to predict treatment and hoping balance follows.\",\"title\":\"Covariate balancing propensity score\"}" .
<urn:capy:obs.weighting.entropy> a capy:method ; skos:prefLabel "Entropy balancing" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:obs.weighting.entropy\"],\"catalogue_key\":\"method:obs.weighting.entropy\",\"citation_ids\":[\"10.1093/pan/mpr025\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":null,\"engines\":{\"python\":true,\"r\":\"ebal\"},\"needs_r_packages\":[\"ebal\"],\"runs_here\":true,\"summary\":\"Runs on this computer with what the app already installs.\"},\"designs\":[{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.love\",\"id\":\"love\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Covariate balance (Love plot)\"},{\"explain_key\":\"diagnostic.ess\",\"id\":\"ess\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Effective sample size\"},{\"explain_key\":\"diagnostic.ebal_convergence\",\"id\":\"ebal_convergence\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Moment balance\"}],\"estimands\":[{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"}],\"explain_key\":\"method.obs.weighting.entropy\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"obs.weighting.entropy\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":true,\"one_liner\":\"Find the weights closest to equal that make the covariate means match exactly.\",\"options\":[{\"default\":1,\"help\":\"1 balances means, 2 adds variances, 3 adds skewness.\",\"label\":\"Moments to balance\",\"max\":3,\"min\":1,\"name\":\"moments\",\"profile\":\"standard\",\"type\":\"int\"}],\"plain_language\":\"Find the weights closest to equal that make the covariate means match exactly.\",\"probes\":[{\"explain_key\":\"probe.placebo_outcome\",\"id\":\"probe.placebo_outcome\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the same analysis on something the treatment could not have changed. It should find nothing.\",\"requested_as\":\"probe.placebo_outcome\",\"title\":\"Placebo outcome\"},{\"explain_key\":\"probe.subset\",\"id\":\"probe.subset\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Re-estimate on random subsets. The answer should move about as much as losing that much data costs, and no more.\",\"requested_as\":\"probe.subset\",\"title\":\"Subset stability\"},{\"explain_key\":\"probe.cinelli_hazlett\",\"id\":\"probe.cinelli_hazlett\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"How strong would an unmeasured confounder have to be -- compared with the covariates you already have -- to explain the estimate away?\",\"requested_as\":\"probe.cinelli_hazlett\",\"title\":\"Cinelli-Hazlett sensitivity (partial R2)\"}],\"references\":[\"Hainmueller (2012), Entropy balancing for causal effects\"],\"roles_forbidden\":[\"forbidden\"],\"roles_optional\":[\"a clustering variable\",\"weight\",\"effect_modifiers\"],\"roles_required\":[\"a treatment\",\"an outcome\",\"at least one measured confounder\"],\"see_also\":[{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"},{\"explain_key\":\"method.bounds.manski\",\"id\":\"bounds.manski\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Report the range the effect must lie in given only what the data can support, without assuming away the missing counterfactual.\",\"title\":\"Manski bounds\"},{\"explain_key\":\"method.interference.exposure\",\"id\":\"interference.exposure\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"When one unit's treatment affects another's outcome, estimate the direct and spillover effects separately instead of pretending neither exists.\",\"title\":\"Interference and spillovers\"},{\"explain_key\":\"method.ml.causal_forest\",\"id\":\"ml.causal_forest\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Grow trees that look for units whose effect differs, keeping the rows that chose each split away from the rows that estimate it.\",\"title\":\"Honest causal forest\"},{\"explain_key\":\"method.ml.dml_irm\",\"id\":\"ml.dml_irm\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"A separate outcome model for each arm plus a treatment model, combined in a doubly robust score: right if either side is right.\",\"title\":\"Double ML (interactive)\"},{\"explain_key\":\"method.ml.metalearner\",\"id\":\"ml.metalearner\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Build the per-unit effect out of ordinary prediction models, four different ways, on the same cross-fitting.\",\"title\":\"Meta-learner (T, S, X, DR)\"},{\"explain_key\":\"method.obs.aipw\",\"id\":\"obs.aipw\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Use a treatment model and an outcome model together; it is right if either one is.\",\"title\":\"Doubly robust (AIPW)\"}],\"status\":\"recommended\",\"status_label\":\"Recommended\",\"tags\":[\"Adjust for background differences\",\"ATT\",\"Recommended\"],\"title\":\"Entropy balancing\",\"what_it_assumes\":[{\"explain_key\":\"assumption.exchangeability\",\"explains\":\"Treated and untreated units are comparable once you condition on the confounders you measured. Everything that pushed people towards treatment and also moves the outcome is in your adjustment set.\",\"id\":\"exchangeability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Exchangeability / no unmeasured confounding\",\"worry_when\":\"Treatment was chosen by people who knew something about the likely outcome that you do not observe. Clinical judgement, self-selection into a programme, and administrative triage are the classic cases.\"},{\"explain_key\":\"assumption.positivity\",\"explains\":\"Every kind of unit had some chance of being treated and some chance of not being treated. Where that fails, there is no comparison to make and the model is inventing one.\",\"id\":\"positivity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Positivity / overlap\",\"worry_when\":\"Any single weight carries a large share of the total; the effective sample is far below the nominal one; the propensity model separates the arms almost perfectly; treated units sit outside the control group's range.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"when_not_to_use\":[\"If the treated profile lies outside the control group's range, no weights exist and the solver says so rather than quietly returning something.\"],\"when_to_use\":[\"Balance on the requested moments is exact by construction, so there is no iterate-and-recheck loop.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"obs.weighting.entropy\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"obs.weighting.entropy\",\"registry\":{\"designs\":[\"observational\"],\"diagnostics\":[\"love\",\"ess\",\"ebal_convergence\"],\"disrecommend_when\":null,\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":true,\"r\":\"ebal\"},\"estimands\":[\"ATT\"],\"explain_key\":\"method.obs.weighting.entropy\",\"id\":\"obs.weighting.entropy\",\"needs\":[\"numpy\",\"scipy\",\"pandas\"],\"needs_overlap\":true,\"one_liner\":\"Find the weights closest to equal that make the covariate means match exactly.\",\"options\":[{\"default\":1,\"help\":\"1 balances means, 2 adds variances, 3 adds skewness.\",\"label\":\"Moments to balance\",\"max\":3,\"min\":1,\"name\":\"moments\",\"profile\":\"standard\",\"type\":\"int\"}],\"probes\":[\"probe.placebo_outcome\",\"probe.subset\",\"probe.cinelli_hazlett\"],\"reference_dispositions\":[{\"disposition\":\"resolved_metadata\",\"id\":\"10.1093/pan/mpr025\",\"requested_as\":\"Hainmueller (2012), Entropy balancing for causal effects\"}],\"reference_ids\":[\"10.1093/pan/mpr025\"],\"references\":[\"Hainmueller (2012), Entropy balancing for causal effects\"],\"roles_forbidden\":[\"forbidden\"],\"roles_optional\":[\"cluster\",\"weight\",\"effect_modifiers\"],\"roles_required\":[\"treatment\",\"outcome\",\"confounders\"],\"source_path\":\"engines/python/capy_py/observational.py\",\"source_sha256\":\"f9dfafacc9dacabf923e4d48367973338dbe326bdf5c222ade0dedf0470b5ccb\",\"status\":\"recommended\",\"title\":\"Entropy balancing\",\"what_can_go_wrong\":\"If the treated profile lies outside the control group's range, no weights exist and the solver says so rather than quietly returning something.\",\"why_recommended\":\"Balance on the requested moments is exact by construction, so there is no iterate-and-recheck loop.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:088c23c7f4f81a92df3e264d\",\"object_id\":\"concept:estimand-estimator-estimate\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:ich2019\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"obs.weighting.entropy\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:0d05ec54ccf0aa47bef10f75\",\"object_id\":\"concept:baseline-covariates\",\"predicate\":\"related_to\",\"prov