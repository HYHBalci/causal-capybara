type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped proposition explains or qualifies this concept; support remains limited to the exact original evidence note.\",\"subject_id\":\"claim:competing-target\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:young2019\",\"source:ontology:stensrud2020\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped original methodological explanation; no whole-method or study audit is implied.\",\"source_ids\":[\"source:note:competing-target\",\"source:ontology:young2019\",\"source:ontology:stensrud2020\"],\"summary\":\"A competing event prevents the focal event. A contrast of focal-event cumulative incidence with competitors present differs from a hypothetical contrast eliminating those events. Treating a competing death as ordinary censoring can silently change the question. Separable-effect targets require meaningful treatment-component interventions and additional identification conditions. A one-event adapter must reject incompatible event coding instead of presenting an unsupported competing-event analysis.\",\"title\":\"Competing-event handling changes the causal question\"}" .
<urn:capy:claim%3Adid-aggregation> a capy:claim ; skos:prefLabel "DiD aggregation weights and event-time composition" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Adid> ; capy:record "{\"aliases\":[\"event time\",\"dynamic aggregation\",\"aggregation weights\",\"balanced event time cohorts\",\"cohort composition\"],\"assertion_mode\":\"original_editorial_explanation\",\"citation_ids\":[\"callaway2021\",\"source:note:did\"],\"citations\":[],\"conditions\":[\"Eligible cohort-time cells are declared.\",\"Aggregation weights and exposure window are reported.\",\"Any fixed-cohort restriction is reflected in the target population.\"],\"counterevidence\":[\"Changing event-time composition can mimic changes in effects.\",\"Holding cohort composition fixed reduces the available cohorts and may reduce precision.\"],\"evidence_ids\":[\"evidence:did-aggregation\"],\"gaps\":[\"A single overall average does not reveal all cohort heterogeneity.\"],\"id\":\"claim:did-aggregation\",\"kind\":\"claim\",\"provenance\":[\"source:note:did\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:2045e10b3c32e6d210c4c4d1\",\"object_id\":\"callaway2021\",\"predicate\":\"cites\",\"provenance\":[\"source:note:did\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/did_modern.py\",\"tests/python/test_did_modern.py\",\"https://arxiv.org/html/1803.09015v4\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project mate