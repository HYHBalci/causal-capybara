:\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped proposition explains or qualifies this concept; support remains limited to the exact original evidence note.\",\"subject_id\":\"claim:target-time\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:fe35cc38ec8b61d9f7708307\",\"object_id\":\"source:ontology:hernan2016\",\"predicate\":\"cites\",\"provenance\":[\"source:note:target-time\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:hernan2016\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Citation and original explanation; linked external bodies are not included.\",\"subject_id\":\"claim:target-time\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:hernan2016\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped original methodological explanation; no whole-method or study audit is implied.\",\"source_ids\":[\"source:note:target-time\",\"source:ontology:hernan2016\"],\"summary\":\"An exposure label constructed from events after eligibility can require units to survive until they receive that label. Counting that guaranteed event-free period as exposed follow-up introduces immortal-time bias. Specify eligibility, assignment or strategy classification, and start of follow-up together; inspect joins and exclusion rules for future information. The appropriate emulation depends on the intended strategy, not only on available timestamps.\",\"title\":\"Eligibility and follow-up must share a defensible time zero\"}" .
