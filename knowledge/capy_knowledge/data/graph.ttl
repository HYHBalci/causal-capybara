ssions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Source context for original explanation; linked external bodies are not redistributed.\",\"subject_id\":\"concept:categorical-outcome-interaction\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret in the declared target population, sampling design and outcome scale.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:71bd5d416f813d9e6d663e5f\",\"object_id\":\"source:ontology:statsmodels-mnlogit\",\"predicate\":\"cites\",\"provenance\":[\"source:project-ontology\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Source context for original explanation; linked external bodies are not redistributed.\",\"subject_id\":\"concept:categorical-outcome-interaction\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret in the declared target population, sampling design and outcome scale.\"],\"counterevidence\":[],\"gaps\":[\"Implementation availability must be checked in the registry.\"],\"id\":\"relation:8f3359aba5a743ed55bf944c\",\"object_id\":\"concept:effect-modification\",\"predicate\":\"broader\",\"provenance\":[\"source:project-ontology\",\"source:ontology:statsmodels-mnlogit\",\"source:ontology:statsmodels-wald\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Qualified conceptual navigation, not an identifying assumption or equivalence.\",\"subject_id\":\"concept:categorical-outcome-interaction\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Original explanation of Categorical-outcome probability heterogeneity; verify the exact target and local implementation.\",\"source_ids\":[\"source:ontology:statsmodels-mnlogit\",\"source:ontology:statsmodels-wald\"],\"summary\":\"A multinomial model represents a probability for each outcome category. Nominal labels are not numerical scores; applying this model to ordered labels does not impose proportional odds or estimate a common ordinal shift. Category probabilities sum to one, so joint tests must account for their dependent contrasts.\",\"title\":\"Categorical-outcome probability heterogeneity\"}" .
