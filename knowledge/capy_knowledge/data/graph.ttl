<urn:capy:ml.metalearner> a capy:method ; skos:prefLabel "Meta-learner (T, S, X, DR)" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:ml.metalearner\"],\"catalogue_key\":\"method:ml.metalearner\",\"citation_ids\":[\"10.1073/pnas.1804597116\",\"10.1214/23-ejs2157\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":null,\"engines\":{\"python\":true,\"r\":\"grf\"},\"needs_r_packages\":[\"grf\"],\"runs_here\":true,\"summary\":\"Runs on this computer with what the app already installs.\"},\"designs\":[{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.nuisance_rmse\",\"id\":\"nuisance_rmse\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Nuisance models by fold\"},{\"explain_key\":\"diagnostic.propensity_clipping\",\"id\":\"propensity_clipping\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Propensity clipping\"},{\"explain_key\":\"diagnostic.cate_distribution\",\"id\":\"cate_distribution\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"CATE distribution\"},{\"explain_key\":\"diagnostic.cate_calibration\",\"id\":\"cate_calibration\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"CATE calibration\"},{\"explain_key\":\"diagnostic.rate\",\"id\":\"rate\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Rank-weighted average treatment effect\"},{\"explain_key\":\"diagnostic.fold_stability\",\"id\":\"fold_stability\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Stability across folds\"},{\"explain_key\":\"diagnostic.seed_stability\",\"id\":\"seed_stability\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Stability across seeds\"},{\"explain_key\":\"diagnostic.metalearner_plug_in\",\"id\":\"metalearner_plug_in\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Plug-in bias of the meta-learner\"}],\"estimands\":[{\"acronym\":\"CATE\",\"explain_key\":\"estimand.cate\",\"id\":\"CATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"How does the effect vary from person to person, or place to place?\",\"title\":\"Conditional average treatment effect\"},{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"},{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"}],\"explain_key\":\"method.ml.metalearner\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"ml.metalearner\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":true,\"one_liner\":\"Build the per-unit effect out of ordinary prediction models, four different ways, on the same cross-fitting.\",\"options\":[{\"choices\":[\"linear\",\"lasso\",\"forest\",\"gradient_boosting\"],\"default\":\"linear\",\"help\":\"The model used for E[Y|X] and E[D|X]. Boring is usually right: a regularised linear model is hard to beat when the sample is small, and a flexible learner cannot fix a confounder you did not measure.\",\"label\":\"Nuisance learner\",\"name\":\"learner\",\"profile\":\"standard\",\"type\":\"select\"},{\"default\":5,\"help\":\"Each fold is scored by models that never saw it. More folds use the data better and cost more time; below 5 the estimate starts to depend on the split.\",\"label\":\"Cross-fitting folds\",\"max\":20,\"min\":2,\"name\":\"folds\",\"profile\":\"standard\",\"type\":\"int\"},{\"default\":0.01,\"help\":\"Keeps the weights finite when a unit is nearly certain to be treated. Every clipped unit is reported, because clipping quietly changes the population.\",\"label\":\"Clip propensity scores at\",\"max\":0.45,\"min\":0.0,\"name\":\"clip\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":0.95,\"help\":\"The interval width. Changing it after seeing the result is not a neutral act.\",\"label\":\"Confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":1,\"help\":\"Reruns the whole cross-fitting under fresh random splits. The split is an arbitrary choice; the answer should not depend on it.\",\"label\":\"Repeat under new fold splits\",\"max\":10,\"min\":1,\"name\":\"stability_reps\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":200,\"help\":\"Draws used for the standard error of the targeting curve. 0 skips it.\",\"label\":\"Bootstrap draws for the RATE curve\",\"max\":2000,\"min\":0,\"name\":\"rate_reps\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":[],\"help\":\"Groups you named BEFORE looking. Each one gets the same doubly robust score as the headline, and the multiplicity caution comes with them.\",\"label\":\"Pre-registered subgroups\",\"name\":\"subgroups\",\"profile\":\"standard\",\"type\":\"columns\"},{\"choices\":[\"t\",\"s\",\"x\",\"dr\"],\"default\":\"dr\",\"help\":\"T fits one outcome model per arm. S fits one model with treatment as a feature. X imputes each unit's effect from the other arm and weights by the propensity. DR regresses the doubly robust score on the modifiers and is the safest default.\",\"label\":\"Which meta-learner\",\"name\":\"metalearner\",\"profile\":\"standard\",\"type\":\"select\"},{\"choices\":[\"ATE\",\"ATT\"],\"default\":\"ATE\",\"help\":\"The headline average always comes from the doubly robust score, because that is the number with a defensible interval.\",\"label\":\"Population for the headline average\",\"name\":\"estimand\",\"profile\":\"standard\",\"type\":\"select\"}],\"plain_language\":\"Build the per-unit effect out of ordinary prediction models, four different ways, on the same cross-fitting.\",\"probes\":[{\"explain_key\":\"probe.cinelli_hazlett\",\"id\":\"probe.cinelli_hazlett\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"How strong would an unmeasured confounder have to be -- compared with the covariates you already have -- to explain the estimate away?\",\"requested_as\":\"probe.cinelli_hazlett\",\"title\":\"Cinelli-Hazlett sensitivity (partial R2)\"},{\"explain_key\":\"probe.rosenbaum\",\"id\":\"probe.rosenbaum\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"How unequal could the odds of treatment be inside a matched pair before the conclusion stopped being clear?\",\"requested_as\":\"probe.rosenbaum\",\"title\":\"Rosenbaum bounds\"},{\"explain_key\":\"probe.placebo_outcome\",\"id\":\"probe.placebo_outcome\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the same analysis on something the treatment could not have changed. It should find nothing.\",\"requested_as\":\"probe.placebo_outcome\",\"title\":\"Placebo outcome\"},{\"explain_key\":\"probe.subset\",\"id\":\"probe.subset\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Re-estimate on random subsets. The answer should move about as much as losing that much data costs, and no more.\",\"requested_as\":\"probe.subset\",\"title\":\"Subset stability\"},{\"explain_key\":\"probe.random_common_cause\",\"id\":\"probe.random_common_cause\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Add a variable that causes nothing to the adjustment set. The estimate should barely move.\",\"requested_as\":\"probe.random_common_cause\",\"title\":\"Random common cause\"},{\"explain_key\":\"probe.trim_curve\",\"id\":\"probe.trim_curve\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Re-estimate across a grid of propensity-score trimming thresholds instead of picking one and hoping.\",\"requested_as\":\"probe.trim_curve\",\"title\":\"Trimming curve\"}],\"references\":[\"Kunzel, Sekhon, Bickel & Yu (2019), Metalearners for estimating heterogeneous treatment effects using machine learning\",\"Kennedy (2023), Towards optimal doubly robust estimation of heterogeneous causal effects\"],\"roles_forbidden\":[\"forbidden\"],\"roles_optional\":[\"effect_modifiers\",\"a clustering variable\"],\"roles_required\":[\"a treatment\",\"an outcome\",\"at least one measured confounder\"],\"see_also\":[{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"},{\"explain_key\":\"method.bounds.manski\",\"id\":\"bounds.manski\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Report the range the effect must lie in given only what the data can support, without assuming away the missing counterfactual.\",\"title\":\"Manski bounds\"},{\"explain_key\":\"method.heterogeneity.binary\",\"id\":\"heterogeneity.binary\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Logistic interactions plus separate standardized risk-difference, risk-ratio or marginal odds-ratio heterogeneity tests.\",\"title\":\"Binary outcome heterogeneity\"},{\"explain_key\":\"method.heterogeneity.categorical\",\"id\":\"heterogeneity.categorical\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Multinomial treatment interactions and a joint test of category-probability contrasts; preserves categories without assigning numeric scores.\",\"title\":\"Nominal and ordinal outcome heterogeneity\"},{\"explain_key\":\"method.heterogeneity.continuous\",\"id\":\"heterogeneity.continuous\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"OLS treatment-by-baseline-modifier interactions with HC3 or cluster sandwich inference, direct mean-difference tests and Holm pairwise comparisons.\",\"title\":\"Continuous outcome heterogeneity\"},{\"explain_key\":\"method.heterogeneity.count\",\"id\":\"heterogeneity.count\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Poisson conditional-mean interactions with robust sandwich inference; compare standardized count or fixed-exposure rate contrasts.\",\"title\":\"Count and rate outcome heterogeneity\"},{\"explain_key\":\"method.interference.exposure\",\"id\":\"interference.exposure\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"When one unit's treatment affects another's outcome, estimate the direct and spillover effects separately instead of pretending neither exists.\",\"title\":\"Interference and spillovers\"}],\"status\":\"reasonable\",\"status_label\":\"Reasonable\",\"tags\":[\"Adjust for background differences\",\"CATE\",\"ATE\",\"ATT\",\"Reasonable\"],\"title\":\"Meta-learner (T, S, X, DR)\",\"what_it_assumes\":[{\"explain_key\":\"assumption.exchangeability\",\"explains\":\"Treated and untreated units are comparable once you condition on the confounders you measured. Everything that pushed people towards treatment and also moves the outcome is in your adjustment set.\",\"id\":\"exchangeability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Exchangeability / no unmeasured confounding\",\"worry_when\":\"Treatment was chosen by people who knew something about the likely outcome that you do not observe. Clinical judgement, self-selection into a programme, and administrative triage are the classic cases.\"},{\"explain_key\":\"assumption.positivity\",\"explains\":\"Every kind of unit had some chance of being treated and some chance of not being treated. Where that fails, there is no comparison to make and the model is inventing one.\",\"id\":\"positivity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Positivity / overlap\",\"worry_when\":\"Any single weight carries a large share of the total; the effective sample is far below the nominal one; the propensity model separates the arms almost perfectly; treated units sit outside the control group's range.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"when_not_to_use\":[\"The S-learner can regularise the treatment effect away to nothing. The T-learner inherits both outcome models' biases. None of the per-unit effects carries an interval, and the plain average of a learner's predictions is shrunk, which is why it is never the headline here. Machine learning does not identify anything. Cross-fitting removes the bias that comes from fitting flexible models on the same rows you estimate with; it does nothing about a confounder you never measured.\",\"You want one average effect and nothing else -- ml.dml_irm is the same score with less machinery.\"],\"when_to_use\":[\"Comparing meta-learners on the same folds is the cheapest way to see how much of your 'heterogeneity' is the learner rather than the world.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"ml.metalearner\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"ml.metalearner\",\"registry\":{\"designs\":[\"observational\"],\"diagnostics\":[\"nuisance_rmse\",\"propensity_clipping\",\"cate_distribution\",\"cate_calibration\",\"rate\",\"fold_stability\",\"seed_stability\",\"metalearner_plug_in\"],\"disrecommend_when\":\"You want one average effect and nothing else -- ml.dml_irm is the same score with less machinery.\",\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":true,\"r\":\"grf\"},\"estimands\":[\"CATE\",\"ATE\",\"ATT\"],\"explain_key\":\"method.ml.metalearner\",\"id\":\"ml.metalearner\",\"needs\":[\"numpy\",\"scipy\",\"pandas\",\"scikit-learn\"],\"needs_overlap\":true,\"one_liner\":\"Build the per-unit effect out of ordinary prediction models, four different ways, on the same cross-fitting.\",\"options\":[{\"choices\":[\"linear\",\"lasso\",\"forest\",\"gradient_boosting\"],\"default\":\"linear\",\"help\":\"The model used for E[Y|X] and E[D|X]. Boring is usually right: a regularised linear model is hard to beat when the sample is small, and a flexible learner cannot fix a confounder you did not measure.\",\"label\":\"Nuisance learner\",\"name\":\"learner\",\"profile\":\"standard\",\"type\":\"select\"},{\"default\":5,\"help\":\"Each fold is scored by models that never saw it. More folds use the data better and cost more time; below 5 the estimate starts to depend on the split.\",\"label\":\"Cross-fitting folds\",\"max\":20,\"min\":2,\"name\":\"folds\",\"profile\":\"standard\",\"type\":\"int\"},{\"default\":0.01,\"help\":\"Keeps the weights finite when a unit is nearly certain to be treated. Every clipped unit is reported, because clipping quietly changes the population.\",\"label\":\"Clip propensity scores at\",\"max\":0.45,\"min\":0.0,\"name\":\"clip\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":0.95,\"help\":\"The interval width. Changing it after seeing the result is not a neutral act.\",\"label\":\"Confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":1,\"help\":\"Reruns the whole cross-fitting under fresh random splits. The split is an arbitrary choice; the answer should not depend on it.\",\"label\":\"Repeat under new fold splits\",\"max\":10,\"min\":1,\"name\":\"stability_reps\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":200,\"help\":\"Draws used for the standard error of the targeting curve. 0 skips it.\",\"label\":\"Bootstrap draws for the RATE curve\",\"max\":2000,\"min\":0,\"name\":\"rate_reps\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":[],\"help\":\"Groups you named BEFORE looking. Each one gets the same doubly robust score as the headline, and the multiplicity caution comes with them.\",\"label\":\"Pre-registered subgroups\",\"name\":\"subgroups\",\"profile\":\"standard\",\"type\":\"columns\"},{\"choices\":[\"t\",\"s\",\"x\",\"dr\"],\"default\":\"dr\",\"help\":\"T fits one outcome model per arm. S fits one model with treatment as a feature. X imputes each unit's effect from the other arm and weights by the propensity. DR regresses the doubly robust score on the modifiers and is the safest default.\",\"label\":\"Which meta-learner\",\"name\":\"metalearner\",\"profile\":\"standard\",\"type\":\"select\"},{\"choices\":[\"ATE\",\"ATT\"],\"default\":\"ATE\",\"help\":\"The headline average always comes from the doubly robust score, because that is the number with a defensible interval.\",\"label\":\"Population for the headline average\",\"name\":\"estimand\",\"profile\":\"standard\",\"type\":\"select\"}],\"probes\":[\"probe.cinelli_hazlett\",\"probe.rosenbaum\",\"probe.placebo_outcome\",\"probe.subset\",\"probe.random_common_cause\",\"probe.trim_curve\"],\"reference_dispositions\":[{\"disposition\":\"resolved_metadata\",\"id\":\"10.1073/pnas.1804597116\",\"requested_as\":\"Kunzel, Sekhon, Bickel & Yu (2019), Metalearners for estimating heterogeneous treatment effects using machine learning\"},{\"disposition\":\"resolved_metadata\",\"id\":\"10.1214/23-ejs2157\",\"requested_as\":\"Kennedy (2023), Towards optimal doubly robust estimation of heterogeneous causal effects\"}],\"reference_ids\":[\"10.1073/pnas.1804597116\",\"10.1214/23-ejs2157\"],\"references\":[\"Kunzel, Sekhon, Bickel & Yu (2019), Metalearners for estimating heterogeneous treatment effects using machine learning\",\"Kennedy (2023), Towards optimal doubly robust estimation of heterogeneous causal effects\"],\"roles_forbidden\":[\"forbidden\"],\"roles_optional\":[\"effect_modifiers\",\"cluster\"],\"roles_required\":[\"treatment\",\"outcome\",\"confounders\"],\"source_path\":\"engines/python/capy_py/causalml.py\",\"source_sha256\":\"1c60218ff563078a18a811cc23ca51cddaad89bb27de76b552224a35be8473ca\",\"status\":\"reasonable\",\"title\":\"Meta-learner (T, S, X, DR)\",\"what_can_go_wrong\":\"The S-learner can regularise the treatment effect away to nothing. The T-learner inherits both outcome models' biases. None of the per-unit effects carries an interval, and the plain average of a learner's predictions is shrunk, which is why it is never the headline here. Machine learning does not identify anything. Cross-fitting removes the bias that comes from fitting flexible models on the same rows you estimate with; it does nothing about a confounder you never measured.\",\"why_recommended\":\"Comparing meta-learners on the same folds is the cheapest way to see how much of your 'heterogeneity' is the learner rather than the world.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:007a1ce3b911753c709424d4\",\"object_id\":\"diagnostic:seed_stability\",\"predicate\":\"checked_by_diagnostic\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10