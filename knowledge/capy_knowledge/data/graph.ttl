agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/observational.py\",\"tests/python/test_observational.py\",\"https://miguelhernan.org/whatifbook\",\"https://pmc.ncbi.nlm.nih.gov/articles/PMC2732954/\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"source_ids\":[\"source:note:aipw\",\"hernan2020\",\"10.1093/aje/kwn164\"],\"summary\":\"Balance, overlap, effective sample size, clipping and nuisance diagnostics help find weak adjustment; they cannot prove unmeasured exchangeability or causal identification.\",\"title\":\"AIPW diagnostics do not prove exchangeability\"}" .
<urn:capy:claim%3Aaipw-double-robustness> a capy:claim ; skos:prefLabel "AIPW double robustness and its scope" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Aaipw> ; capy:record "{\"aliases\":[\"doubly robust consistency\",\"augmented inverse probability weighting\",\"one nuisance correct\",\"propensity model correctness\",\"outcome model correctness\"],\"assertion_mode\":\"original_editorial_explanation\",\"citation_ids\":[\"bang2005\",\"chernozhukov2018\",\"source:note:aipw\"],\"citations\":[],\"conditions\":[\"The target is identified.\",\"Propensity or relevant outcome nuisance converges appropriately.\",\"Clipping must not invalidate the claimed propensity branch; regularity and integrability remain necessary.\"],\"counterevidence\":[\"Both nuisances may be wrong.\",\"Consistency under one correct nuisance does not automatically justify the reported interval.\"],\"evidence_ids\":[\"evidence:aipw-double-robustness\"],\"gaps\":[\"No finite-sample coverage guarantee is supplied.\"],\"id\":\"claim:aipw-double-robustness\",\"kind\":\"claim\",\"provenance\":[\"source:note:aipw\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:10899fbeab275a5129ac6af0\",\"object_id\":\"chernozhukov2018\",\"predicate\":\"cites\",\"provenance\":[\"source:note:aipw\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/observational.py\",\"tests/python/test_observational.py\",\"https://doi.org/10.1111/j.1541-0420.2005.00377.x\",\"https://arxiv.org/html/1608.00060v7\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Citation and original explanation; linked external bodies are not included.\",\"subject_id\":\"claim:aipw-double-robustness\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"The target is identified.\",\"Propensity or relevant outcome nuisance converges appropriately.\",\"Clipping must not invalidate the claimed propensity branch; regularity and integrability remain necessary.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:7f3b9351925c5c20841b1f93\",\"object_id\":\"obs.aipw\",\"predicate\":\"qualifies\",\"provenance\":[\"source:note:aipw\",\"bang2005\",\"chernozhukov2018\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/observational.py\",\"tests/python/test_observational.py\",\"https://doi.org/10.1111/j.1541-0420.2005.00377.x\",\"https://arxiv.org/html/1608.00060v7\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"subject_id\":\"claim:aipw-double-robustness\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:8aa3c418911778e9c6968eec\",\"object_id\":\"source:note:aipw\",\"predicate\":\"cites\",\"provenance\":[\"source:note:aipw\"],\"review\":{\"actor