<urn:capy:bounds.manski> a capy:method ; skos:prefLabel "Manski bounds" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:bounds.manski\"],\"catalogue_key\":\"method:bounds.manski\",\"citation_ids\":[\"source:unresolved:40dcbbb8dd486b8b8d3c\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":\"Not implemented. Designed for: the spec and result schema already allow an interval with no point estimate.\",\"engines\":{\"python\":false,\"r\":null},\"needs_r_packages\":[],\"runs_here\":false,\"summary\":\"Not built yet. The card is here so you can see that the method exists and read what it is for.\"},\"designs\":[{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"},{\"explain_key\":\"design.rct\",\"id\":\"rct\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"People were assigned by chance, or as good as chance.\",\"title\":\"Randomised or as-if randomised\"},{\"explain_key\":\"design.iv\",\"id\":\"iv\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"An instrument or encouragement changed treatment, not the outcome directly.\",\"title\":\"Something else pushed people in\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.outcome_distribution\",\"id\":\"outcome_distribution\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Outcome distribution\"}],\"estimands\":[{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"},{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"}],\"explain_key\":\"method.bounds.manski\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"bounds.manski\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":false,\"one_liner\":\"Report the range the effect must lie in given only what the data can support, without assuming away the missing counterfactual.\",\"options\":[],\"plain_language\":\"Report the range the effect must lie in given only what the data can support, without assuming away the missing counterfactual.\",\"probes\":[],\"references\":[\"Manski (1990), Nonparametric bounds on treatment effects\"],\"roles_forbidden\":[],\"roles_optional\":[],\"roles_required\":[\"a treatment\",\"an outcome\"],\"see_also\":[{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"},{\"explain_key\":\"design.rct\",\"id\":\"rct\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"People were assigned by chance, or as good as chance.\",\"title\":\"Randomised or as-if randomised\"},{\"explain_key\":\"design.iv\",\"id\":\"iv\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"An instrument or encouragement changed treatment, not the outcome directly.\",\"title\":\"Something else pushed people in\"},{\"explain_key\":\"method.interference.exposure\",\"id\":\"interference.exposure\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"When one unit's treatment affects another's outcome, estimate the direct and spillover effects separately instead of pretending neither exists.\",\"title\":\"Interference and spillovers\"},{\"explain_key\":\"method.iv.2sls\",\"id\":\"iv.2sls\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Use only the part of the treatment that the instrument moved, and see what happened to the outcome.\",\"title\":\"Two-stage least squares\"},{\"explain_key\":\"method.iv.gmm\",\"id\":\"iv.gmm\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Weight the instruments by how informative each one actually is, using a weight matrix estimated from the data.\",\"title\":\"Two-step GMM\"},{\"explain_key\":\"method.iv.liml\",\"id\":\"iv.liml\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"The maximum-likelihood cousin of two-stage least squares, which stays much better behaved when the instruments are weak.\",\"title\":\"LIML (and Fuller)\"},{\"explain_key\":\"method.iv.mte\",\"id\":\"iv.mte\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Trace the effect as a function of how reluctant a unit is to be treated, instead of reporting one local average.\",\"title\":\"Marginal treatment effects\"},{\"explain_key\":\"method.iv.shift_share\",\"id\":\"iv.shift_share\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Combine national shocks with local exposure shares to build an instrument for local changes.\",\"title\":\"Shift-share (Bartik) instruments\"}],\"status\":\"reasonable\",\"status_label\":\"Reasonable\",\"tags\":[\"Adjust for background differences\",\"Randomised or as-if randomised\",\"Something else pushed people in\",\"ATE\",\"ATT\",\"Reasonable\"],\"title\":\"Manski bounds\",\"what_it_assumes\":[{\"explain_key\":\"assumption.exchangeability\",\"explains\":\"Treated and untreated units are comparable once you condition on the confounders you measured. Everything that pushed people towards treatment and also moves the outcome is in your adjustment set.\",\"id\":\"exchangeability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Exchangeability / no unmeasured confounding\",\"worry_when\":\"Treatment was chosen by people who knew something about the likely outcome that you do not observe. Clinical judgement, self-selection into a programme, and administrative triage are the classic cases.\"},{\"explain_key\":\"assumption.positivity\",\"explains\":\"Every kind of unit had some chance of being treated and some chance of not being treated. Where that fails, there is no comparison to make and the model is inventing one.\",\"id\":\"positivity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Positivity / overlap\",\"worry_when\":\"Any single weight carries a large share of the total; the effective sample is far below the nominal one; the propensity model separates the arms almost perfectly; treated units sit outside the control group's range.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"},{\"explain_key\":\"assumption.randomisation\",\"explains\":\"Assignment really was by chance, and nothing after assignment broke the comparison -- no differential dropout, no crossover you have not modelled.\",\"id\":\"randomisation\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Randomisation held\",\"worry_when\":\"Dropout differs across arms; take-up is far from assignment; the randomiser was a person with discretion.\"},{\"explain_key\":\"assumption.relevance\",\"explains\":\"The instrument actually moves treatment, and moves it enough that the resulting estimate is not mostly noise.\",\"id\":\"relevance\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Instrument relevance\",\"worry_when\":\"An effective F below about 10; a first-stage coefficient that is substantively tiny even if statistically significant; many instruments.\"},{\"explain_key\":\"assumption.exclusion\",\"explains\":\"The instrument affects the outcome only through the treatment. On the board, that is the arrow you did not draw.\",\"id\":\"exclusion\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Exclusion restriction\",\"worry_when\":\"The instrument is a policy that changed several things at once; it is correlated with geography, time or institutions that have their own effects; it was chosen because it predicted the outcome.\"},{\"explain_key\":\"assumption.monotonicity\",\"explains\":\"The instrument pushes everyone the same way, or not at all. Nobody takes the treatment only because they were discouraged from it.\",\"id\":\"monotonicity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Monotonicity / no defiers\",\"worry_when\":\"The instrument is an incentive that could plausibly backfire for some people, or it is a judge or examiner whose leniency ordering differs across case types.\"}],\"when_not_to_use\":[\"The bounds are often wide enough to include zero, which is informative and unpopular. Narrowing them means adding assumptions, and those should be stated.\"],\"when_to_use\":[\"The honest floor. When the point estimate rests on assumptions nobody can defend, an interval that rests on almost none is worth more than a number that rests on many.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"bounds.manski\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"bounds.manski\",\"registry\":{\"coming\":\"Not implemented. Designed for: the spec and result schema already allow an interval with no point estimate.\",\"designs\":[\"observational\",\"rct\",\"iv\"],\"diagnostics\":[\"outcome_distribution\"],\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":false,\"r\":null},\"estimands\":[\"ATE\",\"ATT\"],\"id\":\"bounds.manski\",\"one_liner\":\"Report the range the effect must lie in given only what the data can support, without assuming away the missing counterfactual.\",\"probes\":[],\"r_needs\":[],\"reference_dispositions\":[{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:40dcbbb8dd486b8b8d3c\",\"requested_as\":\"Manski (1990), Nonparametric bounds on treatment effects\"}],\"reference_ids\":[\"source:unresolved:40dcbbb8dd486b8b8d3c\"],\"references\":[\"Manski (1990), Nonparametric bounds on treatment effects\"],\"roles_required\":[\"treatment\",\"outcome\"],\"source_path\":\"engines/registry/methods.extra.yaml\",\"source_sha256\":\"2cb349e9f7f7e6f88c10c18d81478656fd420eda7ca977d9767610ac8c7a4be0\",\"status\":\"reasonable\",\"title\":\"Manski bounds\",\"what_can_go_wrong\":\"The bounds are often wide enough to include zero, which is informative and unpopular. Narrowing them means adding assumptions, and those should be stated.\",\"why_recommended\":\"The honest floor. When the point estimate rests on assumptions nobody can defend, an interval that rests on almost none is worth more than a number that rests on many.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:07f6c58fcba0aacd198f9ceb\",\"object_id\":\"concep