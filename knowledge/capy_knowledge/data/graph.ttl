\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:wilson2017\",\"source:ontology:sandve2013\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Citation and original explanation; linked external bodies are not included.\",\"subject_id\":\"claim:audit-reproducibility\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:wilson2017\",\"source:ontology:sandve2013\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped original methodological explanation; no whole-method or study audit is implied.\",\"source_ids\":[\"source:note:audit-reproducibility\",\"source:ontology:wilson2017\",\"source:ontology:sandve2013\"],\"summary\":\"An implementation audit records the authorized revision, code location and observed behavior for each finding, explains the threatened estimand or assumption, and proposes a correction and verification method. Preserve exact data transformations, input hashes, options, randomness and dependency versions. Independent numerical examples, full uncertainty refits and adversarial inputs assess computation. Agreement with a reference calculation or passing software tests does not establish causal identification for the study.\",\"title\":\"Implementation audits require traceable evidence\"}" .
<urn:capy:claim%3Acate-heterogeneity-evaluation> a capy:claim ; skos:prefLabel "CATE projection, calibration and GATES require honest evaluation" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Acate-heterogeneity-evaluation> ; capy:record "{\"aliases\":[\"CATE heterogeneity\",\"BLP\",\"GATES\",\"calibration\",\"causal forest\"],\"assertion_mode\":\"original_editorial_explanation\",\"citation_ids\":[\"source:note:cate-heterogeneity-evaluation\",\"source:ontology:genericml\",\"source:ontology:grf-blp\",\"source:ontology:grf-calibration\"],\"citations\":[],\"conditions\":[\"Learning/evaluation separation, suitable target scores and overlap.\",\"Evidence matches the implemented score and inference, not only the method label.\"],\"counterevidence\":[\"Dispersion of estimated CATEs can reflect estimation noise.\"],\"evidence_ids\":[\"evidence:cate-heterogeneity-evaluation\"],\"gaps\":[\"This scoped methodological note does not validate a particular study or certify the local statistical implementation.\"],\"id\":\"claim:cate-heterogeneity-evaluation\",\"kind\":\"claim\",\"provenance\":[\"source:note:cate-heterogeneity-evaluation\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Learning/evaluation separation, suitable target scores and overlap.\",\"Evidence matches the implemented score and inference, not only the method label.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:0eb3fc7069a72d25fbacb3bd\",\"object_id\":\"ml.dml_irm\",\"predicate\":\"qualifies\",\"provenance\":[\"source:note:cate-heterogeneity-evaluation\",\"source:ontology:genericml\",\"source:ontology:grf-blp\",\"source:ontology:grf-calibration\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution