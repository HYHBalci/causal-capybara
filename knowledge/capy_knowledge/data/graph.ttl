\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"heterogeneity.count\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Consult the method card and exact claim qualifications before treating conceptual coverage as implementation support.\"],\"counterevidence\":[],\"gaps\":[\"No independent human scientific review or study-specific causal identification is established.\"],\"id\":\"relation:f9a2ae35538cf6495ef82572\",\"object_id\":\"concept:reproducibility\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:sandve2013\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Qualified methodological context for this declared method; this link does not assert an implemented test or identifying assumption.\",\"subject_id\":\"heterogeneity.count\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Consult the method card and exact claim qualifications before treating conceptual coverage as implementation support.\"],\"counterevidence\":[],\"gaps\":[\"No independent human scientific review or study-specific causal identification is established.\"],\"id\":\"relation:fdbdf9f58b560889c96b0008\",\"object_id\":\"concept:consistency\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:rubin2008\",\"hernan2020\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Qualified methodological context for this declared method; this link does not assert an implemented test or identifying assumption.\",\"subject_id\":\"heterogeneity.count\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:ffdf2563b0e0a02416860600\",\"object_id\":\"altman2003\",\"predicate\":\"cites\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"heterogeneity.count\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Compare standardized count means or fixed-exposure rates using a Poisson mean model with robust uncertainty.\",\"title\":\"Count and rate outcome heterogeneity\"}" .
<urn:capy:interference.exposure> a capy:method ; skos:prefLabel "Interference and spillovers" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:interference.exposure\"],\"catalogue_key\":\"method:interference.exposure\",\"citation_ids\":[\"source:unresolved:d51a801671055fa29107\",\"source:unresolved:db8ac35f53e482c9876b\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":\"Not implemented. Advanced, and easy to misuse.\",\"engines\":{\"python\":false,\"r\":null},\"needs_r_packages\":[],\"runs_here\":false,\"summary\":\"Not built yet. The card is here so you can see that the method exists and read what it is for.\"},\"designs\":[{\"explain_key\":\"design.rct\",\"id\":\"rct\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"People were assigned by chance, or as good as chance.\",\"title\":\"Randomised or as-if randomised\"},{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"},{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.cluster_structure\",\"id\":\"cluster_structure\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Cluster structure\"}],\"estimands\":[{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"},{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"}],\"explain_key\":\"method.interference.exposure\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"interference.exposure\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":false,\"one_liner\":\"When one unit's treatment affects another's outcome, estimate the direct and spillover effects separately instead of pretending neither exists.\",\"options\":[],\"plain_language\":\"When one unit's treatment affects another's outcome, estimate the direct and spillover effects separately instead of pretending neither exists.\",\"probes\":[{\"explain_key\":\"probe.placebo_outcome\",\"id\":\"probe.placebo_outcome\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the same analysis on something the treatment could not have changed. It should find nothing.\",\"requested_as\":\"probe.placebo_outcome\",\"title\":\"Placebo outcome\"}],\"references\":[\"Hudgens & Halloran (2008)\",\"Aronow & Samii (2017)\"],\"roles_forbidden\":[],\"roles_optional\":[],\"roles_required\":[\"a treatment\",\"an outcome\",\"a clustering variable\"],\"see_also\":[{\"explain_key\":\"design.rct\",\"id\":\"rct\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"People were assigned by chance, or as good as chance.\",\"title\":\"Randomised or as-if randomised\"},{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"},{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"},{\"explain_key\":\"method.bounds.manski\",\"id\":\"bounds.manski\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Report the range the effect must lie in given only what the data can support, without assuming away the missing counterfactual.\",\"title\":\"Manski bounds\"},{\"explain_key\":\"method.did.bjs_imputation\",\"id\":\"did.bjs_imputation\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Learn what untreated life looks like from untreated cells only, then ask how far each treated cell landed from it.\",\"title\":\"Imputation (Borusyak-Jaravel-Spiess)\"},{\"explain_key\":\"method.did.callaway_santanna\",\"id\":\"did.callaway_santanna\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Estimate one clean before-and-after for every adoption cohort, then say out loud how you averaged them.\",\"title\":\"Callaway & Sant'Anna group-time effects\"},{\"explain_key\":\"method.did.chaisemartin\",\"id\":\"did.chaisemartin\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"An estimator built for panels where treatment switches on and off, which the imputation and cohort estimators assume never happens.\",\"title\":\"de Chaisemartin & D'Haultfoeuille\"},{\"explain_key\":\"method.did.dr_did\",\"id\":\"did.dr_did\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"One before-and-after with covariates, using an outcome model and a comparison-group model together so either one can carry it.\",\"title\":\"Doubly robust DiD\"},{\"explain_key\":\"method.did.event_study\",\"id\":\"did.event_study\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Plot the effect period by period around adoption, so you can see whether the gap opened when the policy arrived or long before it.\",\"title\":\"Event study (leads and lags)\"}],\"status\":\"reasonable\",\"status_label\":\"Reasonable\",\"tags\":[\"Randomised or as-if randomised\",\"Adjust for background differences\",\"Policy rolled out over time\",\"ATE\",\"ATT\",\"Reasonable\"],\"title\":\"Interference and spillovers\",\"what_it_assumes\":[{\"explain_key\":\"assumption.randomisation\",\"explains\":\"Assignment really was by chance, and nothing after assignment broke the comparison -- no differential dropout, no crossover you have not modelled.\",\"id\":\"randomisation\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Randomisation held\",\"worry_when\":\"Dropout differs across arms; take-up is far from assignment; the randomiser was a person with discretion.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"},{\"explain_key\":\"assumption.exchangeability\",\"explains\":\"Treated and untreated units are comparable once you condition on the confounders you measured. Everything that pushed people towards treatment and also moves the outcome is in your adjustment set.\",\"id\":\"exchangeability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Exchangeability / no unmeasured confounding\",\"worry_when\":\"Treatment was chosen by people who knew something about the likely outcome that you do not observe. Clinical judgement, self-selection into a programme, and administrative triage are the classic cases.\"},{\"explain_key\":\"assumption.positivity\",\"explains\":\"Every kind of unit had some chance of being treated and some chance of not being treated. Where that fails, there is no comparison to make and the model is inventing one.\",\"id\":\"positivity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Positivity / overlap\",\"worry_when\":\"Any single weight carries a large share of the total; the effective sample is far below the nominal one; the propensity model separates the arms almost perfectly; treated units sit outside the control group's range.\"},{\"explain_key\":\"assumption.parallel_trends\",\"explains\":\"Without the policy, treated and comparison groups would have moved the same way. Not that they were at the same level -- that their paths would have been parallel.\",\"id\":\"parallel_trends\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Parallel trends\",\"worry_when\":\"Pre-period event-study coefficients drift away from zero; the policy was adopted because outcomes were already moving; the groups differ in composition in ways that interact with time.\"},{\"explain_key\":\"assumption.no_anticipation\",\"explains\":\"Units did not change behaviour before treatment arrived because they knew it was coming.\",\"id\":\"no_anticipation\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No anticipation\",\"worry_when\":\"There was a public announcement well before the policy started, or the pre-period coefficients move in the period immediately before adoption.\"}],\"when_not_to_use\":[\"Requires an exposure mapping -- who is exposed to whom -- and that mapping is itself a strong assumption that is easy to get wrong and easy to hide.\"],\"when_to_use\":[\"SUTVA is assumed everywhere in this catalogue and is false in most of the settings policy analysts care about. Partial interference designs at least make the assumption explicit.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"interference.exposure\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"interference.exposure\",\"registry\":{\"coming\":\"Not implemented. Advanced, and easy to misuse.\",\"designs\":[\"rct\",\"observational\",\"did\"],\"diagnostics\":[\"cluster_structure\"],\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":false,\"r\":null},\"estimands\":[\"ATE\",\"ATT\"],\"id\":\"interference.exposure\",\"one_liner\":\"When one unit's treatment affects another's outcome, estimate the direct and spillover effects separately instead of pretending neither exists.\",\"probes\":[\"probe.placebo_outcome\"],\"r_needs\":[],\"reference_dispositions\":[{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:d51a801671055fa29107\",\"requested_as\":\"Hudgens & Halloran (2008)\"},{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:db8ac35f53e482c9876b\",\"requested_as\":\"Aronow & Samii (2017)\"}],\"reference_ids\":[\"source:unresolved:d51a801671055fa29107\",\"source:unresolved:db8ac35f53e482c9876b\"],\"references\":[\"Hudgens & Halloran (2008)\",\"Aronow & Samii (2017)\"],\"roles_required\":[\"treatment\",\"outcome\",\"cluster\"],\"source_path\":\"engines/registry/methods.extra.yaml\",\"source_sha256\":\"2cb349e9f7f7e6f88c10c18d81478656fd420eda7ca977d9767610ac8c7a4be0\",\"status\":\"reasonable\",\"title\":\"Interference and spillovers\",\"what_can_go_wrong\":\"Requires an exposure mapping -- who is exposed to whom -- and that mapping is itself a strong assumption that is easy to get wrong and easy to hide.\",\"why_recommended\":\"SUTVA is assumed everywhere in this catalogue and is false in most of the settings policy analysts care about. Partial interference designs at least make the assumption explicit.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:187f9f042aa81e3aae4711a4\",\"object_id\":\"assumption:parallel_trends\",\"predicate\":\"requires_assumption\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"interference.exposure\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:1b1dffa864a196873f17a0af\",\"object_id\":\"assumption:consistency\",\"predicate\":\"requires_assumption\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"interference.exposure\"},{\"assertion_mode\":\"editorial\",\"condition