<urn:capy:study%3Answ_observational> a capy:study ; skos:prefLabel "The same programme, without the experiment" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"study:nsw_observational\",\"citation_ids\":[],\"citations\":[],\"content\":{\"caveat\":\"Compare what you get here with the experimental benchmark. They will not agree easily.\",\"citation\":\"LaLonde (1986); Dehejia & Wahba (1999).\",\"citation_url\":\"https://doi.org/10.2307/2669919\",\"design\":{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"},\"difficulty\":\"start here\",\"estimand\":{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"},\"explain_key\":null,\"gaps\":[],\"id\":\"nsw_observational\",\"kind\":\"study\",\"one_liner\":\"why overlap comes before the estimate, on the study that made the point\",\"plain_language\":\"The real trainees against 15,992 CPS survey respondents. LaLonde's challenge, on the data he set it with: can any adjustment recover the experimental answer?\",\"provenance\":{\"data_origin\":\"Published study data, fetched from source. Not redistributed by this project.\",\"downloads_from\":[\"https://vincentarelbundock.github.io/Rdatasets/csv/causaldata/nsw_mixtape.csv\",\"https://vincentarelbundock.github.io/Rdatasets/csv/causaldata/cps_mixtape.csv\"],\"licences\":[\"MIT\"],\"rights\":\"MIT via causaldata, Huntington-Klein et al.\",\"source\":\"real\",\"study\":\"National Supported Work Demonstration vs Current Population Survey\",\"truth\":\"This is the study data, not a simulation. There is no built-in answer to check the estimators against -- which is the whole reason to work with it.\"},\"question\":\"The real trainees against 15,992 CPS survey respondents. LaLonde's challenge, on the data he set it with: can any adjustment recover the experimental answer?\",\"rows\":16177,\"see_also\":[{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"},{\"explain_key\":\"method.obs.aipw\",\"id\":\"obs.aipw\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Use a treatment model and an outcome model together; it is right if either one is.\",\"title\":\"Doubly robust (AIPW)\"},{\"explain_key\":\"method.obs.weighting.ipw\",\"id\":\"obs.weighting.ipw\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Reweight the sample so the treated and untreated groups look alike on the measured confounders.\",\"title\":\"Propensity weighting\"},{\"explain_key\":\"method.obs.matching.nn\",\"id\":\"obs.matching.nn\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Pair each treated unit with the most similar untreated unit, then compare within pairs.\",\"title\":\"Nearest-neighbour matching\"},{\"explain_key\":\"method.obs.outcome_regression\",\"id\":\"obs.outcome_regression\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Model the outcome, then ask what would have happened if everyone had been treated, and if nobody had.\",\"title\":\"Outcome regression (g-computation)\"}],\"suggested_methods\":[{\"explain_key\":\"method.obs.aipw\",\"id\":\"obs.aipw\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Use a treatment model and an outcome model together; it is right if either one is.\",\"title\":\"Doubly robust (AIPW)\"},{\"explain_key\":\"method.obs.weighting.ipw\",\"id\":\"obs.weighting.ipw\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Reweight the sample so the treated and u