:\"relation:e87a0856d856b73c22afb808\",\"object_id\":\"concept:metalearners\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"chernozhukov2018\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"ml.metalearner\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:ec22f4e9d4af5f0099ab3ab8\",\"object_id\":\"diagnostic:cate_distribution\",\"predicate\":\"checked_by_diagnostic\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"ml.metalearner\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Consult the method card and exact claim qualifications before treating conceptual coverage as implementation support.\"],\"counterevidence\":[],\"gaps\":[\"No independent human scientific review or study-specific causal identification is established.\"],\"id\":\"relation:f337714bb425947ede4ff23e\",\"object_id\":\"concept:heterogeneity-multiplicity\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:sun2010\",\"source:ontology:genericml\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Qualified methodological context for this declared method; this link does not assert an implemented test or identifying assumption.\",\"subject_id\":\"ml.metalearner\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Build the per-unit effect out of ordinary prediction models, four different ways, on the same cross-fitting.\",\"title\":\"Meta-learner (T, S, X, DR)\"}" .
<urn:capy:ml.policy_tree> a capy:method ; skos:prefLabel "Policy tree (who should be treated)" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:ml.policy_tree\"],\"catalogue_key\":\"method:ml.policy_tree\",\"citation_ids\":[\"10.1287/opre.2022.2271\",\"10.3982/ecta15732\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":null,\"engines\":{\"python\":true,\"r\":\"policytree\"},\"needs_r_packages\":[\"policytree\"],\"runs_here\":true,\"summary\":\"Runs on this computer with what the app already installs.\"},\"designs\":[{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.nuisance_rmse\",\"id\":\"nuisance_rmse\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Nuisance models by fold\"},{\"explain_key\":\"diagnostic.propensity_clipping\",\"id\":\"propensity_clipping\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Propensity clipping\"},{\"explain_key\":\"diagnostic.cate_distribution\",\"id\":\"cate_distribution\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"CATE distribution\"},{\"explain_key\":\"diagnostic.cate_calibration\",\"id\":\"cate_calibration\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"CATE calibration\"},{\"explain_key\":\"diagnostic.rate\",\"id\":\"rate\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Rank-weighted average treatment effect\"},{\"explain_key\":\"diagnostic.fold_stability\",\"id\":\"fold_stability\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Stability across folds\"},{\"explain_key\":\"diagnostic.seed_stability\",\"id\":\"seed_stability\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Stability across seeds\"},{\"explain_key\":\"diagnostic.policy_value\",\"id\":\"policy_value\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Honest policy value\"}],\"estimands\":[{\"acronym\":null,\"explain_key\":null,\"id\":\"policy_value\",\"in_catalogue\":false,\"kind\":\"estimand\",\"one_liner\":null,\"title\":\"Value of the policy the rule would implement\"},{\"acronym\":\"CATE\",\"explain_key\":\"estimand.cate\",\"id\":\"CATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"How does the effect vary from person to person, or place to place?\",\"title\":\"Conditional average treatment effect\"}],\"explain_key\":\"method.ml.policy_tree\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\",\"targets Value of the policy the rule would implement, which the estimand catalogue does not define yet\"],\"id\":\"ml.policy_tree\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":true,\"one_liner\":\"Learn a short, readable rule for who to treat, then value that rule on data it never saw.\",\"options\":[{\"choices\":[\"linear\",\"lasso\",\"forest\",\"gradient_boosting\"],\"default\":\"linear\",\"help\":\"The model used for E[Y|X] and E[D|X]. Boring is usually right: a regularised linear model is hard to beat when the sample is small, and a flexible learner cannot fix a confounder you did not measure.\",\"label\":\"Nuisance learner\",\"name\":\"learner\",\"profile\":\"advanced\",\"type\":\"select\"},{\"default\":5,\"help\":\"Each fold is scored by models that never saw it. More folds use the data better and cost more time; below 5 the estimate starts to depend on the split.\",\"label\":\"Cross-fitting folds\",\"max\":20,\"min\":2,\"name\":\"folds\",\"profile\":\"standard\",\"type\":\"int\"},{\"default\":0.01,\"help\":\"Keeps the weights finite when a unit is nearly certain to be treated. Every clipped unit is reported, because clipping quietly changes the population.\",\"label\":\"Clip propensity scores at\",\"max\":0.45,\"min\":0.0,\"name\":\"clip\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":0.95,\"help\":\"The interval width. Changing it after seeing the result is not a neutral act.\",\"label\":\"Confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":1,\"help\":\"Reruns the whole cross-fitting under fresh random splits. The split is an arbitrary choice; the answer should not depend on it.\",\"label\":\"Repeat under new fold splits\",\"max\":10,\"min\":1,\"name\":\"stability_reps\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":200,\"help\":\"Draws used for the standard error of the targeting curve. 0 skips it.\",\"label\":\"Bootstrap draws for the RATE curve\",\"max\":2000,\"min\":0,\"name\":\"rate_reps\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":[],\"help\":\"Groups you named BEFORE looking. Each one gets the same doubly robust score as the headline, and the multiplicity caution comes with them.\",\"label\":\"Pre-registered subgroups\",\"name\":\"subgroups\",\"profile\":\"standard\",\"type\":\"columns\"},{\"default\":2,\"help\":\"Depth 1 is a single rule. Depth 3 can fit noise in a way you will not see until the policy is deployed.\",\"label\":\"Tree depth\",\"max\":3,\"min\":1,\"name\":\"depth\",\"profile\":\"standard\",\"type\":\"int\"},{\"default\":25,\"help\":\"Stops the tree from carving out a handful of lucky rows.\",\"label\":\"Minimum rows per leaf\",\"max\":5000,\"min\":5,\"name\":\"min_leaf\",\"profile\":\"standard\",\"type\":\"int\"},{\"default\":0.5,\"help\":\"These rows do not help choose the rule, so the value measured on them is not self-graded. Holding back less makes the value less reliable, not more.\",\"label\":\"Share held back to value the policy\",\"max\":0.8,\"min\":0.2,\"name\":\"eval_share\",\"profile\":\"advanced\",\"type\":\"number\"}],\"plain_language\":\"Learn a short, readable rule for who to treat, then value that rule on data it never saw.\",\"probes\":[{\"explain_key\":\"probe.cinelli_hazlett\",\"id\":\"probe.cinelli_hazlett\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"How strong would an unmeasured confounder have to be -- compared with the covariates you already have -- to explain the estimate away?\",\"requested_as\":\"probe.cinelli_hazlett\",\"title\":\"Cinelli-Hazlett sensitivity (partial R2)\"},{\"explain_key\":\"probe.rosenbaum\",\"id\":\"probe.rosenbaum\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"How unequal could the odds of treatment be inside a matched pair before the conclusion stopped being clear?\",\"requested_as\":\"probe.rosenbaum\",\"title\":\"Rosenbaum bounds\"},{\"explain_key\":\"probe.placebo_outcome\",\"id\":\"probe.placebo_outcome\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the same analysis on something the treatment could not have changed. It should find nothing.\",\"requested_as\":\"probe.placebo_outcome\",\"title\":\"Placebo outcome\"},{\"explain_key\":\"probe.subset\",\"id\":\"probe.subset\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Re-estimate on random subsets. The answer should move about as much as losing that much data costs, and no more.\",\"requested_as\":\"probe.subset\",\"title\":\"Subset stability\"},{\"explain_key\":\"probe.random_common_cause\",\"id\":\"probe.random_common_cause\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Add a variable that causes nothing to the adjustment set. The estimate should barely move.\",\"requested_as\":\"probe.random_common_cause\",\"title\":\"Random common cause\"},{\"explain_key\":\"probe.trim_curve\",\"id\":\"probe.trim_curve\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Re-estimate across a grid of propensity-score trimming thresholds instead of picking one and hoping.\",\"requested_as\":\"probe.trim_curve\",\"title\":\"Trimming curve\"}],\"references\":[\"Athey & Wager (2021), Policy learning with observational data\",\"Zhou, Athey & Wager (2023), Offline multi-action policy learning\"],\"roles_forbidden\":[\"forbidden\"],\"roles_optional\":[\"effect_modifiers\",\"a clustering variable\"],\"roles_required\":[\"a treatment\",\"an outcome\",\"at least one measured confounder\"],\"see_also\":[{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"},{\"explain_key\":\"method.heterogeneity.binary\",\"id\":\"heterogeneity.binary\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Logistic interactions plus separate standardized risk-difference, risk-ratio or marginal odds-ratio heterogeneity tests.\",\"title\":\"Binary outcome heterogeneity\"},{\"explain_key\":\"method.heterogeneity.categorical\",\"id\":\"heterogeneity.categorical\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Multinomial treatment interactions and a joint test of category-probability contrasts; preserves categories without assigning numeric scores.\",\"title\":\"Nominal and ordinal outcome heterogeneity\"},{\"explain_key\":\"method.heterogeneity.continuous\",\"id\":\"heterogeneity.continuous\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"OLS treatment-by-baseline-modifier interactions with HC3 or cluster sandwich inference, direct mean-difference tests and Holm pairwise comparisons.\",\"title\":\"Continuous outcome heterogeneity\"},{\"explain_key\":\"method.heterogeneity.count\",\"id\":\"heterogeneity.count\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Poisson conditional-mean interactions with robust sandwich inference; compare standardized count or fixed-exposure rate contrasts.\",\"title\":\"Count and rate outcome heterogeneity\"},{\"explain_key\":\"method.ml.causal_forest\",\"id\":\"ml.causal_forest\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Grow trees that look for units whose effect differs, keeping the rows that chose each split away from the rows that estimate it.\",\"title\":\"Honest causal forest\"},{\"explain_key\":\"method.ml.metalearner\",\"id\":\"ml.metalearner\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Build the per-unit effect out of ordinary prediction models, four different ways, on the same cross-fitting.\",\"title\":\"Meta-learner (T, S, X, DR)\"}],\"status\":\"reasonable\",\"status_label\":\"Reasonable\",\"tags\":[\"Adjust for background differences\",\"Value of the policy the rule would implement\",\"CATE\",\"Reasonable\"],\"title\":\"Policy tree (who should be treated)\",\"what_it_assumes\":[{\"explain_key\":\"assumption.exchangeability\",\"explains\":\"Treated and untreated units are comparable once you condition on the confounders you measured. Everything that pushed people towards treatment and also moves the outcome is in your adjustment set.\",\"id\":\"exchangeability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Exchangeability / no unmeasured confounding\",\"worry_when\":\"Treatment was chosen by people who knew something about the likely outcome that you do not observe. Clinical judgement, self-selection into a programme, and administrative triage are the classic cases.\"},{\"explain_key\":\"assumption.positivity\",\"explains\":\"Every kind of unit had some chance of being treated and some chance of not being treated. Where that fails, there is no comparison to make and the model is inventing one.\",\"id\":\"positivity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Positivity / overlap\",\"worry_when\":\"Any single weight carries a large share of the total; the effective sample is far below the nominal one; the propensity model separates the arms almost perfectly; treated units sit outside the control group's range.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"when_not_to_use\":[\"The in-sample value of a learned policy is optimistic, always, and the gap can be large. The search here is greedy rather than exhaustive, so the tree is a good rule, not the best one. A policy that does not beat treating everyone is usually not worth the administrative cost of targeting. Machine learning does not identify anything. Cross-fitting removes the bias that comes from fitting flexible models on the same rows you estimate with; it does nothing about a confounder you never measured.\",\"The calibration diagnostic says the per-unit effects carry no signal: then there is nothing to target on and the tree is decoration.\"],\"when_to_use\":[\"A rule you can print on one page and hand to the people who run the programme, with a value measured on rows that did not choose it.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\",\"targets Value of the policy the rule would implement, which the estimand catalogue does not define yet\"],\"id\":\"ml.policy_tree\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"ml.policy_tree\",\"registry\":{\"designs\":[\"observational\"],\"diagnostics\":[\"nuisance_rmse\",\"propensity_clipping\",\"cate_distribution\",\"cate_calibration\",\"rate\",\"fold_stability\",\"seed_stability\",\"policy_value\"],\"disrecommend_when\":\"The calibration diagnostic says the per-unit effects carry no signal: then there is nothing to target on and the tree is decoration.\",\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":true,\"r\":\"policytree\"},\"estimands\":[\"policy_value\",\"CATE\"],\"explain_key\":\"method.ml.policy_tree\",\"id\":\"ml.policy_tree\",\"needs\":[\"numpy\",\"scipy\",\"pandas\",\"scikit-learn\"],\"needs_overlap\":true,\"one_liner\":\"Learn a short, readable rule for who to treat, then value that rule on data it never saw.\",\"options\":[{\"choices\":[\"linear\",\"lasso\",\"forest\",\"gradient_boosting\"],\"default\":\"linear\",\"help\":\"The model used for E[Y|X] and E[D|X]. Boring is usually right: a regularised linear model is hard to beat when the sample is small, and a flexible learner cannot fix a confounder you did not measure.\",\"label\":\"Nuisance learner\",\"name\":\"learner\",\"profile\":\"advanced\",\"type\":\"select\"},{\"default\":5,\"help\":\"Each fold is scored by models that never saw it. More folds use the data better and cost more time; below 5 the estimate starts to depend on the split.\",\"label\":\"Cross-fitting folds\",\"max\":20,\"min\":2,\"name\":\"folds\",\"profile\":\"standard\",\"type\":\"int\"},{\"default\":0.01,\"help\":\"Keeps the weights finite when a unit is nearly certain to be treated. Every clipped unit is reported, because clipping quietly changes the population.\",\"label\":\"Clip propensity scores at\",\"max\":0.45,\"min\":0.0,\"name\":\"clip\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":0.95,\"help\":\"The interval width. Changing it after seeing the result is not a neutral act.\",\"label\":\"Confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":1,\"help\":\"Reruns the whole cross-fitting under fresh random splits. The split is an arbitrary choice; the answer should not depend on it.\",\"label\":\"Repeat under new fold splits\",\"max\":10,\"min\":1,\"name\":\"stability_reps\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":200,\"help\":\"Draws used for the standard error of the targeting curve. 0 skips it.\",\"label\":\"Bootstrap draws for the RATE curve\",\"max\":2000,\"min\":0,\"name\":\"rate_reps\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":[],\"help\":\"Groups you named BEFORE looking. Each one gets the same doubly robust score as the headline, and the multiplicity caution comes with them.\",\"label\":\"Pre-registered subgroups\",\"name\":\"subgroups\",\"profile\":\"standard\",\"type\":\"columns\"},{\"default\":2,\"help\":\"Depth 1 is a single rule. Depth 3 can fit noise in a way you will not see until the policy is deployed.\",\"label\":\"Tree depth\",\"max\":3,\"min\":1,\"name\":\"depth\",\"profile\":\"standard\",\"type\":\"int\"},{\"default\":25,\"help\":\"Stops the tree from carving out a handful of lucky rows.\",\"label\":\"Minimum rows per leaf\",\"max\":5000,\"min\":5,\"name\":\"min_leaf\",\"profile\":\"standard\",\"type\":\"int\"},{\"default\":0.5,\"help\":\"These rows do not help choose the rule, so the value measured on them is not self-graded. Holding back less makes the value less reliable, not more.\",\"label\":\"Share held back to value the policy\",\"max\":0.8,\"min\":0.2,\"name\":\"eval_share\",\"profile\":\"advanced\",\"type\":\"number\"}],\"probes\":[\"probe.cinelli_hazlett\",\"probe.rosenbaum\",\"probe.placebo_outcome\",\"probe.subset\",\"probe.random_common_cause\",\"probe.trim_curve\"],\"reference_dispositions\":[{\"disposition\":\"resolved_metadata\",\"id\":\"10.3982/ecta15732\",\"requested_as\":\"Athey & Wager (2021), Policy learning with observational data\"},{\"disposition\":\"resolved_metadata\",\"id\":\"10.1287/opre.2022.2271\",\"requested_as\":\"Zhou, Athey & Wager (2023), Offline multi-action policy learning\"}],\"reference_ids\":[\"10.3982/ecta15732\",\"10.1287/opre.2022.2271\"],\"references\":[\"Athey & Wager (2021), Policy learning with observational data\",\"Zhou, Athey & Wager (2023), Offline multi-action policy learning\"],\"roles_forbidden\":[\"forbidden\"],\"roles_optional\":[\"effect_modifiers\",\"cluster\"],\"roles_required\":[\"treatment\",\"outcome\",\"confounders\"],\"source_path\":\"engines/python/capy_py/causalml.py\",\"source_sha256\":\"1c60218ff563078a18a811cc23ca51cddaad89bb27de76b552224a35be8473ca\",\"status\":\"reasonable\",\"title\":\"Policy tree (who should be treated)\",\"what_can_go_wrong\":\"The in-sample value of a learned policy is optimistic, always, and the gap can be large. The search here is greedy rather than exhaustive, so the tree is a good rule, not the best one. A policy that does not beat treating everyone is usually not worth the administrative cost of targeting. Machine learning does not identify anything. Cross-fitting removes the bias that comes from fitting flexible models on the same rows you estimate with; it does nothing about a confounder you never measured.\",\"why_recommended\":\"A rule you can print on one page and hand to the people who run the programme, with a value measured on rows that did not choose it.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:0115d0840c7acb3f1a9148b4\",\"object_id\":\"concept:causal-estimands\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:ich2019\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"ml.policy_tree\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:0ac731810e94c816664dc310\",\"object_id\":\"diagnostic:rate\",\"predicate\":\"checked_by_diagnostic\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"ml.policy_tree\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation