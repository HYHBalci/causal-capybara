<urn:capy:study%3Answ_experimental> a capy:study ; skos:prefLabel "A randomised job-training experiment" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"study:nsw_experimental\",\"citation_ids\":[],\"citations\":[],\"content\":{\"caveat\":\"\",\"citation\":\"LaLonde (1986); Dehejia & Wahba (1999).\",\"citation_url\":\"https://doi.org/10.2307/1806062\",\"design\":{\"explain_key\":\"design.rct\",\"id\":\"rct\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"People were assigned by chance, or as good as chance.\",\"title\":\"Randomised or as-if randomised\"},\"difficulty\":\"start here\",\"estimand\":{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"},\"explain_key\":null,\"gaps\":[],\"id\":\"nsw_experimental\",\"kind\":\"study\",\"one_liner\":\"what a randomised benchmark looks like before anyone adjusts anything\",\"plain_language\":\"The National Supported Work demonstration, as it was actually run: trainees and controls assigned by lottery. The benchmark the observational version is judged against.\",\"provenance\":{\"data_origin\":\"Published study data, fetched from source. Not redistributed by this project.\",\"downloads_from\":[\"https://vincentarelbundock.github.io/Rdatasets/csv/causaldata/nsw_mixtape.csv\"],\"licences\":[\"MIT\"],\"rights\":\"MIT via causaldata, Huntington-Klein et al.\",\"source\":\"real\",\"study\":\"National Supported Work Demonstration\",\"truth\":\"This is the study data, not a simulation. There is no built-in answer to check the estimators against -- which is the whole reason to work with it.\"},\"question\":\"The National Supported Work demonstration, as it was actually run: trainees and controls assigned by lottery. The benchmark the observational version is judged against.\",\"rows\":445,\"see_also\":[{\"explain_key\":\"design.rct\",\"id\":\"rct\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"People were assigned by chance, or as good as chance.\",\"title\":\"Randomised or as-if randomised\"},{\"explain_key\":\"method.rct.diff_means\",\"id\":\"rct.diff_means\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Compare the two arms as they were randomised, and let covariates sharpen the comparison without letting them change the question.\",\"title\":\"Difference in means\"},{\"explain_key\":\"method.obs.outcome_regression\",\"id\":\"obs.outcome_regression\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Model the outcome, then ask what would have happened if everyone had been treated, and if nobody had.\",\"title\":\"Outcome regression (g-computation)\"}],\"suggested_methods\":[{\"explain_key\":\"method.rct.diff_means\",\"id\":\"rct.diff_means\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Compare the two arms as they were randomised, and let covariates sharpen the comparison without letting them change the question.\",\"title\":\"Difference in means\"},{\"explain_key\":\"method.obs.outcome_regression\",\"id\":\"obs.outcome_regression\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Model the outcome, then ask what would have happened if everyone had been treated, and if nobody had.\",\"title\":\"Outcome regression (g-computation)\"}],\"tags\":[\"Randomised or as-if randomised\",\"start here\"],\"teaches\":\"what a randomised benchmark looks like before anyone adjusts anything\",\"title\":\"A randomised job-training experiment\",\"tour\":[]},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"study:nsw_experimental\",\"kind\":\"study\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"nsw_experimental\",\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:0afa0ac9bd0da0fc01a2d0fc\",\"object_id\":\"rct.diff_means\