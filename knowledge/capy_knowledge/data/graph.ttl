<urn:capy:iv.2sls> a capy:method ; skos:prefLabel "Two-stage least squares" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:iv.2sls\"],\"catalogue_key\":\"method:iv.2sls\",\"citation_ids\":[\"10.2307/2951620\",\"angrist1996\",\"source:unresolved:a5e4013eacc5d703e666\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":null,\"engines\":{\"python\":true,\"r\":\"ivreg\"},\"needs_r_packages\":[\"ivreg\"],\"runs_here\":true,\"summary\":\"Runs on this computer with what the app already installs.\"},\"designs\":[{\"explain_key\":\"design.iv\",\"id\":\"iv\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"An instrument or encouragement changed treatment, not the outcome directly.\",\"title\":\"Something else pushed people in\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.first_stage\",\"id\":\"first_stage\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"First stage\"},{\"explain_key\":\"diagnostic.reduced_form\",\"id\":\"reduced_form\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Reduced form\"},{\"explain_key\":\"diagnostic.overid\",\"id\":\"overid\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Overidentification test\"},{\"explain_key\":\"diagnostic.weak_iv_set\",\"id\":\"weak_iv_set\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Weak-instrument-robust set\"},{\"explain_key\":\"diagnostic.endogeneity\",\"id\":\"endogeneity\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Endogeneity test\"},{\"explain_key\":\"diagnostic.compliers\",\"id\":\"compliers\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Complier share\"},{\"explain_key\":\"diagnostic.placebo_reduced_form\",\"id\":\"placebo_reduced_form\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Placebo reduced form\"}],\"estimands\":[{\"acronym\":\"LATE\",\"explain_key\":\"estimand.late\",\"id\":\"LATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who only got it because of the instrument or the cutoff, what did it do?\",\"title\":\"Local average treatment effect\"},{\"acronym\":\"CACE\",\"explain_key\":\"estimand.cace\",\"id\":\"CACE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For the people who comply with what they were offered, what did it do?\",\"title\":\"Complier average causal effect\"},{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"}],\"explain_key\":\"method.iv.2sls\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\",\"some of the robustness probes it names have no card of their own yet\"],\"id\":\"iv.2sls\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":false,\"one_liner\":\"Use only the part of the treatment that the instrument moved, and see what happened to the outcome.\",\"options\":[{\"choices\":[\"auto\",\"robust\",\"classical\",\"cluster\"],\"default\":\"auto\",\"help\":\"'auto' uses cluster-robust standard errors when a clustering unit is set, and heteroskedasticity-robust ones otherwise.\",\"label\":\"Standard errors\",\"name\":\"se_type\",\"profile\":\"standard\",\"type\":\"select\"},{\"default\":false,\"help\":\"Relabels the estimate an average treatment effect. This is an assertion about the world, not a setting: without it the number is a LATE for the units the instrument moved.\",\"label\":\"Assert one effect for everyone\",\"name\":\"assume_homogeneous_effects\",\"profile\":\"standard\",\"type\":\"bool\"},{\"default\":0.95,\"help\":\"Applies to the Wald interval and to the robust set alike.\",\"label\":\"Confidence level\",\"max\":0.9999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":[],\"help\":\"Each one gets a placebo reduced form. It can catch the exclusion restriction failing; nothing can confirm it.\",\"label\":\"Outcomes the instrument should not move\",\"name\":\"placebo_outcomes\",\"profile\":\"advanced\",\"type\":\"columns\"},{\"default\":[],\"help\":\"Every extra endogenous variable needs its own excluded instrument.\",\"label\":\"Further endogenous variables\",\"name\":\"extra_endogenous\",\"profile\":\"advanced\",\"type\":\"columns\"},{\"default\":201,\"help\":\"The Anderson-Rubin set is found by inverting the test on this grid, then refining the edges by bisection.\",\"label\":\"Grid points for the robust set\",\"max\":2001,\"min\":51,\"name\":\"grid_points\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":8.0,\"help\":\"Widened automatically when the set has not closed by the edge.\",\"label\":\"Grid half-width (in standard errors)\",\"max\":500.0,\"min\":1.0,\"name\":\"grid_span\",\"profile\":\"advanced\",\"type\":\"number\"}],\"plain_language\":\"Use only the part of the treatment that the instrument moved, and see what happened to the outcome.\",\"probes\":[{\"explain_key\":\"probe.placebo_outcome\",\"id\":\"probe.placebo_outcome\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the same analysis on something the treatment could not have changed. It should find nothing.\",\"requested_as\":\"probe.placebo_outcome\",\"title\":\"Placebo outcome\"},{\"explain_key\":\"probe.subset\",\"id\":\"probe.subset\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Re-estimate on random subsets. The answer should move about as much as losing that much data costs, and no more.\",\"requested_as\":\"probe.subset\",\"title\":\"Subset stability\"},{\"explain_key\":\"probe.alternate_spec\",\"id\":\"probe.alternate_spec\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the grid of defensible specifications and sort the answers. The curve is the result, not the one you happened to run.\",\"requested_as\":\"probe.alternate_spec\",\"title\":\"Specification curve\"},{\"explain_key\":\"probe.random_common_cause\",\"id\":\"probe.random_common_cause\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Add a variable that causes nothing to the adjustment set. The estimate should barely move.\",\"requested_as\":\"probe.random_common_cause\",\"title\":\"Random common cause\"},{\"explain_key\":null,\"id\":\"probe.leave_one_instrument_out\",\"in_catalogue\":false,\"kind\":\"probe\",\"one_liner\":null,\"requested_as\":\"probe.leave_one_instrument_out\",\"title\":\"Leave one instrument out\"}],\"references\":[\"Imbens & Angrist (1994), Identification and estimation of local average treatment effects\",\"Angrist, Imbens & Rubin (1996), Identification of causal effects using instrumental variables\",\"Angrist & Pischke (2009), Mostly Harmless Econometrics, ch. 4\"],\"roles_forbidden\":[\"forbidden\"],\"roles_optional\":[\"at least one measured confounder\",\"a clustering variable\",\"weight\"],\"roles_required\":[\"a treatment\",\"an outcome\",\"an instrument\"],\"see_also\":[{\"explain_key\":\"design.iv\",\"id\":\"iv\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"An instrument or encouragement changed treatment, not the outcome directly.\",\"title\":\"Something else pushed people in\"},{\"explain_key\":\"method.bounds.manski\",\"id\":\"bounds.manski\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Report the range the effect must lie in given only what the data can support, without assuming away the missing counterfactual.\",\"title\":\"Manski bounds\"},{\"explain_key\":\"method.iv.gmm\",\"id\":\"iv.gmm\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Weight the instruments by how informative each one actually is, using a weight matrix estimated from the data.\",\"title\":\"Two-step GMM\"},{\"explain_key\":\"method.iv.liml\",\"id\":\"iv.liml\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"The maximum-likelihood cousin of two-stage least squares, which stays much better behaved when the instruments are weak.\",\"title\":\"LIML (and Fuller)\"},{\"explain_key\":\"method.iv.mte\",\"id\":\"iv.mte\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Trace the effect as a function of how reluctant a unit is to be treated, instead of reporting one local average.\",\"title\":\"Marginal treatment effects\"},{\"explain_key\":\"method.iv.shift_share\",\"id\":\"iv.shift_share\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Combine national shocks with local exposure shares to build an instrument for local changes.\",\"title\":\"Shift-share (Bartik) instruments\"},{\"explain_key\":\"method.iv.weak_robust\",\"id\":\"iv.weak_robust\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Report the set of effects the data cannot reject, which stays honest however weak the instrument is.\",\"title\":\"Weak-instrument-robust confidence set\"}],\"status\":\"recommended\",\"status_label\":\"Recommended\",\"tags\":[\"Something else pushed people in\",\"LATE\",\"CACE\",\"ATE\",\"Recommended\"],\"title\":\"Two-stage least squares\",\"what_it_assumes\":[{\"explain_key\":\"assumption.relevance\",\"explains\":\"The instrument actually moves treatment, and moves it enough that the resulting estimate is not mostly noise.\",\"id\":\"relevance\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Instrument relevance\",\"worry_when\":\"An effective F below about 10; a first-stage coefficient that is substantively tiny even if statistically significant; many instruments.\"},{\"explain_key\":\"assumption.exclusion\",\"explains\":\"The instrument affects the outcome only through the treatment. On the board, that is the arrow you did not draw.\",\"id\":\"exclusion\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Exclusion restriction\",\"worry_when\":\"The instrument is a policy that changed several things at once; it is correlated with geography, time or institutions that have their own effects; it was chosen because it predicted the outcome.\"},{\"explain_key\":\"assumption.monotonicity\",\"explains\":\"The instrument pushes everyone the same way, or not at all. Nobody takes the treatment only because they were discouraged from it.\",\"id\":\"monotonicity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Monotonicity / no defiers\",\"worry_when\":\"The instrument is an incentive that could plausibly backfire for some people, or it is a judge or examiner whose leniency ordering differs across case types.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"when_not_to_use\":[\"Exclusion is untestable and usually the weakest link: if the instrument reaches the outcome by any other route, the bias is the violation divided by the first stage, which is enormous when the instrument is weak. Two-stage least squares is also the estimator that degrades worst under weak instruments: it is biased towards ordinary least squares and its interval is too short.\",\"The Olea-Pflueger effective first-stage F is below about 10; report the Anderson-Rubin set instead.\"],\"when_to_use\":[\"The standard instrumental-variables estimator, and the one every referee reads without translation. With a strong first stage it is efficient and its interval is honest.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\",\"some of the robustness probes it names have no card of their own yet\"],\"id\":\"iv.2sls\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"iv.2sls\",\"registry\":{\"designs\":[\"iv\"],\"diagnostics\":[\"first_stage\",\"reduced_form\",\"overid\",\"weak_iv_set\",\"endogeneity\",\"compliers\",\"placebo_reduced_form\"],\"disrecommend_when\":\"The Olea-Pflueger effective first-stage F is below about 10; report the Anderson-Rubin set instead.\",\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":true,\"r\":\"ivreg\"},\"estimands\":[\"LATE\",\"CACE\",\"ATE\"],\"explain_key\":\"method.iv.2sls\",\"id\":\"iv.2sls\",\"needs\":[\"numpy\",\"scipy\",\"pandas\",\"linearmodels\"],\"needs_overlap\":false,\"one_liner\":\"Use only the part of the treatment that the instrument moved, and see what happened to the outcome.\",\"options\":[{\"choices\":[\"auto\",\"robust\",\"classical\",\"cluster\"],\"default\":\"auto\",\"help\":\"'auto' uses cluster-robust standard errors when a clustering unit is set, and heteroskedasticity-robust ones otherwise.\",\"label\":\"Standard errors\",\"name\":\"se_type\",\"profile\":\"standard\",\"type\":\"select\"},{\"default\":false,\"help\":\"Relabels the estimate an average treatment effect. This is an assertion about the world, not a setting: without it the number is a LATE for the units the instrument moved.\",\"label\":\"Assert one effect for everyone\",\"name\":\"assume_homogeneous_effects\",\"profile\":\"standard\",\"type\":\"bool\"},{\"default\":0.95,\"help\":\"Applies to the Wald interval and to the robust set alike.\",\"label\":\"Confidence level\",\"max\":0.9999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":[],\"help\":\"Each one gets a placebo reduced form. It can catch the exclusion restriction failing; nothing can confirm it.\",\"label\":\"Outcomes the instrument should not move\",\"name\":\"placebo_outcomes\",\"profile\":\"advanced\",\"type\":\"columns\"},{\"default\":[],\"help\":\"Every extra endogenous variable needs its own excluded instrument.\",\"label\":\"Further endogenous variables\",\"name\":\"extra_endogenous\",\"profile\":\"advanced\",\"type\":\"columns\"},{\"default\":201,\"help\":\"The Anderson-Rubin set is found by inverting the test on this grid, then refining the edges by bisection.\",\"label\":\"Grid points for the robust set\",\"max\":2001,\"min\":51,\"name\":\"grid_points\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":8.0,\"help\":\"Widened automatically when the set has not closed by the edge.\",\"label\":\"Grid half-width (in standard errors)\",\"max\":500.0,\"min\":1.0,\"name\":\"grid_span\",\"profile\":\"advanced\",\"type\":\"number\"}],\"probes\":[\"probe.placebo_outcome\",\"probe.subset\",\"probe.alternate_spec\",\"probe.random_common_cause\",\"probe.leave_one_instrument_out\"],\"reference_dispositions\":[{\"disposition\":\"resolved_metadata\",\"id\":\"10.2307/2951620\",\"requested_as\":\"Imbens & Angrist (1994), Identification and estimation of local average treatment effects\"},{\"disposition\":\"resolved_metadata\",\"id\":\"angrist1996\",\"requested_as\":\"Angrist, Imbens & Rubin (1996), Identification of causal effects using instrumental variables\"},{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:a5e4013eacc5d703e666\",\"requested_as\":\"Angrist & Pischke (2009), Mostly Harmless Econometrics, ch. 4\"}],\"reference_ids\":[\"10.2307/2951620\",\"angrist1996\",\"source:unresolved:a5e4013eacc5d703e666\"],\"references\":[\"Imbens & Angrist (1994), Identification and estimation of local average treatment effects\",\"Angrist, Imbens & Rubin (1996), Identification of causal effects using instrumental variables\",\"Angrist & Pischke (2009), Mostly Harmless Econometrics, ch. 4\"],\"roles_forbidden\":[\"forbidden\"],\"roles_optional\":[\"confounders\",\"cluster\",\"weight\"],\"roles_required\":[\"treatment\",\"outcome\",\"instruments\"],\"source_path\":\"engines/python/capy_py/iv.py\",\"source_sha256\":\"ab0a0614687ffe9aa5d99f36252cc388ee4436f7f45bc43e98bbed8df9e4bb64\",\"status\":\"recommended\",\"title\":\"Two-stage least squares\",\"what_can_go_wrong\":\"Exclusion is untestable and usually the weakest link: if the instrument reaches the outcome by any other route, the bias is the violation divided by the first stage, which is enormous when the instrument is weak. Two-stage least squares is also the estimator that degrades worst under weak instruments: it is biased towards ordinary least squares and its interval is too short.\",\"why_recommended\":\"The standard instrumental-variables estimator, and the one every referee reads without translation. With a strong first stage it is efficient and its interval is honest.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:04faaafae5bb72138a0dbf17\",\"object_id\":\"softwarepackage:capy-python\",\"predicate\":\"implemented_by\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\