nt_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Run the same estimator on variables the programme cannot have changed; they should not step at the threshold.\",\"title\":\"Do the covariates jump at the cutoff too?\"}" .
<urn:capy:rd.density_test> a capy:method ; skos:prefLabel "Did people sort across the cutoff?" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:rd.density_test\"],\"catalogue_key\":\"method:rd.density_test\",\"citation_ids\":[\"10.1016/j.jeconom.2007.05.005\",\"10.1080/01621459.2019.1635480\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":null,\"engines\":{\"python\":true,\"r\":\"rddensity\"},\"needs_r_packages\":[\"rddensity\"],\"runs_here\":true,\"summary\":\"Runs on this computer with what the app already installs.\"},\"designs\":[{\"explain_key\":\"design.rd\",\"id\":\"rd\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Crossing a score, age, or border switched the programme on.\",\"title\":\"A cutoff decided eligibility\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.manipulation\",\"id\":\"manipulation\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Density at the cutoff\"},{\"explain_key\":\"diagnostic.rd_plot\",\"id\":\"rd_plot\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Binned scatter at the cutoff\"},{\"explain_key\":\"diagnostic.running_variable_discreteness\",\"id\":\"running_variable_discreteness\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Discreteness of the running variable\"},{\"explain_key\":\"diagnostic.bandwidth_sensitivity\",\"id\":\"bandwidth_sensitivity\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Bandwidth sensitivity path\"}],\"estimands\":[],\"explain_key\":\"method.rd.density_test\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\",\"does not say which effect it estimates\"],\"id\":\"rd.density_test\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":false,\"one_liner\":\"Compare how many units sit just below the threshold with how many sit just above.\",\"options\":[{\"default\":null,\"help\":\"The window the local linear density fit uses either side of the cutoff.\",\"label\":\"Density bandwidth (leave empty to choose one)\",\"min\":0.0,\"name\":\"density_bandwidth\",\"profile\":\"standard\",\"type\":\"number\"},{\"default\":0.0,\"help\":\"Drop units within this distance of the cutoff, where heaping and manipulation live. Every dropped row appears in the sample flow.\",\"label\":\"Donut hole radius\",\"min\":0.0,\"name\":\"donut\",\"profile\":\"standard\",\"type\":\"number\"},{\"default\":0.95,\"help\":\"0.95 unless you have a reason.\",\"label\":\"Confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":0,\"help\":\"0 picks about 2 n^(1/3) bins a side.\",\"label\":\"Bins per side in the plot\",\"max\":100,\"min\":0,\"name\":\"plot_bins\",\"profile\":\"advanced\",\"type\":\"int\"},{\"choices\":[\"quantile\",\"evenly\"],\"default\":\"quantile\",\"help\":\"Quantile bins hold the same number of units each; even bins hold the same width each.\",\"label\":\"Bin spacing\",\"name\":\"plot_bin_spacing\",\"profile\":\"advanced\",\"type\":\"select\"}],\"plain_language\":\"Compare how many units sit just below the threshold with how many sit just above.\",\"probes\":[{\"explain_key\":\"probe.subset\",\"id\":\"probe.subset\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Re-estimate on random subsets. The answer should move about as much as losing that much data costs, and no more.\",\"requested_as\":\"probe.subset\",\"title\":\"Subset stability\"}],\"references\":[\"McCrary (2008), Manipulation of the running variable in the regression discontinuity design: a density test\",\"Cattaneo, Jansson & Ma (2020), Simple local polynomial density estimators\"],\"roles_forbidden\":[\"an instrument\",\"forbidden\"],\"roles_optional\":[\"a clustering variable\",\"a treatment\",\"at least one measured confounder\"],\"roles_required\":[\"a running variable\",\"a cutoff\",\"an outcome\"],\"see_also\":[{\"explain_key\":\"design.rd\",\"id\":\"rd\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Crossing a score, age, or border switched the programme on.\",\"title\":\"A cutoff decided eligibility\"}],\"status\":\"recommended\",\"status_label\":\"Recommended\",\"tags\":[\"A cutoff decided eligibility\",\"Recommended\"],\"title\":\"Did people sort across the cutoff?\",\"what_it_assumes\":[{\"explain_key\":\"assumption.no_manipulation\",\"explains\":\"People could not precisely control which side of the cutoff they landed on.\",\"id\":\"no_manipulation\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No manipulation of the running variable\",\"worry_when\":\"A visible spike or gap in the density at the cutoff; covariates that jump; a cutoff that people knew about and had time to respond to.\"},{\"explain_key\":\"assumption.continuity\",\"explains\":\"Everything else that affects the outcome changes smoothly through the cutoff, so the only thing that jumps is the treatment.\",\"id\":\"continuity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Continuity of potential outcomes at the cutoff\",\"worry_when\":\"Several rules share the threshold; the running variable is coarse, so \\\"at the cutoff\\\" is really a wide band; the estimate depends heavily on the bandwidth.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"when_not_to_use\":[\"A clean density does not prove nobody manipulated anything -- sorting that leaves the totals alone is invisible here. A dirty density can also come from harmless heaping on round numbers, so look at the histogram before concluding anything.\",\"The running variable is coarse enough that fewer than about three histogram bins fall inside the bandwidth\"],\"when_to_use\":[\"It is the one check that speaks to the assumption RD lives on: that units could not choose which side of the cutoff to land on. Run it before you believe any RD number.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\",\"does not say which effect it estimates\"],\"id\":\"rd.density_test\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"rd.density_test\",\"registry\":{\"designs\":[\"rd\"],\"diagnostics\":[\"manipulation\",\"rd_plot\",\"running_variable_discreteness\",\"bandwidth_sensitivity\"],\"disrecommend_when\":\"The running variable is coarse enough that fewer than about three histogram bins fall inside the bandwidth\",\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":true,\"r\":\"rddensity\"},\"estimands\":[],\"explain_key\":\"method.rd.density_test\",\"id\":\"rd.density_test\",\"needs\":[\"numpy\",\"scipy\",\"pandas\"],\"needs_overlap\":false,\"one_liner\":\"Compare how many units sit just below the threshold with how many sit just above.\",\"options\":[{\"default\":null,\"help\":\"The window the local linear density fit uses either side of the cutoff.\",\"label\":\"Density bandwidth (leave empty to choose one)\",\"min\":0.0,\"name\":\"density_bandwidth\",\"profile\":\"standard\",\"type\":\"number\"},{\"default\":0.0,\"help\":\"Drop units within this distance of the cutoff, where heaping and manipulation live. Every dropped row appears in the sample flow.\",\"label\":\"Donut hole radius\",\"min\":0.0,\"name\":\"donut\",\"profile\":\"standard\",\"type\":\"number\"},{\"default\":0.95,\"help\":\"0.95 unless you have a reason.\",\"label\":\"Confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":0,\"help\":\"0 picks about 2 n^(1/3) bins a side.\",\"label\":\"Bins per side in the plot\",\"max\":100,\"min\":0,\"name\":\"plot_bins\",\"profile\":\"advanced\",\"type\":\"int\"},{\"choices\":[\"quantile\",\"evenly\"],\"default\":\"quantile\",\"help\":\"Quantile bins hold the same number of units each; even bins hold the same width each.\",\"label\":\"Bin spacing\",\"name\":\"plot_bin_spacing\",\"profile\":\"advanced\",\"type\":\"select\"}],\"probes\":[\"probe.subset\"],\"reference_dispositions\":[{\"disposition\":\"resolved_metadata\",\"id\":\"10.1016/j.jeconom.2007.05.005\",\"requested_as\":\"McCrary (2008), Manipulation of the running variable in the regression discontinuity design: a density test\"},{\"disposition\":\"resolved_metadata\",\"id\":\"10.1080/01621459.2019.1635480\",\"requested_as\":\"Cattaneo, Jansson & Ma (2020), Simple local polynomial density estimators\"}],\"reference_ids\":[\"10.1016/j.jeconom.2007.05.005\",\"10.1080/01621459.2019.1635480\"],\"references\":[\"McCrary (2008), Manipulation of the running variable in the regression discontinuity design: a density test\",\"Cattaneo, Jansson & Ma (2020), Simple local polynomial density estimators\"],\"roles_forbidden\":[\"instruments\",\"forbidden\"],\"roles_optional\":[\"cluster\",\"treatment\",\"confounders\"],\"roles_required\":[\"running\",\"cutoff\",\"outcome\"],\"source_path\":\"engines/python/capy_py/rd.py\",\"source_sha256\":\"a86f14c44b23637b2b7378f638cdbfba5ad3bdcb0ed99ee9af783e9f071548bf\",\"status\":\"recommended\",\"title\":\"Did people sort across the cutoff?\",\"what_can_go_wrong\":\"A clean density does not prove nobody manipulated anything -- sorting that leaves the totals alone is invisible here. A dirty density can also come from harmless heaping on round numbers, so look at the histogram before concluding anything.\",\"why_recommended\":\"It is the one check that speaks to the assumption RD lives on: that units could not choose which side of the cutoff to land on. Run it before you believe any RD number.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:04104cfa7aa59b6dda0e839c\",\"object_id\":\"design:rd\",\"predicate\":\"compatible_with_design\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"rd.density_test\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:0551e860315d89466d5509e3\",\"object_id\":\"10.1080/01621459.2019.1635480\",\"predicate\":\"cites\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10