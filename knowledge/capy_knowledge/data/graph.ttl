review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"subject_id\":\"claim:did-aggregation\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/did_modern.py\",\"tests/python/test_did_modern.py\",\"https://arxiv.org/html/1803.09015v4\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"source_ids\":[\"source:note:did\",\"callaway2021\"],\"summary\":\"Event-time DiD curves may combine different cohorts at different exposure durations; aggregation weights and a fixed cohort window make the target explicit.\",\"title\":\"DiD aggregation weights and event-time composition\"}" .
<urn:capy:claim%3Adid-composition> a capy:claim ; skos:prefLabel "DiD attrition and changing panel composition" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Adid> ; capy:record "{\"aliases\":[\"panel attrition\",\"changing panel composition\",\"units enter leave\",\"missing outcomes\"],\"assertion_mode\":\"original_editorial_explanation\",\"citation_ids\":[\"callaway2021\",\"source:note:did\"],\"citations\":[],\"conditions\":[\"Target units and missing-data scope are declared.\",\"Changes in the units contributing to each comparison are inspected.\"],\"counterevidence\":[\"A balanced observed panel can still be selectively observed.\",\"A complete-pair sample can differ from the intended target population.\"],\"evidence_ids\":[\"evidence:did-composition\"],\"gaps\":[\"The missing-data mechanism remains a study-level assumption.\",\"The attrition explanation is an original reading of public engine behavior, not a claim of a general missingness theorem in the referenced paper.\"],\"id\":\"claim:did-composition\",\"kind\":\"claim\",\"provenance\":[\"source:note:did\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Target units and missing-data scope are declared.\",\"Changes in the units contributing to each comparison are inspected.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:0d143e4ad8ae6f92a33c2cdd\",\"object_id\":\"did.callaway_santanna\",\"predicate\":\"qualifies\",\"provenance\":[\"source:note:did\",\"callaway2021\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/did_modern.py\",\"tests/python/test_did_modern.py\",\"https://arxiv.org/html/1803.09015v4\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICEN