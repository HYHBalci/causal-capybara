:\"relation:f980bdbfd9af0534085d0971\",\"object_id\":\"concept:identification\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:pearl2009\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"sc.microsynth\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:fe76f417a1779f85a23f9249\",\"object_id\":\"design:synth\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"sc.microsynth\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Synthetic control when the treated unit is a neighbourhood or a small area and there are many of them.\",\"title\":\"Microsynth (many treated units)\"}" .
<urn:capy:sc.scpi> a capy:method ; skos:prefLabel "Prediction intervals for synthetic control (scpi)" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:sc.scpi\"],\"catalogue_key\":\"method:sc.scpi\",\"citation_ids\":[\"10.1080/01621459.2021.1979561\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":\"Not wrapped. Placebo-in-space and placebo-in-time inference are implemented.\",\"engines\":{\"python\":false,\"r\":\"scpi\"},\"needs_r_packages\":[\"scpi\"],\"runs_here\":false,\"summary\":\"Not built into the app yet. The authoritative version is the R package scpi, which the Engines screen can install for you.\"},\"designs\":[{\"explain_key\":\"design.synth\",\"id\":\"synth\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"One treated unit; build a comparison from a donor pool.\",\"title\":\"One place, constructed twin\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.sc_pre_fit\",\"id\":\"sc_pre_fit\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Pre-treatment fit\"},{\"explain_key\":\"diagnostic.sc_gap\",\"id\":\"sc_gap\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Treated minus synthetic gap\"},{\"explain_key\":\"diagnostic.sc_weights\",\"id\":\"sc_weights\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Donor weights\"}],\"estimands\":[{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"}],\"explain_key\":\"method.sc.scpi\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"sc.scpi\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":false,\"one_liner\":\"Confidence intervals for a synthetic control that come from a model of the prediction error rather than from permutation.\",\"options\":[],\"plain_language\":\"Confidence intervals for a synthetic control that come from a model of the prediction error rather than from permutation.\",\"probes\":[{\"explain_key\":\"probe.leave_one_out\",\"id\":\"probe.leave_one_out\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Drop one cluster, cohort or donor at a time and see whether any single one is carrying the result.\",\"requested_as\":\"probe.leave_one_out\",\"title\":\"Leave one out\"}],\"references\":[\"Cattaneo, Feng & Titiunik (2021), Prediction intervals for synthetic control methods\"],\"roles_forbidden\":[],\"roles_optional\":[],\"roles_required\":[\"an outcome\",\"a unit id\",\"a time variable\",\"the treated unit\",\"an intervention time\"],\"see_also\":[{\"explain_key\":\"design.synth\",\"id\":\"synth\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"One treated unit; build a comparison from a donor pool.\",\"title\":\"One place, constructed twin\"},{\"explain_key\":\"method.did.synthdid_r\",\"id\":\"did.synthdid_r\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Weight both units and periods, then take a difference-in-differences -- halfway between synthetic control and DiD.\",\"title\":\"Synthetic difference-in-differences (synthdid)\"},{\"explain_key\":\"method.its.causal_impact\",\"id\":\"its.causal_impact\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Model the counterfactual series with a structural time-series model and control series, and report a posterior rather than an interval.\",\"title\":\"Bayesian structural time series (CausalImpact)\"},{\"explain_key\":\"method.sc.abadie\",\"id\":\"sc.abadie\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Build a weighted copy of the treated place out of untreated places that looked like it beforehand, then watch the two lines separate.\",\"title\":\"Synthetic control\"},{\"explain_key\":\"method.sc.augmented\",\"id\":\"sc.augmented\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"When no weighted average of the donors can match the treated place, correct the leftover bias with a ridge model and show the size of the correction.\",\"title\":\"Augmented synthetic control\"},{\"explain_key\":\"method.sc.matrix_completion\",\"id\":\"sc.matrix_completion\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Treat the missing treated-period outcomes as holes in a panel and fill them in with a low-rank model of what the panel would have done.\",\"title\":\"Matrix completion\"},{\"explain_key\":\"method.sc.microsynth\",\"id\":\"sc.microsynth\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Synthetic control when the treated unit is a neighbourhood or a small area and there are many of them.\",\"title\":\"Microsynth (many treated units)\"}],\"status\":\"recommended\",\"status_label\":\"Recommended\",\"tags\":[\"One place, constructed twin\",\"ATT\",\"Recommended\"],\"title\":\"Prediction intervals for synthetic control (scpi)\",\"what_it_assumes\":[{\"explain_key\":\"assumption.donor_fit\",\"explains\":\"The weighted combination of untreated units reproduces the treated unit's pre-period path closely enough to stand in for it afterwards.\",\"id\":\"donor_fit\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Pre-treatment fit from the donor pool\",\"worry_when\":\"Visible pre-period gaps; a short pre-period relative to the number of donors; one donor carrying most of the weight.\"},{\"explain_key\":\"assumption.convex_hull\",\"explains\":\"The treated unit's characteristics can be written as a weighted average of the donors', with weights that do not go negative.\",\"id\":\"convex_hull\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Treated unit inside the donor convex hull\",\"worry_when\":\"The treated unit is at an extreme of the donor distribution on the predictors, or the pre-period gap has a persistent level offset.\"},{\"explain_key\":\"assumption.no_anticipation\",\"explains\":\"Units did not change behaviour before treatment arrived because they knew it was coming.\",\"id\":\"no_anticipation\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No anticipation\",\"worry_when\":\"There was a public announcement well before the policy started, or the pre-period coefficients move in the period immediately before adoption.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"}],\"when_not_to_use\":[\"The intervals rest on a model of the in-sample error and are not exact; they say nothing about whether the pre-period fit was credible in the first place.\"],\"when_to_use\":[\"Placebo inference has a coarse floor on its p-value with a small donor pool. This gives an interval instead of a rank.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"sc.scpi\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"sc.scpi\",\"registry\":{\"coming\":\"Not wrapped. Placebo-in-space and placebo-in-time inference are implemented.\",\"designs\":[\"synth\"],\"diagnostics\":[\"sc_pre_fit\",\"sc_gap\",\"sc_weights\"],\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":false,\"r\":\"scpi\"},\"estimands\":[\"ATT\"],\"id\":\"sc.scpi\",\"one_liner\":\"Confidence intervals for a synthetic control that come from a model of the prediction error rather than from permutation.\",\"probes\":[\"probe.leave_one_out\"],\"r_needs\":[\"scpi\"],\"reference_dispositions\":[{\"disposition\":\"resolved_metadata\",\"id\":\"10.1080/01621459.2021.1979561\",\"requested_as\":\"Cattaneo, Feng & Titiunik (2021), Prediction intervals for synthetic control methods\"}],\"reference_ids\":[\"10.1080/01621459.2021.1979561\"],\"references\":[\"Cattaneo, Feng & Titiunik (2021), Prediction intervals for synthetic control methods\"],\"roles_required\":[\"outcome\",\"unit\",\"time\",\"treated_unit\",\"event_time\"],\"source_path\":\"engines/registry/methods.extra.yaml\",\"source_sha256\":\"2cb349e9f7f7e6f88c10c18d81478656fd420eda7ca977d9767610ac8c7a4be0\",\"status\":\"recommended\",\"title\":\"Prediction intervals for synthetic control (scpi)\",\"what_can_go_wrong\":\"The intervals rest on a model of the in-sample error and are not exact; they say nothing about whether the pre-period fit was credible in the first place.\",\"why_recommended\":\"Placebo inference has a coarse floor on its p-value with a small donor pool. This gives an interval instead of a rank.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:168b9e66f01af9eb08842aa2\",\"object_id\":\"design:synth\",\"predicate\":\"compatible_with_design\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"sc.scpi\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:1d4e18e8baebbb39d994a5a4\",\"object_id\":\"estimand:ATT\",\"predicate\":\"targets_estimand\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"sc.scpi\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:23b2aa4e9070ef97e3307d2b\",\"object_id\":\"softwarepackage:scpi\",\"predicate\":\"implemented_by\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causa