\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Build a weighted copy of the treated place out of untreated places that looked like it beforehand, then watch the two lines separate.\",\"title\":\"Synthetic control\"}" .
<urn:capy:sc.augmented> a capy:method ; skos:prefLabel "Augmented synthetic control" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:sc.augmented\"],\"catalogue_key\":\"method:sc.augmented\",\"citation_ids\":[\"10.1080/01621459.2021.1971535\",\"source:unresolved:e7a6924054c6b937e77c\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":null,\"engines\":{\"python\":true,\"r\":\"augsynth\"},\"needs_r_packages\":[\"augsynth\"],\"runs_here\":true,\"summary\":\"Runs on this computer with what the app already installs.\"},\"designs\":[{\"explain_key\":\"design.synth\",\"id\":\"synth\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"One treated unit; build a comparison from a donor pool.\",\"title\":\"One place, constructed twin\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.sc_pre_fit\",\"id\":\"sc_pre_fit\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Pre-treatment fit\"},{\"explain_key\":\"diagnostic.sc_gap\",\"id\":\"sc_gap\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Treated minus synthetic gap\"},{\"explain_key\":\"diagnostic.sc_weights\",\"id\":\"sc_weights\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Donor weights\"},{\"explain_key\":\"diagnostic.sc_convex_hull\",\"id\":\"sc_convex_hull\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Treated unit inside the donor hull\"},{\"explain_key\":\"diagnostic.sc_placebo_space\",\"id\":\"sc_placebo_space\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Placebo in space\"},{\"explain_key\":\"diagnostic.sc_placebo_time\",\"id\":\"sc_placebo_time\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Placebo in time\"},{\"explain_key\":\"diagnostic.sc_loo\",\"id\":\"sc_loo\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Leave one donor out\"},{\"explain_key\":\"diagnostic.sc_augmentation\",\"id\":\"sc_augmentation\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Size of the augmentation correction\"}],\"estimands\":[{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"}],\"explain_key\":\"method.sc.augmented\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\",\"some of the robustness probes it names have no card of their own yet\"],\"id\":\"sc.augmented\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":false,\"one_liner\":\"When no weighted average of the donors can match the treated place, correct the leftover bias with a ridge model and show the size of the correction.\",\"options\":[{\"choices\":[\"cv\",\"prefit\",\"inverse_variance\"],\"default\":\"cv\",\"help\":\"cv: split the pre-treatment period and pick V by held-out fit (the usual choice). prefit: minimise the whole pre-treatment fit (can overfit). inverse_variance: weight predictors equally once standardised.\",\"label\":\"How predictor importance (V) is chosen\",\"name\":\"v_method\",\"profile\":\"advanced\",\"type\":\"select\"},{\"default\":\"all\",\"help\":\"'all' matches on every pre-treatment period; a number matches on that many evenly spaced lags. Cross-validated V needs a fixed number, so 'all' becomes the length of the training window.\",\"label\":\"Outcome path as predictors\",\"name\":\"outcome_lags\",\"profile\":\"advanced\",\"type\":\"string\"},{\"default\":null,\"help\":\"Variables averaged over the pre-treatment period and matched on alongside the outcome path. Defaults to the confounders on the board.\",\"label\":\"Extra predictors\",\"name\":\"predictors\",\"profile\":\"standard\",\"type\":\"columns\"},{\"default\":null,\"help\":\"Predictors measured over particular periods, e.g. [{'variable': 'gdp', 'periods': [1980, 1985], 'stat': 'mean'}].\",\"label\":\"Special predictors\",\"name\":\"special_predictors\",\"profile\":\"advanced\",\"type\":\"string\"},{\"default\":true,\"help\":\"Re-run the method treating each donor as if it had been treated. This is where the p-value comes from; turning it off leaves the estimate with no yardstick.\",\"label\":\"Placebo in space\",\"name\":\"placebo_in_space\",\"profile\":\"standard\",\"type\":\"bool\"},{\"default\":60,\"help\":\"Cap on the number of donor placebo refits. Lower it only for speed; the p-value's floor is 1/(placebos+1).\",\"label\":\"Donors used for placebos\",\"max\":500,\"min\":2,\"name\":\"max_placebos\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":true,\"help\":\"Refit pretending the intervention happened earlier, using pre-intervention data only.\",\"label\":\"Placebo in time\",\"name\":\"placebo_in_time\",\"profile\":\"standard\",\"type\":\"bool\"},{\"default\":null,\"help\":\"Which earlier period to pretend the intervention happened in. Defaults to about 60% of the way through the pre-treatment period.\",\"label\":\"Placebo date\",\"name\":\"placebo_time\",\"profile\":\"advanced\",\"type\":\"string\"},{\"default\":true,\"help\":\"Refit without each contributing donor, to see whether the result rests on one unit.\",\"label\":\"Leave one donor out\",\"name\":\"leave_one_out\",\"profile\":\"standard\",\"type\":\"bool\"},{\"default\":30,\"help\":\"Cap on leave-one-donor-out refits.\",\"label\":\"Leave-one-out refits\",\"max\":200,\"min\":1,\"name\":\"max_loo\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":0.5,\"help\":\"Share of total weight at which a single donor raises a warning.\",\"label\":\"Warn when one donor exceeds\",\"max\":1.0,\"min\":0.1,\"name\":\"donor_share_warn\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":0.95,\"help\":\"Level for the placebo-based interval.\",\"label\":\"Interval level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"}],\"plain_language\":\"When no weighted average of the donors can match the treated place, correct the leftover bias with a ridge model and show the size of the correction.\",\"probes\":[{\"explain_key\":null,\"id\":\"placebo_in_space\",\"in_catalogue\":false,\"kind\":\"probe\",\"one_liner\":null,\"requested_as\":\"placebo_in_space\",\"title\":\"Placebo in space: run it on a unit that was never treated\"},{\"explain_key\":null,\"id\":\"placebo_in_time\",\"in_catalogue\":false,\"kind\":\"probe\",\"one_liner\":null,\"requested_as\":\"placebo_in_time\",\"title\":\"Placebo in time: pretend it happened earlier\"},{\"explain_key\":null,\"id\":\"leave_one_donor_out\",\"in_catalogue\":false,\"kind\":\"probe\",\"one_liner\":null,\"requested_as\":\"leave_one_donor_out\",\"title\":\"Leave one donor region out\"},{\"explain_key\":\"probe.alternate_spec\",\"id\":\"probe.alternate_spec\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the grid of defensible specifications and sort the answers. The curve is the result, not the one you happened to run.\",\"requested_as\":\"alternate_spec\",\"title\":\"Specification curve\"},{\"explain_key\":\"probe.placebo_outcome\",\"id\":\"probe.placebo_outcome\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the same analysis on something the treatment could not have changed. It should find nothing.\",\"requested_as\":\"placebo_outcome\",\"title\":\"Placebo outcome\"},{\"explain_key\":null,\"id\":\"ridge_path\",\"in_catalogue\":false,\"kind\":\"probe\",\"one_liner\":null,\"requested_as\":\"ridge_path\",\"title\":\"Ridge penalty path\"}],\"references\":[\"Ben-Michael, Feller & Rothstein (2021), The Augmented Synthetic Control Method\",\"Abadie & L'Hour (2021), A Penalized Synthetic Control Estimator for Disaggregated Data\"],\"roles_forbidden\":[\"a running variable\",\"an instrument\",\"a cutoff\"],\"roles_optional\":[\"a treatment\",\"at least one measured confounder\",\"donor_pool\"],\"roles_required\":[\"a unit id\",\"a time variable\",\"an outcome\",\"the treated unit\",\"an intervention time\"],\"see_also\":[{\"explain_key\":\"design.synth\",\"id\":\"synth\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"One treated unit; build a comparison from a donor pool.\",\"title\":\"One place, constructed twin\"},{\"explain_key\":\"method.did.synthdid_r\",\"id\":\"did.synthdid_r\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Weight both units and periods, then take a difference-in-differences -- halfway between synthetic control and DiD.\",\"title\":\"Synthetic difference-in-differences (synthdid)\"},{\"explain_key\":\"method.its.causal_impact\",\"id\":\"its.causal_impact\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Model the counterfactual series with a structural time-series model and control series, and report a posterior rather than an interval.\",\"title\":\"Bayesian structural time series (CausalImpact)\"},{\"explain_key\":\"method.sc.abadie\",\"id\":\"sc.abadie\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Build a weighted copy of the treated place out of untreated places that looked like it beforehand, then watch the two lines separate.\",\"title\":\"Synthetic control\"},{\"explain_key\":\"method.sc.matrix_completion\",\"id\":\"sc.matrix_completion\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Treat the missing treated-period outcomes as holes in a panel and fill them in with a low-rank model of what the panel would have done.\",\"title\":\"Matrix completion\"},{\"explain_key\":\"method.sc.microsynth\",\"id\":\"sc.microsynth\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Synthetic control when the treated unit is a neighbourhood or a small area and there are many of them.\",\"title\":\"Microsynth (many treated units)\"},{\"explain_key\":\"method.sc.scpi\",\"id\":\"sc.scpi\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Confidence intervals for a synthetic control that come from a model of the prediction error rather than from permutation.\",\"title\":\"Prediction intervals for synthetic control (scpi)\"}],\"status\":\"recommended\",\"status_label\":\"Recommended\",\"tags\":[\"One place, constructed twin\",\"ATT\",\"Recommended\"],\"title\":\"Augmented synthetic control\",\"what_it_assumes\":[{\"explain_key\":\"assumption.donor_fit\",\"explains\":\"The weighted combination of untreated units reproduces the treated unit's pre-period path closely enough to stand in for it afterwards.\",\"id\":\"donor_fit\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Pre-treatment fit from the donor pool\",\"worry_when\":\"Visible pre-period gaps; a short pre-period relative to the number of donors; one donor carrying most of the weight.\"},{\"explain_key\":\"assumption.convex_hull\",\"explains\":\"The treated unit's characteristics can be written as a weighted average of the donors', with weights that do not go negative.\",\"id\":\"convex_hull\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Treated unit inside the donor convex hull\",\"worry_when\":\"The treated unit is at an extreme of the donor distribution on the predictors, or the pre-period gap has a persistent level offset.\"},{\"explain_key\":\"assumption.no_anticipation\",\"explains\":\"Units did not change behaviour before treatment arrived because they knew it was coming.\",\"id\":\"no_anticipation\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No anticipation\",\"worry_when\":\"There was a public announcement well before the policy started, or the pre-period coefficients move in the period immediately before adoption.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"}],\"when_not_to_use\":[\"The correction can be larger than the original estimate, at which point the outcome model rather than the donor pool is doing the work. The augmented weights can be negative, which means extrapolating outside the donor pool. This implementation offers ridge ASCM only (no covariate or general outcome-model augmentation), picks the penalty by holding out late pre-treatment periods with the SC weights held fixed, and reports placebo inference rather than augsynth's jackknife+ intervals.\",\"The plain synthetic control already fits the pre-treatment period well - then the correction is noise you do not need.\"],\"when_to_use\":[\"Poor pre-treatment fit is the usual reason a synthetic control fails, and augmentation is the honest response: it estimates the leftover bias and subtracts it, while reporting the uncorrected number beside it so you can see how much of the answer is the correction.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\",\"some of the robustness probes it names have no card of their own yet\"],\"id\":\"sc.augmented\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"sc.augmented\",\"registry\":{\"designs\":[\"synth\"],\"diagnostics\":[\"sc_pre_fit\",\"sc_gap\",\"sc_weights\",\"sc_convex_hull\",\"sc_placebo_space\",\"sc_placebo_time\",\"sc_loo\",\"sc_augmentation\"],\"disrecommend_when\":\"The plain synthetic control already fits the pre-treatment period well - then the correction is noise you do not need.\",\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":true,\"r\":\"augsynth\"},\"estimands\":[\"ATT\"],\"explain_key\":\"method.sc.augmented\",\"id\":\"sc.augmented\",\"needs\":[\"numpy\",\"scipy\",\"pandas\"],\"needs_overlap\":false,\"one_liner\":\"When no weighted average of the donors can match the treated place, correct the leftover bias with a ridge model and show the size of the correction.\",\"options\":[{\"choices\":[\"cv\",\"prefit\",\"inverse_variance\"],\"default\":\"cv\",\"help\":\"cv: split the pre-treatment period and pick V by held-out fit (the usual choice). prefit: minimise the whole pre-treatment fit (can overfit). inverse_variance: weight predictors equally once standardised.\",\"label\":\"How predictor importance (V) is chosen\",\"name\":\"v_method\",\"profile\":\"advanced\",\"type\":\"select\"},{\"default\":\"all\",\"help\":\"'all' matches on every pre-treatment period; a number matches on that many evenly spaced lags. Cross-validated V needs a fixed number, so 'all' becomes the length of the training window.\",\"label\":\"Outcome path as predictors\",\"name\":\"outcome_lags\",\"profile\":\"advanced\",\"type\":\"string\"},{\"default\":null,\"help\":\"Variables averaged over the pre-treatment period and matched on alongside the outcome path. Defaults to the confounders on the board.\",\"label\":\"Extra predictors\",\"name\":\"predictors\",\"profile\":\"standard\",\"type\":\"columns\"},{\"default\":null,\"help\":\"Predictors measured over particular periods, e.g. [{'variable': 'gdp', 'periods': [1980, 1985], 'stat': 'mean'}].\",\"label\":\"Special predictors\",\"name\":\"special_predictors\",\"profile\":\"advanced\",\"type\":\"string\"},{\"default\":true,\"help\":\"Re-run the method treating each donor as if it had been treated. This is where the p-value comes from; turning it off leaves the estimate with no yardstick.\",\"label\":\"Placebo in space\",\"name\":\"placebo_in_space\",\"profile\":\"standard\",\"type\":\"bool\"},{\"default\":60,\"help\":\"Cap on the number of donor placebo refits. Lower it only for speed; the p-value's floor is 1/(placebos+1).\",\"label\":\"Donors used for placebos\",\"max\":500,\"min\":2,\"name\":\"max_placebos\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":true,\"help\":\"Refit pretending the intervention happened earlier, using pre-intervention data only.\",\"label\":\"Placebo in time\",\"name\":\"placebo_in_time\",\"profile\":\"standard\",\"type\":\"bool\"},{\"default\":null,\"help\":\"Which earlier period to pretend the intervention happened in. Defaults to about 60% of the way through the pre-treatment period.\",\"label\":\"Placebo date\",\"name\":\"placebo_time\",\"profile\":\"advanced\",\"type\":\"string\"},{\"default\":true,\"help\":\"Refit without each contributing donor, to see whether the result rests on one unit.\",\"label\":\"Leave one donor out\",\"name\":\"leave_one_out\",\"profile\":\"standard\",\"type\":\"bool\"},{\"default\":30,\"help\":\"Cap on leave-one-donor-out refits.\",\"label\":\"Leave-one-out refits\",\"max\":200,\"min\":1,\"name\":\"max_loo\",\"profile\":\"advanced\",\"type\":\"int\"},{\"default\":0.5,\"help\":\"Share of total weight at which a single donor raises a warning.\",\"label\":\"Warn when one donor exceeds\",\"max\":1.0,\"min\":0.1,\"name\":\"donor_share_warn\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":0.95,\"help\":\"Level for the placebo-based interval.\",\"label\":\"Interval level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"}],\"probes\":[\"placebo_in_space\",\"placebo_in_time\",\"leave_one_donor_out\",\"alternate_spec\",\"placebo_outcome\",\"ridge_path\"],\"reference_dispositions\":[{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:e7a6924054c6b937e77c\",\"requested_as\":\"Ben-Michael, Feller & Rothstein (2021), The Augmented Synthetic Control Method\"},{\"disposition\":\"resolved_metadata\",\"id\":\"10.1080/01621459.2021.1971535\",\"requested_as\":\"Abadie & L'Hour (2021), A Penalized Synthetic Control Estimator for Disaggregated Data\"}],\"reference_ids\":[\"source:unresolved:e7a6924054c6b937e77c\",\"10.1080/01621459.2021.1971535\"],\"references\":[\"Ben-Michael, Feller & Rothstein (2021), The Augmented Synthetic Control Method\",\"Abadie & L'Hour (2021), A Penalized Synthetic Control Estimator for Disaggregated Data\"],\"roles_forbidden\":[\"running\",\"instruments\",\"cutoff\"],\"roles_optional\":[\"treatment\",\"confounders\",\"donor_pool\"],\"roles_required\":[\"unit\",\"time\",\"outcome\",\"treated_unit\",\"event_time\"],\"source_path\":\"engines/python/capy_py/synth.py\",\"source_sha256\":\"15e0fecaebae31df3c3744e9641e14d8600985ef540e9ec544eefab910067860\",\"status\":\"recommended\",\"title\":\"Augmented synthetic control\",\"what_can_go_wrong\":\"The correction can be larger than the original estimate, at which point the outcome model rather than the donor pool is doing the work. The augmented weights can be negative, which means extrapolating outside the donor pool. This implementation offers ridge ASCM only (no covariate or general outcome-model augmentation), picks the penalty by holding out late pre-treatment periods with the SC weights held fixed, and reports placebo inference rather than augsynth's jackknife+ intervals.\",\"why_recommended\":\"Poor pre-treatment fit is the usual reason a synthetic control fails, and augmentation is the honest response: it estimates the leftover bias and subtracts it, while reporting the uncorrected number beside it so you can see how much of the answer is the correction.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:05716af62c14ffad66843261\",\"object_id\":\"assumption:convex_hull\",\"predicate\":\"requires_assumption\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"sc.augmented\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:0ce64f0c3392fed8f48f1c74\",\"object_id\":\"concept:anticipation\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"abadie2005\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"sc.augmented\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:0e71b7f6ad7024f10f71a4ae\",\"object_id\":\"concept:causal-good-practices\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:rubin2008\",\"source:ontology:ich2019\",\"source:ontology:wilson2017\",\"source:ontology:sandve2013\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"sc.augmented\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:0ff46d908457eb5dceba2b04\",\"object_id\":\"diagnostic:sc_convex_hull\",\"predicate\":\"checked_by_diagnostic\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"sc.augmented\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:212f99e528178b0b6f078e3f\",\"object_id\":\"concept:causal-foundations\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:pearl2009\",\"source:ontology:rubin2008\",\"hernan2020\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"sc.augmented\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:2bd152f4b734e77132e9d8fa\",\"object_id\":\"assumption:sutva\",\"predicate\":\"requires_assumption\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_