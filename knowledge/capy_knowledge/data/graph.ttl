",\"provenance\":[\"source:project-ontology\",\"source:ontology:ich2019\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"obs.weighting.entropy\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:feff94dc172a8e7a3d5ff8ab\",\"object_id\":\"softwarepackage:capy-python\",\"predicate\":\"implemented_by\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"obs.weighting.entropy\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Find the weights closest to equal that make the covariate means match exactly.\",\"title\":\"Entropy balancing\"}" .
<urn:capy:obs.weighting.ipw> a capy:method ; skos:prefLabel "Propensity weighting" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:obs.weighting.ipw\"],\"catalogue_key\":\"method:obs.weighting.ipw\",\"citation_ids\":[\"10.1080/01621459.2016.1260466\",\"rosenbaum1983\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":null,\"engines\":{\"python\":true,\"r\":\"WeightIt\"},\"needs_r_packages\":[\"WeightIt\"],\"runs_here\":true,\"summary\":\"Runs on this computer with what the app already installs.\"},\"designs\":[{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.overlap\",\"id\":\"overlap\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Overlap between the arms\"},{\"explain_key\":\"diagnostic.love\",\"id\":\"love\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Covariate balance (Love plot)\"},{\"explain_key\":\"diagnostic.ess\",\"id\":\"ess\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Effective sample size\"},{\"explain_key\":\"diagnostic.ps_calibration\",\"id\":\"ps_calibration\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Treatment-model calibration\"},{\"explain_key\":\"diagnostic.propensity_clipping\",\"id\":\"propensity_clipping\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Propensity clipping\"}],\"estimands\":[{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"},{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"},{\"acronym\":\"ATC\",\"explain_key\":\"estimand.atc\",\"id\":\"ATC\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who didn't get it, what would it have done?\",\"title\":\"Average treatment effect on the controls\"},{\"acronym\":\"ATO\",\"explain_key\":\"estimand.ato\",\"id\":\"ATO\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For the people where treated and untreated genuinely overlap, what did it do?\",\"title\":\"Average treatment effect on the overlap population\"}],\"explain_key\":\"method.obs.weighting.ipw\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"obs.weighting.ipw\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":true,\"one_liner\":\"Reweight the sample so the treated and untreated groups look alike on the measured confounders.\",\"options\":[{\"choices\":[\"att\",\"ate\",\"atc\",\"ato\",\"matching\",\"stabilised\"],\"default\":\"att\",\"help\":\"ATO (overlap weights) is the most stable when the groups barely overlap, but it changes the population the estimate is about.\",\"label\":\"Population to weight to\",\"name\":\"weight_type\",\"profile\":\"standard\",\"type\":\"select\"},{\"choices\":[\"logit\",\"forest\",\"gradient_boosting\"],\"default\":\"logit\",\"help\":\"Flexible learners use out-of-fold predictions so the overlap plot stays honest.\",\"label\":\"Treatment model\",\"name\":\"ps_learner\",\"profile\":\"advanced\",\"type\":\"select\"},{\"default\":0.01,\"help\":\"Bounds the weights. Reported, never silent.\",\"label\":\"Clip propensity scores at\",\"max\":0.2,\"min\":0.0,\"name\":\"clip\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":null,\"help\":\"An explicit choice that changes the population. The Probe bench can plot the estimate against it instead.\",\"label\":\"Trim units outside\",\"max\":0.4,\"min\":0.0,\"name\":\"trim\",\"profile\":\"advanced\",\"type\":\"number\"}],\"plain_language\":\"Reweight the sample so the treated and untreated groups look alike on the measured confounders.\",\"probes\":[{\"explain_key\":\"probe.trim_curve\",\"id\":\"probe.trim_curve\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Re-estimate across a grid of propensity-score trimming thresholds instead of picking one and hoping.\",\"requested_as\":\"probe.trim_curve\",\"title\":\"Trimming curve\"},{\"explain_key\":\"probe.placebo_outcome\",\"id\":\"probe.placebo_outcome\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the same analysis on something the treatment could not have changed. It should find nothing.\",\"requested_as\":\"probe.placebo_outcome\",\"title\":\"Placebo outcome\"},{\"explain_key\":\"probe.subset\",\"id\":\"probe.subset\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Re-estimate on random subsets. The answer should move about as much as losing that much data costs, and no more.\",\"requested_as\":\"probe.subset\",\"title\":\"Subset stability\"},{\"explain_key\":\"probe.random_common_cause\",\"id\":\"probe.random_common_cause\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Add a variable that causes nothing to the adjustment set. The estimate should barely move.\",\"requested_as\":\"probe.random_common_cause\",\"title\":\"Random common cause\"},{\"explain_key\":\"probe.cinelli_hazlett\",\"id\":\"probe.cinelli_hazlett\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"How strong would an unmeasured confounder have to be -- compared with the covariates you already have -- to explain the estimate away?\",\"requested_as\":\"probe.cinelli_hazlett\",\"title\":\"Cinelli-Hazlett sensitivity (partial R2)\"}],\"references\":[\"Rosenbaum & Rubin (1983), The central role of the propensity score\",\"Li, Morgan & Zaslavsky (2018), Balancing covariates via propensity score weighting\"],\"roles_forbidden\":[\"forbidden\"],\"roles_optional\":[\"a clustering variable\",\"weight\",\"effect_modifiers\"],\"roles_required\":[\"a treatment\",\"an outcome\",\"at least one measured confounder\"],\"see_also\":[{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"},{\"explain_key\":\"method.bounds.manski\",\"id\":\"bounds.manski\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Report the range the effect must lie in given only what the data can support, without assuming away the missing counterfactual.\",\"title\":\"Manski bounds\"},{\"explain_key\":\"method.interference.exposure\",\"id\":\"interference.exposure\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"When one unit's treatment affects another's outcome, estimate the direct and spillover effects separately instead of pretending neither exists.\",\"title\":\"Interference and spillovers\"},{\"explain_key\":\"method.ml.causal_forest\",\"id\":\"ml.causal_forest\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Grow trees that look for units whose effect differs, keeping the rows that chose each split away from the rows that estimate it.\",\"title\":\"Honest causal forest\"},{\"explain_key\":\"method.ml.dml_irm\",\"id\":\"ml.dml_irm\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"A separate outcome model for each arm plus a treatment model, combined in a doubly robust score: right if either side is right.\",\"title\":\"Double ML (interactive)\"},{\"explain_key\":\"method.ml.dml_plr\",\"id\":\"ml.dml_plr\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Predict the outcome and the treatment from the confounders, then regress what is left of one on what is left of the other.\",\"title\":\"Double ML (partially linear)\"},{\"explain_key\":\"method.ml.metalearner\",\"id\":\"ml.metalearner\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Build the per-unit effect out of ordinary prediction models, four different ways, on the same cross-fitting.\",\"title\":\"Meta-learner (T, S, X, DR)\"}],\"status\":\"recommended\",\"status_label\":\"Recommended\",\"tags\":[\"Adjust for background differences\",\"ATE\",\"ATT\",\"ATC\",\"ATO\",\"Recommended\"],\"title\":\"Propensity weighting\",\"what_it_assumes\":[{\"explain_key\":\"assumption.exchangeability\",\"explains\":\"Treated and untreated units are comparable once you condition on the confounders you measured. Everything that pushed people towards treatment and also moves the outcome is in your adjustment set.\",\"id\":\"exchangeability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Exchangeability / no unmeasured confounding\",\"worry_when\":\"Treatment was chosen by people who knew something about the likely outcome that you do not observe. Clinical judgement, self-selection into a programme, and administrative triage are the classic cases.\"},{\"explain_key\":\"assumption.positivity\",\"explains\":\"Every kind of unit had some chance of being treated and some chance of not being treated. Where that fails, there is no comparison to make and the model is inventing one.\",\"id\":\"positivity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Positivity / overlap\",\"worry_when\":\"Any single weight carries a large share of the total; the effective sample is far below the nominal one; the propensity model separates the arms almost perfectly; treated units sit outside the control group's range.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"when_not_to_use\":[\"Weights explode when some units are almost certain to be treated. The effective sample size, not N, is the honest denominator.\"],\"when_to_use\":[\"Keeps every unit, targets the population you name, and the weight histogram shows you immediately when it is in trouble.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"obs.weighting.ipw\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"obs.weighting.ipw\",\"registry\":{\"designs\":[\"observational\"],\"diagnostics\":[\"overlap\",\"love\",\"ess\",\"ps_calibration\",\"propensity_clipping\"],\"disrecommend_when\":null,\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":true,\"r\":\"WeightIt\"},\"estimands\":[\"ATE\",\"ATT\",\"ATC\",\"ATO\"],\"explain_key\":\"method.obs.weighting.ipw\",\"id\":\"obs.weighting.ipw\",\"needs\":[\"numpy\",\"scipy\",\"pandas\"],\"needs_overlap\":true,\"one_liner\":\"Reweight the sample so the treated and untreated groups look alike on the measured confounders.\",\"options\":[{\"choices\":[\"att\",\"ate\",\"atc\",\"ato\",\"matching\",\"stabilised\"],\"default\":\"att\",\"help\":\"ATO (overlap weights) is the most stable when the groups barely overlap, but it changes the population the estimate is about.\",\"label\":\"Population to weight to\",\"name\":\"weight_type\",\"profile\":\"standard\",\"type\":\"select\"},{\"choices\":[\"logit\",\"forest\",\"gradient_boosting\"],\"default\":\"logit\",\"help\":\"Flexible learners use out-of-fold predictions so the overlap plot stays honest.\",\"label\":\"Treatment model\",\"name\":\"ps_learner\",\"profile\":\"advanced\",\"type\":\"select\"},{\"default\":0.01,\"help\":\"Bounds the weights. Reported, never silent.\",\"label\":\"Clip propensity scores at\",\"max\":0.2,\"min\":0.0,\"name\":\"clip\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":null,\"help\":\"An explicit choice that changes the population. The Probe bench can plot the estimate against it instead.\",\"label\":\"Trim units outside\",\"max\":0.4,\"min\":0.0,\"name\":\"trim\",\"profile\":\"advanced\",\"type\":\"number\"}],\"probes\":[\"probe.trim_curve\",\"probe.placebo_outcome\",\"probe.subset\",\"probe.random_common_cause\",\"probe.cinelli_hazlett\"],\"reference_dispositions\":[{\"disposition\":\"resolved_metadata\",\"id\":\"rosenbaum1983\",\"requested_as\":\"Rosenbaum & Rubin (1983), The central role of the propensity score\"},{\"disposition\":\"resolved_metadata\",\"id\":\"10.1080/01621459.2016.1260466\",\"requested_as\":\"Li, Morgan & Zaslavsky (2018), Balancing covariates via propensity score weighting\"}],\"reference_ids\":[\"rosenbaum1983\",\"10.1080/01621459.2016.1260466\"],\"references\":[\"Rosenbaum & Rubin (1983), The central role of the propensity score\",\"Li, Morgan & Zaslavsky (2018), Balancing covariates via propensity score weighting\"],\"roles_forbidden\":[\"forbidden\"],\"roles_optional\":[\"cluster\",\"weight\",\"effect_modifiers\"],\"roles_required\":[\"treatment\",\"outcome\",\"confounders\"],\"source_path\":\"engines/python/capy_py/observational.py\",\"source_sha256\":\"f9dfafacc9dacabf923e4d48367973338dbe326bdf5c222ade0dedf0470b5ccb\",\"status\":\"recommended\",\"title\":\"Propensity weighting\",\"what_can_go_wrong\":\"Weights explode when some units are almost certain to be treated. The effective sample size, not N, is the honest denominator.\",\"why_recommended\":\"Keeps every unit, targets the population you name, and the weight histogram shows you immediately when it is in trouble.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:0f2b789ed7602eac6d5f179f\",\"object_id\":\"ml.dml_plr\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"obs.weighting.ipw\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:172d925d82ceefda5bbd302e\",\"object_id\":\"concept:collider\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:pearl2009\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":