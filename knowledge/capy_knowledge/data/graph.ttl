":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Citation and original explanation; linked external bodies are not included.\",\"subject_id\":\"claim:survival-marginal\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:7da3088fdc76150bce0f1a1a\",\"object_id\":\"concept:survival-difference\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:cole2004\",\"source:ontology:uno2014\",\"source:ontology:hernan2010\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped proposition explains or qualifies this concept; support remains limited to the exact original evidence note.\",\"subject_id\":\"claim:survival-marginal\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Target population, shared horizon, treatment/censoring identification and model conditions are justified.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:bf96db42528c8b19679db379\",\"object_id\":\"survival.rmst\",\"predicate\":\"qualifies\",\"provenance\":[\"source:note:survival-marginal\",\"source:ontology:cole2004\",\"source:ontology:uno2014\",\"source:ontology:hernan2010\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:cole2004\",\"source:ontology:uno2014\",\"source:ontology:hernan2010\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped original methodological explanation; no whole-method or study audit is implied.\",\"subject_id\":\"claim:survival-marginal\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:cole2004\",\"source:ontology:uno2014\",\"source:ontology:hernan2010\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped original methodological explanation; no whole-method or study audit is implied.\",\"source_ids\":[\"source:note:survival-marginal\",\"source:ontology:cole2004\",\"source:ontology:uno2014\",\"source:ontology:hernan2010\"],\"summary\":\"The survival contrast S^1(tau) minus S^0(tau) compares event-free probabilities at a declared horizon. RMST is the integral of survival from zero through tau, so an RMST difference has duration units and requires the same horizon in both strategies. A conditional hazard ratio or AFT coefficient is a different summary. Standardized survival predictions average strategy-specific curves over the declared target covariate distribution under the needed treatment, censoring and model conditions.\",\"title\":\"Survival and RMST contrasts are horizon-specific population targets\"}" .
<urn:capy:claim%3Atarget-time> a capy:claim ; skos:prefLabel "Eligibility and follow-up must share a defensible time zero" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Atarget-time> ; capy:record "{\"aliases\":[\"target time\",\"immortal time bias\",\"time zero eligibility assignment follow-up\",\"future exposure labels\"],\"assertion_mode\":\"original_editorial_explanation\",\"citation_ids\":[\"source:note:target-time\",\"source:ontology:hernan2016\"],\"citations\":[],\"conditions\":[\"Eligibility, assignment and follow-up are aligned for the defined target trial.\"],\"counterevidence\":[\"The related diagnostic, fitted model or software check cannot establish all causal assumptions.\"],\"evidence_ids\":[\"evidence:target-time\"],\"gaps\":[\"Independent human review and empirical study-specific identification evidence are absent.\"],\"id\":\"claim:target-time\",\"kind\":\"claim\",\"provenance\":[\"source:note:target-time\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:249f7230ba0be8b036fadf22\",\"object_id\":\"source:note:target-time\",\"predicate\":\"cites\",\"provenance\":[\"source:note:target-time\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:hernan2016\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\"