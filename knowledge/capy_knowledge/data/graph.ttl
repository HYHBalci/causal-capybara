blic_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"long.ltmle_survival\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:f4a8a9691878a00cf3ac4e3a\",\"object_id\":\"assumption:sequential_ignorability\",\"predicate\":\"requires_assumption\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"long.ltmle_survival\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:f9198eec0685b0cd48768d5b\",\"object_id\":\"concept:longitudinal-gformula\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:robins2000\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"long.ltmle_survival\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:fbb4a43c3ea12906b7372624\",\"object_id\":\"concept:causal-framing\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:pearl2009\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"long.ltmle_survival\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Time-to-event outcomes with time-varying treatment and censoring, targeted at each time.\",\"title\":\"Longitudinal TMLE for survival outcomes\"}" .
<urn:capy:long.msm_iptw> a capy:method ; skos:prefLabel "Marginal structural model (time-varying weights)" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:long.msm_iptw\"],\"catalogue_key\":\"method:long.msm_iptw\",\"citation_ids\":[\"10.1093/aje/kwn164\",\"10.1097/00001648-200009000-00011\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":null,\"engines\":{\"python\":true,\"r\":\"ipw\"},\"needs_r_packages\":[\"ipw\"],\"runs_here\":true,\"summary\":\"Runs on this computer with what the app already installs.\"},\"designs\":[{\"explain_key\":\"design.longitudinal\",\"id\":\"longitudinal\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"The same person is treated, untreated, treated again; confounders also move.\",\"title\":\"Treatment that changes over time\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.temporal_ordering\",\"id\":\"temporal_ordering\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Temporal ordering of covariates\"},{\"explain_key\":\"diagnostic.person_time\",\"id\":\"person_time\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Person-time and switching\"},{\"explain_key\":\"diagnostic.positivity_by_period\",\"id\":\"positivity_by_period\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Positivity by period\"},{\"explain_key\":\"diagnostic.weights_by_period\",\"id\":\"weights_by_period\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Weights by period\"},{\"explain_key\":\"diagnostic.weighted_balance\",\"id\":\"weighted_balance\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Balance after weighting\"},{\"explain_key\":\"diagnostic.censoring_weights\",\"id\":\"censoring_weights\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Censoring weights\"}],\"estimands\":[{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"}],\"explain_key\":\"method.long.msm_iptw\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"long.msm_iptw\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":true,\"one_liner\":\"Reweight each person-period so the treated and untreated histories look alike, then fit one simple model to the reweighted data.\",\"options\":[{\"choices\":[\"cumulative\",\"current\",\"cumulative_and_current\"],\"default\":\"cumulative\",\"help\":\"Total periods of treatment so far (a dose), this period's treatment only, or both.\",\"label\":\"What the model says the outcome depends on\",\"name\":\"msm_form\",\"profile\":\"standard\",\"type\":\"select\"},{\"default\":true,\"help\":\"Divides by the probability of treatment given baseline only, which keeps the weights near one. Almost always worth it.\",\"label\":\"Stabilised weights\",\"name\":\"stabilised\",\"profile\":\"standard\",\"type\":\"bool\"},{\"default\":null,\"help\":\"0.01 clips the smallest and largest 1% of weights. It trades bias for variance and it is recorded as your choice, never applied by default.\",\"label\":\"Truncate the weight tails at\",\"max\":0.2,\"min\":0.0,\"name\":\"truncate\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":true,\"help\":\"When follow-up ends early, reweight the people who stayed to stand in for those who left.\",\"label\":\"Weight for people who leave\",\"name\":\"censoring_weights\",\"profile\":\"standard\",\"type\":\"bool\"},{\"choices\":[\"dummies\",\"linear\"],\"default\":\"dummies\",\"label\":\"How time enters the models\",\"name\":\"period_effects\",\"profile\":\"advanced\",\"type\":\"select\"}],\"plain_language\":\"Reweight each person-period so the treated and untreated histories look alike, then fit one simple model to the reweighted data.\",\"probes\":[{\"explain_key\":\"probe.trim_curve\",\"id\":\"probe.trim_curve\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Re-estimate across a grid of propensity-score trimming thresholds instead of picking one and hoping.\",\"requested_as\":\"probe.trim_curve\",\"title\":\"Trimming curve\"},{\"explain_key\":\"probe.subset\",\"id\":\"probe.subset\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Re-estimate on random subsets. The answer should move about as much as losing that much data costs, and no more.\",\"requested_as\":\"probe.subset\",\"title\":\"Subset stability\"},{\"explain_key\":\"probe.placebo_outcome\",\"id\":\"probe.placebo_outcome\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the same analysis on something the treatment could not have changed. It should find nothing.\",\"requested_as\":\"probe.placebo_outcome\",\"title\":\"Placebo outcome\"},{\"explain_key\":\"probe.random_common_cause\",\"id\":\"probe.random_common_cause\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Add a variable that causes nothing to the adjustment set. The estimate should barely move.\",\"requested_as\":\"probe.random_common_cause\",\"title\":\"Random common cause\"}],\"references\":[\"Robins, Hernan & Brumback (2000), Marginal structural models and causal inference in epidemiology\",\"Cole & Hernan (2008), Constructing inverse probability weights for marginal structural models\"],\"roles_forbidden\":[\"forbidden\"],\"roles_optional\":[\"strata\",\"weight\",\"a clustering variable\",\"censoring\"],\"roles_required\":[\"a unit id\",\"a time variable\",\"a treatment\",\"an outcome\",\"at least one measured confounder\"],\"see_also\":[{\"explain_key\":\"design.longitudinal\",\"id\":\"longitudinal\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"The same person is treated, untreated, treated again; confounders also move.\",\"title\":\"Treatment that changes over time\"},{\"explain_key\":\"method.long.g_estimation\",\"id\":\"long.g_estimation\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Estimate the effect of a treatment regime by finding the parameter that removes the association between treatment and the blipped-down outcome.\",\"title\":\"G-estimation of structural nested models\"},{\"explain_key\":\"method.long.gformula\",\"id\":\"long.gformula\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Model each period in turn, then simulate the world where everyone followed the strategy you name.\",\"title\":\"Parametric g-formula\"},{\"explain_key\":\"method.long.lmtp\",\"id\":\"long.lmtp\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Estimate the effect of shifting a continuous or multi-valued treatment, rather than of setting everyone to one value.\",\"title\":\"Longitudinal modified treatment policies (lmtp)\"},{\"explain_key\":\"method.long.ltmle\",\"id\":\"long.ltmle\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Regress backwards from the final outcome, then correct with the treatment probabilities: right if either set of models is right.\",\"title\":\"Sequential doubly robust (ICE g-formula with augmentation)\"},{\"explain_key\":\"method.long.ltmle_survival\",\"id\":\"long.ltmle_survival\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Time-to-event outcomes with time-varying treatment and censoring, targeted at each time.\",\"title\":\"Longitudinal TMLE for survival outcomes\"},{\"explain_key\":\"method.obs.missing.mice\",\"id\":\"obs.missing.mice\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Impute the missing values several times, run the analysis in each, and combine -- instead of dropping every row with a gap.\",\"title\":\"Multiple imputation compatible with the analysis\"}],\"status\":\"recommended\",\"status_label\":\"Recommended\",\"tags\":[\"Treatment that changes over time\",\"ATE\",\"Recommended\"],\"title\":\"Marginal structural model (time-varying weights)\",\"what_it_assumes\":[{\"explain_key\":\"assumption.no_time_varying_confounding\",\"explains\":\"At every period, the things that drive the treatment decision and also affect the outcome are measured -- and measured before that decision.\",\"id\":\"no_time_varying_confounding\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No unmeasured time-varying confounding\",\"worry_when\":\"Clinical measurements taken after the dose was changed; employment status recorded at the end of a period used to explain treatment at its start.\"},{\"explain_key\":\"assumption.positivity\",\"explains\":\"Every kind of unit had some chance of being treated and some chance of not being treated. Where that fails, there is no comparison to make and the model is inventing one.\",\"id\":\"positivity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Positivity / overlap\",\"worry_when\":\"Any single weight carries a large share of the total; the effective sample is far below the nominal one; the propensity model separates the arms almost perfectly; treated units sit outside the control group's range.\"},{\"explain_key\":\"assumption.sequential_ignorability\",\"explains\":\"No unmeasured confounding of the treatment-outcome relationship, and none of the mediator-outcome relationship either, even after conditioning on treatment.\",\"id\":\"sequential_ignorability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Sequential ignorability\",\"worry_when\":\"There is a variable affected by treatment that also confounds the mediator-outcome relationship. Under that structure the natural effects are not identified at all.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"when_not_to_use\":[\"Weights are a product over the whole history, so they degenerate as follow-up lengthens; a handful of people end up carrying the estimate while the interval stays narrow.\",\"Long follow-up with strong time-varying confounding, where the cumulative weights collapse the effective sample\"],\"when_to_use\":[\"The standard answer to time-varying confounding, and the one whose failure mode is visible: the weight histogram and the effective sample size tell you when the data cannot support the comparison.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"long.msm_iptw\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"long.msm_iptw\",\"registry\":{\"designs\":[\"longitudinal\"],\"diagnostics\":[\"temporal_ordering\",\"person_time\",\"positivity_by_period\",\"weights_by_period\",\"weighted_balance\",\"censoring_weights\"],\"disrecommend_when\":\"Long follow-up with strong time-varying confounding, where the cumulative weights collapse the effective sample\",\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":true,\"r\":\"ipw\"},\"estimands\":[\"ATE\"],\"explain_key\":\"method.long.msm_iptw\",\"id\":\"long.msm_iptw\",\"needs\":[\"numpy\",\"scipy\",\"pandas\"],\"needs_overlap\":true,\"one_liner\":\"Reweight each person-period so the treated and untreated histories look alike, then fit one simple model to the reweighted data.\",\"options\":[{\"choices\":[\"cumulative\",\"current\",\"cumulative_and_current\"],\"default\":\"cumulative\",\"help\":\"Total periods of treatment so far (a dose), this period's treatment only, or both.\",\"label\":\"What the model says the outcome depends on\",\"name\":\"msm_form\",\"profile\":\"standard\",\"type\":\"select\"},{\"default\":true,\"help\":\"Divides by the probability of treatment given baseline only, which keeps the weights near one. Almost always worth it.\",\"label\":\"Stabilised weights\",\"name\":\"stabilised\",\"profile\":\"standard\",\"type\":\"bool\"},{\"default\":null,\"help\":\"0.01 clips the smallest and largest 1% of weights. It trades bias for variance and it is recorded as your choice, never applied by default.\",\"label\":\"Truncate the weight tails at\",\"max\":0.2,\"min\":0.0,\"name\":\"truncate\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":true,\"help\":\"When follow-up ends early, reweight the people who stayed to stand in for those who left.\",\"label\":\"Weight for people who leave\",\"name\":\"censoring_weights\",\"profile\":\"standard\",\"type\":\"bool\"},{\"choices\":[\"dummies\",\"linear\"],\"default\":\"dummies\",\"label\":\"How time enters the models\",\"name\":\"period_effects\",\"profile\":\"advanced\",\"type\":\"select\"}],\"probes\":[\"probe.trim_curve\",\"probe.subset\",\"probe.placebo_outcome\",\"probe.random_common_cause\"],\"reference_dispositions\":[{\"disposition\":\"resolved_metadata\",\"id\":\"10.1097/00001648-200009000-00011\",\"requested_as\":\"Robins, Hernan & Brumback (2000), Marginal structural models and causal inference in epidemiology\"},{\"disposition\":\"resolved_metadata\",\"id\":\"10.1093/aje/kwn164\",\"requested_as\":\"Cole & Hernan (2008), Constructing inverse probability weights for marginal structural models\"}],\"reference_ids\":[\"10.1097/00001648-200009000-00011\",\"10.1093/aje/kwn164\"],\"references\":[\"Robins, Hernan & Brumback (2000), Marginal structural models and causal inference in epidemiology\",\"Cole & Hernan (2008), Constructing inverse probability weights for marginal structural models\"],\"roles_forbidden\":[\"forbidden\"],\"roles_optional\":[\"strata\",\"weight\",\"cluster\",\"censoring\"],\"roles_required\":[\"unit\",\"time\",\"treatment\",\"outcome\",\"confounders\"],\"source_path\":\"engines/python/capy_py/longitudinal.py\",\"source_sha256\":\"49a2064131adc4f82db0de13c3127729b10c3407c6c933d1afed97a11dce4e83\",\"status\":\"recommended\",\"title\":\"Marginal structural model (time-varying weights)\",\"what_can_go_wrong\":\"Weights are a product over the whole history, so they degenerate as follow-up lengthens; a handful of people end up carrying the estimate while the interval stays narrow.\",\"why_recommended\":\"The standard answer to time-varying confounding, and the one whose failure mode is visible: the weight histogram and the effective sample size tell you when the data cannot support the comparison.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:00c8a41fa9c0e3222dec8aef\",\"object_id\":\"long.ltmle\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body incl