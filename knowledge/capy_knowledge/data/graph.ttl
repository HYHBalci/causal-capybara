<urn:capy:estimand%3Asurvival_difference> a capy:estimand ; skos:prefLabel "Survival probability difference" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"estimand:survival_difference\",\"citation_ids\":[],\"citations\":[],\"content\":{\"acronym\":\"S(1) - S(0)\",\"common_mistake\":\"Relabelling an unadjusted group difference or a hazard ratio as a marginal causal survival probability effect.\",\"designs\":[{\"explain_key\":\"design.survival\",\"id\":\"survival\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Follow people from a common time zero; some leave follow-up before the event is observed.\",\"title\":\"Time until an event\"}],\"explain_key\":\"estimand.survival_difference\",\"gaps\":[\"no plain-language description has been written yet\"],\"id\":\"survival_difference\",\"in_more_depth\":\"A probability contrast at an explicit horizon. Standardized S^1(tau) minus S^0(tau) targets a marginal counterfactual contrast under identification, censoring and model conditions; raw Kaplan–Meier compares observed groups.\",\"kind\":\"estimand\",\"methods\":[{\"explain_key\":\"method.survival.aft\",\"id\":\"survival.aft\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Fit a right-censored log-normal/Weibull AFT model; standardize survival/RMST over baseline covariates under explicit causal assumptions, or report a conditional time factor.\",\"title\":\"Censored AFT regression and causal standardization\"},{\"explain_key\":\"method.survival.kaplan_meier\",\"id\":\"survival.kaplan_meier\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Compare observed group event-free probabilities at an explicit common horizon; this is an unadjusted association.\",\"title\":\"Unadjusted Kaplan–Meier survival contrast\"}],\"notation\":null,\"one_liner\":\"At a chosen horizon, how do event-free probabilities differ between baseline treatments?\",\"plain_language\":\"At a chosen horizon, how do event-free probabilities differ between baseline treatments?\",\"profile\":\"beginner\",\"references\":[],\"see_also\":[{\"explain_key\":\"design.survival\",\"id\":\"survival\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Follow people from a common time zero; some leave follow-up before the event is observed.\",\"title\":\"Time until an event\"},{\"explain_key\":\"method.survival.aft\",\"id\":\"survival.aft\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Fit a right-censored log-normal/Weibull AFT model; standardize survival/RMST over baseline covariates under explicit causal assumptions, or report a conditional time factor.\",\"title\":\"Censored AFT regression and causal standardization\"},{\"explain_key\":\"method.survival.kaplan_meier\",\"id\":\"survival.kaplan_meier\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Compare observed group event-free probabilities at an explicit common horizon; this is an unadjusted association.\",\"title\":\"Unadjusted Kaplan–Meier survival contrast\"}],\"tags\":[\"Time until an event\"],\"title\":\"Survival probability difference\"},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet\"],\"id\":\"estimand:survival_difference\",\"kind\":\"estimand\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"survival_difference\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"At a chosen horizon, how do event-free probabilities differ between baseline treatments?\",\"title\":\"Survival probability difference\"}" .
<urn:capy:estimand%3Atime_ratio> a capy:estimand ; skos:prefLabel "Conditional AFT time ratio" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"estimand:time_ratio\",\"citation_ids\":[],\"citations\":[],\"content\":{\"acronym\":\"exp(beta)\",\"common_mistake\":\"Calling a time ratio a hazard ratio, marginal survival difference, or structural causal AFT estimate.\",\"designs\":[{\"explain_key\":\"design.survival\",\"id\":\"survival\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Follow people from a common time zero; some leave follow-up before the event is observed.\",\"title\":\"Time until an event\"}],\"explain_key\":\"estimand.time_ratio\",\"gaps\":[\"no plain-language description has been written yet\"],\"id\":\"time_ratio\",\"in_more_depth\":\"With a common-scale log-time model and no treatment interactions, exp(beta_treatment) is a conditional factor for event-time quantiles. It is a model association unless a causal interpretation is justified separately.\",\"kind\":\"estimand\",\"methods\":[{\"explain_key\":\"method.survival.aft\",\"id\":\"survival.aft\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Fit a right-censored log-normal/Weibull AFT model; standardize survival/RMST over baseline covariates under explicit causal assumptions, or report a conditional time factor.\",\"title\":\"Censored AFT regression and causal standardization\"}],\"notation\":null,\"one_liner\":\"Conditional on baseline covariates, what common factor stretches event times in the AFT model?\",\"plain_language\":\"Conditional on baseline covariates, what common factor stretches event times in the AFT model?\",\"profile\":\"standard\",\"references\":[],\"see_also\":[{\"explain_key\":\"design.survival\",\"id\":\"survival\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Follow people from a common time zero; some leave follow-up before the event is observed.\",\"title\":\"Time until an event\"},{\"explain_key\":\"method.survival.aft\",\"id\":\"survival.aft\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Fit a right-censored log-normal/Weibull AFT model; standardize survival/RMST over baseline covariates under explicit causal assumptions, or report a conditional time factor.\",\"title\":\"Censored AFT regression and causal standardization\"}],\"tags\":[\"Time until an event\"],\"title\":\"Conditional AFT time ratio\"},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet\"],\"id\":\"estimand:time_ratio\",\"kind\":\"estimand\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"time_ratio\",\"relations\":[],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Conditional on baseline covariates, what common factor stretches event times in the AFT model?\",\"title\":\"Conditional AFT time ratio\"}" .
<urn:capy:evidence%3Aadjustment-design> a capy:evidencelocator ; skos:prefLabel "Adjustment depends on causal role and timing — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Aadjustment-design> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/adjustment-design.md\",\"id\":\"evidence:adjustment-design\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":629,\"exact_text\":\"A variable can predict outcomes and still be inappropriate for adjustment. Conditioning on a mediator can remove part of a total effect; conditioning on a collider can open a noncausal path. Choose the adjustment set using the stated causal graph and pre-treatment measurement timing. Complete-case restrictions and missing-data procedures also need explicit assumptions and may change which population the comparison represents.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":200},\"provenance\":[\"source:note:adjustment-design\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Variable roles and observation selection are justified for the intended contrast.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:c8684b0ccb7b6abcb26c2a61\",\"object_id\":\"claim:adjustment-design\",\"predicate\":\"supports\",\"provenance\":[\"source:note:adjustment-design\",\"source:ontology:pearl2009\",\"source:ontology:imai2010\",\"bang2005\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:pearl2009\",\"source:ontology:imai2010\",\"bang2005\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped original methodological explanation; no whole-method or study audit is implied.\",\"subject_id\":\"evidence:adjustment-design\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:pearl2009\",\"source:ontology:imai2010\",\"bang2005\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:adjustment-design\",\"source_version\":\"sha256:f39661642368d81675f7c3bc8e73b2466a81a99cc6be7d9e93e376dc0f9c15b8\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"Adjustment depends on causal role and timing — original evidence note\"}" .
<urn:capy:evidence%3Aaft-heterogeneity> a capy:evidencelocator ; skos:prefLabel "AFT interactions and marginal effect modification are different tests — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Aaft-heterogeneity> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/aft-heterogeneity.md\",\"id\":\"evidence:aft-heterogeneity\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":825,\"exact_text\":\"For log T = alpha + beta A + gamma Z + delta A Z + other baseline terms + sigma epsilon with a shared residual distribution, the conditional time factor at Z=z is exp(beta + delta z). Retain modifier main effects and define the reference level. A pooled fit can standardize both treatment predictions over each subgroup target population. Test equality of those survival or RMST differences using their joint uncertainty if that is the question: a zero delta is not the null of equal marginal additive effects. Refit the censored model and recompute standardization in each model-bootstrap replicate.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":225},\"provenance\":[\"source:note:aft-heterogeneity\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Common residual scale and distribution, correct likelihood and appropriate observation conditions.\",\"Treatment and modifier coding and target subgroup population are explicit.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:52b2b4d9e0884c2981ba2d59\",\"object_id\":\"claim:aft-heterogeneity\",\"predicate\":\"supports\",\"provenance\":[\"source:note:aft-heterogeneity\",\"source:ontology:r-survreg\",\"source:ontology:wei1992\",\"source:ontology:kent2020\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"subject_id\":\"evidence:aft-heterogeneity\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:aft-heterogeneity\",\"source_version\":\"sha256:03077dc006fc189195927d265161ec8177aacfded632887d36471692eb4d60c2\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"AFT interactions and marginal effect modification are different tests — original evidence note\"}" .
<urn:capy:evidence%3Aaft-time-ratio> a capy:evidencelocator ; skos:prefLabel "Ordinary AFT regression and structural failure-time models differ — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Aaft-time-ratio> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/aft-time-ratio.md\",\"id\":\"evidence:aft-time-ratio\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":736,\"exact_text\":\"A common-distribution AFT model relates log event time to covariates; exponentiating a treatment coefficient gives a conditional time factor under that specification. It is not automatically a causal parameter or a marginal RMST contrast. Declare the distribution, shape, scale and covariate parameterization, since software conventions differ. Structural failure-time and rank-preserving models encode separate counterfactual transformations and identifying conditions; an ordinary AFT fit does not implement them.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":221},\"provenance\":[\"source:note:aft-time-ratio\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Common-distribution AFT restrictions and any causal-identification argument are explicitly stated.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:e4392047774e23dfbd105d7a\",\"object_id\":\"claim:aft-time-ratio\",\"predicate\":\"supports\",\"provenance\":[\"source:note:aft-time-ratio\",\"source:ontology:wei1992\",\"source:ontology:r-survreg\",\"source:ontology:lifelines-aft\",\"source:ontology:robins1991\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:wei1992\",\"source:ontology:r-survreg\",\"source:ontology:lifelines-aft\",\"source:ontology:robins1991\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped original methodological explanation; no whole-method or study audit is implied.\",\"subject_id\":\"evidence:aft-time-ratio\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:wei1992\",\"source:ontology:r-survreg\",\"source:ontology:lifelines-aft\",\"source:ontology:robins1991\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:aft-time-ratio\",\"source_version\":\"sha256:5b93d018b32cc1fb4470c8cd8ad925f5de91ac13c29df4dc86502ba4de0c33d8\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"Ordinary AFT regression and structural failure-time models differ — original evidence note\"}" .
<urn:capy:evidence%3Aaipw-att-control-nuisance> a capy:evidencelocator ; skos:prefLabel "ATT control outcome nuisance m0 — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Aaipw> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/aipw.md\",\"id\":\"evidence:aipw-att-control-nuisance\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":2464,\"exact_text\":\"Let e(X)=P(T=1|X), p=P(T=1), and m0(X)=E[Y|T=0,X]. The ATT augmented score combines treated residuals Y-m0(X) with control residuals weighted by e(X)/(1-e(X)), divided by p. It needs the control outcome nuisance m0, not the treated outcome nuisance m1. The public engine fits both outcome models for shared code, but its ATT estimate uses m0 alone. This distinction matters when explaining the outcome-model branch of double robustness.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":2028},\"provenance\":[\"source:note:aipw\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Binary treatment and nonzero treated population probability.\",\"The described ATT score, not the ATE score.\",\"Relevant ATT identification and support assumptions.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:7499ba4b8b6179dd04f007f9\",\"object_id\":\"claim:aipw-att-control-nuisance\",\"predicate\":\"supports\",\"provenance\":[\"source:note:aipw\",\"chernozhukov2018\",\"bang2005\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/observational.py\",\"tests/python/test_observational.py\",\"https://arxiv.org/html/1608.00060v7\",\"https://doi.org/10.1111/j.1541-0420.2005.00377.x\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"subject_id\":\"evidence:aipw-att-control-nuisance\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/observational.py\",\"tests/python/test_observational.py\",\"https://arxiv.org/html/1608.00060v7\",\"https://doi.org/10.1111/j.1541-0420.2005.00377.x\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:aipw\",\"source_version\":\"sha256:a36af981272f30e0432a6adbcf536a7c663b149bda4af78313fe6db207725904\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"ATT control outcome nuisance m0 — original evidence note\"}" .
<urn:capy:evidence%3Aaipw-att-positivity> a capy:evidencelocator ; skos:prefLabel "ATT asymmetric positivity and treated support — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Aaipw> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/aipw.md\",\"id\":\"evidence:aipw-att-positivity\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":1990,\"exact_text\":\"ATT targets people who were treated. Identification therefore requires controls with the covariate profiles represented among treated people: P(T=0 | X=x) must be positive on treated support. A control-only stratum with P(T=1 | X=x)=0 does not itself violate ATT identification. Uniform bounds away from one, adequate effective control sample size, and moment restrictions may still be needed for stable estimation and inference. ATE generally needs both treatment arms throughout its target support.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":1490},\"provenance\":[\"source:note:aipw\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"ATT is the declared target.\",\"Untreated counterfactual outcomes are exchangeable conditional on the adjustment set.\",\"Controls have positive probability on treated support.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:890d5a30fc8f8649de339403\",\"object_id\":\"claim:aipw-att-positivity\",\"predicate\":\"supports\",\"provenance\":[\"source:note:aipw\",\"hernan2020\",\"chernozhukov2018\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/observational.py\",\"tests/python/test_observational.py\",\"https://miguelhernan.org/whatifbook\",\"https://arxiv.org/html/1608.00060v7\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"subject_id\":\"evidence:aipw-att-positivity\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/observational.py\",\"tests/python/test_observational.py\",\"https://miguelhernan.org/whatifbook\",\"https://arxiv.org/html/1608.00060v7\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:aipw\",\"source_version\":\"sha256:a36af981272f30e0432a6adbcf536a7c663b149bda4af78313fe6db207725904\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"ATT asymmetric positivity and treated support — original evidence note\"}" .
<urn:capy:evidence%3Aaipw-clipping> a capy:evidencelocator ; skos:prefLabel "Finite propensity clipping, weighting and consistency — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Aaipw> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/aipw.md\",\"id\":\"evidence:aipw-clipping\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":3127,\"exact_text\":\"Fixed propensity clipping changes the weighting calculation wherever it binds. It does not manufacture missing controls or generally preserve the correct-propensity branch of consistency when the outcome nuisance is misspecified. For ATT, with true propensity e, clipped limit c, and limiting control regression g0, the score bias is E[((e-c)/(1-c))*(m0-g0)]/p. A correct m0 makes this term zero; a correct raw e does not when c differs from e. If clipping never binds asymptotically, that particular objection disappears. Clipping is distinct from trimming units, which changes the analyzed population.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":2524},\"provenance\":[\"source:note:aipw\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Clipping binds in the limiting propensity function.\",\"The outcome nuisance is misspecified for the propensity-only failure example.\",\"The bias expression describes the stated ATT score.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:d3fd431202fd0c5858cfa428\",\"object_id\":\"claim:aipw-clipping\",\"predicate\":\"supports\",\"provenance\":[\"source:note:aipw\",\"bang2005\",\"chernozhukov2018\",\"10.1093/aje/kwn164\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/observational.py\",\"tests/python/test_observational.py\",\"https://doi.org/10.1111/j.1541-0420.2005.00377.x\",\"https://arxiv.org/html/1608.00060v7\",\"https://pmc.ncbi.nlm.nih.gov/articles/PMC2732954/\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"subject_id\":\"evidence:aipw-clipping\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/observational.py\",\"tests/python/test_observational.py\",\"https://doi.org/10.1111/j.1541-0420.2005.00377.x\",\"https://arxiv.org/html/1608.00060v7\",\"https://pmc.ncbi.nlm.nih.gov/articles/PMC2732954/\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:aipw\",\"source_version\":\"sha256:a36af981272f30e0432a6adbcf536a7c663b149bda4af78313fe6db207725904\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"Finite propensity clipping, weighting and consistency — original evidence note\"}" .
<urn:capy:evidence%3Aaipw-cross-fitting-inference> a capy:evidencelocator ; skos:prefLabel "Cross-fitting and inference conditions — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Aaipw> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/aipw.md\",\"id\":\"evidence:aipw-cross-fitting-inference\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":3775,\"exact_text\":\"Cross-fitting trains nuisance models on one fold and evaluates scores on another to reduce reuse and overfitting. Valid influence-function inference also requires identification, support, moments, suitable sampling or dependence assumptions, and nuisance estimation conditions. A common sufficient condition is that both nuisance errors converge and their product is o(n^(-1/2)). Cross-fitting alone does not guarantee confidence-interval coverage, and double-robust consistency alone does not establish double-robust inference. Clustered or serial data require an appropriate dependence-aware analysis.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":3172},\"provenance\":[\"source:note:aipw\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Identification and support hold.\",\"Inference respects the sampling or dependence structure.\",\"Suitable nuisance convergence and regularity hold; a standard sufficient error-product rate is o(n^(-1/2)).\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:237cc13cb737244d364013e5\",\"object_id\":\"claim:aipw-cross-fitting-inference\",\"predicate\":\"supports\",\"provenance\":[\"source:note:aipw\",\"chernozhukov2018\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/observational.py\",\"tests/python/test_observational.py\",\"https://arxiv.org/html/1608.00060v7\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"subject_id\":\"evidence:aipw-cross-fitting-inference\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/observational.py\",\"tests/python/test_observational.py\",\"https://arxiv.org/html/1608.00060v7\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:aipw\",\"source_version\":\"sha256:a36af981272f30e0432a6adbcf536a7c663b149bda4af78313fe6db207725904\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"Cross-fitting and inference conditions — original evidence note\"}" .
<urn:capy:evidence%3Aaipw-diagnostics> a capy:evidencelocator ; skos:prefLabel "AIPW diagnostics do not prove exchangeability — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Aaipw> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/aipw.md\",\"id\":\"evidence:aipw-diagnostics\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":4339,\"exact_text\":\"Overlap plots, balance statistics, effective sample size, weight concentration, clipping counts, held-out nuisance prediction errors, and fold stability describe weaknesses in the fitted analysis. They cannot verify absence of unmeasured confounding or identify a causal effect by themselves. Good balance on measured covariates is useful evidence about adjustment, not a certificate of conditional exchangeability. Poor overlap should trigger target-population and design review as well as sensitivity analysis.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":3827},\"provenance\":[\"source:note:aipw\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Diagnostics concern the fitted analysis and measured variables.\",\"Scientific identification assumptions are assessed separately.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:61e88829d0bcbffbf3c193f0\",\"object_id\":\"claim:aipw-diagnostics\",\"predicate\":\"supports\",\"provenance\":[\"source:note:aipw\",\"hernan2020\",\"10.1093/aje/kwn164\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/observational.py\",\"tests/python/test_observational.py\",\"https://miguelhernan.org/whatifbook\",\"https://pmc.ncbi.nlm.nih.gov/articles/PMC2732954/\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"subject_id\":\"evidence:aipw-diagnostics\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/observational.py\",\"tests/python/test_observational.py\",\"https://miguelhernan.org/whatifbook\",\"https://pmc.ncbi.nlm.nih.gov/articles/PMC2732954/\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:aipw\",\"source_version\":\"sha256:a36af981272f30e0432a6adbcf536a7c663b149bda4af78313fe6db207725904\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"AIPW diagnostics do not prove exchangeability — original evidence note\"}" .
<urn:capy:evidence%3Aaipw-double-robustness> a capy:evidencelocator ; skos:prefLabel "AIPW double robustness and its scope — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Aaipw> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/aipw.md\",\"id\":\"evidence:aipw-double-robustness\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":1438,\"exact_text\":\"For an identified target, an unmodified AIPW score is consistent under suitable regularity when either the propensity nuisance or the relevant outcome nuisance is consistently estimated. ATE uses both outcome means; ATT uses the control outcome mean. This consistency statement assumes the score's weights remain valid. It does not guarantee finite-sample accuracy, valid standard errors under one misspecified nuisance, or robustness when both nuisances are wrong.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":973},\"provenance\":[\"source:note:aipw\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"The target is identified.\",\"Propensity or relevant outcome nuisance converges appropriately.\",\"Clipping must not invalidate the claimed propensity branch; regularity and integrability remain necessary.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:cc21e2229435e05ba197b2ce\",\"object_id\":\"claim:aipw-double-robustness\",\"predicate\":\"supports\",\"provenance\":[\"source:note:aipw\",\"bang2005\",\"chernozhukov2018\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/observational.py\",\"tests/python/test_observational.py\",\"https://doi.org/10.1111/j.1541-0420.2005.00377.x\",\"https://arxiv.org/html/1608.00060v7\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"subject_id\":\"evidence:aipw-double-robustness\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/observational.py\",\"tests/python/test_observational.py\",\"https://doi.org/10.1111/j.1541-0420.2005.00377.x\",\"https://arxiv.org/html/1608.00060v7\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:aipw\",\"source_version\":\"sha256:a36af981272f30e0432a6adbcf536a7c663b149bda4af78313fe6db207725904\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"AIPW double robustness and its scope — original evidence note\"}" .
<urn:capy:evidence%3Aaipw-identification> a capy:evidencelocator ; skos:prefLabel "AIPW identification versus estimation — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Aaipw> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/aipw.md\",\"id\":\"evidence:aipw-identification\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":930,\"exact_text\":\"AIPW is an estimation strategy, not an identification argument. A causal ATE requires a well-defined intervention, consistency, appropriate noninterference, conditional exchangeability given pre-treatment covariates, and overlap in the target population. For ATT, the required counterfactual comparison concerns untreated potential outcomes among treated units. Double robustness does not remove unmeasured confounding or justify adjustment for a post-treatment variable.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":459},\"provenance\":[\"source:note:aipw\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Well-defined intervention, consistency and appropriate noninterference.\",\"Conditional exchangeability of the potential outcomes needed for the target.\",\"Target-population positivity and pre-treatment adjustment covariates.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:7856a4e78dc46632309a5c14\",\"object_id\":\"claim:aipw-identification\",\"predicate\":\"supports\",\"provenance\":[\"source:note:aipw\",\"hernan2020\",\"bang2005\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/observational.py\",\"tests/python/test_observational.py\",\"https://miguelhernan.org/whatifbook\",\"https://doi.org/10.1111/j.1541-0420.2005.00377.x\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"subject_id\":\"evidence:aipw-identification\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/observational.py\",\"tests/python/test_observational.py\",\"https://miguelhernan.org/whatifbook\",\"https://doi.org/10.1111/j.1541-0420.2005.00377.x\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:aipw\",\"source_version\":\"sha256:a36af981272f30e0432a6adbcf536a7c663b149bda4af78313fe6db207725904\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"AIPW identification versus estimation — original evidence note\"}" .
<urn:capy:evidence%3Aaudit-reproducibility> a capy:evidencelocator ; skos:prefLabel "Implementation audits require traceable evidence — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Aaudit-reproducibility> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/audit-reproducibility.md\",\"id\":\"evidence:audit-reproducibility\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":729,\"exact_text\":\"An implementation audit records the authorized revision, code location and observed behavior for each finding, explains the threatened estimand or assumption, and proposes a correction and verification method. Preserve exact data transformations, input hashes, options, randomness and dependency versions. Independent numerical examples, full uncertainty refits and adversarial inputs assess computation. Agreement with a reference calculation or passing software tests does not establish causal identification for the study.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":204},\"provenance\":[\"source:note:audit-reproducibility\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"File inspection and execution are authorized separately; evidence is actually observed.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:14499e31f176a5ea4c5977d7\",\"object_id\":\"claim:audit-reproducibility\",\"predicate\":\"supports\",\"provenance\":[\"source:note:audit-reproducibility\",\"source:ontology:wilson2017\",\"source:ontology:sandve2013\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:wilson2017\",\"source:ontology:sandve2013\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped original methodological explanation; no whole-method or study audit is implied.\",\"subject_id\":\"evidence:audit-reproducibility\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:wilson2017\",\"source:ontology:sandve2013\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:audit-reproducibility\",\"source_version\":\"sha256:69887516c848ab9c984ba6f4221b02c5bfc94360db29bfedfa4da85cda1a0bdb\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"Implementation audits require traceable evidence — original evidence note\"}" .
<urn:capy:evidence%3Acate-heterogeneity-evaluation> a capy:evidencelocator ; skos:prefLabel "CATE projection, calibration and GATES require honest evaluation — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Acate-heterogeneity-evaluation> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/cate-heterogeneity-evaluation.md\",\"id\":\"evidence:cate-heterogeneity-evaluation\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":819,\"exact_text\":\"A CATE is a conditional average contrast, not an observed individual treatment effect. BLP summarizes it through specified features, calibration evaluates learned predictions, and GATES summarizes groups induced by a learned score. Keep their estimands and nulls distinct. Formal guarantees require the stated score construction, independence or sample-splitting and covariance procedure; plotting bins or regressing fitted predictions does not by itself implement the published estimator. Report simplifications of the local adapter and distinguish exploratory diagnostics from validated inference.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":220},\"provenance\":[\"source:note:cate-heterogeneity-evaluation\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Learning/evaluation separation, suitable target scores and overlap.\",\"Evidence matches the implemented score and inference, not only the method label.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:36392c66a2c34523829b3ca4\",\"object_id\":\"claim:cate-heterogeneity-evaluation\",\"predicate\":\"supports\",\"provenance\":[\"source:note:cate-heterogeneity-evaluation\",\"source:ontology:genericml\",\"source:ontology:grf-blp\",\"source:ontology:grf-calibration\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"subject_id\":\"evidence:cate-heterogeneity-evaluation\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:cate-heterogeneity-evaluation\",\"source_version\":\"sha256:2b3fbf3e2558e1eb7e8168519be48c34ea38531f8dd1ab9939ceb6cf734e7052\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"CATE projection, calibration and GATES require honest evaluation — original evidence note\"}" .
<urn:capy:evidence%3Acategorical-outcome-interaction> a capy:evidencelocator ; skos:prefLabel "Categorical-outcome probability heterogeneity — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Acategorical-outcome-interaction> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/categorical-outcome-interaction.md\",\"id\":\"evidence:categorical-outcome-interaction\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":468,\"exact_text\":\"A multinomial model represents a probability for each outcome category. Nominal labels are not numerical scores; applying this model to ordered labels does not impose proportional odds or estimate a common ordinal shift. Category probabilities sum to one, so joint tests must account for their dependent contrasts.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":154},\"provenance\":[\"source:note:categorical-outcome-interaction\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Sampling covariance and prediction target must match the declared null.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:6468759b97d9d0588c4b1ff1\",\"object_id\":\"claim:categorical-outcome-interaction\",\"predicate\":\"supports\",\"provenance\":[\"source:note:categorical-outcome-interaction\",\"source:ontology:statsmodels-mnlogit\",\"source:ontology:statsmodels-wald\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"subject_id\":\"evidence:categorical-outcome-interaction\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:categorical-outcome-interaction\",\"source_version\":\"sha256:6586db470501e18063d6ebf057029e375babe2675f2debaf29b5805b9a65682e\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"Categorical-outcome probability heterogeneity — original evidence note\"}" .
<urn:capy:evidence%3Acausal-framing> a capy:evidencelocator ; skos:prefLabel "Causal framing requires an identification argument — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Acausal-framing> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/causal-framing.md\",\"id\":\"evidence:causal-framing\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":664,\"exact_text\":\"A regression coefficient, balanced covariates, a fitted graph or an accurately predicted outcome is not by itself an identified causal effect. Name the intervention, target population, endpoint and contrast, then state which design and assumptions connect them to an observed-data functional. When that argument is unavailable, report an association or model prediction. Computational verification and source links do not establish a study’s exchangeability.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":206},\"provenance\":[\"source:note:causal-framing\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"A defensible design and identification argument are needed for causal interpretation.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:b561688e490fa0382b497a76\",\"object_id\":\"claim:causal-framing\",\"predicate\":\"supports\",\"provenance\":[\"source:note:causal-framing\",\"source:ontology:pearl2009\",\"source:ontology:ich2019\",\"source:ontology:rubin2008\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:pearl2009\",\"source:ontology:ich2019\",\"source:ontology:rubin2008\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped original methodological explanation; no whole-method or study audit is implied.\",\"subject_id\":\"evidence:causal-framing\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:pearl2009\",\"source:ontology:ich2019\",\"source:ontology:rubin2008\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:causal-framing\",\"source_version\":\"sha256:5110631f0189fb97e2facd4e0e962b322ddfa10053916c81a5b501a250405a19\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"Causal framing requires an identification argument — original evidence note\"}" .
<urn:capy:evidence%3Acompeting-target> a capy:evidencelocator ; skos:prefLabel "Competing-event handling changes the causal question — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Acompeting-target> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/competing-target.md\",\"id\":\"evidence:competing-target\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":710,\"exact_text\":\"A competing event prevents the focal event. A contrast of focal-event cumulative incidence with competitors present differs from a hypothetical contrast eliminating those events. Treating a competing death as ordinary censoring can silently change the question. Separable-effect targets require meaningful treatment-component interventions and additional identification conditions. A one-event adapter must reject incompatible event coding instead of presenting an unsupported competing-event analysis.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":208},\"provenance\":[\"source:note:competing-target\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Competing-event strategy and its distinct identifying conditions are explicit.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:b773bea585c4d3f30069ee63\",\"object_id\":\"claim:competing-target\",\"predicate\":\"supports\",\"provenance\":[\"source:note:competing-target\",\"source:ontology:young2019\",\"source:ontology:stensrud2020\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:young2019\",\"source:ontology:stensrud2020\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped original methodological explanation; no whole-method or study audit is implied.\",\"subject_id\":\"evidence:competing-target\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:young2019\",\"source:ontology:stensrud2020\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:competing-target\",\"source_version\":\"sha256:65a2eefd9142a96bcb868bfc415833062a16acfcc3609496ea4edeb89597df73\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"Competing-event handling changes the causal question — original evidence note\"}" .
<urn:capy:evidence%3Adid-aggregation> a capy:evidencelocator ; skos:prefLabel "DiD aggregation weights and event-time composition — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Adid> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/did.md\",\"id\":\"evidence:did-aggregation\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":3903,\"exact_text\":\"An overall or event-time DiD estimate is defined by its eligible cohort-time cells and aggregation weights. At longer exposure durations, later cohorts may no longer contribute, so changes along a dynamic curve can reflect different cohort composition as well as effect dynamics. Holding the cohort set fixed across an event window improves that comparison but changes the target population and can reduce precision. Report the contributing cohorts, exposure window, weights, and omitted cells.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":3409},\"provenance\":[\"source:note:did\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Eligible cohort-time cells are declared.\",\"Aggregation weights and exposure window are reported.\",\"Any fixed-cohort restriction is reflected in the target population.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:c9b7c945aad7fecde96f29aa\",\"object_id\":\"claim:did-aggregation\",\"predicate\":\"supports\",\"provenance\":[\"source:note:did\",\"callaway2021\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/did_modern.py\",\"tests/python/test_did_modern.py\",\"https://arxiv.org/html/1803.09015v4\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"subject_id\":\"evidence:did-aggregation\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/did_modern.py\",\"tests/python/test_did_modern.py\",\"https://arxiv.org/html/1803.09015v4\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:did\",\"source_version\":\"sha256:99a5140c973c3731cf9f69e4ed044b7bf233ff9696081a9f5663f0e89a66ef67\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"DiD aggregation weights and event-time composition — original evidence note\"}" .
<urn:capy:evidence%3Adid-composition> a capy:evidencelocator ; skos:prefLabel "DiD attrition and changing panel composition — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Adid> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/did.md\",\"id\":\"evidence:did-composition\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":3352,\"exact_text\":\"Changing panel composition can move observed cohort means even without a treatment effect. Attrition, entry, missing outcomes, and changes in the units contributing to a comparison need explicit assessment. Requiring observations in both comparison periods changes the contributing sample and may change its interpretation; a balanced observed panel does not prove ignorable selection. The public engine reports panel balance and builds cohort-time blocks from units observed in both periods. Population and missing-data assumptions remain separate scientific judgments.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":2782},\"provenance\":[\"source:note:did\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Target units and missing-data scope are declared.\",\"Changes in the units contributing to each comparison are inspected.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:e21e07bee14120c189d1467c\",\"object_id\":\"claim:did-composition\",\"predicate\":\"supports\",\"provenance\":[\"source:note:did\",\"callaway2021\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/did_modern.py\",\"tests/python/test_did_modern.py\",\"https://arxiv.org/html/1803.09015v4\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"subject_id\":\"evidence:did-composition\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/did_modern.py\",\"tests/python/test_did_modern.py\",\"https://arxiv.org/html/1803.09015v4\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:did\",\"source_version\":\"sha256:99a5140c973c3731cf9f69e4ed044b7bf233ff9696081a9f5663f0e89a66ef67\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"DiD attrition and changing panel composition — original evidence note\"}" .
<urn:capy:evidence%3Adid-group-time-att> a capy:evidencelocator ; skos:prefLabel "Staggered DiD cohort-time ATT — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Adid> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/did.md\",\"id\":\"evidence:did-group-time-att\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":946,\"exact_text\":\"In staggered adoption, ATT(g,t) is the average effect at calendar time t for units first treated in cohort g. Callaway-Sant'Anna estimates eligible cohort-time comparisons using never-treated or not-yet-treated controls under the chosen identification conditions. These cells are distinct from an overall ATT, a cohort average, or a dynamic event-time average. The public engine records estimable cells and reports skipped cells instead of filling unsupported comparisons.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":474},\"provenance\":[\"source:note:did\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Absorbing treatment adoption.\",\"Chosen control-group and parallel-trends assumptions.\",\"Suitable baseline, support and no-anticipation or declared anticipation conditions.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:77f0332c467c0c5ac8bdf699\",\"object_id\":\"claim:did-group-time-att\",\"predicate\":\"supports\",\"provenance\":[\"source:note:did\",\"callaway2021\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/did_modern.py\",\"tests/python/test_did_modern.py\",\"https://arxiv.org/html/1803.09015v4\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"subject_id\":\"evidence:did-group-time-att\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/did_modern.py\",\"tests/python/test_did_modern.py\",\"https://arxiv.org/html/1803.09015v4\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:did\",\"source_version\":\"sha256:99a5140c973c3731cf9f69e4ed044b7bf233ff9696081a9f5663f0e89a66ef67\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"Staggered DiD cohort-time ATT — original evidence note\"}" .
<urn:capy:evidence%3Adid-no-anticipation> a capy:evidencelocator ; skos:prefLabel "DiD no anticipation and control eligibility — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Adid> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/did.md\",\"id\":\"evidence:did-no-anticipation\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":2145,\"exact_text\":\"No anticipation means outcomes do not respond to a future treatment before the assigned adoption date. If behavior changes earlier, a declared anticipation window and earlier baseline or revised control eligibility may be necessary. A not-yet-treated unit is a usable control only while it remains unaffected over the comparison periods. A quiet pre-adoption plot does not prove no anticipation, and the public engine's ordinary adoption-date implementation does not automatically implement every anticipation-window design.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":1621},\"provenance\":[\"source:note:did\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"The adoption date and intervention are well defined.\",\"Controls remain unaffected over the comparison periods.\",\"Any anticipation horizon is declared and implemented.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:8b4b22c15bb745695464944b\",\"object_id\":\"claim:did-no-anticipation\",\"predicate\":\"supports\",\"provenance\":[\"source:note:did\",\"callaway2021\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/did_modern.py\",\"tests/python/test_did_modern.py\",\"https://arxiv.org/html/1803.09015v4\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"subject_id\":\"evidence:did-no-anticipation\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/did_modern.py\",\"tests/python/test_did_modern.py\",\"https://arxiv.org/html/1803.09015v4\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:did\",\"source_version\":\"sha256:99a5140c973c3731cf9f69e4ed044b7bf233ff9696081a9f5663f0e89a66ef67\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"DiD no anticipation and control eligibility — original evidence note\"}" .
<urn:capy:evidence%3Adid-parallel-trends> a capy:evidencelocator ; skos:prefLabel "DiD parallel trends and pretrend tests — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Adid> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/did.md\",\"id\":\"evidence:did-parallel-trends\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":2731,\"exact_text\":\"Parallel trends restricts changes in untreated potential outcomes for a treated cohort and the eligible comparison group, possibly conditional on pre-treatment covariates. It concerns the missing counterfactual trend after adoption, not equality of observed outcome levels. Pretrend evidence can challenge the assumption, but a test that fails to reject cannot prove it; low power and selection after pretesting remain concerns. Heterogeneous-effect contamination in a conventional TWFE event study can further complicate interpreting leads.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":2190},\"provenance\":[\"source:note:did\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Eligible comparison group and declared outcome scale.\",\"Conditional or unconditional trends restriction matches the estimator.\",\"Pre-treatment covariates and no-anticipation policy are explicit.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:43adec65ec672af45dc22af4\",\"object_id\":\"claim:did-parallel-trends\",\"predicate\":\"supports\",\"provenance\":[\"source:note:did\",\"callaway2021\",\"sun2021\",\"roth2023\",\"10.1257/aeri.20210236\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/did_modern.py\",\"tests/python/test_did_modern.py\",\"https://arxiv.org/html/1803.09015v4\",\"https://arxiv.org/html/1804.05785v2\",\"https://doi.org/10.1016/j.jeconom.2023.03.008\",\"https://www.aeaweb.org/articles?id=10.1257%2Faeri.20210236\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"subject_id\":\"evidence:did-parallel-trends\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/did_modern.py\",\"tests/python/test_did_modern.py\",\"https://arxiv.org/html/1803.09015v4\",\"https://arxiv.org/html/1804.05785v2\",\"https://doi.org/10.1016/j.jeconom.2023.03.008\",\"https://www.aeaweb.org/articles?id=10.1257%2Faeri.20210236\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:did\",\"source_version\":\"sha256:99a5140c973c3731cf9f69e4ed044b7bf233ff9696081a9f5663f0e89a66ef67\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"DiD parallel trends and pretrend tests — original evidence note\"}" .
<urn:capy:evidence%3Adid-support> a capy:evidencelocator ; skos:prefLabel "DiD comparison support and omitted cells — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Adid> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/did.md\",\"id\":\"evidence:did-support\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":4483,\"exact_text\":\"A cohort-time effect requires an admissible untreated comparison and the relevant baseline and outcome observations; conditional adjustment also requires overlap. If no comparison survives, the effect is not supplied by choosing a different label or by extrapolating an empty cell. The public engine excludes ineligible or unestimable cells, discloses skipped cells, and reports when a never-treated control choice falls back to not-yet-treated controls. Each resulting aggregate must be interpreted for the cells actually supported.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":3950},\"provenance\":[\"source:note:did\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Comparison units are unaffected over relevant periods.\",\"Baseline and target outcomes are observed for the chosen comparison.\",\"Conditional adjustment has relevant overlap.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:2407ae39a27a9c300d816326\",\"object_id\":\"claim:did-support\",\"predicate\":\"supports\",\"provenance\":[\"source:note:did\",\"callaway2021\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/did_modern.py\",\"tests/python/test_did_modern.py\",\"https://arxiv.org/html/1803.09015v4\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"subject_id\":\"evidence:did-support\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/did_modern.py\",\"tests/python/test_did_modern.py\",\"https://arxiv.org/html/1803.09015v4\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:did\",\"source_version\":\"sha256:99a5140c973c3731cf9f69e4ed044b7bf233ff9696081a9f5663f0e89a66ef67\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"DiD comparison support and omitted cells — original evidence note\"}" .
<urn:capy:evidence%3Adid-twfe-heterogeneity> a capy:evidencelocator ; skos:prefLabel "TWFE heterogeneity and already-treated controls — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Adid> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/did.md\",\"id\":\"evidence:did-twfe-heterogeneity\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":1571,\"exact_text\":\"With staggered adoption, a two-way fixed-effects regression can compare later-treated units with units already treated. Changes in those controls may include evolving treatment effects. Under heterogeneous or dynamic effects, its coefficient need not equal the desired treated-population average. Conventional lead-lag event studies can also mix effects from other relative periods, producing misleading apparent pretrends. TWFE is not universally invalid, but its causal interpretation needs restrictions on effects and comparisons beyond merely including fixed effects.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":1000},\"provenance\":[\"source:note:did\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Staggered adoption with the described two-way fixed-effects comparisons.\",\"Heterogeneous or time-varying treatment effects can affect interpretation.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:d28e5c8a75317cd78f99315f\",\"object_id\":\"claim:did-twfe-heterogeneity\",\"predicate\":\"supports\",\"provenance\":[\"source:note:did\",\"bacon2021\",\"sun2021\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/did_modern.py\",\"tests/python/test_did_modern.py\",\"https://doi.org/10.1016/j.jeconom.2021.03.014\",\"https://arxiv.org/html/1804.05785v2\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"subject_id\":\"evidence:did-twfe-heterogeneity\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/did_modern.py\",\"tests/python/test_did_modern.py\",\"https://doi.org/10.1016/j.jeconom.2021.03.014\",\"https://arxiv.org/html/1804.05785v2\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:did\",\"source_version\":\"sha256:99a5140c973c3731cf9f69e4ed044b7bf233ff9696081a9f5663f0e89a66ef67\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"TWFE heterogeneity and already-treated controls — original evidence note\"}" .
<urn:capy:evidence%3Afixed-profile-inference> a capy:evidencelocator ; skos:prefLabel "Fixed-profile standardization inference — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Afixed-profile-inference> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/fixed-profile-inference.md\",\"id\":\"evidence:fixed-profile-inference\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":526,\"exact_text\":\"A delta-method contrast based on fitted-parameter covariance conditions on the empirical profiles used for standardization. Inference for a superpopulation target additionally needs the relevant uncertainty from estimating its covariate distribution. Explicitly distinguish subgroup-restricted averages from controlled comparisons setting a continuous modifier to chosen values.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":148},\"provenance\":[\"source:note:fixed-profile-inference\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Sampling covariance and prediction target must match the declared null.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:83dc12cd9357a90fe122eb6c\",\"object_id\":\"claim:fixed-profile-inference\",\"predicate\":\"supports\",\"provenance\":[\"source:note:fixed-profile-inference\",\"hernan2020\",\"source:ontology:statsmodels-wald\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"subject_id\":\"evidence:fixed-profile-inference\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:fixed-profile-inference\",\"source_version\":\"sha256:6508b2640ec76860f6b687248f3b3c3e24f040a92f2cab3d50ced01f8c184127\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"Fixed-profile standardization inference — original evidence note\"}" .
<urn:capy:evidence%3Aheterogeneity-direct> a capy:evidencelocator ; skos:prefLabel "Heterogeneity requires a direct comparison on a declared scale — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Aheterogeneity-direct> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/heterogeneity-direct.md\",\"id\":\"evidence:heterogeneity-direct\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":598,\"exact_text\":\"Compare subgroup treatment contrasts directly; do not compare their separate significance labels. A joint Wald test needs an estimable contrast vector and covariance of full rank. Its null is equality on the stated effect scale, for the stated population and horizon. Failure to reject is not an equivalence result, and rejecting the null does not establish causal identification.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":218},\"provenance\":[\"source:note:heterogeneity-direct\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Prespecified contrast and appropriate joint covariance.\",\"Causal interpretation additionally requires design-specific identification.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:676e97807dbb73b8eb9c9550\",\"object_id\":\"claim:heterogeneity-direct\",\"predicate\":\"supports\",\"provenance\":[\"source:note:heterogeneity-direct\",\"source:ontology:altman2003\",\"source:ontology:statsmodels-wald\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"subject_id\":\"evidence:heterogeneity-direct\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:heterogeneity-direct\",\"source_version\":\"sha256:98c311d545e512a9b65da5d557d4cf5f7f6ce54fff1702cd376006000249e14e\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"Heterogeneity requires a direct comparison on a declared scale — original evidence note\"}" .
<urn:capy:evidence%3Aheterogeneity-outcome-scales> a capy:evidencelocator ; skos:prefLabel "Outcome families require distinct interaction targets — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Aheterogeneity-outcome-scales> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/heterogeneity-outcome-scales.md\",\"id\":\"evidence:heterogeneity-outcome-scales\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":732,\"exact_text\":\"An identity-link interaction concerns a conditional mean difference, a logit interaction concerns conditional log odds ratios, and a log-link interaction concerns conditional mean ratios. Standardized risk or mean differences are different functionals and require contrasts of their own predictions and covariance. A count-rate model additionally defines exposure and an offset; compare predictions at a stated exposure. Robust standard errors cannot repair a wrong mean model, inadequate overlap or unmeasured confounding.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":209},\"provenance\":[\"source:note:heterogeneity-outcome-scales\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Outcome encoding, link, target covariate distribution and exposure are declared.\",\"Main effects and treatment interactions use a full-rank design.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:1a64f764b0d2bd32eff7470c\",\"object_id\":\"claim:heterogeneity-outcome-scales\",\"predicate\":\"supports\",\"provenance\":[\"source:note:heterogeneity-outcome-scales\",\"source:ontology:knol2012\",\"source:ontology:statsmodels-glm\",\"hernan2020\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"subject_id\":\"evidence:heterogeneity-outcome-scales\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:heterogeneity-outcome-scales\",\"source_version\":\"sha256:8260efa6d323be66afaba765956bb320ad777e996f2fdd76da552de9c3eca18a\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"Outcome families require distinct interaction targets — original evidence note\"}" .
<urn:capy:evidence%3Aheterogeneity-prespecification> a capy:evidencelocator ; skos:prefLabel "Subgroup discovery and confirmatory analysis have different evidence requirements — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Aheterogeneity-prespecification> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/heterogeneity-prespecification.md\",\"id\":\"evidence:heterogeneity-prespecification\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":730,\"exact_text\":\"Define baseline modifiers and the family of hypotheses before looking for outcome patterns. Report all attempted modifiers, scales and horizons, with a multiplicity strategy or explicit exploratory status. Preserve main effects when adding treatment interactions. Baseline timing and prespecification declarations are study assertions to audit, not facts verified by a checkbox. Rejecting one omnibus null neither adjusts pointwise subgroup intervals nor establishes every subgroup difference.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":237},\"provenance\":[\"source:note:heterogeneity-prespecification\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Observed modifier precedes treatment or has an explicitly justified alternative causal target.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:59f3ce197c5715a84895a5a6\",\"object_id\":\"claim:heterogeneity-prespecification\",\"predicate\":\"supports\",\"provenance\":[\"source:note:heterogeneity-prespecification\",\"source:ontology:sun2010\",\"source:ontology:kent2020\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"subject_id\":\"evidence:heterogeneity-prespecification\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:heterogeneity-prespecification\",\"source_version\":\"sha256:10b6c6133e5243e5a09b60c1e04da64de78b467d1056bf50b0ddcb3dd01a34a6\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"Subgroup discovery and confirmatory analysis have different evidence requirements — original evidence note\"}" .
<urn:capy:evidence%3Aiv-local> a capy:evidencelocator ; skos:prefLabel "IV interpretation is a compliance-specific identification statement — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Aiv-local> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/iv-local.md\",\"id\":\"evidence:iv-local\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":699,\"exact_text\":\"A relevant instrument is not automatically a valid instrument. Exclusion, independence and the applicable compliance restrictions connect an instrument-induced comparison to a local effect. Under the usual binary monotonicity setup, that target concerns compliers rather than necessarily every eligible unit. Report the instrument construction, first-stage information and weak-identification-aware uncertainty; a different estimator such as LIML does not establish exclusion.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":223},\"provenance\":[\"source:note:iv-local\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Instrument and compliance assumptions hold for the stated local target.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:829a5b8a78ff95a82f18e939\",\"object_id\":\"claim:iv-local\",\"predicate\":\"supports\",\"provenance\":[\"source:note:iv-local\",\"angrist1996\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"angrist1996\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped original methodological explanation; no whole-method or study audit is implied.\",\"subject_id\":\"evidence:iv-local\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"angrist1996\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:iv-local\",\"source_version\":\"sha256:9b00c15dcb5c6cb4f37396ea94d7047b460b3a8f5f572445dde8a30bb7fb57fa\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"IV interpretation is a compliance-specific identification statement — original evidence note\"}" .
<urn:capy:evidence%3Alongitudinal-feedback> a capy:evidencelocator ; skos:prefLabel "Treatment-confounder feedback requires sequential reasoning — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Alongitudinal-feedback> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/longitudinal-feedback.md\",\"id\":\"evidence:longitudinal-feedback\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":737,\"exact_text\":\"When a measured covariate is affected by earlier treatment and predicts later treatment and outcome, ordinary covariate adjustment can fail to target the intended treatment-history effect. Define the intervention history and order its measurements. Marginal structural models, longitudinal g-computation and structural-model approaches use different estimation constructions, but all require their applicable sequential exchangeability, consistency and support conditions; fitted histories do not verify those assumptions.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":215},\"provenance\":[\"source:note:longitudinal-feedback\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"The intended longitudinal strategy and sequential identification conditions are stated.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:05208d10eabfbc5b684cf124\",\"object_id\":\"claim:longitudinal-feedback\",\"predicate\":\"supports\",\"provenance\":[\"source:note:longitudinal-feedback\",\"source:ontology:robins2000\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:robins2000\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped original methodological explanation; no whole-method or study audit is implied.\",\"subject_id\":\"evidence:longitudinal-feedback\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:robins2000\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:longitudinal-feedback\",\"source_version\":\"sha256:202bd1057a670068ad7f3ad6e05e6424319e8b9c6763bd39080dcadaa9593dc6\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"Treatment-confounder feedback requires sequential reasoning — original evidence note\"}" .
<urn:capy:evidence%3Amediation-target> a capy:evidencelocator ; skos:prefLabel "Mediation targets require additional assumptions — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Amediation-target> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/mediation-target.md\",\"id\":\"evidence:mediation-target\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":775,\"exact_text\":\"Randomized treatment does not automatically identify mediator effects. A controlled direct effect fixes a mediator intervention, while natural effects involve mediator potential outcomes and additional cross-world or equivalent structural conditions. Interventional mediation effects specify different stochastic mediator strategies. Identify the target explicitly, inspect mediator-outcome confounding and exposure-induced confounders, and avoid relabeling a mediator-adjusted treatment regression coefficient as any of these effects without its identification argument.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":204},\"provenance\":[\"source:note:mediation-target\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"The mediator intervention and target-specific identifying assumptions are justified.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:88e91529fb53a9010140e0ac\",\"object_id\":\"claim:mediation-target\",\"predicate\":\"supports\",\"provenance\":[\"source:note:mediation-target\",\"source:ontology:imai2010\",\"source:ontology:vansteelandt2017\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:imai2010\",\"source:ontology:vansteelandt2017\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped original methodological explanation; no whole-method or study audit is implied.\",\"subject_id\":\"evidence:mediation-target\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:imai2010\",\"source:ontology:vansteelandt2017\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:mediation-target\",\"source_version\":\"sha256:e3b87e77b7246efe35f6f8145821a8a93d52af0dffb35bcf15fe7a34fcf2b9b4\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"Mediation targets require additional assumptions — original evidence note\"}" .
<urn:capy:evidence%3Anuisance-learning> a capy:evidencelocator ; skos:prefLabel "Orthogonal learning retains identification and inference conditions — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Anuisance-learning> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/nuisance-learning.md\",\"id\":\"evidence:nuisance-learning\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":704,\"exact_text\":\"An orthogonal score can reduce first-order sensitivity to nuisance estimation errors; it does not remove confounding. Fit nuisance models on training folds and evaluate target-specific scores on held-out observations, keeping dependent units or clusters in valid split units. ATE and ATT scores are not interchangeable. Valid uncertainty also requires the stated rate, sampling and dependence conditions, even when one nuisance component gives a doubly robust consistency property.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":223},\"provenance\":[\"source:note:nuisance-learning\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Score, target, fold unit and inference conditions match the procedure.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:32d08f0ed2717c84fb9095c0\",\"object_id\":\"claim:nuisance-learning\",\"predicate\":\"supports\",\"provenance\":[\"source:note:nuisance-learning\",\"bang2005\",\"chernozhukov2018\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"bang2005\",\"chernozhukov2018\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped original methodological explanation; no whole-method or study audit is implied.\",\"subject_id\":\"evidence:nuisance-learning\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"bang2005\",\"chernozhukov2018\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:nuisance-learning\",\"source_version\":\"sha256:cef582a9db5cfc88b1c08dfee093f2d541915e19b1997b67bf24b186b9b5c4ba\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"Orthogonal learning retains identification and inference conditions — original evidence note\"}" .
<urn:capy:evidence%3Apopulation-effects> a capy:evidencelocator ; skos:prefLabel "Interference and transport alter the comparison — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Apopulation-effects> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/population-effects.md\",\"id\":\"evidence:population-effects\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":662,\"exact_text\":\"Cross-unit treatment effects require an exposure mapping or allocation strategy, so direct, spillover and overall effects can differ. Transport to another population additionally requires source and target definitions, relevant effect modifiers and support. A balancing weight or network summary alone does not establish the assumptions needed for either question. State which units, assignments and population distributions the reported effect averages over.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":203},\"provenance\":[\"source:note:population-effects\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Exposure mapping or transport assumptions match the declared target.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:e2580918b528fc6075c0e151\",\"object_id\":\"claim:population-effects\",\"predicate\":\"supports\",\"provenance\":[\"source:note:population-effects\",\"source:ontology:hudgens2008\",\"source:ontology:bareinboim2016\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:hudgens2008\",\"source:ontology:bareinboim2016\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped original methodological explanation; no whole-method or study audit is implied.\",\"subject_id\":\"evidence:population-effects\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:hudgens2008\",\"source:ontology:bareinboim2016\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:population-effects\",\"source_version\":\"sha256:ecb7d5a95afecaeca32e30054b2866667617ade1ceb6c28042a08c7c930b3cd5\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"Interference and transport alter the comparison — original evidence note\"}" .
<urn:capy:evidence%3Arate-evaluation> a capy:evidencelocator ; skos:prefLabel "Ranking tests assess a rule with a specified evaluation design — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Arate-evaluation> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/rate-evaluation.md\",\"id\":\"evidence:rate-evaluation\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":740,\"exact_text\":\"RATE and its AUTOC or Qini weighting summarize treatment-effect differences along a prioritization rule. A valid evaluation design separates construction of the ranking from its evaluation outcomes. Holding an estimated ranking fixed during row bootstrap omits learning uncertainty unless the inferential target is explicitly conditional on an independently learned rule. A non-significant ranking test can mean limited power or a poor rule, even when true effects vary. Do not equate it with evidence of no heterogeneity.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":218},\"provenance\":[\"source:note:rate-evaluation\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Ranking independence or an explicitly justified cross-fitting design.\",\"Resampling respects the actual unit of independence.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:9b531be17390dbc8ba5165da\",\"object_id\":\"claim:rate-evaluation\",\"predicate\":\"supports\",\"provenance\":[\"source:note:rate-evaluation\",\"source:ontology:grf-rate\",\"source:ontology:genericml\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"subject_id\":\"evidence:rate-evaluation\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:rate-evaluation\",\"source_version\":\"sha256:9c4dbb0a1fa42fc3e114990434cb37c23e2f16fd1b334cd40dc6746097778ba6\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"Ranking tests assess a rule with a specified evaluation design — original evidence note\"}" .
<urn:capy:evidence%3Ard-local> a capy:evidencelocator ; skos:prefLabel "RD targets depend on the cutoff design and estimator — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Ard-local> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/rd-local.md\",\"id\":\"evidence:rd-local\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":683,\"exact_text\":\"Regression discontinuity is a local design. Continuity-based, local-randomization, fuzzy and kink analyses rely on different conditions and targets. Inspect the running variable, threshold rule, treatment discontinuity, bandwidth and uncertainty procedure. Density and covariate-balance diagnostics can reveal problems, but a failure to reject cannot establish all required smoothness or assignment conditions. Extrapolation away from the cutoff needs an additional argument.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":208},\"provenance\":[\"source:note:rd-local\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"The stated cutoff design and local target conditions apply.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:6f9ccdf3ce4430394e86afd8\",\"object_id\":\"claim:rd-local\",\"predicate\":\"supports\",\"provenance\":[\"source:note:rd-local\",\"source:ontology:cattaneo2022\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:cattaneo2022\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped original methodological explanation; no whole-method or study audit is implied.\",\"subject_id\":\"evidence:rd-local\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:cattaneo2022\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:rd-local\",\"source_version\":\"sha256:d0c4a6868e047f3bc3f67b013ce41c3213e0066fe81d61adbbd71b79390da321\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"RD targets depend on the cutoff design and estimator — original evidence note\"}" .
<urn:capy:evidence%3Asurvival-censoring> a capy:evidencelocator ; skos:prefLabel "Conditional censoring assumptions must match the procedure — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Asurvival-censoring> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/survival-censoring.md\",\"id\":\"evidence:survival-censoring\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":897,\"exact_text\":\"A right-censored record says the event occurs after the observed duration; it contributes a survival-tail term rather than an event density to a parametric likelihood. Raw treatment-arm Kaplan–Meier and its RMST summary need within-arm independent censoring and supported risk sets for their associational distributions. Conditional independence of censoring given additional measured covariates does not automatically justify raw arm curves when both censoring and event time depend on those covariates. A causal treatment contrast additionally needs a separate identification argument. Delayed entry, interval censoring and competing events require explicitly supported procedures.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":214},\"provenance\":[\"source:note:survival-censoring\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Observation and censoring conditions match the actually implemented estimator.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:efd0d4d0c940c380c03039be\",\"object_id\":\"claim:survival-censoring\",\"predicate\":\"supports\",\"provenance\":[\"source:note:survival-censoring\",\"source:ontology:cole2004\",\"source:ontology:wei1992\",\"source:ontology:r-survreg\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:cole2004\",\"source:ontology:wei1992\",\"source:ontology:r-survreg\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped original methodological explanation; no whole-method or study audit is implied.\",\"subject_id\":\"evidence:survival-censoring\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:cole2004\",\"source:ontology:wei1992\",\"source:ontology:r-survreg\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:survival-censoring\",\"source_version\":\"sha256:1c118543ae80f42b398b42e23f5312c5d7a9b432805ed9976773a20ed29052c0\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"Conditional censoring assumptions must match the procedure — original evidence note\"}" .
<urn:capy:evidence%3Asurvival-heterogeneity> a capy:evidencelocator ; skos:prefLabel "KM and RMST heterogeneity depend on common horizons and subgroup support — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Asurvival-heterogeneity> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/survival-heterogeneity.md\",\"id\":\"evidence:survival-heterogeneity\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":758,\"exact_text\":\"Compare KM survival differences at a fixed horizon or RMST differences integrated through the same horizon across baseline subgroups. Raw within-cell KM requires a defensible censoring assumption within each treatment-by-subgroup cell; conditioning only in a later interpretation does not adjust that estimator. Estimate the joint covariance of the subgroup contrasts, preserve the sampling unit when resampling, and disclose failed replicates. A log-rank test is not a test of equality of those fixed-horizon treatment contrasts.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":228},\"provenance\":[\"source:note:survival-heterogeneity\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"The same time units and horizon are supported in each required treatment-by-subgroup cell.\",\"Both treatment arms occur in every target subgroup.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:cf27017b10a4ee1fe5527e60\",\"object_id\":\"claim:survival-heterogeneity\",\"predicate\":\"supports\",\"provenance\":[\"source:note:survival-heterogeneity\",\"source:ontology:cole2004\",\"source:ontology:uno2014\",\"source:ontology:altman2003\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped methodological explanation; not a study finding or a promise of identification.\",\"subject_id\":\"evidence:survival-heterogeneity\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:survival-heterogeneity\",\"source_version\":\"sha256:04f72b8726a62586c341660671a00a0613bcb9d01be741798a48121add5031a3\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"KM and RMST heterogeneity depend on common horizons and subgroup support — original evidence note\"}" .
<urn:capy:evidence%3Asurvival-marginal> a capy:evidencelocator ; skos:prefLabel "Survival and RMST contrasts are horizon-specific population targets — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Asurvival-marginal> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/survival-marginal.md\",\"id\":\"evidence:survival-marginal\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":717,\"exact_text\":\"The survival contrast S^1(tau) minus S^0(tau) compares event-free probabilities at a declared horizon. RMST is the integral of survival from zero through tau, so an RMST difference has duration units and requires the same horizon in both strategies. A conditional hazard ratio or AFT coefficient is a different summary. Standardized survival predictions average strategy-specific curves over the declared target covariate distribution under the needed treatment, censoring and model conditions.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":223},\"provenance\":[\"source:note:survival-marginal\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Target population, shared horizon, treatment/censoring identification and model conditions are justified.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:dc3a44f954b819216c885e5e\",\"object_id\":\"claim:survival-marginal\",\"predicate\":\"supports\",\"provenance\":[\"source:note:survival-marginal\",\"source:ontology:cole2004\",\"source:ontology:uno2014\",\"source:ontology:hernan2010\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:cole2004\",\"source:ontology:uno2014\",\"source:ontology:hernan2010\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped original methodological explanation; no whole-method or study audit is implied.\",\"subject_id\":\"evidence:survival-marginal\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:cole2004\",\"source:ontology:uno2014\",\"source:ontology:hernan2010\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:survival-marginal\",\"source_version\":\"sha256:1d0c387c862bf0fb851d5ec7f855b3c6d3898e9817defdac9d2d895dde89d2da\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"Survival and RMST contrasts are horizon-specific population targets — original evidence note\"}" .
<urn:capy:evidence%3Atarget-time> a capy:evidencelocator ; skos:prefLabel "Eligibility and follow-up must share a defensible time zero — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Atarget-time> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/target-time.md\",\"id\":\"evidence:target-time\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":674,\"exact_text\":\"An exposure label constructed from events after eligibility can require units to survive until they receive that label. Counting that guaranteed event-free period as exposed follow-up introduces immortal-time bias. Specify eligibility, assignment or strategy classification, and start of follow-up together; inspect joins and exclusion rules for future information. The appropriate emulation depends on the intended strategy, not only on available timestamps.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":215},\"provenance\":[\"source:note:target-time\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Eligibility, assignment and follow-up are aligned for the defined target trial.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:3532ea1780db4343c07b993a\",\"object_id\":\"claim:target-time\",\"predicate\":\"supports\",\"provenance\":[\"source:note:target-time\",\"source:ontology:hernan2016\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:hernan2016\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped original methodological explanation; no whole-method or study audit is implied.\",\"subject_id\":\"evidence:target-time\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"source:ontology:hernan2016\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:target-time\",\"source_version\":\"sha256:d2d524258065668eb403f2e6c0c250686eead48c4c4de983e753021d235ce337\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"Eligibility and follow-up must share a defensible time zero — original evidence note\"}" .
<urn:capy:evidence%3Aweight-target> a capy:evidencelocator ; skos:prefLabel "Weighting and support are target-specific — original evidence note" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Aweight-target> ; capy:record "{\"citation_ids\":[],\"citations\":[],\"content_path\":\"seed/evidence/weight-target.md\",\"id\":\"evidence:weight-target\",\"kind\":\"evidencelocator\",\"locator\":{\"end\":650,\"exact_text\":\"ATE, ATT and overlap-population targets use different treatment weighting rules. Record the target before fitting assignment models, and examine support, weight concentration and balance after weighting. Clipping probabilities changes the estimator; discarding units can change the eligible target. Neither stable weights nor measured balance proves exchangeability, and no probability model repairs absent treatment support for the required comparison.\",\"normalization\":\"none; strict UTF-8\",\"offset_convention\":\"Unicode code points; zero-based; end-exclusive\",\"start\":197},\"provenance\":[\"source:note:weight-target\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Target-specific weight equations and positivity are justified.\"],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:95dd89f0f10050c00b087e81\",\"object_id\":\"claim:weight-target\",\"predicate\":\"supports\",\"provenance\":[\"source:note:weight-target\",\"rosenbaum1983\",\"bang2005\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"rosenbaum1983\",\"bang2005\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Scoped original methodological explanation; no whole-method or study audit is implied.\",\"subject_id\":\"evidence:weight-target\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original note reviewed against linked primary context; no external full text redistributed.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"sources\":[\"rosenbaum1983\",\"bang2005\"],\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_id\":\"source:note:weight-target\",\"source_version\":\"sha256:4f36448670ea64cf7130341fb1ba5023cfe8d7e72caa52c532c2309b4c52e59e\",\"summary\":\"Exact original source text is preserved in the versioned locator.\",\"title\":\"Weighting and support are target-specific — original evidence note\"}" .
<urn:capy:example%3Abasque> a capy:example ; skos:prefLabel "One region, a constructed twin" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"example:basque\",\"citation_ids\":[],\"citations\":[],\"content\":{\"caveat\":null,\"citation\":\"After Abadie & Gardeazabal (2003).\",\"citation_url\":\"https://doi.org/10.1257/000282803321455188\",\"design\":{\"explain_key\":\"design.synth\",\"id\":\"synth\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"One treated unit; build a comparison from a donor pool.\",\"title\":\"One place, constructed twin\"},\"difficulty\":\"medium\",\"estimand\":null,\"explain_key\":null,\"gaps\":[],\"id\":\"basque\",\"kind\":\"example\",\"one_liner\":\"synthetic control and placebo inference\",\"plain_language\":\"A single treated region and a pool of donors. If the synthetic twin cannot reproduce the pre-period, it is not a counterfactual, and the placebos will tell you.\",\"provenance\":{\"data_origin\":\"Independent deterministic simulation; no original study records.\",\"downloads_from\":[],\"licences\":[],\"rights\":\"Generated locally by Causal Capybara from original simulation code. No rows, labels, or documentation from the cited study are redistributed.\",\"simulated_note\":\"Simulated data built to the shape of the original study, not the original data. The lesson is real; the numbers are not the published ones.\",\"source\":\"simulated\",\"study\":null,\"truth\":null},\"question\":\"A single treated region and a pool of donors. If the synthetic twin cannot reproduce the pre-period, it is not a counterfactual, and the placebos will tell you.\",\"rows\":684,\"see_also\":[{\"explain_key\":\"design.synth\",\"id\":\"synth\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"One treated unit; build a comparison from a donor pool.\",\"title\":\"One place, constructed twin\"}],\"suggested_methods\":[],\"tags\":[\"One place, constructed twin\",\"medium\"],\"teaches\":\"synthetic control and placebo inference\",\"title\":\"One region, a constructed twin\",\"tour\":[{\"body\":\"Simulated data built to the shape of the original study, not the original data. The lesson is real; the numbers are not the published ones. After Abadie & Gardeazabal (2003). The built-in effect is recorded in the project so you can check what the estimators recover.\",\"focus\":\"data\",\"step\":\"0\",\"title\":\"This data is simulated\"},{\"body\":\"The sentence at the top is the analysis. Completing it is how you start.\",\"focus\":\"question\",\"step\":\"1\",\"title\":\"The question strip\"},{\"body\":\"The picture is the identification strategy. Drop variables onto it; every zone also has a keyboard equivalent in the inspector.\",\"focus\":\"board\",\"step\":\"2\",\"title\":\"The board\"},{\"body\":\"The live diagnostic for this design appears as soon as the board has its minimum roles. You can estimate without looking; the run is then marked provisional, and it says so everywhere.\",\"focus\":\"diagnose\",\"step\":\"3\",\"title\":\"Diagnose first\"},{\"body\":\"The default is the recommended set, not the first card. The forest is the headline.\",\"focus\":\"recommend\",\"step\":\"4\",\"title\":\"Estimate a set\"},{\"body\":\"Ask how fragile the conclusion is, then export a report a colleague can read and a referee can rerun.\",\"focus\":\"probe\",\"step\":\"5\",\"title\":\"Probe, then report\"}]},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"example:basque\",\"kind\":\"example\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"basque\",\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:d5595cf5fad7352fece1a8de\",\"object_id\":\"design:synth\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"example:basque\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"A single treated region and a pool of donors. If the synthetic twin cannot reproduce the pre-period, it is not a counterfactual, and the placebos will tell you.\",\"title\":\"One region, a constructed twin\"}" .
<urn:capy:example%3Acalifornia_tobacco> a capy:example ; skos:prefLabel "A tobacco-control policy and cigarette sales" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"example:california_tobacco\",\"citation_ids\":[],\"citations\":[],\"content\":{\"caveat\":null,\"citation\":\"After Abadie, Diamond & Hainmueller (2010).\",\"citation_url\":\"https://doi.org/10.1198/jasa.2009.ap08746\",\"design\":{\"explain_key\":\"design.synth\",\"id\":\"synth\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"One treated unit; build a comparison from a donor pool.\",\"title\":\"One place, constructed twin\"},\"difficulty\":\"medium\",\"estimand\":null,\"explain_key\":null,\"gaps\":[],\"id\":\"california_tobacco\",\"kind\":\"example\",\"one_liner\":\"the canonical policy application of synthetic control\",\"plain_language\":\"One state adopts a policy while a donor pool supplies a synthetic comparison. The pre-period fit and in-space placebos decide whether the post-period gap is credible.\",\"provenance\":{\"data_origin\":\"Independent deterministic simulation; no original study records.\",\"downloads_from\":[],\"licences\":[],\"rights\":\"Generated locally by Causal Capybara from original simulation code. No rows, labels, or documentation from the cited study are redistributed.\",\"simulated_note\":\"Simulated data built to the shape of the original study, not the original data. The lesson is real; the numbers are not the published ones.\",\"source\":\"simulated\",\"study\":null,\"truth\":\"A declining post-policy sales path is built in and reported in the project note.\"},\"question\":\"One state adopts a policy while a donor pool supplies a synthetic comparison. The pre-period fit and in-space placebos decide whether the post-period gap is credible.\",\"rows\":1209,\"see_also\":[{\"explain_key\":\"design.synth\",\"id\":\"synth\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"One treated unit; build a comparison from a donor pool.\",\"title\":\"One place, constructed twin\"}],\"suggested_methods\":[],\"tags\":[\"One place, constructed twin\",\"medium\"],\"teaches\":\"the canonical policy application of synthetic control\",\"title\":\"A tobacco-control policy and cigarette sales\",\"tour\":[{\"body\":\"Simulated data built to the shape of the original study, not the original data. The lesson is real; the numbers are not the published ones. After Abadie, Diamond & Hainmueller (2010). The built-in effect is recorded in the project so you can check what the estimators recover.\",\"focus\":\"data\",\"step\":\"0\",\"title\":\"This data is simulated\"},{\"body\":\"A synthetic state is credible only if its weighted donors reproduce the treated state's pre-policy path. Pre-period fit is the admission ticket, not decoration.\",\"focus\":\"diagnose\",\"step\":\"1\",\"title\":\"Earn the post-period comparison\"},{\"body\":\"A few donors may carry most of the comparison. Leave-one-donor-out results show whether one state is quietly holding the answer together.\",\"focus\":\"dashboard\",\"step\":\"2\",\"title\":\"Inspect the donor weights\"},{\"body\":\"Reassign the policy to donor states. The treated gap matters only relative to gaps the same procedure invents where no intervention occurred.\",\"focus\":\"dashboard\",\"step\":\"3\",\"title\":\"Put the gap beside placebos\"}]},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"example:california_tobacco\",\"kind\":\"example\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"california_tobacco\",\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:c4be03fa1a63f21046155db1\",\"object_id\":\"design:synth\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"example:california_tobacco\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"One state adopts a policy while a donor pool supplies a synthetic comparison. The pre-period fit and in-space placebos decide whether the post-period gap is credible.\",\"title\":\"A tobacco-control policy and cigarette sales\"}" .
<urn:capy:example%3Aclose_elections> a capy:example ; skos:prefLabel "Barely winning an election" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"example:close_elections\",\"citation_ids\":[],\"citations\":[],\"content\":{\"caveat\":null,\"citation\":\"After Lee (2008).\",\"citation_url\":\"https://doi.org/10.1016/j.jeconom.2007.05.004\",\"design\":{\"explain_key\":\"design.rd\",\"id\":\"rd\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Crossing a score, age, or border switched the programme on.\",\"title\":\"A cutoff decided eligibility\"},\"difficulty\":\"medium\",\"estimand\":null,\"explain_key\":null,\"gaps\":[],\"id\":\"close_elections\",\"kind\":\"example\",\"one_liner\":\"the sharp regression discontinuity\",\"plain_language\":\"Incumbency decided by a hair. Drag the cutoff, watch the binned scatter, and see the jump before you have chosen a bandwidth.\",\"provenance\":{\"data_origin\":\"Independent deterministic simulation; no original study records.\",\"downloads_from\":[],\"licences\":[],\"rights\":\"Generated locally by Causal Capybara from original simulation code. No rows, labels, or documentation from the cited study are redistributed.\",\"simulated_note\":\"Simulated data built to the shape of the original study, not the original data. The lesson is real; the numbers are not the published ones.\",\"source\":\"simulated\",\"study\":null,\"truth\":null},\"question\":\"Incumbency decided by a hair. Drag the cutoff, watch the binned scatter, and see the jump before you have chosen a bandwidth.\",\"rows\":4000,\"see_also\":[{\"explain_key\":\"design.rd\",\"id\":\"rd\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Crossing a score, age, or border switched the programme on.\",\"title\":\"A cutoff decided eligibility\"}],\"suggested_methods\":[],\"tags\":[\"A cutoff decided eligibility\",\"medium\"],\"teaches\":\"the sharp regression discontinuity\",\"title\":\"Barely winning an election\",\"tour\":[{\"body\":\"Simulated data built to the shape of the original study, not the original data. The lesson is real; the numbers are not the published ones. After Lee (2008). The built-in effect is recorded in the project so you can check what the estimators recover.\",\"focus\":\"data\",\"step\":\"0\",\"title\":\"This data is simulated\"},{\"body\":\"Drop the winning margin on the axis and set the cutoff to zero. The binned scatter appears immediately -- before you have chosen a bandwidth, a kernel or a polynomial order.\",\"focus\":\"board\",\"step\":\"1\",\"title\":\"Drag the cutoff\"},{\"body\":\"If candidates could decide which side of the line they landed on, the density would jump at the cutoff. Here it does not, and 'does not contradict' is as strong as that gets.\",\"focus\":\"diagnose\",\"step\":\"2\",\"title\":\"Look for a cliff in the density\"},{\"body\":\"The bandwidth path shows the estimate across a grid of bandwidths. If the answer only exists at one bandwidth, it is not an answer.\",\"focus\":\"dashboard\",\"step\":\"3\",\"title\":\"Bandwidth is a plot, not an option\"},{\"body\":\"The estimand is a LATE: districts decided by a hair. It is not the effect of incumbency in a safe seat, and the report will not let you imply that it is.\",\"focus\":\"dashboard\",\"step\":\"4\",\"title\":\"Say who the number is about\"}]},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"example:close_elections\",\"kind\":\"example\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"close_elections\",\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:0e80a2c57479555602d41056\",\"object_id\":\"design:rd\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"example:close_elections\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Incumbency decided by a hair. Drag the cutoff, watch the binned scatter, and see the jump before you have chosen a bandwidth.\",\"title\":\"Barely winning an election\"}" .
<urn:capy:example%3Adraft_lottery> a capy:example ; skos:prefLabel "Draft eligibility and later earnings" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"example:draft_lottery\",\"citation_ids\":[],\"citations\":[],\"content\":{\"caveat\":null,\"citation\":\"After Angrist (1990).\",\"citation_url\":\"https://www.jstor.org/stable/2006669\",\"design\":{\"explain_key\":\"design.iv\",\"id\":\"iv\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"An instrument or encouragement changed treatment, not the outcome directly.\",\"title\":\"Something else pushed people in\"},\"difficulty\":\"medium\",\"estimand\":null,\"explain_key\":null,\"gaps\":[],\"id\":\"draft_lottery\",\"kind\":\"example\",\"one_liner\":\"a natural experiment, the first stage, and LATE\",\"plain_language\":\"A lottery shifts military service but does not determine it. The first stage is visible, and the estimate belongs to the people whose service the lottery changed.\",\"provenance\":{\"data_origin\":\"Independent deterministic simulation; no original study records.\",\"downloads_from\":[],\"licences\":[],\"rights\":\"Generated locally by Causal Capybara from original simulation code. No rows, labels, or documentation from the cited study are redistributed.\",\"simulated_note\":\"Simulated data built to the shape of the original study, not the original data. The lesson is real; the numbers are not the published ones.\",\"source\":\"simulated\",\"study\":null,\"truth\":\"The complier effect on log earnings is built in and reported in the project note.\"},\"question\":\"A lottery shifts military service but does not determine it. The first stage is visible, and the estimate belongs to the people whose service the lottery changed.\",\"rows\":4000,\"see_also\":[{\"explain_key\":\"design.iv\",\"id\":\"iv\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"An instrument or encouragement changed treatment, not the outcome directly.\",\"title\":\"Something else pushed people in\"}],\"suggested_methods\":[],\"tags\":[\"Something else pushed people in\",\"medium\"],\"teaches\":\"a natural experiment, the first stage, and LATE\",\"title\":\"Draft eligibility and later earnings\",\"tour\":[{\"body\":\"Simulated data built to the shape of the original study, not the original data. The lesson is real; the numbers are not the published ones. After Angrist (1990). The built-in effect is recorded in the project so you can check what the estimators recover.\",\"focus\":\"data\",\"step\":\"0\",\"title\":\"This data is simulated\"},{\"body\":\"Eligibility changes the probability of service; it does not determine service. A weak first stage would make every later number fragile, so inspect it before the outcome.\",\"focus\":\"diagnose\",\"step\":\"1\",\"title\":\"Start with the first stage\"},{\"body\":\"The exclusion restriction says eligibility reaches earnings only through service. The data cannot verify that claim; the board keeps it visible as an assumption.\",\"focus\":\"board\",\"step\":\"2\",\"title\":\"Name the missing arrow\"},{\"body\":\"The result is for people whose service status eligibility changed. It is not automatically the effect for volunteers, never-takers, or everyone exposed to the lottery.\",\"focus\":\"dashboard\",\"step\":\"3\",\"title\":\"Read the estimate as a LATE\"}]},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"example:draft_lottery\",\"kind\":\"example\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"draft_lottery\",\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:8daaa974474c56b77d9072cb\",\"object_id\":\"design:iv\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"example:draft_lottery\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"A lottery shifts military service but does not determine it. The first stage is visible, and the estimate belongs to the people whose service the lottery changed.\",\"title\":\"Draft eligibility and later earnings\"}" .
<urn:capy:example%3Aencouragement> a capy:example ; skos:prefLabel "An encouragement people could ignore" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"example:encouragement\",\"citation_ids\":[],\"citations\":[],\"content\":{\"caveat\":null,\"citation\":\"After Angrist, Imbens & Rubin (1996).\",\"citation_url\":\"https://doi.org/10.1080/01621459.1996.10476902\",\"design\":{\"explain_key\":\"design.iv\",\"id\":\"iv\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"An instrument or encouragement changed treatment, not the outcome directly.\",\"title\":\"Something else pushed people in\"},\"difficulty\":\"medium\",\"estimand\":null,\"explain_key\":null,\"gaps\":[],\"id\":\"encouragement\",\"kind\":\"example\",\"one_liner\":\"LATE, compliers, and why ITT is not the treatment effect\",\"plain_language\":\"A letter that nudged people into a programme. The effect you can identify is the effect on the people the letter actually moved -- not on everyone.\",\"provenance\":{\"data_origin\":\"Independent deterministic simulation; no original study records.\",\"downloads_from\":[],\"licences\":[],\"rights\":\"Generated locally by Causal Capybara from original simulation code. No rows, labels, or documentation from the cited study are redistributed.\",\"simulated_note\":\"Simulated data built to the shape of the original study, not the original data. The lesson is real; the numbers are not the published ones.\",\"source\":\"simulated\",\"study\":null,\"truth\":null},\"question\":\"A letter that nudged people into a programme. The effect you can identify is the effect on the people the letter actually moved -- not on everyone.\",\"rows\":3000,\"see_also\":[{\"explain_key\":\"design.iv\",\"id\":\"iv\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"An instrument or encouragement changed treatment, not the outcome directly.\",\"title\":\"Something else pushed people in\"}],\"suggested_methods\":[],\"tags\":[\"Something else pushed people in\",\"medium\"],\"teaches\":\"LATE, compliers, and why ITT is not the treatment effect\",\"title\":\"An encouragement people could ignore\",\"tour\":[{\"body\":\"Simulated data built to the shape of the original study, not the original data. The lesson is real; the numbers are not the published ones. After Angrist, Imbens & Rubin (1996). The built-in effect is recorded in the project so you can check what the estimators recover.\",\"focus\":\"data\",\"step\":\"0\",\"title\":\"This data is simulated\"},{\"body\":\"The sentence at the top is the analysis. Completing it is how you start.\",\"focus\":\"question\",\"step\":\"1\",\"title\":\"The question strip\"},{\"body\":\"The picture is the identification strategy. Drop variables onto it; every zone also has a keyboard equivalent in the inspector.\",\"focus\":\"board\",\"step\":\"2\",\"title\":\"The board\"},{\"body\":\"The live diagnostic for this design appears as soon as the board has its minimum roles. You can estimate without looking; the run is then marked provisional, and it says so everywhere.\",\"focus\":\"diagnose\",\"step\":\"3\",\"title\":\"Diagnose first\"},{\"body\":\"The default is the recommended set, not the first card. The forest is the headline.\",\"focus\":\"recommend\",\"step\":\"4\",\"title\":\"Estimate a set\"},{\"body\":\"Ask how fragile the conclusion is, then export a report a colleague can read and a referee can rerun.\",\"focus\":\"probe\",\"step\":\"5\",\"title\":\"Probe, then report\"}]},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"example:encouragement\",\"kind\":\"example\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"encouragement\",\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:aa46f66415f567cab66e49d4\",\"object_id\":\"design:iv\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"example:encouragement\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"A letter that nudged people into a programme. The effect you can identify is the effect on the people the letter actually moved -- not on everyone.\",\"title\":\"An encouragement people could ignore\"}" .
<urn:capy:example%3Aheterogeneous_outcomes> a capy:example ; skos:prefLabel "Treatment heterogeneity across outcome types" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"example:heterogeneous_outcomes\",\"citation_ids\":[],\"citations\":[],\"content\":{\"caveat\":null,\"citation\":\"Methodological context: Altman and Bland (2003), Knol and VanderWeele (2012).\",\"citation_url\":\"https://doi.org/10.1136/bmj.326.7382.219\",\"design\":{\"explain_key\":\"design.rct\",\"id\":\"rct\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"People were assigned by chance, or as good as chance.\",\"title\":\"Randomised or as-if randomised\"},\"difficulty\":\"medium\",\"estimand\":null,\"explain_key\":null,\"gaps\":[],\"id\":\"heterogeneous_outcomes\",\"kind\":\"example\",\"one_liner\":\"direct heterogeneity tests, scale dependence and multiplicity\",\"plain_language\":\"One randomized baseline study with continuous, binary, count and categorical outcomes. Compare prespecified effect scales and direct interaction tests.\",\"provenance\":{\"data_origin\":\"Independent deterministic simulation; no original study records.\",\"downloads_from\":[],\"licences\":[],\"rights\":\"Generated locally by Causal Capybara from original simulation code. No rows, labels, or documentation from the cited study are redistributed.\",\"simulated_note\":\"Simulated data built to the shape of the original study, not the original data. The lesson is real; the numbers are not the published ones.\",\"source\":\"simulated\",\"study\":null,\"truth\":\"Continuous subgroup effects are 0.5 and 2.0. Other outcomes have distinct nonlinear contrasts; no individual treatment effects are observed.\"},\"question\":\"One randomized baseline study with continuous, binary, count and categorical outcomes. Compare prespecified effect scales and direct interaction tests.\",\"rows\":1800,\"see_also\":[{\"explain_key\":\"design.rct\",\"id\":\"rct\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"People were assigned by chance, or as good as chance.\",\"title\":\"Randomised or as-if randomised\"}],\"suggested_methods\":[],\"tags\":[\"Randomised or as-if randomised\",\"medium\"],\"teaches\":\"direct heterogeneity tests, scale dependence and multiplicity\",\"title\":\"Treatment heterogeneity across outcome types\",\"tour\":[{\"body\":\"Simulated data built to the shape of the original study, not the original data. The lesson is real; the numbers are not the published ones. Methodological context: Altman and Bland (2003), Knol and VanderWeele (2012). The built-in effect is recorded in the project so you can check what the estimators recover.\",\"focus\":\"data\",\"step\":\"0\",\"title\":\"This data is simulated\"},{\"body\":\"The sentence at the top is the analysis. Completing it is how you start.\",\"focus\":\"question\",\"step\":\"1\",\"title\":\"The question strip\"},{\"body\":\"The picture is the identification strategy. Drop variables onto it; every zone also has a keyboard equivalent in the inspector.\",\"focus\":\"board\",\"step\":\"2\",\"title\":\"The board\"},{\"body\":\"The live diagnostic for this design appears as soon as the board has its minimum roles. You can estimate without looking; the run is then marked provisional, and it says so everywhere.\",\"focus\":\"diagnose\",\"step\":\"3\",\"title\":\"Diagnose first\"},{\"body\":\"The default is the recommended set, not the first card. The forest is the headline.\",\"focus\":\"recommend\",\"step\":\"4\",\"title\":\"Estimate a set\"},{\"body\":\"Ask how fragile the conclusion is, then export a report a colleague can read and a referee can rerun.\",\"focus\":\"probe\",\"step\":\"5\",\"title\":\"Probe, then report\"}]},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"example:heterogeneous_outcomes\",\"kind\":\"example\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"heterogeneous_outcomes\",\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:052b7b95c4b4798ebddcba7f\",\"object_id\":\"design:rct\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"example:heterogeneous_outcomes\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"One randomized baseline study with continuous, binary, count and categorical outcomes. Compare prespecified effect scales and direct interaction tests.\",\"title\":\"Treatment heterogeneity across outcome types\"}" .
<urn:capy:example%3Aihdp> a capy:example ; skos:prefLabel "Early support and child development" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"example:ihdp\",\"citation_ids\":[],\"citations\":[],\"content\":{\"caveat\":null,\"citation\":\"After the IHDP benchmark used by Hill (2011).\",\"citation_url\":\"https://doi.org/10.1198/jcgs.2010.08162\",\"design\":{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"},\"difficulty\":\"medium\",\"estimand\":null,\"explain_key\":null,\"gaps\":[],\"id\":\"ihdp\",\"kind\":\"example\",\"one_liner\":\"benchmarking adjustment when the counterfactual is known\",\"plain_language\":\"A deliberately confounded treatment assignment with the familiar size and structure of the IHDP benchmark. The outcome surface is known, so adjustment can be checked.\",\"provenance\":{\"data_origin\":\"Independent deterministic simulation; no original study records.\",\"downloads_from\":[],\"licences\":[],\"rights\":\"Generated locally by Causal Capybara from original simulation code. No rows, labels, or documentation from the cited study are redistributed.\",\"simulated_note\":\"Simulated data built to the shape of the original study, not the original data. The lesson is real; the numbers are not the published ones.\",\"source\":\"simulated\",\"study\":null,\"truth\":\"Individual effects are generated in code; the ATT is recorded in the project note.\"},\"question\":\"A deliberately confounded treatment assignment with the familiar size and structure of the IHDP benchmark. The outcome surface is known, so adjustment can be checked.\",\"rows\":747,\"see_also\":[{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"}],\"suggested_methods\":[],\"tags\":[\"Adjust for background differences\",\"medium\"],\"teaches\":\"benchmarking adjustment when the counterfactual is known\",\"title\":\"Early support and child development\",\"tour\":[{\"body\":\"Simulated data built to the shape of the original study, not the original data. The lesson is real; the numbers are not the published ones. After the IHDP benchmark used by Hill (2011). The built-in effect is recorded in the project so you can check what the estimators recover.\",\"focus\":\"data\",\"step\":\"0\",\"title\":\"This data is simulated\"},{\"body\":\"Programme participation depends on measured baseline characteristics. Inspect overlap and balance before asking an outcome model to repair those differences.\",\"focus\":\"diagnose\",\"step\":\"1\",\"title\":\"See selection before adjustment\"},{\"body\":\"Weighting, outcome regression and AIPW make different modelling commitments. Their agreement is informative; their disagreement points to the part of the data doing the work.\",\"focus\":\"recommend\",\"step\":\"2\",\"title\":\"Triangulate\"},{\"body\":\"Because this is a simulation, the untreated potential outcome and individual effect are known. Compare the estimators with that recorded truth without pretending real studies do.\",\"focus\":\"dashboard\",\"step\":\"3\",\"title\":\"Use the built-in counterfactual\"}]},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"example:ihdp\",\"kind\":\"example\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"ihdp\",\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:3d137c0393641f8dbc0ddd3b\",\"object_id\":\"design:observational\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"example:ihdp\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"A deliberately confounded treatment assignment with the familiar size and structure of the IHDP benchmark. The outcome surface is known, so adjustment can be checked.\",\"title\":\"Early support and child development\"}" .
<urn:capy:example%3Aits_public_health> a capy:example ; skos:prefLabel "A public-health rule, one series" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"example:its_public_health\",\"citation_ids\":[],\"citations\":[],\"content\":{\"caveat\":null,\"citation\":\"After Bernal, Cummins & Gasparrini (2017).\",\"citation_url\":\"https://doi.org/10.1093/ije/dyw098\",\"design\":{\"explain_key\":\"design.its\",\"id\":\"its\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Before versus after an interruption; maybe a control series.\",\"title\":\"A shock in a single series\"},\"difficulty\":\"medium\",\"estimand\":null,\"explain_key\":null,\"gaps\":[],\"id\":\"its_public_health\",\"kind\":\"example\",\"one_liner\":\"interrupted time series, seasonality and autocorrelation\",\"plain_language\":\"Monthly admissions with a seasonal cycle and one interruption. Everything depends on what you believe the line would have done anyway.\",\"provenance\":{\"data_origin\":\"Independent deterministic simulation; no original study records.\",\"downloads_from\":[],\"licences\":[],\"rights\":\"Generated locally by Causal Capybara from original simulation code. No rows, labels, or documentation from the cited study are redistributed.\",\"simulated_note\":\"Simulated data built to the shape of the original study, not the original data. The lesson is real; the numbers are not the published ones.\",\"source\":\"simulated\",\"study\":null,\"truth\":null},\"question\":\"Monthly admissions with a seasonal cycle and one interruption. Everything depends on what you believe the line would have done anyway.\",\"rows\":96,\"see_also\":[{\"explain_key\":\"design.its\",\"id\":\"its\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Before versus after an interruption; maybe a control series.\",\"title\":\"A shock in a single series\"}],\"suggested_methods\":[],\"tags\":[\"A shock in a single series\",\"medium\"],\"teaches\":\"interrupted time series, seasonality and autocorrelation\",\"title\":\"A public-health rule, one series\",\"tour\":[{\"body\":\"Simulated data built to the shape of the original study, not the original data. The lesson is real; the numbers are not the published ones. After Bernal, Cummins & Gasparrini (2017). The built-in effect is recorded in the project so you can check what the estimators recover.\",\"focus\":\"data\",\"step\":\"0\",\"title\":\"This data is simulated\"},{\"body\":\"The sentence at the top is the analysis. Completing it is how you start.\",\"focus\":\"question\",\"step\":\"1\",\"title\":\"The question strip\"},{\"body\":\"The picture is the identification strategy. Drop variables onto it; every zone also has a keyboard equivalent in the inspector.\",\"focus\":\"board\",\"step\":\"2\",\"title\":\"The board\"},{\"body\":\"The live diagnostic for this design appears as soon as the board has its minimum roles. You can estimate without looking; the run is then marked provisional, and it says so everywhere.\",\"focus\":\"diagnose\",\"step\":\"3\",\"title\":\"Diagnose first\"},{\"body\":\"The default is the recommended set, not the first card. The forest is the headline.\",\"focus\":\"recommend\",\"step\":\"4\",\"title\":\"Estimate a set\"},{\"body\":\"Ask how fragile the conclusion is, then export a report a colleague can read and a referee can rerun.\",\"focus\":\"probe\",\"step\":\"5\",\"title\":\"Probe, then report\"}]},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"example:its_public_health\",\"kind\":\"example\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"its_public_health\",\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:d9e5e5cced441dc1a108ca54\",\"object_id\":\"design:its\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"example:its_public_health\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Monthly admissions with a seasonal cycle and one interruption. Everything depends on what you believe the line would have done anyway.\",\"title\":\"A public-health rule, one series\"}" .
<urn:capy:example%3Alalonde> a capy:example ; skos:prefLabel "Job training and later earnings" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"example:lalonde\",\"citation_ids\":[],\"citations\":[],\"content\":{\"caveat\":null,\"citation\":\"After LaLonde (1986) and Dehejia & Wahba (1999).\",\"citation_url\":\"https://doi.org/10.2307/2529249\",\"design\":{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"},\"difficulty\":\"start here\",\"estimand\":null,\"explain_key\":null,\"gaps\":[],\"id\":\"lalonde\",\"kind\":\"example\",\"one_liner\":\"why overlap comes before the estimate\",\"plain_language\":\"A training programme against a survey comparison group. The comparison group is nothing like the trainees, and the overlap plot says so before any estimator runs.\",\"provenance\":{\"data_origin\":\"Independent deterministic simulation; no original study records.\",\"downloads_from\":[],\"licences\":[],\"rights\":\"Generated locally by Causal Capybara from original simulation code. No rows, labels, or documentation from the cited study are redistributed.\",\"simulated_note\":\"Simulated data built to the shape of the original study, not the original data. The lesson is real; the numbers are not the published ones.\",\"source\":\"simulated\",\"study\":null,\"truth\":\"ATT is built in and reported in the project note.\"},\"question\":\"A training programme against a survey comparison group. The comparison group is nothing like the trainees, and the overlap plot says so before any estimator runs.\",\"rows\":2675,\"see_also\":[{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"}],\"suggested_methods\":[],\"tags\":[\"Adjust for background differences\",\"start here\"],\"teaches\":\"why overlap comes before the estimate\",\"title\":\"Job training and later earnings\",\"tour\":[{\"body\":\"Simulated data built to the shape of the original study, not the original data. The lesson is real; the numbers are not the published ones. After LaLonde (1986) and Dehejia & Wahba (1999). The built-in effect is recorded in the project so you can check what the estimators recover.\",\"focus\":\"data\",\"step\":\"0\",\"title\":\"This data is simulated\"},{\"body\":\"The strip at the top is the whole analysis in one sentence: the effect of the training programme on 1978 earnings, for people eligible for it, against comparable people who did not take part.\",\"focus\":\"question\",\"step\":\"1\",\"title\":\"Read the question\"},{\"body\":\"The trainees and the comparison group are not alike. The propensity histogram shows most of the comparison group sitting where no trainee sits, and the effective sample size tells you how few of them are really being used.\",\"focus\":\"diagnose\",\"step\":\"2\",\"title\":\"Look at the overlap before anything else\"},{\"body\":\"Nothing was dropped to make the picture look better. Trimming is available on the Probe bench as a curve, so you can see what it costs rather than accept a package default.\",\"focus\":\"diagnose\",\"step\":\"3\",\"title\":\"Notice what the app refuses to do\"},{\"body\":\"Four methods, not one. Matching, weighting, outcome regression and the doubly robust estimator disagree here, and the disagreement is the finding.\",\"focus\":\"recommend\",\"step\":\"4\",\"title\":\"Estimate the recommended set\"},{\"body\":\"There is no headline number when several methods ran. Outcome regression sits highest because it reaches furthest into the region where the two groups do not overlap at all. Propensity weighting sits far below zero, on the wrong side of no effect entirely, because it has almost nobody comparable to lean on. Matching, and the doubly robust method that fits both a model of who took part and a model of earnings so that either one being right is enough, land close to the built-in effect. The spread between the four is the finding, and it is a statement about this data rather than about the methods.\",\"focus\":\"dashboard\",\"step\":\"5\",\"title\":\"Read the forest, not a number\"},{\"body\":\"Run the sensitivity probe. It answers a specific question: how strong would an unmeasured confounder have to be, compared with the covariates you did measure, to explain the estimate away?\",\"focus\":\"probe\",\"step\":\"6\",\"title\":\"Ask how wrong it could be\"}]},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"example:lalonde\",\"kind\":\"example\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"lalonde\",\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:821b340bacf8e5b75ee3086d\",\"object_id\":\"design:observational\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"example:lalonde\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"A training programme against a survey comparison group. The comparison group is nothing like the trainees, and the overlap plot says so before any estimator runs.\",\"title\":\"Job training and later earnings\"}" .
<urn:capy:example%3Amedicaid> a capy:example ; skos:prefLabel "A policy states adopted at different times" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"example:medicaid\",\"citation_ids\":[],\"citations\":[],\"content\":{\"caveat\":null,\"citation\":\"After Goodman-Bacon (2021) and Callaway & Sant'Anna (2021).\",\"citation_url\":\"https://doi.org/10.1016/j.jeconom.2020.12.001\",\"design\":{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"},\"difficulty\":\"the important one\",\"estimand\":null,\"explain_key\":null,\"gaps\":[],\"id\":\"medicaid\",\"kind\":\"example\",\"one_liner\":\"why TWFE misleads under staggered adoption\",\"plain_language\":\"Staggered adoption with effects that grow after treatment. Two-way fixed effects gets the wrong answer here, and the app will keep saying so until you look.\",\"provenance\":{\"data_origin\":\"Independent deterministic simulation; no original study records.\",\"downloads_from\":[],\"licences\":[],\"rights\":\"Generated locally by Causal Capybara from original simulation code. No rows, labels, or documentation from the cited study are redistributed.\",\"simulated_note\":\"Simulated data built to the shape of the original study, not the original data. The lesson is real; the numbers are not the published ones.\",\"source\":\"simulated\",\"study\":null,\"truth\":null},\"question\":\"Staggered adoption with effects that grow after treatment. Two-way fixed effects gets the wrong answer here, and the app will keep saying so until you look.\",\"rows\":1020,\"see_also\":[{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"}],\"suggested_methods\":[],\"tags\":[\"Policy rolled out over time\",\"the important one\"],\"teaches\":\"why TWFE misleads under staggered adoption\",\"title\":\"A policy states adopted at different times\",\"tour\":[{\"body\":\"Simulated data built to the shape of the original study, not the original data. The lesson is real; the numbers are not the published ones. After Goodman-Bacon (2021) and Callaway & Sant'Anna (2021). The built-in effect is recorded in the project so you can check what the estimators recover.\",\"focus\":\"data\",\"step\":\"0\",\"title\":\"This data is simulated\"},{\"body\":\"Drop the unit, period and treatment indicator and the design card notices that states adopted at different times. It says so on the board, before any menu of estimators.\",\"focus\":\"board\",\"step\":\"1\",\"title\":\"The card changes its own copy\"},{\"body\":\"The adoption heatmap is sorted by adoption date. Three cohorts, seventeen never-treated states, and effects that grow for three years after adoption.\",\"focus\":\"diagnose\",\"step\":\"2\",\"title\":\"Look at the rollout\"},{\"body\":\"Two-way fixed effects is in the catalogue, greyed, with the reason attached. Include it anyway: seeing the wrong number next to the right one teaches more than hiding it.\",\"focus\":\"recommend\",\"step\":\"3\",\"title\":\"Run the wrong method on purpose\"},{\"body\":\"Callaway-Sant'Anna and Sun-Abraham recover the built-in effect. TWFE does not, because it averages 2x2 comparisons that include already-treated states used as controls.\",\"focus\":\"dashboard\",\"step\":\"4\",\"title\":\"Compare\"},{\"body\":\"The Goodman-Bacon decomposition shows exactly which comparisons TWFE leaned on and what weight it gave them. That plot is the argument.\",\"focus\":\"dashboard\",\"step\":\"5\",\"title\":\"Decompose the damage\"},{\"body\":\"The event study's pre-period coefficients are the closest thing to evidence about parallel trends, and honest DiD asks how far trends could drift before the conclusion breaks.\",\"focus\":\"probe\",\"step\":\"6\",\"title\":\"Test what you assumed\"}]},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"example:medicaid\",\"kind\":\"example\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"medicaid\",\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:7b3098d1845cb5ac2afbbbd2\",\"object_id\":\"design:did\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"example:medicaid\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Staggered adoption with effects that grow after treatment. Two-way fixed effects gets the wrong answer here, and the app will keep saying so until you look.\",\"title\":\"A policy states adopted at different times\"}" .
<urn:capy:example%3Aminimum_wage> a capy:example ; skos:prefLabel "A minimum wage rise in one state" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"example:minimum_wage\",\"citation_ids\":[],\"citations\":[],\"content\":{\"caveat\":null,\"citation\":\"After Card & Krueger (1994).\",\"citation_url\":\"https://doi.org/10.1257/aer.84.4.772\",\"design\":{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"},\"difficulty\":\"start here\",\"estimand\":null,\"explain_key\":null,\"gaps\":[],\"id\":\"minimum_wage\",\"kind\":\"example\",\"one_liner\":\"the 2x2 difference-in-differences\",\"plain_language\":\"Two states, two periods, one policy change. The cleanest difference-in-differences there is, and the place to learn what parallel trends actually asks of you.\",\"provenance\":{\"data_origin\":\"Independent deterministic simulation; no original study records.\",\"downloads_from\":[],\"licences\":[],\"rights\":\"Generated locally by Causal Capybara from original simulation code. No rows, labels, or documentation from the cited study are redistributed.\",\"simulated_note\":\"Simulated data built to the shape of the original study, not the original data. The lesson is real; the numbers are not the published ones.\",\"source\":\"simulated\",\"study\":null,\"truth\":null},\"question\":\"Two states, two periods, one policy change. The cleanest difference-in-differences there is, and the place to learn what parallel trends actually asks of you.\",\"rows\":820,\"see_also\":[{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"}],\"suggested_methods\":[],\"tags\":[\"Policy rolled out over time\",\"start here\"],\"teaches\":\"the 2x2 difference-in-differences\",\"title\":\"A minimum wage rise in one state\",\"tour\":[{\"body\":\"Simulated data built to the shape of the original study, not the original data. The lesson is real; the numbers are not the published ones. After Card & Krueger (1994). The built-in effect is recorded in the project so you can check what the estimators recover.\",\"focus\":\"data\",\"step\":\"0\",\"title\":\"This data is simulated\"},{\"body\":\"The sentence at the top is the analysis. Completing it is how you start.\",\"focus\":\"question\",\"step\":\"1\",\"title\":\"The question strip\"},{\"body\":\"The picture is the identification strategy. Drop variables onto it; every zone also has a keyboard equivalent in the inspector.\",\"focus\":\"board\",\"step\":\"2\",\"title\":\"The board\"},{\"body\":\"The live diagnostic for this design appears as soon as the board has its minimum roles. You can estimate without looking; the run is then marked provisional, and it says so everywhere.\",\"focus\":\"diagnose\",\"step\":\"3\",\"title\":\"Diagnose first\"},{\"body\":\"The default is the recommended set, not the first card. The forest is the headline.\",\"focus\":\"recommend\",\"step\":\"4\",\"title\":\"Estimate a set\"},{\"body\":\"Ask how fragile the conclusion is, then export a report a colleague can read and a referee can rerun.\",\"focus\":\"probe\",\"step\":\"5\",\"title\":\"Probe, then report\"}]},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"example:minimum_wage\",\"kind\":\"example\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"minimum_wage\",\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:112593d0b1f849a1a6a13abf\",\"object_id\":\"design:did\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"example:minimum_wage\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Two states, two periods, one policy change. The cleanest difference-in-differences there is, and the place to learn what parallel trends actually asks of you.\",\"title\":\"A minimum wage rise in one state\"}" .
<urn:capy:example%3Aproject_star> a capy:example ; skos:prefLabel "Smaller classes in early grades" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"example:project_star\",\"citation_ids\":[],\"citations\":[],\"content\":{\"caveat\":null,\"citation\":\"After Tennessee Project STAR; Mosteller (1995).\",\"citation_url\":\"https://doi.org/10.2307/1602360\",\"design\":{\"explain_key\":\"design.rct\",\"id\":\"rct\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"People were assigned by chance, or as good as chance.\",\"title\":\"Randomised or as-if randomised\"},\"difficulty\":\"start here\",\"estimand\":null,\"explain_key\":null,\"gaps\":[],\"id\":\"project_star\",\"kind\":\"example\",\"one_liner\":\"blocked assignment and cluster-aware uncertainty\",\"plain_language\":\"Pupils are assigned to small or regular classes within schools. The school blocks and classroom clusters are part of the design, not standard-error options to remember later.\",\"provenance\":{\"data_origin\":\"Independent deterministic simulation; no original study records.\",\"downloads_from\":[],\"licences\":[],\"rights\":\"Generated locally by Causal Capybara from original simulation code. No rows, labels, or documentation from the cited study are redistributed.\",\"simulated_note\":\"Simulated data built to the shape of the original study, not the original data. The lesson is real; the numbers are not the published ones.\",\"source\":\"simulated\",\"study\":null,\"truth\":\"The intention-to-treat effect is built in and reported in the project note.\"},\"question\":\"Pupils are assigned to small or regular classes within schools. The school blocks and classroom clusters are part of the design, not standard-error options to remember later.\",\"rows\":2520,\"see_also\":[{\"explain_key\":\"design.rct\",\"id\":\"rct\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"People were assigned by chance, or as good as chance.\",\"title\":\"Randomised or as-if randomised\"}],\"suggested_methods\":[],\"tags\":[\"Randomised or as-if randomised\",\"start here\"],\"teaches\":\"blocked assignment and cluster-aware uncertainty\",\"title\":\"Smaller classes in early grades\",\"tour\":[{\"body\":\"Simulated data built to the shape of the original study, not the original data. The lesson is real; the numbers are not the published ones. After Tennessee Project STAR; Mosteller (1995). The built-in effect is recorded in the project so you can check what the estimators recover.\",\"focus\":\"data\",\"step\":\"0\",\"title\":\"This data is simulated\"},{\"body\":\"Class size was assigned within schools. The school role keeps the estimate tied to those within-school comparisons instead of treating the sample as one unstructured lottery.\",\"focus\":\"board\",\"step\":\"1\",\"title\":\"Keep the assignment blocks\"},{\"body\":\"Pupils in one classroom share a teacher and a classroom shock. The classroom role makes that dependence visible and carries it into uncertainty estimates.\",\"focus\":\"diagnose\",\"step\":\"2\",\"title\":\"Keep the outcome clusters\"},{\"body\":\"Run the blocked and cluster-randomised analyses beside the plain difference in means. The point estimates should be close; the uncertainty need not be.\",\"focus\":\"recommend\",\"step\":\"3\",\"title\":\"Compare design-aware analyses\"}]},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"example:project_star\",\"kind\":\"example\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"project_star\",\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:ce1e51ae168b4cd8cff7b146\",\"object_id\":\"design:rct\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"example:project_star\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Pupils are assigned to small or regular classes within schools. The school blocks and classroom clusters are part of the design, not standard-error options to remember later.\",\"title\":\"Smaller classes in early grades\"}" .
<urn:capy:example%3Arct_noncompliance> a capy:example ; skos:prefLabel "A trial people did not all comply with" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"example:rct_noncompliance\",\"citation_ids\":[],\"citations\":[],\"content\":{\"caveat\":null,\"citation\":\"After Bloom (1984).\",\"citation_url\":\"https://doi.org/10.1016/0191-2615(84)90020-8\",\"design\":{\"explain_key\":\"design.rct\",\"id\":\"rct\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"People were assigned by chance, or as good as chance.\",\"title\":\"Randomised or as-if randomised\"},\"difficulty\":\"start here\",\"estimand\":null,\"explain_key\":null,\"gaps\":[],\"id\":\"rct_noncompliance\",\"kind\":\"example\",\"one_liner\":\"ITT against CACE\",\"plain_language\":\"Randomised assignment, one-sided noncompliance. Both numbers are correct and they answer different questions.\",\"provenance\":{\"data_origin\":\"Independent deterministic simulation; no original study records.\",\"downloads_from\":[],\"licences\":[],\"rights\":\"Generated locally by Causal Capybara from original simulation code. No rows, labels, or documentation from the cited study are redistributed.\",\"simulated_note\":\"Simulated data built to the shape of the original study, not the original data. The lesson is real; the numbers are not the published ones.\",\"source\":\"simulated\",\"study\":null,\"truth\":null},\"question\":\"Randomised assignment, one-sided noncompliance. Both numbers are correct and they answer different questions.\",\"rows\":2000,\"see_also\":[{\"explain_key\":\"design.rct\",\"id\":\"rct\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"People were assigned by chance, or as good as chance.\",\"title\":\"Randomised or as-if randomised\"}],\"suggested_methods\":[],\"tags\":[\"Randomised or as-if randomised\",\"start here\"],\"teaches\":\"ITT against CACE\",\"title\":\"A trial people did not all comply with\",\"tour\":[{\"body\":\"Simulated data built to the shape of the original study, not the original data. The lesson is real; the numbers are not the published ones. After Bloom (1984). The built-in effect is recorded in the project so you can check what the estimators recover.\",\"focus\":\"data\",\"step\":\"0\",\"title\":\"This data is simulated\"},{\"body\":\"Assignment was random; attendance was not. The intention-to-treat effect and the complier effect are both correct, and they are not the same number.\",\"focus\":\"board\",\"step\":\"1\",\"title\":\"Two questions, two numbers\"},{\"body\":\"Randomisation should leave the arms alike at baseline. A balance test is not proof that randomisation worked -- it is a check that nothing went wrong afterwards.\",\"focus\":\"diagnose\",\"step\":\"2\",\"title\":\"Check the balance\"},{\"body\":\"rct.diff_means gives the effect of being offered the programme. rct.cace scales it by the compliance rate to get the effect on the people who actually attended.\",\"focus\":\"recommend\",\"step\":\"3\",\"title\":\"Run both\"},{\"body\":\"A policy that can only offer the programme is described by the ITT. Reporting the complier effect as the policy effect overstates what the policy can deliver.\",\"focus\":\"dashboard\",\"step\":\"4\",\"title\":\"Pick the one your question asks for\"}]},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"example:rct_noncompliance\",\"kind\":\"example\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"rct_noncompliance\",\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:a1bbb8d7df004a1105b3e9d6\",\"object_id\":\"design:rct\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"example:rct_noncompliance\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Randomised assignment, one-sided noncompliance. Both numbers are correct and they answer different questions.\",\"title\":\"A trial people did not all comply with\"}" .
<urn:capy:example%3Asurvival_followup> a capy:example ; skos:prefLabel "Baseline treatment and event-free follow-up" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"example:survival_followup\",\"citation_ids\":[],\"citations\":[],\"content\":{\"caveat\":null,\"citation\":\"Methodological context: Hernán (2010), Wei (1992) and Uno et al. (2014).\",\"citation_url\":\"https://doi.org/10.1097/EDE.0b013e3181c1ea43\",\"design\":{\"explain_key\":\"design.survival\",\"id\":\"survival\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Follow people from a common time zero; some leave follow-up before the event is observed.\",\"title\":\"Time until an event\"},\"difficulty\":\"medium\",\"estimand\":null,\"explain_key\":null,\"gaps\":[],\"id\":\"survival_followup\",\"kind\":\"example\",\"one_liner\":\"event definition, time zero, censoring and conditional versus marginal contrasts\",\"plain_language\":\"Confounded baseline treatment, right censoring and a prespecified eight-month horizon. Compare raw RMST with AFT standardization over the same baseline population.\",\"provenance\":{\"data_origin\":\"Independent deterministic simulation; no original study records.\",\"downloads_from\":[],\"licences\":[],\"rights\":\"Generated locally by Causal Capybara from original simulation code. No rows, labels, or documentation from the cited study are redistributed.\",\"simulated_note\":\"Simulated data built to the shape of the original study, not the original data. The lesson is real; the numbers are not the published ones.\",\"source\":\"simulated\",\"study\":null,\"truth\":\"The standardized RMST difference at eight months is built in; the raw group difference intentionally misses it.\"},\"question\":\"Confounded baseline treatment, right censoring and a prespecified eight-month horizon. Compare raw RMST with AFT standardization over the same baseline population.\",\"rows\":1600,\"see_also\":[{\"explain_key\":\"design.survival\",\"id\":\"survival\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Follow people from a common time zero; some leave follow-up before the event is observed.\",\"title\":\"Time until an event\"}],\"suggested_methods\":[],\"tags\":[\"Time until an event\",\"medium\"],\"teaches\":\"event definition, time zero, censoring and conditional versus marginal contrasts\",\"title\":\"Baseline treatment and event-free follow-up\",\"tour\":[{\"body\":\"Simulated data built to the shape of the original study, not the original data. The lesson is real; the numbers are not the published ones. Methodological context: Hernán (2010), Wei (1992) and Uno et al. (2014). The built-in effect is recorded in the project so you can check what the estimators recover.\",\"focus\":\"data\",\"step\":\"0\",\"title\":\"This data is simulated\"},{\"body\":\"One independent person per row; treatment is set at baseline. Follow-up is elapsed months until event or right censoring. Event is 1, censoring 0. No competing-event, delayed-entry or time-varying-treatment analysis is implied.\",\"focus\":\"board\",\"step\":\"1\",\"title\":\"Define the event and time zero\"},{\"body\":\"The horizon is fixed at eight months with observed follow-up in both groups. RMST is event-free time restricted to that horizon; it is neither unrestricted lifetime nor a hazard ratio.\",\"focus\":\"recommend\",\"step\":\"2\",\"title\":\"Choose the target before the estimate\"},{\"body\":\"Raw unadjusted RMST intentionally misses the built-in standardized effect because baseline risk confounds treatment. AFT adjusts the correctly generated baseline model and averages both treatment predictions over the same population. In this simulation the assumptions hold by construction; model convergence and balance cannot verify them in an actual study.\",\"focus\":\"dashboard\",\"step\":\"3\",\"title\":\"Compare association with standardization\"},{\"body\":\"Identification, censoring and model assumptions remain labelled untested. Subject bootstrap uncertainty refits the AFT model and re-averages the target in every sample. exp(beta) is a conditional common time factor and generally does not equal the RMST ratio at eight months.\",\"focus\":\"diagnose\",\"step\":\"4\",\"title\":\"Read the assumptions and uncertainty\"}]},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"example:survival_followup\",\"kind\":\"example\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"survival_followup\",\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:7936831729088372e32e65c7\",\"object_id\":\"design:survival\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"example:survival_followup\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Confounded baseline treatment, right censoring and a prespecified eight-month horizon. Compare raw RMST with AFT standardization over the same baseline population.\",\"title\":\"Baseline treatment and event-free follow-up\"}" .
<urn:capy:hernan2010> a capy:source ; skos:prefLabel "Hernán, M. A. (2010). The Hazards of Hazard Ratios. Epidemiology, 21(1), 13–15." ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"citation\":\"Hernán, M. A. (2010). The Hazards of Hazard Ratios. Epidemiology, 21(1), 13–15.\",\"citation_ids\":[],\"citations\":[],\"disposition\":\"resolved_metadata\",\"id\":\"hernan2010\",\"kind\":\"source\",\"metadata\":{\"citation\":\"Hernán, M. A. (2010). The Hazards of Hazard Ratios. Epidemiology, 21(1), 13–15.\",\"id\":\"hernan2010\",\"match\":[\"hernan\",\"2010\",\"hazard\"],\"resolved\":true,\"topic\":\"Survival and causal event-time analysis\",\"url\":\"https://doi.org/10.1097/EDE.0b013e3181c1ea43\"},\"provenance\":[\"source:project-inventory\"],\"publication_rights\":{\"attribution\":\"Hernán, M. A. (2010). The Hazards of Hazard Ratios. Epidemiology, 21(1), 13–15.\",\"content_type\":\"external_publication_body\",\"license_id\":\"unknown\",\"license_url\":null,\"modified\":false,\"permissions\":{\"adapt\":false,\"cache\":false,\"display\":false,\"model_context\":false,\"public_export\":false},\"review_basis\":\"No full-text license has been admitted.\"},\"relations\":[],\"resolved\":true,\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_version\":\"https://doi.org/10.1097/EDE.0b013e3181c1ea43\",\"summary\":\"Bibliographic metadata/link only; no publication text, abstract, figure or dataset is distributed.\",\"title\":\"Hernán, M. A. (2010). The Hazards of Hazard Ratios. Epidemiology, 21(1), 13–15.\",\"url\":\"https://doi.org/10.1097/EDE.0b013e3181c1ea43\"}" .
<urn:capy:hernan2020> a capy:source ; skos:prefLabel "Hernán, M. A., & Robins, J. M. (2020). Causal Inference: What If. Chapman & Hall/CRC." ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"citation\":\"Hernán, M. A., & Robins, J. M. (2020). Causal Inference: What If. Chapman & Hall/CRC.\",\"citation_ids\":[],\"citations\":[],\"disposition\":\"resolved_metadata\",\"id\":\"hernan2020\",\"kind\":\"source\",\"metadata\":{\"citation\":\"Hernán, M. A., & Robins, J. M. (2020). Causal Inference: What If. Chapman & Hall/CRC.\",\"id\":\"hernan2020\",\"match\":[\"hernan\",\"robins\",\"2020\"],\"resolved\":true,\"topic\":\"Foundations\",\"url\":\"https://miguelhernan.org/whatifbook\"},\"provenance\":[\"source:project-inventory\"],\"publication_rights\":{\"attribution\":\"Hernán, M. A., & Robins, J. M. (2020). Causal Inference: What If. Chapman & Hall/CRC.\",\"content_type\":\"external_publication_body\",\"license_id\":\"unknown\",\"license_url\":null,\"modified\":false,\"permissions\":{\"adapt\":false,\"cache\":false,\"display\":false,\"model_context\":false,\"public_export\":false},\"review_basis\":\"No full-text license has been admitted.\"},\"relations\":[],\"resolved\":true,\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_version\":\"https://miguelhernan.org/whatifbook\",\"summary\":\"Bibliographic metadata/link only; no publication text, abstract, figure or dataset is distributed.\",\"title\":\"Hernán, M. A., & Robins, J. M. (2020). Causal Inference: What If. Chapman & Hall/CRC.\",\"url\":\"https://miguelhernan.org/whatifbook\"}" .
<urn:capy:heterogeneity.binary> a capy:method ; skos:prefLabel "Binary outcome heterogeneity" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:heterogeneity.binary\"],\"catalogue_key\":\"method:heterogeneity.binary\",\"citation_ids\":[\"altman2003\",\"kent2020\",\"knol2012\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":null,\"engines\":{\"python\":true,\"r\":false},\"needs_r_packages\":[],\"runs_here\":true,\"summary\":\"Runs on this computer with what the app already installs.\"},\"designs\":[{\"explain_key\":\"design.rct\",\"id\":\"rct\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"People were assigned by chance, or as good as chance.\",\"title\":\"Randomised or as-if randomised\"},{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.outcome_heterogeneity\",\"id\":\"outcome_heterogeneity\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Direct heterogeneity test on the selected outcome scale\"},{\"explain_key\":\"diagnostic.link_heterogeneity\",\"id\":\"link_heterogeneity\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Conditional treatment-by-modifier interaction\"}],\"estimands\":[{\"acronym\":\"CATE\",\"explain_key\":\"estimand.cate\",\"id\":\"CATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"How does the effect vary from person to person, or place to place?\",\"title\":\"Conditional average treatment effect\"},{\"acronym\":\"GATE\",\"explain_key\":\"estimand.gate\",\"id\":\"GATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"How does the effect vary across pre-specified groups?\",\"title\":\"Group average treatment effect\"}],\"explain_key\":\"method.heterogeneity.binary\",\"gaps\":[],\"id\":\"heterogeneity.binary\",\"in_more_depth\":\"The outcome must be 0 or 1, with supported events and non-events in each required treatment-by-modifier cell. The conditional logit-interaction test and the selected marginal-effect equality test answer different questions. Both treatment predictions use the declared baseline target profiles. Ratios are compared on the log scale and have positive confidence limits. HC0 or supported cluster sandwich and delta inference is asymptotic and conditions on fixed profiles; separation and unsupported ratios are refused.\",\"kind\":\"method\",\"needs_overlap\":true,\"one_liner\":\"Logistic interactions plus separate standardized risk-difference, risk-ratio or marginal odds-ratio heterogeneity tests.\",\"options\":[{\"default\":[],\"help\":\"Select one prespecified baseline variable. Categorical levels define subgroups; continuous mode evaluates two declared values without binning.\",\"label\":\"Baseline effect modifier\",\"max_items\":1,\"name\":\"subgroups\",\"profile\":\"beginner\",\"type\":\"columns\"},{\"default\":false,\"help\":\"Declare that the baseline modifier, coding, outcome and contrasts were chosen before inspecting effects. This declaration does not verify timing or scientific validity.\",\"label\":\"Modifier and contrasts were prespecified\",\"name\":\"subgroups_prespecified\",\"profile\":\"beginner\",\"type\":\"bool\"},{\"choices\":[\"categorical\",\"continuous\"],\"default\":\"categorical\",\"label\":\"Modifier type\",\"name\":\"modifier_type\",\"profile\":\"beginner\",\"type\":\"select\"},{\"default\":null,\"help\":\"An explicit scientifically meaningful value within both treatment arms' observed range.\",\"label\":\"Lower modifier value (continuous mode)\",\"name\":\"modifier_low\",\"profile\":\"standard\",\"type\":\"number\"},{\"default\":null,\"label\":\"Upper modifier value (continuous mode)\",\"name\":\"modifier_high\",\"profile\":\"standard\",\"type\":\"number\"},{\"default\":0.95,\"label\":\"Pointwise confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"standard\",\"type\":\"number\"},{\"choices\":[\"risk_difference\",\"risk_ratio\",\"odds_ratio\"],\"default\":\"risk_difference\",\"label\":\"Binary effect scale\",\"name\":\"effect_scale\",\"profile\":\"beginner\",\"type\":\"select\"}],\"plain_language\":\"Fit logistic treatment interactions and separately test standardized risk differences, risk ratios or marginal odds ratios.\",\"probes\":[],\"references\":[\"Altman and Bland (2003), Interaction revisited: the difference between two estimates\",\"Knol and VanderWeele (2012), Recommendations for presenting analyses of effect modification and interaction\",\"Kent et al. (2020), The Predictive Approaches to Treatment effect Heterogeneity (PATH) Statement\"],\"roles_forbidden\":[\"weight\",\"a time variable\",\"strata\",\"an instrument\",\"a running variable\",\"a mediator\",\"elapsed follow-up duration\",\"an event indicator (1 event, 0 right censored)\"],\"roles_optional\":[\"at least one measured confounder\",\"effect_modifiers\",\"a unit id\",\"a clustering variable\",\"forbidden\"],\"roles_required\":[\"a treatment\",\"an outcome\"],\"see_also\":[{\"explain_key\":\"design.rct\",\"id\":\"rct\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"People were assigned by chance, or as good as chance.\",\"title\":\"Randomised or as-if randomised\"},{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"},{\"explain_key\":\"diagnostic.outcome_heterogeneity\",\"id\":\"outcome_heterogeneity\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Direct heterogeneity test on the selected outcome scale\"},{\"explain_key\":\"diagnostic.link_heterogeneity\",\"id\":\"link_heterogeneity\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Conditional treatment-by-modifier interaction\"},{\"explain_key\":\"concept.heterogeneity_scale\",\"id\":\"concept.heterogeneity_scale\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"Absolute and relative treatment contrasts can vary differently across the same baseline groups.\",\"title\":\"Heterogeneity depends on the effect scale\"},{\"explain_key\":\"method.heterogeneity.categorical\",\"id\":\"heterogeneity.categorical\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Multinomial treatment interactions and a joint test of category-probability contrasts; preserves categories without assigning numeric scores.\",\"title\":\"Nominal and ordinal outcome heterogeneity\"},{\"explain_key\":\"method.heterogeneity.continuous\",\"id\":\"heterogeneity.continuous\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"OLS treatment-by-baseline-modifier interactions with HC3 or cluster sandwich inference, direct mean-difference tests and Holm pairwise comparisons.\",\"title\":\"Continuous outcome heterogeneity\"},{\"explain_key\":\"method.heterogeneity.count\",\"id\":\"heterogeneity.count\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Poisson conditional-mean interactions with robust sandwich inference; compare standardized count or fixed-exposure rate contrasts.\",\"title\":\"Count and rate outcome heterogeneity\"},{\"explain_key\":\"method.ml.causal_forest\",\"id\":\"ml.causal_forest\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Grow trees that look for units whose effect differs, keeping the rows that chose each split away from the rows that estimate it.\",\"title\":\"Honest causal forest\"},{\"explain_key\":\"method.ml.metalearner\",\"id\":\"ml.metalearner\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Build the per-unit effect out of ordinary prediction models, four different ways, on the same cross-fitting.\",\"title\":\"Meta-learner (T, S, X, DR)\"},{\"explain_key\":\"method.ml.policy_tree\",\"id\":\"ml.policy_tree\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Learn a short, readable rule for who to treat, then value that rule on data it never saw.\",\"title\":\"Policy tree (who should be treated)\"}],\"status\":\"recommended\",\"status_label\":\"Recommended\",\"tags\":[\"Randomised or as-if randomised\",\"Adjust for background differences\",\"CATE\",\"GATE\",\"Recommended\"],\"title\":\"Binary outcome heterogeneity\",\"what_it_assumes\":[{\"explain_key\":\"assumption.randomisation\",\"explains\":\"Assignment really was by chance, and nothing after assignment broke the comparison -- no differential dropout, no crossover you have not modelled.\",\"id\":\"randomisation\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Randomisation held\",\"worry_when\":\"Dropout differs across arms; take-up is far from assignment; the randomiser was a person with discretion.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"},{\"explain_key\":\"assumption.exchangeability\",\"explains\":\"Treated and untreated units are comparable once you condition on the confounders you measured. Everything that pushed people towards treatment and also moves the outcome is in your adjustment set.\",\"id\":\"exchangeability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Exchangeability / no unmeasured confounding\",\"worry_when\":\"Treatment was chosen by people who knew something about the likely outcome that you do not observe. Clinical judgement, self-selection into a programme, and administrative triage are the classic cases.\"},{\"explain_key\":\"assumption.positivity\",\"explains\":\"Every kind of unit had some chance of being treated and some chance of not being treated. Where that fails, there is no comparison to make and the model is inventing one.\",\"id\":\"positivity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Positivity / overlap\",\"worry_when\":\"Any single weight carries a large share of the total; the effective sample is far below the nominal one; the propensity model separates the arms almost perfectly; treated units sit outside the control group's range.\"}],\"when_not_to_use\":[\"Model-based baseline binary-treatment contrasts require correct conditional mean form and within-modifier support. Prespecification does not prove causality; model convergence and a significant interaction do not verify exchangeability. Delta inference conditions on empirical profiles. No outcome-driven subgroup discovery, panel/design-specific interactions or small-cluster correction.\"],\"when_to_use\":[\"Tests effect differences directly on a prespecified scale, with all interaction main effects and explicit sampling assumptions.\"]},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"heterogeneity.binary\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"heterogeneity.binary\",\"registry\":{\"designs\":[\"rct\",\"observational\"],\"diagnostics\":[\"outcome_heterogeneity\",\"link_heterogeneity\"],\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":true,\"r\":false},\"estimands\":[\"CATE\",\"GATE\"],\"explain_key\":\"method.heterogeneity.binary\",\"id\":\"heterogeneity.binary\",\"needs\":[\"numpy\",\"scipy\",\"statsmodels\"],\"needs_overlap\":true,\"one_liner\":\"Logistic interactions plus separate standardized risk-difference, risk-ratio or marginal odds-ratio heterogeneity tests.\",\"options\":[{\"default\":[],\"help\":\"Select one prespecified baseline variable. Categorical levels define subgroups; continuous mode evaluates two declared values without binning.\",\"label\":\"Baseline effect modifier\",\"max_items\":1,\"name\":\"subgroups\",\"profile\":\"beginner\",\"type\":\"columns\"},{\"default\":false,\"help\":\"Declare that the baseline modifier, coding, outcome and contrasts were chosen before inspecting effects. This declaration does not verify timing or scientific validity.\",\"label\":\"Modifier and contrasts were prespecified\",\"name\":\"subgroups_prespecified\",\"profile\":\"beginner\",\"type\":\"bool\"},{\"choices\":[\"categorical\",\"continuous\"],\"default\":\"categorical\",\"label\":\"Modifier type\",\"name\":\"modifier_type\",\"profile\":\"beginner\",\"type\":\"select\"},{\"default\":null,\"help\":\"An explicit scientifically meaningful value within both treatment arms' observed range.\",\"label\":\"Lower modifier value (continuous mode)\",\"name\":\"modifier_low\",\"profile\":\"standard\",\"type\":\"number\"},{\"default\":null,\"label\":\"Upper modifier value (continuous mode)\",\"name\":\"modifier_high\",\"profile\":\"standard\",\"type\":\"number\"},{\"default\":0.95,\"label\":\"Pointwise confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"standard\",\"type\":\"number\"},{\"choices\":[\"risk_difference\",\"risk_ratio\",\"odds_ratio\"],\"default\":\"risk_difference\",\"label\":\"Binary effect scale\",\"name\":\"effect_scale\",\"profile\":\"beginner\",\"type\":\"select\"}],\"probes\":[],\"reference_dispositions\":[{\"disposition\":\"resolved_metadata\",\"id\":\"altman2003\",\"requested_as\":\"Altman and Bland (2003), Interaction revisited: the difference between two estimates\"},{\"disposition\":\"resolved_metadata\",\"id\":\"knol2012\",\"requested_as\":\"Knol and VanderWeele (2012), Recommendations for presenting analyses of effect modification and interaction\"},{\"disposition\":\"resolved_metadata\",\"id\":\"kent2020\",\"requested_as\":\"Kent et al. (2020), The Predictive Approaches to Treatment effect Heterogeneity (PATH) Statement\"}],\"reference_ids\":[\"altman2003\",\"knol2012\",\"kent2020\"],\"references\":[\"Altman and Bland (2003), Interaction revisited: the difference between two estimates\",\"Knol and VanderWeele (2012), Recommendations for presenting analyses of effect modification and interaction\",\"Kent et al. (2020), The Predictive Approaches to Treatment effect Heterogeneity (PATH) Statement\"],\"roles_forbidden\":[\"weight\",\"time\",\"strata\",\"instruments\",\"running\",\"mediator\",\"duration\",\"event\"],\"roles_optional\":[\"confounders\",\"effect_modifiers\",\"unit\",\"cluster\",\"forbidden\"],\"roles_required\":[\"treatment\",\"outcome\"],\"source_path\":\"engines/python/capy_py/heterogeneity.py\",\"source_sha256\":\"f85f72b881f0021897d588369d6e6e2e615d761c8e7d43ea4e273916f9509c05\",\"status\":\"recommended\",\"title\":\"Binary outcome heterogeneity\",\"what_can_go_wrong\":\"Model-based baseline binary-treatment contrasts require correct conditional mean form and within-modifier support. Prespecification does not prove causality; model convergence and a significant interaction do not verify exchangeability. Delta inference conditions on empirical profiles. No outcome-driven subgroup discovery, panel/design-specific interactions or small-cluster correction.\",\"why_recommended\":\"Tests effect differences directly on a prespecified scale, with all interaction main effects and explicit sampling assumptions.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Consult the method card and exact claim qualifications before treating conceptual coverage as implementation support.\"],\"counterevidence\":[],\"gaps\":[\"No independent human scientific review or study-specific causal identification is established.\"],\"id\":\"relation:05b8e4e13b3e3f14af3ed0dd\",\"object_id\":\"concept:direct-heterogeneity-test\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:altman2003\",\"source:ontology:statsmodels-wald\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Qualified methodological context for this declared method; this link does not assert an implemented test or identifying assumption.\",\"subject_id\":\"heterogeneity.binary\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:069c668c8e0689598aaf77b8\",\"object_id\":\"diagnostic:link_heterogeneity\",\"predicate\":\"checked_by_diagnostic\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attr