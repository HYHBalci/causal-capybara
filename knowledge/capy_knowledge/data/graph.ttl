\":\"did.chaisemartin\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:cc4ac649b0982583d93fa45d\",\"object_id\":\"concept:pretrend\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"abadie2005\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"did.chaisemartin\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:d2e6a28649679f3df21d439c\",\"object_id\":\"did.gardner_2s\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"did.chaisemartin\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:d46a3fb653da08445a9eaeeb\",\"object_id\":\"concept:donor-pool\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"abadie2010\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"did.chaisemartin\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:d96870459e72ce08f1e42f35\",\"object_id\":\"chaisemartin2020\",\"predicate\":\"cites\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"did.chaisemartin\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:e00936d5430d840aa02207ad\",\"object_id\":\"assumption:no_anticipation\",\"predicate\":\"requires_assumption\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"did.chaisemartin\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"An estimator built for panels where treatment switches on and off, which the imputation and cohort estimators assume never happens.\",\"title\":\"de Chaisemartin & D'Haultfoeuille\"}" .
<urn:capy:did.dr_did> a capy:method ; skos:prefLabel "Doubly robust DiD" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:did.dr_did\"],\"catalogue_key\":\"method:did.dr_did\",\"citation_ids\":[\"abadie2005\",\"santanna2020\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":null,\"engines\":{\"python\":true,\"r\":\"DRDID\"},\"needs_r_packages\":[\"DRDID\"],\"runs_here\":true,\"summary\":\"Runs on this computer with what the app already installs.\"},\"designs\":[{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.raw_means\",\"id\":\"raw_means\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Raw means by cohort and period\"},{\"explain_key\":\"diagnostic.adoption\",\"id\":\"adoption\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Adoption pattern\"},{\"explain_key\":\"diagnostic.panel_balance\",\"id\":\"panel_balance\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Panel balance\"},{\"explain_key\":\"diagnostic.comparison_group\",\"id\":\"comparison_group\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Comparison group used\"},{\"explain_key\":\"diagnostic.cohort_att\",\"id\":\"cohort_att\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Cohort effects\"},{\"explain_key\":\"diagnostic.event_study\",\"id\":\"event_study\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Event study\"},{\"explain_key\":\"diagnostic.pre_trends\",\"id\":\"pre_trends\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Pre-trend test\"},{\"explain_key\":\"diagnostic.group_time_att\",\"id\":\"group_time_att\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Group-time effects\"},{\"explain_key\":\"diagnostic.overlap\",\"id\":\"overlap\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Overlap between the arms\"}],\"estimands\":[{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"}],\"explain_key\":\"method.did.dr_did\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\",\"some of the robustness probes it names have no card of their own yet\"],\"id\":\"did.dr_did\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":true,\"one_liner\":\"One before-and-after with covariates, using an outcome model and a comparison-group model together so either one can carry it.\",\"options\":[{\"choices\":[\"dr\",\"ipw\",\"reg\"],\"default\":\"dr\",\"help\":\"Doubly robust uses an outcome model and a comparison-group model together and is right if either is. IPW reweights the comparison group; Reg models the change in the outcome. With no covariates all three are the same plain difference of differences.\",\"label\":\"How each 2x2 adjusts for covariates\",\"name\":\"est_method\",\"profile\":\"standard\",\"type\":\"select\"},{\"choices\":[\"never_treated\",\"not_yet_treated\"],\"default\":\"never_treated\",\"help\":\"Units that never adopt are the cleanest comparison. Units that have not adopted yet give you more of them, at the cost of assuming the late adopters were on the same path. If nobody stays untreated the estimator switches to not-yet-treated on its own and says so.\",\"label\":\"Compare adopters with\",\"name\":\"control_group\",\"profile\":\"standard\",\"type\":\"select\"},{\"default\":0.001,\"help\":\"Bounds the weights when a unit is almost certain to be in the adopting cohort. Clipping is counted and reported, never silent.\",\"label\":\"Clip comparison-group probabilities at\",\"max\":0.2,\"min\":0.0,\"name\":\"clip\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":0.95,\"help\":\"Width of the interval reported next to the estimate.\",\"label\":\"Confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":false,\"help\":\"A pointwise interval is right for one period and wrong for the picture: read five periods at once and one will fall outside by chance. This widens the band so the whole path is covered together.\",\"label\":\"Simultaneous band on the event study\",\"name\":\"cband\",\"profile\":\"standard\",\"type\":\"bool\"},{\"default\":1000,\"help\":\"Multiplier-bootstrap draws for the simultaneous band. Seeded by the run seed, so the band is reproducible.\",\"label\":\"Bootstrap draws\",\"max\":20000,\"min\":99,\"name\":\"boot_reps\",\"profile\":\"advanced\",\"type\":\"int\"}],\"plain_language\":\"One before-and-after with covariates, using an outcome model and a comparison-group model together so either one can carry it.\",\"probes\":[{\"explain_key\":\"probe.placebo_outcome\",\"id\":\"probe.placebo_outcome\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the same analysis on something the treatment could not have changed. It should find nothing.\",\"requested_as\":\"placebo_outcome\",\"title\":\"Placebo outcome\"},{\"explain_key\":null,\"id\":\"placebo_period\",\"in_catalogue\":false,\"kind\":\"probe\",\"one_liner\":null,\"requested_as\":\"placebo_period\",\"title\":\"Placebo period\"},{\"explain_key\":\"probe.alternate_spec\",\"id\":\"probe.alternate_spec\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the grid of defensible specifications and sort the answers. The curve is the result, not the one you happened to run.\",\"requested_as\":\"alternate_spec\",\"title\":\"Specification curve\"},{\"explain_key\":null,\"id\":\"leave_one_cohort_out\",\"in_catalogue\":false,\"kind\":\"probe\",\"one_liner\":null,\"requested_as\":\"leave_one_cohort_out\",\"title\":\"Leave one adoption cohort out\"}],\"references\":[\"Sant'Anna and Zhao (2020), Doubly robust difference-in-differences estimators\",\"Abadie (2005), Semiparametric difference-in-differences estimators\"],\"roles_forbidden\":[\"a running variable\",\"an instrument\"],\"roles_optional\":[\"a clustering variable\",\"weight\",\"at least one measured confounder\"],\"roles_required\":[\"a treatment\",\"an outcome\",\"a unit id\",\"a time variable\"],\"see_also\":[{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"},{\"explain_key\":\"method.did.bjs_imputation\",\"id\":\"did.bjs_imputation\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Learn what untreated life looks like from untreated cells only, then ask how far each treated cell landed from it.\",\"title\":\"Imputation (Borusyak-Jaravel-Spiess)\"},{\"explain_key\":\"method.did.callaway_santanna\",\"id\":\"did.callaway_santanna\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Estimate one clean before-and-after for every adoption cohort, then say out loud how you averaged them.\",\"title\":\"Callaway & Sant'Anna group-time effects\"},{\"explain_key\":\"method.did.chaisemartin\",\"id\":\"did.chaisemartin\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"An estimator built for panels where treatment switches on and off, which the imputation and cohort estimators assume never happens.\",\"title\":\"de Chaisemartin & D'Haultfoeuille\"},{\"explain_key\":\"method.did.event_study\",\"id\":\"did.event_study\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Plot the effect period by period around adoption, so you can see whether the gap opened when the policy arrived or long before it.\",\"title\":\"Event study (leads and lags)\"},{\"explain_key\":\"method.did.gardner_2s\",\"id\":\"did.gardner_2s\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Strip out unit and period effects using untreated cells only, then regress what is left on the policy.\",\"title\":\"Two-stage DiD (Gardner / Wooldridge-Mundlak)\"},{\"explain_key\":\"method.did.goodman_bacon\",\"id\":\"did.goodman_bacon\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Open up a two-way fixed effects estimate and show every two-group comparison inside it, with the weight each one carries -- including the ones that use already-treated units as controls.\",\"title\":\"Goodman-Bacon decomposition\"}],\"status\":\"recommended\",\"status_label\":\"Recommended\",\"tags\":[\"Policy rolled out over time\",\"ATT\",\"Recommended\"],\"title\":\"Doubly robust DiD\",\"what_it_assumes\":[{\"explain_key\":\"assumption.parallel_trends\",\"explains\":\"Without the policy, treated and comparison groups would have moved the same way. Not that they were at the same level -- that their paths would have been parallel.\",\"id\":\"parallel_trends\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Parallel trends\",\"worry_when\":\"Pre-period event-study coefficients drift away from zero; the policy was adopted because outcomes were already moving; the groups differ in composition in ways that interact with time.\"},{\"explain_key\":\"assumption.no_anticipation\",\"explains\":\"Units did not change behaviour before treatment arrived because they knew it was coming.\",\"id\":\"no_anticipation\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No anticipation\",\"worry_when\":\"There was a public announcement well before the policy started, or the pre-period coefficients move in the period immediately before adoption.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"when_not_to_use\":[\"Doubly robust is not doubly safe. When some units are almost certain to be adopters, the weights blow up and the outcome model quietly takes over by extrapolation. It says nothing at all about confounders you did not measure, and nothing about trends that differ for reasons the covariates do not capture.\",\"Adoption is staggered -- the doubly robust 2x2 still works cohort by cohort, but did.callaway_santanna is the same thing with the aggregations and the simultaneous bands.\"],\"when_to_use\":[\"When parallel trends is only credible after conditioning on covariates, this is the estimator that does the conditioning properly: it is consistent if the model for the comparison group's change is right, or if the model for who adopted is right.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\",\"some of the robustness probes it names have no card of their own yet\"],\"id\":\"did.dr_did\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"did.dr_did\",\"registry\":{\"designs\":[\"did\"],\"diagnostics\":[\"raw_means\",\"adoption\",\"panel_balance\",\"comparison_group\",\"cohort_att\",\"event_study\",\"pre_trends\",\"group_time_att\",\"overlap\"],\"disrecommend_when\":\"Adoption is staggered -- the doubly robust 2x2 still works cohort by cohort, but did.callaway_santanna is the same thing with the aggregations and the simultaneous bands.\",\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":true,\"r\":\"DRDID\"},\"estimands\":[\"ATT\"],\"explain_key\":\"method.did.dr_did\",\"id\":\"did.dr_did\",\"needs\":[\"numpy\",\"scipy\",\"pandas\"],\"needs_overlap\":true,\"one_liner\":\"One before-and-after with covariates, using an outcome model and a comparison-group model together so either one can carry it.\",\"options\":[{\"choices\":[\"dr\",\"ipw\",\"reg\"],\"default\":\"dr\",\"help\":\"Doubly robust uses an outcome model and a comparison-group model together and is right if either is. IPW reweights the comparison group; Reg models the change in the outcome. With no covariates all three are the same plain difference of differences.\",\"label\":\"How each 2x2 adjusts for covariates\",\"name\":\"est_method\",\"profile\":\"standard\",\"type\":\"select\"},{\"choices\":[\"never_treated\",\"not_yet_treated\"],\"default\":\"never_treated\",\"help\":\"Units that never adopt are the cleanest comparison. Units that have not adopted yet give you more of them, at the cost of assuming the late adopters were on the same path. If nobody stays untreated the estimator switches to not-yet-treated on its own and says so.\",\"label\":\"Compare adopters with\",\"name\":\"control_group\",\"profile\":\"standard\",\"type\":\"select\"},{\"default\":0.001,\"help\":\"Bounds the weights when a unit is almost certain to be in the adopting cohort. Clipping is counted and reported, never silent.\",\"label\":\"Clip comparison-group probabilities at\",\"max\":0.2,\"min\":0.0,\"name\":\"clip\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":0.95,\"help\":\"Width of the interval reported next to the estimate.\",\"label\":\"Confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":false,\"help\":\"A pointwise interval is right for one period and wrong for the picture: read five periods at once and one will fall outside by chance. This widens the band so the whole path is covered together.\",\"label\":\"Simultaneous band on the event study\",\"name\":\"cband\",\"profile\":\"standard\",\"type\":\"bool\"},{\"default\":1000,\"help\":\"Multiplier-bootstrap draws for the simultaneous band. Seeded by the run seed, so the band is reproducible.\",\"label\":\"Bootstrap draws\",\"max\":20000,\"min\":99,\"name\":\"boot_reps\",\"profile\":\"advanced\",\"type\":\"int\"}],\"probes\":[\"placebo_outcome\",\"placebo_period\",\"alternate_spec\",\"leave_one_cohort_out\"],\"reference_dispositions\":[{\"disposition\":\"resolved_metadata\",\"id\":\"santanna2020\",\"requested_as\":\"Sant'Anna and Zhao (2020), Doubly robust difference-in-differences estimators\"},{\"disposition\":\"resolved_metadata\",\"id\":\"abadie2005\",\"requested_as\":\"Abadie (2005), Semiparametric difference-in-differences estimators\"}],\"reference_ids\":[\"santanna2020\",\"abadie2005\"],\"references\":[\"Sant'Anna and Zhao (2020), Doubly robust difference-in-differences estimators\",\"Abadie (2005), Semiparametric difference-in-differences estimators\"],\"roles_forbidden\":[\"running\",\"instruments\"],\"roles_optional\":[\"cluster\",\"weight\",\"confounders\"],\"roles_required\":[\"treatment\",\"outcome\",\"unit\",\"time\"],\"source_path\":\"engines/python/capy_py/did_modern.py\",\"source_sha256\":\"f5546f580cd2c75174a6cb550cf3b66ca1a008151067f52513cafaa766ebfe16\",\"status\":\"recommended\",\"title\":\"Doubly robust DiD\",\"what_can_go_wrong\":\"Doubly robust is not doubly safe. When some units are almost certain to be adopters, the weights blow up and the outcome model quietly takes over by extrapolation. It says nothing at all about confounders you did not measure, and nothing about trends that differ for reasons the covariates do not capture.\",\"why_recommended\":\"When parallel trends is only credible after conditioning on covariates, this is the estimator that does the conditioning properly: it is consistent if the model for the comparison group's change is right, or if the model for who adopted is right.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:0eba96126ad3fec10582e821\",\"object_id\":\"diagnostic:panel_balance\",\"predicate\":\"checked_by_diagnostic\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"did.dr_did\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:15d6ed0f466bc91a8a7d2587\",\"object_id\":\"concept:donor-pool\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"abadie2010\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_con