<urn:capy:rct.cace> a capy:method ; skos:prefLabel "ITT and CACE (noncompliance)" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:rct.cace\"],\"catalogue_key\":\"method:rct.cace\",\"citation_ids\":[\"10.1177/0193841x8400800205\",\"10.2307/2951620\",\"angrist1996\",\"source:unresolved:12d5c830da10862dd1b8\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":null,\"engines\":{\"python\":true,\"r\":\"ivreg, estimatr (iv_robust), AER\"},\"needs_r_packages\":[\"ivreg, estimatr (iv_robust), AER\"],\"runs_here\":true,\"summary\":\"Runs on this computer with what the app already installs.\"},\"designs\":[{\"explain_key\":\"design.rct\",\"id\":\"rct\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"People were assigned by chance, or as good as chance.\",\"title\":\"Randomised or as-if randomised\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.compliance\",\"id\":\"compliance\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Compliance with assignment\"},{\"explain_key\":\"diagnostic.baseline_balance\",\"id\":\"baseline_balance\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Baseline balance\"},{\"explain_key\":\"diagnostic.differential_attrition\",\"id\":\"differential_attrition\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Differential attrition\"},{\"explain_key\":\"diagnostic.outcome_distribution\",\"id\":\"outcome_distribution\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Outcome distribution\"}],\"estimands\":[{\"acronym\":\"ITT\",\"explain_key\":\"estimand.itt\",\"id\":\"ITT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For everyone who was offered it, what did the offer do?\",\"title\":\"Intention to treat\"},{\"acronym\":\"CACE\",\"explain_key\":\"estimand.cace\",\"id\":\"CACE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For the people who comply with what they were offered, what did it do?\",\"title\":\"Complier average causal effect\"},{\"acronym\":\"LATE\",\"explain_key\":\"estimand.late\",\"id\":\"LATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who only got it because of the instrument or the cutoff, what did it do?\",\"title\":\"Local average treatment effect\"}],\"explain_key\":\"method.rct.cace\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"rct.cace\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":false,\"one_liner\":\"Not everyone offered a programme takes it. Report what the offer did, and separately what taking it up did for the people it moved.\",\"options\":[{\"default\":null,\"help\":\"The 0/1 column recording who actually received the programme. Leave blank if you put the offer in the instrument slot and take-up in the treatment slot.\",\"label\":\"Take-up variable\",\"name\":\"takeup\",\"profile\":\"standard\",\"type\":\"string\"},{\"choices\":[\"cace\",\"itt\"],\"default\":\"cace\",\"help\":\"Both are always reported. The ITT is the effect of the policy as it would be rolled out; the CACE is the effect on those the offer moved.\",\"label\":\"Which number leads\",\"name\":\"headline\",\"profile\":\"standard\",\"type\":\"select\"},{\"default\":true,\"help\":\"Covariates enter both equations additively, exactly as they would in 2SLS.\",\"label\":\"Adjust for baseline covariates\",\"name\":\"adjust\",\"profile\":\"standard\",\"type\":\"bool\"},{\"default\":1000,\"help\":\"A second opinion on the ratio's interval, which the delta method approximates poorly when take-up barely moves. Set to 0 to skip.\",\"label\":\"Bootstrap resamples\",\"max\":20000,\"min\":0,\"name\":\"bootstrap_reps\",\"profile\":\"advanced\",\"type\":\"int\"},{\"choices\":[\"HC0\",\"HC1\",\"HC2\",\"HC3\"],\"default\":\"HC2\",\"help\":\"HC2 is the default because for a two-arm contrast it reproduces Neyman's variance exactly. HC3 is more conservative in small samples; HC1 is the Stata default.\",\"label\":\"Robust variance\",\"name\":\"vcov\",\"profile\":\"advanced\",\"type\":\"select\"},{\"default\":0.95,\"help\":\"The coverage of the interval reported next to the estimate.\",\"label\":\"Confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"}],\"plain_language\":\"Not everyone offered a programme takes it. Report what the offer did, and separately what taking it up did for the people it moved.\",\"probes\":[{\"explain_key\":\"probe.placebo_outcome\",\"id\":\"probe.placebo_outcome\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the same analysis on something the treatment could not have changed. It should find nothing.\",\"requested_as\":\"placebo_outcome\",\"title\":\"Placebo outcome\"},{\"explain_key\":\"probe.alternate_spec\",\"id\":\"probe.alternate_spec\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the grid of defensible specifications and sort the answers. The curve is the result, not the one you happened to run.\",\"requested_as\":\"alternate_spec\",\"title\":\"Specification curve\"},{\"explain_key\":\"probe.subset\",\"id\":\"probe.subset\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Re-estimate on random subsets. The answer should move about as much as losing that much data costs, and no more.\",\"requested_as\":\"subset_refuter\",\"title\":\"Subset stability\"},{\"explain_key\":\"method.rct.randomization_inference\",\"id\":\"rct.randomization_inference\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Re-run the randomisation thousands of times with the outcomes held fixed, and see how unusual what actually happened really is.\",\"requested_as\":\"randomization_inference\",\"title\":\"Randomisation (Fisher) inference\"}],\"references\":[\"Bloom (1984), Accounting for No-Shows in Experimental Evaluation Designs\",\"Imbens and Angrist (1994), Identification and Estimation of Local Average Treatment Effects\",\"Angrist, Imbens and Rubin (1996), Identification of Causal Effects Using Instrumental Variables\",\"Gerber and Green (2012), Field Experiments: Design, Analysis, and Interpretation\"],\"roles_forbidden\":[\"a running variable\"],\"roles_optional\":[\"an instrument\",\"at least one measured confounder\",\"a clustering variable\"],\"roles_required\":[\"a treatment\",\"an outcome\"],\"see_also\":[{\"explain_key\":\"design.rct\",\"id\":\"rct\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"People were assigned by chance, or as good as chance.\",\"title\":\"Randomised or as-if randomised\"},{\"explain_key\":\"method.rct.cluster\",\"id\":\"rct.cluster\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"When whole schools, clinics or villages were assigned, the number of clusters is the sample size that matters.\",\"title\":\"Cluster-randomised trial\"},{\"explain_key\":\"method.rct.diff_means\",\"id\":\"rct.diff_means\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Compare the two arms as they were randomised, and let covariates sharpen the comparison without letting them change the question.\",\"title\":\"Difference in means\"},{\"explain_key\":\"method.rct.randomization_inference\",\"id\":\"rct.randomization_inference\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Re-run the randomisation thousands of times with the outcomes held fixed, and see how unusual what actually happened really is.\",\"title\":\"Randomisation (Fisher) inference\"},{\"explain_key\":\"method.rct.stratified\",\"id\":\"rct.stratified\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Estimate inside the blocks the randomisation was run in, then average them the way your estimand says to.\",\"title\":\"Blocked or stratified experiment\"}],\"status\":\"recommended\",\"status_label\":\"Recommended\",\"tags\":[\"Randomised or as-if randomised\",\"ITT\",\"CACE\",\"LATE\",\"Recommended\"],\"title\":\"ITT and CACE (noncompliance)\",\"what_it_assumes\":[{\"explain_key\":\"assumption.randomisation\",\"explains\":\"Assignment really was by chance, and nothing after assignment broke the comparison -- no differential dropout, no crossover you have not modelled.\",\"id\":\"randomisation\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Randomisation held\",\"worry_when\":\"Dropout differs across arms; take-up is far from assignment; the randomiser was a person with discretion.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"when_not_to_use\":[\"The CACE needs the exclusion restriction -- the offer must not affect the outcome except through take-up, which unblinded trials break routinely -- and monotonicity, which cannot be tested. It describes compliers, a group nobody can point at in the data, and it is not transportable to a place where different people would comply. The delta-method interval degrades as the first stage weakens; the bootstrap interval is reported alongside for that reason. No weak-instrument-robust (Anderson-Rubin) set is computed here.\",\"Take-up moves by less than a few percentage points -- the ratio is then a small denominator away from meaningless; report the ITT.\"],\"when_to_use\":[\"Take-up was imperfect, so the difference between the arms measures the offer and not the programme. Reporting only one of the two numbers hides which question was answered.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"rct.cace\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"rct.cace\",\"registry\":{\"designs\":[\"rct\"],\"diagnostics\":[\"compliance\",\"baseline_balance\",\"differential_attrition\",\"outcome_distribution\"],\"disrecommend_when\":\"Take-up moves by less than a few percentage points -- the ratio is then a small denominator away from meaningless; report the ITT.\",\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":true,\"r\":\"ivreg, estimatr (iv_robust), AER\"},\"estimands\":[\"ITT\",\"CACE\",\"LATE\"],\"explain_key\":\"method.rct.cace\",\"id\":\"rct.cace\",\"needs\":[\"numpy\",\"pandas\",\"scipy\"],\"needs_overlap\":false,\"one_liner\":\"Not everyone offered a programme takes it. Report what the offer did, and separately what taking it up did for the people it moved.\",\"options\":[{\"default\":null,\"help\":\"The 0/1 column recording who actually received the programme. Leave blank if you put the offer in the instrument slot and take-up in the treatment slot.\",\"label\":\"Take-up variable\",\"name\":\"takeup\",\"profile\":\"standard\",\"type\":\"string\"},{\"choices\":[\"cace\",\"itt\"],\"default\":\"cace\",\"help\":\"Both are always reported. The ITT is the effect of the policy as it would be rolled out; the CACE is the effect on those the offer moved.\",\"label\":\"Which number leads\",\"name\":\"headline\",\"profile\":\"standard\",\"type\":\"select\"},{\"default\":true,\"help\":\"Covariates enter both equations additively, exactly as they would in 2SLS.\",\"label\":\"Adjust for baseline covariates\",\"name\":\"adjust\",\"profile\":\"standard\",\"type\":\"bool\"},{\"default\":1000,\"help\":\"A second opinion on the ratio's interval, which the delta method approximates poorly when take-up barely moves. Set to 0 to skip.\",\"label\":\"Bootstrap resamples\",\"max\":20000,\"min\":0,\"name\":\"bootstrap_reps\",\"profile\":\"advanced\",\"type\":\"int\"},{\"choices\":[\"HC0\",\"HC1\",\"HC2\",\"HC3\"],\"default\":\"HC2\",\"help\":\"HC2 is the default because for a two-arm contrast it reproduces Neyman's variance exactly. HC3 is more conservative in small samples; HC1 is the Stata default.\",\"label\":\"Robust variance\",\"name\":\"vcov\",\"profile\":\"advanced\",\"type\":\"select\"},{\"default\":0.95,\"help\":\"The coverage of the interval reported next to the estimate.\",\"label\":\"Confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"}],\"probes\":[\"placebo_outcome\",\"alternate_spec\",\"subset_refuter\",\"randomization_inference\"],\"reference_dispositions\":[{\"disposition\":\"resolved_metadata\",\"id\":\"10.1177/0193841x8400800205\",\"requested_as\":\"Bloom (1984), Accounting for No-Shows in Experimental Evaluation Designs\"},{\"disposition\":\"resolved_metadata\",\"id\":\"10.2307/2951620\",\"requested_as\":\"Imbens and Angrist (1994), Identification and Estimation of Local Average Treatment Effects\"},{\"disposition\":\"resolved_metadata\",\"id\":\"angrist1996\",\"requested_as\":\"Angrist, Imbens and Rubin (1996), Identification of Causal Effects Using Instrumental Variables\"},{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:12d5c830da10862dd1b8\",\"requested_as\":\"Gerber and Green (2012), Field Experiments: Design, Analysis, and Interpretation\"}],\"reference_ids\":[\"10.1177/0193841x8400800205\",\"10.2307/2951620\",\"angrist1996\",\"source:unresolved:12d5c830da10862dd1b8\"],\"references\":[\"Bloom (1984), Accounting for No-Shows in Experimental Evaluation Designs\",\"Imbens and Angrist (1994), Identification and Estimation of Local Average Treatment Effects\",\"Angrist, Imbens and Rubin (1996), Identification of Causal Effects Using Instrumental Variables\",\"Gerber and Green (2012), Field Experiments: Design, Analysis, and Interpretation\"],\"roles_forbidden\":[\"running\"],\"roles_optional\":[\"instruments\",\"confounders\",\"cluster\"],\"roles_required\":[\"treatment\",\"outcome\"],\"source_path\":\"engines/python/capy_py/rct.py\",\"source_sha256\":\"ad0630960d6aaff7fdef9a290c97dcb094099f646bd6ff87151d786a5604baa8\",\"status\":\"recommended\",\"title\":\"ITT and CACE (noncompliance)\",\"what_can_go_wrong\":\"The CACE needs the exclusion restriction -- the offer must not affect the outcome except through take-up, which unblinded trials break routinely -- and monotonicity, which cannot be tested. It describes compliers, a group nobody can point at in the data, and it is not transportable to a place where different people would comply. The delta-method interval degrades as the first stage weakens; the bootstrap interval is reported alongside for that reason. No weak-instrument-robust (Anderson-Rubin) set is computed here.\",\"why_recommended\":\"Take-up was imperfect, so the difference between the arms measures the offer and not the programme. Reporting only one of the two numbers hides which question was answered.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:141b42b59115872e794df658\",\"object_id\":\"angrist1996\",\"predicate\":\"cites\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"rct.cace\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:17b13080c25cbc487a879ed7\",\"object_id\":\"concept:synthetic-control\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"abadie2010\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"rct.cace\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:18f3b98dc295cfd5c16ca95d\",\"object_id