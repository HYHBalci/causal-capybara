ified causal effect.\",\"subject_id\":\"rd.fuzzy\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:d78aad4d44a334549b15483d\",\"object_id\":\"concept:causal-estimands\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:ich2019\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"rd.fuzzy\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:e08866383988cab3d2c7a290\",\"object_id\":\"diagnostic:manipulation\",\"predicate\":\"checked_by_diagnostic\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"rd.fuzzy\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:f1fd8c950673429b16fba124\",\"object_id\":\"concept:causal-foundations\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:pearl2009\",\"source:ontology:rubin2008\",\"hernan2020\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"rd.fuzzy\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:f9c50206f4965f30c56c43ef\",\"object_id\":\"concept:causal-framing\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:pearl2009\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"rd.fuzzy\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:fec666ed6136104bfd7edbfe\",\"object_id\":\"diagnostic:bandwidth_sensitivity\",\"predicate\":\"checked_by_diagnostic\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"rd.fuzzy\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Divide the jump in the outcome by the jump in take-up: the effect for the people the cutoff actually moved.\",\"title\":\"Fuzzy RD (crossing the cutoff only nudged people in)\"}" .
<urn:capy:rd.kink> a capy:method ; skos:prefLabel "Regression kink (the rule bends, it does not switch)" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:rd.kink\"],\"catalogue_key\":\"method:rd.kink\",\"citation_ids\":[\"10.1016/j.jeconom.2007.05.001\",\"calonico2014\",\"source:unresolved:179f2828781ef26e5dd8\",\"source:unresolved:afa378e198697172e867\",\"source:unresolved:df3e0fc0efd97b70d940\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":null,\"engines\":{\"python\":true,\"r\":\"rdrobust\"},\"needs_r_packages\":[\"rdrobust\"],\"runs_here\":true,\"summary\":\"Runs on this computer with what the app already installs.\"},\"designs\":[{\"explain_key\":\"design.rd\",\"id\":\"rd\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Crossing a score, age, or border switched the programme on.\",\"title\":\"A cutoff decided eligibility\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.rd_plot\",\"id\":\"rd_plot\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Binned scatter at the cutoff\"},{\"explain_key\":\"diagnostic.level_jump_at_kink\",\"id\":\"level_jump_at_kink\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Level jump at a kink\"},{\"explain_key\":\"diagnostic.bias_correction\",\"id\":\"bias_correction\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Bias correction and robust interval\"},{\"explain_key\":\"diagnostic.bandwidth_sensitivity\",\"id\":\"bandwidth_sensitivity\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Bandwidth sensitivity path\"},{\"explain_key\":\"diagnostic.running_variable_discreteness\",\"id\":\"running_variable_discreteness\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Discreteness of the running variable\"},{\"explain_key\":\"diagnostic.manipulation\",\"id\":\"manipulation\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Density at the cutoff\"},{\"explain_key\":\"diagnostic.covariate_balance\",\"id\":\"covariate_balance\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Covariate balance\"}],\"estimands\":[{\"acronym\":null,\"explain_key\":null,\"id\":\"slope_change\",\"in_catalogue\":false,\"kind\":\"estimand\",\"one_liner\":null,\"title\":\"Change in slope at the cutoff\"}],\"explain_key\":\"method.rd.kink\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\",\"targets Change in slope at the cutoff, which the estimand catalogue does not define yet\"],\"id\":\"rd.kink\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":false,\"one_liner\":\"Where a formula changes slope rather than switching on, measure the change in slope of the outcome.\",\"options\":[{\"default\":2,\"help\":\"A slope needs at least a quadratic. 2 is the default, matching the usual p = derivative + 1 convention.\",\"label\":\"Polynomial order either side\",\"max\":4,\"min\":2,\"name\":\"polynomial_order\",\"profile\":\"standard\",\"type\":\"int\"},{\"choices\":[\"mse\",\"ik\"],\"default\":\"mse\",\"help\":\"'mse' is capy's own finite-sample plug-in rule: it measures the bias and variance of this estimator on this sample. 'ik' is the Imbens-Kalyanaraman (2012) formula, for a sharp local linear fit only. Neither is rdrobust's CCT selector.\",\"label\":\"How to choose the window\",\"name\":\"bandwidth_selector\",\"profile\":\"standard\",\"type\":\"select\"},{\"default\":null,\"help\":\"The half-width of the window either side of the cutoff, in the units of the running variable. Setting it by hand overrides the selector; the sensitivity path shows you what every other choice would have given.\",\"label\":\"Bandwidth (leave empty to choose one)\",\"min\":0.0,\"name\":\"bandwidth\",\"profile\":\"standard\",\"type\":\"number\"},{\"default\":0.0,\"help\":\"Drop units within this distance of the cutoff, where heaping and manipulation live. Every dropped row appears in the sample flow.\",\"label\":\"Donut hole radius\",\"min\":0.0,\"name\":\"donut\",\"profile\":\"standard\",\"type\":\"number\"},{\"choices\":[\"triangular\",\"epanechnikov\",\"uniform\"],\"default\":\"triangular\",\"help\":\"Triangular gives the most weight to units closest to the cutoff, which is what the MSE-optimal theory assumes. Uniform is the plain 'everyone inside the window counts equally' choice.\",\"label\":\"Weighting near the cutoff\",\"name\":\"kernel\",\"profile\":\"advanced\",\"type\":\"select\"},{\"default\":null,\"help\":\"The wider window used by the higher-order fit that estimates the smoothing bias.\",\"label\":\"Bias-correction pilot bandwidth\",\"min\":0.0,\"name\":\"pilot_bandwidth\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":false,\"help\":\"Off by default: in RD the covariates are how you check the design, not how you fix it. Turning this on tightens the interval a little and slightly changes the estimand.\",\"label\":\"Put the covariates in the local regression\",\"name\":\"covariate_adjust\",\"profile\":\"advanced\",\"type\":\"bool\"},{\"choices\":[\"HC0\",\"HC1\",\"HC2\",\"HC3\"],\"default\":\"HC1\",\"help\":\"Heteroskedasticity-robust. HC3 is more conservative in small windows. Set the cluster role as well and the variance becomes cluster-robust.\",\"label\":\"Standard errors\",\"name\":\"vce\",\"profile\":\"advanced\",\"type\":\"select\"},{\"default\":0.95,\"help\":\"0.95 unless you have a reason.\",\"label\":\"Confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":0,\"help\":\"0 picks about 2 n^(1/3) bins a side.\",\"label\":\"Bins per side in the plot\",\"max\":100,\"min\":0,\"name\":\"plot_bins\",\"profile\":\"advanced\",\"type\":\"int\"},{\"choices\":[\"quantile\",\"evenly\"],\"default\":\"quantile\",\"help\":\"Quantile bins hold the same number of units each; even bins hold the same width each.\",\"label\":\"Bin spacing\",\"name\":\"plot_bin_spacing\",\"profile\":\"advanced\",\"type\":\"select\"}],\"plain_language\":\"Where a formula changes slope rather than switching on, measure the change in slope of the outcome.\",\"probes\":[{\"explain_key\":\"probe.placebo_outcome\",\"id\":\"probe.placebo_outcome\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the same analysis on something the treatment could not have changed. It should find nothing.\",\"requested_as\":\"probe.placebo_outcome\",\"title\":\"Placebo outcome\"},{\"explain_key\":\"probe.subset\",\"id\":\"probe.subset\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Re-estimate on random subsets. The answer should move about as much as losing that much data costs, and no more.\",\"requested_as\":\"probe.subset\",\"title\":\"Subset stability\"},{\"explain_key\":\"probe.alternate_spec\",\"id\":\"probe.alternate_spec\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the grid of defensible specifications and sort the answers. The curve is the result, not the one you happened to run.\",\"requested_as\":\"probe.alternate_spec\",\"title\":\"Specification curve\"}],\"references\":[\"Imbens & Lemieux (2008), Regression discontinuity designs: a guide to practice\",\"Calonico, Cattaneo & Titiunik (2014), Robust nonparametric confidence intervals for regression-discontinuity designs\",\"Imbens & Kalyanaraman (2012), Optimal bandwidth choice for the regression discontinuity estimator\",\"Cattaneo, Idrobo & Titiunik (2020), A practical introduction to regression discontinuity designs\",\"Card, Lee, Pei & Weber (2015), Inference on causal effects in a generalized regression kink design\"],\"roles_forbidden\":[\"an instrument\",\"forbidden\"],\"roles_optional\":[\"at least one measured confounder\",\"a clustering variable\",\"a treatment\"],\"roles_required\":[\"a running variable\",\"a cutoff\",\"an outcome\"],\"see_also\":[{\"explain_key\":\"design.rd\",\"id\":\"rd\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Crossing a score, age, or border switched the programme on.\",\"title\":\"A cutoff decided eligibility\"}],\"status\":\"reasonable\",\"status_label\":\"Reasonable\",\"tags\":[\"A cutoff decided eligibility\",\"Change in slope at the cutoff\",\"Reasonable\"],\"title\":\"Regression kink (the rule bends, it does not switch)\",\"what_it_assumes\":[{\"explain_key\":\"assumption.no_manipulation\",\"explains\":\"People could not precisely control which side of the cutoff they landed on.\",\"id\":\"no_manipulation\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No manipulation of the running variable\",\"worry_when\":\"A visible spike or gap in the density at the cutoff; covariates that jump; a cutoff that people knew about and had time to respond to.\"},{\"explain_key\":\"assumption.continuity\",\"explains\":\"Everything else that affects the outcome changes smoothly through the cutoff, so the only thing that jumps is the treatment.\",\"id\":\"continuity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Continuity of potential outcomes at the cutoff\",\"worry_when\":\"Several rules share the threshold; the running variable is coarse, so \\\"at the cutoff\\\" is really a wide band; the estimate depends heavily on the bandwidth.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"when_not_to_use\":[\"Estimating a derivative is far noisier than estimating a level, so kink designs need much more data than they look like they need, and they are more sensitive to curvature in the underlying relationship. The number is a change in slope -- per unit of the running variable -- and must never be reported as an effect size. This is capy.py's own local-polynomial code, not rdrobust. The bandwidth selector is named in the Classic tab and the variance is heteroskedasticity- or cluster-robust rather than rdrobust's nearest-neighbour estimator, so numbers will be close but need not match to the last digit.\",\"Fewer than a few thousand observations inside a plausible bandwidth\"],\"when_to_use\":[\"Benefit formulas, tax schedules and subsidy rules usually bend rather than switch. When that is the rule you have, the kink is the discontinuity, and reading it as a level jump would be wrong.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\",\"targets Change in slope at the cutoff, which the estimand catalogue does not define yet\"],\"id\":\"rd.kink\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"rd.kink\",\"registry\":{\"designs\":[\"rd\"],\"diagnostics\":[\"rd_plot\",\"level_jump_at_kink\",\"bias_correction\",\"bandwidth_sensitivity\",\"running_variable_discreteness\",\"manipulation\",\"covariate_balance\"],\"disrecommend_when\":\"Fewer than a few thousand observations inside a plausible bandwidth\",\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":true,\"r\":\"rdrobust\"},\"estimands\":[\"slope_change\"],\"explain_key\":\"method.rd.kink\",\"id\":\"rd.kink\",\"needs\":[\"numpy\",\"scipy\",\"pandas\"],\"needs_overlap\":false,\"one_liner\":\"Where a formula changes slope rather than switching on, measure the change in slope of the outcome.\",\"options\":[{\"default\":2,\"help\":\"A slope needs at least a quadratic. 2 is the default, matching the usual p = derivative + 1 convention.\",\"label\":\"Polynomial order either side\",\"max\":4,\"min\":2,\"name\":\"polynomial_order\",\"profile\":\"standard\",\"type\":\"int\"},{\"choices\":[\"mse\",\"ik\"],\"default\":\"mse\",\"help\":\"'mse' is capy's own finite-sample plug-in rule: it measures the bias and variance of this estimator on this sample. 'ik' is the Imbens-Kalyanaraman (2012) formula, for a sharp local linear fit only. Neither is rdrobust's CCT selector.\",\"label\":\"How to choose the window\",\"name\":\"bandwidth_selector\",\"profile\":\"standard\",\"type\":\"select\"},{\"default\":null,\"help\":\"The half-width of the window either side of the cutoff, in the units of the running variable. Setting it by hand overrides the selector; the sensitivity path shows you what every other choice would have given.\",\"label\":\"Bandwidth (leave empty to choose one)\",\"min\":0.0,\"name\":\"bandwidth\",\"profile\":\"standard\",\"type\":\"number\"},{\"default\":0.0,\"help\":\"Drop units within this distance of the cutoff, where heaping and manipulation live. Every dropped row appears in the sample flow.\",\"label\":\"Donut hole radius\",\"min\":0.0,\"name\":\"donut\",\"profile\":\"standard\",\"type\":\"number\"},{\"choices\":[\"triangular\",\"epanechnikov\",\"uniform\"],\"default\":\"triangular\",\"help\":\"Triangular gives the most weight to units closest to the cutoff, which is what the MSE-optimal theory assumes. Uniform is the plain 'everyone inside the window counts equally' choice.\",\"label\":\"Weighting near the cutoff\",\"name\":\"kernel\",\"profile\":\"advanced\",\"type\":\"select\"},{\"default\":null,\"help\":\"The wider window used by the higher-order fit that estimates the smoothing bias.\",\"label\":\"Bias-correction pilot bandwidth\",\"min\":0.0,\"name\":\"pilot_bandwidth\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":false,\"help\":\"Off by default: in RD the covariates are how you check the design, not how you fix it. Turning this on tightens the interval a little and slightly changes the estimand.\",\"label\":\"Put the covariates in the local regression\",\"name\":\"covariate_adjust\",\"profile\":\"advanced\",\"type\":\"bool\"},{\"choices\":[\"HC0\",\"HC1\",\"HC2\",\"HC3\"],\"default\":\"HC1\",\"help\":\"Heteroskedasticity-robust. HC3 is more conservative in small windows. Set the cluster role as well and the variance becomes cluster-robust.\",\"label\":\"Standard errors\",\"name\":\"vce\",\"profile\":\"advanced\",\"type\":\"select\"},{\"default\":0.95,\"help\":\"0.95 unless you have a reason.\",\"label\":\"Confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":0,\"help\":\"0 picks about 2 n^(1/3) bins a side.\",\"label\":\"Bins per side in the plot\",\"max\":100,\"min\":0,\"name\":\"plot_bins\",\"profile\":\"advanced\",\"type\":\"int\"},{\"choices\":[\"quantile\",\"evenly\"],\"default\":\"quantile\",\"help\":\"Quantile bins hold the same number of units each; even bins hold the same width each.\",\"label\":\"Bin spacing\",\"name\":\"plot_bin_spacing\",\"profile\":\"advanced\",\"type\":\"select\"}],\"probes\":[\"probe.placebo_outcome\",\"probe.subset\",\"probe.alternate_spec\"],\"reference_dispositions\":[{\"disposition\":\"resolved_metadata\",\"id\":\"10.1016/j.jeconom.2007.05.001\",\"requested_as\":\"Imbens & Lemieux (2008), Regression discontinuity designs: a guide to practice\"},{\"disposition\":\"resolved_metadata\",\"id\":\"calonico2014\",\"requested_as\":\"Calonico, Cattaneo & Titiunik (2014), Robust nonparametric confidence intervals for regression-discontinuity designs\"},{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:179f2828781ef26e5dd8\",\"requested_as\":\"Imbens & Kalyanaraman (2012), Optimal bandwidth choice for the regression discontinuity estimator\"},{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:afa378e198697172e867\",\"requested_as\":\"Cattaneo, Idrobo & Titiunik (2020), A practical introduction to regression discontinuity designs\"},{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:df3e0fc0efd97b70d940\",\"requested_as\":\"Card, Lee, Pei & Weber (2015), Inference on causal effects in a generalized regression kink design\"}],\"reference_ids\":[\"10.1016/j.jeconom.2007.05.001\",\"calonico2014\",\"source:unresolved:179f2828781ef26e5dd8\",\"source:unresolved:afa378e198697172e867\",\"source:unresolved:df3e0fc0efd97b70d940\"],\"references\":[\"Imbens & Lemieux (2008), Regression discontinuity designs: a guide to practice\",\"Calonico, Cattaneo & Titiunik (2014), Robust nonparametric confidence intervals for regression-discontinuity designs\",\"Imbens & Kalyanaraman (2012), Optimal bandwidth choice for the regression discontinuity estimator\",\"Cattaneo, Idrobo & Titiunik (2020), A practical introduction to regression discontinuity designs\",\"Card, Lee, Pei & Weber (2015), Inference on causal effects in a generalized regression kink design\"],\"roles_forbidden\":[\"instruments\",\"forbidden\"],\"roles_optional\":[\"confounders\",\"cluster\",\"treatment\"],\"roles_required\":[\"running\",\"cutoff\",\"outcome\"],\"source_path\":\"engines/python/capy_py/rd.py\",\"source_sha256\":\"a86f14c44b23637b2b7378f638cdbfba5ad3bdcb0ed99ee9af783e9f071548bf\",\"status\":\"reasonable\",\"title\":\"Regression kink (the rule bends, it does not switch)\",\"what_can_go_wrong\":\"Estimating a derivative is far noisier than estimating a level, so kink designs need much more data than they look like they need, and they are more sensitive to curvature in the underlying relationship. The number is a change in slope -- per unit of the running variable -- and must never be reported as an effect size. This is capy.py's own local-polynomial code, not rdrobust. The bandwidth selector is named in the Classic tab and the variance is heteroskedasticity- or cluster-robust rather than rdrobust's nearest-neighbour estimator, so numbers will be close but need not match to the last digit.\",\"why_recommended\":\"Benefit formulas, tax schedules and subsidy rules usually bend rather than switch. When that is the rule you have, the kink is the discontinuity, and reading it as a level jump would be wrong.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:092d732258e34744aab7d20b\",\"object_id\":\"10.1016/j.jeconom.2007.05.001\",\"predicate\":\"cites\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"rd.kink\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:0fd04bba0439f40c75141ac2\",\"object_id\":\"diagnostic:level_jump_at_kink\",\"predicate\":\"checked_by_diagnostic\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"rd.kink\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:14b2c3a963180620cc9cef2c\",\"object_id\":\"concept:estimand-estimator-estimate\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:ich2019\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subjec