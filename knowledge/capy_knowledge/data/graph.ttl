<urn:capy:did.matched> a capy:method ; skos:prefLabel "Matched difference-in-differences" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:did.matched\"],\"catalogue_key\":\"method:did.matched\",\"citation_ids\":[\"10.1111/1475-6773.12993\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":\"Not wrapped as one method. You can match first and estimate the DiD on the matched project.\",\"engines\":{\"python\":false,\"r\":\"MatchIt\"},\"needs_r_packages\":[\"MatchIt\",\"did\"],\"runs_here\":false,\"summary\":\"Not built into the app yet. The authoritative version is the R package MatchIt, which the Engines screen can install for you.\"},\"designs\":[{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.love\",\"id\":\"love\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Covariate balance (Love plot)\"},{\"explain_key\":\"diagnostic.adoption\",\"id\":\"adoption\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Adoption pattern\"},{\"explain_key\":\"diagnostic.event_study\",\"id\":\"event_study\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Event study\"},{\"explain_key\":\"diagnostic.pre_trends\",\"id\":\"pre_trends\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Pre-trend test\"},{\"explain_key\":\"diagnostic.n_matched\",\"id\":\"n_matched\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Match quality\"}],\"estimands\":[{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"}],\"explain_key\":\"method.did.matched\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"did.matched\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":false,\"one_liner\":\"Match treated to comparison units on pre-period characteristics first, then difference.\",\"options\":[],\"plain_language\":\"Match treated to comparison units on pre-period characteristics first, then difference.\",\"probes\":[{\"explain_key\":\"probe.placebo_treatment\",\"id\":\"probe.placebo_treatment\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Move the policy date earlier, reshuffle who was treated, or swap in a variable that cannot cause the outcome.\",\"requested_as\":\"probe.placebo_treatment\",\"title\":\"Placebo treatment\"},{\"explain_key\":\"probe.honest_did\",\"id\":\"probe.honest_did\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"What survives when parallel trends is allowed to fail by a stated amount.\",\"requested_as\":\"probe.honest_did\",\"title\":\"Honest DiD (Rambachan-Roth)\"}],\"references\":[\"Daw & Hatfield (2018), Matching and regression to the mean in difference-in-differences\"],\"roles_forbidden\":[],\"roles_optional\":[],\"roles_required\":[\"a treatment\",\"an outcome\",\"a unit id\",\"a time variable\",\"at least one measured confounder\"],\"see_also\":[{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"},{\"explain_key\":\"method.did.bjs_imputation\",\"id\":\"did.bjs_imputation\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Learn what untreated life looks like from untreated cells only, then ask how far each treated cell landed from it.\",\"title\":\"Imputation (Borusyak-Jaravel-Spiess)\"},{\"explain_key\":\"method.did.callaway_santanna\",\"id\":\"did.callaway_santanna\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Estimate one clean before-and-after for every adoption cohort, then say out loud how you averaged them.\",\"title\":\"Callaway & Sant'Anna group-time effects\"},{\"explain_key\":\"method.did.chaisemartin\",\"id\":\"did.chaisemartin\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"An estimator built for panels where treatment switches on and off, which the imputation and cohort estimators assume never happens.\",\"title\":\"de Chaisemartin & D'Haultfoeuille\"},{\"explain_key\":\"method.did.dr_did\",\"id\":\"did.dr_did\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"One before-and-after with covariates, using an outcome model and a comparison-group model together so either one can carry it.\",\"title\":\"Doubly robust DiD\"},{\"explain_key\":\"method.did.event_study\",\"id\":\"did.event_study\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Plot the effect period by period around adoption, so you can see whether the gap opened when the policy arrived or long before it.\",\"title\":\"Event study (leads and lags)\"},{\"explain_key\":\"method.did.gardner_2s\",\"id\":\"did.gardner_2s\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Strip out unit and period effects using untreated cells only, then regress what is left on the policy.\",\"title\":\"Two-stage DiD (Gardner / Wooldridge-Mundlak)\"}],\"status\":\"reasonable\",\"status_label\":\"Reasonable\",\"tags\":[\"Policy rolled out over time\",\"ATT\",\"Reasonable\"],\"title\":\"Matched difference-in-differences\",\"what_it_assumes\":[{\"explain_key\":\"assumption.parallel_trends\",\"explains\":\"Without the policy, treated and comparison groups would have moved the same way. Not that they were at the same level -- that their paths would have been parallel.\",\"id\":\"parallel_trends\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Parallel trends\",\"worry_when\":\"Pre-period event-study coefficients drift away from zero; the policy was adopted because outcomes were already moving; the groups differ in composition in ways that interact with time.\"},{\"explain_key\":\"assumption.no_anticipation\",\"explains\":\"Units did not change behaviour before treatment arrived because they knew it was coming.\",\"id\":\"no_anticipation\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No anticipation\",\"worry_when\":\"There was a public announcement well before the policy started, or the pre-period coefficients move in the period immediately before adoption.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"when_not_to_use\":[\"Matching on the pre-period outcome invites regression to the mean, which manufactures an effect. Match on levels and trends, and check the pre-period afterwards.\"],\"when_to_use\":[\"When treated and comparison units differ so much that parallel trends is implausible for the full sample, it can hold for a matched subset.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"did.matched\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"did.matched\",\"registry\":{\"coming\":\"Not wrapped as one method. You can match first and estimate the DiD on the matched project.\",\"designs\":[\"did\"],\"diagnostics\":[\"love\",\"adoption\",\"event_study\",\"pre_trends\",\"n_matched\"],\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":false,\"r\":\"MatchIt\"},\"estimands\":[\"ATT\"],\"id\":\"did.matched\",\"one_liner\":\"Match treated to comparison units on pre-period characteristics first, then difference.\",\"probes\":[\"probe.placebo_treatment\",\"probe.honest_did\"],\"r_needs\":[\"MatchIt\",\"did\"],\"reference_dispositions\":[{\"disposition\":\"resolved_metadata\",\"id\":\"10.1111/1475-6773.12993\",\"requested_as\":\"Daw & Hatfield (2018), Matching and regression to the mean in difference-in-differences\"}],\"reference_ids\":[\"10.1111/1475-6773.12993\"],\"references\":[\"Daw & Hatfield (2018), Matching and regression to the mean in difference-in-differences\"],\"roles_required\":[\"treatment\",\"outcome\",\"unit\",\"time\",\"confounders\"],\"source_path\":\"engines/registry/methods.extra.yaml\",\"source_sha256\":\"2cb349e9f7f7e6f88c10c18d81478656fd420eda7ca977d9767610ac8c7a4be0\",\"status\":\"reasonable\",\"title\":\"Matched difference-in-differences\",\"what_can_go_wrong\":\"Matching on the pre-period outcome invites regression to the mean, which manufactures an effect. Match on levels and trends, and check the pre-period afterwards.\",\"why_recommended\":\"When treated and comparison units differ so much that parallel trends is implausible for the full sample, it can hold for a matched subset.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:06fd5e0c76505c69ce6d94ac\",\"object_id\":\"design:did\",\"predicate\":\"compatible_with_design\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"acto