":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Source context for original explanation; linked external bodies are not redistributed.\",\"subject_id\":\"concept:fixed-profile-inference\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Original explanation of Fixed-profile standardization inference; verify the exact target and local implementation.\",\"source_ids\":[\"hernan2020\",\"source:ontology:statsmodels-wald\"],\"summary\":\"A delta-method contrast based on fitted-parameter covariance conditions on the empirical profiles used for standardization. Inference for a superpopulation target additionally needs the relevant uncertainty from estimating its covariate distribution. Explicitly distinguish subgroup-restricted averages from controlled comparisons setting a continuous modifier to chosen values.\",\"title\":\"Fixed-profile standardization inference\"}" .
