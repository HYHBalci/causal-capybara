":[],\"gaps\":[\"No independent human scientific review or study-specific causal identification is established.\"],\"id\":\"relation:fef0548be2ef9225f7683f41\",\"object_id\":\"concept:missing-data\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"bang2005\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original methodological explanation checked against linked primary sources; no independent human review or study audit.\"],\"date\":\"2026-10-14\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Qualified methodological context for this declared method; this link does not assert an implemented test or identifying assumption.\",\"subject_id\":\"heterogeneity.binary\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Fit logistic treatment interactions and separately test standardized risk differences, risk ratios or marginal odds ratios.\",\"title\":\"Binary outcome heterogeneity\"}" .
<urn:capy:heterogeneity.categorical> a capy:method ; skos:prefLabel "Nominal and ordinal outcome heterogeneity" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:heterogeneity.categorical\"],\"catalogue_key\":\"method:heterogeneity.categorical\",\"citation_ids\":[\"altman2003\",\"kent2020\",\"knol2012\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":null,\"engines\":{\"python\":true,\"r\":false},\"needs_r_packages\":[],\"runs_here\":true,\"summary\":\"Runs on this computer with what the app already installs.\"},\"designs\":[{\"explain_key\":\"design.rct\",\"id\":\"rct\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"People were assigned by chance, or as good as chance.\",\"title\":\"Randomised or as-if randomised\"},{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.outcome_heterogeneity\",\"id\":\"outcome_heterogeneity\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Direct heterogeneity test on the selected outcome scale\"},{\"explain_key\":\"diagnostic.link_heterogeneity\",\"id\":\"link_heterogeneity\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Conditional treatment-by-modifier interaction\"}],\"estimands\":[{\"acronym\":\"CATE\",\"explain_key\":\"estimand.cate\",\"id\":\"CATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"How does the effect vary from person to person, or place to place?\",\"title\":\"Conditional average treatment effect\"},{\"acronym\":\"GATE\",\"explain_key\":\"estimand.gate\",\"id\":\"GATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"How does the effect vary across pre-specified groups?\",\"title\":\"Group average treatment effect\"}],\"explain_key\":\"method.heterogeneity.categorical\",\"gaps\":[],\"id\":\"heterogeneity.categorical\",\"in_more_depth\":\"A multinomial logit model retains treatment, baseline modifier main effects and their interactions. The modifier may be categorical or continuous with two declared evaluation values. Nominal or ordered outcome labels are analyzed as a full distribution; this is not a proportional-odds model or a common ordinal shift. Predictions are probabilities for each category. Because they sum to one, the joint marginal test uses an independent contrast basis and excludes one redundant category. HC0 or supported cluster sandwich covariance feeds delta inference. Displayed category-specific subgroup comparisons have a stated Holm family. Required category support, model convergence and covariance rank are checked.\",\"kind\":\"method\",\"needs_overlap\":true,\"one_liner\":\"Multinomial treatment interactions and a joint test of category-probability contrasts; preserves categories without assigning numeric scores.\",\"options\":[{\"default\":[],\"help\":\"Select one prespecified baseline variable. Categorical levels define subgroups; continuous mode evaluates two declared values without binning.\",\"label\":\"Baseline effect modifier\",\"max_items\":1,\"name\":\"subgroups\",\"profile\":\"beginner\",\"type\":\"columns\"},{\"default\":false,\"help\":\"Declare that the baseline modifier, coding, outcome and contrasts were chosen before inspecting effects. This declaration does not verify timing or scientific validity.\",\"label\":\"Modifier and contrasts were prespecified\",\"name\":\"subgroups_prespecified\",\"profile\":\"beginner\",\"type\":\"bool\"},{\"choices\":[\"categorical\",\"continuous\"],\"default\":\"categorical\",\"label\":\"Modifier type\",\"name\":\"modifier_type\",\"profile\":\"beginner\",\"type\":\"select\"},{\"default\":null,\"help\":\"An explicit scientifically meaningful value within both treatment arms' observed range.\",\"label\":\"Lower modifier value (continuous mode)\",\"name\":\"modifier_low\",\"profile\":\"standard\",\"type\":\"number\"},{\"default\":null,\"label\":\"Upper modifier value (continuous mode)\",\"name\":\"modifier_high\",\"profile\":\"standard\",\"type\":\"number\"},{\"default\":0.95,\"label\":\"Pointwise confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"standard\",\"type\":\"number\"}],\"plain_language\":\"Compare treatment-induced category-probability contrasts jointly without assigning numerical scores to labels.\",\"probes\":[],\"references\":[\"Altman and Bland (2003), Interaction revisited: the difference between two estimates\",\"Knol and VanderWeele (2012), Recommendations for presenting analyses of effect modification and interaction\",\"Kent et al. (2020), The Predictive Approaches to Treatment effect Heterogeneity (PATH) Statement\"],\"roles_forbidden\":[\"weight\",\"a time variable\",\"strata\",\"an instrument\",\"a running variable\",\"a mediator\",\"elapsed follow-up duration\",\"an event indicator (1 event, 0 right censored)\"],\"roles_optional\":[\"at least one measured confounder\",\"effect_modifiers\",\"a unit id\",\"a clustering variable\",\"forbidden\"],\"roles_required\":[\"a treatment\",\"an outcome\"],\"see_also\":[{\"explain_key\":\"design.rct\",\"id\":\"rct\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"People were assigned by chance, or as good as chance.\",\"title\":\"Randomised or as-if randomised\"},{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"},{\"explain_key\":\"diagnostic.outcome_heterogeneity\",\"id\":\"outcome_heterogeneity\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Direct heterogeneity test on the selected outcome scale\"},{\"explain_key\":\"diagnostic.link_heterogeneity\",\"id\":\"link_heterogeneity\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Conditional treatment-by-modifier interaction\"},{\"explain_key\":\"method.heterogeneity.binary\",\"id\":\"heterogeneity.binary\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Logistic interactions plus separate standardized risk-difference, risk-ratio or marginal odds-ratio heterogeneity tests.\",\"title\":\"Binary outcome heterogeneity\"},{\"explain_key\":\"method.heterogeneity.continuous\",\"id\":\"heterogeneity.continuous\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"OLS treatment-by-baseline-modifier interactions with HC3 or cluster sandwich inference, direct mean-difference tests and Holm pairwise comparisons.\",\"title\":\"Continuous outcome heterogeneity\"},{\"explain_key\":\"method.heterogeneity.count\",\"id\":\"heterogeneity.count\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Poisson conditional-mean interactions with robust sandwich inference; compare standardized count or fixed-exposure rate contrasts.\",\"title\":\"Count and rate outcome heterogeneity\"},{\"explain_key\":\"method.ml.causal_forest\",\"id\":\"ml.causal_forest\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Grow trees that look for units whose effect differs, keeping the rows that chose each split away from the rows that estimate it.\",\"title\":\"Honest causal forest\"},{\"explain_key\":\"method.ml.metalearner\",\"id\":\"ml.metalearner\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Build the per-unit effect out of ordinary prediction models, four different ways, on the same cross-fitting.\",\"title\":\"Meta-learner (T, S, X, DR)\"},{\"explain_key\":\"method.ml.policy_tree\",\"id\":\"ml.policy_tree\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Learn a short, readable rule for who to treat, then value that rule on data it never saw.\",\"title\":\"Policy tree (who should be treated)\"}],\"status\":\"recommended\",\"status_label\":\"Recommended\",\"tags\":[\"Randomised or as-if randomised\",\"Adjust for background differences\",\"CATE\",\"GATE\",\"Recommended\"],\"title\":\"Nominal and ordinal outcome heterogeneity\",\"what_it_assumes\":[{\"explain_key\":\"assumption.randomisation\",\"explains\":\"Assignment really was by chance, and nothing after assignment broke the comparison -- no differential dropout, no crossover you have not modelled.\",\"id\":\"randomisation\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Randomisation held\",\"worry_when\":\"Dropout differs across arms; take-up is far from assignment; the randomiser was a person with discretion.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"},{\"explain_key\":\"assumption.exchangeability\",\"explains\":\"Treated and untreated units are comparable once you condition on the confounders you measured. Everything that pushed people towards treatment and also moves the outcome is in your adjustment set.\",\"id\":\"exchangeability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Exchangeability / no unmeasured confounding\",\"worry_when\":\"Treatment was chosen by people who knew something about the likely outcome that you do not observe. Clinical judgement, self-selection into a programme, and administrative triage are the classic cases.\"},{\"explain_key\":\"assumption.positivity\",\"explains\":\"Every kind of unit had some chance of being treated and some chance of not being treated. Where that fails, there is no comparison to make and the model is inventing one.\",\"id\":\"positivity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Positivity / overlap\",\"worry_when\":\"Any single weight carries a large share of the total; the effective sample is far below the nominal one; the propensity model separates the arms almost perfectly; treated units sit outside the control group's range.\"}],\"when_not_to_use\":[\"Model-based baseline binary-treatment contrasts require correct conditional mean form and within-modifier support. Prespecification does not prove causality; model convergence and a significant interaction do not verify exchangeability. Delta inference conditions on empirical profiles. No outcome-driven subgroup discovery, panel/design-specific interactions or small-cluster correction.\"],\"when_to_use\":[\"Tests effect differences directly on a prespecified scale, with all interaction main effects and explicit sampling assumptions.\"]},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"heterogeneity.categorical\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"heterogeneity.categorical\",\"registry\":{\"designs\":[\"rct\",\"observational\"],\"diagnostics\":[\"outcome_heterogeneity\",\"link_heterogeneity\"],\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":true,\"r\":false},\"estimands\":[\"CATE\",\"GATE\"],\"explain_key\":\"method.heterogeneity.categorical\",\"id\":\"heterogeneity.categorical\",\"needs\":[\"numpy\",\"scipy\",\"statsmodels\"],\"needs_overlap\":true,\"one_liner\":\"Multinomial treatment interactions and a joint test of category-probability contrasts; preserves categories without assigning numeric scores.\",\"options\":[{\"default\":[],\"help\":\"Select one prespecified baseline variable. Categorical levels define subgroups; continuous mode evaluates two declared values without binning.\",\"label\":\"Baseline effect modifier\",\"max_items\":1,\"name\":\"subgroups\",\"profile\":\"beginner\",\"type\":\"columns\"},{\"default\":false,\"help\":\"Declare that the baseline modifier, coding, outcome and contrasts were chosen before inspecting effects. This declaration does not verify timing or scientific validity.\",\"label\":\"Modifier and contrasts were prespecified\",\"name\":\"subgroups_prespecified\",\"profile\":\"beginner\",\"type\":\"bool\"},{\"choices\":[\"categorical\",\"continuous\"],\"default\":\"categorical\",\"label\":\"Modifier type\",\"name\":\"modifier_type\",\"profile\":\"beginner\",\"type\":\"select\"},{\"default\":null,\"help\":\"An explicit scientifically meaningful value within both treatment arms' observed range.\",\"label\":\"Lower modifier value (continuous mode)\",\"name\":\"modifier_low\",\"profile\":\"standard\",\"type\":\"number\"},{\"default\":null,\"label\":\"Upper modifier value (continuous mode)\",\"name\":\"modifier_high\",\"profile\":\"standard\",\"type\":\"number\"},{\"default\":0.95,\"label\":\"Pointwise confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"standard\",\"type\":\"number\"}],\"probes\":[],\"reference_dispositions\":[{\"disposition\":\"resolved_metadata\",\"id\":\"altman2003\",\"requested_as\":\"Altman and Bland (2003), Interaction revisited: the difference between two estimates\"},{\"disposition\":\"resolved_metadata\",\"id\":\"knol2012\",\"requested_as\":\"Knol and VanderWeele (2012), Recommendations for presenting analyses of effect modification and interaction\"},{\"disposition\":\"resolved_metadata\",\"id\":\"kent2020\",\"requested_as\":\"Kent et al. (2020), The Predictive Approaches to Treatment effect Heterogeneity (PATH) Statement\"}],\"reference_ids\":[\"altman2003\",\"knol2012\",\"kent2020\"],\"references\":[\"Altman and Bland (2003), Interaction revisited: the difference between two estimates\",\"Knol and VanderWeele (2012), Recommendations for presenting analyses of effect modification and interaction\",\"Kent et al. (2020), The Predictive Approaches to Treatment effect Heterogeneity (PATH) Statement\"],\"roles_forbidden\":[\"weight\",\"time\",\"strata\",\"instruments\",\"running\",\"mediator\",\"duration\",\"event\"],\"roles_optional\":[\"confounders\",\"effect_modifiers\",\"unit\",\"cluster\",\"forbidden\"],\"roles_required\":[\"treatment\",\"outcome\"],\"source_path\":\"engines/python/capy_py/heterogeneity.py\",\"source_sha256\":\"f85f72b881f0021897d588369d6e6e2e615d761c8e7d43ea4e273916f9509c05\",\"status\":\"recommended\",\"title\":\"Nominal and ordinal outcome heterogeneity\",\"what_can_go_wrong\":\"Model-based baseline binary-treatment contrasts require correct conditional mean form and within-modifier support. Prespecification does not prove causality; model convergence and a significant interaction do not verify exchangeability. Delta inference conditions on empirical profiles. No outcome-driven subgroup discovery, panel/design-specific interactions or small-cluster correction.\",\"why_recommended\":\"Tests effect differences directly on a prespecified scale, with all interaction main effects and explicit sampling assumptions.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:02bfcd92ced4eb10ed561a98\",\"object_id\":\"assumption:consistency\",\"predicate\":\"requires_assumption\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"heterogeneity.categorical\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:07116c0650dc7f6beabfa385\",\"object_id\":\"estimand:GATE\",\"predicate\":\"targets_estimand\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"heterogeneity.categorical\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Consult the method card and exact claim qualifications before treating conceptual coverage as implementation support.\"],\"counterevidence\":[],\"gaps\":[\"No independent human scientific review or study-specific causal identification is established.\"],\"id\":\"relation:0c2b942274a3af1282bf2cb8\",\"obje