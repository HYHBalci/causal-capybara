<urn:capy:claim%3Adid-parallel-trends> a capy:claim ; skos:prefLabel "DiD parallel trends and pretrend tests" ; prov:wasDerivedFrom <urn:capy:source%3Anote%3Adid> ; capy:record "{\"aliases\":[\"conditional parallel trends\",\"pretrend test\",\"pre-trends\",\"untreated potential outcomes\"],\"assertion_mode\":\"original_editorial_explanation\",\"citation_ids\":[\"10.1257/aeri.20210236\",\"callaway2021\",\"roth2023\",\"source:note:did\",\"sun2021\"],\"citations\":[],\"conditions\":[\"Eligible comparison group and declared outcome scale.\",\"Conditional or unconditional trends restriction matches the estimator.\",\"Pre-treatment covariates and no-anticipation policy are explicit.\"],\"counterevidence\":[\"Low-power tests may fail to reveal important divergence.\",\"TWFE lead contamination can create apparent pretrends under effect heterogeneity.\",\"Equal observed levels are not required by parallel trends.\"],\"evidence_ids\":[\"evidence:did-parallel-trends\"],\"gaps\":[\"Roth et al. (2023) is metadata/link-only further reading; Roth (2022) was reviewed through its published abstract, with no copied full text.\",\"Observed pre-period evidence does not verify the missing post-adoption counterfactual.\"],\"id\":\"claim:did-parallel-trends\",\"kind\":\"claim\",\"provenance\":[\"source:note:did\"],\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:1fab68bf01ea1e6de588d1c5\",\"object_id\":\"roth2023\",\"predicate\":\"cites\",\"provenance\":[\"source:note:did\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/did_modern.py\",\"tests/python/test_did_modern.py\",\"https://arxiv.org/html/1803.09015v4\",\"https://arxiv.org/html/1804.05785v2\",\"https://doi.org/10.1016/j.jeconom.2023.03.008\",\"https://www.aeaweb.org/articles?id=10.1257%2Faeri.20210236\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Citation and original explanation; linked external bodies are not included.\",\"subject_id\":\"claim:did-parallel-trends\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:2348e6dc7c7dd403c0f6a3d1\",\"object_id\":\"callaway2021\",\"predicate\":\"cites\",\"provenance\":[\"source:note:did\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"engines/python/capy_py/did_modern.py\",\"tests/python/test_did_modern.py\",\"https://arxiv.org/html/1803.09015v4\",\"https://arxiv.org/html/1804.05785v2\",\"https://doi.org/10.1016/j.jeconom.2023.03.008\",\"https://www.aeaweb.org/articles?id=10.1257%2Faeri.20210236\"],\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"agent_context_review\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Citation and original explanation; linked external bodies are not included.\",\"subject_id\":\"claim:did-parallel-trends\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:722576362