e\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:f498c9e66a11b6882917628a\",\"object_id\":\"bounds.manski\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:rct\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Assignment was by chance, so the arms are comparable on everything -- including the things nobody measured. That is the whole reason experiments are the benchmark.\",\"title\":\"Randomised or as-if randomised\"}" .
<urn:capy:design%3Ard> a capy:design ; skos:prefLabel "A cutoff decided eligibility" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"Regression discontinuity\",\"RD\",\"RDD\",\"sharp RD\",\"fuzzy RD\",\"running variable\",\"forcing variable\",\"cutoff design\",\"bandwidth\"],\"catalogue_key\":\"design:rd\",\"citation_ids\":[],\"citations\":[],\"content\":{\"also_called\":[\"Regression discontinuity\",\"RD\",\"RDD\",\"sharp RD\",\"fuzzy RD\",\"running variable\",\"forcing variable\",\"cutoff design\",\"bandwidth\"],\"assumption_notes\":[\"No precise manipulation of the running variable -- the density test speaks to this\",\"Continuity of everything else at the cutoff\"],\"common_mistake\":\"Presenting the discontinuity estimate as the average effect for everyone eligible. It is the effect at the boundary.\",\"default_estimand\":{\"acronym\":\"LATE\",\"explain_key\":\"estimand.late\",\"id\":\"LATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who only got it because of the instrument or the cutoff, what did it do?\",\"title\":\"Local average treatment effect\"},\"diagnostics\":[{\"explain_key\":\"diagnostic.bandwidth_sensitivity\",\"id\":\"bandwidth_sensitivity\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Bandwidth sensitivity path\"},{\"explain_key\":\"diagnostic.bias_correction\",\"id\":\"bias_correction\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Bias correction and robust interval\"},{\"explain_key\":\"diagnostic.covariate_balance\",\"id\":\"covariate_balance\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Covariate balance\"},{\"explain_key\":\"diagnostic.first_stage\",\"id\":\"first_stage\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"First stage\"},{\"explain_key\":\"diagnostic.leave_one_out\",\"id\":\"leave_one_out\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Leave one unit out\"},{\"explain_key\":\"diagnostic.level_jump_at_kink\",\"id\":\"level_jump_at_kink\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Level jump at a kink\"},{\"explain_key\":\"diagnostic.manipulation\",\"id\":\"manipulation\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Density at the cutoff\"},{\"explain_key\":\"diagnostic.negative_control\",\"id\":\"negative_control\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Negative control\"},{\"explain_key\":\"diagnostic.placebo_outcome\",\"id\":\"placebo_outcome\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Placebo outcome\"},{\"explain_key\":\"diagnostic.placebo_treatment\",\"id\":\"placebo_treatment\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Placebo treatment\"},{\"explain_key\":\"diagnostic.probe_runs\",\"id\":\"probe_runs\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Probe runs\"},{\"explain_key\":\"diagnostic.random_common_cause\",\"id\":\"random_common_cause\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Random common cause\"},{\"explain_key\":\"diagnostic.rd_plot\",\"id\":\"rd_plot\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Binned scatter at the cutoff\"},{\"explain_key\":\"diagnostic.running_variable_discreteness\",\"id\":\"running_variable_discreteness\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Discreteness of the running variable\"},{\"explain_key\":\"diagnostic.spec_curve\",\"id\":\"spec_curve\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Specification curve\"},{\"explain_key\":\"diagnostic.subset_stability\",\"id\":\"subset_stability\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Stability on random subsets\"},{\"explain_key\":\"diagnostic.unobserved_confounder\",\"id\":\"unobserved_confounder\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Simulated unobserved confounder\"}],\"estimands\":[{\"acronym\":\"LATE\",\"explain_key\":\"estimand.late\",\"id\":\"LATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who only got it because of the instrument or the cutoff, what did it do?\",\"title\":\"Local average treatment effect\"},{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"}],\"explain_key\":\"design.rd\",\"gaps\":[],\"how_the_board_reads\":\"Type the threshold into the Cutoff box. The binned scatter appears before any estimator does.\",\"id\":\"rd\",\"in_more_depth\":\"The credibility of this design is local and its estimate is local with it. You learn about units at the cutoff and nobody else, which is exactly right if the policy question is about moving the threshold, and a poor fit if it is about the programme overall. Two things can break it. If people could control their score precisely, they sorted across the line and the comparison is not as-good-as-random -- the density test looks for that. If the same threshold triggers other rules, the jump combines them and nothing separates them. The binned scatter is the design. If you cannot see the discontinuity, be suspicious of an estimator that reports one.\",\"kind\":\"design\",\"methods\":[{\"explain_key\":\"method.rd.covariate_balance\",\"id\":\"rd.covariate_balance\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Run the same estimator on variables the programme cannot have changed; they should not step at the threshold.\",\"title\":\"Do the covariates jump at the cutoff too?\"},{\"explain_key\":\"method.rd.density_test\",\"id\":\"rd.density_test\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Compare how many units sit just below the threshold with how many sit just above.\",\"title\":\"Did people sort across the cutoff?\"},{\"explain_key\":\"method.rd.fuzzy\",\"id\":\"rd.fuzzy\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Divide the jump in the outcome by the jump in take-up: the effect for the people the cutoff actually moved.\",\"title\":\"Fuzzy RD (crossing the cutoff only nudged people in)\"},{\"explain_key\":\"method.rd.kink\",\"id\":\"rd.kink\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Where a formula changes slope rather than switching on, measure the change in slope of the outcome.\",\"title\":\"Regression kink (the rule bends, it does not switch)\"},{\"explain_key\":\"method.rd.local_linear\",\"id\":\"rd.local_linear\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Fit a line either side of the threshold and measure the step between them.\",\"title\":\"Sharp RD at the cutoff\"},{\"explain_key\":\"method.rd.local_randomization\",\"id\":\"rd.local_randomization\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Treat a narrow window around the cutoff as a small randomised experiment rather than fitting a curve through it.\",\"title\":\"Local randomisation RD\"},{\"explain_key\":\"method.rd.multi_cutoff\",\"id\":\"rd.multi_cutoff\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Several thresholds, or a boundary on a map, pooled into one design.\",\"title\":\"Multi-cutoff and geographic RD\"}],\"one_liner\":\"Crossing a score, age, or border switched the programme on.\",\"plain_language\":\"A rule assigned treatment on one side of a threshold. Right at the threshold, which side you land on is as good as random.\",\"probes\":[{\"explain_key\":\"probe.add_unobserved_confounder\",\"id\":\"probe.add_unobserved_confounder\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Simulate a common cause of a stated strength and watch the estimate move; read off how strong one would have to be to explain the result away.\",\"title\":\"Unobserved confounder\"},{\"explain_key\":\"probe.alternate_spec\",\"id\":\"probe.alternate_spec\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the grid of defensible specifications and sort the answers. The curve is the result, not the one you happened to run.\",\"title\":\"Specification curve\"},{\"explain_key\":\"probe.leave_one_out\",\"id\":\"probe.leave_one_out\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Drop one cluster, cohort or donor at a time and see whether any single one is carrying the result.\",\"title\":\"Leave one out\"},{\"explain_key\":\"probe.negative_control\",\"id\":\"probe.negative_control\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Estimate something that shares the confounding but not the causal path. A non-zero answer is bias you can see.\",\"title\":\"Negative control\"},{\"explain_key\":\"probe.placebo_outcome\",\"id\":\"probe.placebo_outcome\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the same analysis on something the treatment could not have changed. It should find nothing.\",\"title\":\"Placebo outcome\"},{\"explain_key\":\"probe.placebo_treatment\",\"id\":\"probe.placebo_treatment\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Move the policy date earlier, reshuffle who was treated, or swap in a variable that cannot cause the outcome.\",\"title\":\"Placebo treatment\"},{\"explain_key\":\"probe.random_common_cause\",\"id\":\"probe.random_common_cause\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Add a variable that causes nothing to the adjustment set. The estimate should barely move.\",\"title\":\"Random common cause\"},{\"explain_key\":\"probe.subset\",\"id\":\"probe.subset\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Re-estimate on random subsets. The answer should move about as much as losing that much data costs, and no more.\",\"title\":\"Subset stability\"}],\"references\":[\"Lee & Lemieux (2010)\",\"Cattaneo, Idrobo & Titiunik (2019), A practical introduction to RD\"],\"see_also\":[{\"explain_key\":\"assumption.no_manipulation\",\"explains\":\"People could not precisely control which side of the cutoff they landed on.\",\"id\":\"no_manipulation\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No manipulation of the running variable\",\"worry_when\":\"A visible spike or gap in the density at the cutoff; covariates that jump; a cutoff that people knew about and had time to respond to.\"},{\"explain_key\":\"diagnostic.rd_scatter\",\"id\":\"diagnostic.rd_scatter\",\"in_catalogue\":true,\"kind\":\"concept\",\"one_liner\":\"Local averages of the outcome in bins of the running variable, either side of the cutoff, with the fitted curves.\",\"title\":\"Binned scatter at the cutoff\"},{\"acronym\":\"LATE\",\"explain_key\":\"estimand.late\",\"id\":\"LATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who only got it because of the instrument or the cutoff, what did it do?\",\"title\":\"Local average treatment effect\"},{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"},{\"explain_key\":\"method.rd.covariate_balance\",\"id\":\"rd.covariate_balance\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Run the same estimator on variables the programme cannot have changed; they should not step at the threshold.\",\"title\":\"Do the covariates jump at the cutoff too?\"},{\"explain_key\":\"method.rd.density_test\",\"id\":\"rd.density_test\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Compare how many units sit just below the threshold with how many sit just above.\",\"title\":\"Did people sort across the cutoff?\"},{\"explain_key\":\"method.rd.fuzzy\",\"id\":\"rd.fuzzy\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Divide the jump in the outcome by the jump in take-up: the effect for the people the cutoff actually moved.\",\"title\":\"Fuzzy RD (crossing the cutoff only nudged people in)\"},{\"explain_key\":\"method.rd.kink\",\"id\":\"rd.kink\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Where a formula changes slope rather than switching on, measure the change in slope of the outcome.\",\"title\":\"Regression kink (the rule bends, it does not switch)\"}],\"tags\":[\"LATE\",\"ATT\"],\"title\":\"A cutoff decided eligibility\",\"what_it_assumes\":[{\"explain_key\":\"assumption.no_manipulation\",\"explains\":\"People could not precisely control which side of the cutoff they landed on.\",\"id\":\"no_manipulation\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No manipulation of the running variable\",\"worry_when\":\"A visible spike or gap in the density at the cutoff; covariates that jump; a cutoff that people knew about and had time to respond to.\"},{\"explain_key\":\"assumption.continuity\",\"explains\":\"Everything else that affects the outcome changes smoothly through the cutoff, so the only thing that jumps is the treatment.\",\"id\":\"continuity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Continuity of potential outcomes at the cutoff\",\"worry_when\":\"Several rules share the threshold; the running variable is coarse, so \\\"at the cutoff\\\" is really a wide band; the estimate depends heavily on the bandwidth.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"worry_when\":null},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"design:rd\",\"kind\":\"design\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"rd\",\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:06f1bde326368bce0bfe904e\",\"object_id\":\"rd.kink\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"design:rd\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:10ad3c344008fcf0d52c4133\",\"object_id\":\"estimand:LATE\",\"predicate\":\"targets_estimand\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apach