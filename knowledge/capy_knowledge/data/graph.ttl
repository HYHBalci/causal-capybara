://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"long.gformula\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Model each period in turn, then simulate the world where everyone followed the strategy you name.\",\"title\":\"Parametric g-formula\"}" .
<urn:capy:long.lmtp> a capy:method ; skos:prefLabel "Longitudinal modified treatment policies (lmtp)" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:long.lmtp\"],\"catalogue_key\":\"method:long.lmtp\",\"citation_ids\":[\"source:unresolved:8f69ac168c659dd10250\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":\"Not wrapped. The g-formula, marginal structural models and a sequential doubly robust estimator are implemented for binary regimes.\",\"engines\":{\"python\":false,\"r\":\"lmtp\"},\"needs_r_packages\":[\"lmtp\"],\"runs_here\":false,\"summary\":\"Not built into the app yet. The authoritative version is the R package lmtp, which the Engines screen can install for you.\"},\"designs\":[{\"explain_key\":\"design.longitudinal\",\"id\":\"longitudinal\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"The same person is treated, untreated, treated again; confounders also move.\",\"title\":\"Treatment that changes over time\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.positivity_by_period\",\"id\":\"positivity_by_period\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Positivity by period\"},{\"explain_key\":\"diagnostic.weights_by_period\",\"id\":\"weights_by_period\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Weights by period\"},{\"explain_key\":\"diagnostic.natural_course\",\"id\":\"natural_course\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Natural-course calibration\"},{\"explain_key\":\"diagnostic.regime_support\",\"id\":\"regime_support\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Support for the intervention regime\"}],\"estimands\":[{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"}],\"explain_key\":\"method.long.lmtp\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"long.lmtp\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":false,\"one_liner\":\"Estimate the effect of shifting a continuous or multi-valued treatment, rather than of setting everyone to one value.\",\"options\":[],\"plain_language\":\"Estimate the effect of shifting a continuous or multi-valued treatment, rather than of setting everyone to one value.\",\"probes\":[{\"explain_key\":\"probe.subset\",\"id\":\"probe.subset\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Re-estimate on random subsets. The answer should move about as much as losing that much data costs, and no more.\",\"requested_as\":\"probe.subset\",\"title\":\"Subset stability\"}],\"references\":[\"Diaz, Williams, Hoffman & Schenck (2021)\"],\"roles_forbidden\":[],\"roles_optional\":[],\"roles_required\":[\"a treatment\",\"an outcome\",\"a unit id\",\"a time variable\"],\"see_also\":[{\"explain_key\":\"design.longitudinal\",\"id\":\"longitudinal\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"The same person is treated, untreated, treated again; confounders also move.\",\"title\":\"Treatment that changes over time\"},{\"explain_key\":\"method.long.g_estimation\",\"id\":\"long.g_estimation\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Estimate the effect of a treatment regime by finding the parameter that removes the association between treatment and the blipped-down outcome.\",\"title\":\"G-estimation of structural nested models\"},{\"explain_key\":\"method.long.gformula\",\"id\":\"long.gformula\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Model each period in turn, then simulate the world where everyone followed the strategy you name.\",\"title\":\"Parametric g-formula\"},{\"explain_key\":\"method.long.ltmle\",\"id\":\"long.ltmle\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Regress backwards from the final outcome, then correct with the treatment probabilities: right if either set of models is right.\",\"title\":\"Sequential doubly robust (ICE g-formula with augmentation)\"},{\"explain_key\":\"method.long.ltmle_survival\",\"id\":\"long.ltmle_survival\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Time-to-event outcomes with time-varying treatment and censoring, targeted at each time.\",\"title\":\"Longitudinal TMLE for survival outcomes\"},{\"explain_key\":\"method.long.msm_iptw\",\"id\":\"long.msm_iptw\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Reweight each person-period so the treated and untreated histories look alike, then fit one simple model to the reweighted data.\",\"title\":\"Marginal structural model (time-varying weights)\"},{\"explain_key\":\"method.obs.missing.mice\",\"id\":\"obs.missing.mice\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Impute the missing values several times, run the analysis in each, and combine -- instead of dropping every row with a gap.\",\"title\":\"Multiple imputation compatible with the analysis\"}],\"status\":\"recommended\",\"status_label\":\"Recommended\",\"tags\":[\"Treatment that changes over time\",\"ATE\",\"Recommended\"],\"title\":\"Longitudinal modified treatment policies (lmtp)\",\"what_it_assumes\":[{\"explain_key\":\"assumption.no_time_varying_confounding\",\"explains\":\"At every period, the things that drive the treatment decision and also affect the outcome are measured -- and measured before that decision.\",\"id\":\"no_time_varying_confounding\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No unmeasured time-varying confounding\",\"worry_when\":\"Clinical measurements taken after the dose was changed; employment status recorded at the end of a period used to explain treatment at its start.\"},{\"explain_key\":\"assumption.positivity\",\"explains\":\"Every kind of unit had some chance of being treated and some chance of not being treated. Where that fails, there is no comparison to make and the model is inventing one.\",\"id\":\"positivity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Positivity / overlap\",\"worry_when\":\"Any single weight carries a large share of the total; the effective sample is far below the nominal one; the propensity model separates the arms almost perfectly; treated units sit outside the control group's range.\"},{\"explain_key\":\"assumption.sequential_ignorability\",\"explains\":\"No unmeasured confounding of the treatment-outcome relationship, and none of the mediator-outcome relationship either, even after conditioning on treatment.\",\"id\":\"sequential_ignorability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Sequential ignorability\",\"worry_when\":\"There is a variable affected by treatment that also confounds the mediator-outcome relationship. Under that structure the natural effects are not identified at all.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"when_not_to_use\":[\"The machinery is heavy and the estimator is sensitive to the density estimation it depends on.\"],\"when_to_use\":[\"\\\"Treat everyone\\\" is often not a policy anyone could implement. A modified treatment policy -- shift the dose down by ten percent for those above a threshold -- is, and it usually satisfies positivity far better.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"long.lmtp\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"long.lmtp\",\"registry\":{\"coming\":\"Not wrapped. The g-formula, marginal structural models and a sequential doubly robust estimator are implemented for binary regimes.\",\"designs\":[\"longitudinal\"],\"diagnostics\":[\"positivity_by_period\",\"weights_by_period\",\"natural_course\",\"regime_support\"],\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":false,\"r\":\"lmtp\"},\"estimands\":[\"ATE\"],\"id\":\"long.lmtp\",\"one_liner\":\"Estimate the effect of shifting a continuous or multi-valued treatment, rather than of setting everyone to one value.\",\"probes\":[\"probe.subset\"],\"r_needs\":[\"lmtp\"],\"reference_dispositions\":[{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:8f69ac168c659dd10250\",\"requested_as\":\"Diaz, Williams, Hoffman & Schenck (2021)\"}],\"reference_ids\":[\"source:unresolved:8f69ac168c659dd10250\"],\"references\":[\"Diaz, Williams, Hoffman & Schenck (2021)\"],\"roles_required\":[\"treatment\",\"outcome\",\"unit\",\"time\"],\"source_path\":\"engines/registry/methods.extra.yaml\",\"source_sha256\":\"2cb349e9f7f7e6f88c10c18d81478656fd420eda7ca977d9767610ac8c7a4be0\",\"status\":\"recommended\",\"title\":\"Longitudinal modified treatment policies (lmtp)\",\"what_can_go_wrong\":\"The machinery is heavy and the estimator is sensitive to the density estimation it depends on.\",\"why_recommended\":\"\\\"Treat everyone\\\" is often not a policy anyone could implement. A modified treatment policy -- shift the dose down by ten percent for those above a threshold -- is, and it usually satisfies positivity far better.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:0007ea4be418db389e604717\",\"object_id\":\"concept:causal-scope\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:skos2009\",\"source:ontology:provo2013\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"long.lmtp\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:10542ace54787ea399d9fc9d\",\"object_id\":\"softwarepackage:lmtp\",\"predicate\":\"implemented_by\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"seman