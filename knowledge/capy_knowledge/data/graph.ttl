/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"probe.alternate_spec\"},{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:f1934bb5378dbf2ee75593dd\",\"object_id\":\"concept:identification\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:pearl2009\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"probe.alternate_spec\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:f478f24d844970fa157bd843\",\"object_id\":\"assumption:exclusion\",\"predicate\":\"requires_assumption\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"probe.alternate_spec\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:f8b0efc354d509e5d572f3c9\",\"object_id\":\"assumption:parallel_trends\",\"predicate\":\"requires_assumption\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"probe.alternate_spec\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:fa9a3b796aca5ab66d8dd809\",\"object_id\":\"design:longitudinal\",\"predicate\":\"compatible_with_design\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"probe.alternate_spec\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Run the grid of defensible specifications and sort the answers. The curve is the result, not the one you happened to run.\",\"title\":\"Specification curve\"}" .
<urn:capy:probe.cinelli_hazlett> a capy:probe ; skos:prefLabel "Cinelli-Hazlett sensitivity (partial R2)" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"probe:probe.cinelli_hazlett\"],\"catalogue_key\":\"probe:probe.cinelli_hazlett\",\"citation_ids\":[\"10.1111/rssb.12348\",\"10.2139/ssrn.3588978\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":null,\"engines\":{\"python\":true,\"r\":\"sensemakr\"},\"needs_r_packages\":[\"sensemakr\"],\"runs_here\":true,\"summary\":\"Runs on this computer with what the app already installs.\"},\"designs\":[{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"},{\"explain_key\":\"design.longitudinal\",\"id\":\"longitudinal\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"The same person is treated, untreated, treated again; confounders also move.\",\"title\":\"Treatment that changes over time\"},{\"explain_key\":\"design.mediation\",\"id\":\"mediation\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"We care about a mediator, not only the total effect.\",\"title\":\"How it worked (pathways)\"},{\"explain_key\":null,\"id\":\"undecided\",\"in_catalogue\":false,\"kind\":\"design\",\"one_liner\":null,\"title\":\"Any design\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.robustness_value\",\"id\":\"robustness_value\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Robustness value\"},{\"explain_key\":\"diagnostic.extreme_confounder\",\"id\":\"extreme_confounder\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Confounder strength needed to explain the estimate\"},{\"explain_key\":\"diagnostic.linear_form\",\"id\":\"linear_form\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Linearity of the outcome model\"}],\"estimands\":[{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"},{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"},{\"acronym\":\"ATC\",\"explain_key\":\"estimand.atc\",\"id\":\"ATC\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who didn't get it, what would it have done?\",\"title\":\"Average treatment effect on the controls\"}],\"explain_key\":\"probe.cinelli_hazlett\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"probe.cinelli_hazlett\",\"in_more_depth\":null,\"kind\":\"probe\",\"needs_overlap\":false,\"one_liner\":\"How strong would an unmeasured confounder have to be -- compared with the covariates you already have -- to explain the estimate away?\",\"options\":[{\"default\":null,\"help\":\"The number this probe is about. Filled in automatically when the probe is launched from a result.\",\"label\":\"Parent estimate\",\"name\":\"parent_estimate\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":null,\"help\":\"Used to place the parent's confidence interval on the same scale.\",\"label\":\"Parent standard error\",\"min\":0.0,\"name\":\"parent_se\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":null,\"help\":\"Which analysis this probe is attached to. Some probes re-run it to get the fitted model rather than just the number.\",\"label\":\"Parent method\",\"name\":\"parent_method\",\"profile\":\"advanced\",\"type\":\"string\"},{\"default\":1.0,\"help\":\"1 asks what it takes to reach zero; 0.5 asks what it takes to halve it.\",\"label\":\"Share of the estimate to explain away\",\"max\":1.0,\"min\":0.05,\"name\":\"q\",\"profile\":\"standard\",\"type\":\"number\"},{\"default\":0.05,\"help\":\"The second robustness value also asks that the shrunken estimate stop being distinguishable from the target at this level.\",\"label\":\"Significance level for RV\",\"max\":0.5,\"min\":0.001,\"name\":\"alpha\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":[1.0,2.0,3.0],\"help\":\"Bounds for a confounder 1, 2 or 3 times as informative as each covariate.\",\"label\":\"Benchmark multipliers\",\"name\":\"benchmark_multipliers\",\"profile\":\"advanced\",\"type\":\"list\"},{\"default\":25,\"label\":\"Contour resolution\",\"max\":61,\"min\":9,\"name\":\"grid_points\",\"profile\":\"advanced\",\"type\":\"int\"}],\"plain_language\":\"How strong would an unmeasured confounder have to be -- compared with the covariates you already have -- to explain the estimate away?\",\"probes\":[],\"references\":[\"Cinelli & Hazlett (2020), Making sense of sensitivity: extending omitted variable bias, JRSS-B 82(1)\",\"Cinelli, Ferwerda & Hazlett (2020), sensemakr: sensitivity analysis tools for OLS\"],\"roles_forbidden\":[\"forbidden\"],\"roles_optional\":[\"a clustering variable\",\"weight\"],\"roles_required\":[\"a treatment\",\"an outcome\",\"at least one measured confounder\"],\"see_also\":[{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"},{\"explain_key\":\"design.longitudinal\",\"id\":\"longitudinal\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"The same person is treated, untreated, treated again; confounders also move.\",\"title\":\"Treatment that changes over time\"},{\"explain_key\":\"design.mediation\",\"id\":\"mediation\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"We care about a mediator, not only the total effect.\",\"title\":\"How it worked (pathways)\"},{\"explain_key\":null,\"id\":\"undecided\",\"in_catalogue\":false,\"kind\":\"design\",\"one_liner\":null,\"title\":\"Any design\"},{\"explain_key\":\"method.bounds.manski\",\"id\":\"bounds.manski\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Report the range the effect must lie in given only what the data can support, without assuming away the missing counterfactual.\",\"title\":\"Manski bounds\"},{\"explain_key\":\"method.interference.exposure\",\"id\":\"interference.exposure\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"When one unit's treatment affects another's outcome, estimate the direct and spillover effects separately instead of pretending neither exists.\",\"title\":\"Interference and spillovers\"},{\"explain_key\":\"method.long.g_estimation\",\"id\":\"long.g_estimation\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Estimate the effect of a treatment regime by finding the parameter that removes the association between treatment and the blipped-down outcome.\",\"title\":\"G-estimation of structural nested models\"},{\"explain_key\":\"method.long.gformula\",\"id\":\"long.gformula\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Model each period in turn, then simulate the world where everyone followed the strategy you name.\",\"title\":\"Parametric g-formula\"},{\"explain_key\":\"method.long.lmtp\",\"id\":\"long.lmtp\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Estimate the effect of shifting a continuous or multi-valued treatment, rather than of setting everyone to one value.\",\"title\":\"Longitudinal modified treatment policies (lmtp)\"},{\"explain_key\":\"method.long.ltmle\",\"id\":\"long.ltmle\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Regress backwards from the final outcome, then correct with the treatment probabilities: right if either set of models is right.\",\"title\":\"Sequential doubly robust (ICE g-formula with augmentation)\"}],\"status\":\"recommended\",\"status_label\":\"Recommended\",\"tags\":[\"Adjust for background differences\",\"Treatment that changes over time\",\"How it worked (pathways)\",\"Any design\",\"ATE\",\"ATT\",\"ATC\",\"Recommended\"],\"title\":\"Cinelli-Hazlett sensitivity (partial R2)\",\"what_it_assumes\":[{\"explain_key\":\"assumption.exchangeability\",\"explains\":\"Treated and untreated units are comparable once you condition on the confounders you measured. Everything that pushed people towards treatment and also moves the outcome is in your adjustment set.\",\"id\":\"exchangeability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Exchangeability / no unmeasured confounding\",\"worry_when\":\"Treatment was chosen by people who knew something about the likely outcome that you do not observe. Clinical judgement, self-selection into a programme, and administrative triage are the classic cases.\"},{\"explain_key\":\"assumption.positivity\",\"explains\":\"Every kind of unit had some chance of being treated and some chance of not being treated. Where that fails, there is no comparison to make and the model is inventing one.\",\"id\":\"positivity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Positivity / overlap\",\"worry_when\":\"Any single weight carries a large share of the total; the effective sample is far below the nominal one; the propensity model separates the arms almost perfectly; treated units sit outside the control group's range.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"},{\"explain_key\":\"assumption.no_time_varying_confounding\",\"explains\":\"At every period, the things that drive the treatment decision and also affect the outcome are measured -- and measured before that decision.\",\"id\":\"no_time_varying_confounding\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"No unmeasured time-varying confounding\",\"worry_when\":\"Clinical measurements taken after the dose was changed; employment status recorded at the end of a period used to explain treatment at its start.\"},{\"explain_key\":\"assumption.sequential_ignorability\",\"explains\":\"No unmeasured confounding of the treatment-outcome relationship, and none of the mediator-outcome relationship either, even after conditioning on treatment.\",\"id\":\"sequential_ignorability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Sequential ignorability\",\"worry_when\":\"There is a variable affected by treatment that also confounds the mediator-outcome relationship. Under that structure the natural effects are not identified at all.\"}],\"when_not_to_use\":[\"It is exact only for a linear outcome model with one linearly-entering confounder. A large robustness value is not evidence that no such confounder exists, and the benchmarks only cover confounders that look like the covariates you happened to measure.\"],\"when_to_use\":[\"It answers the question people actually ask -- 'what about the thing you did not measure?' -- with a number on the same scale as the covariates that are in the model, so the comparison is concrete.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"probe.cinelli_hazlett\",\"kind\":\"probe\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"probe.cinelli_hazlett\",\"registry\":{\"designs\":[\"observational\",\"longitudinal\",\"mediation\",\"undecided\"],\"diagnostics\":[\"robustness_value\",\"extreme_confounder\",\"linear_form\"],\"disrecommend_when\":null,\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":true,\"r\":\"sensemakr\"},\"estimands\":[\"ATE\",\"ATT\",\"ATC\"],\"explain_key\":\"probe.cinelli_hazlett\",\"id\":\"probe.cinelli_hazlett\",\"needs\":[\"numpy\",\"scipy\",\"pandas\"],\"needs_overlap\":false,\"one_liner\":\"How strong would an unmeasured confounder have to be -- compared with the covariates you already have -- to explain the estimate away?\",\"options\":[{\"default\":null,\"help\":\"The number this probe is about. Filled in automatically when the probe is launched from a result.\",\"label\":\"Parent estimate\",\"name\":\"parent_estimate\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":null,\"help\":\"Used to place the parent's confidence interval on the same scale.\",\"label\":\"Parent standard error\",\"min\":0.0,\"name\":\"parent_se\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":null,\"help\":\"Which analysis this probe is attached to. Some probes re-run it to get the fitted model rather than just the number.\",\"label\":\"Parent method\",\"name\":\"parent_method\",\"profile\":\"advanced\",\"type\":\"string\"},{\"default\":1.0,\"help\":\"1 asks what it takes to reach zero; 0.5 asks what it takes to halve it.\",\"label\":\"Share of the estimate to explain away\",\"max\":1.0,\"min\":0.05,\"name\":\"q\",\"profile\":\"standard\",\"type\":\"number\"},{\"default\":0.05,\"help\":\"The second robustness value also asks that the shrunken estimate stop being distinguishable from the target at this level.\",\"label\":\"Significance level for RV\",\"max\":0.5,\"min\":0.001,\"name\":\"alpha\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":[1.0,2.0,3.0],\"help\":\"Bounds for a confounder 1, 2 or 3 times as informative as each covariate.\",\"label\":\"Benchmark multipliers\",\"name\":\"benchmark_multipliers\",\"profile\":\"advanced\",\"type\":\"list\"},{\"default\":25,\"label\":\"Contour resolution\",\"max\":61,\"min\":9,\"name\":\"grid_points\",\"profile\":\"advanced\",\"type\":\"int\"}],\"probes\":[],\"reference_dispositions\":[{\"disposition\":\"resolved_metadata\",\"id\":\"10.1111/rssb.12348\",\"requested_as\":\"Cinelli & Hazlett (2020), Making sense of sensitivity: extending omitted variable bias, JRSS-B 82(1)\"},{\"disposition\":\"resolved_metadata\",\"id\":\"10.2139/ssrn.3588978\",\"requested_as\":\"Cinelli, Ferwerda & Hazlett (2020), sensemakr: sensitivity analysis tools for OLS\"}],\"reference_ids\":[\"10.1111/rssb.12348\",\"10.2139/ssrn.3588978\"],\"references\":[\"Cinelli & Hazlett (2020), Making sense of sensitivity: extending omitted variable bias, JRSS-B 82(1)\",\"Cinelli, Ferwerda & Hazlett (2020), sensemakr: sensitivity analysis tools for OLS\"],\"roles_forbidden\":[\"forbidden\"],\"roles_optional\":[\"cluster\",\"weight\"],\"roles_required\":[\"treatment\",\"outcome\",\"confounders\"],\"source_path\":\"engines/python/capy_py/sensitivity.py\",\"source_sha256\":\"2d17c4ca3660d99d91eb0d3bb715c2164c82cc3fe8c8b3d0cf21a2d54c733d8b\",\"status\":\"recommended\",\"title\":\"Cinelli-Hazlett sensitivity (partial R2)\",\"what_can_go_wrong\":\"It is exact only for a linear outcome model with one linearly-entering confounder. A large robustness value is not evidence that no such confounder exists, and the benchmarks only cover confounders that look like the covariates you happened to measure.\",\"why_recommended\":\"It answers the question people actually ask -- 'what about the thing you did not measure?' -- with a number on the same scale as the covariates that are in the model, so the comparison is concrete.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:05d5871e8a8dd12a11913863\",\"object_id\":\"concept:causal-estimands\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"source:ontology:ich2019\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Editorial methodological context for this registry entry; not a reviewed implementation or equivalence assertion.\",\"subject_id\":\"probe.cinelli_hazlett\"},{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:1a9c3624cc1192a397160246\",\"object_id\":\"softwarepackage:capy-python\",\"predicate\":\"implemented_by\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},