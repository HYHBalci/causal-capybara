<urn:capy:rct.diff_means> a capy:method ; skos:prefLabel "Difference in means" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"method:rct.diff_means\"],\"catalogue_key\":\"method:rct.diff_means\",\"citation_ids\":[\"10.1016/j.aam.2006.12.003\",\"10.1214/12-aoas583\",\"source:unresolved:12d5c830da10862dd1b8\",\"source:unresolved:d06ee7af3bee3177c1ad\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":null,\"engines\":{\"python\":true,\"r\":\"estimatr (difference_in_means, lm_lin)\"},\"needs_r_packages\":[\"estimatr (difference_in_means, lm_lin)\"],\"runs_here\":true,\"summary\":\"Runs on this computer with what the app already installs.\"},\"designs\":[{\"explain_key\":\"design.rct\",\"id\":\"rct\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"People were assigned by chance, or as good as chance.\",\"title\":\"Randomised or as-if randomised\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.baseline_balance\",\"id\":\"baseline_balance\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Baseline balance\"},{\"explain_key\":\"diagnostic.differential_attrition\",\"id\":\"differential_attrition\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Differential attrition\"},{\"explain_key\":\"diagnostic.outcome_distribution\",\"id\":\"outcome_distribution\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Outcome distribution\"}],\"estimands\":[{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"},{\"acronym\":\"ITT\",\"explain_key\":\"estimand.itt\",\"id\":\"ITT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For everyone who was offered it, what did the offer do?\",\"title\":\"Intention to treat\"}],\"explain_key\":\"method.rct.diff_means\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"rct.diff_means\",\"in_more_depth\":null,\"kind\":\"method\",\"needs_overlap\":false,\"one_liner\":\"Compare the two arms as they were randomised, and let covariates sharpen the comparison without letting them change the question.\",\"options\":[{\"default\":true,\"help\":\"Uses Lin's interacted regression, which cannot make the estimate worse than the simple difference in large samples. Turn it off to report the raw randomised comparison.\",\"label\":\"Adjust for baseline covariates\",\"name\":\"adjust\",\"profile\":\"standard\",\"type\":\"bool\"},{\"choices\":[\"auto\",\"yes\",\"no\"],\"default\":\"auto\",\"help\":\"If the variable records who was offered the programme rather than who received it, the estimate is an intention-to-treat effect and is labelled as one.\",\"label\":\"Is the treatment variable an offer?\",\"name\":\"treatment_is_offer\",\"profile\":\"standard\",\"type\":\"select\"},{\"default\":null,\"help\":\"Added to the covariates already on the design board. Baseline only: anything measured after randomisation will bias the comparison.\",\"label\":\"Extra baseline covariates\",\"name\":\"covariates\",\"profile\":\"advanced\",\"type\":\"columns\"},{\"choices\":[\"HC0\",\"HC1\",\"HC2\",\"HC3\"],\"default\":\"HC2\",\"help\":\"HC2 is the default because for a two-arm contrast it reproduces Neyman's variance exactly. HC3 is more conservative in small samples; HC1 is the Stata default.\",\"label\":\"Robust variance\",\"name\":\"vcov\",\"profile\":\"advanced\",\"type\":\"select\"},{\"default\":0.95,\"help\":\"The coverage of the interval reported next to the estimate.\",\"label\":\"Confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"}],\"plain_language\":\"Compare the two arms as they were randomised, and let covariates sharpen the comparison without letting them change the question.\",\"probes\":[{\"explain_key\":\"probe.placebo_outcome\",\"id\":\"probe.placebo_outcome\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the same analysis on something the treatment could not have changed. It should find nothing.\",\"requested_as\":\"placebo_outcome\",\"title\":\"Placebo outcome\"},{\"explain_key\":\"probe.alternate_spec\",\"id\":\"probe.alternate_spec\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Run the grid of defensible specifications and sort the answers. The curve is the result, not the one you happened to run.\",\"requested_as\":\"alternate_spec\",\"title\":\"Specification curve\"},{\"explain_key\":\"probe.subset\",\"id\":\"probe.subset\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Re-estimate on random subsets. The answer should move about as much as losing that much data costs, and no more.\",\"requested_as\":\"subset_refuter\",\"title\":\"Subset stability\"},{\"explain_key\":\"probe.random_common_cause\",\"id\":\"probe.random_common_cause\",\"in_catalogue\":true,\"kind\":\"probe\",\"one_liner\":\"Add a variable that causes nothing to the adjustment set. The estimate should barely move.\",\"requested_as\":\"random_common_cause\",\"title\":\"Random common cause\"},{\"explain_key\":\"method.rct.randomization_inference\",\"id\":\"rct.randomization_inference\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Re-run the randomisation thousands of times with the outcomes held fixed, and see how unusual what actually happened really is.\",\"requested_as\":\"randomization_inference\",\"title\":\"Randomisation (Fisher) inference\"}],\"references\":[\"Neyman (1923/1990), On the Application of Probability Theory to Agricultural Experiments\",\"Freedman (2008), On Regression Adjustments to Experimental Data\",\"Lin (2013), Agnostic Notes on Regression Adjustments to Experimental Data\",\"Gerber and Green (2012), Field Experiments: Design, Analysis, and Interpretation\"],\"roles_forbidden\":[\"an instrument\",\"a running variable\"],\"roles_optional\":[\"at least one measured confounder\",\"a clustering variable\",\"weight\"],\"roles_required\":[\"a treatment\",\"an outcome\"],\"see_also\":[{\"explain_key\":\"design.rct\",\"id\":\"rct\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"People were assigned by chance, or as good as chance.\",\"title\":\"Randomised or as-if randomised\"},{\"explain_key\":\"method.bounds.manski\",\"id\":\"bounds.manski\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Report the range the effect must lie in given only what the data can support, without assuming away the missing counterfactual.\",\"title\":\"Manski bounds\"},{\"explain_key\":\"method.interference.exposure\",\"id\":\"interference.exposure\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"When one unit's treatment affects another's outcome, estimate the direct and spillover effects separately instead of pretending neither exists.\",\"title\":\"Interference and spillovers\"},{\"explain_key\":\"method.rct.cace\",\"id\":\"rct.cace\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Not everyone offered a programme takes it. Report what the offer did, and separately what taking it up did for the people it moved.\",\"title\":\"ITT and CACE (noncompliance)\"},{\"explain_key\":\"method.rct.cluster\",\"id\":\"rct.cluster\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"When whole schools, clinics or villages were assigned, the number of clusters is the sample size that matters.\",\"title\":\"Cluster-randomised trial\"},{\"explain_key\":\"method.rct.randomization_inference\",\"id\":\"rct.randomization_inference\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Re-run the randomisation thousands of times with the outcomes held fixed, and see how unusual what actually happened really is.\",\"title\":\"Randomisation (Fisher) inference\"},{\"explain_key\":\"method.rct.stratified\",\"id\":\"rct.stratified\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Estimate inside the blocks the randomisation was run in, then average them the way your estimand says to.\",\"title\":\"Blocked or stratified experiment\"}],\"status\":\"recommended\",\"status_label\":\"Recommended\",\"tags\":[\"Randomised or as-if randomised\",\"ATE\",\"ITT\",\"Recommended\"],\"title\":\"Difference in means\",\"what_it_assumes\":[{\"explain_key\":\"assumption.randomisation\",\"explains\":\"Assignment really was by chance, and nothing after assignment broke the comparison -- no differential dropout, no crossover you have not modelled.\",\"id\":\"randomisation\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Randomisation held\",\"worry_when\":\"Dropout differs across arms; take-up is far from assignment; the randomiser was a person with discretion.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"when_not_to_use\":[\"Rows lost after randomisation (attrition) quietly turn the randomised comparison into an observational one. Covariate adjustment with many covariates and few units per arm can add bias and lose precision (Freedman 2008); Lin's interacted form limits that but does not remove it. If the treatment variable is really an offer, this is an ITT and not the effect of the programme.\"],\"when_to_use\":[\"The treatment was randomised, so the difference between the arms is already the effect. Nothing needs to be modelled for the estimate to be causal -- only for it to be precise.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"rct.diff_means\",\"kind\":\"method\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"rct.diff_means\",\"registry\":{\"designs\":[\"rct\"],\"diagnostics\":[\"baseline_balance\",\"differential_attrition\",\"outcome_distribution\"],\"disrecommend_when\":null,\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":true,\"r\":\"estimatr (difference_in_means, lm_lin)\"},\"estimands\":[\"ATE\",\"ITT\"],\"explain_key\":\"method.rct.diff_means\",\"id\":\"rct.diff_means\",\"needs\":[\"numpy\",\"pandas\",\"scipy\"],\"needs_overlap\":false,\"one_liner\":\"Compare the two arms as they were randomised, and let covariates sharpen the comparison without letting them change the question.\",\"options\":[{\"default\":true,\"help\":\"Uses Lin's interacted regression, which cannot make the estimate worse than the simple difference in large samples. Turn it off to report the raw randomised comparison.\",\"label\":\"Adjust for baseline covariates\",\"name\":\"adjust\",\"profile\":\"standard\",\"type\":\"bool\"},{\"choices\":[\"auto\",\"yes\",\"no\"],\"default\":\"auto\",\"help\":\"If the variable records who was offered the programme rather than who received it, the estimate is an intention-to-treat effect and is labelled as one.\",\"label\":\"Is the treatment variable an offer?\",\"name\":\"treatment_is_offer\",\"profile\":\"standard\",\"type\":\"select\"},{\"default\":null,\"help\":\"Added to the covariates already on the design board. Baseline only: anything measured after randomisation will bias the comparison.\",\"label\":\"Extra baseline covariates\",\"name\":\"covariates\",\"profile\":\"advanced\",\"type\":\"columns\"},{\"choices\":[\"HC0\",\"HC1\",\"HC2\",\"HC3\"],\"default\":\"HC2\",\"help\":\"HC2 is the default because for a two-arm contrast it reproduces Neyman's variance exactly. HC3 is more conservative in small samples; HC1 is the Stata default.\",\"label\":\"Robust variance\",\"name\":\"vcov\",\"profile\":\"advanced\",\"type\":\"select\"},{\"default\":0.95,\"help\":\"The coverage of the interval reported next to the estimate.\",\"label\":\"Confidence level\",\"max\":0.999,\"min\":0.5,\"name\":\"ci_level\",\"profile\":\"advanced\",\"type\":\"number\"}],\"probes\":[\"placebo_outcome\",\"alternate_spec\",\"subset_refuter\",\"random_common_cause\",\"randomization_inference\"],\"reference_dispositions\":[{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:d06ee7af3bee3177c1ad\",\"requested_as\":\"Neyman (1923/1990), On the Application of Probability Theory to Agricultural Experiments\"},{\"disposition\":\"resolved_metadata\",\"id\":\"10.1016/j.aam.2006.12.003\",\"requested_as\":\"Freedman (2008), On Regression Adjustments to Experimental Data\"},{\"disposition\":\"resolved_metadata\",\"id\":\"10.1214/12-aoas583\",\"requested_as\":\"Lin (2013), Agnostic Notes on Regression Adjustments to Experimental Data\"},{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:12d5c830da10862dd1b8\",\"requested_as\":\"Gerber and Green (2012), Field Experiments: Design, Analysis, and Interpretation\"}],\"reference_ids\":[\"source:unresolved:d06ee7af3bee3177c1ad\",\"10.1016/j.aam.2006.12.003\",\"10.1214/12-aoas583\",\"source:unresolved:12d5c830da10862dd1b8\"],\"references\":[\"Neyman (1923/1990), On the Application of Probability Theory to Agricultural Experiments\",\"Freedman (2008), On Regression Adjustments to Experimental Data\",\"Lin (2013), Agnostic Notes on Regression Adjustments to Experimental Data\",\"Gerber and Green (2012), Field Experiments: Design, Analysis, and Interpretation\"],\"roles_forbidden\":[\"instruments\",\"running\"],\"roles_optional\":[\"confounders\",\"cluster\",\"weight\"],\"roles_required\":[\"treatment\",\"outcome\"],\"source_path\":\"engines/python/capy_py/rct.py\",\"source_sha256\":\"ad0630960d6aaff7fdef9a290c97dcb094099f646bd6ff87151d786a5604baa8\",\"status\":\"recommended\",\"title\":\"Difference in means\",\"what_can_go_wrong\":\"Rows lost after randomisation (attrition) quietly turn the randomised comparison into an observational one. Covariate adjustment with many covariates and few units per arm can add bias and lose precision (Freedman 2008); Lin's interacted form limits that but does not remove it. If the treatment variable is really an offer, this is an ITT and not the effect of the programme.\",\"why_recommended\":\"The treatment was randomised, so the difference between the arms is already the effect. Nothing needs to be modelled for the estimate to be causal -- only for it to be precise.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[\"Interpret the relation within the stated design, population and observation process.\"],\"counterevidence\":[],\"gaps\":[\"This editorial link does not certify semantic entailment or implementation correctness.\"],\"id\":\"relation:0e99631f8a12d11a98bce4d0\",\"object_id\":\"concept:synthetic-control\",\"predicate\":\"related_to\",\"provenance\":[\"source:project-ontology\",\"abadie2010\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"basis\":[\"Original explanation and primary reference context; not a completed implementation audit.\"],\"date\":\"2026-10-13\",\"human_review\":false,\"semantic\":\"agent_editorial_context\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Ba