ghts\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"scope\":\"Declared project registry/navigation relationship; not an identified causal effect.\",\"subject_id\":\"probe.negative_control\"}],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"summary\":\"Estimate something that shares the confounding but not the causal path. A non-zero answer is bias you can see.\",\"title\":\"Negative control\"}" .
<urn:capy:probe.oster> a capy:probe ; skos:prefLabel "Oster coefficient stability" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[\"probe:probe.oster\"],\"catalogue_key\":\"probe:probe.oster\",\"citation_ids\":[\"10.1086/426036\",\"source:unresolved:a85a7fdfed55f3dc421c\"],\"citations\":[],\"content\":{\"availability\":{\"coming\":null,\"engines\":{\"python\":true,\"r\":\"robomit\"},\"needs_r_packages\":[\"robomit\"],\"runs_here\":true,\"summary\":\"Runs on this computer with what the app already installs.\"},\"designs\":[{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"},{\"explain_key\":null,\"id\":\"undecided\",\"in_catalogue\":false,\"kind\":\"design\",\"one_liner\":null,\"title\":\"Any design\"}],\"diagnostics\":[{\"explain_key\":\"diagnostic.oster_delta\",\"id\":\"oster_delta\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Oster delta\"},{\"explain_key\":\"diagnostic.oster_assumptions\",\"id\":\"oster_assumptions\",\"in_catalogue\":true,\"kind\":\"diagnostic\",\"title\":\"Oster's assumptions\"}],\"estimands\":[{\"acronym\":\"ATE\",\"explain_key\":\"estimand.ate\",\"id\":\"ATE\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"If everyone got the programme, how would the average outcome change?\",\"title\":\"Average treatment effect\"},{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"}],\"explain_key\":\"probe.oster\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"probe.oster\",\"in_more_depth\":null,\"kind\":\"probe\",\"needs_overlap\":false,\"one_liner\":\"How important would unobserved variables have to be, relative to the controls you already have, to drive the coefficient to zero?\",\"options\":[{\"default\":null,\"help\":\"The number this probe is about. Filled in automatically when the probe is launched from a result.\",\"label\":\"Parent estimate\",\"name\":\"parent_estimate\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":null,\"help\":\"Used to place the parent's confidence interval on the same scale.\",\"label\":\"Parent standard error\",\"min\":0.0,\"name\":\"parent_se\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":null,\"help\":\"Which analysis this probe is attached to. Some probes re-run it to get the fitted model rather than just the number.\",\"label\":\"Parent method\",\"name\":\"parent_method\",\"profile\":\"advanced\",\"type\":\"string\"},{\"default\":null,\"help\":\"The R-squared a regression on everything -- observed and unobserved -- would reach. Assumed, never estimated.\",\"label\":\"R_max\",\"max\":1.0,\"min\":0.0,\"name\":\"r_max\",\"profile\":\"standard\",\"type\":\"number\"},{\"default\":1.3,\"help\":\"Oster's own rule of thumb when R_max is left empty.\",\"label\":\"R_max as a multiple of the controlled R-squared\",\"max\":3.0,\"min\":1.0,\"name\":\"r_max_multiplier\",\"profile\":\"standard\",\"type\":\"number\"},{\"default\":1.0,\"help\":\"1 means unobservables matter as much as observables.\",\"label\":\"delta for the adjusted coefficient\",\"max\":5.0,\"min\":0.0,\"name\":\"delta\",\"profile\":\"standard\",\"type\":\"number\"},{\"default\":[],\"help\":\"Variables that belong in the uncontrolled regression too, such as fixed effects.\",\"label\":\"Controls in both regressions\",\"name\":\"always_include\",\"profile\":\"advanced\",\"type\":\"columns\"}],\"plain_language\":\"How important would unobserved variables have to be, relative to the controls you already have, to drive the coefficient to zero?\",\"probes\":[],\"references\":[\"Oster (2019), Unobservable selection and coefficient stability, Journal of Business & Economic Statistics 37(2)\",\"Altonji, Elder & Taber (2005), Selection on observed and unobserved variables\"],\"roles_forbidden\":[\"forbidden\"],\"roles_optional\":[\"a clustering variable\",\"weight\"],\"roles_required\":[\"a treatment\",\"an outcome\",\"at least one measured confounder\"],\"see_also\":[{\"explain_key\":\"design.observational\",\"id\":\"observational\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Treatment was not random; we can measure the things that made people get it.\",\"title\":\"Adjust for background differences\"},{\"explain_key\":null,\"id\":\"undecided\",\"in_catalogue\":false,\"kind\":\"design\",\"one_liner\":null,\"title\":\"Any design\"},{\"explain_key\":\"method.bounds.manski\",\"id\":\"bounds.manski\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Report the range the effect must lie in given only what the data can support, without assuming away the missing counterfactual.\",\"title\":\"Manski bounds\"},{\"explain_key\":\"method.interference.exposure\",\"id\":\"interference.exposure\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"When one unit's treatment affects another's outcome, estimate the direct and spillover effects separately instead of pretending neither exists.\",\"title\":\"Interference and spillovers\"},{\"explain_key\":\"method.ml.causal_forest\",\"id\":\"ml.causal_forest\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Grow trees that look for units whose effect differs, keeping the rows that chose each split away from the rows that estimate it.\",\"title\":\"Honest causal forest\"},{\"explain_key\":\"method.ml.dml_irm\",\"id\":\"ml.dml_irm\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"A separate outcome model for each arm plus a treatment model, combined in a doubly robust score: right if either side is right.\",\"title\":\"Double ML (interactive)\"},{\"explain_key\":\"method.ml.dml_plr\",\"id\":\"ml.dml_plr\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Predict the outcome and the treatment from the confounders, then regress what is left of one on what is left of the other.\",\"title\":\"Double ML (partially linear)\"},{\"explain_key\":\"method.ml.metalearner\",\"id\":\"ml.metalearner\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Build the per-unit effect out of ordinary prediction models, four different ways, on the same cross-fitting.\",\"title\":\"Meta-learner (T, S, X, DR)\"}],\"status\":\"reasonable\",\"status_label\":\"Reasonable\",\"tags\":[\"Adjust for background differences\",\"Any design\",\"ATE\",\"ATT\",\"Reasonable\"],\"title\":\"Oster coefficient stability\",\"what_it_assumes\":[{\"explain_key\":\"assumption.exchangeability\",\"explains\":\"Treated and untreated units are comparable once you condition on the confounders you measured. Everything that pushed people towards treatment and also moves the outcome is in your adjustment set.\",\"id\":\"exchangeability\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Exchangeability / no unmeasured confounding\",\"worry_when\":\"Treatment was chosen by people who knew something about the likely outcome that you do not observe. Clinical judgement, self-selection into a programme, and administrative triage are the classic cases.\"},{\"explain_key\":\"assumption.positivity\",\"explains\":\"Every kind of unit had some chance of being treated and some chance of not being treated. Where that fails, there is no comparison to make and the model is inventing one.\",\"id\":\"positivity\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Positivity / overlap\",\"worry_when\":\"Any single weight carries a large share of the total; the effective sample is far below the nominal one; the propensity model separates the arms almost perfectly; treated units sit outside the control group's range.\"},{\"explain_key\":\"assumption.sutva\",\"explains\":\"One unit's treatment does not change another unit's outcome, and \\\"treated\\\" means the same thing for everyone who got it.\",\"id\":\"sutva\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"SUTVA / no interference\",\"worry_when\":\"Units interact: they compete for the same jobs, infect each other, share a classroom or a market. Or the \\\"programme\\\" is really a family of programmes whose intensity varied a lot across sites.\"},{\"explain_key\":\"assumption.consistency\",\"explains\":\"The outcome you observe under the treatment a unit received is the same as the potential outcome under that treatment. In practice: the treatment has to be a thing someone could actually do.\",\"id\":\"consistency\",\"in_catalogue\":true,\"kind\":\"assumption\",\"title\":\"Consistency / well-defined intervention\",\"worry_when\":\"The treatment is a state of the world rather than an action, or it is coded from several very different real interventions.\"}],\"when_not_to_use\":[\"Proportional selection is a strong and unverifiable assumption, and R_max is assumed rather than estimated. The bound moves a long way with both, which is why they are plotted together rather than reported as one number.\",\"The controls barely move the R-squared, which leaves Oster's ratio undefined\"],\"when_to_use\":[\"Coefficient stability gets claimed informally in almost every paper; this at least makes the claim quantitative and shows what it depends on.\"]},\"disposition\":\"imported\",\"gaps\":[\"no plain-language description has been written yet, so the one-line summary is standing in for it\"],\"id\":\"probe.oster\",\"kind\":\"probe\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"probe.oster\",\"registry\":{\"designs\":[\"observational\",\"undecided\"],\"diagnostics\":[\"oster_delta\",\"oster_assumptions\"],\"disrecommend_when\":\"The controls barely move the R-squared, which leaves Oster's ratio undefined\",\"engine_support_basis\":\"Static adapter decorator and declared package metadata; installed availability not checked.\",\"engines\":{\"python\":true,\"r\":\"robomit\"},\"estimands\":[\"ATE\",\"ATT\"],\"explain_key\":\"probe.oster\",\"id\":\"probe.oster\",\"needs\":[\"numpy\",\"pandas\"],\"needs_overlap\":false,\"one_liner\":\"How important would unobserved variables have to be, relative to the controls you already have, to drive the coefficient to zero?\",\"options\":[{\"default\":null,\"help\":\"The number this probe is about. Filled in automatically when the probe is launched from a result.\",\"label\":\"Parent estimate\",\"name\":\"parent_estimate\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":null,\"help\":\"Used to place the parent's confidence interval on the same scale.\",\"label\":\"Parent standard error\",\"min\":0.0,\"name\":\"parent_se\",\"profile\":\"advanced\",\"type\":\"number\"},{\"default\":null,\"help\":\"Which analysis this probe is attached to. Some probes re-run it to get the fitted model rather than just the number.\",\"label\":\"Parent method\",\"name\":\"parent_method\",\"profile\":\"advanced\",\"type\":\"string\"},{\"default\":null,\"help\":\"The R-squared a regression on everything -- observed and unobserved -- would reach. Assumed, never estimated.\",\"label\":\"R_max\",\"max\":1.0,\"min\":0.0,\"name\":\"r_max\",\"profile\":\"standard\",\"type\":\"number\"},{\"default\":1.3,\"help\":\"Oster's own rule of thumb when R_max is left empty.\",\"label\":\"R_max as a multiple of the controlled R-squared\",\"max\":3.0,\"min\":1.0,\"name\":\"r_max_multiplier\",\"profile\":\"standard\",\"type\":\"number\"},{\"default\":1.0,\"help\":\"1 means unobservables matter as much as observables.\",\"label\":\"delta for the adjusted coefficient\",\"max\":5.0,\"min\":0.0,\"name\":\"delta\",\"profile\":\"standard\",\"type\":\"number\"},{\"default\":[],\"help\":\"Variables that belong in the uncontrolled regression too, such as fixed effects.\",\"label\":\"Controls in both regressions\",\"name\":\"always_include\",\"profile\":\"advanced\",\"type\":\"columns\"}],\"probes\":[],\"reference_dispositions\":[{\"disposition\":\"unresolved_search_only\",\"id\":\"source:unresolved:a85a7fdfed55f3dc421c\",\"requested_as\":\"Oster (2019), Unobservable selection and coefficient stability, Journal of Business & Economic Statistics 37(2)\"},{\"disposition\":\"resolved_metadata\",\"id\":\"10.1086/426036\",\"requested_as\":\"Altonji, Elder & Taber (2005), Selection on observed and unobserved variables\"}],\"reference_ids\":[\"source:unresolved:a85a7fdfed55f3dc421c\",\"10.1086/426036\"],\"references\":[\"Oster (2019), Unobservable selection and coefficient stability, Journal of Business & Economic Statistics 37(2)\",\"Altonji, Elder & Taber (2005), Selection on observed and unobserved variables\"],\"roles_forbidden\":[\"forbidden\"],\"roles_optional\":[\"cluster\",\"weight\"],\"roles_required\":[\"treatment\",\"outcome\",\"confounders\"],\"source_path\":\"engines/python/capy_py/sensitivity.py\",\"source_sha256\":\"2d17c4ca3660d99d91eb0d3bb715c2164c82cc3fe8c8b3d0cf21a2d54c733d8b\",\"status\":\"reasonable\",\"title\":\"Oster coefficient stability\",\"what_can_go_wrong\":\"Proportional selection is a strong and unverifiable assumption, and R_max is assumed rather than estimated. The bound moves a long way with both, which is why they are plotted together rather than reported as one number.\",\"why_recommended\":\"Coefficient stability gets claimed informally in almost every paper; this at least makes the claim quantitative and shows what it depends on.\"},\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:076fe6c7939924ba6d50a7e5\",\"object_id\":\"design:undecided\",\"predicate\":\"compatible_with_design\",\"provenance\":[\"source:project-inventory\"],\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attrib