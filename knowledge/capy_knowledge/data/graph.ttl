<urn:capy:study%3Aorgan_donations> a capy:study ; skos:prefLabel "Active choice and organ donation" ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"aliases\":[],\"catalogue_key\":\"study:organ_donations\",\"citation_ids\":[],\"citations\":[],\"content\":{\"caveat\":\"One treated state. Inference here is genuinely hard, and the app will say so.\",\"citation\":\"Kessler & Roth (2014).\",\"citation_url\":\"https://doi.org/10.1016/j.jpubeco.2014.06.001\",\"design\":{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"},\"difficulty\":\"medium\",\"estimand\":{\"acronym\":\"ATT\",\"explain_key\":\"estimand.att\",\"id\":\"ATT\",\"in_catalogue\":true,\"kind\":\"estimand\",\"one_liner\":\"For people who actually got it, what did it do?\",\"title\":\"Average treatment effect on the treated\"},\"explain_key\":null,\"gaps\":[],\"id\":\"organ_donations\",\"kind\":\"study\",\"one_liner\":\"difference-in-differences with a single treated unit\",\"plain_language\":\"California changed its driver-licence form; 26 other states did not. Six quarters, one treated unit, and every reason to be careful about the standard error.\",\"provenance\":{\"data_origin\":\"Published study data, fetched from source. Not redistributed by this project.\",\"downloads_from\":[\"https://vincentarelbundock.github.io/Rdatasets/csv/causaldata/organ_donations.csv\"],\"licences\":[\"MIT\"],\"rights\":\"MIT via causaldata, Huntington-Klein et al.\",\"source\":\"real\",\"study\":\"Kessler & Roth (2014)\",\"truth\":\"This is the study data, not a simulation. There is no built-in answer to check the estimators against -- which is the whole reason to work with it.\"},\"question\":\"California changed its driver-licence form; 26 other states did not. Six quarters, one treated unit, and every reason to be careful about the standard error.\",\"rows\":162,\"see_also\":[{\"explain_key\":\"design.did\",\"id\":\"did\",\"in_catalogue\":true,\"kind\":\"design\",\"one_liner\":\"Some places or groups got it earlier than others.\",\"title\":\"Policy rolled out over time\"},{\"explain_key\":\"method.did.event_study\",\"id\":\"did.event_study\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Plot the effect period by period around adoption, so you can see whether the gap opened when the policy arrived or long before it.\",\"title\":\"Event study (leads and lags)\"},{\"explain_key\":\"method.did.twfe\",\"id\":\"did.twfe\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"One regression with unit and period fixed effects. Familiar, fast, and not an average treatment effect when units adopt at different dates.\",\"title\":\"Two-way fixed effects\"}],\"suggested_methods\":[{\"explain_key\":\"method.did.event_study\",\"id\":\"did.event_study\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"Plot the effect period by period around adoption, so you can see whether the gap opened when the policy arrived or long before it.\",\"title\":\"Event study (leads and lags)\"},{\"explain_key\":\"method.did.twfe\",\"id\":\"did.twfe\",\"in_catalogue\":true,\"kind\":\"method\",\"one_liner\":\"One regression with unit and period fixed effects. Familiar, fast, and not an average treatment effect when units adopt at different dates.\",\"title\":\"Two-way fixed effects\"}],\"tags\":[\"Policy rolled out over time\",\"medium\"],\"teaches\":\"difference-in-differences with a single treated unit\",\"title\":\"Active choice and organ donation\",\"tour\":[]},\"disposition\":\"imported\",\"gaps\":[],\"id\":\"study:organ_donations\",\"kind\":\"study\",\"provenance\":[\"source:project-inventory\"],\"raw_id\":\"organ_donations\",\"relations\":[{\"assertion_mode\":\"editorial\",\"conditions\":[],\"counterevidence\":[],\"gaps\":[],\"id\":\"relation:21adb93dcbd598679711819c\",\"object_id\":\"design:did\",\"predicate\":\"relate