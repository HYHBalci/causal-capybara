ural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_version\":\"https://doi.org/10.1198/jasa.2009.ap08746\",\"summary\":\"Bibliographic metadata/link only; no publication text, abstract, figure or dataset is distributed.\",\"title\":\"Abadie, A., Diamond, A., & Hainmueller, J. (2010). Synthetic control methods for comparative case studies: Estimating the effect of California’s tobacco control program. Journal of the American Statistical Association, 105(490), 493–505.\",\"url\":\"https://doi.org/10.1198/jasa.2009.ap08746\"}" .
<urn:capy:altman2003> a capy:source ; skos:prefLabel "Altman, D. G., and Bland, J. M. (2003). Interaction revisited: the difference between two estimates. BMJ 326:219." ; prov:wasDerivedFrom <urn:capy:source%3Aproject-inventory> ; capy:record "{\"citation\":\"Altman, D. G., and Bland, J. M. (2003). Interaction revisited: the difference between two estimates. BMJ 326:219.\",\"citation_ids\":[],\"citations\":[],\"disposition\":\"resolved_metadata\",\"id\":\"altman2003\",\"kind\":\"source\",\"metadata\":{\"citation\":\"Altman, D. G., and Bland, J. M. (2003). Interaction revisited: the difference between two estimates. BMJ 326:219.\",\"id\":\"altman2003\",\"match\":[\"altman\",\"bland\",\"2003\"],\"resolved\":true,\"topic\":\"Treatment effect heterogeneity\",\"url\":\"https://doi.org/10.1136/bmj.326.7382.219\"},\"provenance\":[\"source:project-inventory\"],\"publication_rights\":{\"attribution\":\"Altman, D. G., and Bland, J. M. (2003). Interaction revisited: the difference between two estimates. BMJ 326:219.\",\"content_type\":\"external_publication_body\",\"license_id\":\"unknown\",\"license_url\":null,\"modified\":false,\"permissions\":{\"adapt\":false,\"cache\":false,\"display\":false,\"model_context\":false,\"public_export\":false},\"review_basis\":\"No full-text license has been admitted.\"},\"relations\":[],\"resolved\":true,\"review\":{\"actor\":\"Codex agent\",\"actor_type\":\"agent\",\"date\":\"2026-10-12\",\"human_review\":false,\"semantic\":\"not_assessed\",\"structural\":\"validated\"},\"rights\":{\"attribution\":\"Causal Capybara contributors; Yusufhan Balci; VCESR\",\"content_type\":\"original_project_content\",\"license_id\":\"Apache-2.0\",\"license_url\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"modified\":true,\"permissions\":{\"adapt\":true,\"cache\":true,\"display\":true,\"model_context\":true,\"public_export\":true},\"review_basis\":\"Original or imported Apache-2.0 project material; no third-party paper body included.\"},\"source_version\":