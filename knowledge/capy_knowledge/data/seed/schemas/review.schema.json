{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review and authorship",
  "type": "object",
  "required": [
    "actor",
    "actor_type",
    "structural",
    "semantic",
    "human_review"
  ],
  "properties": {
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "actor_type": {
      "enum": [
        "agent",
        "human",
        "project",
        "not_assessed"
      ]
    },
    "structural": {
      "type": "string"
    },
    "semantic": {
      "type": "string"
    },
    "human_review": {
      "type": "boolean"
    },
    "date": {
      "type": "string"
    },
    "basis": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "human_review": {
            "const": true
          }
        },
        "required": [
          "human_review"
        ]
      },
      "then": {
        "required": [
          "basis",
          "sources",
          "date"
        ],
        "properties": {
          "actor_type": {
            "const": "human"
          },
          "basis": {
            "minItems": 1
          },
          "sources": {
            "minItems": 1
          },
          "date": {
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "format": "date"
          }
        }
      }
    }
  ]
}
