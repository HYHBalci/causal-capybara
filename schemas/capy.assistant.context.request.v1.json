{
  "$id": "https://causalcapybara.dev/schemas/capy.assistant.context.request.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "include_study": {
      "default": false,
      "title": "Include Study",
      "type": "boolean"
    },
    "previous_context_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Context Id"
    },
    "project_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "query": {
      "default": "",
      "maxLength": 4000,
      "title": "Query",
      "type": "string"
    },
    "redactions": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "title": "Redactions",
      "type": "array"
    },
    "selected_run_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 5,
      "title": "Selected Run Ids",
      "type": "array"
    },
    "selection": {
      "anyOf": [
        {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selection"
    },
    "spec_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Spec Id"
    }
  },
  "title": "ContextRequest",
  "type": "object"
}
